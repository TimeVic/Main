<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>14</LangVersion>
        <WarningsAsErrors>CS0168,CS8602,CS0169,CS1998</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Api.Requests.Base\Api.Requests.Base.csproj" />
        <ProjectReference Include="..\AspNetCore.ApiControllers.Abstractions\AspNetCore.ApiControllers.Abstractions.csproj" />
        <ProjectReference Include="..\AspNetCore.ApiControllers.Extensions\AspNetCore.ApiControllers.Extensions.csproj" />
        <ProjectReference Include="..\TimeTracker.Api.Shared\TimeTracker.Api.Shared.csproj" />
        <ProjectReference Include="..\TimeTracker.Business.Common\TimeTracker.Business.Common.csproj" />
        <ProjectReference Include="..\TimeTracker.Business\TimeTracker.Business.csproj" />
        <ProjectReference Include="..\TimeTracker.Business.Logging\TimeTracker.Business.Logging.csproj" />
        <InternalsVisibleTo Include="TimeTracker.Tests.Integration.Api" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\Shared\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <None Include="appsettings.Local.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
