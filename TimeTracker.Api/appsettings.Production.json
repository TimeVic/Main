{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Error",
                "System": "Error"
            }
        }
    },
    "App": {
        "Auth": {
            "JwtLifetime": 7200,
            "AccessTokenLifetime": 30,
            "CookieDomains": [ ".timevic.com" ]
        }
    },
    "Garage": {
        "BucketName": "timevic-production"
    }
}
