{
    "Serilog": {
        "IsSendEmailIfError": false,
        "Using": [],
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Error",
                "System": "Error"
            }
        },
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithProcessId",
            "WithThreadId"
        ],
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "Debug"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "./logs/log.txt",
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    },
    "AllowedHosts": "*",
    "App": {
        "Name": "api",
        "Auth": {
            "Issuer": "TimeVic API",
            "Audience": "TimeVic API",
            "JwtLifetime": 60,
            "AccessTokenLifetime": 30,
            "SymmetricSecurityKey": "sDciuOhv2y4tXeM5Nd3t0cFBZB2S6P09q8k5ZmLXSC"
        },
        "Email": {
            "Notification": "notifications@timevic.com"
        },
        "Logging": {
            "GrayLog": {
                "Host": "",
                "Port": 0
            }
        }
    },
    "DefaultConnection": "User ID=postgres;Password=StronG67Pass;Host=localhost;Port=5433;Database=timevic;Pooling=true;",
    "Google": {
        "Storage": {
            "ProjectId": "",
            "BucketName": ""
        },
        "Firebase": {
            "Credentials": ""
        }
    },
    "AWS": {
        "S3": {
            "BucketName": "",
            "AccessKey": "",
            "SecretKey": ""
        }
    }
}
