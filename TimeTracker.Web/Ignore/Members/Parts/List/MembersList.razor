@inherits BaseReactiveComponent

@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants
@using TimeTracker.Business.Extensions

<MudTable
    Class="mt-2 w-100"
    Items="@_state.Value.List"
    Hover="true"
    Dense="true"
    Outlined="true"
    Breakpoint="Breakpoint.Sm"
    Loading="@_state.Value.IsListLoading"
    LoadingProgressColor="Color.Info">

    <ToolBarContent>
        <MudText Typo="Typo.h6">Workspace memberships</MudText>
        <MudSpacer/>
        <MudButton
            OnClick="@OnAdd"
            Disabled="@(!AuthState.Value.IsRoleAdmin)"
            StartIcon="@Icons.Material.Filled.Add">
            Add member
        </MudButton>
    </ToolBarContent>

    <HeaderContent>
        <MudTh>User</MudTh>
        <MudTh>Access Level</MudTh>
        <MudTh>Projects</MudTh>
        <MudTh></MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="User">@context.User.Email</MudTd>
        <MudTd DataLabel="AccessLevel">@context.Access.GetDisplayName()</MudTd>
        <MudTd DataLabel="Projects">
            @if (context.Access is MembershipAccessType.Manager or MembershipAccessType.Owner)
            {
                <text>All</text>
            }
            else
            {
                var projectNames = GetProjectNames(context);
                if (string.IsNullOrEmpty(projectNames))
                {
                    projectNames = "No access";
                }
                <text>@projectNames</text>
            }
        </MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton
                OnClick="@(() => OnEdit(context))"
                Icon="@Icons.Material.Filled.Edit"
                Disabled="@(!AuthState.Value.IsRoleAdmin)"
                Size="Size.Small"/>
            <MudIconButton
                OnClick="@(() => OnDelete(context))"
                Icon="@Icons.Material.Filled.Delete"
                Disabled="@(!AuthState.Value.IsRoleAdmin)"
                Color="Color.Error"
                Size="Size.Small"/>
        </MudTd>
    </RowTemplate>
</MudTable>
