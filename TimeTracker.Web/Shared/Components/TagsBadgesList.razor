
<div class="w-tags-badges">
    @foreach (var tag in Tags)
    {
        if (tag.Color != null)
        {
            <MudChip
                Size="Size.Small"
                class="w-badge"
                Style="@($"background-color: {tag.Color}; color: {tag.TextColor};")">
                @tag.Name
            </MudChip>
        }
        else
        {
            <MudChip
                Size="Size.Small"
                Color="Color.Secondary"
                class="w-badge"
            >
                @tag.Name
            </MudChip>
        }
    }
</div>
