@using MudBlazor

@inherits BaseReactiveComponent

@if (_workpsaceState.Value.IsLoaded)
{
    <MudDivider/>
    <MudMenuItem Disabled="true">Switch workspace:</MudMenuItem>
    @foreach (var workspace in _workpsaceState.Value.List)
    {
        if (_authState.Value.Workspace.Id != @workspace.Id)
        {
            <MudMenuItem
                OnClick=@(args => OnClickToMenuItem(workspace))>
                @workspace.Name
            </MudMenuItem>
        }
    }
    <MudDivider/>
    <MudMenuItem
        IconSize="Size.Small"
        Icon="@Icons.Material.Filled.Dashboard"
        OnClick="NavigateToEditWorkspaces">
        Manage workspaces
    </MudMenuItem>
}
