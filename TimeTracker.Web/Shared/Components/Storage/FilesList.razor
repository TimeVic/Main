@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants.Storage

<div class="@Class">
    @if (!Files.Any())
    {
        <div
            class="mt-3 w-100">
            <FluentLabel Typo="Typography.Subject">No records to display.</FluentLabel>
        </div>
    }
    else
    {
        <FluentDataGrid Items="@Files.AsQueryable()">
            <TemplateColumn Title="File">
                @if (!string.IsNullOrEmpty(context.Title))
                {
                    @context.Title
                }
                else
                {
                    @context.OriginalFileName
                }
            </TemplateColumn>
            <TemplateColumn Title="Action">
                <FluentButton
                    Appearance="Appearance.Lightweight"
                    @onclick="@(() => OnClickView(context))">
                    View
                </FluentButton>
                <FluentButton
                    Appearance="Appearance.Lightweight"
                    @onclick="@(() => OnClickDownload(context))">
                    Download
                </FluentButton>
                <FluentButton
                    IconStart="@(new Icons.Filled.Size24.Delete())"
                    Appearance="Appearance.Lightweight"
                    @onclick="@(() => OnCLickDelete(context))"/>
            </TemplateColumn>
        </FluentDataGrid>
    }
</div>
