@inherits BaseReactiveComponent

<div class="w-file-upload @Class">
    <InputFile 
        @ref="@_fileInput" 
        class="w-upload-input"
        OnChange="@OnInputFileChange" 
        multiple 
        accept="@_acceptTypes" />
    <FluentButton
        IconEnd="@(new Icons.Filled.Size24.SelectObject())"
        Class="mr-3"
        Appearance="Appearance.Accent"
        Disabled="_isLoading"
        OnClick="@OnClickSelectFile">
        @_buttonLabel
    </FluentButton>
</div>
