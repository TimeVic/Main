@using MudBlazor

@inherits BaseComponent

<div class="w-file-upload @Class">
    <InputFile 
        @ref="@_fileInput" 
        class="w-upload-input"
        OnChange="@OnInputFileChange" 
        multiple 
        accept="@_acceptTypes" />
    <MudButton
        StartIcon="@Icons.Material.Filled.Upload"
        Color="Color.Default"
        OnClick="OnClickSelectFile"
        Disabled="_isLoading">
        @_buttonLabel
    </MudButton>
</div>
