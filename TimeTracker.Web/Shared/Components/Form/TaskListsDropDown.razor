@using TimeTracker.Api.Shared.Dto.Entity.Task

@inherits BaseReactiveComponent

<FluentSelect
    TOption="TaskListDto"
    Label="@Label"
    Class="@Class"
    Multiple="false"
    Autofocus="false"
    Disabled="@Disabled"
    Placeholder="@_placeholder"
    SelectedOption="_selectedItem"
    Appearance="Appearance.Outline"
    OptionText="@(item => item.Name)"
    Height="400px">

    @foreach (var listGroup in _groupedList)
    {
        var project = listGroup.First().Project;
        <FluentLabel Typo="Typography.H3" Class="mt-2 mb-1">
            @project.Name
        </FluentLabel>
        <FluentDivider Orientation="Orientation.Horizontal"/>
        foreach (var taskList in listGroup)
        {
            <FluentOption 
                Value="@taskList.Id.ToString()"
                Selected="@(taskList.Id == _selectedId)"
                OnSelect="@(() => OnValueChanged(taskList))">
                @taskList.Name
            </FluentOption>        
        }
    }
</FluentSelect>
