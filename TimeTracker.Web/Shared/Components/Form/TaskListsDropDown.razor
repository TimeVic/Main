@using Newtonsoft.Json
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Api.Shared.Dto.Entity.Task
@using TimeTracker.Business.Common.Constants

@inherits BaseReactiveComponent

<FluentSelect
    TOption="TaskListDto"
    Label="@Label"
    Class="@Class"
    Autofocus="false"
    Disabled="@Disabled"
    Placeholder="@Placeholder"
    Items="@_list.ToList()"
    OptionValue="@(dto => dto?.Id.ToString() ?? string.Empty)"
    Value="@(_selectedId.ToString())"
    ValueChanged="OnValueChanged"
    >
    <OptionTemplate>
        @if (context is null)
        {
            return;
        }
        @context.Name
        @if (context.Project != null && IsExtendedInfo)
        {
            <text> (@context.Project?.Name)</text>
        }
    </OptionTemplate>
</FluentSelect>
