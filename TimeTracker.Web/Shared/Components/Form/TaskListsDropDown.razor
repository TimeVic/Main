@using Newtonsoft.Json
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Api.Shared.Dto.Entity.Task
@using TimeTracker.Business.Common.Constants
@using MudBlazor

@inherits BaseReactiveComponent

<MudSelect
    T="long"
    U="TaskListDto"
    Class="@Class"
    Disabled="@Disabled"
    Dense="true"
    Required="Required"
    Placeholder="@Placeholder"
    EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
    For="For"
    Value="@_selectedId"
    ValueChanged="OnValueChanged"
    ToStringFunc="ToStringFunc"
    RequiredError="Task list is required"
    Variant="MudBlazor.Variant.Text"
    AnchorOrigin="Origin.BottomCenter">
    @foreach (var taskList in _list)
    {
        <MudSelectItem Value="@taskList.Id">
            <div>@taskList.Name</div>
            @if (taskList.Project != null && IsExtendedInfo)
            {
                <RadzenText class="mt-2 d-block" TextStyle="TextStyle.Caption">
                    @taskList.Project?.Name
                    @if (taskList.Project?.Client != null)
                    {
                        <text> - @taskList.Project?.Client.Name</text>
                    }
                </RadzenText>
            }
        </MudSelectItem>
    }
</MudSelect>
