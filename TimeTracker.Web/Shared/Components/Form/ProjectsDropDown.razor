@inherits BaseReactiveComponent

@using TimeTracker.Api.Shared.Dto.Entity

<FluentSelect
    TOption="ProjectDto?"
    Label="@Label"
    Class="@Class"
    Placeholder="@_placeholder"
    Items="@_list.ToList()"
    Disabled="@(!_list.Any() || Disabled)"
    OptionSelected="@(dto => dto?.Id == _selectedItem?.Id)"
    OptionValue="@(dto => dto?.Id.ToString() ?? string.Empty)"
    SelectedOption="@_selectedItem"
    ValueChanged="OnValueChanged">
    <OptionTemplate>
        @context?.Name
        @if (context?.Client != null)
        {
            <text>(@context?.Client?.Name)</text>
        }
    </OptionTemplate>
</FluentSelect>
