@inherits BaseReactiveComponent

@using Newtonsoft.Json
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants
@using MudBlazor

<MudSelect
    T="long"
    U="ProjectDto"
    Class="@Class"
    Disabled="@Disabled"
    Dense="true"
    For="For"
    Clearable="Clearable"
    Placeholder="@Placeholder"
    EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
    Value="@_selectedId"
    ValueChanged="OnValueChanged"
    ToStringFunc="ToStringFunc"
    Variant="MudBlazor.Variant.Text"
    AnchorOrigin="Origin.BottomCenter">
    @foreach (var project in _list)
    {
        <MudSelectItem Value="@project.Id">
            @project.Name
            @if (project?.Client != null)
            {
                @if (_selectedId == project.Id)
                {
                    <text>(@project.Client?.Name)</text>
                }
                else
                {
                    <MudText
                        class="d-block"
                        Typo="Typo.caption">
                        <b>@project.Client?.Name</b>
                    </MudText>    
                }
            }
        </MudSelectItem>
    }
</MudSelect>
