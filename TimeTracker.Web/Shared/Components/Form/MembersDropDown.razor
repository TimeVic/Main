@inherits BaseReactiveComponent

@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants

<FluentSelect
    TOption="WorkspaceMembershipDto?"
    Label="@Label"
    Class="@Class"
    Disabled="@Disabled"
    Placeholder="@Placeholder"
    Items="@_list.ToList()"
    SelectedOption="@_selectedItem"
    OptionValue="@(dto => dto?.Id.ToString())"
    OptionSelected="@(dto => dto?.Id == _selectedItem?.Id)"
    SelectedOptionChanged="OnValueChanged">
    <OptionTemplate>
        @context?.User.Name
    </OptionTemplate>
</FluentSelect>
