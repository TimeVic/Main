@using TimeTracker.Web.Core.Helpers

@typeparam TItem where TItem: struct, IConvertible

<FluentSelect
    TOption="TItem?"
    Label="@Label"
    Class="@Class"
    Placeholder="@Placeholder"
    Items="@_list.ToList()"
    SelectedOption="@_value"
    Disabled="@Disabled"
    OptionValue="@(dto => dto?.ToString())"
    OptionSelected="@(value => value!.Value.Equals(_value))"
    ValueChanged="OnItemSelected">
    <OptionTemplate>
        @if (context is null)
        {
            return;
        }
        @(EnumHelpers.GetDisplayName(typeof(TItem), context))
    </OptionTemplate>
</FluentSelect>
