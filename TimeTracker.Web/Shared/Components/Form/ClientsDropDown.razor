@inherits BaseReactiveComponent

@using TimeTracker.Business.Common.Constants
@using TimeTracker.Api.Shared.Dto.Entity

<div class="justify-content-start">
    <FluentSelect
        TOption="ClientDto?"
        Label="@Label"
        Class="@Class"
        Disabled="@Disabled"
        Placeholder="@Placeholder"
        Items="@_list.ToList()"
        @bind-Value="@_selectedId"
        OptionValue="@(dto => dto?.Id.ToString())"
        SelectedOptionChanged="OnValueChanged">
        <OptionTemplate>
            @context?.Name
        </OptionTemplate>
    </FluentSelect>

    @if (Clearable)
    {
    <FluentButton
        Class="w-select-clear-btn"
        IconStart="@(new Icons.Filled.Size16.Dismiss())"
        OnClick="OnClear"/>
    }
</div>
