@using TimeTracker.Business.Common.Constants
@using MudBlazor

@inherits BaseReactiveComponent

<MudSelect
    T="long"
    @ref="_select"
    Class="@Class"
    Disabled="@Disabled"
    Dense="true"
    MultiSelection="true"
    Placeholder="@Placeholder"
    SelectedValues="@_selectedIds"
    SelectedValuesChanged="OnValueChanged"
    Variant="MudBlazor.Variant.Text"
    ToStringFunc="ToStringFunc"
    AnchorOrigin="Origin.BottomCenter">
    @foreach (var tag in _state.Value.List)
    {
        <MudSelectItem Value="@tag.Id">
            @tag.Name
        </MudSelectItem>
    }
</MudSelect>
