@inherits TimeTracker.Web.Shared.Components.Form.Select.Core.BaseSingleSelect<ClientDto>

@using TimeTracker.Business.Common.Constants
@using TimeTracker.Api.Shared.Dto.Entity

<div class="justify-content-start w-select @Class @(FullWidth ? "w-100" : "")">
    <FluentSelect
        TOption="ClientDto?"
        Label="@Label"
        Disabled="@Disabled"
        Class="@SelectClass"
        Placeholder="@Placeholder"
        Required="Required"
        Items="@_list.ToList()"
        @bind-Value="@_selectedId"
        OptionValue="@(dto => dto?.Id.ToString())"
        SelectedOptionChanged="OnValueChanged">
        <OptionTemplate>
            @context?.Name
        </OptionTemplate>
    </FluentSelect>

    @if (Clearable)
    {
        <FluentButton
            Class="w-select-clear-btn"
            IconStart="@(new Icons.Filled.Size16.Dismiss())"
            OnClick="OnClear"/>
    }
</div>
