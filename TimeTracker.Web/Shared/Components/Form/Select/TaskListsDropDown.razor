@using TimeTracker.Api.Shared.Dto.Entity.Task

@inherits TimeTracker.Web.Shared.Components.Form.Select.Core.BaseSingleSelect<TaskListDto>

<div class="justify-content-start w-select @Class @(FullWidth ? "w-100" : "")">
    <FluentSelect
        TOption="TaskListDto"
        Label="@Label"
        Class="@SelectClass"
        Multiple="false"
        Autofocus="false"
        Disabled="@Disabled"
        Required="Required"
        Placeholder="@_placeholder"
        SelectedOption="_selectedItem"
        Appearance="Appearance.Outline"
        OptionText="@(item => item.Name)"
        @bind-Value="@_selectedId"
        OptionValue="@(dto => dto?.Id.ToString())"
        SelectedOptionChanged="OnValueChanged"
        Height="400px">

        @foreach (var listGroup in _groupedList)
        {
            var project = listGroup.First().Project;
            <FluentLabel Typo="Typography.H3" Class="mt-2 mb-1">
                @project.Name
            </FluentLabel>
            <FluentDivider Orientation="Orientation.Horizontal"/>
            foreach (var taskList in listGroup)
            {
                <FluentOption
                    Value="@taskList.Id.ToString()"
                    Selected="@(taskList.Id.ToString() == _selectedId)"
                    OnSelect="@(() => OnValueChanged(taskList))">
                    @taskList.Name
                </FluentOption>
            }
        }
    </FluentSelect>

    @if (Clearable)
    {
        <FluentButton
            Class="w-select-clear-btn"
            IconStart="@(new Icons.Filled.Size16.Dismiss())"
            OnClick="OnClear"/>
    }
</div>
