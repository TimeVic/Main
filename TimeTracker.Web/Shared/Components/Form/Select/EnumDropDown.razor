@using TimeTracker.Web.Core.Helpers

@typeparam TItem where TItem: struct, IConvertible

<div class="justify-content-start w-select @Class @(FullWidth ? "w-100" : "")">
    <FluentSelect
        TOption="TItem?"
        Label="@Label"
        Class="@SelectClass"
        Placeholder="@_placeholder"
        Items="@_list.ToList()"
        SelectedOption="@_value"
        Disabled="@Disabled"
        OptionValue="@(dto => dto?.ToString())"
        OptionSelected="@(value => value!.Value.Equals(_value))"
        ValueChanged="OnItemSelected">
        <OptionTemplate>
            @if (context is null)
            {
                return;
            }
            @(EnumHelpers.GetDisplayName(typeof(TItem), context))
        </OptionTemplate>
    </FluentSelect>

    @if (Clearable)
    {
        <FluentButton
            Class="w-select-clear-btn"
            IconStart="@(new Icons.Filled.Size16.Dismiss())"
            OnClick="OnClear"/>
    }
</div>
