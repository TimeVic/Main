@page "/chat"

@inherits BaseReactiveComponent
@layout TimeTracker.Web.Pages.Chat.Shared.Layout

@using BlazorApp.Models
@using TimeTracker.Web.Pages.Chat.Parts

<aside class="w-full border-b border-slate-200 bg-white lg:w-80 lg:border-b-0 lg:border-r">
    <div class="border-b border-slate-200 p-4">
        <div class="flex items-center justify-between gap-3">
            <div>
                <p class="text-xs uppercase tracking-[0.3em] text-cyan-600">Blazor Chat</p>
                <h1 class="mt-1 text-xl font-semibold text-slate-900">Messages</h1>
            </div>
            <div class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-medium text-emerald-700">
                Online demo
            </div>
        </div>
        <div class="mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-3">
            <label class="mb-2 block text-xs font-semibold uppercase tracking-wide text-slate-500">Workspace</label>
            <InputSelect 
                TValue="string" 
                @bind-Value="activeUserId" 
                class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none"
            >
                @foreach (var user in users)
                {
                    <option value="@user.Id">@user.Name</option>
                }
            </InputSelect>
        </div>
    </div>

    <ChannelsBlock></ChannelsBlock>
</aside>

<main class="flex min-h-[70vh] flex-1 flex-col bg-slate-50">
    <div class="border-b border-slate-200 bg-white px-4 py-4 sm:px-6">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <div class="flex items-center gap-3">
                    @if (selectedView == "channel")
                    {
                        <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-cyan-100 text-cyan-700">
                            <i class="fa-solid fa-hashtag"></i>
                        </span>
                    }
                    else
                    {
                        <span class="flex h-11 w-11 items-center justify-center rounded-full bg-violet-100 text-violet-700">
                            @GetInitials(ActiveDirectContact?.Name ?? "DM")
                        </span>
                    }
                    <div>
                        <h2 class="text-lg font-semibold text-slate-900">@ActiveTitle</h2>
                        <p class="text-sm text-slate-500">@ActiveSubtitle</p>
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-500">
                <span class="rounded-full border border-slate-300 bg-white px-3 py-1.5">@ActiveUser.Name</span>
                <span class="rounded-full border border-slate-300 bg-white px-3 py-1.5">@VisibleMessages.Count() messages</span>
            </div>
        </div>
    </div>

    <div class="flex-1 space-y-4 overflow-y-auto bg-slate-50 px-4 py-5 sm:px-6">
        @if (VisibleMessages.Any())
        {
            @foreach (var message in VisibleMessages)
            {
                var sender = GetUserById(message.SenderId);
                var isMine = message.SenderId == activeUserId;
                <div class="@($"flex {(isMine ? "justify-end" : "justify-start")}")">
                    <div class="@($"max-w-xl rounded-3xl border px-4 py-3 shadow-sm {(isMine ? "border-cyan-200 bg-cyan-50" : "border-slate-200 bg-white")}")">
                        <div class="mb-1 flex items-center gap-2 text-xs">
                            <span class="@($"font-semibold {(isMine ? "text-cyan-700" : "text-slate-700")}")">@sender.Name</span>
                            <span class="text-slate-500">@message.SentAt.ToString("HH:mm")</span>
                        </div>
                        <p class="text-sm leading-6 text-slate-900">@message.Text</p>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="flex h-full min-h-[20rem] items-center justify-center">
                <div class="max-w-md rounded-3xl border border-dashed border-slate-300 bg-white p-8 text-center shadow-sm">
                    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-100 text-slate-500">
                        <i class="fa-regular fa-comments text-2xl"></i>
                    </div>
                    <h3 class="mt-4 text-lg font-semibold text-slate-900">No messages yet</h3>
                    <p class="mt-2 text-sm text-slate-500">Start the conversation with a first message in this chat.</p>
                </div>
            </div>
        }
    </div>

    <div class="border-t border-slate-200 bg-white px-4 py-4 sm:px-6">
        <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-slate-500">
            <span class="rounded-full bg-slate-100 px-3 py-1">Mock real-time</span>
            <span class="rounded-full bg-slate-100 px-3 py-1">Direct + channels</span>
            <button class="rounded-full border border-slate-300 px-3 py-1 text-slate-700 transition hover:border-slate-400 hover:bg-slate-50 hover:text-slate-900" @onclick="SeedReply">
                Simulate reply
            </button>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
            <InputTextArea @bind-Value="draftMessage" class="min-h-[88px] flex-1 rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none" placeholder="Type your message..." />
            <button class="inline-flex items-center justify-center gap-2 rounded-2xl bg-cyan-600 px-5 py-3 font-semibold text-white transition hover:bg-cyan-700 disabled:cursor-not-allowed disabled:opacity-50" @onclick="SendMessage" disabled="@string.IsNullOrWhiteSpace(draftMessage)">
                <i class="fa-solid fa-paper-plane"></i>
                <span>Send</span>
            </button>
        </div>
    </div>
</main>
