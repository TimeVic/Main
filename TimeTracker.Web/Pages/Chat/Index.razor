@page "/chat"

@inherits BaseReactiveComponent
@layout TimeTracker.Web.Pages.Chat.Shared.Layout

@using BlazorApp.Models
@using TimeTracker.Web.Pages.Chat.Parts
@using TimeTracker.Web.Pages.Chat.Parts.Messages

<aside class="w-full border-b border-slate-200 bg-white lg:w-80 lg:border-b-0 lg:border-r">
    <WorkspaceMenuBlock></WorkspaceMenuBlock>
    <ChannelsBlock></ChannelsBlock>
</aside>

<main class="flex min-h-[70vh] flex-1 flex-col bg-slate-50">
    <div class="border-b border-slate-200 bg-white px-4 py-4 sm:px-6">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <div class="flex items-center gap-3">
                    @if (selectedView == "channel")
                    {
                        <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-cyan-100 text-cyan-700">
                            <i class="fa-solid fa-hashtag"></i>
                        </span>
                    }
                    else
                    {
                        <span class="flex h-11 w-11 items-center justify-center rounded-full bg-violet-100 text-violet-700">
                            @GetInitials(ActiveDirectContact?.Name ?? "DM")
                        </span>
                    }
                    <div>
                        <h2 class="text-lg font-semibold text-slate-900">@ActiveTitle</h2>
                        <p class="text-sm text-slate-500">@ActiveSubtitle</p>
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-500">
                <span class="rounded-full border border-slate-300 bg-white px-3 py-1.5">@ActiveUser.Name</span>
                <span class="rounded-full border border-slate-300 bg-white px-3 py-1.5">@VisibleMessages.Count() messages</span>
            </div>
        </div>
    </div>

    <MessagesListBlock></MessagesListBlock>

    <div class="border-t border-slate-200 bg-white px-4 py-4 sm:px-6">
        <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-slate-500">
            <span class="rounded-full bg-slate-100 px-3 py-1">Mock real-time</span>
            <span class="rounded-full bg-slate-100 px-3 py-1">Direct + channels</span>
            <button class="rounded-full border border-slate-300 px-3 py-1 text-slate-700 transition hover:border-slate-400 hover:bg-slate-50 hover:text-slate-900" @onclick="SeedReply">
                Simulate reply
            </button>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
            <InputTextArea @bind-Value="draftMessage" class="min-h-[88px] flex-1 rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none" placeholder="Type your message..." />
            <button class="inline-flex items-center justify-center gap-2 rounded-2xl bg-cyan-600 px-5 py-3 font-semibold text-white transition hover:bg-cyan-700 disabled:cursor-not-allowed disabled:opacity-50" @onclick="SendMessage" disabled="@string.IsNullOrWhiteSpace(draftMessage)">
                <i class="fa-solid fa-paper-plane"></i>
                <span>Send</span>
            </button>
        </div>
    </div>
</main>
