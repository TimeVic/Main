@inherits BaseReactiveComponent

<div class="border-t border-slate-200 bg-white px-4 py-4 sm:px-6">
    <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-slate-500">
        <span class="rounded-full bg-slate-100 px-3 py-1">Mock real-time</span>
        <span class="rounded-full bg-slate-100 px-3 py-1">Direct + channels</span>
        <button 
            class="rounded-full border border-slate-300 px-3 py-1 text-slate-700 transition hover:border-slate-400 hover:bg-slate-50 hover:text-slate-900" 
            @onclick="SeedReply"
        >
            Simulate reply
        </button>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
        <InputTextArea 
            @bind-Value="@_messageText"
            @oninput="OnMessageChanged" 
            class="min-h-[88px] flex-1 rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none" 
            placeholder="Type your message..." />
        <button 
            class="inline-flex items-center justify-center gap-2 rounded-2xl bg-cyan-600 px-5 py-3 font-semibold text-white transition hover:bg-cyan-700 disabled:cursor-not-allowed disabled:opacity-50" 
            @onclick="SendMessage" 
            disabled="@(!IsCanSend)">
            <i class="fa-solid fa-paper-plane"></i>
            <span>Send</span>
        </button>
    </div>
</div>
