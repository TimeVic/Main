@page "/"

@using TimeTracker.Web.Pages.Landing.Shared

@inherits BaseReactiveComponent
@layout Layout

<FluentStack Orientation="Orientation.Horizontal">
    <FluentLabel
        Class="mt-4"
        Typo="Typography.H3">
        Free and <a href="https://github.com/TimeVic/Main" target="_blank">open source</a> time tracker
        <br/>
        for you or your team.
    </FluentLabel>

    <FluentLabel
        Class="mb-4"
        Typo="Typography.Body">
        Add your team members to your workspace to track time spent within a team.
    </FluentLabel>

    <FluentLabel
        Class="mt-4"
        Typo="Typography.Body">
        Track your time across projects.
    </FluentLabel>
</FluentStack>

@code
{
    [Inject] 
    private NavigationManager _navigationManager { get; set; }
    
    protected override void OnInitialized()
    {
        base.OnInitialized();
        AuthState.StateChanged += (sender, args) =>
        {
            if (AuthState.Value.IsLoggedIn)
            {
                _navigationManager.NavigateTo(SiteUrl.DashboardBase);
            }
            else
            {
                _navigationManager.NavigateTo(SiteUrl.Login);
            }
        };
    }
}
