@inherits BaseLayout

<FluentMainLayout NavMenuTitle="TimeVic" Style="min-height: calc(100% - 40px)">
    <Header>
        TimeVic
        <MainHeader/>
    </Header>
    <Body>
        <FluentBodyContent>
            @Body
        </FluentBodyContent>
        @if (!IsShowReCaptcha)
        {
            <style>
                    .grecaptcha-badge {
                        visibility: hidden;
                    }
                </style>
        }
    </Body>
</FluentMainLayout>
<FluentFooter>
    Copyright © @DateTime.Now.Year <a href="https://georgyshira.info/" target="_blank">Georgy Shira</a> Apache License Version 2.0
</FluentFooter>

<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />
