@inherits BaseLayout

@using MudBlazor

<MudLayout>
    <MainHeader/>
    <MudMainContent>
        <MudPaper>
            <div>
                @Body
            </div>
            @if (!IsShowReCaptcha)
            {
                <style>
                    .grecaptcha-badge {
                        visibility: hidden;
                    }
                </style>
            }
            
        </MudPaper>
    </MudMainContent>
    <MudContainer>
        <MudText Typo="Typo.subtitle2" Align="Align.Center">
            Copyright © @DateTime.Now.Year <a href="https://georgyshira.info/" target="_blank">Georgy Shira</a> Apache License Version 2.0
        </MudText>
    </MudContainer>
</MudLayout>
