@page "/login"

@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Public.User
@using TimeTracker.Web.Pages.Landing.Shared
@using MudBlazor

@inherits BaseReactiveComponent
@layout Layout

<MudStack Justify="Justify.Center" AlignItems="MudBlazor.AlignItems.Center">
    <MudCard Style="width: 300px" Class="mt-5 mb-5">
        <MudCardContent>
            <MudForm
                @ref="_form"
                @bind-IsValid="_isValid">

                <MudText Typo="Typo.h4">Sign In</MudText>

                <MudStack>
                    <MudTextField
                        T="string"
                        For="() => model.Email"
                        Disabled="_isLoading"
                        @bind-Text="@model.Email"
                        Placeholder="Enter your email"/>

                    <MudTextField
                        T="string"
                        InputType="InputType.Password"
                        For="() => model.Password"
                        Disabled="_isLoading"
                        @bind-Text="@model.Password"
                        Placeholder="Your password"/>
                </MudStack>
            </MudForm>
        </MudCardContent>
        <MudCardActions Class="d-flex justify-space-between">
            <MudButton
                Variant="MudBlazor.Variant.Filled"
                OnClick="Submit"
                Color="Color.Primary">
                Login
            </MudButton>

            <MudButton
                Variant="MudBlazor.Variant.Text"
                Href="/user/password-reset"
                Color="Color.Transparent">
                Forgot password?
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudStack>
