@page "/user/password-reset"

@using TimeTracker.Web.Pages.Landing.Shared

@inherits BaseReactiveComponent
@layout Layout


<FluentStack HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
    <FluentCard Style="width: 300px" Class="mt-5 mb-5">
        <EditForm
            Model="model"
            @ref="_form"
            novalidate>
            <DataAnnotationsValidator />

            <FluentLabel Typo="Typography.H2" Class="mb-3">Reset password</FluentLabel>

            <FluentStack Orientation="Orientation.Vertical" Class="mb-3">
                <FluentTextField
                    style="width: 100%;"
                    Disabled="_isLoading"
                    ValueExpression="() => model.Email"
                    Value="@model.Email"
                    ValueChanged="value => model.Email = value"
                    InputMode="InputMode.Email"
                    Placeholder="Enter your email">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Slot="start" Color="Color.Neutral"/>
                </FluentTextField>
            </FluentStack>
        </EditForm>
        <div Class="d-flex justify-space-between">
            <FluentButton
                Appearance="@Appearance.Accent"
                OnClick="Submit">
                Submit
            </FluentButton>
            <FluentSpacer></FluentSpacer>
            <FluentAnchor
                Href="/login">
                Login
            </FluentAnchor>
        </div>
    </FluentCard>
</FluentStack>
