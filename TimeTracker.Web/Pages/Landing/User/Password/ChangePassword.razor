@page "/user/change-password/{token}"

@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Public.User
@using TimeTracker.Web.Pages.Landing.Shared
@using MudBlazor

@inherits BaseComponent
@layout Layout


<MudStack Justify="Justify.Center" AlignItems="MudBlazor.AlignItems.Center">
    <MudCard Style="width: 300px" Class="mt-5 mb-5">
        <MudCardContent>
            <MudForm
                @ref="_form"
                @bind-IsValid="_isValid">

                <MudText Typo="Typo.h4">Change Password</MudText>

                <MudStack>
                    <MudTextField
                        T="string"
                        InputType="InputType.Password"
                        For="() => model.Password"
                        Disabled="_isLoading"
                        @bind-Text="@model.Password"
                        Placeholder="Your password"/>
                </MudStack>
            </MudForm>
        </MudCardContent>
        <MudCardActions Class="d-flex justify-space-between">
            <MudButton
                Variant="MudBlazor.Variant.Filled"
                OnClick="Submit"
                Color="Color.Primary">
                Change password
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudStack>
