@page "/registration/verification/{verificationToken}"

@using Microsoft.AspNetCore.Components
@using TimeTracker.Web.Pages.Landing.Shared
@using MudBlazor

@layout Layout
@inherits BaseComponent

<MudStack Justify="Justify.Center" AlignItems="MudBlazor.AlignItems.Center">
    <MudCard Style="width: 300px" Class="mt-5 mb-5">
        <MudCardContent>
            <MudForm
                @ref="_form"
                @bind-IsValid="_isValid">

                <MudText Typo="Typo.h4">Registration - Step 2</MudText>

                <MudStack>
                    <MudTextField
                        T="string"
                        InputType="InputType.Password"
                        For="() => model.Password"
                        Disabled="_isLoading"
                        @bind-Text="@model.Password"
                        Placeholder="Enter your password to finish registration"/>
                </MudStack>
            </MudForm>
        </MudCardContent>
        <MudCardActions Class="d-flex justify-space-between">
            <MudButton
                Variant="MudBlazor.Variant.Filled"
                OnClick="Submit"
                Color="Color.Primary">
                Continue
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudStack>
