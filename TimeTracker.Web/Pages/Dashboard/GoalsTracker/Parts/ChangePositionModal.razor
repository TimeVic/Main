@inherits BaseComponent

<MudDialog Style="min-width: 300px;">
    <DialogContent>
        <Dropzone Items="@_goals">
            <MudCard Class="pa-2 mb-2 cursor-move">@context.Name</MudCard>
        </Dropzone>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@OnCloseModal">Cancel</MudButton>
        <MudButton
            ButtonType="MudBlazor.ButtonType.Submit"
            OnClick="@Submit"
            Color="Color.Primary">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>
