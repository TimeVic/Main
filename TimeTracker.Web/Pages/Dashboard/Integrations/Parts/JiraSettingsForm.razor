@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Workspace
@using Microsoft.AspNetCore.Components

@inherits BaseComponent

<RadzenTemplateForm TItem="SetJiraSettingsRequest" Data="@_model" Submit="HandleSubmit">
    <DataAnnotationsValidator/>
    <ValidationSummary/>

    <div class="row">
        <div class="col">
            <RadzenLabel
                Text="Url"
                TextStyle="@TextStyle.Subtitle2"/>
            <RadzenTextBox
                disabled="@_isLoading"
                @bind-Value="@_model.Url"
                AutoComplete="false"
                Name="Url"
                Class="w-100"/>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <RadzenLabel
                Text="User Name"
                TextStyle="@TextStyle.Subtitle2"/>
            <RadzenTextBox
                disabled="@_isLoading"
                @bind-Value="@_model.UserName"
                AutoComplete="false"
                Name="UserName"
                Class="w-100"/>
        </div>
        <div class="col">
            <RadzenLabel
                Text="Api Key"
                TextStyle="@TextStyle.Subtitle2"/>
            <RadzenPassword
                disabled="@_isLoading"
                @bind-Value="@_model.ApiKey"
                AutoComplete="false"
                Name="ApiKey"
                Class="w-100"/>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-12 d-flex align-items-end justify-content-center mt-4">
            <RadzenButton
                ButtonType="ButtonType.Submit"
                Disabled="@_isLoading"
                class="ml-3"
                Text="Save"/>
        </div>
    </div>
</RadzenTemplateForm>
