@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Workspace
@using Microsoft.AspNetCore.Components
@using MudBlazor

@inherits BaseComponent

<MudForm
    @ref="_form"
    @bind-IsValid="_isValid">

    <MudStack Class="pa-4">
        <MudTextField
            T="string"
            Name="Security Key"
            InputType="InputType.Password"
            @bind-Value="@_model.SecurityKey"
            Placeholder="Task title"/>

        <MudTextField
            T="string"
            Name="Team Id"
            @bind-Value="@_model.TeamId"
            Placeholder="External task ID"/>

        <MudCheckBox
            T="bool"
            Label="Is custom Task IDs"
            @bind-Value="@_model.IsCustomTaskIds"/>

        <div class="d-flex align-center justify-space-end">
            <MudButton
                Variant="MudBlazor.Variant.Filled"
                Color="Color.Primary"
                Disabled="@(!_isValid || _isLoading)"
                OnClick="HandleSubmit"
                Class="ml-auto">
                Save
            </MudButton>
        </div>
    </MudStack>
</MudForm>
