@page "/board/integrations"

@using TimeTracker.Web.Pages.Dashboard.Shared
@using TimeTracker.Web.Pages.Dashboard.Integrations.Parts

@inherits BaseComponent
@layout Layout

@if (_isLoading)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate"/>
}
else
{
    <RadzenTabs TabPosition="@TabPosition.Top" RenderMode="TabRenderMode.Client" >
        <Tabs>
            <RadzenTabsItem 
                Text="ClickUp" 
                Icon="@(_settings.IntegrationClickUp is { IsActive: true } ? "cloud_done" : "signal_disconnected")">
                <ClickUpSettingsForm @bind-Value="_settings.IntegrationClickUp"/>
            </RadzenTabsItem>
            <RadzenTabsItem 
                Text="Redmine"
                Icon="@(_settings.IntegrationRedmine is { IsActive: true } ? "cloud_done" : "signal_disconnected")">
                <RedmineSettingsForm @bind-Value="_settings.IntegrationRedmine"/>
            </RadzenTabsItem>
            <RadzenTabsItem 
                Text="Jira"
                Icon="@(_settings.IntegrationJira is { IsActive: true } ? "cloud_done" : "signal_disconnected")">>
                <JiraSettingsForm @bind-Value="_settings.IntegrationJira"/>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>    
}
