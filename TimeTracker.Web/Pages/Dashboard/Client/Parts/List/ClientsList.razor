@inherits BaseReactiveComponent

@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants
@using MudBlazor

<MudTable
    Class="mt-2 w-100"
    Items="@_state.Value.List"
    Hover="true"
    Dense="true"
    Outlined="true"
    Breakpoint="Breakpoint.Sm"
    Loading="@_state.Value.IsListLoading"
    LoadingProgressColor="Color.Info">

    <ToolBarContent>
        <MudText Typo="Typo.h6">Clients</MudText>
        <MudSpacer/>
        <MudButton
            OnClick="@OnAdd"
            Disabled="@(!AuthState.Value.IsRoleAdmin)"
            StartIcon="@Icons.Material.Filled.Add">
            Add
        </MudButton>
    </ToolBarContent>

    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh></MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Project">@context?.Name</MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton
                Icon="@Icons.Material.Filled.Edit"
                Disabled="@(!AuthState.Value.IsRoleAdmin || true)"
                Size="Size.Small"/>
        </MudTd>
    </RowTemplate>
</MudTable>
