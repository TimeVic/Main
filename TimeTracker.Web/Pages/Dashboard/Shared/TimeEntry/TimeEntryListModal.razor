        <FluentIcon Value="@(new Icons.Regular.Size24.Timer())" />
        <FluentLabel Typo="Typography.PaneHeader">
            My Time Entries
        </FluentLabel>
    </FluentStack>
</FluentDialogHeader>

<FluentDialogBody>
    <TimeEntryList IsFilteredList="@Content.IsFilteredList"/>
</FluentDialogBody>
