@inherits BaseReactiveComponent

@using TimeTracker.Web.Pages.Dashboard.Shared.Tasks

<div class="w-time-entry-list w-100 mb-3 @Class">

    <FluentDataGrid 
        Loading="_state.Value.IsListLoading"
        Items="@_list.AsQueryable()" 
        ShowHover="true">
        @if (IsFilteredList)
        {
            <PropertyColumn 
                Width="100px"
                Title="User"
                Property="@(p => p.User.Name)" 
                Sortable="false"/>
        }
        <TemplateColumn
            Title="Date"
            Width="100px"
            Sortable="false">
            @context.Date.ToShortDateString()
        </TemplateColumn>
        <TemplateColumn
            Title="Time"
            Width="130px"
            Sortable="false">
            @_timeParsingService.TimeSpanToTimeString(context.StartTime) - @_timeParsingService.TimeSpanToTimeString(context.EndTime.Value)
        </TemplateColumn>
        <PropertyColumn
            Title="Duration"
            Width="90px"
            Property="@(p => @_timeParsingService.TimeSpanToTimeString(p.Duration, true))"
            Sortable="false"/>
        <TemplateColumn
            Title="Project"
            Tooltip="true"
            Sortable="false">
            @context.Project?.Name
        </TemplateColumn>
        <TemplateColumn
            Title="Task"
            Width="100px"
            Sortable="false">
            <div @onclick:stopPropagation="true">
                @if (context.Task != null)
                {
                    <TaskIdBadge
                        IsClickable="true"
                        InternalTask="@context.Task"/>
                }
                else
                {
                    <FluentButton
                        IconStart="@(new Icons.Regular.Size20.Add())"
                        OnClick="@(() => ShowAddTaskModal(context.Id))"/>
                }
            </div>
        </TemplateColumn>
        <TemplateColumn
            Title="Description"
            Tooltip="true"
            Sortable="false">
            @GetDescriptionLabel(context)
        </TemplateColumn>
        <TemplateColumn
            Title="Billable"
            Width="120px"
            Align="Align.Center"
            Sortable="false">
            @if (context.IsBillable)
            {
                <FluentIcon Value="@(new Icons.Regular.Size20.Check())"></FluentIcon>
            }
        </TemplateColumn>
        <TemplateColumn
            Title="Actions"
            Width="140px"
            Sortable="false">
            <FluentButton
                IconStart="@(new Icons.Regular.Size20.Copy())"
                OnClick="@(() => OnStartCloned(context))"/>
            <FluentButton
                IconStart="@(new Icons.Regular.Size20.Edit())"
                OnClick="@(() => OnEditClick(context))"/>
            <FluentButton
                IconStart="@(new Icons.Regular.Size20.Delete())"
                OnClick="@(() => OnDeleteItemAsync(context))"/>
        </TemplateColumn>
    </FluentDataGrid>

    @if (_groupedList.Any())
    {
        <FluentPaginator
            CurrentPageIndexChanged="OnPaginated"
            State="@_paginationState"/>
    }
    else
    {
        <FluentLabel Typo="Typography.Body">
            No entries
        </FluentLabel>
    }

</div>
