@inherits BaseComponent

@using TimeTracker.Web.Shared.Components.Form
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants
@using MudBlazor
@using TimeTracker.Business.Common.Utils
@using TimeTracker.Business.Extensions
@using TimeTracker.Web.Pages.Dashboard.Shared.Tasks
@using Variant = MudBlazor.Variant

<div class="w-time-entry-list w-100 @Class">
    <MudDataGrid
        T="TimeEntryDto"
        Items="@_list"
        SortMode="SortMode.None"
        ReadOnly="false"
        Outlined="Outlined"
        EditMode="MudBlazor.DataGridEditMode.Cell"
        EditTrigger="DataGridEditTrigger.OnRowClick"
        Loading="@_state.Value.IsListLoading"
        Groupable="true"
        FixedHeader="true"
        GroupExpanded="@true"
        Dense="true"
        GroupClassFunc="OnGroupTimeEntry">
        <Columns>
            @if (IsFilteredList)
            {
                <PropertyColumn
                    T="TimeEntryDto"
                    TProperty="string"
                    Property="@(x => x.User.Name)"
                    Title="User"/>
            }
            <PropertyColumn
                T="TimeEntryDto"
                TProperty="string"
                Property="@(x => _timeParsingService.TimeSpanToTimeString(x.Duration, true))"
                IsEditable="false"
                Title="Duration"/>

            <PropertyColumn
                T="TimeEntryDto"
                TProperty="TimeEntryDto"
                Property="@(x => x)"
                Title="Start Time">
                <EditTemplate>
                    <TimeInput
                        Class="mr-1"
                        ValueChanged="@((value) => OnChangeStartTime(context.Item, value))"
                        Value="@context.Item.StartTime"/>
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn
                T="TimeEntryDto"
                TProperty="TimeEntryDto"
                Property="@(x => x)"
                Title="End Time">
                <EditTemplate>
                    <TimeInput
                        Class="ml-1"
                        ValueChanged="@((value) => OnChangeEndTime(context.Item, value))"
                        Value="@context.Item.EndTime.Value"/>
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn
                T="TimeEntryDto"
                TProperty="TimeEntryDto"
                Property="@(x => x)"
                Title="Project">
                <EditTemplate>
                    <ProjectsDropDown
                        Value="@(context.Item.Project?.Id ?? 0)"
                        SelectedItemChanged="project => OnChangeProject(context.Item, project)"/>
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn
                T="TimeEntryDto"
                TProperty="TimeEntryDto"
                Property="@(x => x)"
                Title="Task ID">
                <EditTemplate>
                    @if (context.Item.Task != null)
                    {
                        <TaskIdBadge
                            IsClickable="true"
                            InternalTask="@context.Item.Task"/>
                    }
                    else
                    {
                        <MudIconButton
                            Size="Size.Small"
                            Variant="Variant.Outlined"
                            Color="Color.Info"
                            OnClick="@(() => ShowAddTaskModal(context.Item.Id))"
                            Icon="@Icons.Material.Filled.Add"/>
                    }
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn
                T="TimeEntryDto"
                TProperty="TimeEntryDto"
                Property="x => x"
                Title="Description">
                <EditTemplate>
                    <MudTextField
                        T="string"
                        Placeholder="@(GetDescriptionLabel(context.Item))"
                        Value="@context.Item.Description"
                        ValueChanged="@(value => OnChangeDescription(context.Item, value))"
                        Variant="@Variant.Text"/>
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn
                T="TimeEntryDto"
                TProperty="TimeEntryDto"
                Property="x => x"
                Title="Billable">
                <EditTemplate>
                    <MudCheckBox
                        T="Boolean"
                        CheckedChanged="@(value => OnChangeIsBillable(context.Item, value))"
                        Checked="@context.Item.IsBillable"/>
                </EditTemplate>
            </PropertyColumn>

            <PropertyColumn
                Property="x => x.Date.ToShortDateString()"
                Title="Category"
                Grouping
                Hidden="true"
                GroupBy="@_groupBy">
                <GroupTemplate>
                    <span style="font-weight:bold">@context.Grouping.Key</span>
                </GroupTemplate>
            </PropertyColumn>

            <PropertyColumn
                Property="x => x"
                IsEditable="false">
                <CellTemplate>
                    <MudIconButton
                        Size="@Size.Small"
                        Variant="@Variant.Text"
                        Icon="@Icons.Material.Filled.Delete"
                        OnClick="() => OnDeleteItemAsync(context.Item)"
                        Color="@Color.Secondary"/>
                </CellTemplate>
            </PropertyColumn>
        </Columns>
        <PagerContent>
            <MudPagination
                class="pa-4"
                Disabled="_isLoading"
                Color="Color.Primary"
                Count="@_totalPages"
                Selected="@_selectedPage"
                SelectedChanged="@OnSelectPage"/>
        </PagerContent>
    </MudDataGrid>

</div>
