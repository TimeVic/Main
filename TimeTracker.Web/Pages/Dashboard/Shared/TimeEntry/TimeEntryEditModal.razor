
@implements IDialogContentComponent<TimeEntryEditModal.Parameters>
@using TimeTracker.Web.Pages.Dashboard.Shared.Tasks
@inherits BaseComponent

<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentIcon Value="@(new Icons.Regular.Size24.WindowApps())"/>
        <FluentLabel Typo="Typography.PaneHeader">
            Edit time entry
        </FluentLabel>
        @if (Content.TimeEntry.Task != null)
        {
            <TaskIdBadge IsLink="true" InternalTask="Content.TimeEntry.Task"/>
        }
    </FluentStack>
</FluentDialogHeader>

@* Body *@
<FluentDialogBody>
    <EditForm
        @ref="_form"
        Model="@Content.TimeEntry"
        novalidate>
        <DataAnnotationsValidator />
        <FluentValidationSummary />

        @if (Content.TimeEntry.Task == null)
        {
            <ProjectsDropDown
                Class="mb-3"
                FullWidth="true"
                Label="Project"
                Clearable="true"
                Value="@(Content.TimeEntry.Project?.Id ?? Guid.Empty)"
                SelectedItemChanged="@OnProjectChanged"/>
        }
        
        <FluentCard>
            <FluentStack Orientation="Orientation.Horizontal">
                <div>
                    <FluentDatePicker
                        Label="Date"
                        Value="@Content.TimeEntry.Date.ToDateTime(TimeOnly.MinValue)"
                        ValueChanged="@OnDateChanged"/>
                </div>

                <div>
                    <TimeEditField
                        Label="Start"
                        Value="@Content.TimeEntry.StartTime"
                        ValueChanged="@OnChangeStartTime"
                    />
                </div>
                <div>
                    <TimeEditField
                        Label="End"
                        Value="@Content.TimeEntry.EndTime"
                        ValueChanged="@OnChangeEndTime"/>

                </div>
            </FluentStack>

            <FluentLabel Typo="Typography.Body" Class="mb-3">
                Duration: <b>@_timeParsingService.TimeSpanToTimeString(_duration, true)</b>
            </FluentLabel>
        </FluentCard>

        <FluentCard Class="mt-3 mb-3">
            <FluentLabel Typo="Typography.Subject">Description</FluentLabel>
            <FluentTextArea
                Value="@Content.TimeEntry.Description"
                ValueChanged="OnChangeDescription"
                Class="mb-3 w-100"
                Maxlength="500"
                Rows="5">
            </FluentTextArea>
        </FluentCard>

        <FluentCard Class="mt-3">
            <FluentLabel Typo="Typography.Subject">Pricing</FluentLabel>
            <FluentStack Class="mb-3" Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                <FluentCheckbox
                    Label="Billable"
                    @bind-Value="@Content.TimeEntry.IsBillable"/>

                <FluentNumberField
                    Label="Hourly Rate"
                    Required="@Content.TimeEntry.IsBillable"
                    @bind-Value="@(Content.TimeEntry.HourlyRate)"
                    Disabled="@(!Content.TimeEntry.IsBillable)"
                    Step=".01M"
                    Min="0.0M"/>
            </FluentStack>
        </FluentCard>

    </EditForm>
</FluentDialogBody>

@* Footer *@
<FluentDialogFooter>
    <FluentButton
        Appearance="Appearance.Accent"
        OnClick="@OnCloseModal">OK</FluentButton>
</FluentDialogFooter>
