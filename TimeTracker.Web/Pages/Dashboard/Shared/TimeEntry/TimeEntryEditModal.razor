@inherits BaseComponent

<MudDialog Style="min-width: 500px">
    <DialogContent>
        <MudForm
            @ref="_form"
            @bind-IsValid="_isValid">

            <MudDatePicker
                Class="ml-1 mb-2"
                Label="Date"
                Style="min-width: 110px"
                Clearable="false"
                Required="true"
                Elevation="3"
                AutoClose="true"
                IconSize="Size.Small"
                DateChanged="@((value) => TimeEntry.Date = value.Value)"
                Date="@TimeEntry.Date"/>

            <MudStack
                Row="true"
                Class="mb-2"
                Spacing="3">
                <TimeInput
                    Label="Start Time"
                    Style="min-width: 100px"
                    ValueChanged="@((value) => OnChangeStartTime(value))"
                    Value="@TimeEntry.StartTime"/>

                <TimeInput
                    Label="End Time"
                    Style="min-width: 100px"
                    ValueChanged="@((value) => OnChangeEndTime(value))"
                    Value="@TimeEntry.EndTime.Value"/>

                <MudField Label="Duration" Variant="Variant.Text">
                    @_timeParsingService.TimeSpanToTimeString(_duration, true)
                </MudField>
            </MudStack>

            <ProjectsDropDown
                Label="Project"
                Clearable="true"
                Value="@(TimeEntry.Project?.Id ?? 0)"
                SelectedItemChanged="@(project => TimeEntry.Project = project)"/>

            <MudStack
                Row="true"
                Class="mb-2"
                Spacing="3">

                <MudCheckBox
                    T="Boolean"
                    Class="mt-3"
                    Label="Billable"
                    @bind-Checked="@TimeEntry.IsBillable"/>

                <MudNumericField
                    T="decimal?"
                    Label="Hourly Rate"
                    Required="@TimeEntry.IsBillable"
                    @bind-Value="@(TimeEntry.HourlyRate)"
                    Variant="MudBlazor.Variant.Text"
                    Disabled="@(!TimeEntry.IsBillable)"
                    Step=".01M"
                    Min="0.0M"/>
            </MudStack>

            <MudTextField
                T="string"
                Required="false"
                Label="Description"
                Placeholder="Enter description"
                Variant="Variant.Outlined"
                @bind-Value="@TimeEntry.Description"
                Lines="5"
                MaxLength="512"/>

        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@OnCloseModal">Close</MudButton>
        <MudButton
            OnClick="@SubmitForm"
            Variant="Variant.Filled"
            Color="Color.Primary">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>
