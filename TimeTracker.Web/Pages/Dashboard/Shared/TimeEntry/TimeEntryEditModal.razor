
@implements IDialogContentComponent<TimeEntryEditModal.Parameters>
@using TimeTracker.Web.Shared.Components.Form
@using TimeTracker.Web.Shared.Components.Form.Select
@inherits BaseComponent

<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentIcon Value="@(new Icons.Regular.Size24.WindowApps())" />
        <FluentLabel Typo="Typography.PaneHeader">
            Edit time entry
        </FluentLabel>
    </FluentStack>
</FluentDialogHeader>

@* Body *@
<FluentDialogBody>
    <EditForm
        @ref="_form"
        Model="@Content.TimeEntry"
        novalidate>
        <DataAnnotationsValidator />
        <FluentValidationSummary />

        <FluentStack Orientation="Orientation.Horizontal">
            <div>
                <FluentDatePicker
                    Label="Date"
                    Value="@Content.TimeEntry.Date"
                    ValueChanged="@OnDateChanged"/>
            </div>

            <div>
                <FluentTimePicker
                    Label="Start"
                    Value="@(Content.TimeEntry.Date.ToUniversalTime().Add(Content.TimeEntry.StartTime))"
                    ValueChanged="@OnChangeStartTime"/>

            </div>
            <div>
                <FluentTimePicker
                    Label="End"
                    Value="@(Content.TimeEntry.Date.ToUniversalTime().Add(Content.TimeEntry.EndTime!.Value))"
                    ValueChanged="@OnChangeEndTime"/>

            </div>
        </FluentStack>

        <FluentLabel Typo="Typography.Body" Class="mb-3">
            Duration: <b>@_timeParsingService.TimeSpanToTimeString(_duration, true)</b>
        </FluentLabel>

        <ProjectsDropDown
            Class="mb-3"
            FullWidth="true"
            Label="Project"
            Clearable="true"
            Value="@(Content.TimeEntry.Project?.Id ?? 0)"
            SelectedItemChanged="@OnProjectChanged"/>

        <FluentStack Class="mb-3" Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
            <FluentCheckbox
                Label="Billable"
                @bind-Value="@Content.TimeEntry.IsBillable"/>

            <FluentNumberField
                Label="Hourly Rate"
                Required="@Content.TimeEntry.IsBillable"
                @bind-Value="@(Content.TimeEntry.HourlyRate)"
                Disabled="@(!Content.TimeEntry.IsBillable)"
                Step=".01M"
                Min="0.0M"/>
        </FluentStack>

        <FluentTextArea
            AriaLabel="Description"
            Value="@Content.TimeEntry.Description"
            ValueChanged="OnChangeDescription"
            Label="Description"
            Class="mb-3 w-100"
            Maxlength="500"
            Rows="5">
        </FluentTextArea>

    </EditForm>
</FluentDialogBody>

@* Footer *@
<FluentDialogFooter>
    <FluentButton
        Appearance="Appearance.Neutral"
        OnClick="@OnCloseModal">OK</FluentButton>
</FluentDialogFooter>
