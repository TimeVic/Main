@inherits BaseReactiveComponent

@using TimeTracker.Web.Shared.Components.Form
@using TimeTracker.Web.Pages.Dashboard.TimeEntry.Parts
@using TimeTracker.Web.Pages.Dashboard.Shared.Tasks
@using TimeTracker.Web.Shared.Components.Form.Select

<div Class="w-time-form @Class">
    <FluentToolbar>
        @if (_state.Value.HasActiveEntry)
        {
            <FluentButton
                OnClick="@(() => ToggleTimeEntry(false))"
                Appearance="Appearance.Stealth"
                Class="mr-3"
                IconStart="@(new Icons.Regular.Size24.Stop())"
                Disabled="@_state.Value.IsTimeEntryProcessing"/>
        }
        else
        {
            <FluentButton
                OnClick="@(() => ToggleTimeEntry(true))"
                Appearance="Appearance.Accent"
                Class="mr-3"
                IconStart="@(new Icons.Regular.Size24.Play())"
                Disabled="@_state.Value.IsTimeEntryProcessing"/>
        }
        @if (!IsShort)
        {
            <TimeCounterField
                Class="mr-3"
                Value="@_activeEntry?.StartTime"
                IsActive="@_hasActiveEntry"/>
        }

        @if (_activeEntry?.Task  == null && _activeEntry != null)
        {
            <FluentButton
                Disabled="@_state.Value.IsTimeEntryProcessing"
                Class="mr-3"
                Appearance="Appearance.Neutral"
                IconStart="@(new Icons.Regular.Size28.Add())"
                OnClick="@(() => ShowAddTaskModal(_activeEntry!.Id))"/>
        }

        @if (_activeEntry?.Task != null && !IsShort)
        {
            <TaskIdBadge
                Class="mr-3"
                InternalTask="@_activeEntry?.Task"
                IsClickable="true"/>
        }

        @if (!IsShort)
        {
            <FluentButton
                id="js_time_entry_details_btn"
                OnClick="@(() => _isDetailsOpened = !_isDetailsOpened)"
                Appearance="Appearance.Neutral"
                Class="mr-3"
                Disabled="@(!_state.Value.HasActiveEntry || _state.Value.IsTimeEntryProcessing)"
                IconStart="@(new Icons.Regular.Size24.ArrowDown())"/>
        }
        
        @if (IsShowTimeEntriesButton)
        {
            <FluentButton
                IconStart="@(new Icons.Filled.Size24.History())"
                Disabled="@_state.Value.IsTimeEntryProcessing"
                Class="mr-3"
                OnClick="@ShowTimeEntriesModal"/>
        }
        
        <FluentPopover Style="width: 400px;" VerticalThreshold="170" AnchorId="js_time_entry_details_btn" @bind-Open="_isDetailsOpened">
            <Body>
                <div style="width: calc(100% - 30px)">
                    @if (_activeEntry?.Task == null)
                    {
                        <ProjectsDropDown
                            Label="Project"
                            FullWidth="true"
                            Disabled="!_state.Value.HasActiveEntry"
                            Value="@(_activeEntry?.Project?.Id ?? 0)"
                            SelectedItemChanged="OnChangeProject"
                            Class="mb-3 w-100"/>
                    }
                    <FluentTextArea
                        AriaLabel="Description"
                        Disabled="@(!_state.Value.HasActiveEntry)"
                        Value="@_activeEntry?.Description"
                        ValueChanged="OnChangeDescription"
                        Label="@(GetDescriptionLabel(@_activeEntry))"
                        Class="mb-3 w-100"
                        Maxlength="500"
                        Rows="5">
                    </FluentTextArea>
                </div>
            </Body>
        </FluentPopover>

        @* <FluentButton Appearance="Appearance.Accent">Accent Button</FluentButton> *@
        @* <FluentButton Appearance="Appearance.Stealth">Stealth Button</FluentButton> *@
