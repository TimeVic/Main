@inherits BaseLayout
<FluentMainLayout NavMenuTitle="TimeVic" Style="min-height: calc(100% - 40px)">
    <Header>
        TimeVic
        <FluentStack HorizontalAlignment="HorizontalAlignment.Center">
            <MainHeader/>
        </FluentStack>
    </Header>
    <Body>
        @if (CommonState.Value.IsInitialized)
        {
            <InitializationContainer>
                <FluentBodyContent>
                    @Body
                </FluentBodyContent>
            </InitializationContainer>
        }
        else
        {
            <FluentProgressRing></FluentProgressRing>
        }
        @if (!IsShowReCaptcha)
        {
            <style>
                .grecaptcha-badge {
                    visibility: hidden;
                }
            </style>
        }
    </Body>
    <NavMenuContent>
        <NavMenu/>
    </NavMenuContent>
</FluentMainLayout>
<FluentFooter>
    Copyright © @DateTime.Now.Year <a href="https://georgyshira.info/" target="_blank">Georgy Shira</a> Apache License Version 2.0
</FluentFooter>

<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />
