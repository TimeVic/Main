@using MudBlazor

@inherits BaseLayout

<RadzenContextMenu/>
<RadzenDialog/>
<RadzenTooltip/>
<RadzenNotification Style="bottom: 1em; top: unset"/>

<MudLayout>
    @if (CommonState.Value.IsInitialized)
    {
        <MainHeader/>
    }
    @if (CommonState.Value.IsInitialized && IsShowMainMenu)
    {
        <NavMenu/>
    }
    <MudMainContent Class="pt-16 px-1">
        <MudContainer
            MaxWidth="MaxWidth.False"
            class="d-flex mt-6">
            <MudStack
                Justify="Justify.FlexStart"
                AlignItems="AlignItems.Center"
                Style="width: 100%;">
                @if (CommonState.Value.IsInitialized)
                {
                    <InitializationContainer>
                        @Body
                    </InitializationContainer>
                }
                else
                {
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
                }
            </MudStack>
            @if (!IsShowReCaptcha)
            {
                <style>
                    .grecaptcha-badge {
                        visibility: hidden;
                    }
                </style>
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>
