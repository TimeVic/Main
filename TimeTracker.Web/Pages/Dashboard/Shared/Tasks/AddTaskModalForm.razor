@using MudBlazor

@inherits BaseComponent

<MudDialog>
    <DialogContent>
        <MudForm
            @ref="_form"
            @bind-IsValid="_isValid">
            <MudTextField
                T="string"
                Name="Title"
                @bind-Value="model.Title"
                Placeholder="Task title"/>
            
            <MudTextField
                T="string"
                Name="Title"
                @bind-Value="model.ExternalTaskId"
                Placeholder="External task ID"/>
            
            <TaskListsDropDown
                For="() => model.TaskListId"
                Required="true"
                Value="@model.TaskListId"
                ValueChanged="@(value => model.TaskListId = value ?? 0)"/>
            
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCloseModal">Cancel</MudButton>
        <MudButton 
            ButtonType="MudBlazor.ButtonType.Submit"
            OnClick="Submit"
            Disabled="@_isLoading"
            Color="Color.Primary">Add</MudButton>
    </DialogActions>
</MudDialog>
