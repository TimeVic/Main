@using TimeTracker.Web.Shared.Components.Form.Select

@inherits BaseComponent
@implements IDialogContentComponent<AddTaskModalForm.Parameters>

<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentIcon Value="@(new Icons.Regular.Size24.WindowApps())" />
        <FluentLabel Typo="Typography.PaneHeader">
            Add new task
        </FluentLabel>
    </FluentStack>
</FluentDialogHeader>

@* Footer *@
<FluentDialogFooter>
    <FluentButton 
        Appearance="Appearance.Accent"
        Disabled="@_isLoading"
        OnClick="@Submit">Add</FluentButton>
    <FluentButton 
        Appearance="Appearance.Neutral"
        OnClick="@OnCloseModal">Cancel</FluentButton>
</FluentDialogFooter>

@* Body *@
<FluentDialogBody>
    <EditForm
        @ref="_form"
        Model="@model"
        novalidate>
        <DataAnnotationsValidator />
        <FluentValidationSummary />

        <TaskListsDropDown
            Required="true"
            Class="mb-3"
            FullWidth="true"
            Value="@model.TaskListId"
            SelectedItemChanged="@(value => model.TaskListId = value?.Id ?? 0)"/>
        
        <FluentDivider Class="mb-3"/>
        <FluentStack Orientation="Orientation.Horizontal">

            <FluentTextField
                T="string"
                Name="Title"
                @bind-Value="model.Title"
                Class="w-100"
                @onkeydown="HandleKeyDown"
                Placeholder="Task title"/>
            
            <FluentTextField
                T="string"
                Name="Title"
                Class="w-100"
                @onkeydown="HandleKeyDown"
                @bind-Value="model.ExternalTaskId"
                Placeholder="External task ID"/>
            
        </FluentStack>
    </EditForm>
</FluentDialogBody>
