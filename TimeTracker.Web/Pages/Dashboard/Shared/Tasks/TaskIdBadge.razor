@using MudBlazor

@inherits BaseComponent

<div class="d-flex align-items-center justify-content-start">
    @{
        var taskId = string.IsNullOrEmpty(InternalTask.ExternalTaskId) && !IsReplaceWithExternal
            ? InternalTask.FormattedId
            : InternalTask.ExternalTaskId;
    }
    @if (IsLink)
    {
        <NavLink href="@($"/board/task/{AuthState.Value.Workspace.Id}/{InternalTask.TaskId}")" target="_blank">
            <MudChip
                Class="@($"{Class} d-flex align-items-center")"
                Style="@(IsClickable ? "cursor: pointer" : string.Empty)"
                Size="Size.Small"
                Color="Color.Info">
                @taskId
            </MudChip>
        </NavLink>
    }
    else
    {
        <MudChip
            Class="@($"{Class} d-flex align-items-center")"
            Style="@(IsClickable ? "cursor: pointer" : string.Empty)"
            Size="Size.Small"
            OnClick="OnClick"
            Color="Color.Info">
            @taskId
        </MudChip>
    }
</div>
