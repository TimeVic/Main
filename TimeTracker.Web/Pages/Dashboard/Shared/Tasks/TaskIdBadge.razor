@inherits BaseComponent

<div class="d-flex align-items-center justify-content-center">
    @{
        var taskId = string.IsNullOrEmpty(InternalTask.ExternalTaskId) && !IsReplaceWithExternal
            ? InternalTask.FormattedId
            : InternalTask.ExternalTaskId;
    }
    @if (IsLink)
    {
        <NavLink href="@("/board/task/" + InternalTask.Id)" target="_blank">
            <RadzenBadge
                Shade="Shade.Lighter"
                BadgeStyle="BadgeStyle.Primary"
                Style="@(IsClickable ? "cursor: pointer" : "")"
                @onclick="OnClick"
                class="@($"{Class} d-flex align-items-center")"
                Text="@taskId"/>
        </NavLink>
    }
    else
    {
        <RadzenBadge
            Shade="Shade.Lighter"
            BadgeStyle="BadgeStyle.Primary"
            Style="@(IsClickable ? "cursor: pointer" : "")"
            @onclick="OnClick"
            class="@($"{Class} d-flex align-items-center")"
            Text="@taskId"/>
    }
</div>
