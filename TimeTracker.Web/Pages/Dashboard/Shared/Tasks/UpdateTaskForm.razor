@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Tasks
@using TimeTracker.Business.Common.Constants.Storage
@using TimeTracker.Business.Common.Constants.Task
@using TimeTracker.Web.Pages.Dashboard.Shared.TimeEntry
@using TimeTracker.Web.Pages.Dashboard.Shared.Tasks
@using TimeTracker.Web.Pages.Dashboard.Shared.Tasks.Comments
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;
@using TimeTracker.Api.Shared.Dto.Entity.Task
@using TimeTracker.Web.Shared.Components.Form
@using TimeTracker.Web.Shared.Components.Storage
@using TimeTracker.Web.Shared.Components.Form.Select

@inherits BaseReactiveComponent

<EditForm
    @ref="_form"
    Model="_model">
    <DataAnnotationsValidator/>
    <FluentValidationSummary/>

    <FluentStack Orientation="Orientation.Horizontal">

        <TaskIdBadge IsLink="true" InternalTask="@Task"/>
        <FluentSpacer/>
        <TimeEntryForm
            InternalTask="@Task"
            IsShort="@true"/>
        <FluentSpacer/>
        <FluentCheckbox
            Disabled="_tasksState.Value.IsTaskSaving"
            Label="Archived"
            Value="@_model.IsArchived"
            ValueChanged="@OnArchivedChanged"/>
    </FluentStack>
    <FluentSpacer/>
    <FluentStack Orientation="Orientation.Vertical" Class="pt-2">
        <FluentTextField
            Class="w-100 mt-2"
            Value="@_model.Title"
            ValueChanged="@OnChangeTitle"
            Placeholder="Title"></FluentTextField>

        <FluentStack Orientation="Orientation.Horizontal" Class="pt-2">
            <div>
                <MembersDropDown
                    Label="Assigned"
                    Clearable="false"
                    AllowedIds="@_allowedUserIds"
                    UserId="@_model.UserId"
                    SelectedItemChanged="@(OnChangedAssigned)"/>
            </div>
            <FluentSpacer/>
            <div>
                <EnumDropDown
                    Label="Status"
                    TItem="TaskStatus"
                    AllowClear="false"
                    Value="_model.Status"
                    ValueChanged="@(item => _model.Status = item ?? default)"
                    OnChanged="SubmitForm"
                    Name="Status"/>
            </div>
            <FluentSpacer/>
            <div>
                <EnumDropDown
                    TItem="TaskPriority"
                    Label="Priority"
                    AllowClear="false"
                    Value="_model.Priority"
                    ValueChanged="@(item => _model.Priority = item ?? default)"
                    OnChanged="SubmitForm"/>
            </div>
        </FluentStack>

        <FluentStack Orientation="Orientation.Horizontal" Class="pt-2">

            <div>
                <FluentLabel>Start Time</FluentLabel>
                <FluentStack Orientation="Orientation.Horizontal">
                    <FluentDatePicker
                        DisabledDateFunc="DisabledStartTime"
                        Value="@_model.StartTime"
                        ValueChanged="@(OnStartDateChanged)"/>
                    <FluentTimePicker
                        Value="@_model.StartTime"
                        ValueChanged="@(OnStartDateChanged)"/>
                </FluentStack>
            </div>
            <FluentSpacer/>
            <div>
                <FluentLabel>Reminder</FluentLabel>
                <FluentStack Orientation="Orientation.Horizontal">
                    <FluentDatePicker
                        Value="@_model.ReminderTime"/>
                    <FluentTimePicker
                        Value="@_model.ReminderTime"
                        ValueChanged="@(date => OnReminderTimeChanged(date?.TimeOfDay))"/>
                </FluentStack>
            </div>
        </FluentStack>

        <FluentStack Orientation="Orientation.Horizontal">
            <div class="mt-2">
                <FluentLabel>End Time</FluentLabel>
                <FluentStack Orientation="Orientation.Horizontal">
                    <FluentDatePicker
                        DisabledDateFunc="DisabledEndTime"
                        Value="@_model.EndTime"
                        ValueChanged="@(OnEndDateChanged)"/>
                    <FluentTimePicker
                        Value="@_model.EndTime"
                        ValueChanged="@(OnEndDateChanged)"/>
                </FluentStack>
            </div>
            
            <FluentSpacer/>
        </FluentStack>

        <FluentLabel Class="mt-2">Tags</FluentLabel>
        <TagsDropDown
            Value="@_model.TagIds"
            ValueChanged="@(OnTagsChanged)"/>

        <FluentLabel Class="mt-2">Description</FluentLabel>
        <MarkdownEdit
            Label="Description"
            Value="@_model.Description"
            ValueChanged="@OnDescriptionChanged"
            Placeholder="Insert your task details here"/>

    </FluentStack>

    <FluentTabs Class="mt-3">
        <FluentTab
            Label="Comments"
            Icon="@(new Icons.Regular.Size24.Comment())"
            Id="tab-1"
            Class="pt-2">
            <TaskCommentsBlock Task="Task"/>
        </FluentTab>

        <FluentTab
            Label="@_tabLabelAttachments"
            Icon="@(new Icons.Regular.Size24.ArrowUpload())"
            Id="tab-2"
            Class="pt-2">
            <FileUploader
                EntityId="@Task.TaskId"
                FileUploaded="OnFileUploaded"
                EntityType="StorageEntityType.Task"
                FileType="StoredFileType.Attachment"/>


            <FilesList
                Class=" mt-2"
                EntityId="@Task.TaskId"
                EntityType="StorageEntityType.Task"
                ListUpdated="AttachmentsListUpdated"
                Files="@Task.Attachments"/>
        </FluentTab>
    </FluentTabs>
</EditForm>
