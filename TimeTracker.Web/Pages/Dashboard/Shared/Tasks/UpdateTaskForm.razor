@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Tasks
@using TimeTracker.Business.Common.Constants.Storage
@using TimeTracker.Business.Common.Constants.Task
@using TimeTracker.Web.Pages.Dashboard.Shared.TimeEntry
@using TimeTracker.Web.Pages.Dashboard.Shared.Tasks
@using TimeTracker.Web.Pages.Dashboard.Shared.Tasks.Comments
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;
@using TimeTracker.Api.Shared.Dto.Entity.Task

@inherits BaseComponent

<RadzenTemplateForm
    @ref="@_form"
    TItem="UpdateRequest"
    Data="@model"
    Submit="HandleSubmit">
<DataAnnotationsValidator/>
<RadzenStack
    class="w-100"
    Orientation="Orientation.Horizontal"
    AlignItems="AlignItems.Stretch"
    Wrap="FlexWrap.Wrap">

<div
    class="flex-grow-1"
    Style="max-width: 60%;">
    <RadzenStack
        class="w-100"
        Orientation="Orientation.Horizontal"
        JustifyContent="JustifyContent.SpaceBetween"
        Wrap="FlexWrap.Wrap">
        <RadzenColumn
            Style="max-width: 60px;"
            class="d-flex align-items-center">
            <TaskIdBadge IsLink="true" InternalTask="@Task"/>
        </RadzenColumn>
        @if (!string.IsNullOrEmpty(model.ExternalTaskId))
        {
            <RadzenColumn>
                <RadzenStack
                    Orientation="Orientation.Horizontal"
                    AlignItems="AlignItems.Center"
                    JustifyContent="JustifyContent.Start"
                    Style="height: 100%;">

                    <RadzenText
                        TextStyle="TextStyle.Subtitle1">
                        External Task Id: @model.ExternalTaskId
                    </RadzenText>
                </RadzenStack>
            </RadzenColumn>
        }
        <RadzenColumn Style="max-width: 200px">
            <TimeEntryForm
                InternalTask="@Task"
                IsShort="true"/>
        </RadzenColumn>
    </RadzenStack>
    <RadzenRow Class="w-100">
        <RadzenColumn>
            <RadzenText
                TextStyle="TextStyle.Subtitle2"
                TagName="TagName.H3">
                Title
            </RadzenText>
            <RadzenTextBox
                Name="Title"
                @bind-Value="model.Title"
                Placeholder="Enter a title for new task"
                Change="SubmitForm"
                Class="w-100"/>
        </RadzenColumn>
    </RadzenRow>

    <RadzenTabs RenderMode="@TabRenderMode.Client" class="w-100 mt-2">
        <Tabs>
            <RadzenTabsItem Text="Description">
                <MarkdownEdit
                    TextAreaName="Description"
                    @bind-Value="model.Description"
                    Placeholder="Insert your task details here"
                    Changed="SubmitForm"
                    Class="w-100"/>
            </RadzenTabsItem>
            <RadzenTabsItem Text="@_tabLabelAttachments">
                <FileUploader
                    Class="w-100"
                    EntityId="@Task.TaskId"
                    FileUploaded="OnFileUploaded"
                    EntityType="StorageEntityType.Task"
                    FileType="StoredFileType.Attachment"/>
                <FilesList
                    Class=" mt-2"
                    EntityId="@Task.TaskId"
                    EntityType="StorageEntityType.Task"
                    ListUpdated="AttachmentsListUpdated"
                    Files="@Task.Attachments"/>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>

    <RadzenRow Class="w-100">
        <RadzenColumn>
            <TaskCommentsBlock Task="Task"/>
        </RadzenColumn>
    </RadzenRow>
</div>

<RadzenFieldset
    Text="Details"
    class="flex-grow-1"
    Style="max-width: 400px;">
    <RadzenRow Class="w-100">
        <RadzenColumn>
            <RadzenText
                TextStyle="TextStyle.Subtitle2"
                TagName="TagName.H3">
                Assigned
            </RadzenText>
            <MembersDropDown
                Clearable="false"
                AllowedIds="_allowedUserIds"
                UserId="@model.UserId"
                Class="w-100"
                SelectedItemChanged="OnChangedAssigned"/>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow Class="w-100 mt-2">
        <RadzenColumn>
            <RadzenText
                TextStyle="TextStyle.Subtitle2"
                TagName="TagName.H3">
                Status
            </RadzenText>
            <EnumDropDown
                TItem="TaskStatus"
                AllowClear="false"
                @bind-Value="model.Status"
                Changed="SubmitForm"
                class="w-100"
                Name="Status"/>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow Class="w-100 mt-2">
        <RadzenColumn>
            <RadzenText
                TextStyle="TextStyle.Subtitle2"
                TagName="TagName.H3">
                Priority
            </RadzenText>
            <EnumDropDown
                TItem="TaskPriority"
                AllowClear="false"
                @bind-Value="model.Priority"
                Changed="SubmitForm"
                class="w-100"
                Name="Priority"/>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow Class="w-100 mt-2">
        <RadzenColumn>
            <RadzenText
                TextStyle="TextStyle.Subtitle2"
                TagName="TagName.H3">
                Start
            </RadzenText>
            <RadzenDatePicker
                TValue="DateTime?"
                ShowTime="true"
                ShowSeconds="false"
                HoursStep="1"
                MinutesStep="15"
                Kind="DateTimeKind.Local"
                Name="StartTime"
                Max="model.EndTime"
                class="w-100"
                Change="OnChangeTime"
                @bind-Value="model.StartTime"
                DateFormat="MM/dd/yyyy HH:mm"/>
            <RadzenCustomValidator
                Component="StartTime" 
                Popup="false"
                Validator="@(() => ValidateStartTime(model.StartTime))" 
                Text="Start Time can not be more than End Time"/>
        </RadzenColumn>
        <RadzenColumn>
            <RadzenText
                TextStyle="TextStyle.Subtitle2"
                TagName="TagName.H3">
                End
            </RadzenText>
            <RadzenDatePicker
                Name="EndTime"
                TValue="DateTime?"
                ShowTime="true"
                ShowSeconds="false"
                HoursStep="1"
                Min="model.StartTime"
                Kind="DateTimeKind.Local"
                MinutesStep="15"
                class="w-100"
                Change="OnChangeTime"
                @bind-Value="model.EndTime"
                DateFormat="MM/dd/yyyy HH:mm"/>
            <RadzenCustomValidator
                Component="EndTime" 
                Popup="false"
                Validator="@(() => ValidateEndTime(model.EndTime))" 
                Text="End Time can not be less than Start Time"/>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow Class="w-100 mt-2">
        <RadzenColumn Style="max-width: 200px">
            <RadzenStack
                Orientation="Orientation.Horizontal"
                AlignItems="AlignItems.End"
                JustifyContent="JustifyContent.Start"
                Style="height: 100%;">
                <div>
                    <RadzenCheckBox
                        @bind-Value=@model.IsArchived
                        Name="IsArchived"
                        Change="SubmitForm"
                        TValue="bool"/>
                    <RadzenLabel Text="Archived" Component="IsArchived" class="ml-1"/>
                </div>
            </RadzenStack>
        </RadzenColumn>
        <RadzenRow Class="w-100 mt-2">
            <RadzenColumn>
                <RadzenText
                    TextStyle="TextStyle.Subtitle2"
                    TagName="TagName.H3">
                    Tags
                </RadzenText>
                <TagsDropDown
                    Value="@model.TagIds"
                    ValueChanged="OnTagsChanged"
                    Class="w-100"/>
            </RadzenColumn>
        </RadzenRow>
    </RadzenRow>
</RadzenFieldset>
</RadzenStack>
</RadzenTemplateForm>
