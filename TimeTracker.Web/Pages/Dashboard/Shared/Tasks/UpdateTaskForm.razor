@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Tasks
@using TimeTracker.Business.Common.Constants.Storage
@using TimeTracker.Business.Common.Constants.Task
@using TimeTracker.Web.Pages.Dashboard.Shared.TimeEntry
@using TimeTracker.Web.Pages.Dashboard.Shared.Tasks
@using TimeTracker.Web.Pages.Dashboard.Shared.Tasks.Comments
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;
@using TimeTracker.Api.Shared.Dto.Entity.Task
@using MudBlazor

@inherits BaseReactiveComponent

<MudForm
    @ref="_form"
    @bind-IsValid="_isValid">

    <MudPaper Class="pa-4" Outlined="true">
        <MudStack Row="true" AlignItems="MudBlazor.AlignItems.Center">
            <TaskIdBadge IsLink="true" InternalTask="@Task"/>

            <MudSpacer/>
            <TimeEntryForm
                InternalTask="@Task"
                IsShort="true"/>
            <MudSpacer/>
            <MudButton
                OnClick="@SubmitForm"
                Variant="Variant.Filled"
                Disabled="@(!_form.IsValid || _tasksState.Value.IsTaskSaving)"
                Color="Color.Primary">
                Save
            </MudButton>
        </MudStack>

        <MudGrid>
            <MudItem xs="12">
                <MudTextField
                    T="string"
                    For="() => _model.Title"
                    @bind-Value="_model.Title"
                    Placeholder="Title"/>
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem xs="6">
                <MudStack Spacing="0">
                    <MembersDropDown
                        Placeholder="Assigned"
                        Clearable="false"
                        AllowedIds="@_allowedUserIds"
                        UserId="@_model.UserId"
                        SelectedItemChanged="@(OnChangedAssigned)"/>

                    <EnumDropDown
                        Placeholder="Status"
                        TItem="TaskStatus"
                        AllowClear="false"
                        @bind-Value="_model.Status"
                        OnChanged="SubmitForm"
                        Name="Status"/>

                    <EnumDropDown
                        TItem="TaskPriority"
                        AllowClear="false"
                        @bind-Value="_model.Priority"
                        OnChanged="SubmitForm"
                        Name="Priority"/>
                </MudStack>
            </MudItem>
            <MudItem xs="6">
                <MudStack Spacing="2">

                    <MudStack
                        Spacing="0"
                        Justify="Justify.SpaceBetween"
                        Row="true">
                        <MudDatePicker
                            @ref="_startDatePicker"
                            Clearable="true"
                            Class="mr-2"
                            Date="_model.StartTime"
                            DateChanged="OnStartDateChanged"
                            Validation="ValidateStartTime"
                            ErrorText="Start Time can not be more than End Time"
                            Label="Start Date"/>
                        <MudDatePicker
                            @ref="_endDatePicker"
                            Clearable="true"
                            Class="mr-2"
                            Date="_model.EndTime"
                            DateChanged="OnEndDateChanged"
                            Validation="ValidateEndTime"
                            ErrorText="End Time can not be less than Start Time"
                            Label="Due Date"/>
                    </MudStack>

                    <MudStack
                        Spacing="0"
                        Justify="Justify.SpaceBetween"
                        Row="true">

                        <MudDatePicker
                            @ref="_reminderDatePicker"
                            Clearable="true"
                            Class="mr-2"
                            @bind-Date="_model.ReminderTime"
                            Placeholder="Reminder Date"/>
                        <MudTimePicker
                            @ref="_reminderTimePicker"
                            Clearable="true"
                            Disabled="@(!_model.ReminderTime.HasValue)"
                            Time="_model.ReminderTime?.TimeOfDay"
                            TimeChanged="OnReminderTimeChanged"
                            Placeholder="Reminder Time"/>
                    </MudStack>

                    <MudCheckBox
                        T="bool"
                        Label="Archived"
                        @bind-Value="@(_model.IsArchived)"/>
                </MudStack>
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem xs="12">
                <TagsDropDown
                    Value="@_model.TagIds"
                    ValueChanged="@(OnTagsChanged)"/>
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem xs="12">
                <MarkdownEdit
                    Class="mt-3"
                    Label="Description"
                    @bind-Value="@_model.Description"
                    Placeholder="Insert your task details here"/>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudForm>

<MudTabs
    Rounded="true"
    Outlined="true"
    ApplyEffectsToContainer="true"
    Class="mt-4 mb-4"
    PanelClass="pa-6">
    <MudTabPanel Text="Comments">
        <TaskCommentsBlock Task="Task"/>
    </MudTabPanel>
    <MudTabPanel Text="@_tabLabelAttachments">
        <FileUploader
            EntityId="@Task.TaskId"
            FileUploaded="OnFileUploaded"
            EntityType="StorageEntityType.Task"
            FileType="StoredFileType.Attachment"/>


        <FilesList
            Class=" mt-2"
            EntityId="@Task.TaskId"
            EntityType="StorageEntityType.Task"
            ListUpdated="AttachmentsListUpdated"
            Files="@Task.Attachments"/>
    </MudTabPanel>
</MudTabs>
