@using TimeTracker.Web.Store.Auth
@using TimeTracker.Business.Extensions

@inherits BaseReactiveComponent

<FluentNavLink Href="@SiteUrl.Dashboard_TimeEntry" Text="My Time Entries">My Time Entries</FluentNavLink>
@* <FluentNavLink Href="@SiteUrl.Dashboard_OverdueTasks" Text="Overdue Tasks">Overdue Tasks</FluentNavLink> *@
@* <FluentNavLink Href="@SiteUrl.Dashboard_GoalsTracker" Text="Goals Tracker">Goals Tracker</FluentNavLink> *@
<FluentNavLink Href="@SiteUrl.Dashboard_Reports_Summary" Text="Summary">Summary</FluentNavLink>
<FluentNavLink Href="@SiteUrl.Dashboard_Tasks_Main" Text="Tasks">Tasks</FluentNavLink>
<FluentNavLink Href="@SiteUrl.Dashboard_Payments" Text="Payments">Payments</FluentNavLink>

<FluentNavGroup Title="" Icon="@(new Icons.Regular.Size20.EarthLeaf())">
    <TitleTemplate>
        <h3>Reports</h3></TitleTemplate>
    <ChildContent>
        <FluentNavLink Href="@SiteUrl.Dashboard_Reports_Payments" Icon="@(new Icons.Regular.Size20.LeafOne())">Payments</FluentNavLink>
        <FluentNavLink Href="@SiteUrl.Dashboard_Reports_TimeEntries" Icon="@(new Icons.Regular.Size20.LeafOne())">Detailed</FluentNavLink>
    </ChildContent>
</FluentNavGroup>

<FluentNavGroup Title="" Icon="@(new Icons.Regular.Size20.EarthLeaf())">
    <TitleTemplate>
        <h3>Workspace</h3></TitleTemplate>
    <ChildContent>
        <FluentNavLink Href="@SiteUrl.Dashboard_Projects" Icon="@(new Icons.Regular.Size20.LeafOne())">Projects</FluentNavLink>
        <FluentNavLink Href="@SiteUrl.Dashboard_Clients" Icon="@(new Icons.Regular.Size20.LeafOne())">Clients</FluentNavLink>
        <FluentNavLink Href="@SiteUrl.Dashboard_Tags" Icon="@(new Icons.Regular.Size20.LeafOne())">Tags</FluentNavLink>
        @if (AuthState.Value.IsRoleAdmin)
        {
            <FluentNavLink Href="@(AuthState.Value.IsRoleAdmin ? SiteUrl.Dashboard_Members : null)" Icon="@(new Icons.Regular.Size20.LeafOne())">Members</FluentNavLink>
        }
        <FluentNavLink Href="@SiteUrl.Dashboard_Integrations" Icon="@(new Icons.Regular.Size20.LeafOne())">Integrations</FluentNavLink>
    </ChildContent>
</FluentNavGroup>

<FluentNavGroup Title="" Icon="@(new Icons.Regular.Size20.EarthLeaf())">
    <TitleTemplate>
        <h3>Reports</h3></TitleTemplate>
    <ChildContent>
        <FluentNavLink Icon="@(new Icons.Regular.Size20.LeafOne())">Item 3.1</FluentNavLink>
        <FluentNavLink Icon="@(new Icons.Regular.Size20.LeafTwo())">Item 3.2</FluentNavLink>
    </ChildContent>
</FluentNavGroup>
