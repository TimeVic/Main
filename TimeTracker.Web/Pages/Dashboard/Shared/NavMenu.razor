@using TimeTracker.Web.Store.Auth
@inherits BaseComponent

<RadzenSidebar>
    <RadzenPanelMenu Match="NavLinkMatch.All">
        <RadzenPanelMenuItem
            Icon="timer"
            Text="Time Tracker"
            Path="@SiteUrl.Dashboard_TimeEntry"/>
        <RadzenPanelMenuItem
            Icon="dashboard"
            Text="Dashboard"
            Path="@SiteUrl.Dashboard_Dashboard"/>
        <RadzenPanelMenuItem
            Icon="event"
            Text="Calendar"
            Path="@SiteUrl.Dashboard_Calendar"/>
        <RadzenPanelMenuItem
            Icon="assessment"
            Text="Summary"
            Path="@SiteUrl.Dashboard_Reports_Summary"/>
        <RadzenPanelMenuItem Text="Tasks" Icon="task">
            <RadzenPanelMenuItem
                Icon="supervisor_account"
                Text="Without client">
                @foreach (var project in GetClientProjects(null))
                {
                    <RadzenPanelMenuItem
                        Icon="list_alt"
                        Text="@project.Name"
                        Path="@GetTasksListUrl(project)"/>
                }
            </RadzenPanelMenuItem>
            @foreach (var client in Clients)
            {
                <RadzenPanelMenuItem
                    @key="client"
                    Icon="supervisor_account"
                    Text="@client.Name">
                    @foreach (var project in GetClientProjects(client))
                    {
                        <RadzenPanelMenuItem
                            Icon="list_alt"
                            Text="@project.Name"
                            Path="@GetTasksListUrl(project)"/>
                    }
                </RadzenPanelMenuItem>
            }
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem
            Icon="euro_symbol"
            Text="Payments"
            Path="@SiteUrl.Dashboard_Payments"/>
        <RadzenPanelMenuItem Text="Reports" Icon="assessment">
            <RadzenPanelMenuItem
                Icon="euro_symbol"
                Text="Payments"
                Path="@SiteUrl.Dashboard_Reports_Payments"/>
            <RadzenPanelMenuItem
                Icon="line_weight"
                Text="Detailed"
                Path="@SiteUrl.Dashboard_Reports_TimeEntries"/>
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Workspace" Icon="dashboard">
            <RadzenPanelMenuItem
                Icon="chrome_reader_mode"
                Text="Projects"
                Path="@SiteUrl.Dashboard_Projects"/>
            <RadzenPanelMenuItem
                Icon="assignment_ind"
                Text="Clients"
                Path="@SiteUrl.Dashboard_Clients"/>
            <RadzenPanelMenuItem
                Icon="local_offer"
                Text="Tags"
                Path="@SiteUrl.Dashboard_Tags"/>
            <RadzenPanelMenuItem
                Icon="face"
                Text="Members"
                Path="@(AuthState.Value.IsRoleAdmin ? SiteUrl.Dashboard_Members : null)"/>
            <RadzenPanelMenuItem
                Icon="compare_arrows"
                Text="Integrations"
                Path="@SiteUrl.Dashboard_Integrations"/>
        </RadzenPanelMenuItem>
    </RadzenPanelMenu>
</RadzenSidebar>
