
@inherits BaseReactiveComponent
@using TimeTracker.Web.Shared.Components.Form.Select
@implements IDialogContentComponent<UpdateProjectModal.Parameters>

<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentIcon Value="@(new Icons.Regular.Size24.WindowApps())" />
        <FluentLabel Typo="Typography.PaneHeader">
            Update project
        </FluentLabel>
    </FluentStack>
</FluentDialogHeader>

@* Footer *@
<FluentDialogFooter>
    <FluentButton
        Appearance="Appearance.Accent"
        Disabled="@_isLoading"
        OnClick="@Submit">Update</FluentButton>
    <FluentButton
        Disabled="@_isLoading"
        Appearance="Appearance.Neutral"
        OnClick="@OnCloseModal">Cancel</FluentButton>
</FluentDialogFooter>

@* Body *@
<FluentDialogBody>
    <EditForm
        @ref="_form"
        Model="model">
        <DataAnnotationsValidator />
        <FluentValidationSummary />

        <FluentStack Orientation="Orientation.Vertical">
            <div class="w-100">
                <FluentTextField
                    Class="w-100 mb-2"
                    @bind-Value="@(model.Name)"
                    Label="Project name">
                </FluentTextField>
            </div>
            
            <ClientsDropDown
                Label="Client"
                Clearable="true"
                FullWidth="true"
                Class="mb-2"
                Value="@(model.ClientId)"
                SelectedItemChanged="@(item => model.ClientId = item?.Id ?? Guid.Empty)"/>

            <div class="w-100">
                <FluentCheckbox
                    Class="w-100 mb-2"
                    Label="Billable by default"
                    @bind-Value="@(model.IsBillableByDefault)"/>
            </div>

            <div class="w-100">
                <FluentNumberField
                    TValue="decimal?"
                    Label="Amount"
                    Class="w-100"
                    Disabled="@(!model.IsBillableByDefault)"
                    @bind-Value="@(model.DefaultHourlyRate)"
                    Step=".01M"
                    Min="0.0M"/>
            </div>
        </FluentStack>
    </EditForm>
</FluentDialogBody>
