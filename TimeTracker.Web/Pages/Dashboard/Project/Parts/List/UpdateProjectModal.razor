@using MudBlazor

@inherits BaseReactiveComponent

<MudDialog>
    <DialogContent>
        <MudForm
            @ref="_form"
            @bind-IsValid="_isValid">

            <MudStack>
                <MudStack Row="true" Spacing="4">
                    <ClientsDropDown
                        For="() => model.ClientId"
                        @bind-Value="@(model.ClientId)"/>

                    <MudTextField
                        T="string?"
                        For="() => model.Name"
                        @bind-Value="@(model.Name)"
                        Label="Project name">
                    </MudTextField>
                </MudStack>
                <MudStack Row="true" Spacing="4">
                    <MudNumericField
                        T="decimal?"
                        Label="Amount"
                        @bind-Value="@(model.DefaultHourlyRate)"
                        Variant="MudBlazor.Variant.Text"
                        Step=".01M"
                        Min="0.0M"/>

                    <MudCheckBox
                        T="bool"
                        For="() => model.IsBillableByDefault"
                        @bind-Value="@(model.IsBillableByDefault)"/>
                </MudStack>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@OnCloseModal">Cancel</MudButton>
        <MudButton
            ButtonType="MudBlazor.ButtonType.Submit"
            OnClick="@Submit"
            Disabled="@_isLoading"
            Color="Color.Primary">
            Update
        </MudButton>
    </DialogActions>
</MudDialog>
