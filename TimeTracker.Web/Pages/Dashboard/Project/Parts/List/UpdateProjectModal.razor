
@inherits BaseReactiveComponent
@implements IDialogContentComponent<UpdateProjectModal.Parameters>

<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentIcon Value="@(new Icons.Regular.Size24.WindowApps())" />
        <FluentLabel Typo="Typography.PaneHeader">
            Update client
        </FluentLabel>
    </FluentStack>
</FluentDialogHeader>

@* Footer *@
<FluentDialogFooter>
    <FluentButton
        Appearance="Appearance.Accent"
        Disabled="@_isLoading"
        OnClick="@Submit">Add</FluentButton>
    <FluentButton
        Disabled="@_isLoading"
        Appearance="Appearance.Neutral"
        OnClick="@OnCloseModal">Cancel</FluentButton>
</FluentDialogFooter>

@* Body *@
<FluentDialogBody>
    <EditForm
        @ref="_form"
        Model="model">
        <DataAnnotationsValidator />
        <FluentValidationSummary />

        <ClientsDropDown
            Value="@(model.ClientId)"
            SelectedItemChanged="@(item => model.ClientId = item.Id)"/>

        <FluentTextField
            @bind-Value="@(model.Name)"
            Label="Project name">
        </FluentTextField>

        <FluentNumberField
            TValue="decimal?"
            Label="Amount"
            @bind-Value="@(model.DefaultHourlyRate)"
            Step=".01M"
            Min="0.0M"/>

        <FluentCheckbox
            @bind-Value="@(model.IsBillableByDefault)"/>
    </EditForm>
</FluentDialogBody>
