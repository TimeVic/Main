@inherits BaseReactiveComponent

<MudDialog>
    <DialogContent>
        <FluentEditForm
            @ref="_form"
            @bind-IsValid="_isValid">

            <FluentTextField
                T="string?"
                For="() => model.Name"
                @bind-Value="@(model.Name)"
                Label="Project name">
            </FluentTextField>
        </FluentEditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@OnCloseModal">Cancel</MudButton>
        <MudButton
            ButtonType="MudBlazor.ButtonType.Submit"
            OnClick="@Submit"
            Disabled="@_isLoading"
            Color="Color.Primary">
            Add
        </MudButton>
    </DialogActions>
</MudDialog>
