@inherits BaseReactiveComponent

@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants

<MudTable
    Class="mt-2 w-100"
    Items="@_state.Value.List"
    Hover="true"
    Dense="true"
    Outlined="true"
    Breakpoint="Breakpoint.Sm"
    Loading="@_state.Value.IsListLoading"
    LoadingProgressColor="Color.Info">

    <ToolBarContent>
        <MudText Typo="Typo.h6">Projects</MudText>
        <MudSpacer/>
        <MudButton
            OnClick="@OnAddProject"
            Disabled="@(!AuthState.Value.IsRoleAdmin)"
            StartIcon="@Icons.Material.Filled.Add">
            Add
        </MudButton>
    </ToolBarContent>

    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Client</MudTh>
        <MudTh>Default Hourly Rate</MudTh>
        <MudTh></MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Project">@context?.Name</MudTd>
        <MudTd DataLabel="Client">@context.Client?.Name</MudTd>
        <MudTd DataLabel="DefaultHourlyRate">@context.DefaultHourlyRate?.ToString("0.00")</MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton
                OnClick="@(() => OnEditProject(context))"
                Icon="@Icons.Material.Filled.Edit"
                Disabled="@(!AuthState.Value.IsRoleAdmin)"
                Size="Size.Small"/>
            <MudIconButton
                OnClick="@(() => DeleteProject(context))"
                Icon="@Icons.Material.Filled.Delete"
                Disabled="@(!AuthState.Value.IsRoleAdmin)"
                Color="Color.Error"
                Size="Size.Small"/>
        </MudTd>
    </RowTemplate>
</MudTable>
