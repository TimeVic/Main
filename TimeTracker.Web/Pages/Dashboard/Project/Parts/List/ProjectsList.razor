@inherits BaseReactiveComponent

@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants

<FluentStack Orientation="Orientation.Vertical" Class="p-2">
    <FluentToolbar Class="w-100">
        <FluentButton
            IconStart="@(new Icons.Regular.Size24.Add())"
            Appearance="Appearance.Accent"
            Disabled="@(!AuthState.Value.IsRoleAdmin)"
            OnClick="@OnAddProject">
            Add
        </FluentButton>
    </FluentToolbar>

    <FluentDataGrid
        Class="w-100"
        Items="@_state.Value.List.AsQueryable()"
        RowSize="DataGridRowSize.Medium"
        ShowHover="true">

        <TemplateColumn
            Title="Name"
            Sortable="false">
            @context?.Name
        </TemplateColumn>

        <TemplateColumn
            Title="Client"
            Sortable="false">
            @context?.Client?.Name
        </TemplateColumn>

        <TemplateColumn
            Title="Default Hourly Rate"
            Sortable="false">
            @context?.DefaultHourlyRate?.ToString("0.##")
        </TemplateColumn>

        <PropertyColumn
            Title="Billable"
            Sortable="false"
            Property="arg => arg.IsBillableByDefault"/>
        
        <TemplateColumn
            Title=""
            Sortable="false">

            <FluentButton
                IconStart="@(new Icons.Regular.Size24.Edit())"
                Appearance="Appearance.Lightweight"
                Disabled="@(!AuthState.Value.IsRoleAdmin)"
                OnClick="@(() => OnEditProject(context))"/>

            <FluentButton
                IconStart="@(new Icons.Regular.Size24.Delete())"
                Appearance="Appearance.Lightweight"
                Disabled="@(!AuthState.Value.IsRoleAdmin)"
                OnClick="@(() => DeleteProject(context))"/>
        </TemplateColumn>
    </FluentDataGrid>
</FluentStack>
