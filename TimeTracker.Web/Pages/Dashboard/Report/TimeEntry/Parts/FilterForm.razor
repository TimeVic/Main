@using MudBlazor

@inherits BaseComponent

<MudGrid Spacing="2" Justify="Justify.SpaceBetween">
    <MudItem>
        <ClientsDropDown
            Clearable="true"
            Value="@(_state.Value.Filter.ClientId ?? 0)"
            ValueChanged="OnChangeClient"/>
    </MudItem>
    <MudItem>
        <ProjectsDropDown
            Clearable="true"
            Value="@(_state.Value.Filter.ProjectId ?? 0)"
            ClientId="@(_state.Value.Filter.ClientId ?? 0)"
            ValueChanged="OnChangeProject"/>
    </MudItem>
    <MudItem>
        <MudDatePicker
            Clearable="true"
            Label="Date from"
            Date="@_state.Value.Filter.DateFrom"
            DateChanged="OnChangeDateFrom"/>
    </MudItem>
    <MudItem>
        <MudDatePicker
            Clearable="true"
            Label="Date to"
            Date="@_state.Value.Filter.DateTo"
            DateChanged="OnChangeDateTo"/>
    </MudItem>
</MudGrid>
<MudGrid 
    Spacing="2" 
    Justify="Justify.SpaceBetween"
    Class="mt-2">
    <MudItem>
        <MembersDropDown
            Clearable="true"
            Class="w-100"
            UserId="@(_state.Value.Filter.UserId ?? 0)"
            SelectedItemChanged="OnChangeMember"/>
    </MudItem>
    <MudItem>
        <MudTextField
            T="string"
            Class="w-100"
            Clearable="true"
            Value="@_state.Value.Filter.Search"
            ValueChanged="OnChangeSearch"
            Placeholder="Search"
            Variant="MudBlazor.Variant.Text"/>
    </MudItem>
</MudGrid>
