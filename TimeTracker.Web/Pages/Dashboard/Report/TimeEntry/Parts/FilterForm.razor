@using TimeTracker.Web.Shared.Components.Form.Select
@inherits BaseReactiveComponent

<FluentToolbar Class="pa-4 w-100" Orientation="Orientation.Horizontal">
    <FluentGrid Justify="JustifyContent.SpaceBetween" Class="w-100">
        <FluentGridItem lg="3" md="6" xs="12">
            <ClientsDropDown
                Label="Client"
                Clearable="true"
                FullWidth="true"
                Value="@(_state.Value.Filter.ClientId ?? 0)"
                SelectedItemChanged="OnChangeClient"/>
        </FluentGridItem>
        <FluentGridItem lg="3" md="6" xs="12">
            <ProjectsDropDown
                Label="Project"
                Clearable="true"
                FullWidth="true"
                Value="@(_state.Value.Filter.ProjectId ?? 0)"
                ClientId="@(_state.Value.Filter.ClientId ?? 0)"
                SelectedItemChanged="OnChangeProject"/>
        </FluentGridItem>
        <FluentGridItem lg="3" md="6" xs="12">
            <FluentDatePicker
                Label="Date from"
                Class="w-100"
                Value="@_state.Value.Filter.DateFrom"
                ValueChanged="OnChangeDateFrom"/>
        </FluentGridItem>
        <FluentGridItem lg="3" md="6" xs="12">
            <FluentDatePicker
                Label="Date to"
                Class="w-100"
                Value="@_state.Value.Filter.DateTo"
                ValueChanged="OnChangeDateTo"/>
        </FluentGridItem>
    </FluentGrid>
    <FluentGrid
        Justify="JustifyContent.SpaceBetween"
        Class="mt-2 w-100">
        <FluentGridItem lg="6" md="6" xs="12">
            <MembersDropDown
                Label="Member"
                FullWidth="true"
                Clearable="true"
                UserId="@(_state.Value.Filter.UserId ?? 0)"
                SelectedItemChanged="OnChangeMember"/>
        </FluentGridItem>
        <FluentGridItem lg="6" md="6" xs="12">
            <FluentTextField
                Label="Search"
                Class="w-100"
                Value="@_state.Value.Filter.Search"
                ValueChanged="OnChangeSearch"/>
        </FluentGridItem>
    </FluentGrid>
</FluentToolbar>
