@page "/board/report/payments"

@using TimeTracker.Web.Pages.Dashboard.Shared
@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Business.Extensions
@using MudBlazor

@inherits BaseComponent
@layout Layout

<MudPaper Class="pa-4">
    <MudDatePicker
        Label="Report Date:"
        Date="@_filterState.EndDate"
        DateChanged="@OnChangeDateEnd"/>
</MudPaper>

<MudPaper Class="mt-4 pa-4">
    @if (_state.Value.IsLoading)
    {
        <MudProgressCircular Color="Color.Info" Indeterminate="true"/>
    }
    else
    {
        @if (_state.Value.IsLoading)
        {
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate"/>
        }
        else
        {
            if (!_grouppedItems.Any())
            {
                <MudText
                    Typo="Typo.subtitle1"
                    class="mt-3">
                    The report is empty
                </MudText>
            }
            foreach (var groupItem in _grouppedItems)
            {
                var clientId = groupItem.Key ?? 0;
                var clientDataItem = groupItem.First();
                var clientName = clientDataItem.ClientName;
                var clientAmount = clientDataItem.PaidAmountByClient;
                var unpaidAmount = GetClientUnpaidAmount(clientId);
                var totalAmount = GetClientTotalAmount(clientId);
                var totalDuration = GetTotalDuration(clientId);

                <MudTable
                    Class="mt-2"
                    Items="@groupItem"
                    Hover="true"
                    Dense="true"
                    Outlined="true"
                    Breakpoint="Breakpoint.Sm"
                    Loading="@_state.Value.IsLoading"
                    LoadingProgressColor="Color.Info">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">
                            @if (string.IsNullOrEmpty(clientName))
                            {
                                clientName = "Other projects";
                            }
                            @clientName
                        </MudText>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>Project</MudTh>
                        <MudTh>Total Duration</MudTh>
                        <MudTh>Amount</MudTh>
                        <MudTh>Paid</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Project">
                            @(string.IsNullOrEmpty(context.ProjectName) ? "-- No project name --" : context.ProjectName)
                        </MudTd>
                        <MudTd DataLabel="TotalDuration">
                            @context.TotalDuration.ToReadableShortString()
                        </MudTd>
                        <MudTd DataLabel="Amount">
                            @context.Amount.ToString("0.00")
                        </MudTd>
                        <MudTd DataLabel="Paid">
                            @context.PaidAmountByProject.ToString("0.00")
                        </MudTd>
                    </RowTemplate>
                    <GroupFooterTemplate>
                        <MudTh Class="mud-table-cell-custom-group mud-table-cell-custom-group-footer">
                            Unpaid:
                            <b>
                                @((unpaidAmount > 0) ? "+" : string.Empty)@unpaidAmount.ToString("0.00")
                            </b>
                        </MudTh>
                        <MudTh Class="mud-table-cell-custom-group mud-table-cell-custom-group-footer">
                            Total: <b>@totalDuration.ToReadableShortString()</b>
                        </MudTh>
                        <MudTh Class="mud-table-cell-custom-group mud-table-cell-custom-group-footer">
                            Total: <b>@totalAmount.ToString("0.00")</b>
                        </MudTh>
                        <MudTh Class="mud-table-cell-custom-group mud-table-cell-custom-group-footer">
                            Total: <b>@clientAmount.ToString("0.00")</b>
                        </MudTh>
                    </GroupFooterTemplate>
                </MudTable>
            }
        }
    }
</MudPaper>
