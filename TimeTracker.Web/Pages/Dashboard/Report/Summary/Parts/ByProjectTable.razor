@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Business.Extensions
@using Fluxor
@using TimeTracker.Web.Store.Client
@using TimeTracker.Web.Store.Project
@using MudBlazor

@code {

    [Parameter]
    public ICollection<SummaryByProjectsReportItemDto> Items { get; set; } = new List<SummaryByProjectsReportItemDto>();
}

<MudTable
    Items="@Items" 
    Hover="true" 
    Breakpoint="Breakpoint.Sm" 
    LoadingProgressColor="Color.Info">
    <HeaderContent>
        <MudTh>Project</MudTh>
        <MudTh>Duration</MudTh>
        <MudTh>Amount</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Project">@(context.ProjectName ?? "- No project -")</MudTd>
        <MudTd DataLabel="Duration">@context.Duration.ToReadableShortString()</MudTd>
        <MudTd DataLabel="Amount">@context.Amount.ToMoneyFormat()</MudTd>
    </RowTemplate>
</MudTable>
