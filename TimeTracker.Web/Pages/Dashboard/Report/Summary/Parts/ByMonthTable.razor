@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Business.Extensions
@using System.Globalization
@using MudBlazor

@code {

    [Parameter]
    public ICollection<SummaryByMonthsReportItemDto> Items { get; set; } = new List<SummaryByMonthsReportItemDto>();

    private string GetName(int month, int year)
    {
        return new DateTime(year, month, 1).ToString("MMM", CultureInfo.InvariantCulture);
    }
}

<MudTable
    Items="@Items" 
    Hover="true" 
    Breakpoint="Breakpoint.Sm" 
    LoadingProgressColor="Color.Info">
    <HeaderContent>
        <MudTh>Month</MudTh>
        <MudTh>Duration</MudTh>
        <MudTh>Amount</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Month">@GetName(context.Month, context.Year)</MudTd>
        <MudTd DataLabel="Duration">@context.Duration.ToReadableShortString()</MudTd>
        <MudTd DataLabel="Amount">@context.Amount.ToMoneyFormat()</MudTd>
    </RowTemplate>
</MudTable>
