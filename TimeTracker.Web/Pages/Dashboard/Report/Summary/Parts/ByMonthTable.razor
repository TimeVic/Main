@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Business.Extensions
@using System.Globalization

@code {
    
    [Parameter]
    public ICollection<SummaryByMonthsReportItemDto> Items { get; set; } = new List<SummaryByMonthsReportItemDto>();

    private string GetName(int month, int year)
    {
        return new DateTime(year, month, 1).ToString("MMM", CultureInfo.InvariantCulture);
    }
}

<FluentDataGrid TGridItem="SummaryByMonthsReportItemDto" Items="@Items.AsQueryable()">
    <PropertyColumn Title="Month" Property="@(p => GetName(p.Month, p.Year))" Sortable="false"/>
    <PropertyColumn Title="Duration" Property="@(p => p.Duration.ToReadableShortString())" Sortable="false"/>
    <PropertyColumn Title="Amount" Property="@(p => p.Amount.ToMoneyFormat())" Sortable="false"/>
</FluentDataGrid>
