@using TimeTracker.Business.Extensions
@using MudBlazor

@inherits BaseReactiveComponent

<div class="d-flex justify-content-center">
    <MudText Typo="Typo.body1">
        Total Duration: 
    </MudText>
    <MudText Typo="Typo.subtitle1" Class="ml-2">
        @_totalDuration.ToReadableShortString()
    </MudText>
</div>
<div class="d-flex justify-content-center">
    <MudText Typo="Typo.body1">
        Total Amount: 
    </MudText>
    <MudText Typo="Typo.subtitle1" Class="ml-2">
        @_totalAmount.ToMoneyFormat()
    </MudText>
</div>
