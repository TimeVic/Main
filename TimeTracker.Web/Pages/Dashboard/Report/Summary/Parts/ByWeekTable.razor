@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Business.Extensions
@using System.Globalization

@code {

    [Parameter]
    public ICollection<SummaryByWeeksReportItemDto> Items { get; set; } = new List<SummaryByWeeksReportItemDto>();

}

<FluentDataGrid TGridItem="SummaryByWeeksReportItemDto" Items="@Items.AsQueryable()">
    <TemplateColumn Title="Week" Sortable="false">
        @context.WeekStartDate.ToShortDateString()
        -
        @context.WeekEndDate.ToShortDateString()
    </TemplateColumn>
    <PropertyColumn Title="Duration" Property="@(p => p.Duration.ToReadableShortString())" Sortable="false"/>
    <PropertyColumn Title="Amount" Property="@(p => p.Amount.ToMoneyFormat())" Sortable="false"/>
</FluentDataGrid>
