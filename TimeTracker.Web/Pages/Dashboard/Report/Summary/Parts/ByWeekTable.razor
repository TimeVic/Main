@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Business.Extensions
@using System.Globalization
@using MudBlazor

@code {

    [Parameter]
    public ICollection<SummaryByWeeksReportItemDto> Items { get; set; } = new List<SummaryByWeeksReportItemDto>();

}

<MudTable
    Items="@Items"
    Hover="true"
    Breakpoint="Breakpoint.Sm"
    LoadingProgressColor="Color.Info">
    <HeaderContent>
        <MudTh>Week</MudTh>
        <MudTh>Duration</MudTh>
        <MudTh>Amount</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Week">
            @context.WeekStartDate.ToShortDateString()
            -
            @context.WeekEndDate.ToShortDateString()
        </MudTd>
        <MudTd DataLabel="Duration">@context.Duration.ToReadableShortString()</MudTd>
        <MudTd DataLabel="Amount">@context.Amount.ToMoneyFormat()</MudTd>
    </RowTemplate>
</MudTable>
