@inherits BaseComponent

@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants
@using MudBlazor

<MudTable
    Class="mt-2 w-100"
    Items="@_state.Value.List"
    Hover="true"
    Dense="true"
    Outlined="true"
    Breakpoint="Breakpoint.Sm"
    Loading="@_state.Value.IsListLoading"
    LoadingProgressColor="Color.Info">

    <ToolBarContent>
        <MudText Typo="Typo.h6">Payments</MudText>
        <MudSpacer/>
        <MudButton
            OnClick="OnAddPayment"
            StartIcon="@Icons.Material.Filled.Add">
            Add
        </MudButton>
    </ToolBarContent>

    <HeaderContent>
        <MudTh>Client</MudTh>
        <MudTh>Project</MudTh>
        <MudTh>Amount</MudTh>
        <MudTh>Payment time</MudTh>
        <MudTh>Description</MudTh>
        <MudTh></MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Client">@context.Client?.Name</MudTd>
        <MudTd DataLabel="Project">@context.Project?.Name</MudTd>
        <MudTd DataLabel="Amount">@context.Amount.ToString("0.##")</MudTd>
        <MudTd DataLabel="PaymentTime">@context.PaymentTime.ToString("d")</MudTd>
        <MudTd DataLabel="Description">@context.Description</MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton
                OnClick="@(() => OnEditPayment(context))"
                Icon="@Icons.Material.Filled.Edit"
                Size="Size.Small"/>
            <MudIconButton
                OnClick="@(() => OnDeleteItem(context))"
                Icon="@Icons.Material.Filled.Delete"
                Color="Color.Error"
                Size="Size.Small"/>
        </MudTd>
    </RowTemplate>
</MudTable>
