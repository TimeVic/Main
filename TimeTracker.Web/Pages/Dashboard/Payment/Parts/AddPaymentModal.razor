
@inherits BaseComponent
@using TimeTracker.Web.Shared.Components.Form.Select
@implements IDialogContentComponent

<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentIcon Value="@(new Icons.Regular.Size24.WindowApps())" />
        <FluentLabel Typo="Typography.PaneHeader">
            Add new payment
        </FluentLabel>
    </FluentStack>
</FluentDialogHeader>

@* Footer *@
<FluentDialogFooter>
    <FluentButton
        Appearance="Appearance.Accent"
        Disabled="@_isLoading"
        OnClick="@Submit">Add</FluentButton>
    <FluentButton
        Appearance="Appearance.Neutral"
        OnClick="@OnCloseModal">Cancel</FluentButton>
</FluentDialogFooter>

@* Body *@
<FluentDialogBody>
    <EditForm
        @ref="_form"
        Model="@model"
        novalidate>
        <DataAnnotationsValidator />
        <FluentValidationSummary />

        <ClientsDropDown
            Label="Client"
            FullWidth="true"
            Value="@(model.ClientId)"
            SelectedItemChanged="@(item => model.ClientId = item?.Id ?? Guid.Empty)"/>

        <ProjectsDropDown
            Label="Project"
            FullWidth="true"
            ClientId="@(model.ClientId)"
            Value="@model.ProjectId"
            ShowProjectsWithoutClients="false"
            SelectedItemChanged="@(item => model.ProjectId = item?.Id ?? Guid.Empty)"/>

        <FluentNumberField
            T="decimal"
            Class="w-100"
            Label="Amount"
            @bind-Value="@(model.Amount)"
            Step=".01M"
            Min="0.0M"/>

        <FluentDatePicker
            Required="true"
            Class="w-100"
            Label="Payment date"
            Value="@model.PaymentTime"
            ValueChanged="OnUpdateTime"/>

        <FluentTextArea
            Label="Description"
            Class="w-100"
            @bind-Value="@(model.Description)">
        </FluentTextArea>
    </EditForm>
</FluentDialogBody>
