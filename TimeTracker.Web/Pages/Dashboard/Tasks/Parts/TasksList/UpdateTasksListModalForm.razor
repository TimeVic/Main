@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Tasks.List
@using TimeTracker.Web.Shared.Components.Form
@using TimeTracker.Web.Shared.Components.Form.Select

@inherits BaseReactiveComponent
@implements IDialogContentComponent<UpdateTasksListModalForm.Parameters>

<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentIcon Value="@(new Icons.Regular.Size24.WindowApps())" />
        <FluentLabel Typo="Typography.PaneHeader">
            Update task list
        </FluentLabel>
    </FluentStack>
</FluentDialogHeader>

@* Footer *@
<FluentDialogFooter>
    <FluentButton 
        Appearance="Appearance.Accent"
        Disabled="@_isLoading"
        OnClick="@Submit">Update</FluentButton>
    <FluentButton 
        Appearance="Appearance.Neutral"
        OnClick="@OnCloseModal">Cancel</FluentButton>
</FluentDialogFooter>

@* Body *@
<FluentDialogBody>
    <EditForm
        @ref="_form"
        Model="@model"
        novalidate>
        <DataAnnotationsValidator />
        <FluentValidationSummary />

        <div class="mb-2">
            <ProjectsDropDown
                FullWidth="true"
                Label="Project"
                Value="@(model.ProjectId)"
                SelectedItemChanged="@(item => model.ProjectId = item?.Id ?? Guid.Empty)"
                Placeholder="Task title"/>
        </div>

        <div>
            <FluentTextField
                Class="w-100"
                Label="Name"
                @bind-Value="model.Name"
                Placeholder="Enter list name"/>
        </div>
    </EditForm>
</FluentDialogBody>
