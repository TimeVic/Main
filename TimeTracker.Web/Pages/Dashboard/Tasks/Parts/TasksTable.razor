@using TimeTracker.Web.Pages.Dashboard.Shared
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants
@using TimeTracker.Business.Extensions
@using TimeTracker.Web.Core.Extensions.Enums
@using TimeTracker.Web.Pages.Dashboard.Shared.Tasks
@using MudBlazor
@using TimeTracker.Api.Shared.Dto.Entity.Task
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;

@inherits BaseComponent

<MudDropContainer 
    T="TaskDto" 
    @ref="_dropContainer" 
    Items="@_tasksToDragAndDrop" 
    ItemsSelector="DropItemSelector" 
    ItemDropped="TaskUpdated"
    ApplyDropClassesOnDragStarted="true"
    Class="d-flex flex-row">
    
    <ChildContent>
        @foreach (var taskStatus in _statuses)
        {
            <MudPaper 
                Elevation="0"
                Width="300px" 
                MinHeight="400px" 
                Class="pa-2 ma-4 d-flex flex-column mud-background-gray rounded-lg">
                <MudToolBar DisableGutters="true" Class="px-2">
                    <MudText Typo="Typo.subtitle1">
                        <b>@taskStatus.GetDisplayName()</b>
                    </MudText>
                    <MudSpacer />
                    <MudIconButton
                        OnClick="() => OnAddTask(taskStatus)"
                        Icon="@Icons.Material.Filled.Add"/>
                    
                </MudToolBar>
                @if (TasksState.Value.IsListLoading)
                {
                    <div class="d-flex justify-center mt-4">
                        <MudProgressLinear Color="Color.Info" Indeterminate="true" />
                    </div>
                }
                <MudDropZone 
                    T="TaskDto"
                    Identifier="@taskStatus.ToString()" 
                    AllowReorder="true"
                    Class="mud-height-full" />
            </MudPaper>
        }
    </ChildContent>
    <ItemRenderer>
        <MudPaper
            Elevation="25"
            Class="pa-2 rounded-lg my-3">
            <MudStack>
                <MudStack Row="true" Spacing="1">
                    <TaskIdBadge
                        IsClickable="true"
                        InternalTask="context"/>
                    <MudSpacer/>
                    <MudChip
                        Shade="Shade.Lighter"
                        Size="Size.Small"
                        OnClick="@(() => OnClickTask(context))"
                        BadgeStyle="@context.Priority.GetChipStyle()">
                        @context.Priority.GetDisplayName()
                    </MudChip>
                </MudStack>

                <MudText
                    Style="line-break: anywhere;"
                    Typo="Typo.body2">
                    @context.Title?.Truncate(300)
                </MudText>

                <TagsBadgesList Tags="@context.Tags"/>
            </MudStack>
        </MudPaper>
    </ItemRenderer>
</MudDropContainer>
