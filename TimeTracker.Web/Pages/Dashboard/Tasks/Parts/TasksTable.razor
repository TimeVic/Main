@using TimeTracker.Web.Pages.Dashboard.Shared
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants
@using TimeTracker.Business.Extensions
@using TimeTracker.Web.Core.Extensions.Enums
@using TimeTracker.Web.Pages.Dashboard.Shared.Tasks
@using MudBlazor
@using TimeTracker.Api.Shared.Dto.Entity.Task
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;

@inherits BaseComponent

<div class="d-flex flex-row">
    @foreach (var taskStatus in _statuses)
    {
        <MudPaper
            Elevation="0"
            Width="300px"
            MinHeight="400px"
            Class="pa-2 ma-4 d-flex flex-column mud-background-gray rounded-lg">
            <MudToolBar DisableGutters="true" Class="px-2">
                <MudText Typo="Typo.subtitle1">
                    <b>@taskStatus.GetDisplayName()</b>
                </MudText>
                <MudSpacer/>
                <MudIconButton
                    OnClick="() => OnAddTask(taskStatus)"
                    Icon="@Icons.Material.Filled.Add"/>

            </MudToolBar>
            @if (TasksState.Value.IsListLoading)
            {
                <div class="d-flex justify-center mt-4">
                    <MudProgressLinear Color="Color.Info" Indeterminate="true"/>
                </div>
            }
            else
            {
                foreach (var task in _tasks.Where(item => item.Status == taskStatus))
                {
                    <MudPaper
                        Elevation="25"
                        Class="pa-2 rounded-lg my-3">
                        <MudStack>
                            <MudStack Row="true" Spacing="1">
                                <TaskIdBadge
                                    IsClickable="true"
                                    InternalTask="@task"/>
                                <MudSpacer/>
                                <MudMenu
                                    AnchorOrigin="Origin.BottomLeft"
                                    TransformOrigin="Origin.TopLeft">
                                    <ActivatorContent>
                                        <MudChip
                                            Shade="Shade.Lighter"
                                            Size="Size.Small"
                                            Icon="@Icons.Material.Filled.ArrowDropDown"
                                            Color="@task.Priority.GetChipStyle()"
                                            BadgeStyle="@task.Priority.GetChipStyle()">
                                            @task.Priority.GetDisplayName()
                                        </MudChip>
                                    </ActivatorContent>
                                    <ChildContent>
                                        @foreach (var priority in _priorities)
                                        {
                                            <MudMenuItem
                                                OnClick="() => OnSelectTaskPriority(task, priority)"
                                                Disabled="@(task.Priority == priority)">
                                                @priority.GetDisplayName()
                                            </MudMenuItem>
                                        }
                                    </ChildContent>
                                </MudMenu>

                                <MudMenu
                                    AnchorOrigin="Origin.BottomLeft"
                                    TransformOrigin="Origin.TopLeft">
                                    <ActivatorContent>
                                        <MudChip
                                            Shade="Shade.Lighter"
                                            Size="Size.Small"
                                            Icon="@Icons.Material.Filled.ArrowDropDown"
                                            Color="Color.Default">
                                            @task.Status.GetDisplayName()
                                        </MudChip>
                                    </ActivatorContent>
                                    <ChildContent>
                                        @foreach (var status in _statuses)
                                        {
                                            <MudMenuItem
                                                OnClick="() => OnSelectTaskStatus(task, status)"
                                                Disabled="@(task.Status == status)">
                                                @status.GetDisplayName()
                                            </MudMenuItem>
                                        }
                                    </ChildContent>
                                </MudMenu>
                            </MudStack>

                            <MudText
                                Style="line-break: anywhere;"
                                Typo="Typo.body2">
                                @task.Title?.Truncate(300)
                            </MudText>

                            <TagsBadgesList Tags="@task.Tags"/>
                        </MudStack>
                    </MudPaper>
                }
            }
        </MudPaper>
    }
</div>
