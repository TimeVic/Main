@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;

@inherits BaseComponent

<MudStack Spacing="2" Row="false" Justify="Justify.SpaceBetween">
    <MudText Typo="Typo.h4">@_selectedTasksList?.Name</MudText>

    <MudGrid Style="gap: 8px; min-width: 1226px; margin-left: 2px;">
        <TasksGrid Status="@TaskStatus.Backlog"></TasksGrid>
        <TasksGrid Status="@TaskStatus.ToDo"></TasksGrid>
        <TasksGrid Status="@TaskStatus.InProgress"></TasksGrid>
        <TasksGrid Status="@TaskStatus.Done"></TasksGrid>
    </MudGrid>
</MudStack>
