@using TimeTracker.Web.Pages.Dashboard.Shared
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants
@using TimeTracker.Business.Extensions
@using TimeTracker.Web.Core.Extensions.Enums
@using TimeTracker.Web.Pages.Dashboard.Shared.Tasks
@using MudBlazor
@using TimeTracker.Api.Shared.Dto.Entity.Task
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;

@inherits BaseComponent

<div class="d-flex flex-row">
    @foreach (var taskStatus in _statuses)
    {
        <MudPaper
            Elevation="0"
            Width="300px"
            MinHeight="400px"
            Class="pa-2 ma-4 d-flex flex-column mud-background-gray rounded-lg">
            <MudToolBar DisableGutters="true" Class="px-2">
                <MudText Typo="Typo.subtitle1">
                    <b>@taskStatus.GetDisplayName()</b>
                </MudText>
                <MudSpacer/>
                <MudIconButton
                    OnClick="() => OnAddTask(taskStatus)"
                    Icon="@Icons.Material.Filled.Add"/>

            </MudToolBar>
            @if (TasksState.Value.IsListLoading)
            {
                <div class="d-flex justify-center mt-4">
                    <MudProgressLinear Color="Color.Info" Indeterminate="true"/>
                </div>
            }
            @foreach (var task in _tasks.Where(item => item.Status == taskStatus))
            {
                <TaskCard Class="mb-3" Task="@task"></TaskCard>
            }
        </MudPaper>
    }
</div>
