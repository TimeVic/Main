@using TimeTracker.Web.Pages.Dashboard.Shared
@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Tasks

@inherits BaseComponent

<RadzenCard>
    <RadzenTemplateForm TItem="AddRequest" Data="@model" Submit="HandleSubmit">
        <DataAnnotationsValidator/>

        <RadzenRow>
            <RadzenColumn>
                <RadzenTextBox
                    Name="Title"
                    @bind-Value="@model.Title"
                    Placeholder="Enter a title for new task"
                    Class="w-100"/>
            </RadzenColumn>
            <RadzenColumn Style="max-width: 110px">
                <RadzenButton
                    ButtonType="ButtonType.Submit"
                    IsBusy="_isLoading"
                    Disabled="_isDisabled"
                    class="ml-1"
                    Text="Add"/>
                <RadzenButton
                    ButtonType="ButtonType.Button"
                    ButtonStyle="ButtonStyle.Light"
                    Click="OnClickAdd"
                    IsBusy="_isLoading"
                    Disabled="_isDisabled"
                    class="ml-1"
                    Icon="add_circle_outline"/>
            </RadzenColumn>
        </RadzenRow>
    </RadzenTemplateForm>
</RadzenCard>
