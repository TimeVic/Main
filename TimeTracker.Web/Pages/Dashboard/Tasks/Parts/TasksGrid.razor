@using Microsoft.FluentUI.AspNetCore.Components.Extensions
@using TimeTracker.Api.Shared.Dto.Entity.Task
@using TimeTracker.Web.Core.Extensions.Enums
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus

@inherits BaseComponent

<FluentCard class="mb-3" MinimalStyle="true">
    <FluentStack
        HorizontalAlignment="HorizontalAlignment.SpaceBetween"
        VerticalAlignment="VerticalAlignment.Center"
        Class="pb-3">
        
        <FluentLabel Typo="Typography.H3" Class="mb-2">
            @if (Statuses.Contains(TaskStatus.Backlog))
            {
                <text>📄 </text>
                @TaskStatus.Backlog.GetDisplayName()
            }
            else
            {
                <text>📋 </text>
                @TaskStatus.ToDo.GetDisplayName()
            }
        </FluentLabel>

        <FluentButton
            Disabled="@(!_selectedTasks.Any() || _isLoading)"
            Appearance="Appearance.Accent"
            BackgroundColor="@Color.Warning.GetDescription()"
            OnClick="@ArchiveTasks">
            To Archive(@_selectedTasks.Count)
        </FluentButton>
    </FluentStack>

    <FluentDivider Style="width: 100%;" Role="@DividerRole.Presentation"></FluentDivider>

    <FluentDataGrid
        TGridItem="TaskDto"
        Class="w-100"
        Loading="_isLoading"
        Virtualize="true"
        ItemSize="46"
        OnRowClick="@(async (eventObj) => await OnEditTask(eventObj.Item))"
        Items="@_tasks.AsQueryable()"
        ShowHover="true">

        <TemplateColumn
            Width="50px"
            Sortable="false">
            <HeaderCellItemTemplate>
                <FluentStack
                    HorizontalAlignment="HorizontalAlignment.Center"
                    VerticalAlignment="VerticalAlignment.Center"
                    Class="ps-3"
                    Style="height: 100%;">
                    <FluentCheckbox
                        @onclick:stopPropagation="true"
                        Label=" "
                        Value="@(IsSelectedAllTasks())"
                        ValueChanged="@(() => OnSelectAllTasks())"/>
                </FluentStack>
            </HeaderCellItemTemplate>
            <ChildContent>
                <FluentCheckbox
                    @onclick:stopPropagation="true"
                    Label=" "
                    Value="@(IsSelectedTask(context))"
                    ValueChanged="@(() => OnSelectTask(context))"/>
            </ChildContent>

        </TemplateColumn>
        <PropertyColumn
            Title="Id" Property="@(p => p.FormattedId)"
            Width="100px"
            Sortable="false"/>
        <TemplateColumn
            Title="Title"
            Sortable="false">
            @if (context.IsArchived)
            {
                <s>@context.Title</s>
            }
            else
            {
                @context.Title
            }
        </TemplateColumn>
        <PropertyColumn
            Title="Status"
            Property="@(p => p.Status.GetDisplayName())"
            Width="100px"
            Sortable="true"/>
        <TemplateColumn
            Title="Priority"
            Width="100px"
            Sortable="true">

            @{
                (string backgroundColor, string textColor) = context.Priority.GetColors();
            }
            <FluentBadge Appearance="Appearance.Neutral" Fill="lowlight" BackgroundColor="@backgroundColor" Color="@textColor">
                @context.Priority.GetDisplayName()
            </FluentBadge>
        </TemplateColumn>
        <PropertyColumn
            Title="Description"
            Property="@(p => p.Description)"
            Width="200px"
            Sortable="false"/>
        <PropertyColumn
            Title="Assigned"
            Property="@(p => p.User.Name)"
            Width="200px"
            Sortable="false"/>
    </FluentDataGrid>
</FluentCard>
