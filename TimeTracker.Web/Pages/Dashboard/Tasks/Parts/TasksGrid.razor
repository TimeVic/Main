@using TimeTracker.Api.Shared.Dto.Entity.Task
@using TimeTracker.Business.Extensions
@using TimeTracker.Web.Pages.Dashboard.Shared.Tasks
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus

@inherits BaseComponent

<FluentLabel Typo="Typography.H3" Class="mt-3">
    @if (Statuses.Contains(TaskStatus.Backlog))
    {
        @TaskStatus.Backlog.GetDisplayName()
    }
    else
    {
        @TaskStatus.ToDo.GetDisplayName()
    }
</FluentLabel>

<FluentDataGrid
    TGridItem="TaskDto"
    Class="w-100"
    Loading="_isLoading"
    Virtualize="true"
    ItemSize="45"
    OnRowClick="@(async (eventObj) => await OnEditTask(eventObj.Item))"
    Items="@_tasks.AsQueryable()"
    ShowHover="true">

    <PropertyColumn 
        Title="Id" Property="@(p => p.FormattedId)"
        Width="100px"
        Sortable="false"/>
    <PropertyColumn 
        Title="Title" 
        Property="@(p => p.Title)"
        Sortable="false"/>
    <PropertyColumn 
        Title="Status" 
        Property="@(p => p.Status.GetDisplayName())"
        Width="100px"
        Sortable="true"/>
    <PropertyColumn 
        Title="Priority"
        Property="@(p => p.Priority.GetDisplayName())"
        Width="100px"
        Sortable="true"/>
    <PropertyColumn 
        Title="Description" 
        Property="@(p => p.Description)"
        Width="200px"
        Sortable="false"/>
    <PropertyColumn 
        Title="Assigned" 
        Property="@(p => p.User.Name)"
        Width="200px"
        Sortable="false"/>
</FluentDataGrid>
