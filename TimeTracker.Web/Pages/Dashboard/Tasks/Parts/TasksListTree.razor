@using TimeTracker.Web.Pages.Dashboard.Shared
@using TimeTracker.Business.Extensions
@using MudBlazor

@inherits BaseReactiveComponent

<MudStack Spacing="2">
    <MudList 
        @ref="@_taskListList"
        SelectedValue="@_selectedTaskListId"
        Clickable="true">
        @foreach (var taskList in _tasksList)
        {
            <MudListItem
                
                Value="@taskList.Id"
                OnClick="@(() => OnSelectedTasksList(taskList.Id))"
                Text="@taskList.Name.Truncate(32, true)"/>
        }
        <MudDivider/>
        @if (!_tasksList.Any())
        {
            <MudListItem
                IconSize="Size.Small"
                Icon="@Icons.Material.Filled.Add"
                OnClick="@(ShowAddTaskListModal)"
                Text="Add new list"/>
        }
        else
        {
            <MudListItem 
                IconSize="Size.Small"
                OnClick="@ShowAddTaskListModal"
                Icon="@Icons.Material.Filled.Add"
                Text="Add"/>
            @if (_selectedTaskListId != 0)
            {
                <MudListItem 
                    IconSize="Size.Small"
                    OnClick="@ShowUpdateTaskListModal"
                    Icon="@Icons.Material.Filled.Edit"
                    Text="Update"/>
                <MudListItem 
                    IconSize="Size.Small"
                    OnClick="@OnDeleteTaskList"
                    Icon="@Icons.Material.Filled.Delete"
                    Text="Delete"/>
            }
        }
        
    </MudList>
</MudStack>
