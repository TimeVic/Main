@using TimeTracker.Web.Pages.Dashboard.Shared
@using TimeTracker.Business.Extensions
@using MudBlazor

@inherits BaseComponent

<MudStack Spacing="2">
    <MudTabs
        Position="Position.Left"
        Outlined="true"
        Rounded="true"
        Border="true">
        @foreach (var taskList in _tasksList)
        {
            <MudTabPanel
                ID="@taskList.Id"
                OnClick="() => OnTasksListSelected(taskList.Id)"
                Text="@taskList.Name"/>
        }
    </MudTabs>

    <MudStack Row="true">
        <MudIconButton
            Icon="@Icons.Material.Filled.Add"
            Title="Add new"
            OnClick="ShowAddTaskListModal"/>
        @if (_selectedTaskListId != null)
        {
            <MudSpacer/>
            <MudIconButton
                Icon="@Icons.Material.Filled.Edit"
                Title="Update active"
                OnClick="ShowUpdateTaskListModal"/>
            <MudSpacer/>
            <MudIconButton
                Color="Color.Error"
                Icon="@Icons.Material.Filled.Delete"
                Title="Delete active"
                OnClick="OnDeleteTaskList"/>    
        }
    </MudStack>
</MudStack>
