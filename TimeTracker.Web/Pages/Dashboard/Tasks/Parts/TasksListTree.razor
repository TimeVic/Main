@using TimeTracker.Web.Pages.Dashboard.Shared
@using TimeTracker.Business.Extensions

@inherits BaseComponent

<RadzenSplitButton
    Click="OnClickSplitButton"
    IsBusy="@(!_commonState.Value.IsInitialized)"
    Text="@_selectedTaskListName.TruncateAndAddDots(16)">
    <ChildContent>
        @foreach (var taskList in _tasksList)
        {
            <RadzenSplitButtonItem
                Text="@taskList.Name"
                Value="@taskList.Id.ToString()"/>
        }
        <hr/>
        <RadzenSplitButtonItem
            Value="@TaskListAction.Add.ToString()"
            Icon="add"
            Text="Add new"/>
        @if (_selectedTaskListId != null)
        {
            <RadzenSplitButtonItem
                Value="@TaskListAction.Edit.ToString()"
                Icon="edit"
                Text="Edit"/>
            <RadzenSplitButtonItem
                Value="@TaskListAction.Delete.ToString()"
                Icon="delete"
                Text="Delete"/>
        }
    </ChildContent>
</RadzenSplitButton>
