@using TimeTracker.Web.Pages.Dashboard.Shared

@inherits BaseComponent

<RadzenRow>
    <RadzenColumn class="d-flex justify-content-center">
        <RadzenSelectBar 
            TValue="long"
            Value="@_selectedTaskListId"
            ValueChanged="OnSelectedTasksList"
            TextProperty="Name"
            ValueProperty="Id" 
            Data="@_tasksList"
            Size="ButtonSize.Small"
            Class="rz-display-none rz-display-xl-flex" />
    </RadzenColumn>
    <RadzenColumn Style="max-width: 36px;">
        <RadzenButton
            Variant="Variant.Text"
            ButtonStyle="ButtonStyle.Primary"
            Class="w-100"
            Click="ShowAddTaskListModal"
            Icon="add">
        </RadzenButton>
    </RadzenColumn>
    <RadzenColumn Style="max-width: 36px;">
        <RadzenButton
            Variant="Variant.Text"
            ButtonStyle="ButtonStyle.Secondary"
            Class="w-100"
            Disabled="@(_selectedTaskListId == null)"
            Click="ShowUpdateTaskListModal"
            Icon="edit"/>
    </RadzenColumn>
    <RadzenColumn Style="max-width: 36px;">
        <RadzenButton
            Variant="Variant.Text"
            ButtonStyle="ButtonStyle.Danger"
            Class="w-100"
            Disabled="@(_selectedTaskListId == null)"
            Click="OnDeleteTaskList"
            Icon="delete"/>
    </RadzenColumn>
</RadzenRow>
