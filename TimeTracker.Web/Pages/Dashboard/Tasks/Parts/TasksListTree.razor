@using TimeTracker.Web.Shared.Components.Form

@inherits BaseReactiveComponent

<FluentToolbar Class="w-100">
    <FluentButton
        id="taskListsMenuAnchor"
        Appearance="Appearance.Accent"
        Disabled="@(!_tasksListState.Value.List.Any())"
        @onclick="@(() => _isTaskListsMenuOpened = !_isTaskListsMenuOpened)">
        <text>Select task list</text>
    </FluentButton>

    <FluentMenu Anchor="taskListsMenuAnchor" @bind-Open="_isTaskListsMenuOpened" VerticalThreshold="170">

        @foreach (var groupedItem in _groupedTasksList)
        {
            var project = _projectState.Value.List.First(item => item.Id == groupedItem.Key);
            <FluentLabel
                Class="mt-1"
                Typo="Typography.Body">
                @project.Name
            </FluentLabel>
            <hr/>
            foreach (var taskList in groupedItem)
            {
                <FluentMenuItem
                    Checked="@(taskList.Id == _selectedTaskList?.Id)"
                    OnClick="@((e) => OnSelectedTasksList(taskList))">
                    @taskList.Name
                </FluentMenuItem>
            }
        }
    </FluentMenu>

    <FluentButton
        Appearance="Appearance.Accent"
        Disabled="@(_selectedTaskList is null)"
        @onclick="@(ShowAddTaskModal)">
        Add task
    </FluentButton>

    @if (_selectedTaskList is not null)
    {
        <FluentButton
            Id="taskListMenuAnchor"
            IconStart="@(new Icons.Regular.Size24.Navigation())"
            Appearance="Appearance.Lightweight"
            @onclick="@(() => _isTaskListMenuOpened = !_isTaskListMenuOpened)"/>

        <FluentMenu Anchor="taskListMenuAnchor" @bind-Open="_isTaskListMenuOpened" VerticalThreshold="170">
            <FluentMenuItem
                OnClick="@(ShowAddTaskListModal)">
                Add new
            </FluentMenuItem>
            <FluentMenuItem
                Disabled="@(_selectedTaskList is null)"
                OnClick="@(ShowUpdateTaskListModal)">
                Update current
            </FluentMenuItem>
            <FluentMenuItem OnClick="@(OnDeleteTaskList)">
                Delete current
            </FluentMenuItem>
        </FluentMenu>
    }
    else
    {
        <FluentButton
            Appearance="Appearance.Accent"
            @onclick="@(ShowAddTaskListModal)">
            Add tasks list
        </FluentButton>
    }
</FluentToolbar>
