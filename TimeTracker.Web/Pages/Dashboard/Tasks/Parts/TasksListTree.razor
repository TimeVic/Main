@using TimeTracker.Web.Pages.Dashboard.Shared

@inherits BaseComponent

<RadzenRow>
    <RadzenColumn>
        <TaskListsDropDown
            Class="w-100"
            ProjectId="ProjectId"
            IsExtendedInfo="false"
            Value="@_selectedTaskListId"
            ValueChanged="OnSelectedTasksList"/>
    </RadzenColumn>
    <RadzenColumn Style="max-width: 36px;">
        <RadzenButton
            Variant="Variant.Text"
            ButtonStyle="ButtonStyle.Primary"
            Class="w-100"
            Click="ShowAddTaskListModal"
            Icon="add">
        </RadzenButton>
    </RadzenColumn>
    <RadzenColumn Style="max-width: 36px;">
        <RadzenButton
            Variant="Variant.Text"
            ButtonStyle="ButtonStyle.Secondary"
            Class="w-100"
            Disabled="@(_selectedTaskListId == null)"
            Click="ShowUpdateTaskListModal"
            Icon="edit"/>
    </RadzenColumn>
    <RadzenColumn Style="max-width: 36px;">
        <RadzenButton
            Variant="Variant.Text"
            ButtonStyle="ButtonStyle.Danger"
            Class="w-100"
            Disabled="@(_selectedTaskListId == null)"
            Click="OnDeleteTaskList"
            Icon="delete"/>
    </RadzenColumn>
</RadzenRow>
