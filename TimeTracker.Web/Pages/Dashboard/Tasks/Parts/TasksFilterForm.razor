@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Tasks
@using Microsoft.AspNetCore.Components

@inherits BaseComponent

<RadzenRow class="mb-1">
    <RadzenColumn style="max-width: 200px">
        <TasksListTree/>
    </RadzenColumn>
    <RadzenColumn>
        <RadzenTextBox
            Name="Title"
            Value="@Filter.SearchString"
            ValueChanged="OnChangeSearchString"
            Placeholder="Write anything"
            Class="w-100"/>
    </RadzenColumn>
    <RadzenColumn style="max-width: 150px">
        <MembersDropDown
            Class="w-100"
            Value="@(Filter.AssignedUserId ?? 0)"
            ValueChanged="OnChangeAssignedUserId"/>
    </RadzenColumn>
    <RadzenColumn Style="max-width: 150px;">
        <YesNoDropDown
            Class="w-100"
            Placeholder="Only archived"
            ValueChanged="OnChangeIsArchived"
            Value="@Filter.IsArchived"/>
    </RadzenColumn>
</RadzenRow>

