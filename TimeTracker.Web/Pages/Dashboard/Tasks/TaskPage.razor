@page "/board/task/{WorkspaceId:long}/{TaskId:long}"

@using TimeTracker.Web.Pages.Dashboard.Shared
@using TimeTracker.Web.Pages.Dashboard.Shared.Tasks

@inherits BaseReactiveComponent
@layout Layout

<FluentCard class="w-100">
    <FluentButton
        IconStart="@(new Icons.Filled.Size32.ArrowLeft())"
        Appearance="Appearance.Neutral"
        OnClick="@NavigateToTasksPage">
        To list
    </FluentButton>
</FluentCard>

<FluentCard class="w-100">
    @if (_isLoading)
    {
        <FluentProgressRing></FluentProgressRing>
    }
    else
    {
        <UpdateTaskForm Task="_task"/>
    }
</FluentCard>
