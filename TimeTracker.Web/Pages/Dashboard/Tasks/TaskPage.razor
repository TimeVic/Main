@page "/board/task/{WorkspaceId:long}/{TaskId:long}"

@using TimeTracker.Web.Pages.Dashboard.Shared
@using TimeTracker.Web.Pages.Dashboard.Shared.Tasks

@inherits BaseReactiveComponent
@layout Layout

<RadzenCard class="no-gutters w-100">
    <RadzenButton
        Click="NavigateToTasksPage"
        Icon="arrow_back_ios"
        ButtonStyle="ButtonStyle.Light"
        Text="To list"
    />
</RadzenCard>

<RadzenCard class="no-gutters mt-1 ml-2 w-100">
    @if (_isLoading)
    {
        <MudProgressCircular Color="Color.Info" Indeterminate="true" />
    }
    else
    {
        <UpdateTaskForm Task="_task"/>
    }
</RadzenCard>
