@page "/board/overdue-tasks"

@using TimeTracker.Web.Pages.Dashboard.Shared.Tasks
@using TimeTracker.Web.Pages.Dashboard.Shared
@using TimeTracker.Business.Extensions

@inherits BaseComponent
@layout Layout

<MudStack>
    @if (TasksState.Value.IsOverdueListLoading)
    {
        <MudStack AlignItems="AlignItems.Center">
            <MudProgressCircular Color="Color.Info" Indeterminate="true" />
        </MudStack>
    }
    else
    {
        var overdueTasks = _tasks.Where(item => item.EndTime < _listStartDate).ToList();
        if (overdueTasks.Any())
        {
            <MudText Typo="Typo.subtitle2">Overdue</MudText>
            <MudDivider></MudDivider>
            foreach (var task in overdueTasks)
            {
                <TaskCard Task="@task"></TaskCard>
            }
            <MudSpacer/>    
        }

        @foreach (var date in _listStartDate.GetDateRange(_listEndDate))
        {
            <MudText Typo="Typo.subtitle2">@date.ToString("MMM dd yyyy - dddd")</MudText>
            <MudDivider></MudDivider>
            foreach (var task in _tasks)
            {
                if (task.EndTime.HasValue && task.EndTime.Value.Date == date)
                {
                    <TaskCard
                        Task="@task"
                        IsShowTaskList="true">
                    </TaskCard>
                }
            }

            <MudStack Spacing="0" Justify="Justify.FlexStart" AlignItems="AlignItems.Start">
                <MudButton
                    Size="Size.Small"
                    OnClick="@(() => OnAddTask(date))"
                    StartIcon="@Icons.Material.Filled.Add">
                    Add task
                </MudButton>
            </MudStack>
            <MudSpacer/>
            <MudSpacer/>
        }
    }
</MudStack>
