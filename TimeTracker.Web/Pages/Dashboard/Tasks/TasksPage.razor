@page "/board/tasks/{ProjectId:long}/{TaskListId:long}"
@page "/board/tasks/{ProjectId:long}"

@using TimeTracker.Web.Pages.Dashboard.Shared
@using MudBlazor
@using TimeTracker.Web.Pages.Dashboard.Tasks.Parts
@using TasksTable = TimeTracker.Web.Pages.Dashboard.Dashboard.Parts.TasksTable

@inherits BaseComponent
@layout Layout

<MudStack>
    <CascadingValue Name="TaskListId" Value="@TaskListId">
        <CascadingValue Name="ProjectId" Value="@ProjectId">
            <MudStack>
                <MudPaper>
                    <TasksFilterForm/>
                </MudPaper>
                <MudStack Row="true">
                    <TasksListTree/>
                    <TasksTable/>
                </MudStack>
            </MudStack>
        </CascadingValue>
    </CascadingValue>
</MudStack>
