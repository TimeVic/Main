@page "/board/tasks/{TaskListId:long}"
@page "/board/tasks"

@using TimeTracker.Web.Pages.Dashboard.Shared
@using TimeTracker.Web.Pages.Dashboard.Tasks.Parts

@inherits BaseComponent
@layout Layout

<FluentStack Class="w-100 p-2">
    <CascadingValue Name="TaskListId" Value="@TaskListId">
        <FluentStack Orientation="Orientation.Vertical">
            <TasksListTree/>

            <FluentLabel
                Class="mt-2 mb-2"
                Typo="Typography.H3">
                @_selectedTaskList?.Name
            </FluentLabel>

            <FluentDivider 
                Class="mb-2 w-100"
                Orientation="Orientation.Horizontal"/>
            
            @if (_selectedTaskList != null)
            {
                <TasksFilterForm/>

                <FluentStack Orientation="Orientation.Horizontal">
                    <TasksTable/>
                </FluentStack>
            }
        </FluentStack>
    </CascadingValue>
</FluentStack>
