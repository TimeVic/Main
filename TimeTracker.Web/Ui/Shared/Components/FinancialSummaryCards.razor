@inherits BaseReactiveComponent

<section class="grid gap-4 md:grid-cols-3 @Class">
    <LumexCard>
        <LumexCardBody>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Total Earned</p>
            <p class="mt-2 text-3xl font-semibold text-slate-900">
                <AmountDisplay Amount="@TotalEarned"/>
            </p>
            <p class="mt-1 text-sm text-slate-500">@EarnedCaption</p>
        </LumexCardBody>
    </LumexCard>

    <LumexCard>
        <LumexCardBody>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Total Received</p>
            <p class="mt-2 text-3xl font-semibold text-emerald-700">
                <AmountDisplay Amount="@TotalPaid"/>
            </p>
            <p class="mt-1 text-sm text-slate-500">@PaidCaption</p>
        </LumexCardBody>
    </LumexCard>

    <LumexCard Class="@(OutstandingBalance > 0 ? "border-red-200 bg-red-50/40" : "border-emerald-200 bg-emerald-50/30")">
        <LumexCardBody>
            <p class="text-xs font-semibold uppercase tracking-wide @(OutstandingBalance > 0 ? "text-red-600" : "text-emerald-700")">Outstanding Balance</p>
            <p class="mt-2 text-3xl font-semibold @(OutstandingBalance > 0 ? "text-red-700" : "text-emerald-700")">
                <AmountDisplay Amount="@OutstandingBalance"/>
            </p>
            <p class="mt-1 text-sm @(OutstandingBalance > 0 ? "text-red-700" : "text-slate-500")">@OutstandingCaption</p>
        </LumexCardBody>
    </LumexCard>
</section>

@code {
    [Parameter]
    public decimal TotalEarned { get; set; }

    [Parameter]
    public decimal TotalPaid { get; set; }

    [Parameter]
    public decimal OutstandingBalance { get; set; }

    [Parameter]
    public string EarnedCaption { get; set; } = "Billable value of tracked work";

    [Parameter]
    public string PaidCaption { get; set; } = "Payments recorded from clients";

    [Parameter]
    public string OutstandingCaption { get; set; } = "Still unpaid";

    [Parameter]
    public string Class { get; set; } = string.Empty;
}
