@using LumexUI.Common
<LumexModal 
    Open="true" 
    Size="ModalSize.Full"
    OnClose="@OnClose"
    @ref="modal">
    <LumexModalContent>
        <LumexModalHeader Class="flex items-center gap-3">
            <div class="flex items-start gap-4">
                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-blue-600">Emoji library</p>
                <h2 class="mt-2 text-xl font-semibold text-slate-900">Choose an emoji</h2>
                <p class="mt-1 text-sm text-slate-500">Search by name, category, or HTML code and insert an emoji into the workspace name.</p>
            </div>
        </LumexModalHeader>
        <LumexModalBody>
            <div class="mt-5 flex flex-col gap-3 lg:flex-row lg:items-center">
                <div class="min-w-0 flex-1">
                    <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Search emoji</label>
                    <InputText @bind-Value="searchText" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700 focus:border-blue-500 focus:outline-none" placeholder="For example: rocket, fire, heart, &#128640; or &#x1F680;" />
                </div>
                <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600 lg:w-[220px]">
                    Found: <span class="font-semibold text-slate-900">@FilteredEmojis.Count()</span>
                </div>
            </div>

            <div class="mt-4 flex flex-wrap gap-2">
                @foreach (var category in Categories)
                {
                    <button type="button" @onclick="@(() => SetCategory(category))" class="@(activeCategory == category ? "inline-flex items-center rounded-full bg-blue-600 px-3 py-2 text-xs font-semibold text-white shadow-sm" : "inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600 transition hover:border-slate-300 hover:bg-slate-50")">
                        @category
                    </button>
                }
            </div>
            
            <div class="max-h-[65vh] overflow-y-auto p-5 sm:p-6">
                @if (FilteredEmojis.Any())
                {
                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
                        @foreach (var emoji in FilteredEmojis)
                        {
                            <button type="button" @onclick="@(() => SelectEmojiAsync(emoji.Symbol))" class="group flex h-full flex-col items-start rounded-3xl border border-slate-200 bg-white p-4 text-left transition hover:-translate-y-0.5 hover:border-blue-300 hover:bg-blue-50 hover:shadow-sm">
                                <div class="flex w-full items-start justify-between gap-3">
                                    <span class="text-3xl leading-none">@emoji.Symbol</span>
                                    <span class="rounded-full bg-slate-100 px-2 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500 transition group-hover:bg-white">@emoji.Category</span>
                                </div>
                                <p class="mt-3 text-sm font-semibold text-slate-900">@emoji.Name</p>
                                <p class="mt-1 line-clamp-2 text-xs text-slate-500">@emoji.Keywords</p>
                                <p class="mt-3 rounded-xl bg-slate-50 px-2 py-1 text-[11px] text-slate-500">@emoji.HtmlCode</p>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-6 py-14 text-center">
                        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white text-3xl shadow-sm">🔎</div>
                        <h3 class="mt-4 text-lg font-semibold text-slate-900">No matches found</h3>
                        <p class="mt-2 text-sm text-slate-500">Try a different search term or switch the category.</p>
                    </div>
                }
            </div>
        </LumexModalBody>
    </LumexModalContent>
</LumexModal>
