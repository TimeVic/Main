@using TimeTracker.Web.Services.UI.Modal

@code {
    [Inject]    
    public ModalDialogService ModalDialogService { get; set; }      
    
    protected override void OnInitialized()
    {
        ModalDialogService.OnChange += StateHasChanged;
    }
}



@foreach (var modal in ModalDialogService.Modals)
{
    @modal.Fragment
}

