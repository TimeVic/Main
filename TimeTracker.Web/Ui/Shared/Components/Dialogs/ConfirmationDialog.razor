@implements IDialogContentComponent<ConfirmationDialog.Parameters>

@* Footer *@
<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Accent" OnClick="@Submit">Save</FluentButton>
    <FluentButton Appearance="Appearance.Neutral" OnClick="@Cancel">Cancel</FluentButton>
</FluentDialogFooter>

@* Body *@
<FluentDialogBody>
    @Content.Message
</FluentDialogBody>

@code {

    public class Parameters
    {
        public required string Message { get; set; }
    
        public required Color ButtonColor { get; set; }
    
        public required string ButtonText { get; set; }
    }

    [CascadingParameter]
    FluentDialog Dialog { get; set; }

    [Parameter]
    public Parameters Content { get; set; }
    
    void Submit() => Dialog.CloseAsync(DialogResult.Ok(true));
    void Cancel() => Dialog.CloseAsync();
}
