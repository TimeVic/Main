@using LumexUI.Common
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using TimeTracker.Web.Core.Helpers
@using TimeTracker.Web.Ui.Shared.Components.Helper.Portal

<div class="relative inline-block">
    <LumexButton
        OnClick="TogglePopup"
        Color="ThemeColor.Primary"
        IconOnly="true"
        Size="Size.Small"
        Variant="Variant.Outlined">
        <StartContent>😊</StartContent>
    </LumexButton>
</div>

@code {
    private bool IsOpen { get; set; }
    private const double ViewportPadding = 8;
    private const double PopupWidth = 320;
    private const double PopupOffset = 12;
    private readonly string popupId = Guid.NewGuid().ToString("N");

    [Parameter] public string Title { get; set; } = "Popup";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private RenderFragment PopupPanel
    {
        get
        {
            return @<div class="w-80 max-w-[calc(100vw-1rem)] overflow-auto rounded-2xl border border-slate-200 bg-white shadow-2xl ring-1 ring-black/5">
                       @if (!string.IsNullOrWhiteSpace(Title))
                       {
                           <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3">
                               <h3 class="text-sm font-semibold text-slate-900">@Title</h3>
                               <button type="button"
                                       class="flex h-8 w-8 items-center justify-center rounded-full text-slate-500 transition hover:bg-slate-100 hover:text-slate-700"
                                       @onclick="ClosePopup">
                                   <i class="fa-solid fa-xmark"></i>
                               </button>
                           </div>
                       }

                       <div class="p-4 text-sm text-slate-700">
                           @ChildContent
                       </div>
                   </div>;
        }
    }

    private void TogglePopup(MouseEventArgs e)
    {
        if (PopupPortalStore.IsOpen(popupId))
        {
            ClosePopup();
            return;
        }

        PopupPortalStore.Show(popupId, PopupPanel, BuildPanelStyle(e));
    }

    private void ClosePopup()
    {
        if (PopupPortalStore.IsOpen(popupId))
        {
            PopupPortalStore.Close();
        }
    }

    private static string BuildPanelStyle(MouseEventArgs e)
    {
        var left = Math.Max(ViewportPadding, Math.Min(e.ClientX - PopupWidth + 32, e.ClientX - ViewportPadding));
        var top = Math.Max(ViewportPadding, e.ClientY + PopupOffset);

        return $"left:{left}px; top:{top}px; max-width:calc(100vw - 1rem); max-height:calc(100vh - {top + ViewportPadding}px);";
    }
}
