@using LumexUI
@using LumexUI.Common
@using TimeTracker.Business.Common.Services.Format
@using TimeTracker.Business.Extensions
@using Orientation = Microsoft.FluentUI.AspNetCore.Components.Orientation

<div Class="@Class">
    <FluentLabel>@Label</FluentLabel>
    <FluentStack Orientation="Orientation.Horizontal">
        <LumexDatebox 
            TValue="DateTime?"
            Size="Size.Small"
            Placeholder="@Placeholder"
            Value="@_value"
            ValueChanged="OnDateChanged"
            Label="@Label"/>
        <TimeEditField
            Value="@_timeValue"
            ValueChanged="@(OnTimeChanged)"/>
    </FluentStack>
</div>

@code
{
    [Parameter]
    public string Class { get; set; }

    [Parameter]
    public string Label { get; set; }

    [Parameter]
    public string Placeholder { get; set; }

    [Parameter] 
    public Boolean Disabled { get; set; } = false;

    [Inject]
    public ITimeParsingService _timeParsingService { get; set; }

    [Parameter]
    public virtual Func<DateTime, bool>? DisabledDateFunc { get; set; }

    [Parameter]
    public DateTime? Value
    {
        set
        {
            _value = value;
            UpdateTimeValue();
        }
    }
    
    [Parameter]
    public EventCallback<DateTime?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<DateTime?> Changed { get; set; }

    private DateTime? _value;
    private TimeSpan? _timeValue;

    protected override void OnInitialized()
    {
    }

    private void OnDateChanged(DateTime? date)
    {
        var currentTime = _value?.TimeOfDay;

        _value = date;
        if (currentTime != null)
        {
            _value = _value?.StartOfDay().Add(currentTime.Value);
        }
        UpdateTimeValue();
        ValueChanged.InvokeAsync(_value);
        Changed.InvokeAsync(_value);
    }

    private void OnTimeChanged(TimeSpan? time)
    {
        _value = _value?.StartOfDay();
        if (time != null)
        {
            _value = _value?.StartOfDay().Add(time.Value);
        }
        UpdateTimeValue();
        ValueChanged.InvokeAsync(_value);
        Changed.InvokeAsync(_value);
    }


    private void UpdateTimeValue()
    {
        if (_value.HasValue)
        {
            _timeValue = _value.Value.TimeOfDay;
            return;
        }
        _timeValue = null;
    }
}
