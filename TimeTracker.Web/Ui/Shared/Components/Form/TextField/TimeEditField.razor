@using LumexUI
@using LumexUI.Common
@using TimeTracker.Business.Common.Services.Format

<LumexTextbox
    Value="@_editValue"
    ValueChanged="@OnChangeValue"
    Class="@Class"
    Placeholder="@Placeholder"
    Type="InputType.Text"
    Label="@Label"
    Disabled="Disabled"
    Required="true"
    Variant="InputVariant.Outlined"
    Color="ThemeColor.Default"
    Size="Size.Small"
    FullWidth="@FullWidth"
    Clearable="@Clearable">
</LumexTextbox>

@code
{
    [Parameter]
    public string Class { get; set; }

    [Parameter]
    public string Label { get; set; }

    [Parameter]
    public string Placeholder { get; set; }

    [Parameter] 
    public Boolean Disabled { get; set; } = false;

    [Parameter] 
    public Boolean FullWidth { get; set; } = false;
    
    [Parameter] 
    public Boolean Clearable { get; set; } = false;
    
    [Inject]
    public ITimeParsingService _timeParsingService { get; set; }
    
    [Parameter]
    public TimeSpan? Value
    {
        set
        {
            _value = value;
            if (_value != null)
            {
                _editValue = _timeParsingService.TimeSpanToTimeString(_value.Value);
            }
            else
            {
                _editValue = string.Empty;
            }
        }
    }

    [Parameter]
    public int RowsMin { get; set; } = 6;

    [Parameter]
    public EventCallback<TimeSpan?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string> Changed { get; set; }

    private TimeSpan? _value;
    private string _editValue;

    protected override void OnInitialized()
    {
    }

    private void OnChangeValue(string? value)
    {
        _editValue = value != null ? _timeParsingService.FormatTime(value) : string.Empty;
        _value = value != null ? _timeParsingService.ParseTimeSpan(value) : null;
        StateHasChanged();
        ValueChanged.InvokeAsync(_value);
    }
}
