@inherits CustomValidationSummaryBase

@if (_validationMessages.Any())
{
    <div class="mt-4 rounded-2xl border border-red-200 bg-red-50/90 p-4 shadow-sm shadow-red-100/60">
        <div class="mb-3 flex items-center gap-2 text-sm font-semibold text-red-700">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>Please fix the highlighted fields before saving.</span>
        </div>
        <div class="text-sm text-red-700 [&_ul]:m-0 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5 [&_li]:leading-6 [&_li::marker]:text-red-400">
            <ul class="validation-errors">
                @foreach (var message in _validationMessages)
                {
                    <li class="validation-message">@message</li>
                }
            </ul>
        </div>
    </div>
}
