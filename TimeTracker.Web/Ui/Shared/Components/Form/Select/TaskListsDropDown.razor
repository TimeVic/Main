@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons
@using TimeTracker.Api.Shared.Dto.Entity.Task

@inherits TimeTracker.Web.Ui.Shared.Components.Form.Select.Core.BaseSingleSelect<TaskListDto>

<div class="@Class @(FullWidth ? "w-full" : "")">
    
    <LumexSelect 
        TValue="TaskListDto"
        Label="@Label"
        Placeholder="@_placeholder"
        LabelPlacement="@LabelPlacement.Outside"
        Variant="@Variant"
        ValueChanged="dto => OnValueChanged(dto)"
        Value="_selectedItem"
        Disabled="@(Disabled || !ProjectId.HasValue)"
        FullWidth="@FullWidth"
        Invalid="@IsInvalid">
        <ChildContent>
            @if (Clearable && _selectedItem != null)
            {
                <LumexSelectItem Value="@_clearSentinel" TextValue="">
                    <div class="flex items-center gap-2 text-slate-400">
                        <i class="fa-solid fa-xmark text-xs"></i>
                        <span class="text-small">@DashboardLocalizer["None"]</span>
                    </div>
                </LumexSelectItem>
            }
            @foreach (var character in _list)
            {
                <LumexSelectItem @key="@character" Value="@character">
                    <div class="flex gap-2 items-center">
                        <div class="flex flex-col">
                            <span class="text-small">@character.Name</span>
                        </div>
                    </div>
                </LumexSelectItem>
            }
        </ChildContent>
        <ValueContent>
            <div class="flex items-center gap-2">
                <div class="flex flex-col">
                    <span>@context?.Name</span>
                </div>
            </div>
        </ValueContent>
    </LumexSelect>
</div>
