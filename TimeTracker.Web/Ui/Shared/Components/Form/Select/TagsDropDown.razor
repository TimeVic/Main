@using LumexUI
@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity

@inherits BaseReactiveComponent

<div class="min-w-0 max-w-full @Class @(FullWidth ? "w-100" : "")">
    <LumexSelect
        TValue="TagDto"
        Label="@Label"
        Placeholder="@Placeholder"
        LabelPlacement="@LabelPlacement.Outside"
        Variant="@Variant"
        Color="ThemeColor.Default"
        Values="@_selectedItems"
        ValuesChanged="OnValueChanged"
        Disabled="@Disabled"
        FullWidth="@FullWidth"
        ListboxMaxHeight="256"
        Classes="@_selectClasses">
        <ChildContent>
            @foreach (var tag in _list)
            {
                <LumexSelectItem @key="@tag.Id" Value="@tag" TextValue="@tag.Name">
                    <div class="flex min-w-0 items-center gap-2">
                        <span
                            class="inline-block h-3 w-3 shrink-0 rounded border border-slate-200"
                            style="@GetColorStyle(tag)">
                        </span>
                        <span class="truncate text-small">@tag.Name</span>
                    </div>
                </LumexSelectItem>
            }
        </ChildContent>
        <ValueContent>
            @if (context != null)
            {
                <LumexChip
                    Class="min-w-0 max-w-full"
                    Size="Size.Small"
                    Radius="Radius.Small"
                    Variant="ChipVariant.Flat"
                    Color="ThemeColor.Default">
                    <StartContent>
                        <span
                            class="inline-block h-3 w-3 shrink-0 rounded border border-slate-200"
                            style="@GetColorStyle(context)">
                        </span>
                    </StartContent>
                    <ChildContent>
                        <span class="block max-w-[10rem] truncate">@context.Name</span>
                    </ChildContent>
                </LumexChip>
            }
        </ValueContent>
    </LumexSelect>
</div>
