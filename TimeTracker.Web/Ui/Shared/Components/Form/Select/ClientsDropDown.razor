@inherits TimeTracker.Web.Ui.Shared.Components.Form.Select.Core.BaseSingleSelect<ClientDto>

@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons
@using TimeTracker.Api.Shared.Dto.Entity

<div class="flex gap-1">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="mb-1 block text-xs font-medium tracking-wide text-slate-500">@Label</label>
    }
    <LumexDropdown>
        <LumexDropdownTrigger>
            <LumexButton
                Disabled="Disabled"
                FullWidth="true"
                Color="ThemeColor.Info"
                Variant="Variant.Outlined">
                @if (_selectedItem is null)
                {
                    @_placeholder
                }
                else
                {
                    @_selectedItem?.Name
                }
            </LumexButton>
        </LumexDropdownTrigger>
        <LumexDropdownMenu
            Color="ThemeColor.Info"
            Variant="MenuVariant.Outlined">
            @foreach (var project in _list)
            {
                <LumexDropdownItem OnClick="@(() => OnValueChanged(project))">
                    @project?.Name
                </LumexDropdownItem>
            }
        </LumexDropdownMenu>
    </LumexDropdown>
    @if (Clearable)
    {
        <CustomButton
            OnClick="OnClear"
            Variant="Variant.Outlined"
            Color="ThemeColor.Default"
            Size="Size.Large"
            FullWidth="false"
            IconOnly="true">
            <XIcon/>
        </CustomButton>
    }
</div>
