@inherits TimeTracker.Web.Ui.Shared.Components.Form.Select.Core.BaseSingleSelect<ClientDto>

@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons
@using TimeTracker.Api.Shared.Dto.Entity

<div class="justify-content-start w-select @Class @(FullWidth ? "w-100" : "")">
    <LumexDropdown>
        <LumexDropdownTrigger>
            <LumexButton 
                FullWidth="true"
                Color="ThemeColor.Info" 
                Variant="Variant.Outlined"
            >
                @if (_selectedItem is null)
                {
                    @_placeholder
                }
                else
                {
                    @_selectedItem?.Name
                }
            </LumexButton>
        </LumexDropdownTrigger>
        <LumexDropdownMenu
            Color="ThemeColor.Info" 
            Variant="MenuVariant.Outlined">
            @foreach (var project in _list)
            {
                <LumexDropdownItem OnClick="@(() => OnValueChanged(project))">
                    @project?.Name
                </LumexDropdownItem>
            }
        </LumexDropdownMenu>
    </LumexDropdown>
    @if (Clearable)
    {
        <CustomButton 
            OnClick="OnClear"
            IconOnly="true">
            <XIcon/>
        </CustomButton>
    }
</div>
