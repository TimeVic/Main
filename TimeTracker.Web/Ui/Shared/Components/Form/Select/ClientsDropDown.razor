@inherits TimeTracker.Web.Ui.Shared.Components.Form.Select.Core.BaseSingleSelect<ClientDto>

@using LumexUI
@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity

<div class="flex gap-1">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="mb-1 block text-xs font-medium tracking-wide text-slate-500">@Label</label>
    }
    <LumexDropdown>
        <LumexDropdownTrigger>
            <LumexButton
                Disabled="Disabled"
                FullWidth="true"
                Color="@(IsInvalid ? ThemeColor.Danger : ThemeColor.Info)"
                Variant="Variant.Outlined"
                Class="@SelectClass">
                @if (_selectedItem is null)
                {
                    @_placeholder
                }
                else
                {
                    @_selectedItem?.Name
                }
            </LumexButton>
        </LumexDropdownTrigger>
        <LumexDropdownMenu
            Color="ThemeColor.Info"
            Variant="MenuVariant.Outlined">
            @if (Clearable && _selectedItem != null)
            {
                <LumexDropdownItem OnClick="@(() => OnValueChanged(null))" Class="text-slate-400">
                    <span class="flex items-center gap-2">
                        <i class="fa-solid fa-xmark text-xs"></i>
                        None
                    </span>
                </LumexDropdownItem>
            }
            @foreach (var project in _list)
            {
                <LumexDropdownItem OnClick="@(() => OnValueChanged(project))">
                    @project?.Name
                </LumexDropdownItem>
            }
        </LumexDropdownMenu>
    </LumexDropdown>
</div>
