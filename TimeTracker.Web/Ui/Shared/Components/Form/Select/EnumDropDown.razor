@using LumexUI
@using LumexUI.Common
@using Microsoft.FluentUI.AspNetCore.Components.Extensions
@using TimeTracker.Web.Constants.Ui
@using TimeTracker.Web.Core.Helpers

@typeparam TItem where TItem: struct, IConvertible

<div class="@Class @(FullWidth ? "w-100" : "")">
    @if (SelectType == DropDownType.DropDown)
    {
        <LumexDropdown Size="Size">
            <LumexDropdownTrigger>
                <LumexButton
                    FullWidth="true"
                    Color="ThemeColor.Info"
                    Variant="Variant.Outlined">
                    @if (_value is null)
                    {
                        @_placeholder
                    }
                    else
                    {
                        @_value?.GetDescription()
                    }
                </LumexButton>
            </LumexDropdownTrigger>
            <LumexDropdownMenu
                Color="ThemeColor.Info"
                Variant="MenuVariant.Outlined">
                @foreach (var item in _list)
                {
                    <LumexDropdownItem OnClick="@(() => OnItemSelected(item))">
                        @(EnumHelpers.GetDisplayName(typeof(TItem), item))
                    </LumexDropdownItem>
                }
            </LumexDropdownMenu>
        </LumexDropdown>    
    }
    else
    {
        <LumexSelect 
            TValue="TItem?"
            Label="@Label"
            Placeholder="@_placeholder"
            LabelPlacement="@LabelPlacement.Outside"
            ValueChanged="dto => OnItemSelected(dto)"
            Value="_value">
            <ChildContent>
                @foreach (var character in _list)
                {
                    <LumexSelectItem @key="@character" Value="@character">
                        @character?.GetDescription()
                    </LumexSelectItem>
                }
            </ChildContent>
            <ValueContent>
                @if (context is null)
                {
                    return;
                }
                @(EnumHelpers.GetDisplayName(typeof(TItem), context))
            </ValueContent>
        </LumexSelect>
    }
</div>
