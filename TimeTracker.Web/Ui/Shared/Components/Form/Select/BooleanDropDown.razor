@using LumexUI
@using LumexUI.Common
@using TimeTracker.Web.Constants.Ui

<div class="@Class @(FullWidth ? "w-100" : "")">
    @if (SelectType == DropDownType.DropDown)
    {
        @if (!string.IsNullOrEmpty(Label))
        {
            <label class="block text-sm font-medium mb-1">@Label</label>
        }
        <LumexDropdown
            Open="@_isOpen"
            OpenChanged="@OnOpenChanged">
            <LumexDropdownTrigger>
                <LumexButton
                    FullWidth="@FullWidth"
                    Color="ThemeColor.Default"
                    Variant="Variant.Outlined"
                    Class="@(FullWidth ? "w-100" : "")">
                    @if (Value.HasValue)
                    {
                        @(Value.Value ? DashboardLocalizer["Yes"] : DashboardLocalizer["No"])
                    }
                    else
                    {
                    @(string.IsNullOrWhiteSpace(Placeholder) ? DashboardLocalizer["Select"] : Placeholder)
                    }
                </LumexButton>
            </LumexDropdownTrigger>
            <LumexDropdownMenu
                Color="ThemeColor.Default"
                Variant="MenuVariant.Outlined">
                @if (Clearable && Value.HasValue)
                {
                    <LumexDropdownItem
                        OnClick="@(() => OnItemSelected(null))"
                        Class="text-slate-400">
                        <ChildContent>
                            <span class="flex items-center gap-2">
                                <i class="fa-solid fa-xmark text-xs"></i>
                                @DashboardLocalizer["None"]
                            </span>
                        </ChildContent>
                    </LumexDropdownItem>
                }
                <LumexDropdownItem OnClick="@(() => OnItemSelected(true))">@DashboardLocalizer["Yes"]</LumexDropdownItem>
                <LumexDropdownItem OnClick="@(() => OnItemSelected(false))">@DashboardLocalizer["No"]</LumexDropdownItem>
            </LumexDropdownMenu>
        </LumexDropdown>
    }
    else
    {
        <LumexSelect
            TValue="bool?"
            Label="@Label"
            Placeholder="@(string.IsNullOrWhiteSpace(Placeholder) ? DashboardLocalizer["Select"].Value : Placeholder)"
            LabelPlacement="LabelPlacement.Outside"
            Variant="InputVariant.Outlined"
            Color="ThemeColor.Default"
            Clearable="@Clearable"
            OnCleared="@(() => OnItemSelected(null))"
            ValueChanged="OnSelectValueChanged"
            Value="Value">
            <ChildContent>
                <LumexSelectItem Value="@((bool?)true)" TextValue="@DashboardLocalizer["Yes"].Value">@DashboardLocalizer["Yes"]</LumexSelectItem>
                <LumexSelectItem Value="@((bool?)false)" TextValue="@DashboardLocalizer["No"].Value">@DashboardLocalizer["No"]</LumexSelectItem>
            </ChildContent>
            <ValueContent>
                @if (context.HasValue)
                {
                    <span>@(context.Value ? DashboardLocalizer["Yes"] : DashboardLocalizer["No"])</span>
                }
            </ValueContent>
        </LumexSelect>
    }
</div>
