@inherits TimeTracker.Web.Ui.Shared.Components.Form.Select.Core.BaseSingleSelect<WorkspaceMembershipDto>

@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants

<div class="justify-content-start w-select @Class @(FullWidth ? "w-100" : "")">
    <FluentSelect
        TOption="WorkspaceMembershipDto?"
        
        Label="@Label"
        Class="@SelectClass"
        Disabled="@Disabled"
        Required="Required"
        Placeholder="@_placeholder"
        Items="@_list.ToList()"
        @bind-Value="@_selectedId"
        OptionValue="@(dto => dto?.Id.ToString())"
        
        SelectedOptionChanged="OnValueChanged">
        <OptionTemplate>
            @context?.User.Name
        </OptionTemplate>
    </FluentSelect>

    @if (Clearable)
    {
        <FluentButton 
            Class="w-select-clear-btn"
            IconStart="@(new Icons.Filled.Size16.Dismiss())" 
            OnClick="OnClear"/>
    }
</div>
