@inherits TimeTracker.Web.Ui.Shared.Components.Form.Select.Core.BaseSingleSelect<WorkspaceMembershipDto>

@using LumexUI
@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants

<div class="@Class @(FullWidth ? "w-100" : "")">
    <LumexSelect 
        TValue="WorkspaceMembershipDto"
        Label="@Label"
        Placeholder="@_placeholder"
        LabelPlacement="@LabelPlacement.Outside"
        ValueChanged="dto => OnValueChanged(dto)"
        Value="_selectedItem"
        Invalid="@IsInvalid">
        <ChildContent>
            @if (Clearable && _selectedItem != null)
            {
                <LumexSelectItem Value="@((WorkspaceMembershipDto?)null)" TextValue="">
                    <div class="flex items-center gap-2 text-slate-400">
                        <i class="fa-solid fa-xmark text-xs"></i>
                        <span>None</span>
                    </div>
                </LumexSelectItem>
            }
            @foreach (var character in _list)
            {
                <LumexSelectItem @key="@character" Value="@character">
                    @character?.User.Name
                </LumexSelectItem>
            }
        </ChildContent>
        <ValueContent>
            <div class="flex items-center gap-2">
                <div class="flex flex-col">
                    <span>@context?.User.Name</span>
                </div>
            </div>
        </ValueContent>
    </LumexSelect>
</div>
