@inherits TimeTracker.Web.Ui.Shared.Components.Form.Select.Core.BaseSingleSelect<ProjectDto>

@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons
@using TimeTracker.Api.Shared.Dto.Entity

<div class="@Class">
    <LumexDropdown>
        <LumexDropdownTrigger>
            <LumexButton 
                FullWidth="true"
                Color="ThemeColor.Info" 
                Variant="Variant.Outlined"
                Disabled="Disabled"
            >
                @if (_selectedItem is null)
                {
                    @_placeholder
                }
                else
                {
                    @_selectedItem?.Name
                }
            </LumexButton>
        </LumexDropdownTrigger>
        <LumexDropdownMenu
            Color="ThemeColor.Info" 
            Variant="MenuVariant.Outlined">
            @foreach (var project in _list)
            {
                <LumexDropdownItem 
                    Description="@project?.Client?.Name"
                    OnClick="@(() => OnValueChanged(project))">
                    <ChildContent>
                        @project?.Name
                    </ChildContent>
                </LumexDropdownItem>
            }
        </LumexDropdownMenu>
    </LumexDropdown>
    @if (Clearable)
    {
        <CustomButton 
            OnClick="OnClear"
            IconOnly="true">
            <XIcon/>
        </CustomButton>
    }
</div>
