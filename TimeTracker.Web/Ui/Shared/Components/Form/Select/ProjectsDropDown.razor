@inherits TimeTracker.Web.Ui.Shared.Components.Form.Select.Core.BaseSingleSelect<ProjectDto>

@using LumexUI
@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Web.Constants.Ui

<div class="@Class">
    @if (Type == DropDownType.DropDown)
    {
        <LumexDropdown
            Open="@_isOpen"
            OpenChanged="@OnOpenChanged">
            <LumexDropdownTrigger>
                <LumexButton 
                    FullWidth="true"
                    Color="@(IsInvalid ? ThemeColor.Danger : ThemeColor.Default)" 
                    Variant="LumexUI.Common.Variant.Outlined"
                    Size="Size"
                    Disabled="Disabled"
                    Class="@SelectClass"
                >
                    @if (_selectedItem is null)
                    {
                        @_placeholder
                    }
                    else
                    {
                        @_selectedItem?.Name
                    }
                </LumexButton>
            </LumexDropdownTrigger>
            <LumexDropdownMenu
                Color="ThemeColor.Default" 
                Variant="MenuVariant.Outlined">
                @if (Clearable && _selectedItem != null)
                {
                    <LumexDropdownItem
                        OnClick="@(() => OnProjectSelected(null))"
                        Class="text-slate-400">
                        <ChildContent>
                            <span class="flex items-center gap-2">
                                <i class="fa-solid fa-xmark text-xs"></i>
                                None
                            </span>
                        </ChildContent>
                    </LumexDropdownItem>
                }
                @foreach (var group in _projectGroups)
                {
                    @if (_shouldGroupByClient)
                    {
                        <LumexDropdownItem
                            Disabled="true"
                            Class="cursor-default px-2 pb-1 pt-2 text-xs font-semibold uppercase text-slate-400 opacity-100">
                            <ChildContent>
                                @group.Key.Name
                            </ChildContent>
                        </LumexDropdownItem>
                    }
                    @foreach (var project in group)
                    {
                        <LumexDropdownItem 
                            Description="@GetProjectDescription(project)"
                            OnClick="@(() => OnProjectSelected(project))">
                            <ChildContent>
                                @project?.Name
                            </ChildContent>
                        </LumexDropdownItem>
                    }
                }
            </LumexDropdownMenu>
        </LumexDropdown>
    }
    else
    {
        <LumexSelect
            TValue="ProjectDto"
            Label="@Label"
            Placeholder="@_placeholder"
            LabelPlacement="LabelPlacement.Outside"
            Size="Size"
            Variant="@Variant"
            Color="@(IsInvalid ? ThemeColor.Danger : ThemeColor.Default)"
            ValueChanged="dto => OnValueChanged(dto)"
            Value="_selectedItem"
            Invalid="@IsInvalid">
            <ChildContent>
                @if (Clearable && _selectedItem != null)
                {
                    <LumexSelectItem Value="@_clearSentinel" TextValue="">
                        <div class="flex items-center gap-2 text-slate-400">
                            <i class="fa-solid fa-xmark text-xs"></i>
                            <span class="text-small">None</span>
                        </div>
                    </LumexSelectItem>
                }
                @foreach (var group in _projectGroups)
                {
                    @if (_shouldGroupByClient)
                    {
                        <LumexSelectItem
                            @key="@group.Key"
                            Value="@GetGroupHeaderItem(group.Key)"
                            TextValue="@group.Key.Name"
                            Disabled="true">
                            <span class="text-xs font-semibold uppercase text-slate-400">
                                @group.Key.Name
                            </span>
                        </LumexSelectItem>
                    }
                    @foreach (var project in group)
                    {
                        <LumexSelectItem @key="@project" Value="@project" Description="@GetProjectDescription(project)">
                            @project?.Name
                        </LumexSelectItem>
                    }
                }
            </ChildContent>
            <ValueContent>
                <span>@context?.Name</span>
            </ValueContent>
        </LumexSelect>
    }
</div>
