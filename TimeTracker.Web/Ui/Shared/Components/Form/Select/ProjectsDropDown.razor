@inherits TimeTracker.Web.Ui.Shared.Components.Form.Select.Core.BaseSingleSelect<ProjectDto>

@using LumexUI
@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Web.Constants.Ui

<div class="@Class">
    @if (Type == DropDownType.DropDown)
    {
        <LumexDropdown
            Open="@_isOpen"
            OpenChanged="@OnOpenChanged">
            <LumexDropdownTrigger>
                <LumexButton 
                    FullWidth="true"
                    Color="@(IsInvalid ? ThemeColor.Danger : ThemeColor.Info)" 
                    Variant="LumexUI.Common.Variant.Outlined"
                    Disabled="Disabled"
                    Class="@SelectClass"
                >
                    @if (_selectedItem is null)
                    {
                        @_placeholder
                    }
                    else
                    {
                        @_selectedItem?.Name
                    }
                </LumexButton>
            </LumexDropdownTrigger>
            <LumexDropdownMenu
                Color="ThemeColor.Info" 
                Variant="MenuVariant.Outlined">
                @if (Clearable && _selectedItem != null)
                {
                    <LumexDropdownItem
                        OnClick="@(() => OnProjectSelected(null))"
                        Class="text-slate-400">
                        <ChildContent>
                            <span class="flex items-center gap-2">
                                <i class="fa-solid fa-xmark text-xs"></i>
                                None
                            </span>
                        </ChildContent>
                    </LumexDropdownItem>
                }
                @foreach (var project in _list)
                {
                    <LumexDropdownItem 
                        Description="@project?.Client?.Name"
                        OnClick="@(() => OnProjectSelected(project))">
                        <ChildContent>
                            @project?.Name
                        </ChildContent>
                    </LumexDropdownItem>
                }
            </LumexDropdownMenu>
        </LumexDropdown>
    }
    else
    {
        <LumexSelect
            TValue="ProjectDto"
            Label="@Label"
            Placeholder="@_placeholder"
            LabelPlacement="LabelPlacement.Outside"
            Variant="@Variant"
            Color="@(IsInvalid ? ThemeColor.Danger : ThemeColor.Info)"
            ValueChanged="dto => OnValueChanged(dto)"
            Value="_selectedItem"
            Invalid="@IsInvalid">
            <ChildContent>
                @if (Clearable && _selectedItem != null)
                {
                    <LumexSelectItem Value="@_clearSentinel" TextValue="">
                        <div class="flex items-center gap-2 text-slate-400">
                            <i class="fa-solid fa-xmark text-xs"></i>
                            <span class="text-small">None</span>
                        </div>
                    </LumexSelectItem>
                }
                @foreach (var project in _list)
                {
                    <LumexSelectItem @key="@project" Value="@project" Description="@project?.Client?.Name">
                        @project?.Name
                    </LumexSelectItem>
                }
            </ChildContent>
            <ValueContent>
                <span>@context?.Name</span>
            </ValueContent>
        </LumexSelect>
    }
</div>
