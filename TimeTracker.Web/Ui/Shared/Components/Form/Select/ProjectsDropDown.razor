@inherits TimeTracker.Web.Ui.Shared.Components.Form.Select.Core.BaseSingleSelect<ProjectDto>

@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons
@using TimeTracker.Api.Shared.Dto.Entity

<div class="@Class">
    <LumexDropdown
        Open="@_isOpen"
        OpenChanged="@OnOpenChanged">
        <LumexDropdownTrigger>
            <LumexButton 
                FullWidth="true"
                Color="@(IsInvalid ? ThemeColor.Danger : ThemeColor.Info)" 
                Variant="Variant.Outlined"
                Disabled="Disabled"
                Class="@SelectClass"
            >
                @if (_selectedItem is null)
                {
                    @_placeholder
                }
                else
                {
                    @_selectedItem?.Name
                }
            </LumexButton>
        </LumexDropdownTrigger>
        <LumexDropdownMenu
            Color="ThemeColor.Info" 
            Variant="MenuVariant.Outlined">
            @if (Clearable && _selectedItem != null)
            {
                <LumexDropdownItem
                    OnClick="@(() => OnProjectSelected(null))"
                    Class="text-slate-400">
                    <ChildContent>
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-xmark text-xs"></i>
                            None
                        </span>
                    </ChildContent>
                </LumexDropdownItem>
            }
            @foreach (var project in _list)
            {
                <LumexDropdownItem 
                    Description="@project?.Client?.Name"
                    OnClick="@(() => OnProjectSelected(project))">
                    <ChildContent>
                        @project?.Name
                    </ChildContent>
                </LumexDropdownItem>
            }
        </LumexDropdownMenu>
    </LumexDropdown>
</div>
