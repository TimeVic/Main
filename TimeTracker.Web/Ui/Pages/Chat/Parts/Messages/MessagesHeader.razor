@using TimeTracker.Business.Common.Constants.Messaging
@inherits BaseReactiveComponent

<div class="border-b border-slate-200 bg-white px-4 py-4 sm:px-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <div class="flex items-center gap-3">
                @if (ChannelsState.Value.SelectedChannel != null)
                {
                    var selectedChannel = ChannelsState.Value.SelectedChannel!; 
                    if (selectedChannel.Type == MessagingChannelType.Common)
                    {
                        <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-cyan-100 text-cyan-700">
                            <i class="fa-solid fa-hashtag"></i>
                        </span>
                    }
                    else
                    {
                        <span class="flex h-11 w-11 items-center justify-center rounded-full bg-violet-100 text-violet-700">
                            @selectedChannel.User!.Initials
                        </span>
                    }
                    <div>
                        <h2 class="text-lg font-semibold text-slate-900">@selectedChannel.Name</h2>
                        <p class="text-sm text-slate-500">@selectedChannel.Name</p>
                    </div>    
                }
            </div>
        </div>
        <div class="flex items-center gap-2 text-xs text-slate-500">
            <span class="rounded-full border border-slate-300 bg-white px-3 py-1.5">@AuthState.Value.User.Name</span>
            <span class="rounded-full border border-slate-300 bg-white px-3 py-1.5">@(ListState?.TotalCount ?? 0) messages</span>
        </div>
    </div>
</div>
