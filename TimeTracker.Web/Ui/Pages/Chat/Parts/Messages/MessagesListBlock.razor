@inherits BaseReactiveComponent

<div class="flex-1 space-y-4 overflow-y-auto flex-grow bg-slate-50 px-4 py-5 sm:px-6">
    @if (State.Value.List.Any())
    {
        @foreach (var message in State.Value.List)
        {
            var isMine = message.CreatedBy.Id == AuthState.Value.User.Id;
            <div class="@($"flex {(isMine ? "justify-end" : "justify-start")}")">
                <div class="@($"max-w-xl rounded-3xl border px-4 py-3 shadow-sm {(isMine ? "border-cyan-200 bg-cyan-50" : "border-slate-200 bg-white")}")">
                    <div class="mb-1 flex items-center gap-2 text-xs">
                        <span class="@($"font-semibold {(isMine ? "text-cyan-700" : "text-slate-700")}")">@message.CreatedBy.Name</span>
                        <span class="text-slate-500">@message.CreatedAt.ToString("HH:mm")</span>
                    </div>
                    <p class="text-sm leading-6 text-slate-900">@message.Text</p>
                </div>
            </div>
        }
    }
    else
    {
        <div class="flex h-full min-h-[20rem] items-center justify-center">
            <div class="max-w-md rounded-3xl border border-dashed border-slate-300 bg-white p-8 text-center shadow-sm">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-100 text-slate-500">
                    <i class="fa-regular fa-comments text-2xl"></i>
                </div>
                <h3 class="mt-4 text-lg font-semibold text-slate-900">No messages yet</h3>
                <p class="mt-2 text-sm text-slate-500">Start the conversation with a first message in this chat.</p>
            </div>
        </div>
    }
</div>
