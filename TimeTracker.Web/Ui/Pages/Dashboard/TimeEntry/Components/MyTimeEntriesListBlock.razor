@using TimeTracker.Web.Ui.Pages.Dashboard.Shared.Tasks.Modals
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared.TimeEntry.Manage
@using TimeTracker.Web.Ui.Shared.Components.Dialogs
@using TimeTracker.Web.Ui.Shared.Components.List
@inherits BaseReactiveComponent

@if (_timeEntryToEdit != null)
{
    <EditTimeEntryModal
        Entry="_timeEntryToEdit"
        OnClose="@OnCloseEditTimeEntryModal"
    />
}
@if (_timeEntryToDelete != null)
{
    <ConfirmationModal
        DialogVariant="ConfirmationModal.ConfirmationVariant.Delete"
        OnConfirm="@OnConfirmDeleteTimeEntry"
        OnCancel="@(() => _timeEntryToDelete = null)"
    />
}
@if (_taskToEdit != null)
{
    <UpdateTaskModal
        IsOpened="true"
        Task="_taskToEdit"
        OnClose="@(() => _taskToEdit = null)"
    />
}

<section class="space-y-3">
    <div class="space-y-4">
        @if (_groupedList.Any())
        {
            foreach (var groupedItem in _groupedList)
            {
                var totalDuration = TimeSpan.FromTicks(
                    groupedItem.Sum(item => item.Duration.Ticks)
                );
                <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
                    <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-2">
                        <span class="text-xs font-semibold text-slate-600">@groupedItem.Key.ToString("ddd, MMM d")</span>
                        <LumexPopover>
                            <LumexPopoverTrigger>
                                <button
                                    type="button"
                                    class="inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-xs font-semibold text-slate-600 hover:bg-slate-100">
                                    <span>@DashboardLocalizer["Total"]:</span>
                                    <span>@_timeParsingService.TimeSpanToTimeString(totalDuration, true)</span>
                                </button>
                            </LumexPopoverTrigger>
                            <LumexPopoverContent>
                                <div class="min-w-[240px] space-y-3 p-3">
                                    <div>
                                        <p class="text-sm font-semibold text-slate-900">@DashboardLocalizer["TotalDuration"]</p>
                                        <p class="text-xs text-slate-500">@groupedItem.Key.ToString("ddd, MMM d")</p>
                                    </div>

                                    <div class="space-y-2">
                                        @foreach (var clientDuration in GetClientDurationItems(groupedItem))
                                        {
                                            <div class="flex items-center justify-between gap-4 text-xs">
                                                <span class="min-w-0 truncate text-slate-500">@clientDuration.ClientName</span>
                                                <span class="shrink-0 font-medium text-slate-700">
                                                    @_timeParsingService.TimeSpanToTimeString(clientDuration.Duration, true)
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </LumexPopoverContent>
                        </LumexPopover>
                    </div>

                    <div class="divide-y divide-slate-100">
                    @foreach (var entry in groupedItem)
                    {
                        <MyTimeEntryCard
                            CurrentTimeZone="@(AuthState.Value.Workspace?.TimeZone ?? TimeZoneInfo.Local.Id)"
                            Entry="@entry"
                            OnEdit="OnEditTimeEntry"
                            OnClone="OnCloneTimeEntry"
                            OnOpenTask="(entry) => _taskToEdit = entry.Task"
                            OnDelete="(entry) => _timeEntryToDelete = entry"
                        />
                    }
                    </div>
                </div>
            }
            <TPaginator
                CurrentPage="@_state.Value.SelectedPage"
                CurrentPageChanged="OnPageChanged"
                TotalPages="@_state.Value.TotalPages"
                TotalItems="@_state.Value.TotalCount"
                IsLoading="@_state.Value.IsListLoading" />
        }
        else
        {
            <div class="rounded-lg border border-dashed border-slate-200 bg-slate-50 p-4 text-sm text-slate-500">
                @DashboardLocalizer["SummaryEmptyMessage"]
            </div>
        }
    </div>
</section>
