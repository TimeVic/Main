
<div class="flex flex-col gap-3 rounded-3xl border border-blue-100 bg-gradient-to-r from-white via-blue-50/60 to-indigo-50/60 px-4 py-3 lg:flex-row lg:items-center lg:justify-between">
    <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2">
            <p class="truncate text-sm font-semibold text-slate-900">@GetProjectLabel()</p>
            <span class="rounded-full border border-blue-200 bg-blue-50 px-2.5 py-0.5 text-[11px] font-semibold text-blue-700">@GetTaskLabel()</span>
            @if (Entry.IsBillable)
            {
                <span class="rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-700">Billable</span>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Entry.Description))
        {
            <p class="mt-1 truncate text-xs text-slate-600">@Entry.Description</p>
        }
        <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-slate-500">
            <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-1 shadow-sm"><i class="fa-regular fa-user text-blue-600"></i>@Entry.User.Name</span>
            <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-1 shadow-sm">
                <i class="fa-regular fa-hourglass-half text-indigo-600"></i>
                @_timeParsingService.TimeSpanToTimeString(Entry.Duration, true)
            </span>
        </div>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <div class="min-w-[210px] rounded-3xl border border-blue-200 bg-white px-4 py-3 text-center shadow-sm">
            <p class="text-[10px] font-semibold uppercase tracking-wide text-blue-500">Time range</p>
            <div class="mt-1 flex items-center justify-center gap-2 font-mono text-lg font-semibold text-slate-900">
                <span>@_timeParsingService.TimeSpanToTimeString(Entry.StartTime)</span>
                <span class="text-blue-300">—</span>
                <span>@_timeParsingService.TimeSpanToTimeString(Entry.EndTime.Value)</span>
            </div>
        </div>
        <div class="flex items-center gap-2 self-start sm:self-center">
            <button type="button" title="Edit time entry" @onclick="@(() => OnEdit.InvokeAsync(Entry))" 
                    class="inline-flex h-9 w-9 items-center justify-center rounded-2xl border border-blue-200 bg-blue-50 text-blue-700 transition hover:border-blue-300 hover:bg-blue-100">
                <i class="fa-regular fa-pen-to-square"></i>
            </button>
            <button type="button" 
                    title="Delete time entry" 
                    @onclick="@(() => OnDelete.InvokeAsync(Entry))" 
                    class="inline-flex h-9 w-9 items-center justify-center rounded-2xl border border-red-200 bg-red-50 text-red-600 transition hover:border-red-300 hover:bg-red-100">
                <i class="fa-regular fa-trash-can"></i>
            </button>
        </div>
    </div>
</div>
