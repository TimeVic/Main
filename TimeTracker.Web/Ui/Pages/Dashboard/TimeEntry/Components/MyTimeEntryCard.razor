@using LumexUI.Common
@using TimeTracker.Business.Extensions

<div class="flex flex-col gap-3 rounded-3xl border border-blue-100 bg-gradient-to-r from-white via-blue-50/60 to-indigo-50/60 px-4 py-3 lg:flex-row lg:items-center lg:justify-between">
    <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2">
            <p class="truncate text-sm font-semibold text-slate-900">@GetProjectLabel()</p>
            @if (!string.IsNullOrEmpty(GetTaskLabel()))
            {
                <LumexChip
                    Class="cursor-pointer"
                    @onclick="@(() => OnOpenTask.InvokeAsync(Entry))"
                    Size="Size.Small"
                    Variant="@ChipVariant.Outlined"
                    Color="@ThemeColor.Primary">
                    @GetTaskLabel()
                </LumexChip>
            }
            @if (Entry.IsBillable)
            {
                <LumexChip
                    @onclick="@(() => OnOpenTask.InvokeAsync(Entry))"
                    Variant="@ChipVariant.Outlined"
                    Size="Size.Small"
                    Color="@ThemeColor.Info">
                    Billable
                </LumexChip>
            }
            @if (Entry.IsSynced)
            {
                <LumexPopover Color="ThemeColor.Primary">
                    <LumexPopoverTrigger>
                        <LumexChip
                            Size="Size.Small"
                            Variant="@ChipVariant.Outlined"
                            Color="@ThemeColor.Success">
                            <StartContent>
                                <CircleCheckFilledIcon Size="16" />
                            </StartContent>
                            <ChildContent>Synced</ChildContent>
                        </LumexChip>
                    </LumexPopoverTrigger>
                    <LumexPopoverContent>
                        The Time Entry was synchronized with an external service such as Jira or Redmine.
                    </LumexPopoverContent>
                </LumexPopover>
                
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Entry.Description))
        {
            <p class="mt-1 truncate text-xs text-slate-600">@Entry.Description.TruncateAndAddDots(200)</p>
        }
        <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-slate-500">
            <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-1 shadow-sm"><i class="fa-regular fa-user text-blue-600"></i>@Entry.User.Name</span>
            <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-1 shadow-sm">
                <i class="fa-regular fa-hourglass-half text-indigo-600"></i>
                @_timeParsingService.TimeSpanToTimeString(Entry.Duration, true)
            </span>
        </div>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <div class="min-w-[210px] rounded-3xl border border-blue-200 bg-white px-4 py-3 text-center shadow-sm">
            <p class="text-[10px] font-semibold uppercase tracking-wide text-blue-500">Time range</p>
            <div class="mt-1 flex items-center justify-center gap-2 font-mono text-lg font-semibold text-slate-900">
                <span>@_timeParsingService.DateTimeToTimeString(Entry.StartTime)</span>
                <span class="text-blue-300">—</span>
                <span>@_timeParsingService.DateTimeToTimeString(Entry.EndTime)</span>
            </div>
        </div>
        <div class="flex items-center gap-2 self-start sm:self-center">
            <CustomButton
                Class="inline-flex rounded-full"
                OnClick="@(() => OnClone.InvokeAsync(Entry))"
                Size="Size.Small"
                Color="ThemeColor.Primary"
                Variant="Variant.Light"
                IconOnly="true">
                <ChildContent>
                    <i class="fa-regular fa-clone"></i>    
                </ChildContent>
            </CustomButton>
            <CustomButton
                Class="inline-flex rounded-full"
                OnClick="@(() => OnEdit.InvokeAsync(Entry))"
                Size="Size.Small"
                Color="ThemeColor.Primary"
                Variant="Variant.Light"
                IconOnly="true">
                <ChildContent>
                    <i class="fa-regular fa-pen-to-square"></i>
                </ChildContent>
            </CustomButton>
            <CustomButton
                Class="inline-flex rounded-full"
                OnClick="@(() => OnDelete.InvokeAsync(Entry))"
                Size="Size.Small"
                Color="ThemeColor.Danger"
                Variant="Variant.Light"
                IconOnly="true">
                <ChildContent>
                    <i class="fa-regular fa-trash-can"></i>
                </ChildContent>
            </CustomButton>
        </div>
    </div>
</div>
