@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Business.Extensions
@using Fluxor
@using TimeTracker.Web.Store.Client
@using TimeTracker.Web.Store.Project

@code {

    [Parameter]
    public ICollection<SummaryByProjectsReportItemDto> Items { get; set; } = new List<SummaryByProjectsReportItemDto>();
}

<FluentDataGrid TGridItem="SummaryByProjectsReportItemDto" Items="@Items.AsQueryable()">
    <PropertyColumn Title="Project" Property="@(p => p.ProjectName ?? "- No project -")" Sortable="false"/>
    <PropertyColumn Title="Duration" Property="@(p => p.Duration.ToReadableShortString())" Sortable="false"/>
    <PropertyColumn Title="Amount" Property="@(p => p.Amount.ToMoneyFormat())" Sortable="false"/>
</FluentDataGrid>
