@using TimeTracker.Business.Extensions

@inherits BaseReactiveComponent

<div class="d-flex justify-content-between">
    <FluentLabel Typo="Typography.Body">
        Total Duration: 
    </FluentLabel>
    <FluentLabel Typo="Typography.Subject" Class="ml-2">
        <b> @_totalDuration.ToReadableShortString()</b>
    </FluentLabel>
</div>
<div class="d-flex justify-content-between">
    <FluentLabel Typo="Typography.Body">
        Total Amount: 
    </FluentLabel>
    <FluentLabel Typo="Typography.Subject" Class="ml-2">
        <b> @_totalAmount.ToMoneyFormat()</b>
    </FluentLabel>
</div>
