@using TimeTracker.Business.Extensions
@using TimeTracker.Web.Ui.Shared.Components

@inherits BaseReactiveComponent

<FinancialSummaryCards
    TotalEarned="@_paymentReportEarned"
    TotalPaid="@_totalPaid"
    OutstandingBalance="@_outstandingBalance"
    Class="mt-6"
    EarnedCaption="Billable work through the selected date"
    PaidCaption="Client payments received"
    OutstandingCaption="@(_outstandingBalance > 0 ? "Still unpaid" : "No unpaid balance")"/>

<div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
    You earned <span class="font-semibold text-slate-900"><AmountDisplay Amount="@_paymentReportEarned"/></span>,
    received <span class="font-semibold text-emerald-700"><AmountDisplay Amount="@_totalPaid"/></span>,
    and have <span class="font-semibold @(_outstandingBalance > 0 ? "text-red-700" : "text-slate-900")"><AmountDisplay Amount="@_outstandingBalance"/></span> outstanding.
</div>

<section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4 mt-4">
    <LumexCard>
        <LumexCardHeader>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Duration</p>
        </LumexCardHeader>
        <LumexCardBody>
            <p class="text-2xl font-semibold text-slate-900">@_totalDuration.ToReadableShortString()</p>
            <p class="mt-1 text-sm text-slate-500">Worked during the selected period</p>
        </LumexCardBody>
    </LumexCard>
    
    <LumexCard>
        <LumexCardHeader>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Earned in selected period</p>
        </LumexCardHeader>
        <LumexCardBody>
            <p class="text-2xl font-semibold text-slate-900">
                <AmountDisplay Amount="@_totalAmount"/>
            </p>
            <p class="mt-1 text-sm text-slate-500">Billable value of filtered entries</p>
        </LumexCardBody>
    </LumexCard>
</section>
