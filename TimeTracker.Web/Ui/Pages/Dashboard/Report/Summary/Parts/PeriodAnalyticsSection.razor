@using Fluxor
@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Business.Extensions
@using TimeTracker.Web.Store.Report
@using TimeTracker.Web.Ui.Shared.Components

@inherits BaseReactiveComponent

@inject IState<ReportsState> ReportsState

<section class="mt-10 space-y-4">
    <SummarySectionHeader
        Title="Selected period"
        HelperText="Metrics tied to the current filters."/>

    @if (!string.IsNullOrWhiteSpace(_periodInsight))
    {
        <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600">
            @_periodInsight
        </div>
    }

    <div class="grid gap-4 md:grid-cols-3">
        <SummaryMetricCard
            Title="Duration"
            HelperText="Worked during the selected period"
            Variant="neutral"
            IconClass="fa-regular fa-clock">
            <Value>
                @_totalDuration.ToReadableShortString()
            </Value>
        </SummaryMetricCard>

        <SummaryMetricCard
            Title="Earned in selected period"
            HelperText="Billable value in the selected range"
            Variant="neutral"
            IconClass="fa-solid fa-coins">
            <Value>
                <AmountDisplay Amount="@_totalAmount"/>
            </Value>
        </SummaryMetricCard>

        <SummaryMetricCard
            Title="Effective hourly rate"
            HelperText="Average earned amount per tracked hour"
            Variant="neutral"
            IconClass="fa-solid fa-gauge-high">
            <Value>
                @if (_totalDuration.TotalHours > 0)
                {
                    <span><AmountDisplay Amount="@_effectiveHourlyRate"/>/h</span>
                }
                else
                {
                    <span>—</span>
                }
            </Value>
        </SummaryMetricCard>
    </div>
</section>

@code {
    private IEnumerable<SummaryByDaysReportItemDto> _byDateItems
    {
        get => ReportsState.Value.SummaryReportData?.ByDays ?? new List<SummaryByDaysReportItemDto>();
    }

    private TimeSpan _totalDuration
    {
        get => new(_byDateItems.Sum(item => item.Duration.Ticks));
    }

    private decimal _totalAmount
    {
        get => _byDateItems.Sum(item => item.Amount);
    }

    private decimal _effectiveHourlyRate
    {
        get => _totalDuration.TotalHours <= 0
            ? 0
            : Math.Round(_totalAmount / (decimal)_totalDuration.TotalHours, 2);
    }

    private string _periodInsight
    {
        get
        {
            if (_totalDuration.TotalMinutes < 1)
            {
                return "No meaningful activity in the selected period.";
            }

            return string.Empty;
        }
    }
}
