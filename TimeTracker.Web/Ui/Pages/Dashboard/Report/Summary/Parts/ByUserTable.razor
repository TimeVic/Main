@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Business.Extensions
@using Fluxor
@using LumexUI.Common
@using TimeTracker.Web.Store.Client
@using TimeTracker.Web.Store.Project
@using TimeTracker.Web.Ui.Shared.Components

@code {

    [Parameter]
    public ICollection<SummaryByUsersReportItemDto> Items { get; set; } = new List<SummaryByUsersReportItemDto>();

}

<LumexDataGrid Data="@Items.AsQueryable()" Shadow="Shadow.None">
    <PropertyColumn Title="User" Property="@(p => p.Name)"/>
    <PropertyColumn Title="Duration" Property="@(p => p.Duration)">
        <Content>
            @context.Duration.ToReadableShortString()
        </Content>
    </PropertyColumn>
    <PropertyColumn Title="Amount" Property="@(p => p.Amount)">
        <Content>
            <AmountDisplay Amount="@context.Amount"/>
        </Content>
    </PropertyColumn>
</LumexDataGrid>
