@using LumexUI.Common
@using TimeTracker.Business.Common.Constants.Reports

@inherits BaseReactiveComponent

<LumexCard>
    <LumexCardHeader>
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-400">Filter</p>
            <h2 class="mt-2 text-xl font-semibold text-slate-900">Summary report parameters</h2>
            <p class="mt-1 text-sm text-slate-500">Change grouping and period to rebuild both the chart and grouped table.</p>
        </div>
    </LumexCardHeader>
    <LumexCardBody>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            <div>
                <EnumDropDown
                    Label="Group by"
                    TItem="SummaryReportType"
                    DropDownColor="ThemeColor.Default"
                    Value="@_filterState.ReportType"
                    ValueChanged="OnChangeReportType"/>
            </div>

            <div>
                <EnumDropDown
                    Label="Period"
                    TItem="SummaryReportPeriodType"
                    DropDownColor="ThemeColor.Default"
                    Value="@_filterState.PeriodType"
                    ValueChanged="OnChangePeriodType"/>
            </div>

            @if (_filterState.PeriodType == SummaryReportPeriodType.Custom)
            {
                <div>
                    <LumexDatebox 
                        TValue="DateTime?"
                        Required="true"
                        Value="@_filterState.StartDate"
                        Variant="InputVariant.Outlined"
                        LabelPlacement="LabelPlacement.Outside"
                        ValueChanged="@OnChangeDateStart"
                        Label="Date from"/>
                </div>

                <div>
                    <LumexDatebox 
                        TValue="DateTime?"
                        Required="true"
                        Value="@_filterState.EndDate"
                        Variant="InputVariant.Outlined"
                        LabelPlacement="LabelPlacement.Outside"
                        ValueChanged="@OnChangeDateEnd"
                        Label="Date from"/>
                </div>
            }
        </div>
    </LumexCardBody>
</LumexCard>
