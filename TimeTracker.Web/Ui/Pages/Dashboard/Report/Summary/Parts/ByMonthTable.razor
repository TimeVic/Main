@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Business.Extensions
@using System.Globalization
@using LumexUI.Common

@code {
    
    [Parameter]
    public ICollection<SummaryByMonthsReportItemDto> Items { get; set; } = new List<SummaryByMonthsReportItemDto>();

    private string GetName(int month, int year)
    {
        return new DateTime(year, month, 1).ToString("MMM", CultureInfo.InvariantCulture);
    }
}

<LumexDataGrid Data="@Items.AsQueryable()" Shadow="Shadow.None">
    <PropertyColumn Title="Month" Property="@(p => p.Month)">
        <Content>
            @GetName(context.Month, context.Year)
        </Content>
    </PropertyColumn>
    <PropertyColumn Title="Duration" Property="@(p => p.Duration)">
        <Content>
            @context.Duration.ToReadableShortString()
        </Content>
    </PropertyColumn>
    <PropertyColumn Title="Amount" Property="@(p => p.Amount)">
        <Content>
            @context.Amount.ToMoneyFormat()
        </Content>
    </PropertyColumn>
</LumexDataGrid>
