<div class="@Class">
    @if (!string.IsNullOrWhiteSpace(Overline))
    {
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-400">@Overline</p>
    }
    <h2 class="mt-2 text-xl font-semibold text-slate-900">@Title</h2>
    @if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <p class="mt-1 text-sm text-slate-500">@HelperText</p>
    }
</div>

@code {
    [Parameter]
    public string Overline { get; set; } = string.Empty;

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? HelperText { get; set; }

    [Parameter]
    public string Class { get; set; } = string.Empty;
}
