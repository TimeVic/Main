@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Report

@inherits BaseReactiveComponent

<LumexCard Class="mt-10">
    <LumexCardHeader>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <SummarySectionHeader
                Overline="Table"
                Title="Grouped summary"
                HelperText="Detailed rows for the selected grouping."/>
            @if (!string.IsNullOrWhiteSpace(PeriodLabel))
            {
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">@PeriodLabel</span>
            }
        </div>
    </LumexCardHeader>
    <LumexCardBody>
        @if (ReportData?.GroupedByDay != null)
        {
            <ByDateTable Items="@ReportData.GroupedByDay"></ByDateTable>
        }
        else if (ReportData?.GroupedByWeek != null)
        {
            <ByWeekTable Items="@ReportData.GroupedByWeek"></ByWeekTable>
        }
        else if (ReportData?.GroupedByClient != null)
        {
            <ByClientTable Items="@ReportData.GroupedByClient"></ByClientTable>
        }
        else if (ReportData?.GroupedByProject != null)
        {
            <ByProjectTable Items="@ReportData.GroupedByProject"></ByProjectTable>
        }
        else if (ReportData?.GroupedByMonth != null)
        {
            <ByMonthTable Items="@ReportData.GroupedByMonth"></ByMonthTable>
        }
        else if (ReportData?.GroupedByUser != null)
        {
            <ByUserTable Items="@ReportData.GroupedByUser"></ByUserTable>
        }
    </LumexCardBody>
</LumexCard>

@code {
    [Parameter]
    public SummaryReportResponse? ReportData { get; set; }

    [Parameter]
    public string PeriodLabel { get; set; } = string.Empty;
}
