@page "/board/report/payments"
@using LumexUI.Common
@using TimeTracker.Business.Extensions
@using TimeTracker.Web.Ui.Pages.Dashboard.Report.Parts
@using TimeTracker.Web.Ui.Shared.Components
@using Layout = TimeTracker.Web.Ui.Pages.Dashboard.Shared.Layout

@inherits BaseReactiveComponent
@layout Layout

<LumexCard Class="mt-6 overflow-x-auto pb-2">
    <LumexCardHeader>
        <div class="flex flex-col gap-3">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-400">Payments</p>
                <h2 class="mt-2 text-xl font-semibold text-slate-900">Payments summary report</h2>
            </div>
            <div>
                <LumexDatebox
                    TValue="DateTime?"
                    Value="@_filterState.EndDate"
                    ValueChanged="@OnChangeDateEnd"
                    Label="Date end"/>
            </div>
        </div>
    </LumexCardHeader>
    <LumexCardBody>
        @if (_state.Value.IsLoading)
        {
            <div class="flex justify-center py-6">
                <LumexSpinner Variant="@SpinnerVariant.DotsFade"/>
            </div>
        }
        else if (!_grouppedItems.Any())
        {
            <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 p-3 text-sm text-slate-600">
                <text>Start tracking time to see your earnings. Add your first client to track payments.</text>
            </div>
        }
        else
        {
            <FinancialSummaryCardsBlock
                Class="mb-6"
                EarnedCaption="Billable work through the selected date"
                PaidCaption="Client payments received"/>

            foreach (var groupItem in _grouppedItems)
            {
                var clientId = groupItem.Key;
                var clientDataItem = groupItem.First();
                var clientName = string.IsNullOrEmpty(clientDataItem.ClientName) ? "Other projects" : clientDataItem.ClientName;
                var receivedAmount = clientDataItem.PaidAmountByClient;
                var outstandingAmount = GetClientOutstandingAmount(clientId);
                var totalEarned = GetClientTotalAmount(clientId);

                <div class="mb-6 space-y-3">
                    <ClientPaymentSummaryCard
                        ClientName="@clientName"
                        Earned="@totalEarned"
                        Paid="@receivedAmount"
                        Outstanding="@outstandingAmount"
                        ProjectCount="@groupItem.Count()"/>

                    <LumexDataGrid 
                        Loading="_state.Value.IsLoading"
                        Data="@groupItem.AsQueryable()" 
                        Shadow="Shadow.None">
                        <PropertyColumn Title="Project" Property="@(p => p.ProjectName)">
                            <Content>
                                @(string.IsNullOrEmpty(context.ProjectName) ? "-- No project name --" : context.ProjectName)
                            </Content>
                        </PropertyColumn>
                        <PropertyColumn Title="Duration" Property="@(p => p.TotalDuration)">
                            <Content>
                                @context.TotalDuration.ToReadableShortString()
                            </Content>
                        </PropertyColumn>
                        <PropertyColumn Title="Earned" Property="@(p => p.Amount)">
                            <Content>
                                <AmountDisplay Amount="@context.Amount"/>
                            </Content>
                        </PropertyColumn>
                        <PropertyColumn Title="Received" Property="@(p => p.PaidAmountByProject)">
                            <Content>
                                <span class="font-semibold text-emerald-700">
                                    <AmountDisplay Amount="@context.PaidAmountByProject"/>
                                </span>
                            </Content>
                        </PropertyColumn>
                        <PropertyColumn Title="Outstanding" Property="@(p => p.Amount)">
                            <Content>
                                @{
                                    var projectOutstanding = GetProjectOutstandingAmount(context);
                                }
                                <span class="font-semibold @(projectOutstanding > 0 ? "text-red-700" : "text-slate-700")">
                                    <AmountDisplay Amount="@projectOutstanding"/>
                                </span>
                            </Content>
                        </PropertyColumn>
                        <PropertyColumn Title="Effective hourly rate" Property="@(p => p.Amount)">
                            <Content>
                                <AmountDisplay Amount="@GetEffectiveHourlyRate(context.Amount, context.TotalDuration)"/>/h
                            </Content>
                        </PropertyColumn>
                    </LumexDataGrid>
                </div>
            }
        }
    </LumexCardBody>
</LumexCard>
