@page "/board/report/payments"
@using LumexUI.Common
@using TimeTracker.Web.Ui.Pages.Dashboard.Report.Parts
@using Layout = TimeTracker.Web.Ui.Pages.Dashboard.Shared.Layout

@inherits BaseReactiveComponent
@layout Layout

<PaymentsSummaryHeader
    EndDate="@_filterState.EndDate"
    EndDateChanged="@OnChangeDateEnd"/>

@if (_state.Value.IsLoading)
{
    <div class="mt-8 flex justify-center rounded-2xl border border-slate-200 bg-white py-10">
        <LumexSpinner Variant="@SpinnerVariant.DotsFade"/>
    </div>
}
else if (!_groupedItems.Any())
{
    <LumexCard Class="mt-8 border-dashed border-slate-200 bg-slate-50 shadow-none">
        <LumexCardBody>
            <p class="text-sm font-medium text-slate-700">Start tracking time to see your earnings.</p>
            <p class="mt-1 text-sm text-slate-500">Add your first client to track payments.</p>
        </LumexCardBody>
    </LumexCard>
}
else
{
    <PaymentsOverviewCards Class="mt-8"/>

    <section class="mt-10 space-y-5">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-400">Clients</p>
                <h2 class="mt-2 text-xl font-semibold text-slate-900">Client payment status</h2>
                <p class="mt-1 text-sm text-slate-500">Clients with unpaid balances are sorted first.</p>
            </div>
        </div>

        @foreach (var groupItem in _sortedGroupedItems)
        {
            <ClientPaymentsGroup Items="@groupItem"/>
        }
    </section>
}
