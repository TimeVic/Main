@using LumexUI.Common
@using TimeTracker.Web.Constants.Ui

@inherits BaseReactiveComponent

<LumexCard Class="border-slate-200 bg-slate-50/50 shadow-none">
    <LumexCardBody>
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            <div>
                <ProjectsDropDown
                    Type="DropDownType.Select"
                    Label="@DashboardLocalizer["Projects"].Value"
                    Clearable="true"
                    FullWidth="true"
                    IsGroupByClient="true"
                    Value="@(_state.Value.Filter.ProjectId ?? Guid.Empty)"
                    SelectedItemChanged="OnChangeProject"/>
            </div>
            <div>
                <MembersDropDown
                    Type="DropDownType.Select"
                    Label="@DashboardLocalizer["Member"].Value"
                    FullWidth="true"
                    Clearable="true"
                    UserId="@_state.Value.Filter.UserId"
                    SelectedItemChanged="OnChangeMember"/>
            </div>
            <div>
                <BooleanDropDown
                    SelectType="DropDownType.Select"
                    Label="@DashboardLocalizer["Billable"].Value"
                    FullWidth="true"
                    Clearable="true"
                    Value="@_state.Value.Filter.IsBillable"
                    ValueChanged="OnChangeBillable"/>
            </div>
            <div>
                <LumexDatebox
                    TValue="DateTime?"
                    Label="@DashboardLocalizer["DateFrom"].Value"
                    Value="@_state.Value.Filter.DateFrom"
                    ValueChanged="OnChangeDateFrom"
                    Clearable="true"
                    Variant="InputVariant.Outlined"
                    LabelPlacement="LabelPlacement.Outside"
                    FullWidth="true"/>
            </div>
            <div>
                <LumexDatebox
                    TValue="DateTime?"
                    Label="@DashboardLocalizer["DateTo"].Value"
                    Value="@_state.Value.Filter.DateTo"
                    ValueChanged="OnChangeDateTo"
                    Clearable="true"
                    Variant="InputVariant.Outlined"
                    LabelPlacement="LabelPlacement.Outside"
                    FullWidth="true"/>
            </div>
        </div>
        <div class="mt-4">
            <LumexTextbox
                TValue="string"
                Label="@DashboardLocalizer["Search"].Value"
                Placeholder="@DashboardLocalizer["SearchByDescription"].Value"
                Value="@_state.Value.Filter.Search"
                ValueChanged="OnChangeSearch"
                FullWidth="true"
                LabelPlacement="LabelPlacement.Outside"
                Variant="InputVariant.Outlined"/>
        </div>
    </LumexCardBody>
</LumexCard>
