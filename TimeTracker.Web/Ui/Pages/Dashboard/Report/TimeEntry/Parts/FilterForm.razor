@using LumexUI.Common
@using TimeTracker.Web.Constants.Ui

@inherits BaseReactiveComponent

<LumexCard Class="border-slate-200 bg-slate-50/50 shadow-none">
    <LumexCardBody>
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            <div>
                <ClientsDropDown
                    Type="DropDownType.Select"
                    Label="Client"
                    Clearable="true"
                    FullWidth="true"
                    Value="@(_state.Value.Filter.ClientId ?? Guid.Empty)"
                    SelectedItemChanged="OnChangeClient"/>
            </div>
            <div>
                <ProjectsDropDown
                    Type="DropDownType.Select"
                    Label="Project"
                    Clearable="true"
                    FullWidth="true"
                    Value="@(_state.Value.Filter.ProjectId ?? Guid.Empty)"
                    ClientId="@_state.Value.Filter.ClientId"
                    SelectedItemChanged="OnChangeProject"/>
            </div>
            <div>
                <MembersDropDown
                    Type="DropDownType.Select"
                    Label="Member"
                    FullWidth="true"
                    Clearable="true"
                    UserId="@_state.Value.Filter.UserId"
                    SelectedItemChanged="OnChangeMember"/>
            </div>
            <div>
                <BooleanDropDown
                    SelectType="DropDownType.Select"
                    Label="Billable"
                    FullWidth="true"
                    Clearable="true"
                    Value="@_state.Value.Filter.IsBillable"
                    ValueChanged="OnChangeBillable"/>
            </div>
            <div>
                <LumexDatebox
                    TValue="DateTime?"
                    Label="Date from"
                    Value="@_state.Value.Filter.DateFrom"
                    ValueChanged="OnChangeDateFrom"
                    Clearable="true"
                    Variant="InputVariant.Outlined"
                    LabelPlacement="LabelPlacement.Outside"
                    FullWidth="true"/>
            </div>
            <div>
                <LumexDatebox
                    TValue="DateTime?"
                    Label="Date to"
                    Value="@_state.Value.Filter.DateTo"
                    ValueChanged="OnChangeDateTo"
                    Clearable="true"
                    Variant="InputVariant.Outlined"
                    LabelPlacement="LabelPlacement.Outside"
                    FullWidth="true"/>
            </div>
        </div>
        <div class="mt-4">
            <LumexTextbox
                TValue="string"
                Label="Search"
                Placeholder="Search by description..."
                Value="@_state.Value.Filter.Search"
                ValueChanged="OnChangeSearch"
                FullWidth="true"
                LabelPlacement="LabelPlacement.Outside"
                Variant="InputVariant.Outlined"/>
        </div>
    </LumexCardBody>
</LumexCard>
