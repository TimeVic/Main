@using Fluxor
@using TimeTracker.Api.Shared.Dto.Model.Report.WorkspaceFinancialSummary
@using TimeTracker.Business.Extensions
@using TimeTracker.Web.Store.Report
@using TimeTracker.Web.Ui.Shared.Components

@inherits BaseReactiveComponent
@inject IState<ReportsState> ReportsState

<section class="@Class">
    <div class="mb-4">
        <h2 class="text-base font-semibold text-slate-700">Project Profitability</h2>
        <p class="mt-1 text-sm text-slate-500">Compares client billable amount with member earnings for each project.</p>
    </div>
    @{
        var data = ReportsState.Value.WorkspaceFinancialSummaryData;
        var items = data?.ProjectProfitability ?? [];
    }
    @if (items.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 px-4 py-6">
            <p class="text-sm font-medium text-slate-700">No project profitability yet</p>
            <p class="mt-1 text-sm text-slate-500">Billable project work will appear here after it is recorded.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
            <table class="min-w-full text-sm">
                <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
                    <tr>
                        <th class="px-4 py-3 text-left">Project</th>
                        <th class="px-4 py-3 text-left">Client</th>
                        <th class="px-4 py-3 text-right">Hours</th>
                        <th class="px-4 py-3 text-right">Client Earned</th>
                        <th class="px-4 py-3 text-right">Member Earnings</th>
                        <th class="px-4 py-3 text-right">Estimated Margin</th>
                        <th class="px-4 py-3 text-right">Margin %</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in items)
                    {
                        <tr class="hover:bg-slate-50/50">
                            <td class="px-4 py-3 font-medium text-slate-800">@item.Project.Name</td>
                            <td class="px-4 py-3 text-slate-600">@(item.Client?.Name ?? "—")</td>
                            <td class="px-4 py-3 text-right text-slate-600">@item.Duration.ToReadableShortString()</td>
                            <td class="px-4 py-3 text-right"><AmountDisplay Amount="@item.ClientEarned"/></td>
                            <td class="px-4 py-3 text-right"><AmountDisplay Amount="@item.TeamCost"/></td>
                            <td class="px-4 py-3 text-right font-semibold @(item.EstimatedMargin < 0 ? "text-red-700" : "text-emerald-700")">
                                <AmountDisplay Amount="@item.EstimatedMargin"/>
                            </td>
                            <td class="px-4 py-3 text-right @(item.MarginPercent < 0 ? "text-red-700" : "text-slate-700")">
                                @(item.ClientEarned == 0 ? "—" : $"{Math.Round(item.MarginPercent.GetValueOrDefault(), 0)}%")
                            </td>
                        </tr>
                    }
                    <tr class="border-t border-slate-200 bg-slate-50 font-semibold text-slate-700">
                        <td class="px-4 py-3">Total</td>
                        <td class="px-4 py-3"></td>
                        <td class="px-4 py-3 text-right">@items.Aggregate(TimeSpan.Zero, (a, i) => a + i.Duration).ToReadableShortString()</td>
                        <td class="px-4 py-3 text-right"><AmountDisplay Amount="@items.Sum(i => i.ClientEarned)"/></td>
                        @{
                            var totalMargin = items.Sum(i => i.EstimatedMargin);
                            var totalEarned = items.Sum(i => i.ClientEarned);
                        }
                        <td class="px-4 py-3 text-right"><AmountDisplay Amount="@items.Sum(i => i.TeamCost)"/></td>
                        <td class="px-4 py-3 text-right @(totalMargin < 0 ? "text-red-700" : "text-emerald-700")">
                            <AmountDisplay Amount="@totalMargin"/>
                        </td>
                        <td class="px-4 py-3 text-right">
                            @(totalEarned == 0 ? "—" : $"{Math.Round(totalMargin / totalEarned * 100, 0)}%")
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Parameter]
    public string? Class { get; set; }
}
