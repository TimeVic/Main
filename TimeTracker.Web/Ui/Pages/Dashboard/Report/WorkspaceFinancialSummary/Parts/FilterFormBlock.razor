@using Fluxor
@using LumexUI.Common
@using TimeTracker.Web.Constants
@using TimeTracker.Web.Store.Report

@inherits BaseReactiveComponent
@inject IState<ReportsState> ReportsState

<LumexCard Class="@($"border-slate-200 bg-slate-50/50 shadow-none {Class}")"  >
    <LumexCardHeader>
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-400">Filter</p>
            <h2 class="mt-2 text-lg font-semibold text-slate-900">Report parameters</h2>
        </div>
    </LumexCardHeader>
    <LumexCardBody>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            <div>
                <EnumDropDown
                    Label="Period"
                    TItem="SummaryReportPeriodType"
                    DropDownColor="ThemeColor.Default"
                    Value="@_filter.PeriodType"
                    ValueChanged="OnChangePeriodType"/>
            </div>

            @if (_filter.PeriodType == SummaryReportPeriodType.Custom)
            {
                <div>
                    <LumexDatebox
                        TValue="DateTime?"
                        Required="true"
                        Value="@_filter.StartDate"
                        Variant="InputVariant.Outlined"
                        LabelPlacement="LabelPlacement.Outside"
                        ValueChanged="@OnChangeDateStart"
                        Label="Date from"/>
                </div>

                <div>
                    <LumexDatebox
                        TValue="DateTime?"
                        Required="true"
                        Value="@_filter.EndDate"
                        Variant="InputVariant.Outlined"
                        LabelPlacement="LabelPlacement.Outside"
                        ValueChanged="@OnChangeDateEnd"
                        Label="Date to"/>
                </div>
            }
        </div>
    </LumexCardBody>
</LumexCard>

@code {
    [Parameter]
    public string? Class { get; set; }

    private WorkspaceFinancialSummaryFilterState _filter
        => ReportsState.Value.WorkspaceFinancialSummaryFilter;

    private void OnChangePeriodType(SummaryReportPeriodType? type)
    {
        if (_filter.PeriodType == type || type == null) return;
        Dispatcher.Dispatch(new ReportSetWorkspaceFinancialSummaryFilterAction(_filter with { PeriodType = type.Value }));
        Reload();
    }

    private void OnChangeDateStart(DateTime? date)
    {
        if (_filter.StartDate.ToShortDateString() == date?.ToShortDateString()) return;
        Dispatcher.Dispatch(new ReportSetWorkspaceFinancialSummaryFilterAction(_filter with { StartDate = date!.Value }));
        Reload();
    }

    private void OnChangeDateEnd(DateTime? date)
    {
        if (_filter.EndDate.ToShortDateString() == date?.ToShortDateString()) return;
        Dispatcher.Dispatch(new ReportSetWorkspaceFinancialSummaryFilterAction(_filter with { EndDate = date!.Value }));
        Reload();
    }

    private void Reload()
    {
        Dispatcher.Dispatch(new ReportFetchWorkspaceFinancialSummaryAction());
    }
}
