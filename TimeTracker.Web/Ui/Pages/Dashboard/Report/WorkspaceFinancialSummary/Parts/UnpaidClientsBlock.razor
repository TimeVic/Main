@using Fluxor
@using TimeTracker.Api.Shared.Dto.Model.Report.WorkspaceFinancialSummary
@using TimeTracker.Client.Core.Store.Report
@using TimeTracker.Web.Ui.Shared.Components

@inherits BaseReactiveComponent
@inject IState<ReportsState> ReportsState

<section class="@Class">
    <h2 class="mb-4 text-base font-semibold text-slate-700">@DashboardLocalizer["UnpaidClients"]</h2>
    @{
        var items = (ReportsState.Value.WorkspaceFinancialSummaryData?.ClientBalances ?? [])
            .Where(c => c.Outstanding > 0)
            .OrderByDescending(c => c.Outstanding)
            .ToList();
    }
    @if (items.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 px-4 py-6 text-center">
            <p class="text-sm font-medium text-slate-700">@DashboardLocalizer["NoUnpaidClients"]</p>
            <p class="mt-1 text-sm text-slate-500">@DashboardLocalizer["UnpaidClientsBlock_NoUnpaidDescription"]</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
            <table class="min-w-full text-sm">
                <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
                    <tr>
                        <th class="px-4 py-3 text-left">@DashboardLocalizer["Client"]</th>
                        <th class="px-4 py-3 text-right">@DashboardLocalizer["Balance"]</th>
                        <th class="px-4 py-3 text-left">@DashboardLocalizer["LastPayment"]</th>
                        <th class="px-4 py-3 text-left">@DashboardLocalizer["Status"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in items)
                    {
                        <tr class="hover:bg-slate-50/50">
                            <td class="px-4 py-3 font-medium text-slate-800">@(item.Client?.Name ?? DashboardLocalizer["NoClient"].Value)</td>
                            <td class="px-4 py-3 text-right font-semibold text-red-700">
                                <AmountDisplay Amount="@item.Outstanding"/>
                                <span title="@DashboardLocalizer["ClientBalancesTableBlock_DueTooltip"]">@DashboardLocalizer["Due"]</span>
                            </td>
                            <td class="px-4 py-3 text-slate-500">
                                @(item.LastPaymentDate.HasValue ? item.LastPaymentDate.Value.ToString("MMM d, yyyy") : "—")
                            </td>
                            <td class="px-4 py-3">
                                <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-semibold @(item.Received > 0 ? "bg-amber-100 text-amber-700" : "bg-red-100 text-red-700")">
                                    @(item.Received > 0 ? DashboardLocalizer["PartiallyPaid"].Value : DashboardLocalizer["Due"].Value)
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Parameter]
    public string? Class { get; set; }
}
