@using Fluxor
@using TimeTracker.Api.Shared.Dto.Model.Report.WorkspaceFinancialSummary
@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Report
@using TimeTracker.Web.Store.Report
@using TimeTracker.Web.Ui.Pages.Dashboard.Report.Summary.Parts
@using TimeTracker.Web.Ui.Shared.Components

@inherits BaseReactiveComponent
@inject IState<ReportsState> ReportsState

<section class="@Class">
    <h2 class="mb-4 text-base font-semibold text-slate-700">Money Overview</h2>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <SummaryMetricCard
            Title="Client Earned"
            HelperText="Billable work recorded for clients across all time."
            TooltipText="Total billable amount from completed billable time entries across all time."
            Variant="neutral"
            IconClass="fa-solid fa-file-invoice-dollar">
            <Value>
                <AmountDisplay Amount="@(_totals?.ClientEarned ?? 0)"/>
            </Value>
        </SummaryMetricCard>

        <SummaryMetricCard
            Title="Client Received"
            HelperText="Payments received from clients across all time."
            Variant="success"
            IconClass="fa-solid fa-circle-check">
            <Value>
                <AmountDisplay Amount="@(_totals?.ClientReceived ?? 0)"/>
            </Value>
        </SummaryMetricCard>

        <SummaryMetricCard
            Title="Unpaid by Clients"
            HelperText="Current amount clients still owe."
            TooltipText="Due means client earned is greater than client payments received."
            Variant="@(_totals?.ClientOutstanding > 0 ? "danger" : "neutral")"
            Emphasis="@(_totals?.ClientOutstanding > 0)"
            IconClass="fa-solid fa-triangle-exclamation">
            <Value>
                <AmountDisplay Amount="@(_totals?.ClientOutstanding ?? 0)"/>
            </Value>
        </SummaryMetricCard>

        <SummaryMetricCard
            Title="Owner Revenue"
            HelperText="Client received minus payouts to members."
            TooltipText="Owner Revenue = Client Received minus Paid to Members."
            Variant="@(_totals?.RealizedMargin >= 0 ? "success" : "danger")"
            IconClass="fa-solid fa-chart-line">
            <Value>
                <AmountDisplay Amount="@(_totals?.RealizedMargin ?? 0)"/>
            </Value>
        </SummaryMetricCard>
    </div>

    @if (_totals?.RealizedMargin < 0)
    {
        <div class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
            Member payouts exceed client received by <AmountDisplay Amount="@Math.Abs(_totals.RealizedMargin)"/>. Check client payments or member payouts.
        </div>
    }

    @if (_data?.HasMemberPayouts == true)
    {
        <div class="mt-6">
            <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Member payouts</h3>
            <div class="grid gap-3 md:grid-cols-3">
                <div class="rounded-lg border border-slate-200 bg-white px-4 py-3">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500" title="Member Earnings are calculated from tracked work using member rates.">Member Earnings</p>
                    <p class="mt-2 text-xl font-semibold text-slate-900"><AmountDisplay Amount="@(_totals?.TeamCost ?? 0)"/></p>
                </div>

                <div class="rounded-lg border border-emerald-100 bg-emerald-50/40 px-4 py-3">
                    <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Paid to Members</p>
                    <p class="mt-2 text-xl font-semibold text-emerald-700"><AmountDisplay Amount="@(_totals?.MemberPaidOut ?? 0)"/></p>
                </div>

                <div class="rounded-lg border @((_totals?.MemberOutstanding ?? 0) > 0 ? "border-red-200 bg-red-50" : "border-slate-200 bg-white") px-4 py-3">
                    <p class="text-xs font-semibold uppercase tracking-wide @((_totals?.MemberOutstanding ?? 0) > 0 ? "text-red-600" : "text-slate-500")">Owed to Members</p>
                    <p class="mt-2 text-xl font-semibold @((_totals?.MemberOutstanding ?? 0) > 0 ? "text-red-700" : "text-slate-900")"><AmountDisplay Amount="@(_totals?.MemberOutstanding ?? 0)"/></p>
                </div>
            </div>
        </div>
    }
    
    @if (_totals?.ClientEarned > 0 && _totals?.ClientReceived <= 0)
    {
        <p class="mt-3 text-sm text-slate-500">No client payments recorded yet.</p>
    }
    @if (_data?.HasMemberPayouts == true && _totals?.TeamCost > 0 && _totals?.MemberPaidOut <= 0)
    {
        <p class="mt-2 text-sm text-slate-500">No member payouts recorded yet.</p>
    }
</section>

@code {
    [Parameter]
    public string? Class { get; set; }

    private WorkspaceFinancialSummaryReportResponse? _data
        => ReportsState.Value.WorkspaceFinancialSummaryData;

    private WorkspaceFinancialSummaryTotalsDto? _totals
        => _data?.Totals;
}
