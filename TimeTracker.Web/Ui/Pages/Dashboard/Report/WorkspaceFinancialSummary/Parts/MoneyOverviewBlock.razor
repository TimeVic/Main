@using Fluxor
@using TimeTracker.Api.Shared.Dto.Model.Report.WorkspaceFinancialSummary
@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Report
@using TimeTracker.Web.Store.Report
@using TimeTracker.Web.Ui.Pages.Dashboard.Report.Summary.Parts
@using TimeTracker.Web.Ui.Shared.Components

@inherits BaseReactiveComponent
@inject IState<ReportsState> ReportsState

<section class="@Class">
    <h2 class="mb-4 text-base font-semibold text-slate-700">Money Overview</h2>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <SummaryMetricCard
            Title="Client Earned"
            HelperText="Billable work recorded for clients across all time."
            Variant="neutral"
            IconClass="fa-solid fa-file-invoice-dollar">
            <Value>
                <AmountDisplay Amount="@(_totals?.ClientEarned ?? 0)"/>
            </Value>
        </SummaryMetricCard>

        <SummaryMetricCard
            Title="Client Received"
            HelperText="Payments received from clients across all time."
            Variant="success"
            IconClass="fa-solid fa-circle-check">
            <Value>
                <AmountDisplay Amount="@(_totals?.ClientReceived ?? 0)"/>
            </Value>
        </SummaryMetricCard>

        <SummaryMetricCard
            Title="Unpaid by Clients"
            HelperText="Current amount clients still owe."
            Variant="@(_totals?.ClientOutstanding > 0 ? "danger" : "neutral")"
            Emphasis="@(_totals?.ClientOutstanding > 0)"
            IconClass="fa-solid fa-triangle-exclamation">
            <Value>
                <AmountDisplay Amount="@(_totals?.ClientOutstanding ?? 0)"/>
            </Value>
        </SummaryMetricCard>

        <SummaryMetricCard
            Title="Estimated Margin"
            HelperText="Client earned minus member earnings."
            Variant="@(_totals?.EstimatedMargin >= 0 ? "success" : "danger")"
            IconClass="fa-solid fa-chart-line">
            <Value>
                <AmountDisplay Amount="@(_totals?.EstimatedMargin ?? 0)"/>
            </Value>
        </SummaryMetricCard>
    </div>

    @if (_data?.IsTeamWorkspace == true)
    {
        <div class="mt-4 grid gap-4 md:grid-cols-3">
            <SummaryMetricCard
                Title="Member Earnings"
                HelperText="Member earnings calculated by rate across all time."
                Variant="neutral"
                IconClass="fa-solid fa-users">
                <Value>
                    <AmountDisplay Amount="@(_totals?.TeamCost ?? 0)"/>
                </Value>
            </SummaryMetricCard>

            <SummaryMetricCard
                Title="Paid to Members"
                HelperText="Payments already made to members across all time."
                Variant="success"
                IconClass="fa-solid fa-hand-holding-dollar">
                <Value>
                    <AmountDisplay Amount="@(_totals?.MemberPaidOut ?? 0)"/>
                </Value>
            </SummaryMetricCard>

            <SummaryMetricCard
                Title="Owed to Members"
                HelperText="Current amount still owed to members."
                Variant="@(_totals?.MemberOutstanding > 0 ? "danger" : "neutral")"
                IconClass="fa-solid fa-clock-rotate-left">
                <Value>
                    <AmountDisplay Amount="@(_totals?.MemberOutstanding ?? 0)"/>
                </Value>
            </SummaryMetricCard>
        </div>
    }
    
    @if (_totals?.ClientEarned > 0 && _totals?.ClientReceived <= 0)
    {
        <p class="mt-3 text-sm text-slate-500">No client payments recorded yet.</p>
    }
    @if (_data?.IsTeamWorkspace == true && _totals?.TeamCost > 0 && _totals?.MemberPaidOut <= 0)
    {
        <p class="mt-2 text-sm text-slate-500">No member payouts recorded yet.</p>
    }
</section>

@code {
    [Parameter]
    public string? Class { get; set; }

    private WorkspaceFinancialSummaryReportResponse? _data
        => ReportsState.Value.WorkspaceFinancialSummaryData;

    private WorkspaceFinancialSummaryTotalsDto? _totals
        => _data?.Totals;
}
