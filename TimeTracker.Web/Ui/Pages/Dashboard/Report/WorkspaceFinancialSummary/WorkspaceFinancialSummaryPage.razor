@page "/board/money"
@page "/board/report/workspace-financial-summary"
@using Fluxor
@using TimeTracker.Web.Store.Report
@using TimeTracker.Web.Ui.Pages.Dashboard.Report.WorkspaceFinancialSummary.Parts
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared
@using TimeTracker.Web.Ui.Shared.Components
@using Layout = TimeTracker.Web.Ui.Pages.Dashboard.Shared.Layout

@inherits BaseReactiveComponent
@inject IState<ReportsState> _state
@layout Layout

@if (!_isAuthorized)
{
    <div class="mt-8 flex items-center justify-center rounded-2xl border border-slate-200 bg-white py-16">
        <div class="text-center">
            <i class="fa-solid fa-lock mb-4 text-4xl text-slate-300"></i>
            <p class="text-lg font-semibold text-slate-700">@DashboardLocalizer["AccessRestricted"]</p>
            <p class="mt-1 text-sm text-slate-500">@DashboardLocalizer["WorkspaceFinancialSummaryPage_AccessRestrictedDescription"]</p>
        </div>
    </div>
}
else
{
    <div class="space-y-2">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">@DashboardLocalizer["WorkspaceMoney"]</h1>
            <p class="mt-1 text-sm text-slate-500">@DashboardLocalizer["WorkspaceMoneyDescription"]</p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-500">
            @DashboardLocalizer["WorkspaceFinancialSummaryPage_CurrentBalancesDescription"]
        </div>
    </div>

    @if (_state.Value.IsLoading)
    {
        <div class="mt-8 flex justify-center rounded-2xl border border-slate-200 bg-white py-10">
            <LumexSpinner/>
        </div>
    }
    else if (_reportData == null || (_reportData.ClientBalances.Count == 0 && _reportData.MemberBalances.Count == 0))
    {
        <LumexCard Class="mt-8 border-dashed border-slate-200 bg-slate-50 shadow-none">
            <LumexCardBody>
                <p class="text-sm font-medium text-slate-700">@DashboardLocalizer["NoTrackedWorkYet"]</p>
                <p class="mt-1 text-sm text-slate-500">@DashboardLocalizer["WorkspaceFinancialSummaryPage_NoTrackedWorkDescription"]</p>
            </LumexCardBody>
        </LumexCard>
    }
    else
    {
        <MoneyOverviewBlock Class="mt-6"/>

        <section class="mt-8">
            <div class="mb-4">
                <h2 class="text-base font-semibold text-slate-700">@DashboardLocalizer["NeedsAttention"]</h2>
            </div>

            <div class="mb-4 grid gap-3 xl:grid-cols-2">
                <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700">
                    @string.Format(DashboardLocalizer["WorkspaceFinancialSummaryPage_ClientsNeedFollowUp"].Value, _unpaidClientCount)
                    ·
                    <span class="@(_unpaidClientAmount > 0 ? "text-red-700" : "text-slate-500")"><AmountDisplay Amount="@_unpaidClientAmount"/> @DashboardLocalizer["Due"]</span>
                </div>

                @if (_showMemberPayouts)
                {
                    <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700">
                        @string.Format(DashboardLocalizer["WorkspaceFinancialSummaryPage_MembersNeedPayout"].Value, _membersToPayCount)
                        ·
                        <span class="@(_membersToPayAmount > 0 ? "text-red-700" : "text-slate-500")"><AmountDisplay Amount="@_membersToPayAmount"/> @DashboardLocalizer["Owed"]</span>
                    </div>
                }
            </div>

            <div class="grid gap-4 xl:grid-cols-2">
                <UnpaidClientsBlock/>

                @if (_showMemberPayouts)
                {
                    <MembersToPayBlock/>
                }
            </div>
        </section>

        <ClientBalancesTableBlock Class="mt-8"/>

        @if (_showMemberPayouts)
        {
            <MemberBalancesTableBlock Class="mt-8"/>
        }

        <ProjectProfitabilityTableBlock Class="mt-8"/>
    }
}
