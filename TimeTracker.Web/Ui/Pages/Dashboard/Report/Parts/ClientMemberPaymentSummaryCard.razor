@using TimeTracker.Web.Ui.Shared.Components
@inherits BaseReactiveComponent

<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="min-w-0">
            <p class="truncate text-base font-semibold text-slate-900">@ClientName</p>
            <p class="mt-1 text-sm text-slate-500">@ProjectCountLabel</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-3 lg:min-w-[560px]">
            <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2">
                <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Earned</p>
                <p class="mt-1 text-xl font-semibold text-slate-900">
                    <AmountDisplay Amount="@Earned"/>
                </p>
            </div>
            <div class="rounded-lg border border-emerald-100 bg-emerald-50 px-3 py-2">
                <p class="text-[11px] font-semibold uppercase tracking-wide text-emerald-700">Received</p>
                <p class="mt-1 text-xl font-semibold text-emerald-700">
                    <AmountDisplay Amount="@Paid"/>
                </p>
            </div>
            <div class="rounded-lg border px-3 py-2 @(Outstanding > 0 ? "border-red-200 bg-red-50" : "border-slate-200 bg-slate-50")">
                <p class="text-[11px] font-semibold uppercase tracking-wide @(Outstanding > 0 ? "text-red-600" : "text-slate-500")">Outstanding</p>
                <p class="mt-1 text-xl font-semibold @(Outstanding > 0 ? "text-red-700" : "text-slate-900")">
                    <AmountDisplay Amount="@Outstanding"/>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string ClientName { get; set; } = string.Empty;

    [Parameter]
    public decimal Earned { get; set; }

    [Parameter]
    public decimal Paid { get; set; }

    [Parameter]
    public decimal Outstanding { get; set; }

    [Parameter]
    public int ProjectCount { get; set; }

    private string ProjectCountLabel => ProjectCount == 1 ? "1 project" : $"{ProjectCount} projects";
}
