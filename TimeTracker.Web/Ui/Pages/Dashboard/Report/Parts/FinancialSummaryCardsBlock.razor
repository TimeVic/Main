@using Fluxor
@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Client.Core.Store.Report
@using TimeTracker.Web.Ui.Shared.Components
@inherits BaseReactiveComponent

@inject IState<ReportsState> ReportsState

<section class="grid gap-4 md:grid-cols-3 @Class">
    <LumexCard>
        <LumexCardBody>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@DashboardLocalizer["TotalEarned"]</p>
            <p class="mt-2 text-3xl font-semibold text-slate-900">
                <AmountDisplay Amount="@_totalEarned"/>
            </p>
            <p class="mt-1 text-sm text-slate-500">@_earnedCaption</p>
        </LumexCardBody>
    </LumexCard>

    <LumexCard>
        <LumexCardBody>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@DashboardLocalizer["TotalReceived"]</p>
            <p class="mt-2 text-3xl font-semibold text-emerald-700">
                <AmountDisplay Amount="@_totalPaid"/>
            </p>
            <p class="mt-1 text-sm text-slate-500">@_paidCaption</p>
        </LumexCardBody>
    </LumexCard>

    <LumexCard Class="@(_outstandingBalance > 0 ? "border-red-200 bg-red-50/40" : "border-emerald-200 bg-emerald-50/30")">
        <LumexCardBody>
            <p class="text-xs font-semibold uppercase tracking-wide @(_outstandingBalance > 0 ? "text-red-600" : "text-emerald-700")">@DashboardLocalizer["OutstandingBalance"]</p>
            <p class="mt-2 text-3xl font-semibold @(_outstandingBalance > 0 ? "text-red-700" : "text-emerald-700")">
                <AmountDisplay Amount="@_outstandingBalance"/>
            </p>
            <p class="mt-1 text-sm @(_outstandingBalance > 0 ? "text-red-700" : "text-slate-500")">@_outstandingCaption</p>
        </LumexCardBody>
    </LumexCard>
</section>

@code {
    [Parameter]
    public string EarnedCaption { get; set; } = string.Empty;

    [Parameter]
    public string PaidCaption { get; set; } = string.Empty;

    [Parameter]
    public string OutstandingCaptionWhenPositive { get; set; } = string.Empty;

    [Parameter]
    public string OutstandingCaptionWhenZero { get; set; } = string.Empty;

    [Parameter]
    public string Class { get; set; } = string.Empty;

    private IEnumerable<IGrouping<Guid?, MemberPaymentsReportItemDto>> _paymentReportGroups
    {
        get => ReportsState.Value.MemberPaymentReportItems.GroupBy(item => item.ClientId);
    }

    private decimal _totalEarned
    {
        get => ReportsState.Value.MemberPaymentReportItems.Sum(item => item.Amount);
    }

    private decimal _totalPaid
    {
        get => _paymentReportGroups.Sum(group => group.FirstOrDefault()?.PaidAmountByClient ?? 0);
    }

    private decimal _outstandingBalance
    {
        get => _paymentReportGroups.Sum(group =>
        {
            var earned = group.Sum(item => item.Amount);
            var paid = group.FirstOrDefault()?.PaidAmountByClient ?? 0;
            return Math.Max(earned - paid, 0);
        });
    }

    private string _outstandingCaption
    {
        get => _outstandingBalance > 0
            ? (string.IsNullOrWhiteSpace(OutstandingCaptionWhenPositive) ? DashboardLocalizer["NeedsCollection"].Value : OutstandingCaptionWhenPositive)
            : (string.IsNullOrWhiteSpace(OutstandingCaptionWhenZero) ? DashboardLocalizer["NoUnpaidBalance"].Value : OutstandingCaptionWhenZero);
    }

    private string _earnedCaption => string.IsNullOrWhiteSpace(EarnedCaption)
        ? DashboardLocalizer["BillableValueTrackedWork"].Value
        : EarnedCaption;

    private string _paidCaption => string.IsNullOrWhiteSpace(PaidCaption)
        ? DashboardLocalizer["PaymentsRecordedFromClients"].Value
        : PaidCaption;
}
