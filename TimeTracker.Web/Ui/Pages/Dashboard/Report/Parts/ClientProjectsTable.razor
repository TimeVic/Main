@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Business.Extensions
@using TimeTracker.Web.Ui.Shared.Components

@inherits BaseReactiveComponent

<div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
        <tr>
            <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">@DashboardLocalizer["Project"]</th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">@DashboardLocalizer["Duration"]</th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">@DashboardLocalizer["Earned"]</th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">@DashboardLocalizer["Received"]</th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">@DashboardLocalizer["Outstanding"]</th>
            <th class="px-5 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">@DashboardLocalizer["EffectiveHourlyRate"]</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
        @foreach (var item in Items)
        {
            var outstanding = GetProjectOutstandingAmount(item);
            var effectiveHourlyRate = GetEffectiveHourlyRate(item.Amount, item.TotalDuration);

            <tr class="hover:bg-slate-50/80">
                <td class="min-w-[220px] px-5 py-4">
                    <div class="flex items-center gap-3">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500">
                            <i class="fa-regular fa-folder"></i>
                        </span>
                        <span class="@GetProjectNameClass(item)">
                            @GetProjectName(item)
                        </span>
                    </div>
                </td>
                <td class="whitespace-nowrap px-4 py-4 text-right font-medium text-slate-700 tabular-nums">
                    @item.TotalDuration.ToReadableShortString()
                </td>
                <td class="@GetAmountCellClass(item.Amount, "neutral")">
                    <AmountDisplay Amount="@item.Amount"/>
                </td>
                <td class="@GetAmountCellClass(item.PaidAmountByProject, "success")">
                    <AmountDisplay Amount="@item.PaidAmountByProject"/>
                </td>
                <td class="@GetAmountCellClass(outstanding, "danger")">
                    <AmountDisplay Amount="@outstanding"/>
                </td>
                <td class="whitespace-nowrap px-5 py-4 text-right font-medium text-slate-700 tabular-nums">
                    <AmountDisplay Amount="@effectiveHourlyRate"/>/h
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    [Parameter]
    public IEnumerable<MemberPaymentsReportItemDto> Items { get; set; } = Enumerable.Empty<MemberPaymentsReportItemDto>();

    private string GetProjectName(MemberPaymentsReportItemDto item)
    {
        return string.IsNullOrWhiteSpace(item.ProjectName) ? DashboardLocalizer["UnnamedProject"].Value : item.ProjectName;
    }

    private static string GetProjectNameClass(MemberPaymentsReportItemDto item)
    {
        return string.IsNullOrWhiteSpace(item.ProjectName)
            ? "font-medium italic text-slate-400"
            : "font-medium text-slate-900";
    }

    private static decimal GetProjectOutstandingAmount(MemberPaymentsReportItemDto item)
    {
        return Math.Max(item.Amount - item.PaidAmountByProject, 0);
    }

    private static decimal GetEffectiveHourlyRate(decimal amount, TimeSpan duration)
    {
        if (duration.TotalHours <= 0)
        {
            return 0;
        }

        return Math.Round(amount / (decimal)duration.TotalHours, 2);
    }

    private static string GetAmountCellClass(decimal value, string variant)
    {
        if (value == 0)
        {
            return "whitespace-nowrap px-4 py-4 text-right font-medium text-slate-400 tabular-nums";
        }

        return variant switch
        {
            "success" => "whitespace-nowrap px-4 py-4 text-right font-semibold text-emerald-700 tabular-nums",
            "danger" => "whitespace-nowrap px-4 py-4 text-right font-semibold text-red-700 tabular-nums",
            _ => "whitespace-nowrap px-4 py-4 text-right font-medium text-slate-900 tabular-nums"
        };
    }
}
