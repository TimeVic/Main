@using Fluxor
@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Client.Core.Store.Report
@using TimeTracker.Web.Ui.Shared.Components

@inherits BaseReactiveComponent

@inject IState<ReportsState> ReportsState

<section class="@Class">
    <div class="grid gap-4 md:grid-cols-3">
        <MemberPaymentMetricCard
            Title="@DashboardLocalizer["TotalEarned"].Value"
            HelperText="@DashboardLocalizer["BillableValueIncludedWork"].Value"
            Variant="neutral"
            IconClass="fa-solid fa-chart-line">
            <Value>
                <AmountDisplay Amount="@_totalEarned"/>
            </Value>
        </MemberPaymentMetricCard>

        <MemberPaymentMetricCard
            Title="@DashboardLocalizer["TotalReceived"].Value"
            HelperText="@DashboardLocalizer["PaymentsCollectedFromClients"].Value"
            Variant="success"
            IconClass="fa-solid fa-check">
            <Value>
                <AmountDisplay Amount="@_totalReceived"/>
            </Value>
        </MemberPaymentMetricCard>

        <MemberPaymentMetricCard
            Title="@DashboardLocalizer["OutstandingBalance"].Value"
            HelperText="@DashboardLocalizer["StillUnpaidRequiresAttention"].Value"
            Variant="danger"
            IconClass="fa-solid fa-triangle-exclamation">
            <Value>
                <AmountDisplay Amount="@_outstandingBalance"/>
            </Value>
        </MemberPaymentMetricCard>
    </div>

    <p class="mt-3 text-sm text-slate-500">@DashboardLocalizer["OutstandingFormula"]</p>
</section>

@code {
    [Parameter]
    public string Class { get; set; } = string.Empty;

    private IEnumerable<IGrouping<Guid?, MemberPaymentsReportItemDto>> _paymentReportGroups
    {
        get => ReportsState.Value.MemberPaymentReportItems.GroupBy(item => item.ClientId);
    }

    private decimal _totalEarned
    {
        get => ReportsState.Value.MemberPaymentReportItems.Sum(item => item.Amount);
    }

    private decimal _totalReceived
    {
        get => _paymentReportGroups.Sum(group => group.FirstOrDefault()?.PaidAmountByClient ?? 0);
    }

    private decimal _outstandingBalance
    {
        get => _paymentReportGroups.Sum(group =>
        {
            var earned = group.Sum(item => item.Amount);
            var received = group.FirstOrDefault()?.PaidAmountByClient ?? 0;
            return Math.Max(earned - received, 0);
        });
    }
}
