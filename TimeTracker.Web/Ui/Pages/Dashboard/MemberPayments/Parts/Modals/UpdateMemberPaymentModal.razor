@using LumexUI
@using LumexUI.Common
@using TimeTracker.Web.Constants.Ui
@using TimeTracker.Web.Ui.Shared.Components.Form.Validation

@inherits BaseReactiveComponent

<LumexModal
    Open="IsOpened"
    OnClose="@OnCloseModal"
    Size="ModalSize.Large"
    @ref="modal">
    <LumexModalContent>
        <LumexModalHeader Class="flex items-center gap-3">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                    <i class="fa-regular fa-pen-to-square"></i>
                </div>
                <div>
                    <h2 class="mt-2 text-xl font-semibold text-slate-900">Edit payment</h2>
                    <p class="mt-1 text-sm text-slate-600">Update the received amount, date, project, or note.</p>
                </div>
            </div>
        </LumexModalHeader>
        <LumexModalBody>
            <EditForm
                Context="form"
                @ref="_form"
                Model="@model"
                novalidate>
                <DataAnnotationsValidator/>

                <div class="grid gap-4 md:grid-cols-2">
                    <div class="md:col-span-2">
                        <ProjectsDropDown
                            Label="Project"
                            IsGroupByClient="true"
                            IsShowProjectsWithoutClients="false"
                            Value="model.ProjectId"
                            ValueExpression="() => model.ProjectId"
                            SelectedItemChanged="OnProjectSelected"/>
                        <CustomValidationMessage For="@(() => model.ClientId)"/>
                    </div>
                    @if (CanCreatePaymentForOtherMembers)
                    {
                        <div class="md:col-span-2">
                            <MembersDropDown
                                Label="Member"
                                Type="DropDownType.Select"
                                Value="model.MemberId"
                                ValueExpression="() => model.MemberId"
                                SelectedItemChanged="OnMemberSelected"/>
                        </div>
                    }
                    <div>
                        <InputDateTimeField
                            Size="Size.Small"
                            Required="true"
                            Value="@model.PaymentTime"
                            ValueExpression="() => model.PaymentTime"
                            Label="Payment Date"/>
                        <CustomValidationMessage For="@(() => model.PaymentTime)"/>
                    </div>
                    <div>
                        <InputNumericField
                            TItem="decimal"
                            Size="Size.Small"
                            Required="true"
                            @bind-Value="@model.Amount"
                            Label="Received"/>
                        <CustomValidationMessage For="@(() => model.Amount)" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Description</label>
                        <InputTextArea
                            @bind-Value="model.Description"
                            class="min-h-[120px] w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 focus:border-blue-500 focus:outline-none"
                            placeholder="Optional payment note"/>
                    </div>
                </div>

                <CustomValidationSummary/>
            </EditForm>
        </LumexModalBody>
        <LumexModalFooter>
            <CustomButton
                FullWidth="@true"
                OnClick="@Submit"
                IsLoading="_state.Value.IsListLoading"
                Color="@ThemeColor.Primary"
                Radius="@Radius.Full">
                Update
            </CustomButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
