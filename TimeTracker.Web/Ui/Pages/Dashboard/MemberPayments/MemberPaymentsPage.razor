@page "/board/member-payments"

@using TimeTracker.Web.Constants.Ui
@using TimeTracker.Web.Ui.Pages.Dashboard.MemberPayments.Parts
@using TimeTracker.Web.Ui.Pages.Dashboard.MemberPayments.Parts.Modals
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared
@using TimeTracker.Web.Ui.Shared.Components.List

@inherits BaseReactiveComponent
@layout Layout

<AddMemberPaymentModal 
    IsOpened="_isShowAddMemberPaymentModal" 
    IsOpenedChanged="isOpened => _isShowAddMemberPaymentModal = isOpened"/>

<LumexCard Class="mt-6">
    <LumexCardBody>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Payments</p>
        <p class="mt-2 text-2xl font-semibold text-slate-900">@_state.Value.TotalCount</p>
        <p class="mt-1 text-sm text-slate-500">Saved for the current workspace</p>
    </LumexCardBody>
</LumexCard>

<LumexCard Class="mt-6 overflow-x-auto pb-2">
    <LumexCardHeader Class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="text-sm font-semibold text-slate-900">Payments</p>
            <p class="text-sm text-slate-500">Track payments received from clients for completed work on workspace projects.</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
            @if (CanManageOtherMemberPayments)
            {
                <MembersDropDown
                    Class="min-w-56"
                    Label="Member"
                    Type="DropDownType.Select"
                    Clearable="true"
                    Value="_memberFilterId"
                    SelectedItemChanged="OnMemberFilterChanged"/>
            }
            <CustomButton OnClick="@(() => _isShowAddMemberPaymentModal = true)">
                <StartContent>
                    <i class="fa-solid fa-plus"></i>    
                </StartContent>
                <ChildContent>
                    Add payment
                </ChildContent>
            </CustomButton>
        </div>
    </LumexCardHeader>
    <LumexCardBody>
        @if (_state.Value.TotalCount == 0)
        {
            <div class="px-4 py-8 text-center text-sm text-slate-500">No payments added yet. Use the add button to create the first payment.</div>
        }
        else
        {
            <MemberPaymentsTableBlock></MemberPaymentsTableBlock>
        }
        <div class="mt-4">
            <TPaginator
                CurrentPage="@_state.Value.SelectedPage"
                CurrentPageChanged="OnPageChanged"
                TotalPages="@_state.Value.TotalPages"
                SummaryText="@PaymentPaginationSummary"/>
        </div>
    </LumexCardBody>
</LumexCard>
