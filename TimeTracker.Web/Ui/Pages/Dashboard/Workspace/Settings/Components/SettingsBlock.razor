@using TimeTracker.Web.Ui.Pages.Dashboard.Workspace.Settings.Components.Parts

@inherits BaseReactiveComponent

<section class="space-y-6">
    <LumexCard>
        <LumexCardHeader>
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-blue-700">General</p>
                <h2 class="mt-2 text-lg font-semibold text-slate-900">Workspace profile</h2>
                <p class="mt-1 text-sm text-slate-600">Edit core workspace information and save it from this section.</p>
            </div>
        </LumexCardHeader>
        <LumexCardBody>
            <div>
                @if (_workspace != null)
                {
                    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-blue-100">Current workspace</p>
                    <div class="mt-2 flex flex-wrap items-center gap-3">
                        <h2 class="text-2xl font-semibold">@_workspace.Name</h2>
                        @if (_workspace.IsFullAccess)
                        {
                            <span class="rounded-full border border-white/20 bg-white/15 px-3 py-1 text-xs font-semibold text-white">Default</span>
                        }
                    </div>
                    if (!string.IsNullOrEmpty(_workspace.Description))
                    {
                        <p class="mt-2 max-w-2xl text-sm text-blue-100">@_workspace.Description</p>
                    }
                }
            </div>
        </LumexCardBody>
    </LumexCard>
    
    <LumexCard>
        <LumexCardBody>
            <UpdateWorkspaceForm></UpdateWorkspaceForm>
        </LumexCardBody>
    </LumexCard>
</section>
