@using LumexUI.Common
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared.Clients
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared.Projects
@using TimeTracker.Web.Ui.Pages.Dashboard.Workspace.Settings.Components.Parts

@inherits BaseReactiveComponent

<AddClientModal
    IsOpened="_isAddClientModalOpened"
    IsOpenedChanged="isOpened => _isAddClientModalOpened = isOpened"/>

<AddProjectModal
    IsOpened="_isAddProjectModalOpened"
    InitialClientId="_initialProjectClientId"
    IsOpenedChanged="OnAddProjectModalOpenedChanged"/>

@if (_projectToUpdate != null)
{
    <UpdateProjectModal
        Project="_projectToUpdate"
        IsOpened="_projectToUpdate != null"
        IsOpenedChanged="isOpened => { _projectToUpdate = isOpened ? _projectToUpdate : null; }"/>
}

<section class="space-y-6">
    <LumexCard>
        <LumexCardBody>
            <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-blue-700">@DashboardLocalizer["SettingsPage_ClientsAndProjectsTab"]</p>
                    <h2 class="mt-2 text-lg font-semibold text-slate-900">@DashboardLocalizer["ClientsBlock_ProjectDirectoryTitle"]</h2>
                    <p class="mt-1 text-sm text-slate-600">@DashboardLocalizer["ClientsBlock_Description"]</p>
                </div>
                <CustomButton
                    Size="Size.Small"
                    OnClick="@OnAdd"
                    Color="@ThemeColor.Primary"
                    Radius="@Radius.Full">
                    <StartContent>
                        <i class="fa-solid fa-plus"></i>
                    </StartContent>
                    <ChildContent>
                        @DashboardLocalizer["AddClient"]
                    </ChildContent>
                </CustomButton>
            </div>
        </LumexCardBody>
    </LumexCard>
    
    @if (_clientState.Value.List.Any() || _projectState.Value.List.Any())
    {
        <div class="space-y-4">
            @foreach (var client in _clientState.Value.List.OrderBy(client => client.Name))
            {
                <ClientProjectsGroupBlock
                    @key="client.Id"
                    Client="@client"
                    Projects="@GetProjectsByClient(client)"
                    AddProjectRequested="OnAddProject"
                    EditProjectRequested="OnEditProject"/>
            }

            @if (GetProjectsWithoutClient().Any())
            {
                <ClientProjectsGroupBlock
                    Projects="@GetProjectsWithoutClient()"
                    AddProjectRequested="OnAddProject"
                    EditProjectRequested="OnEditProject"/>
            }
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">
            @DashboardLocalizer["ClientsBlock_Empty"]
        </div>
    }
</section>
