@using LumexUI
@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared
@using Orientation = LumexUI.Common.Orientation

@inherits BaseReactiveComponent

<LumexCard Shadow="Shadow.Small" Radius="Radius.Medium">
    <LumexCardHeader>Clients</LumexCardHeader>
    <LumexCardBody>
        <div>
            <InputTextField></InputTextField>
        </div>
    </LumexCardBody>
</LumexCard>

<LumexDataGrid 
    Data="@_state.Value.List.AsQueryable()" 
    Radius="@Radius.Medium"
    Class="mt-3"
>
    <LumexUI.PropertyColumn Title="Name" Property="@(p => p.Name)" />
    <LumexUI.PropertyColumn Title="Actions" Property="@(p => p.Id)">
        <Content>
            <CustomButton
                Class="inline-flex rounded-full"
                OnClick="@(() => OnDelete(context))"
                Size="Size.Small"
                Color="ThemeColor.Danger"
                Variant="Variant.Light"
                IconOnly="true">
                <ChildContent>
                    <i class="fa-regular fa-trash-can"></i>
                </ChildContent>
            </CustomButton>
        </Content>
    </LumexUI.PropertyColumn>
</LumexDataGrid>
