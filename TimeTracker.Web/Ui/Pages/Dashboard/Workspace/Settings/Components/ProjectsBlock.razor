@using LumexUI.Common
@using TimeTracker.Web.Ui.Pages.Dashboard.Workspace.Settings.Components.Parts

@inherits BaseReactiveComponent

<section class="space-y-6">
    <LumexCard>
        <LumexCardBody>
            <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-blue-700">Projects</p>
                    <h2 class="mt-2 text-lg font-semibold text-slate-900">Workspace projects</h2>
                    <p class="mt-1 text-sm text-slate-600">Projects keep their assigned client visible, but existing client links stay read-only here.</p>
                </div>
                <AddProjectForm/>
            </div>
        </LumexCardBody>
    </LumexCard>
    
    <LumexDataGrid
        Data="@_state.Value.List.AsQueryable()"
        Radius="@Radius.Medium"
        Class="mt-3">
        <LumexUI.EditColumn
            Title="Name"
            Property="@(p => p.Name)"/>
        <LumexUI.PropertyColumn
            Title="Billable by default"
            Property="@(p => p.IsBillableByDefault)">
            <Content>
                <LumexCheckbox @bind-Checked="context.IsBillableByDefault"/>
            </Content>
        </LumexUI.PropertyColumn>
        <LumexUI.PropertyColumn
            Title="Default hourly rate"
            Property="@(p => p.DefaultHourlyRate)">
            <Content>
                <InputNumericField
                    TItem="decimal"
                    Step="00.01"
                    Label=""
                    LabelPlacement="LabelPlacement.Outside"
                    Disabled="@(!context.IsBillableByDefault)"
                    Value="context.DefaultHourlyRate"
                    ValueExpression="() => context.DefaultHourlyRate"
                    ValueChanged="@(value => context.DefaultHourlyRate = value ?? 0)"/>
            </Content>
        </LumexUI.PropertyColumn>
        <LumexUI.PropertyColumn
            Title="Client"
            Sortable="true"
            Property="@(p => p.Client != null ? p.Client.Name : string.Empty)">
            <Content>
                <ClientsDropDown
                    Value="@(context.Client?.Id ?? Guid.Empty)"
                    SelectedItemChanged="@(client => context.Client = client)"/>
            </Content>
        </LumexUI.PropertyColumn>
        <LumexUI.PropertyColumn
            Title="Actions"
            Property="@(p => p.Id)">
            <Content>
                <CustomButton
                    Class="inline-flex rounded-full"
                    OnClick="@(() => OnSave(context))"
                    Size="Size.Small"
                    Color="ThemeColor.Success"
                    Variant="Variant.Light"
                    IconOnly="true">
                    <ChildContent>
                        <i class="fa-regular fa-floppy-disk"></i>
                    </ChildContent>
                </CustomButton>
            </Content>
        </LumexUI.PropertyColumn>
    </LumexDataGrid>
</section>
