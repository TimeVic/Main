@using LumexUI
@using LumexUI.Common

@inherits BaseReactiveComponent

<LumexModal
    Open="IsOpened"
    OnClose="@OnCloseModal"
    Size="ModalSize.Large"
    @ref="modal">
    <LumexModalContent>
        <LumexModalHeader Class="flex items-center gap-3">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                    <i class="fa-solid fa-tag"></i>
                </div>
                <div>
                    <h2 class="mt-2 text-xl font-semibold text-slate-900">Edit "@model.Name"</h2>
                    <p class="mt-1 text-sm text-slate-600">Update the tag name and color used across workspace time entries.</p>
                </div>
            </div>
        </LumexModalHeader>
        <LumexModalBody>
            <EditForm
                Context="form"
                @ref="_form"
                Model="@model"
                novalidate>
                <DataAnnotationsValidator/>

                <div class="space-y-5">
                    <div class="mt-1">
                        <InputTextField
                            FullWidth="true"
                            Label="Tag"
                            Placeholder="Tag name"
                            Variant="InputVariant.Outlined"
                            @bind-Value="model.Name"/>
                    </div>

                    <div class="mt-1">
                        <ColorDropDown
                            Label="Color"
                            Clearable="true"
                            @bind-Value="model.Color"/>
                    </div>
                </div>
            </EditForm>
        </LumexModalBody>
        <LumexModalFooter>
            <CustomButton
                FullWidth="@true"
                OnClick="@Submit"
                IsLoading="_state.Value.IsSaving"
                Color="@ThemeColor.Primary"
                Radius="@Radius.Full">
                Update
            </CustomButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
