@using LumexUI
@using LumexUI.Common
@using TimeTracker.Web.Ui.Shared.Components.Form.Validation

@inherits BaseReactiveComponent

<LumexModal
    Open="IsOpened"
    OnClose="@OnCloseModal"
    Size="ModalSize.Large">
    <LumexModalContent>
        <LumexModalHeader Class="flex items-center gap-3">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                    <i class="fa-solid fa-user-plus"></i>
                </div>
                <div>
                    <h2 class="mt-2 text-xl font-semibold text-slate-900">Invite member</h2>
                    <p class="mt-1 text-sm text-slate-600">Send a workspace invitation by email.</p>
                </div>
            </div>
        </LumexModalHeader>
        <LumexModalBody>
            <EditForm
                Context="form"
                @ref="_form"
                Model="@_model"
                novalidate>
                <DataAnnotationsValidator/>

                <div class="mt-1">
                    <InputTextField
                        FullWidth="true"
                        Label="Member email"
                        Type="InputType.Email"
                        Placeholder="member@email.com"
                        Variant="InputVariant.Outlined"
                        @bind-Value="_model.Email"/>
                    <CustomValidationMessage For="@(() => _model.Email)"/>
                </div>

                <CustomValidationSummary/>
            </EditForm>
        </LumexModalBody>
        <LumexModalFooter>
            <CustomButton
                FullWidth="@true"
                OnClick="@Submit"
                IsLoading="_state.Value.IsListLoading"
                Color="@ThemeColor.Primary"
                Radius="@Radius.Full">
                <StartContent>
                    <i class="fa-solid fa-user-plus"></i>
                </StartContent>
                <ChildContent>
                    Invite member
                </ChildContent>
            </CustomButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
