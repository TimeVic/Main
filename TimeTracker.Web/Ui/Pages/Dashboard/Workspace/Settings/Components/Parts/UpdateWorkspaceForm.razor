@using LumexUI.Common
@using TimeTracker.Web.Constants.Ui
@inherits BaseReactiveComponent

<div class="mt-5 space-y-4">
    
    <EditForm 
        Model="model"
        @ref="_form"
        class="mt-6 space-y-4">
        <DataAnnotationsValidator />
    
        <div>
            <InputTextField 
                Label="Workspace name"
                FullWidth="true"
                IsShowEmojiButton="true"
                @bind-Value="model.Name"/>
        </div>
        <div class="grid gap-4 grid-cols-2">
            <LumexSelect 
                TValue="string"
                Label="Time zone"
                Required="true"
                @bind-Value="model.TimeZone"
                Class="max-w-xs">
                @foreach (var timeZone in _timeZones)
                {
                    <LumexSelectItem @key="@timeZone.Id" Value="@timeZone.Id">
                        @timeZone.DisplayName
                    </LumexSelectItem>
                }
            </LumexSelect>
            
            <CurrenciesDropDown @Value="model.CurrencyId" SelectedItemChanged="OnSelectedCurrency" />
        </div>
        <div>
            <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Description</label>
            <InputTextArea @bind-Value="model.Description" class="min-h-[160px] w-full rounded-3xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700 focus:border-blue-500 focus:outline-none"/>
        </div>
    </EditForm>
</div>

<div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-end">
    <div class="flex flex-col items-end gap-2 lg:items-end justify-end">
        <CustomButton
            Color="ThemeColor.Primary"
            Variant="Variant.Solid"
            OnClick="@OnSave">
            <StartContent>
                <i class="fa-regular fa-floppy-disk"></i>
            </StartContent>
            <ChildContent>
                Save settings
            </ChildContent>
        </CustomButton>
    </div>
</div>
