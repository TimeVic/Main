@using LumexUI.Common
@inherits BaseReactiveComponent

<div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div class="flex flex-col items-start gap-2 lg:items-end">
        <CustomButton 
            Color="ThemeColor.Primary"
            Variant="Variant.Solid"
            @OnClick="OnSave">
            <StartContent>
                <i class="fa-regular fa-floppy-disk"></i>
            </StartContent>
            <ChildContent>
                Save settings    
            </ChildContent>
        </CustomButton>
    </div>
</div>
<div class="mt-5 space-y-4">
    
    <EditForm 
        Model="model"
        @ref="_form"
        class="mt-6 space-y-4">
        <DataAnnotationsValidator />
    
        <div>
            <InputTextField 
                Label="Workspace name"
                IsShowEmojiButton="true"
                @bind-Value="model.Name"/>
        </div>
        <div>
            <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Description</label>
            <InputTextArea @bind-Value="model.Description" class="min-h-[160px] w-full rounded-3xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700 focus:border-blue-500 focus:outline-none"/>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
            <div>
                <LumexSelect TValue="string"
                             Label="Time zone"
                             Class="max-w-xs">
                    @foreach (var timeZone in _timeZones)
                    {
                        <LumexSelectItem @key="@timeZone.Id" Value="@timeZone.Id">
                            @timeZone.DisplayName
                        </LumexSelectItem>
                    }
                </LumexSelect>
            </div>
            <div>
                @* <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Currency</label> *@
                @* <InputSelect @bind-Value="CurrentWorkspace.Currency" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 focus:border-blue-500 focus:outline-none"> *@
                @*     @foreach (var currency in currencyOptions) *@
                @*     { *@
                @*         <option value="@currency">@currency</option> *@
                @*     } *@
                @* </InputSelect> *@
            </div>
        </div>
    </EditForm>
</div>
