@using LumexUI.Common

@inherits BaseReactiveComponent

<LumexCard>
    <LumexCardBody>
        <div class="space-y-5">
            <div class="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
                <div class="min-w-0 flex-1">
                    @if (Client != null)
                    {
                        <InputTextField
                            FullWidth="true"
                            Label="@DashboardLocalizer["Client"]"
                            Placeholder="@DashboardLocalizer["ClientName"]"
                            Variant="InputVariant.Outlined"
                            IsShowEmojiButton="true"
                            @bind-Value="Client.Name"/>
                    }
                    else
                    {
                        <div>
                            <p class="text-sm font-semibold text-slate-900">@DashboardLocalizer["ClientProjectsGroupBlock_ProjectsWithoutClient"]</p>
                            <p class="mt-1 text-xs text-slate-500">@DashboardLocalizer["ClientProjectsGroupBlock_ProjectsWithoutClientDescription"]</p>
                        </div>
                    }
                </div>

                <div class="flex shrink-0 flex-col gap-3 sm:flex-row sm:items-center">
                    @if (Client != null)
                    {
                        <CustomButton
                            OnClick="@OnSaveClient"
                            Size="Size.Small"
                            Color="@ThemeColor.Primary"
                            Radius="@Radius.Full">
                            <StartContent>
                                <i class="fa-regular fa-floppy-disk"></i>
                            </StartContent>
                            <ChildContent>
                                @DashboardLocalizer["ClientProjectsGroupBlock_SaveClient"]
                            </ChildContent>
                        </CustomButton>
                    }
                </div>
            </div>

            @if (Projects.Any())
            {
                <div class="space-y-3">
                    <div class="flex items-center justify-end">
                        <CustomButton
                            OnClick="@OnAddProject"
                            Size="Size.Small"
                            Color="@ThemeColor.Primary"
                            Radius="@Radius.Full">
                            <StartContent>
                                <i class="fa-solid fa-plus"></i>
                            </StartContent>
                            <ChildContent>
                                @DashboardLocalizer["AddProject"]
                            </ChildContent>
                        </CustomButton>
                    </div>

                    <LumexDataGrid
                        Data="@Projects.AsQueryable()"
                        Radius="@Radius.Medium">
                        <LumexUI.PropertyColumn
                            Title="@DashboardLocalizer["Project"]"
                            Property="@(p => p.Name)"/>
                        <LumexUI.PropertyColumn
                            Title="@DashboardLocalizer["ClientProjectsGroupBlock_BillableByDefault"]"
                            Property="@(p => p.IsBillableByDefault)"/>
                        <LumexUI.PropertyColumn
                            Title="@DashboardLocalizer["DefaultHourlyRate"]"
                            Property="@(p => p.DefaultHourlyRate)"/>
                        <LumexUI.PropertyColumn
                            Title="@DashboardLocalizer["Actions"]"
                            Property="@(p => p.Id)">
                            <Content>
                                <CustomButton
                                    Class="inline-flex rounded-full"
                                    OnClick="@(() => OnEditProject(context))"
                                    Size="Size.Small"
                                    Color="ThemeColor.Primary"
                                    Variant="Variant.Light"
                                    IconOnly="true">
                                    <ChildContent>
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </ChildContent>
                                </CustomButton>
                            </Content>
                        </LumexUI.PropertyColumn>
                    </LumexDataGrid>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-3 rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-4 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between">
                    <span>@DashboardLocalizer["ClientProjectsGroupBlock_ClientHasNoProjects"]</span>
                    <CustomButton
                        OnClick="@OnAddProject"
                        Size="Size.Small"
                        Color="@ThemeColor.Primary"
                        Radius="@Radius.Full">
                        <StartContent>
                            <i class="fa-solid fa-plus"></i>
                        </StartContent>
                        <ChildContent>
                            @DashboardLocalizer["AddProject"]
                        </ChildContent>
                    </CustomButton>
                </div>
            }
        </div>
    </LumexCardBody>
</LumexCard>
