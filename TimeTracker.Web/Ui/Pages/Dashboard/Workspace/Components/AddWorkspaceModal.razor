@using LumexUI
@using LumexUI.Common

@inherits BaseReactiveComponent

<LumexModal Open="IsOpened" OnClose="@OnCloseModal" Size="ModalSize.Small" @ref="modal">
    <LumexModalContent>
        <LumexModalHeader Class="flex items-center gap-3">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-blue-600">New workspace</p>
                <h2 class="mt-2 text-xl font-semibold text-slate-900">Add workspace</h2>
                <p class="mt-1 text-sm text-slate-500">After creation the app will switch to it automatically.</p>
            </div>
        </LumexModalHeader>
        <LumexModalBody>
            <EditForm
                Context="form"
                @ref="_form"
                Model="@model"
                OnValidSubmit="@Submit"
                novalidate>
                <DataAnnotationsValidator/>
                <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">Submit</button>
                
                <div>
                    <InputTextField
                        Class="w-100"
                        Label="Workspace name"
                        IsShowEmojiButton="true"
                        @bind-Value="model.Name"/>
                </div>
            </EditForm>
        </LumexModalBody>
        <LumexModalFooter>
            <CustomButton
                FullWidth="@true"
                OnClick="@Submit"
                Color="@ThemeColor.Primary"
                Radius="@Radius.Full">
                Add
            </CustomButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
