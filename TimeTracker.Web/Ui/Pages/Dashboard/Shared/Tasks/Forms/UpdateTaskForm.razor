@using LumexUI
@using LumexUI.Common
@using TimeTracker.Business.Common.Constants.Task
@using TimeTracker.Business.Common.Constants.Storage
@using TimeTracker.Web.Constants.Ui
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;

@inherits BaseReactiveComponent

@if (_isLoading)
{
    <LumexSpinner Size="@Size.Large" />
}
else if (!string.IsNullOrEmpty(_task.TaskList?.Name))
{
    <div
        @ref="_attachmentDropZone"
        class="relative rounded-2xl transition @(_isDragActive ? "bg-blue-50/60 ring-2 ring-blue-500 ring-offset-2" : null)">
        <InputFile
            @ref="_attachmentInput"
            class="hidden"
            OnChange="@OnAttachmentsInputFileChange"
            multiple
            accept="@_attachmentAcceptTypes" />
        @if (_isDragActive)
        {
            <div class="pointer-events-none absolute inset-0 z-20 flex items-center justify-center rounded-2xl border-2 border-dashed border-blue-500 bg-blue-50/80 text-blue-600">
                <i class="fa-solid fa-cloud-arrow-up text-3xl"></i>
            </div>
        }

        <EditForm
            @ref="_form"
            EditContext="_editContext"
            novalidate>
            <DataAnnotationsValidator/>

            <div class="rounded-2xl border border-slate-200 p-4">
                <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Task title</label>
                <InputTextField FullWidth="true" @bind-Value="_model.Title"/>
                <div class="mt-4 grid gap-4 md:grid-cols-3">
                    <div>
                        <MembersDropDown
                            Label="Assigned"
                            UserId="_model.UserId"
                            SelectedItemChanged="OnAssignedChanged"
                            AllowedIds="_allowedUserIds"
                        />
                    </div>
                    <div>
                        <EnumDropDown
                            TItem="TaskStatus"
                            Label="Status"
                            Value="_model.Status"
                            ValueChanged="OnStatusChanged"
                        />
                    </div>
                    <div>
                        <EnumDropDown
                            TItem="TaskPriority"
                            Label="Priority"
                            Value="_model.Priority"
                            ValueChanged="OnPriorityChanged"
                        />
                    </div>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 p-4 mt-3">
                <div class="grid gap-4 md:grid-cols-3">
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Project</label>
                        <div class="flex h-[42px] items-center rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm text-slate-700">@_task.TaskList.Project.Name</div>
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Task list</label>
                        <div class="flex h-[42px] items-center rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm text-slate-700">@_task.TaskList.Name</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_task?.FormattedId))
                    {
                        <div>
                            <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">
                                @if (!string.IsNullOrWhiteSpace(_task?.ExternalTaskId))
                                {
                                    <text>External task ID</text>
                                }
                                else
                                {
                                    <text>Task ID</text>
                                }
                            </label>
                            <div class="flex h-[42px] items-center rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm text-slate-700">@_task?.FormattedId</div>
                        </div>
                    }
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 p-4 mt-3">
                <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Description</label>
                <InputTextArea @bind-Value="_model.Description" class="min-h-[180px] w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 focus:border-blue-500 focus:outline-none" />
                <p class="mt-2 text-sm text-slate-500">aste images or drag files into this form to attach them.</p>
            </div>

            @if (_attachments.Any() || _uploadingAttachments.Any())
            {
                <div class="rounded-2xl border border-slate-200 p-4 mt-3">
                    <label class="mb-3 block text-xs font-medium uppercase tracking-wide text-slate-500">Attachments</label>
                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
                        @foreach (var attachment in _uploadingAttachments)
                        {
                            <div class="relative flex aspect-square items-center justify-center overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
                                <div class="absolute inset-0 flex items-center justify-center bg-white/75">
                                    <LumexSpinner Size="@Size.Medium" />
                                </div>
                                @if (attachment.IsImage)
                                {
                                    <i class="fa-regular fa-image text-3xl text-slate-300"></i>
                                }
                                else
                                {
                                    <div class="flex h-16 w-14 items-center justify-center rounded-lg border border-slate-300 bg-white text-xs font-semibold uppercase text-slate-600">
                                        @attachment.Extension
                                    </div>
                                }
                            </div>
                        }
                        @foreach (var attachment in _attachments)
                        {
                            <div class="group relative aspect-square overflow-hidden rounded-xl border border-slate-200 bg-slate-50 transition hover:border-blue-400 hover:shadow-sm">
                                <a
                                    href="@GetAttachmentUrl(attachment)"
                                    target="_blank"
                                    class="flex h-full w-full items-center justify-center"
                                    title="@attachment.Name">
                                    @if (IsAttachmentPending(attachment) || IsAttachmentDeleting(attachment))
                                    {
                                        <div class="absolute inset-0 z-10 flex items-center justify-center bg-white/75">
                                            <LumexSpinner Size="@Size.Medium" />
                                        </div>
                                    }
                                    @if (IsImageAttachment(attachment) && !IsAttachmentPending(attachment))
                                    {
                                        <img
                                            src="@GetAttachmentPreviewUrl(attachment)"
                                            alt="@attachment.Name"
                                            class="h-full w-full object-cover" />
                                    }
                                    else if (IsImageAttachment(attachment))
                                    {
                                        <i class="fa-regular fa-image text-3xl text-slate-300"></i>
                                    }
                                    else
                                    {
                                        <div class="flex h-16 w-14 items-center justify-center rounded-lg border border-slate-300 bg-white text-xs font-semibold uppercase text-slate-600 group-hover:border-blue-300 group-hover:text-blue-600">
                                            @GetAttachmentExtension(attachment)
                                        </div>
                                    }
                                </a>
                                <button
                                    type="button"
                                    class="absolute right-2 top-2 z-20 inline-flex h-8 w-8 items-center justify-center rounded-full border border-white/80 bg-white/90 text-slate-500 shadow-sm transition hover:bg-red-50 hover:text-red-600 disabled:cursor-not-allowed disabled:opacity-70"
                                    title="Delete attachment"
                                    disabled="@IsAttachmentDeleting(attachment)"
                                    @onclick="@(() => OnDeleteAttachment(attachment))"
                                    @onclick:stopPropagation="true">
                                    @if (IsAttachmentDeleting(attachment))
                                    {
                                        <LumexSpinner Size="@Size.Small" />
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-trash-can text-sm"></i>
                                    }
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }

            @* <div class="rounded-2xl border border-slate-200 p-4"> *@
            @*     <div class="flex items-center gap-6 border-b border-slate-200 pb-3 text-sm"> *@
            @*         <button type="button" class="font-semibold text-slate-900">Comments</button> *@
            @*         <button type="button" class="text-slate-500">Attachments</button> *@
            @*     </div> *@
            @*     <InputTextArea @bind-Value="taskComment" class="mt-4 min-h-[100px] w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 focus:border-blue-500 focus:outline-none" placeholder="Your comment..." /> *@
            @* </div> *@

        </EditForm>
    </div>
}
