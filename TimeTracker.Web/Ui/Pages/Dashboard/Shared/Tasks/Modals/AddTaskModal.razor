@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons

@inherits BaseReactiveComponent

<LumexModal 
    Open="IsOpened" 
    OnClose="@OnCloseModal"
    Size="ModalSize.Large"
    @ref="modal">
    <LumexModalContent>
        <LumexModalHeader Class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                <i class="fa-regular fa-rectangle-list"></i>
            </div>
            <div>
                <h3 class="text-2xl font-medium text-slate-900">Add new task</h3>
                <p class="mt-1 text-sm text-slate-500">Select a task list and fill in Title or External Task ID. You can enter both fields if needed.</p>
            </div>
        </LumexModalHeader>
        <LumexModalBody>
            <EditForm
                Context="form"
                @ref="_form"
                Model="@model"
                OnValidSubmit="@Submit"
                novalidate>
                <DataAnnotationsValidator/>
                <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">Submit</button>

                <div>
                    @* <label class="mb-2 block text-sm font-medium text-slate-700">Task list</label> *@
                    @* <InputSelect @bind-Value="newTaskTaskListId" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 focus:border-blue-500 focus:outline-none"> *@
                    @*     @foreach (var list in CurrentProjectTaskLists) *@
                    @*     { *@
                    @*         <option value="@list.Id">@list.Name</option> *@
                    @*     } *@
                    @* </InputSelect> *@
                    <p class="mt-2 text-xs text-slate-500">Task will be added to: <span class="font-semibold text-slate-700">@TaskList.Name</span></p>
                </div>
                
                <div class="mt-1">
                    <InputTextField
                        FullWidth="true"
                        Label="Title"
                        Placeholder="Task title"
                        Variant="InputVariant.Outlined"
                        @bind-Value="model.Title"/>
                </div>

                <div class="space-y-2 mt-3">
                    <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:gap-4">
                        <InputTextField
                            Class="lg:max-w-sm"
                            Label="External Task ID"
                            Placeholder="For example: JIRA-154 or RM-982"
                            Variant="InputVariant.Outlined"
                            @bind-Value="model.ExternalTaskId"/>
                        <p class="text-xs leading-5 text-slate-500 lg:flex-1">Use this when the task already exists in an external service like Jira, ClickUp, or Redmine.</p>
                    </div>
                </div>

                <div class="rounded-2xl border border-blue-100 bg-blue-50 px-4 py-3 text-sm text-blue-900 mt-3">
                    <div class="font-semibold">Title or External Task ID is required.</div>
                    <p class="mt-1 text-blue-800">You can fill both fields, but at least one of them must be entered.</p>
                </div>
            </EditForm>
        </LumexModalBody>
        <LumexModalFooter>
            <CustomButton
                FullWidth="@true"
                OnClick="@Submit"
                Disabled="_isLoading"
                Color="@ThemeColor.Primary"
                Radius="@Radius.Full">
                Add
            </CustomButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
