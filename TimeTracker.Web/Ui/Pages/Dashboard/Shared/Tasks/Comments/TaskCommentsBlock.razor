@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Tasks.Comments
@using TimeTracker.Api.Shared.Dto.Entity.Task

@inherits BaseReactiveComponent

<EditCommentForm 
    OnSaved="OnCommentSaved"
    Comment="@(new TaskCommentDto { Task = Task })"></EditCommentForm>
@foreach (var comment in _comments)
{
    <EditCommentForm
        @key="comment"
        OnSaved="OnCommentSaved"
        OnDeleted="OnCommentDeleted"
        Comment="@comment"/>
}
@if (_isHasMore)
{
    <div class="d-flex justify-content-center">
        <FluentButton
            IconStart="@(new Icons.Filled.Size24.MoreCircle())"
            Appearance="Appearance.Neutral"
            Disabled="@_isLoading"
            OnClick="@LoadMore"/>
    </div>    
}
