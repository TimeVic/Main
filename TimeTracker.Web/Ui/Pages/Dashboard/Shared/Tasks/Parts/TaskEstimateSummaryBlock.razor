@using LumexUI

@inherits BaseComponent

@if (IsCompact)
{
    <div class="@($"w-full {Class}")">
        <TaskEstimateProgressBlock
            ShowLabels="false"
            HeightClass="h-1.5"
            PlannedDuration="PlannedDuration"
            TrackedDuration="TrackedDuration" />
    </div>
}
else
{
    <div class="@($"bg-transparent p-0 {Class}")">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h4 class="text-sm font-semibold text-slate-900">Estimate progress</h4>
                <p class="mt-1 text-xs text-slate-500">Click the progress bar to view planned and tracked time.</p>
            </div>
        </div>

        @if (ShowProgress)
        {
            <LumexPopover>
                <LumexPopoverTrigger>
                    <button
                        type="button"
                        class="mt-4 block w-full rounded-xl bg-transparent text-left transition focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">
                        <TaskEstimateProgressBlock
                            ShowLabels="false"
                            HeightClass="h-3"
                            PlannedDuration="PlannedDuration"
                            TrackedDuration="TrackedDuration" />
                    </button>
                </LumexPopoverTrigger>
                <LumexPopoverContent>
                    <div class="min-w-[240px] space-y-3 p-3">
                        <div>
                            <p class="text-sm font-semibold text-slate-900">Estimate progress</p>
                            <p class="text-xs text-slate-500">Planned and tracked values from backend.</p>
                        </div>

                        @if (!PlannedDuration.HasValue)
                        {
                            <div class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900">
                                Original estimate is not set for this task yet.
                            </div>
                        }

                        <div class="flex items-center justify-between gap-3 text-xs text-slate-500">
                            <span>Planned</span>
                            <span class="font-medium text-slate-700">@PlannedDurationText</span>
                        </div>
                        <div class="flex items-center justify-between gap-3 text-xs text-slate-500">
                            <span>Tracked</span>
                            <span class="font-medium text-slate-700">@TrackedDurationText</span>
                        </div>
                        <div class="flex items-center justify-between gap-3 text-xs text-slate-500">
                            <span>Status</span>
                            <span class="font-medium @StatusTextClass">@StatusLabel</span>
                        </div>

                        <TaskEstimateProgressBlock
                            PlannedDuration="PlannedDuration"
                            TrackedDuration="TrackedDuration" />
                    </div>
                </LumexPopoverContent>
            </LumexPopover>
        }
    </div>
}
