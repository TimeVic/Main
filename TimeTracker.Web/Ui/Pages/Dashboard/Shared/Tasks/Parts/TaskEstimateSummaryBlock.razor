@inherits BaseComponent

@if (IsCompact)
{
    <div class="@($"w-full {Class}")">
        <p class="text-xs text-slate-500">@CompactSummaryText</p>

        @if (ShowProgress)
        {
            <TaskEstimateProgressBlock
                Class="mt-2"
                ShowLabels="false"
                HeightClass="h-1.5"
                PlannedDuration="PlannedDuration"
                TrackedDuration="TrackedDuration" />
        }
    </div>
}
else
{
    <div class="@($"rounded-2xl border border-slate-200 bg-slate-50/60 p-4 {Class}")">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
            <div>
                <h4 class="text-sm font-semibold text-slate-900">Planned vs tracked</h4>
                <p class="mt-1 text-xs text-slate-500">@SectionDescription</p>
            </div>
            <span class="@($"inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold {StatusBadgeClass}")">
                @StatusLabel
            </span>
        </div>

        <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            <div class="rounded-xl border border-slate-200 bg-white px-3 py-3">
                <p class="text-[11px] font-medium uppercase tracking-wide text-slate-500">Planned</p>
                <p class="mt-1 text-sm font-semibold text-slate-900">@PlannedDurationText</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white px-3 py-3">
                <p class="text-[11px] font-medium uppercase tracking-wide text-slate-500">Tracked</p>
                <p class="mt-1 text-sm font-semibold text-slate-900">@TrackedDurationText</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white px-3 py-3">
                <p class="text-[11px] font-medium uppercase tracking-wide text-slate-500">Remaining / Over by</p>
                <p class="mt-1 text-sm font-semibold @RemainingOrOverTextClass">@RemainingOrOverText</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white px-3 py-3">
                <p class="text-[11px] font-medium uppercase tracking-wide text-slate-500">Delta</p>
                <p class="mt-1 text-sm font-semibold @DeltaTextClass">@DeltaText</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white px-3 py-3">
                <p class="text-[11px] font-medium uppercase tracking-wide text-slate-500">Progress %</p>
                <p class="mt-1 text-sm font-semibold text-slate-900">@ProgressPercentText</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white px-3 py-3">
                <p class="text-[11px] font-medium uppercase tracking-wide text-slate-500">Status</p>
                <p class="mt-1 text-sm font-semibold @StatusTextClass">@StatusLabel</p>
            </div>
        </div>

        @if (ShowProgress)
        {
            <div class="mt-4">
                <p class="text-xs text-slate-500">Progress bar shows tracked time as a share of planned time.</p>
                <TaskEstimateProgressBlock
                    Class="mt-2"
                    ShowLabels="false"
                    HeightClass="h-3"
                    PlannedDuration="PlannedDuration"
                    TrackedDuration="TrackedDuration" />
            </div>
        }
    </div>
}
