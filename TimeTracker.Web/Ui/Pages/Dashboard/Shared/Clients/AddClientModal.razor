@using LumexUI
@using LumexUI.Common
@using TimeTracker.Web.Ui.Shared.Components.Form.Validation

@inherits BaseReactiveComponent

<LumexModal
    Open="IsOpened"
    OnClose="@OnCloseModal"
    Size="ModalSize.Large"
    @ref="modal">
    <LumexModalContent>
        <LumexModalHeader Class="flex items-center gap-3">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                    <i class="fa-solid fa-plus"></i>
                </div>
                <div>
                    <h2 class="mt-2 text-xl font-semibold text-slate-900">Add client</h2>
                    <p class="mt-1 text-sm text-slate-600">Enter the client name.</p>
                </div>
            </div>
        </LumexModalHeader>
        <LumexModalBody>
            <EditForm
                Context="form"
                @ref="_form"
                Model="@model"
                OnSubmit="@SubmitForm"
                novalidate>
                <DataAnnotationsValidator/>
                <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">Submit</button>

                <div class="mt-1">
                    <InputTextField
                        FullWidth="true"
                        Label="Client"
                        Placeholder="Client name"
                        Variant="InputVariant.Outlined"
                        IsShowEmojiButton="true"
                        @bind-Value="model.Name"/>
                    <CustomValidationMessage For="@(() => model.Name)"/>
                </div>

                <CustomValidationSummary/>
            </EditForm>
        </LumexModalBody>
        <LumexModalFooter>
            <CustomButton
                FullWidth="@true"
                OnClick="@Submit"
                IsLoading="_state.Value.IsSaving"
                Color="@ThemeColor.Primary"
                Radius="@Radius.Full">
                Add
            </CustomButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
