@using LumexUI.Common
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared.TimeEntry.Manage
@using TimeTracker.Web.Ui.Pages.Dashboard.TimeEntry.Parts
@inherits BaseReactiveComponent

<div class="w-time-form @Class">
    @if (_isEditModalOpened)
    {
        <EditTimeEntryModal 
            Entry="_activeEntry"
            OnClose="@(() => _isEditModalOpened = false)"/>
    }

    <section class="mx-auto w-full max-w-fit rounded-2xl border border-slate-200 bg-white p-3 shadow-sm xl:justify-self-center">
        <div class="flex flex-col items-stretch gap-2 sm:grid sm:grid-cols-[auto_1fr_auto] sm:items-center sm:gap-3">
            <CustomButton
                OnClick="@(() => ToggleTimeEntry())"
                Variant="Variant.Solid"
                Color="@(_hasActiveEntry ? ThemeColor.Default : ThemeColor.Primary)"
                Disabled="@_state.Value.IsTimeEntryProcessing">
                <StartContent>
                    <i class="fa-solid @(_hasActiveEntry ? "fa-stop" : "fa-play")"></i>
                </StartContent>
                <ChildContent>
                    @(_hasActiveEntry ? "Stop" : "Start")
                </ChildContent>
            </CustomButton>

            <TimeCounterField
                Value="@_activeEntry?.StartTimeOffset"
                IsActive="@_hasActiveEntry"/>

            @if (_activeEntry != null)
            {
                <div class="flex flex-wrap gap-2 sm:justify-self-end">
                    <CustomButton
                        OnClick="@(() => _isEditModalOpened = true)"
                        Variant="Variant.Outlined"
                        Size="Size.Medium"
                        Radius="Radius.Full"
                        Color="ThemeColor.Default">
                        <StartContent>
                            <i class="fa-solid fa-pencil"></i>
                        </StartContent>
                    </CustomButton>
                </div>    
            }
        </div>
    </section>
</div>
