@using LumexUI
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared.LayoutParts
@using TimeTracker.Web.Ui.Shared
@using TimeTracker.Web.Ui.Shared.Components.Dialogs
@using TimeTracker.Web.Ui.Shared.Components.Layout
@inherits TimeTracker.Web.Ui.Shared.BaseLayout

<div class="min-h-screen flex flex-col bg-white text-slate-800">
    @if (CommonState.Value.IsInitialized)
    {
        <InitializationContainer>
            <MainHeader></MainHeader>
            <MainMenu></MainMenu>
            <main class="px-4 py-6 sm:px-6 lg:px-8">
                @Body
            </main>
        </InitializationContainer>
    }
    @if (!IsShowReCaptcha)
    {
        <style>
            .grecaptcha-badge {
                visibility: hidden;
            }
        </style>
    }
    
    <LayoutFooterBlock/>
</div>
<LumexToastProvider RichColors="@true" Id="tv-toaster-rich-colors-id" />
<BaseModalDialogRenderBlock/>
