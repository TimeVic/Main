@using LumexUI.Common
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared.TimeEntry
@inherits BaseReactiveComponent

<section class="border-b border-slate-200 bg-slate-50/80">
    <div class="px-4 py-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between">
            <div class="min-w-0 xl:flex-1">
                <TimeEntryForm />
            </div>
            <nav class="flex flex-wrap gap-2">
                @foreach (var item in _navItems.Where(i => i.GroupName == null).AsQueryable())
                {
                    <CustomButton
                        Color="@(IsMenuItemSelected(item) ? ThemeColor.Primary : ThemeColor.Default)"
                        Variant="@(IsMenuItemSelected(item) ? Variant.Solid : Variant.Outlined)"
                        Size="@Size.Medium"
                        IconOnly="@(string.IsNullOrEmpty(item.Name))"
                        Disabled="@IsMenuItemDisabled(item)"
                        OnClick="@(() => OnMenuItemSelected(item.Url))">
                        <StartContent>
                            <span class="flex items-center gap-2">
                                <i class="@item.Icon"></i>
                            </span>
                        </StartContent>
                        <ChildContent>
                            @item.Name
                        </ChildContent>
                    </CustomButton>
                }
                @{
                    var groupedItems = _navItems.Where(item => item.GroupName != null)
                        .GroupBy(i => i.GroupName)
                        .AsQueryable();
                }
                @if (groupedItems.Any())
                {
                    <LumexDropdown ShowArrow="@true"
                                   Radius="@Radius.Small">
                        <LumexDropdownTrigger>
                            <LumexButton 
                                Variant="@Variant.Outlined"
                                IconOnly="true"
                                Size="@Size.Medium">
                                <StartContent>
                                    <i class="fa fa-arrow-down" aria-hidden="true"></i>
                                </StartContent>
                            </LumexButton>
                        </LumexDropdownTrigger>
                        <LumexDropdownMenu Class="p-3">
                            @foreach (var group in groupedItems.Where(g => string.IsNullOrEmpty(g.Key)))
                            {
                                foreach (var item in group)
                                {
                                    <LumexDropdownItem
                                        Color="@(IsMenuItemSelected(item) ? ThemeColor.Primary : ThemeColor.Default)"
                                        Variant="@(IsMenuItemSelected(item) ? MenuVariant.Solid : MenuVariant.Outlined)"
                                        Disabled="@IsMenuItemDisabled(item)"
                                        OnClick="@(() => OnMenuItemSelected(item.Url))">
                                        <StartContent>
                                            <span class="flex items-center gap-2">
                                                <i class="@item.Icon"></i>
                                            </span>
                                        </StartContent>
                                        <ChildContent>
                                            @item.Name
                                        </ChildContent>
                                    </LumexDropdownItem>
                                }
                            }
                            @foreach (var group in groupedItems.Where(g => !string.IsNullOrEmpty(g.Key)))
                            {
                                <LumexDropdownItem
                                    ShowDivider="true"
                                    Disabled="true">
                                    @group.Key
                                </LumexDropdownItem>
                                foreach (var item in group)
                                {
                                    <LumexDropdownItem
                                        Color="@(IsMenuItemSelected(item) ? ThemeColor.Primary : ThemeColor.Default)"
                                        Variant="@(IsMenuItemSelected(item) ? MenuVariant.Solid : MenuVariant.Outlined)"
                                        Disabled="@IsMenuItemDisabled(item)"
                                        OnClick="@(() => OnMenuItemSelected(item.Url))">
                                        <StartContent>
                                            <span class="flex items-center gap-2">
                                                <i class="@item.Icon"></i>
                                            </span>
                                        </StartContent>
                                        <ChildContent>
                                            @item.Name
                                        </ChildContent>
                                    </LumexDropdownItem>
                                }
                            }
                        </LumexDropdownMenu>
                    </LumexDropdown>
                }
            </nav>
        </div>
    </div>
</section>
