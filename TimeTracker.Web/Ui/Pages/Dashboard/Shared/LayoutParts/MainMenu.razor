@using LumexUI.Common
@inherits BaseReactiveComponent

<section class="border-b border-slate-200 bg-slate-50/80">
    <div class="px-4 py-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-400">Workspace pages</p>
                <p class="mt-1 text-sm text-slate-500">
                    Switch between daily time entries, tasks, chat, payments, and reports. Workspace structure now lives in Settings.
                </p>
            </div>
            <nav class="flex flex-wrap gap-2">
                @foreach (var item in _navItems)
                {
                    <CustomButton
                        Color="@(IsMenuItemSelected(item) ? ThemeColor.Primary : ThemeColor.Default)"
                        Variant="@(IsMenuItemSelected(item) ? Variant.Solid : Variant.Outlined)"
                        OnClick="@(() => OnMenuItemSelected(item.Url))">
                        <StartContent>
                            <span class="flex items-center gap-2">
                                <i class="@item.Icon"></i>
                            </span>
                        </StartContent>
                        <ChildContent>
                            @item.Name
                        </ChildContent>
                    </CustomButton>
                }
