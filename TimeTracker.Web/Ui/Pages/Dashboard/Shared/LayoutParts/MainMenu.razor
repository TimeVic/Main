@using LumexUI.Common
@inherits BaseReactiveComponent

<section class="border-b border-slate-200 bg-slate-50/70">
    <div class="px-4 py-3 sm:px-6 lg:px-8">
        @{
            var primaryItems = _navItems
                .Where(item => item.GroupName == null && !string.IsNullOrEmpty(item.Name))
                .AsQueryable();
            var groupedItems = _navItems
                .Where(item => item.GroupName != null)
                .GroupBy(i => i.GroupName)
                .AsQueryable();
            var settingsItem = _navItems.FirstOrDefault(item => string.IsNullOrEmpty(item.Name));
        }
        <div class="flex flex-col gap-3">
            <div>
                <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Workspace Pages</p>
                <p class="mt-1 text-sm text-slate-500">Switch sections without taking attention away from the timer above.</p>
            </div>

            <div class="flex items-center justify-between gap-3">
                <nav class="flex min-w-0 flex-1 items-center gap-2 overflow-x-auto whitespace-nowrap pb-1">
                @foreach (var item in primaryItems)
                {
                    <CustomButton
                        Color="@(IsMenuItemSelected(item) ? ThemeColor.Primary : ThemeColor.Default)"
                        Variant="@(IsMenuItemSelected(item) ? Variant.Solid : Variant.Outlined)"
                        Size="@Size.Medium"
                        Disabled="@IsMenuItemDisabled(item)"
                        OnClick="@(() => OnMenuItemSelected(item.Url))">
                        <StartContent>
                            <span class="flex items-center gap-2">
                                <i class="@item.Icon"></i>
                            </span>
                        </StartContent>
                        <ChildContent>
                            @item.Name
                        </ChildContent>
                    </CustomButton>
                }
                    @if (groupedItems.Any())
                    {
                        <LumexDropdown ShowArrow="@true"
                                       Radius="@Radius.Small">
                            <LumexDropdownTrigger>
                                <LumexButton
                                    Variant="@Variant.Outlined"
                                    IconOnly="true"
                                    Size="@Size.Medium">
                                    <StartContent>
                                        <i class="fa fa-arrow-down" aria-hidden="true"></i>
                                    </StartContent>
                                </LumexButton>
                            </LumexDropdownTrigger>
                            <LumexDropdownMenu Class="p-3">
                                @foreach (var group in groupedItems.Where(g => string.IsNullOrEmpty(g.Key)))
                                {
                                    foreach (var item in group)
                                    {
                                        <LumexDropdownItem
                                            Color="@(IsMenuItemSelected(item) ? ThemeColor.Primary : ThemeColor.Default)"
                                            Variant="@(IsMenuItemSelected(item) ? MenuVariant.Solid : MenuVariant.Outlined)"
                                            Disabled="@IsMenuItemDisabled(item)"
                                            OnClick="@(() => OnMenuItemSelected(item.Url))">
                                            <StartContent>
                                                <span class="flex items-center gap-2">
                                                    <i class="@item.Icon"></i>
                                                </span>
                                            </StartContent>
                                            <ChildContent>
                                                @item.Name
                                            </ChildContent>
                                        </LumexDropdownItem>
                                    }
                                }
                                @foreach (var group in groupedItems.Where(g => !string.IsNullOrEmpty(g.Key)))
                                {
                                    <LumexDropdownItem
                                        ShowDivider="true"
                                        Disabled="true">
                                        @group.Key
                                    </LumexDropdownItem>
                                    foreach (var item in group)
                                    {
                                        <LumexDropdownItem
                                            Color="@(IsMenuItemSelected(item) ? ThemeColor.Primary : ThemeColor.Default)"
                                            Variant="@(IsMenuItemSelected(item) ? MenuVariant.Solid : MenuVariant.Outlined)"
                                            Disabled="@IsMenuItemDisabled(item)"
                                            OnClick="@(() => OnMenuItemSelected(item.Url))">
                                            <StartContent>
                                                <span class="flex items-center gap-2">
                                                    <i class="@item.Icon"></i>
                                                </span>
                                            </StartContent>
                                            <ChildContent>
                                                @item.Name
                                            </ChildContent>
                                        </LumexDropdownItem>
                                    }
                                }
                            </LumexDropdownMenu>
                        </LumexDropdown>
                    }
                </nav>

                @if (settingsItem != null)
                {
                    <div class="shrink-0">
                        <CustomButton
                            Color="@(IsMenuItemSelected(settingsItem) ? ThemeColor.Primary : ThemeColor.Default)"
                            Variant="@(IsMenuItemSelected(settingsItem) ? Variant.Solid : Variant.Outlined)"
                            Size="@Size.Medium"
                            IconOnly="true"
                            Disabled="@IsMenuItemDisabled(settingsItem)"
                            OnClick="@(() => OnMenuItemSelected(settingsItem.Url))">
                            <StartContent>
                                <span class="flex items-center gap-2">
                                    <i class="@settingsItem.Icon"></i>
                                </span>
                            </StartContent>
                        </CustomButton>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
