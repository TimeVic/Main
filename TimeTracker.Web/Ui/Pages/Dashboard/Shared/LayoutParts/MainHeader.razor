@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons
@using TimeTracker.Business.Extensions
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared.TimeEntry
@using TimeTracker.Web.Ui.Pages.Dashboard.Workspace.Components
@using TimeTracker.Web.Ui.Shared.Components.Layout
@inherits BaseReactiveComponent

<AddWorkspaceModal
    IsOpened="_isShowAddWorkspaceModal"
    IsOpenedChanged="@((isOpened) => _isShowAddWorkspaceModal = isOpened)"/>

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
    <div class="px-4 py-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-4">
            <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between xl:gap-6">
                <div class="min-w-0">
                    <AppLogoBlock
                        Eyebrow="@DashboardLocalizer["TimeWorkspace"]"
                    />
                    <p class="mt-2 max-w-2xl text-sm text-slate-500">
                        @DashboardLocalizer["TimeWorkspaceDescription"]
                    </p>
                </div>

                <div class="min-w-0 xl:min-w-[220px] xl:max-w-[260px] xl:shrink-0">
                    <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">@DashboardLocalizer["Workspace"]</label>
                    <div class="flex items-center gap-2">
                        @{
                            var lastWorkspace = WorkspaceState.Value.List.LastOrDefault();
                        }
                        <LumexDropdown>
                            <LumexDropdownTrigger>
                                <LumexButton Variant="@Variant.Outlined">
                                    @AuthState.Value.Workspace?.Name
                                </LumexButton>
                            </LumexDropdownTrigger>
                            <LumexDropdownMenu>
                                @foreach (var workspace in WorkspaceState.Value.List)
                                {
                                    <LumexDropdownItem
                                        ShowDivider="@(workspace == lastWorkspace)"
                                        Description="@(workspace.Id == AuthState.Value.Workspace?.Id ? DashboardLocalizer["CurrentWorkspace"].Value : null)"
                                        OnClick="@(() => OnSelectWorkspace(workspace))">
                                        @workspace.Name
                                    </LumexDropdownItem>
                                }
                                <LumexDropdownItem
                                    Color="ThemeColor.Info"
                                    OnClick="@(() => _isShowAddWorkspaceModal = true)">
                                    <StartContent>
                                        <SquarePlusIcon Size="18" class="text-default-500 shrink-0"/>
                                    </StartContent>
                                    <ChildContent>@DashboardLocalizer["NewWorkspace"]</ChildContent>
                                </LumexDropdownItem>
                            </LumexDropdownMenu>
                        </LumexDropdown>

                        <LumexDropdown
                            ShowArrow="@true"
                            Radius="@Radius.Small">
                            <LumexDropdownTrigger>
                                <LumexAvatar
                                    @key="UserAvatarKey"
                                    Name="@AuthState.Value.User.Initials"
                                    Src="@UserAvatarSrc"/>
                            </LumexDropdownTrigger>
                            <LumexDropdownMenu Class="p-3">
                                <LumexDropdownItem
                                    Disabled="@true"
                                    Class="h-14 gap-2 opacity-100">
                                    <div class="flex items-center gap-2">
                                        <LumexAvatar Size="@Size.Small"
                                                     @key="UserAvatarKey"
                                                     Name="@AuthState.Value.User.Initials"
                                                     Src="@UserAvatarSrc"/>
                                        <div class="inline-flex flex-col items-start">
                                            <span class="text-small text-default-600">@AuthState.Value.User?.Name</span>
                                            <span class="text-tiny text-default-500">@AuthState.Value.User?.Email</span>
                                        </div>
                                    </div>
                                </LumexDropdownItem>
                                <LumexDropdownItem
                                    ShowDivider="@true"
                                    Disabled="true">
                                    @_currentTime.ToString("yyyy-MM-dd HH:mm:ss zzz");
                                </LumexDropdownItem>
                                <LumexDropdownItem OnClick="@OnNavigateToUserSettings">
                                    @DashboardLocalizer["Settings"]
                                </LumexDropdownItem>
                                <LumexDropdownItem Disabled="true">@DashboardLocalizer["HelpSupport"]</LumexDropdownItem>
                                <LumexDropdownItem
                                    ShowDivider="true"
                                    Disabled="true">
                                    @DashboardLocalizer["Language"]: @DashboardLocalizer[CurrentLanguageKey]
                                </LumexDropdownItem>
                                <LumexDropdownItem OnClick="@(() => OnSelectLanguage(TimeTracker.Web.Services.ILocalizationUrlService.EnglishCultureName))">
                                    <span class="inline-flex items-center gap-2">
                                        <span aria-hidden="true">🇺🇸</span>
                                        <span>@DashboardLocalizer["English"]</span>
                                    </span>
                                </LumexDropdownItem>
                                <LumexDropdownItem OnClick="@(() => OnSelectLanguage(TimeTracker.Web.Services.ILocalizationUrlService.UkrainianCultureName))">
                                    <span class="inline-flex items-center gap-2">
                                        <span aria-hidden="true">🇺🇦</span>
                                        <span>@DashboardLocalizer["Ukrainian"]</span>
                                    </span>
                                </LumexDropdownItem>
                                <LumexDropdownItem OnClick="@OnClickLogout">
                                    <ChildContent>
                                        @DashboardLocalizer["LogOut"]
                                    </ChildContent>
                                    <EndContent>
                                        <LogoutIcon Size="16"/>
                                    </EndContent>
                                </LumexDropdownItem>
                            </LumexDropdownMenu>
                        </LumexDropdown>
                    </div>
                </div>
            </div>

            <TimeEntryForm />
        </div>
    </div>
</header>
