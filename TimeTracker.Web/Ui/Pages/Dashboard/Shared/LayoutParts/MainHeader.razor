@using LumexUI
@using LumexUI.Common
@inherits BaseReactiveComponent

<header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
    <div class="px-4 py-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-4 md:grid md:grid-cols-[minmax(0,1fr)_auto_minmax(220px,260px)] md:items-center md:gap-6">
            <div class="min-w-0">
                <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 text-white shadow-sm">
                        <i class="fa-regular fa-clock text-lg"></i>
                    </div>
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-blue-600">Time workspace</p>
                        <h1 class="text-2xl font-semibold text-slate-900">TimeVic</h1>
                    </div>
                </div>
                <p class="mt-2 max-w-xl text-sm text-slate-500">
                    Track time in the workspace and use the task-list panel when you want to browse a specific project.
                </p>
            </div>

            <div class="md:justify-self-center">
                @* @if (CenterContent is not null) *@
                @* { *@
                @*     @CenterContent *@
                @* } *@
            </div>

            <div class="min-w-0 md:min-w-[220px] md:max-w-[260px] md:justify-self-end">
                <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Workspace</label>
                <div class="flex items-center gap-2">
                    <LumexDropdown>
                        <LumexDropdownTrigger>
                            <LumexButton Variant="@Variant.Outlined">
                                @AuthState.Value.Workspace?.Name
                            </LumexButton>
                        </LumexDropdownTrigger>
                        <LumexDropdownMenu>
                            @foreach(var workspace in WorkspaceState.Value.List)
                            {
                                <LumexDropdownItem @OnClick="@(() => OnSelectWorkspace(workspace))">
                                    @workspace.Name
                                </LumexDropdownItem>
                            }
                            @* <LumexDropdownItem Color="@ThemeColor.Danger" Class="text-danger"> *@
                            @*     Delete file *@
                            @* </LumexDropdownItem> *@
                        </LumexDropdownMenu>
                    </LumexDropdown>
                    
                    @* @if (ShowWorkspaceSettingsButton && OnWorkspaceSettings.HasDelegate) *@
                    @* { *@
                    @*     <button type="button" title="Workspace settings" @onclick="OnWorkspaceSettings" class="inline-flex h-[42px] w-[42px] items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900"> *@
                    @*         <i class="fa-solid fa-sliders"></i> *@
                    @*     </button> *@
                    @* } *@

                    <div class="relative">
                        <button type="button" 
                                class="flex h-[42px] w-[42px] items-center justify-center rounded-full border border-slate-200 bg-gradient-to-br from-blue-600 to-indigo-600 text-xs font-semibold uppercase tracking-wide text-white shadow-sm transition hover:scale-[1.02] hover:shadow-md" 
                                title="Open profile menu"
                                >
                            @AuthState.Value.User.Initials
                        </button>

                        @* @if (isProfileMenuOpen) *@
                        @* { *@
                        @*     <div class="absolute right-0 top-14 z-30 w-64 rounded-3xl border border-slate-200 bg-white p-4 shadow-xl"> *@
                        @*         <div class="flex items-center gap-3"> *@
                        @*             <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-900 text-sm font-semibold uppercase tracking-wide text-white"> *@
                        @*                 @UserInitials *@
                        @*             </div> *@
                        @*             <div class="min-w-0"> *@
                        @*                 <p class="truncate text-sm font-semibold text-slate-900">@AuthStateStore.UserName</p> *@
                        @*                 <p class="truncate text-xs text-slate-500">@AuthStateStore.UserEmail</p> *@
                        @*             </div> *@
                        @*         </div> *@
                        @*         <button type="button" @onclick="Logout" class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-2.5 text-sm font-semibold text-rose-700 transition hover:border-rose-300 hover:bg-rose-100"> *@
                        @*             <i class="fa-solid fa-right-from-bracket"></i> *@
                        @*             <span>Log out</span> *@
                        @*         </button> *@
                        @*     </div> *@
                        @* } *@
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
