
@inherits BaseReactiveComponent

<MudDialog>
    <DialogContent>
        <MudForm
            @ref="_form"
            @bind-IsValid="_isValid">

            <MudStack>
                <FluentTextField
                    T="string?"
                    For="() => model.Name"
                    @bind-Value="@(model.Name)"
                    Label="Tag name">
                </FluentTextField>

                <MudColorPicker
                    Label="Color"
                    Clearable="true"
                    ColorPickerView="ColorPickerView.Palette"
                    @bind-Value="@(_mudColor)"/>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@OnCloseModal">Cancel</MudButton>
        <MudButton
            ButtonType="MudBlazor.ButtonType.Submit"
            OnClick="@Submit"
            Disabled="@_isLoading"
            Color="Color.Primary">
            Update
        </MudButton>
    </DialogActions>
</MudDialog>
