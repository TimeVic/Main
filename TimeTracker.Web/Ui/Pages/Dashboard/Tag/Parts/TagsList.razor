@inherits BaseReactiveComponent

@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants

<MudTable
    Class="mt-2 w-100"
    Items="@_state.Value.List"
    Hover="true"
    Dense="true"
    Outlined="true"
    Breakpoint="Breakpoint.Sm"
    Loading="@_state.Value.IsListLoading"
    LoadingProgressColor="Color.Info">

    <ToolBarContent>
        <MudText Typo="Typo.h6">@DashboardLocalizer["Tags"]</MudText>
        <MudSpacer/>
        <MudButton
            OnClick="@OnAdd"
            Disabled="@(!AuthState.Value.IsRoleAdmin)"
            StartIcon="@Icons.Material.Filled.Add">
            @DashboardLocalizer["Add"]
        </MudButton>
    </ToolBarContent>

    <HeaderContent>
        <MudTh>@DashboardLocalizer["Name"]</MudTh>
        <MudTh>@DashboardLocalizer["Color"]</MudTh>
        <MudTh></MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="@DashboardLocalizer["Name"]">@context?.Name</MudTd>
        <MudTd DataLabel="@DashboardLocalizer["Color"]">
            <MudColorPicker
                Disabled="true"
                ColorPickerView="ColorPickerView.Palette"
                Value="@GetMudColor(context.Color)"/>
        </MudTd>
        <MudTd DataLabel="@DashboardLocalizer["Actions"]">
            <MudIconButton
                OnClick="@(() => OnEdit(context))"
                Icon="@Icons.Material.Filled.Edit"
                Disabled="@(!AuthState.Value.IsRoleAdmin)"
                Size="Size.Small"/>
            <MudIconButton
                OnClick="@(() => OnDelete(context))"
                Icon="@Icons.Material.Filled.Delete"
                Disabled="@(!AuthState.Value.IsRoleAdmin)"
                Color="Color.Error"
                Size="Size.Small"/>
        </MudTd>
    </RowTemplate>
</MudTable>
