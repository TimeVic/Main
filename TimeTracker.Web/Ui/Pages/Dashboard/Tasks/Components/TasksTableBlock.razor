@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity.Task
@using TimeTracker.Business.Extensions
@using TimeTracker.Web.Constants.Ui
@using TimeTracker.Web.Core.Extensions.Enums
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared.Tasks.Parts
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;
@using TaskPriority = TimeTracker.Business.Common.Constants.Task.TaskPriority;

@inherits BaseReactiveComponent

@if (_taskToUpdate != null)
{
    <TimeTracker.Web.Ui.Pages.Dashboard.Shared.Tasks.Modals.UpdateTaskModal
        IsOpened="true"
        Task="_taskToUpdate"
        OnClose="@(() => _taskToUpdate = null)"
    />
}

@if (_localTasks.Any())
{
    <div class="flex items-center justify-between px-4 py-3 border-b border-slate-200">
        <div class="flex items-center gap-2">
            <LumexCheckbox
                OnClick="@SelectAllTasks"
                Value="@(_selectedTaskIds.Any() && _selectedTaskIds.Count == _localTasks.Count)"
                ValueChanged="@(SelectAllTasks)"/>
            <span class="text-sm text-slate-600">@string.Format(DashboardLocalizer["TasksTableBlock_SelectedCount"].Value, _selectedTaskIds.Count)</span>
        </div>
        @if (_selectedTaskIds.Count > 0)
        {
            <div class="flex items-center gap-2">
                <CustomButton
                    Color="ThemeColor.Warning"
                    Variant="Variant.Light"
                    Size="Size.Small"
                    OnClick="@(() => OnSetArchivedSelectedTasks(true))">
                    <StartContent>
                        <i class="fa-solid fa-box-archive text-xs"></i>
                    </StartContent>
                    <ChildContent>@DashboardLocalizer["Archive"]</ChildContent>
                </CustomButton>
                <CustomButton
                    Color="ThemeColor.Success"
                    Variant="Variant.Light"
                    Size="Size.Small"
                    OnClick="@(() => OnSetArchivedSelectedTasks(false))">
                    <StartContent>
                        <i class="fa-solid fa-rotate-left text-xs"></i>
                    </StartContent>
                    <ChildContent>@DashboardLocalizer["Restore"]</ChildContent>
                </CustomButton>
            </div>
        }
    </div>
}

<div class="overflow-x-auto">
    <table class="min-w-full border-separate border-spacing-0">
        <thead class="bg-slate-50/80 sticky top-0 z-10">
            <tr class="text-left text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">
                <th class="w-14 px-4 py-3"></th>
                <th class="min-w-[360px] px-2 py-3">@DashboardLocalizer["Task"]</th>
                <th class="px-2 py-3 text-center">@DashboardLocalizer["Status"]</th>
                <th class="px-2 py-3 text-center">@DashboardLocalizer["Priority"]</th>
                <th class="px-2 py-3">@DashboardLocalizer["Assignee"]</th>
                <th class="px-4 py-3 text-right">@DashboardLocalizer["Actions"]</th>
            </tr>
        </thead>
        <tbody class="text-sm">
            @if (IsLoading)
            {
                <TasksTableSkeletonBlock/>
            }
            else if (_localTasks.Any())
            {
                <Virtualize Items="_localTasks" ItemSize="60" SpacerElement="tr" OverscanCount="5" Context="task">
                    @if (IsDropTarget(task))
                    {
                        <tr class="pointer-events-none">
                            <td colspan="6" class="p-0">
                                <div class="h-0.5 bg-blue-500 rounded-full mx-2 shadow-sm shadow-blue-300"></div>
                            </td>
                        </tr>
                    }
                    <tr class="@GetTaskBoardRowClass(task.Id) @GetDragRowClass(task) transition-colors"
                        draggable="true"
                        @ondragstart="@(() => OnDragStart(task))"
                        @ondragover:preventDefault="true"
                        @ondragover="@(() => OnDragOver(task))"
                        @ondrop="@(() => OnDrop(task))"
                        @ondragend="@OnDragEnd">
                        <td class="border-t border-slate-200 px-4 py-3 align-top">
                            <div class="flex flex-col items-center gap-2">
                                <LumexCheckbox
                                    Value="IsTaskBoardSelected(task.Id)"
                                    ValueChanged="@(() => ToggleTaskBoardSelection(task.Id))"/>
                            </div>
                        </td>
                        <td class="border-t border-slate-200 px-2 py-3 align-top">
                            <div class="flex gap-3">
                                <div class="flex-1 min-w-0 space-y-2">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="rounded-md bg-slate-100 px-2 py-1 text-[11px] font-bold uppercase tracking-wide text-slate-600">@task.FormattedId</span>
                                        <button type="button" @onclick="@(() => OpenTaskEditor(task))" class="text-left font-semibold cursor-pointer text-slate-900 transition group-hover:text-blue-700 hover:text-blue-700 @GetTaskTitleClass(task)">
                                            @task.Title
                                        </button>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(task.Description))
                                    {
                                        <p class="max-w-2xl text-sm text-slate-500">@task.Description</p>
                                    }
                                    <TaskEstimateSummaryBlock
                                        Class="mt-2"
                                        IsCompact="true"
                                        PlannedDuration="task.OriginalEstimate"
                                        TrackedDuration="task.TrackedDuration" />
                                </div>
                            </div>
                        </td>
                        <td class="border-t border-slate-200 px-2 py-3 align-top">
                            <EnumDropDown
                                TItem="TaskStatus"
                                DropDownColor="@task.Status.GetThemeColor()"
                                DropDownVariant="Variant.Solid"
                                SelectType="DropDownType.DropDown"
                                Size="Size.Small"
                                Value="@task.Status"
                                ValueChanged="(value) => OnChangeStatusTask(task, value)"/>
                        </td>
                        <td class="border-t border-slate-200 px-2 py-3 align-top">
                            <EnumDropDown
                                TItem="TaskPriority"
                                DropDownColor="@task.Priority.GetThemeColor()"
                                DropDownVariant="Variant.Solid"
                                SelectType="DropDownType.DropDown"
                                Size="Size.Small"
                                Value="@task.Priority"
                                ValueChanged="(value) => OnChangePriorityTask(task, value)"/>
                        </td>
                        <td class="border-t border-slate-200 px-2 py-3 align-top">
                            <div class="flex items-center gap-3">
                                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-semibold uppercase text-white">@(task.User?.Initials ?? "?")</span>
                                <div class="min-w-0">
                                    <div class="truncate text-sm font-medium text-slate-800">@(task.User?.Name ?? "")</div>
                                    <div class="truncate text-xs text-slate-500">@(task.User?.Email ?? DashboardLocalizer["NoAssignee"].Value)</div>
                                </div>
                            </div>
                        </td>
                        <td class="border-t border-slate-200 px-4 py-3 align-top text-right">
                            <div class="flex items-center justify-end gap-2">
                                @if (TimeEntryState.Value.ActiveEntry?.Task?.Id == task.Id)
                                {
                                    <CustomButton
                                        Variant="Variant.Outlined"
                                        Color="ThemeColor.Default"
                                        IconOnly="true"
                                        Size="Size.Small"
                                        Disabled="_isDisabledButtons"
                                        OnClick="@(() => StopTimeEntry())">
                                        <StartContent>
                                            <i class="fa-solid fa-stop text-xs"></i>
                                        </StartContent>
                                    </CustomButton>
                                }
                                else
                                {
                                    <CustomButton
                                        Variant="Variant.Outlined"
                                        Color="ThemeColor.Info"
                                        IconOnly="true"
                                        Size="Size.Small"
                                        Disabled="_isDisabledButtons"
                                        OnClick="@(() => StartTimeEntry(task))">
                                        <StartContent>
                                            <i class="fa-solid fa-play text-xs"></i>
                                        </StartContent>
                                    </CustomButton>
                                }
                                <LumexDropdown>
                                    <LumexDropdownTrigger>
                                        <LumexButton
                                            Class="ml-1"
                                            IconOnly="true"
                                            Size="Size.Small"
                                            Disabled="_isDisabledButtons"
                                            Variant="@Variant.Outlined">
                                            <i class="fa-solid fa-ellipsis-h"></i>
                                        </LumexButton>
                                    </LumexDropdownTrigger>
                                    <LumexDropdownMenu>
                                        <LumexDropdownItem
                                            Color="@ThemeColor.Warning"
                                            OnClick="@(() => OnArchiveTask(task))">
                                            @DashboardLocalizer["TasksTableBlock_ArchiveThisTask"]
                                        </LumexDropdownItem>
                                    </LumexDropdownMenu>
                                </LumexDropdown>
                            </div>
                        </td>
                    </tr>
                </Virtualize>
            }
            else
            {
                <tr>
                    <td colspan="6" class="px-4 py-8 text-center text-sm text-slate-500">@(string.IsNullOrWhiteSpace(EmptyMessage) ? DashboardLocalizer["TasksTableBlock_NoTasksFound"] : EmptyMessage)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
