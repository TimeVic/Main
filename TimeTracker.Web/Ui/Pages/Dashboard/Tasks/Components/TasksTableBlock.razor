@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity.Task
@using TimeTracker.Business.Extensions
@using TimeTracker.Web.Constants.Ui
@using TimeTracker.Web.Core.Extensions.Enums
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;
@using TaskPriority = TimeTracker.Business.Common.Constants.Task.TaskPriority;

@inherits BaseReactiveComponent

@if (_taskToUpdate != null)
{
    <TimeTracker.Web.Ui.Pages.Dashboard.Shared.Tasks.Modals.UpdateTaskModal
        IsOpened="true"
        Task="_taskToUpdate"
        OnClose="@(() => _taskToUpdate = null)"
    />
}

@if (Tasks.Any())
{
    <div class="flex justify-start px-4 py-3 border-b border-slate-200">
        <CustomButton 
            OnClick="@SelectAllTasks" 
            Variant="Variant.Light"
            Size="Size.Small"
            Color="ThemeColor.Info">
            <StartContent>
                <i class="fa-regular fa-square-check"></i>    
            </StartContent>
            <ChildContent>Select visible</ChildContent>
        </CustomButton>
    </div>
}

<div class="overflow-x-auto">
    <table class="min-w-full border-separate border-spacing-0">
        <thead class="bg-slate-50/80">
            <tr class="text-left text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">
                <th class="w-14 px-4 py-3"></th>
                <th class="min-w-[360px] px-2 py-3">Issue</th>
                <th class="px-2 py-3 text-center">Status</th>
                <th class="px-2 py-3 text-center">Priority</th>
                <th class="px-2 py-3">Assignee</th>
                <th class="px-4 py-3 text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="text-sm">
            @if (Tasks.Any())
            {
                @foreach (var task in Tasks)
                {
                    <tr class="@GetTaskBoardRowClass(task.Id)">
                        <td class="border-t border-slate-200 px-4 py-3 align-top">
                            <button type="button" @onclick="@(() => ToggleTaskBoardSelection(task.Id))" class="@($"inline-flex h-8 w-8 items-center justify-center rounded-lg border transition cursor-pointer {(IsTaskBoardSelected(task.Id) ? "border-blue-300 bg-blue-100 text-blue-700" : "border-slate-200 bg-white text-slate-500 hover:border-slate-300 hover:bg-slate-50")}")">
                                <i class="@($"fa-solid {(IsTaskBoardSelected(task.Id) ? "fa-check" : "fa-plus")}")"></i>
                            </button>
                        </td>
                        <td class="border-t border-slate-200 px-2 py-3 align-top">
                            <div class="flex gap-3">
                                <div class="min-w-0 space-y-2">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="rounded-md bg-slate-100 px-2 py-1 text-[11px] font-bold uppercase tracking-wide text-slate-600">@task.FormattedId</span>
                                        <button type="button" @onclick="@(() => OpenTaskEditor(task))" class="text-left font-semibold cursor-pointer text-slate-900 transition group-hover:text-blue-700 hover:text-blue-700 @GetTaskTitleClass(task)">
                                            @task.Title
                                        </button>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(task.Description))
                                    {
                                        <p class="max-w-2xl text-sm text-slate-500">@task.Description</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(task.ExternalTaskId))
                                    {
                                        <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
                                            <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-1">
                                                <i class="fa-solid fa-link"></i>
                                                Synced
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="border-t border-slate-200 px-2 py-3 align-top">
                            <EnumDropDown
                                TItem="TaskStatus"
                                DropDownColor="@task.Status.GetThemeColor()"
                                DropDownVariant="Variant.Light"
                                SelectType="DropDownType.DropDown"
                                Size="Size.Small"
                                Value="@task.Status"
                                ValueChanged="(value) => OnChangeStatusTask(task, value)"/>
                        </td>
                        <td class="border-t border-slate-200 px-2 py-3 align-top">
                            <EnumDropDown
                                TItem="TaskPriority"
                                DropDownColor="@task.Priority.GetThemeColor()"
                                DropDownVariant="Variant.Light"
                                SelectType="DropDownType.DropDown"
                                Size="Size.Small"
                                Value="@task.Priority"
                                ValueChanged="(value) => OnChangePriorityTask(task, value)"/>
                        </td>
                        <td class="border-t border-slate-200 px-2 py-3 align-top">
                            <div class="flex items-center gap-3">
                                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-semibold uppercase text-white">@(task.User?.Initials ?? "?")</span>
                                <div class="min-w-0">
                                    <div class="truncate text-sm font-medium text-slate-800">@(task.User?.Name ?? "")</div>
                                    <div class="truncate text-xs text-slate-500">@(task.User?.Email ?? "No assignee")</div>
                                </div>
                            </div>
                        </td>
                        <td class="border-t border-slate-200 px-4 py-3 align-top text-right">
                            <div class="flex items-center justify-end gap-2">
                                @if (TimeEntryState.Value.ActiveEntry?.Task?.Id == task.Id)
                                {
                                    <CustomButton
                                        Variant="Variant.Outlined"
                                        Color="ThemeColor.Default"
                                        IconOnly="true"
                                        Size="Size.Small"
                                        Disabled="_isDisabledButtons"
                                        OnClick="@(() => StopTimeEntry())">
                                        <StartContent>
                                            <i class="fa-solid fa-stop text-xs"></i>
                                        </StartContent>
                                    </CustomButton>
                                }
                                else
                                {
                                    <CustomButton
                                        Variant="Variant.Outlined"
                                        Color="ThemeColor.Info"
                                        IconOnly="true"
                                        Size="Size.Small"
                                        Disabled="_isDisabledButtons"
                                        OnClick="@(() => StartTimeEntry(task))">
                                        <StartContent>
                                            <i class="fa-solid fa-play text-xs"></i>
                                        </StartContent>
                                    </CustomButton>
                                }
                                <LumexDropdown>
                                    <LumexDropdownTrigger>
                                        <LumexButton
                                            Class="ml-1"
                                            IconOnly="true"
                                            Size="Size.Small"
                                            Disabled="_isDisabledButtons"
                                            Variant="@Variant.Outlined">
                                            <i class="fa-solid fa-ellipsis-h"></i>
                                        </LumexButton>
                                    </LumexDropdownTrigger>
                                    <LumexDropdownMenu>
                                        <LumexDropdownItem
                                            Color="@ThemeColor.Warning"
                                            OnClick="@(() => OnArchiveTask(task))">
                                            Archive this task
                                        </LumexDropdownItem>
                                    </LumexDropdownMenu>
                                </LumexDropdown>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="px-4 py-8 text-center text-sm text-slate-500">@EmptyMessage</td>
                </tr>
            }
        </tbody>
    </table>
</div>
