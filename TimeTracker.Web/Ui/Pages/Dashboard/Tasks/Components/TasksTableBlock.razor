@using LumexUI
@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity.Task
@using TimeTracker.Business.Extensions
@using TimeTracker.Web.Core.Extensions.Enums
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;
@using TaskPriority = TimeTracker.Business.Common.Constants.Task.TaskPriority;

@inherits BaseReactiveComponent

@if (_taskToUpdate != null)
{
    <TimeTracker.Web.Ui.Pages.Dashboard.Shared.Tasks.Modals.UpdateTaskModal
        IsOpened="true"
        Task="_taskToUpdate"
        OnClose="@(() => _taskToUpdate = null)"
    />
}

<LumexDataGrid
    T="TaskDto"
    Class="min-w-full divide-y divide-slate-200"
    Data="@_tasks.AsQueryable()"
    Hoverable="true"
    OnRowClick="@OnRowClickHandler"
    Loading="_isLoading">
    <LumexUI.PropertyColumn Title="#" Property="@(p => p.FormattedId)"/>
    <LumexUI.PropertyColumn Title="Task" Property="@(p => p.Title)" Sortable="@true">
        <Content>
            <div class="font-medium text-slate-900 @GetTaskTitleClass(context)">
                @context.Title
            </div>
            <div class="mt-1 max-w-xl text-slate-500">@context.Description?.TruncateAndAddDots(100)</div>
        </Content>
    </LumexUI.PropertyColumn>
    <LumexUI.PropertyColumn 
        Title="Status"
        Property="@(p => p.Status)"
        Sortable="@true">
        <Content>
            @{
                <LumexChip
                    Size="@Size.Small"
                    Variant="@ChipVariant.Dot"
                    Color="@context.Status.GetThemeColor()">
                    @context.Status.GetDisplayName()
                </LumexChip>
            }
        </Content>
    </LumexUI.PropertyColumn>
    <LumexUI.PropertyColumn 
        Property="@(p => p.Priority)"
        Sortable="@true">
        <Content>
            @{
                <LumexChip
                    Size="@Size.Small"
                    Variant="@ChipVariant.Dot"
                    Color="@context.Priority.GetThemeColor()">
                    @context.Priority.GetDisplayName()
                </LumexChip>
            }
        </Content>
    </LumexUI.PropertyColumn>
    <LumexUI.PropertyColumn 
        Title="Assigned" 
        Property="@(p => p.User.Name)"
        Sortable="@true"/>
    <LumexUI.PropertyColumn
        Title="Actions"
        Property="@(p => p.User.Id)">
        <Content>
            <div @onclick:stopPropagation="true">
                @if (TimeEntryState.Value.ActiveEntry?.Task?.Id == context.Id)
                {
                    <CustomButton
                        Variant="Variant.Outlined"
                        Color="ThemeColor.Default"
                        IconOnly="true"
                        Size="Size.Small"
                        Disabled="_isDisabledButtons"
                        OnClick="@(() => StopTimeEntry())">
                        <StartContent>
                            <i class="fa-solid fa-stop text-xs"></i>
                        </StartContent>
                    </CustomButton>
                }
                else
                {
                    <CustomButton
                        Variant="Variant.Outlined"
                        Color="ThemeColor.Info"
                        IconOnly="true"
                        Size="Size.Small"
                        Disabled="_isDisabledButtons"
                        OnClick="@(() => StartTimeEntry(context))">
                        <StartContent>
                            <i class="fa-solid fa-play text-xs"></i>
                        </StartContent>
                    </CustomButton>
                }
                <LumexDropdown>
                    <LumexDropdownTrigger>
                        <LumexButton
                            Class="ml-1"
                            IconOnly="true"
                            Size="Size.Small"
                            Disabled="_isDisabledButtons"
                            Variant="@Variant.Outlined">
                            <i class="fa-solid fa-ellipsis-h"></i>
                        </LumexButton>
                    </LumexDropdownTrigger>
                    <LumexDropdownMenu>
                        <LumexDropdownItem
                            Color="@ThemeColor.Warning"
                            OnClick="@(() => OnArchiveTask(context))">
                            Archive this task
                        </LumexDropdownItem>
                    </LumexDropdownMenu>
                </LumexDropdown>
            </div>
        </Content>
    </LumexUI.PropertyColumn>
</LumexDataGrid>
