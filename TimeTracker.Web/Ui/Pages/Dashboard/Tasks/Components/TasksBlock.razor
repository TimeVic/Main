@using LumexUI
@using LumexUI.Common
@using TimeTracker.Business.Extensions
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared.Tasks
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared.Tasks.Modals
@using TimeTracker.Web.Ui.Shared.Components.Dialogs
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;
@using TaskPriority = TimeTracker.Business.Common.Constants.Task.TaskPriority;

@inherits BaseReactiveComponent

<section class="space-y-6">
    
    @if (_taskList != null)
    {
        <AddTaskModal @bind-IsOpened="_isShowAddTaskModal" TaskList="@_taskList"></AddTaskModal>
        <UpdateTaskListModal @bind-IsOpened="_isShowUpdateTaskListModal" TaskList="@_taskList"></UpdateTaskListModal>
    }
    @if (_isShowDeleteTaskListConfirmation)
    {
        <ConfirmationModal 
            Title="Delete task list"
            Subtitle="Are you sure you want to delete this task list?"
            OnClose="() => _isShowDeleteTaskListConfirmation = false"
            OnConfirm="OnDeleteTaskList"
        />
    }
    
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-sm font-semibold text-slate-900">@_taskList?.Name</p>
                <p class="mt-1 text-sm text-slate-500">Tasks are optional and mainly used for tracking time.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                @if (_taskList != null)
                {
                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">@_taskList.Project.Name</span>
                }

                <CustomButton
                    Variant="Variant.Outlined"
                    Color="ThemeColor.Info"
                    Disabled="@(_taskList == null)"
                    OnClick="@(() => _isShowAddTaskModal = true)">
                    <StartContent>
                        <i class="fa-solid fa-plus"></i>
                    </StartContent>
                    <ChildContent>Add task</ChildContent>
                </CustomButton>
                <LumexDropdown>
                    <LumexDropdownTrigger>
                        <LumexButton
                            IconOnly="true"
                            Size="Size.Small"
                            Variant="@Variant.Outlined">
                            <i class="fa-solid fa-ellipsis-h"></i>
                        </LumexButton>
                    </LumexDropdownTrigger>
                    <LumexDropdownMenu>
                        <LumexDropdownItem 
                            Disabled="_taskList == null"
                            OnClick="@OnEditTaskList">
                            Edit task list
                        </LumexDropdownItem>
                        <LumexDropdownItem 
                            OnClick="() => _isShowDeleteTaskListConfirmation = true"
                            Disabled="_taskList == null"
                            Color="@ThemeColor.Danger" 
                            Class="text-danger">
                            Delete task list
                        </LumexDropdownItem>
                    </LumexDropdownMenu>
                </LumexDropdown>
            </div>
        </div>

        <TasksBoardBlock></TasksBoardBlock>
    </div>
</section>
