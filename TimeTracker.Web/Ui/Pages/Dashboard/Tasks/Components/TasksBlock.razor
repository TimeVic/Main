@using LumexUI
@using LumexUI.Common
@using Microsoft.FluentUI.AspNetCore.Components.Extensions
@using TimeTracker.Business.Extensions
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;
@using TaskPriority = TimeTracker.Business.Common.Constants.Task.TaskPriority;

@inherits BaseReactiveComponent

<section class="space-y-6">
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-sm font-semibold text-slate-900">Tasks in progress</p>
                <p class="text-sm text-slate-500">Selected list: @_taskList?.Name</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">@_taskList?.Project.Name</span>
                
                <CustomButton
                    Variant="Variant.Outlined"
                    Color="ThemeColor.Info"
                    OnClick="@OnAddTask"
                >
                    <StartContent>
                        <i class="fa-solid fa-plus"></i>
                    </StartContent>
                    <ChildContent>Add task</ChildContent>
                </CustomButton>
            </div>
        </div>

        <div class="mt-5 flex flex-col gap-5">
            <LumexDataGrid 
                Data="@_tasks.AsQueryable()" 
                Loading="_isLoading"
            >
                <LumexUI.PropertyColumn Title="Task" Property="@(p => p.Title)">
                    <Content>
                        <div class="font-medium text-slate-900">@context.Title</div>
                        <div class="mt-1 max-w-xl text-slate-500">@context.Description?.TruncateAndAddDots(100)</div>
                    </Content>
                </LumexUI.PropertyColumn>
                <LumexUI.PropertyColumn Title="Status" Property="@(p => p.Status)">
                    <Content>
                        <EnumDropDown
                            Label="Status"
                            TItem="TaskStatus"
                            AllowClear="false"
                            Size="Size.Small"
                            Value="context.Status"
                            ValueChanged="@(status => OnStatusChanged(context, status))"
                            Name="Status"/>
                    </Content>
                </LumexUI.PropertyColumn>
                <LumexUI.PropertyColumn Property="@(p => p.Priority)">
                    <Content>
                        @{
                            <LumexChip 
                                Size="@Size.Small"
                                Variant="@ChipVariant.Dot"
                                Color="ThemeColor.Primary">
                                @context.Priority.GetDescription()
                            </LumexChip>
                        }
                    </Content>
                </LumexUI.PropertyColumn>
                <LumexUI.PropertyColumn Title="Assigned" Property="@(p => p.User.UserName)"/>
                <LumexUI.PropertyColumn Title="Actions" Property="@(p => p.User.Id)">
                    <Content>
                        <CustomButton
                            Variant="Variant.Outlined"
                            Color="ThemeColor.Info"
                            IconOnly="true"
                            Size="Size.Small"
                            OnClick="@(() => OnStartNewTimeEntryForTask(context))">
                            <StartContent>
                                <i class="fa-solid fa-play text-xs"></i>
                            </StartContent>
                        </CustomButton>
                        <CustomButton
                            Variant="Variant.Outlined"
                            Color="ThemeColor.Info"
                            IconOnly="true"
                            Size="Size.Small"
                            OnClick="@(() => OnEditTask(context))">
                            <ChildContent>
                                <i class="fa-solid fa-pencil text-xs"></i>
                            </ChildContent>
                        </CustomButton>
                    </Content>
                </LumexUI.PropertyColumn>
            </LumexDataGrid>
            
