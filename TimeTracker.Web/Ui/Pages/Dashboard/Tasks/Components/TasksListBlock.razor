@using LumexUI
@using LumexUI.Common
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared.Tasks.Modals
@using TimeTracker.Web.Ui.Pages.Dashboard.Tasks.Parts.TasksList
@using TimeTracker.Web.Ui.Shared.Components.Dialogs
@inherits BaseReactiveComponent

<aside>
    <AddTasksListModalForm 
        Project="_selectedProject"
        OnAdded="@OnTasksListAdded"
        @bind-IsOpened="_isAddTaskListModalOpened"/>

    @if (_selectedTaskList != null)
    {
        <UpdateTaskListModal
            @bind-IsOpened="_isShowUpdateTaskListModal"
            TaskList="@_selectedTaskList"/>
    }

    @if (_isShowDeleteTaskListConfirmation)
    {
        <ConfirmationModal
            Title="@DashboardLocalizer["TasksBlock_DeleteTaskListTitle"].Value"
            Subtitle="@DashboardLocalizer["TasksBlock_DeleteTaskListSubtitle"].Value"
            OnClose="@(() => _isShowDeleteTaskListConfirmation = false)"
            OnConfirm="@OnDeleteTaskList"/>
    }
    
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <div class="flex items-center justify-between gap-3">
            <div>
                <p class="text-sm font-semibold text-slate-900">@DashboardLocalizer["TasksListBlock_Title"]</p>
                <p class="text-xs text-slate-500">@DashboardLocalizer["TasksListBlock_Description"]</p>
            </div>
            <LumexDropdown>
                <LumexDropdownTrigger>
                    <LumexButton
                        IconOnly="true"
                        Size="Size.Small"
                        Variant="@Variant.Outlined">
                        <i class="fa-solid fa-ellipsis-h"></i>
                    </LumexButton>
                </LumexDropdownTrigger>
                <LumexDropdownMenu>
                    <LumexDropdownItem
                        Disabled="@(_selectedProject == null)"
                        OnClick="@(() => _isAddTaskListModalOpened = true)">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-plus w-4 text-xs"></i>
                            @DashboardLocalizer["AddTasksListModalForm_Title"]
                        </span>
                    </LumexDropdownItem>
                    <LumexDropdownItem
                        Disabled="@(_selectedTaskList == null)"
                        OnClick="@OnEditTaskList">
                        @DashboardLocalizer["TasksBlock_EditTaskList"]
                    </LumexDropdownItem>
                    <LumexDropdownItem
                        OnClick="@(() => _isShowDeleteTaskListConfirmation = true)"
                        Disabled="@(_selectedTaskList == null)"
                        Color="@ThemeColor.Danger"
                        Class="text-danger">
                        @DashboardLocalizer["TasksBlock_DeleteTaskListTitle"]
                    </LumexDropdownItem>
                </LumexDropdownMenu>
            </LumexDropdown>
        </div>

        <div class="mt-4 space-y-3">
            <div>
                <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">@DashboardLocalizer["Project"]</label>
                <ProjectsDropDown
                    Value="@(_selectedProject?.Id ?? Guid.Empty)"
                    FullWidth="false"
                    IsGroupByClient="true"
                    SelectedItemChanged="OnSelectedProject">
                </ProjectsDropDown>
                @* <p class="mt-1 text-xs text-slate-500">Grouped by client; projects without a client appear under “No client”.</p> *@
            </div>

            <div class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2">
                <InputTextField
                    @bind-Value="_taskListSearch"
                    Placeholder="@DashboardLocalizer["TasksListBlock_SearchPlaceholder"].Value"
                    FullWidth="true"
                    Size="Size.Small"
                    Clearable="true"
                    Variant="InputVariant.Underlined"
                    Color="ThemeColor.Default">
                    <StartContent>
                        <i class="fa-solid fa-magnifying-glass text-xs text-slate-400"></i>
                    </StartContent>
                </InputTextField>
            </div>

            <div class="space-y-2">
                @foreach (var taskList in _filteredTaskLists)
                {
                    <button type="button" @onclick="@(() => OnTasksListSelected(taskList.Id))" class="@GetTaskListClass(taskList)">
                        <span>
                            <span class="block font-medium text-slate-800">@taskList.Name</span>
                            <span class="text-xs text-slate-500">
                                @GetTasksCountText(taskList)
                            </span>
                        </span>
                        <i class="fa-solid fa-chevron-right text-xs text-slate-400"></i>
                    </button>
                }

                @if (!_filteredTaskLists.Any())
                {
                    <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 p-3 text-sm text-slate-600">
                        @if (_selectedProject == null)
                        {
                            <text>@DashboardLocalizer["TasksListBlock_SelectProjectEmpty"]</text>
                        }
                        else if (!string.IsNullOrWhiteSpace(_taskListSearch))
                        {
                            <text>@string.Format(DashboardLocalizer["TasksListBlock_NoMatches"].Value, _taskListSearch)</text>
                        }
                        else
                        {
                            <div class="space-y-3">
                                <p>@DashboardLocalizer["TasksListBlock_ListIsEmpty"]</p>
                                <CustomButton
                                    FullWidth="true"
                                    Color="ThemeColor.Info"
                                    Variant="Variant.Outlined"
                                    OnClick="@(() => _isAddTaskListModalOpened = true)">
                                    <StartContent>
                                        <i class="fa-solid fa-plus"></i>
                                    </StartContent>
                                    <ChildContent>
                                        @DashboardLocalizer["AddTasksListModalForm_Title"]
                                    </ChildContent>
                                </CustomButton>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</aside>
