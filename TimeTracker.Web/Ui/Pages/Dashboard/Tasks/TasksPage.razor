@page "/board/tasks/{TaskListId:guid}"
@page "/board/tasks"
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared.LayoutParts
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared
@using TimeTracker.Web.Ui.Pages.Dashboard.Tasks.Components

@inherits BaseComponent
@layout Layout

<BodyLayout Title="Tasks">
    <CascadingValue Name="TaskListId" Value="@TaskListId">
        <FluentStack Orientation="Orientation.Vertical">
            <section class="grid gap-6 lg:grid-cols-[280px_minmax(0,1fr)]">
                <TasksListBlock></TasksListBlock>
                <TasksBlock></TasksBlock>
            </section>
        </FluentStack>
    </CascadingValue>
</BodyLayout>
