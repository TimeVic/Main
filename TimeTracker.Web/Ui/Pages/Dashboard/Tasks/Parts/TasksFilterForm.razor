@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Tasks
@using Microsoft.AspNetCore.Components

@inherits BaseReactiveComponent

<FluentStack 
    Orientation="Orientation.Horizontal" 
    HorizontalAlignment="HorizontalAlignment.Start" 
    VerticalAlignment="VerticalAlignment.Center"
    Class="pa-2">
    
    <FluentTextField
        Value="@Filter.SearchString"
        ValueChanged="OnChangeSearchString"
        Placeholder="Write anything"/>
    
    <MembersDropDown
        Clearable="true"
        UserId="@(Filter.AssignedUserId ?? Guid.Empty)"
        SelectedItemChanged="OnChangeAssignedUser"/>

    <FluentCheckbox
        Label="Only archived"
        ThreeState="true"
        CheckStateChanged="OnChangeIsArchived"
        CheckState="@Filter.IsArchived"/>

</FluentStack>

