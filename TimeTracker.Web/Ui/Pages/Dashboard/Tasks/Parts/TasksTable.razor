@using TimeTracker.Api.Shared.Dto.Entity.Task
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;

@inherits BaseComponent

<FluentStack Orientation="Orientation.Vertical" Class="p-2">
    <FluentStack Orientation="Orientation.Vertical">
        <TasksGrid Statuses="@( [TaskStatus.ToDo, TaskStatus.InProgress, TaskStatus.Done])"></TasksGrid>
        <TasksGrid Statuses="@( [TaskStatus.Backlog])"></TasksGrid>
    </FluentStack>
</FluentStack>
