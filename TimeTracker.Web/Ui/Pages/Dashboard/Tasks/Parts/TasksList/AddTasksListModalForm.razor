@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons

@inherits BaseReactiveComponent

<LumexModal Open="IsOpened" OnClose="@OnCloseModal" @ref="modal">
    <LumexModalContent>
        <LumexModalHeader Class="flex items-center gap-3">
            <div class="size-10 flex items-center justify-center bg-default-100 rounded-full">
                <i class="fa-solid fa-plus text-xl"></i>
            </div>
            Add task list
        </LumexModalHeader>
        <LumexModalBody>
            <EditForm
                Context="form"
                @ref="_form"
                Model="@model"
                OnValidSubmit="@Submit"
                novalidate>
                <DataAnnotationsValidator/>
                <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">Submit</button>

                <div class="space-y-6">
                    <div class="rounded-2xl border border-blue-100 bg-blue-50/70 px-4 py-3">
                        <p class="text-xs font-medium uppercase tracking-[0.18em] text-blue-600">Project</p>
                        <p class="mt-1 text-sm font-semibold text-slate-900">@Project?.Name</p>
                    </div>

                    <div>
                        <InputTextField
                            FullWidth="true"
                            Label="Name"
                            @bind-Value="model.Name"
                            Placeholder="Enter list name"/>
                    </div>
                </div>
            </EditForm>
        </LumexModalBody>
        <LumexModalFooter>
            <CustomButton
                FullWidth="@true"
                OnClick="@Submit"
                Color="@ThemeColor.Primary"
                Radius="@Radius.Full">
                Add
            </CustomButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
