@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons

@inherits BaseReactiveComponent

<LumexModal Open="IsOpened">
    <LumexModalContent>
        <LumexModalHeader Class="flex-col gap-3">
            <div class="size-10 flex items-center justify-center bg-default-100 rounded-full">
                <PlusIcon Size="20" />
            </div>
            Add task list
        </LumexModalHeader>
        <LumexModalBody>
            <EditForm
                Context="form"
                @ref="_form"
                Model="@model"
                novalidate>
                <DataAnnotationsValidator/>
                <FluentValidationSummary/>

                <div class="mb-2">
                    <ProjectsDropDown
                        FullWidth="true"
                        Label="Project"
                        Value="@(model.ProjectId)"
                        SelectedItemChanged="@(item => model.ProjectId = item?.Id ?? Guid.Empty)"/>
                </div>

                <div>
                    <InputTextField
                        Class="w-100"
                        Label="Name"
                        @bind-Value="model.Name"
                        Placeholder="Enter list name"/>
                </div>
            </EditForm>
        </LumexModalBody>
        <LumexModalFooter>
            <CustomButton
                FullWidth="@true"
                Color="@ThemeColor.Primary"
                Radius="@Radius.Full">
                Add
            </CustomButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
