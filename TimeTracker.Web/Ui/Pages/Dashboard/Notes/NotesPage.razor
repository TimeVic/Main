@page "/dashboard/notes"
@page "/board/notes"
@using LumexUI.Common
@using TimeTracker.Web.Ui.Pages.Dashboard.Notes.Components
@using TimeTracker.Web.Ui.Pages.Dashboard.Notes.Components.Modals
@using TimeTracker.Web.Ui.Shared.Components.Dialogs
@using Layout = TimeTracker.Web.Ui.Pages.Dashboard.Shared.Layout

@inherits BaseReactiveComponent
@layout Layout

<SeoHead
    Title="@($"TimeVic - {DashboardLocalizer["Notes"]}")"
    Robots="@SiteMetadata.NoIndexRobots" />

<CreateFolderModal
    IsOpened="_isCreateFolderModalOpened"
    IsSaving="_isCreatingNode"
    ParentId="_activeParentId"
    IsOpenedChanged="@OnCreateFolderModalChanged"
    OnSubmit="@CreateFolder"/>

<CreateNoteModal
    IsOpened="_isCreateNoteModalOpened"
    IsSaving="_isCreatingNode"
    ParentId="_activeParentId"
    IsOpenedChanged="@OnCreateNoteModalChanged"
    OnSubmit="@CreateDocument"/>

<RenameNoteNodeModal
    IsOpened="@(_nodeToRename != null)"
    IsSaving="_isRenamingNode"
    Node="_nodeToRename"
    IsOpenedChanged="@OnRenameModalChanged"
    OnSubmit="@RenameNode"/>

@if (_nodeToArchive != null)
{
    <ConfirmationModal
        Title="@DashboardLocalizer["Notes_ArchiveConfirmTitle"].Value"
        Subtitle="@DashboardLocalizer["Notes_ArchiveConfirmSubtitle"].Value"
        ConfirmText="@DashboardLocalizer["Archive"].Value"
        OnClose="@(() => _nodeToArchive = null)"
        OnCancel="@(() => _nodeToArchive = null)"
        OnConfirm="@ArchiveNode"/>
}

<section class="space-y-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">@DashboardLocalizer["Notes"]</h1>
            <p class="mt-1 text-sm text-slate-500">@DashboardLocalizer["Notes_PageSubtitle"]</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <CustomButton
                Variant="Variant.Outlined"
                Color="ThemeColor.Default"
                OnClick="@(() => OpenCreateFolderModal(null))">
                <StartContent>
                    <i class="fa-regular fa-folder"></i>
                </StartContent>
                <ChildContent>@DashboardLocalizer["NewFolder"]</ChildContent>
            </CustomButton>
            <CustomButton
                Color="ThemeColor.Primary"
                OnClick="@(() => OpenCreateNoteModal(null))">
                <StartContent>
                    <i class="fa-solid fa-plus"></i>
                </StartContent>
                <ChildContent>@DashboardLocalizer["NewNote"]</ChildContent>
            </CustomButton>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_treeError))
    {
        <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            @_treeError
        </div>
    }

    <div class="grid gap-5 xl:grid-cols-[320px_minmax(0,1fr)]">
        <NotesTreeBlock
            TreeNodes="@_treeNodes"
            ExpandedNodeIds="@_expandedNodeIds"
            SelectedNoteId="@_selectedNoteId"
            IsLoading="_loadingTree"
            ToggleExpandedRequested="@ToggleExpanded"
            SelectNodeRequested="@SelectDocument"
            CreateFolderRequested="@OpenCreateFolderModal"
            CreateNoteRequested="@OpenCreateNoteModal"
            RenameRequested="@OpenRenameModal"
            ArchiveRequested="@OpenArchiveConfirmation"/>

        <div class="space-y-5">
            <NoteEditorBlock
                Document="@_currentDocument"
                Title="@_editorTitle"
                MarkdownContent="@_editorMarkdown"
                Visibility="@_editorVisibility"
                IsLoading="_loadingDocument"
                IsSaving="_savingDocument"
                IsDirty="@IsDocumentDirty"
                SaveStateLabel="@SaveStateLabel"
                SaveStateClass="@SaveStateClass"
                TitleChanged="@OnTitleChanged"
                MarkdownContentChanged="@OnMarkdownChanged"
                VisibilityChanged="@OnVisibilityChanged"
                OnSave="@SaveDocument"/>

            <NoteMetadataPanelBlock Document="@_currentDocument"/>
        </div>
    </div>
</section>
