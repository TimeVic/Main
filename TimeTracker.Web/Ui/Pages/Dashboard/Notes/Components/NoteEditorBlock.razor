@using LumexUI.Common
@using TimeTracker.Business.Common.Constants.Notes
@using TimeTracker.Web.Constants.Ui
@using TimeTracker.Web.Services.UI

@inject MarkdownService MarkdownService

@inherits BaseReactiveComponent

<section class="min-h-[720px] rounded-2xl border border-slate-200 bg-white shadow-sm">
    @if (IsLoading)
    {
        <div>
            <div class="border-b border-slate-200 p-4">
                <div class="flex flex-col gap-3 xl:flex-row xl:items-start xl:justify-between">
                    <LumexSkeleton Class="h-12 min-w-0 flex-1 rounded-xl"/>
                    <div class="flex shrink-0 items-center gap-2">
                        <LumexSkeleton Class="h-8 w-24 rounded-full"/>
                        <LumexSkeleton Class="h-8 w-28 rounded-full"/>
                    </div>
                </div>
            </div>
            <div class="space-y-5 p-4">
                <div>
                    <div class="mb-2 flex items-center justify-between gap-2">
                        <LumexSkeleton Class="h-4 w-24 rounded-full"/>
                        <LumexSkeleton Class="h-6 w-28 rounded-full"/>
                    </div>
                    <LumexSkeleton Class="h-[340px] w-full rounded-xl"/>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50">
                    <div class="border-b border-slate-200 px-4 py-3">
                        <LumexSkeleton Class="h-4 w-24 rounded-full"/>
                    </div>
                    <div class="p-4">
                        <LumexSkeleton Class="h-[220px] w-full rounded-xl"/>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Document == null)
    {
        <div class="flex min-h-[360px] items-center justify-center p-6 text-center">
            <div>
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-500">
                    <i class="fa-regular fa-note-sticky"></i>
                </div>
                <p class="mt-4 text-sm font-medium text-slate-700">@DashboardLocalizer["Notes_NoSelectedNote"]</p>
            </div>
        </div>
    }
    else
    {
        <div class="border-b border-slate-200 p-4">
            <div class="flex flex-col gap-3 xl:flex-row xl:items-start xl:justify-between">
                <div class="min-w-0 flex-1">
                    <input
                        class="w-full rounded-xl border border-slate-200 px-4 py-3 text-lg font-semibold text-slate-900 outline-none transition focus:border-blue-500"
                        maxlength="200"
                        value="@Title"
                        placeholder="@DashboardLocalizer["Title"].Value"
                        @oninput="@OnTitleInput"/>
                </div>
                <div class="flex shrink-0 flex-wrap items-center gap-2">
                    <EnumDropDown
                        TItem="NoteVisibility"
                        SelectType="@DropDownType.DropDown"
                        Size="Size.Small"
                        Value="@Visibility"
                        ValueChanged="@OnVisibilityChanged"/>
                    <CustomButton
                        Size="Size.Small"
                        Color="@ThemeColor.Primary"
                        Radius="@Radius.Full"
                        IsLoading="IsSaving"
                        Disabled="@(!IsDirty)"
                        OnClick="@OnSave">
                        <StartContent>
                            <i class="fa-regular fa-floppy-disk"></i>
                        </StartContent>
                        <ChildContent>@DashboardLocalizer["Save"]</ChildContent>
                    </CustomButton>
                </div>
            </div>
        </div>
        <div class="space-y-5 p-4">
            <div>
                <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                    <label class="block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">@DashboardLocalizer["Markdown"]</label>
                    <span class="@SaveStateClass">@SaveStateLabel</span>
                </div>
                <textarea
                    class="min-h-[340px] w-full resize-y rounded-xl border border-slate-200 bg-white px-4 py-3 font-mono text-sm leading-6 text-slate-800 outline-none transition focus:border-blue-500"
                    maxlength="5000000"
                    value="@MarkdownContent"
                    placeholder="@DashboardLocalizer["Notes_MarkdownPlaceholder"].Value"
                    @oninput="@OnMarkdownInput"></textarea>
            </div>

            <div class="rounded-xl border border-slate-200 bg-slate-50">
                <div class="border-b border-slate-200 px-4 py-3">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">@DashboardLocalizer["Preview"]</p>
                </div>
                <div class="prose prose-sm min-h-[220px] max-w-none p-4 text-slate-700">
                    @if (string.IsNullOrWhiteSpace(MarkdownContent))
                    {
                        <p class="text-sm text-slate-400">@DashboardLocalizer["Notes_EmptyPreview"]</p>
                    }
                    else
                    {
                        @((MarkupString)MarkdownService.ToHtml(MarkdownContent))
                    }
                </div>
            </div>
        </div>
    }
</section>
