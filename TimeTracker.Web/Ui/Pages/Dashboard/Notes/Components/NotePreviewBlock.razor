@using TimeTracker.Web.Services.UI

@inject MarkdownService MarkdownService

<section class="min-h-[720px] rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 p-4">
        <p class="text-sm font-semibold text-slate-900">@DashboardLocalizer["Preview"]</p>
        <p class="text-xs text-slate-500">@DashboardLocalizer["Notes_PreviewDescription"]</p>
    </div>
    <div class="max-w-none p-4 text-slate-700">
        @if (IsLoading)
        {
            <LumexSkeleton Class="h-[340px] w-full rounded-xl"/>
        }
        else if (string.IsNullOrWhiteSpace(MarkdownContent))
        {
            <p class="text-sm text-slate-400">@DashboardLocalizer["Notes_EmptyPreview"]</p>
        }
        else
        {
            @((MarkupString)MarkdownService.ToHtml(MarkdownContent))
        }
    </div>
</section>

@code {
    [Parameter]
    public string MarkdownContent { get; set; } = string.Empty;

    [Parameter]
    public bool IsLoading { get; set; }
}
