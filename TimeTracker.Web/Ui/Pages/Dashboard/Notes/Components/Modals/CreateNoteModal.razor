@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Notes
@using TimeTracker.Business.Common.Constants.Notes
@using TimeTracker.Web.Ui.Shared.Components.Form.Validation

@inherits BaseReactiveComponent

<LumexModal Open="IsOpened" OnClose="@OnCloseModal" Size="ModalSize.Small" @ref="_modal">
    <LumexModalContent>
        <LumexModalHeader Class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                <i class="fa-regular fa-note-sticky"></i>
            </div>
            <div>
                <h2 class="text-xl font-semibold text-slate-900">@DashboardLocalizer["CreateNote"]</h2>
                <p class="mt-1 text-sm text-slate-600">@DashboardLocalizer["Notes_CreateNoteDescription"]</p>
            </div>
        </LumexModalHeader>
        <LumexModalBody>
            <EditForm Context="form" @ref="_form" Model="@_model" OnSubmit="@SubmitForm" novalidate>
                <DataAnnotationsValidator/>
                <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">@DashboardLocalizer["Submit"]</button>
                <div class="grid gap-4">
                    <div>
                        <InputTextField
                            FullWidth="true"
                            Label="@DashboardLocalizer["Title"].Value"
                            Placeholder="@DashboardLocalizer["Notes_NoteTitlePlaceholder"].Value"
                            @bind-Value="_model.Title"/>
                        <CustomValidationMessage For="@(() => _model.Title)"/>
                    </div>
                    <EnumDropDown
                        TItem="NoteVisibility"
                        FullWidth="true"
                        Label="@DashboardLocalizer["Visibility"].Value"
                        Value="@_model.Visibility"
                        ValueChanged="@OnVisibilityChanged"/>
                    <CustomValidationSummary/>
                </div>
            </EditForm>
        </LumexModalBody>
        <LumexModalFooter>
            <CustomButton
                FullWidth="true"
                Color="@ThemeColor.Primary"
                Radius="@Radius.Full"
                IsLoading="IsSaving"
                OnClick="@Submit">
                @DashboardLocalizer["CreateNote"]
            </CustomButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
