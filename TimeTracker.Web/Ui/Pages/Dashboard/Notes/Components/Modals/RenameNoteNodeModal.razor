@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity.Notes
@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Notes
@using TimeTracker.Web.Ui.Shared.Components.Form.Validation

@inherits BaseReactiveComponent

<LumexModal Open="IsOpened" OnClose="@OnCloseModal" Size="ModalSize.Small" @ref="_modal">
    <LumexModalContent>
        <LumexModalHeader Class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 text-slate-700">
                <i class="fa-solid fa-pen"></i>
            </div>
            <div>
                <h2 class="text-xl font-semibold text-slate-900">@DashboardLocalizer["Rename"]</h2>
                <p class="mt-1 text-sm text-slate-600">@DashboardLocalizer["Notes_RenameDescription"]</p>
            </div>
        </LumexModalHeader>
        <LumexModalBody>
            <EditForm Context="form" @ref="_form" Model="@_model" OnSubmit="@SubmitForm" novalidate>
                <DataAnnotationsValidator/>
                <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">@DashboardLocalizer["Submit"]</button>
                <InputTextField
                    FullWidth="true"
                    Label="@DashboardLocalizer["Title"].Value"
                    Placeholder="@DashboardLocalizer["Title"].Value"
                    @bind-Value="_model.Title"/>
                <CustomValidationMessage For="@(() => _model.Title)"/>
                <CustomValidationSummary/>
            </EditForm>
        </LumexModalBody>
        <LumexModalFooter>
            <CustomButton
                FullWidth="true"
                Color="@ThemeColor.Primary"
                Radius="@Radius.Full"
                IsLoading="IsSaving"
                OnClick="@Submit">
                @DashboardLocalizer["Rename"]
            </CustomButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
