@using TimeTracker.Api.Shared.Dto.Entity.Notes

<section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 p-4">
        <p class="text-sm font-semibold text-slate-900">@DashboardLocalizer["LinkedEntities"]</p>
        <p class="text-xs text-slate-500">@DashboardLocalizer["Notes_MetadataDescription"]</p>
    </div>
    <div class="space-y-4 p-4 text-sm">
        @if (Document == null)
        {
            <p class="text-slate-400">@DashboardLocalizer["Notes_NoMetadata"]</p>
        }
        else
        {
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">@DashboardLocalizer["Visibility"]</p>
                <p class="mt-1 text-slate-700">@DashboardLocalizer[$"NoteVisibility_{Document.Visibility}"]</p>
            </div>
            @if (Document.UpdatedAt.HasValue)
            {
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">@DashboardLocalizer["Updated"]</p>
                    <p class="mt-1 text-slate-700">@Document.UpdatedAt.Value.ToString("g")</p>
                </div>
            }
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">@DashboardLocalizer["LinkedEntities"]</p>
                @if (Document.Links.Any())
                {
                    <div class="mt-2 space-y-2">
                        @foreach (var link in Document.Links)
                        {
                            <div class="rounded-xl border border-slate-200 px-3 py-2">
                                <p class="font-medium text-slate-800">@GetLinkTitle(link)</p>
                                <p class="text-xs text-slate-500">@DashboardLocalizer[$"NoteLinkEntityType_{link.EntityType}"]</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="mt-1 text-slate-400">@DashboardLocalizer["Notes_NoLinkedEntities"]</p>
                }
            </div>
        }
    </div>
</section>

@code {
    [Parameter]
    public NoteDocumentDto? Document { get; set; }

    private string GetLinkTitle(NoteLinkDto link)
    {
        return string.IsNullOrWhiteSpace(link.DisplayName)
            ? link.EntityId.ToString()
            : link.DisplayName;
    }
}
