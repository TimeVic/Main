@using LumexUI.Common
@using TimeTracker.Business.Common.Constants.Notes

@inherits BaseReactiveComponent

<div>
    <div class="@RowClass" style="@IndentStyle">
        <button
            type="button"
            class="flex h-5 w-5 shrink-0 items-center justify-center rounded-md text-slate-400 hover:bg-slate-100"
            disabled="@(!IsFolder)"
            @onclick="@OnToggleExpanded">
            @if (IsFolder)
            {
                <i class="fa-solid @(IsExpanded ? "fa-chevron-down" : "fa-chevron-right") text-[10px]"></i>
            }
        </button>
        <button type="button" class="flex min-w-0 flex-1 items-center gap-2 text-left" @onclick="@OnSelect">
            <i class="@IconClass"></i>
            <span class="truncate">@TreeNode.Node.Title</span>
        </button>
        <LumexDropdown>
            <LumexDropdownTrigger>
                <LumexButton IconOnly="true" Size="Size.Small" Variant="@Variant.Light">
                    <i class="fa-solid fa-ellipsis-h"></i>
                </LumexButton>
            </LumexDropdownTrigger>
            <LumexDropdownMenu>
                @if (IsFolder)
                {
                    <LumexDropdownItem OnClick="@(() => CreateFolderRequested.InvokeAsync(TreeNode.Node.Id))">
                        <span class="flex items-center gap-2">
                            <i class="fa-regular fa-folder w-4 text-xs"></i>
                            @DashboardLocalizer["NewFolder"]
                        </span>
                    </LumexDropdownItem>
                    <LumexDropdownItem OnClick="@(() => CreateNoteRequested.InvokeAsync(TreeNode.Node.Id))">
                        <span class="flex items-center gap-2">
                            <i class="fa-regular fa-note-sticky w-4 text-xs"></i>
                            @DashboardLocalizer["NewNote"]
                        </span>
                    </LumexDropdownItem>
                }
                <LumexDropdownItem OnClick="@(() => RenameRequested.InvokeAsync(TreeNode.Node))">
                    @DashboardLocalizer["Rename"]
                </LumexDropdownItem>
                <LumexDropdownItem Color="@ThemeColor.Danger" OnClick="@(() => ArchiveRequested.InvokeAsync(TreeNode.Node))">
                    @DashboardLocalizer["Archive"]
                </LumexDropdownItem>
            </LumexDropdownMenu>
        </LumexDropdown>
    </div>

    @if (IsFolder && IsExpanded)
    {
        @if (TreeNode.Children.Any())
        {
            @foreach (var child in TreeNode.Children)
            {
                <NotesTreeNodeBlock
                    @key="child.Node.Id"
                    TreeNode="@child"
                    Level="@(Level + 1)"
                    ExpandedNodeIds="@ExpandedNodeIds"
                    SelectedNoteId="@SelectedNoteId"
                    ToggleExpandedRequested="@ToggleExpandedRequested"
                    SelectNodeRequested="@SelectNodeRequested"
                    CreateFolderRequested="@CreateFolderRequested"
                    CreateNoteRequested="@CreateNoteRequested"
                    RenameRequested="@RenameRequested"
                    ArchiveRequested="@ArchiveRequested"/>
            }
        }
        else
        {
            <div class="py-2 text-xs text-slate-400" style="@ChildEmptyIndentStyle">
                @DashboardLocalizer["Notes_EmptyFolder"]
            </div>
        }
    }
</div>
