@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Web.Ui.Pages.Dashboard.ClientPayments.Parts.Modals
@using TimeTracker.Web.Ui.Shared.Components
@using TimeTracker.Web.Ui.Shared.Components.Dialogs

@inherits BaseReactiveComponent

@if (_paymentToView != null)
{
    <ViewClientPaymentModal
        ClientPayment="_paymentToView"
        IsOpened="true"
        IsOpenedChanged="isOpened => _paymentToView = isOpened ? _paymentToView : null"/>
}

@if (_paymentToUpdate != null)
{
    <UpdateClientPaymentModal
        ClientPayment="_paymentToUpdate"
        IsOpened="true"
        IsOpenedChanged="isOpened => _paymentToUpdate = isOpened ? _paymentToUpdate : null"/>
}

@if (_paymentToDelete != null)
{
    <ConfirmationModal
        OnClose="@(() => _paymentToDelete = null)"
        OnConfirm="OnDeleteClientPayment"/>
}

<LumexDataGrid
    T="ClientPaymentDto"
    Class="min-w-full divide-y divide-slate-200"
    Data="@Items.AsQueryable()"
    Hoverable="true"
    Loading="_isLoading">
    <LumexUI.PropertyColumn Title="Date" Property="@(p => p.PaymentTime)">
        <Content>
            <span class="text-sm text-slate-700">@context.PaymentTime.ToShortDateString()</span>
        </Content>
    </LumexUI.PropertyColumn>
    <LumexUI.PropertyColumn Title="Client" Property="@(p => p.Client.Name)">
        <Content>
            <div class="font-medium text-slate-900">@context.Client?.Name</div>
        </Content>
    </LumexUI.PropertyColumn>
    <LumexUI.PropertyColumn Title="Project" Property="@(p => p.Project)">
        <Content>
            @if (context.Project != null)
            {
                <span class="text-sm text-slate-700">@context.Project.Name</span>
            }
            else
            {
                <span class="text-sm text-slate-400">No project</span>
            }
        </Content>
    </LumexUI.PropertyColumn>
    <LumexUI.PropertyColumn
        Title="Amount"
        Property="@(p => p.Amount)"
        Sortable="@true">
        <Content>
            <span class="font-semibold text-emerald-700">
                <AmountDisplay Amount="@context.Amount"></AmountDisplay>
            </span>
        </Content>
    </LumexUI.PropertyColumn>
    <LumexUI.PropertyColumn Title="Added By" Property="@(p => p.Id)">
        <Content>
            <span class="text-sm text-slate-400">Not tracked</span>
        </Content>
    </LumexUI.PropertyColumn>
    <LumexUI.PropertyColumn
        Title="Note / Reference"
        Property="@(p => p.Description)"
        Sortable="@true">
        <Content>
            @if (string.IsNullOrWhiteSpace(context.Description))
            {
                <span class="text-sm text-slate-400">No note</span>
            }
            else
            {
                <span class="text-sm text-slate-700">@context.Description</span>
            }
        </Content>
    </LumexUI.PropertyColumn>
    <LumexUI.PropertyColumn
        Title="Actions"
        Property="@(p => p.Id)">
        <Content>
            <div class="flex items-center gap-2" @onclick:stopPropagation="true">
                <CustomButton
                    Variant="Variant.Outlined"
                    Color="ThemeColor.Default"
                    OnClick="() => _paymentToView = context"
                    IconOnly="true"
                    Size="Size.Small">
                    <StartContent>
                        <i class="fa-regular fa-eye"></i>
                    </StartContent>
                </CustomButton>
                @if (CanUpdatePayments)
                {
                    <CustomButton
                        Variant="Variant.Outlined"
                        Color="ThemeColor.Primary"
                        OnClick="() => _paymentToUpdate = context"
                        IconOnly="true"
                        Size="Size.Small">
                        <StartContent>
                            <i class="fa-regular fa-pen-to-square"></i>
                        </StartContent>
                    </CustomButton>
                    <CustomButton
                        Variant="Variant.Outlined"
                        Color="ThemeColor.Danger"
                        OnClick="() => _paymentToDelete = context"
                        IconOnly="true"
                        Size="Size.Small">
                        <StartContent>
                            <i class="fa-regular fa-trash-can"></i>
                        </StartContent>
                    </CustomButton>
                }
            </div>
        </Content>
    </LumexUI.PropertyColumn>
</LumexDataGrid>
