@using LumexUI.Common
@using TimeTracker.Web.Ui.Shared.Components.Form.Validation

@inherits BaseReactiveComponent

<LumexModal
    Open="IsOpened"
    OnClose="@OnCloseModal"
    Size="ModalSize.Large"
    @ref="modal">
    <LumexModalContent>
        <LumexModalHeader Class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                <i class="fa-solid fa-plus"></i>
            </div>
            <div>
                <h2 class="mt-2 text-xl font-semibold text-slate-900">Add client payment</h2>
                <p class="mt-1 text-sm text-slate-600">Record money received from a client.</p>
            </div>
        </LumexModalHeader>
        <LumexModalBody>
            <EditForm
                Context="form"
                @ref="_form"
                Model="@model"
                novalidate>
                <DataAnnotationsValidator/>

                <div class="grid gap-4 md:grid-cols-2">
                    <div>
                        <ClientsDropDown
                            Value="model.ClientId"
                            ValueExpression="() => model.ClientId"
                            SelectedItemChanged="OnChangeClient"/>
                        <CustomValidationMessage For="@(() => model.ClientId)"/>
                    </div>
                    <div>
                        <ProjectsDropDown
                            Label="Project"
                            ClientId="model.ClientId"
                            Value="model.ProjectId"
                            ValueExpression="() => model.ProjectId"
                            SelectedItemChanged="OnProjectSelected"
                            Disabled="@(model.ClientId == Guid.Empty)"/>
                    </div>
                    <div>
                        <InputDateTimeField
                            Size="Size.Small"
                            Required="true"
                            @bind-Value="@model.PaymentTime"
                            Label="Payment Date"/>
                        <CustomValidationMessage For="@(() => model.PaymentTime)"/>
                    </div>
                    <div>
                        <InputNumericField
                            TItem="decimal"
                            Size="Size.Small"
                            Required="true"
                            @bind-Value="@model.Amount"
                            Label="Amount"/>
                        <CustomValidationMessage For="@(() => model.Amount)"/>
                    </div>
                    <div class="md:col-span-2">
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Note / Reference</label>
                        <InputTextArea
                            @bind-Value="model.Description"
                            class="min-h-[120px] w-full rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 focus:border-blue-500 focus:outline-none"
                            placeholder="Optional payment note or reference"/>
                    </div>
                </div>

                <CustomValidationSummary/>
            </EditForm>
        </LumexModalBody>
        <LumexModalFooter>
            <CustomButton
                FullWidth="@true"
                OnClick="@Submit"
                Color="@ThemeColor.Primary"
                Radius="@Radius.Full">
                Add client payment
            </CustomButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
