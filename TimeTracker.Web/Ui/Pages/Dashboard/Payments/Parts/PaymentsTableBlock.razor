@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Web.Ui.Shared.Components.Dialogs
@inherits BaseReactiveComponent

@if (_paymentToDelete != null)
{
    <ConfirmationModal
        OnClose="@(() => _paymentToDelete = null)"
        OnConfirm="OnDeletePayment"/>
}

<LumexDataGrid
    T="PaymentDto"
    Class="min-w-full divide-y divide-slate-200"
    Data="@_state.Value.List.AsQueryable()"
    Hoverable="true"
    OnRowClick="@OnRowClickHandler"
    Loading="_isLoading">
    <LumexUI.PropertyColumn Title="#" Property="@(p => p.PaymentTime.ToShortDateString())"/>
    <LumexUI.PropertyColumn Title="Client" Property="@(p => p.Client)">
        <Content>
            <div class="font-medium text-slate-900">
                @context.Client
            </div>
            @if (context.Project != null)
            {
                <div class="mt-1 max-w-xl text-slate-500">@context.Project?.Name</div>    
            }
        </Content>
    </LumexUI.PropertyColumn>
    <LumexUI.PropertyColumn 
        Title="Description"
        Property="@(p => p.Description)"
        Sortable="@true">
        <Content>
            @context.Description
        </Content>
    </LumexUI.PropertyColumn>
    <LumexUI.PropertyColumn
        Title="Actions"
        Property="@(p => p.Id)">
        <Content>
            <div @onclick:stopPropagation="true">
                <CustomButton
                    Variant="Variant.Outlined"
                    Color="ThemeColor.Danger"
                    OnClick="() => _paymentToDelete = context"
                    IconOnly="true"
                    Size="Size.Small">
                    <StartContent>
                        <i class="fa-regular fa-trash-can"></i>
                    </StartContent>
                </CustomButton>
            </div>
        </Content>
    </LumexUI.PropertyColumn>
</LumexDataGrid>
