@page "/board/payment"

@using TimeTracker.Web.Ui.Pages.Dashboard.Payments.Parts
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared.LayoutParts
@using TimeTracker.Web.Ui.Pages.Dashboard.Shared
@using TimeTracker.Web.Ui.Pages.Dashboard.Tasks.Components

@inherits BaseComponent
@layout Layout

@{
    var workspace = AuthState.Value.Workspace!;
}

<LumexCard Class="mt-6">
    <LumexCardBody>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Payments</p>
        <p class="mt-2 text-2xl font-semibold text-slate-900">@_state.Value.TotalCount</p>
        <p class="mt-1 text-sm text-slate-500">Saved for the current workspace</p>
    </LumexCardBody>
</LumexCard>

<LumexCard Class="mt-6 overflow-x-auto pb-2">
    <LumexCardHeader Class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="text-sm font-semibold text-slate-900">Workspace payments</p>
            <p class="text-sm text-slate-500">Add, edit, and remove payments linked to workspace projects.</p>
        </div>
        <CustomButton>
            <StartContent>
                <i class="fa-solid fa-plus"></i>    
            </StartContent>
            <ChildContent>
                Add payment
            </ChildContent>
        </CustomButton>
    </LumexCardHeader>
    <LumexCardBody>
        @if (_state.Value.TotalCount == 0)
        {
            <div class="px-4 py-8 text-center text-sm text-slate-500">No payments added yet. Use the add button to create the first payment.</div>
        }
        <PaymentsTableBlock></PaymentsTableBlock>
    </LumexCardBody>
</LumexCard>
