@using LumexUI
@using TimeTracker.Web.Ui.Shared.Components.Layout
@inherits TimeTracker.Web.Ui.Shared.BaseLayout

<div class="min-h-screen flex flex-col bg-white text-slate-900">
    <MainHeader />
    @Body
    <LayoutFooterBlock/>
</div>

@if (!IsShowReCaptcha)
{
    <style>
        .grecaptcha-badge {
            visibility: hidden;
        }
    </style>
}   
<LumexToastProvider RichColors="@true" Id="tv-toaster-rich-colors-id" />
