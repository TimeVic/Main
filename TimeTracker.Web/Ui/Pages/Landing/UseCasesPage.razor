@page "/use-cases"

@using LumexUI.Common
@using Layout = TimeTracker.Web.Ui.Pages.Landing.Shared.LandingLayout
@inherits BaseReactiveComponent
@layout Layout

<SeoHead
    Title="@SiteMetadata.UseCasesTitle"
    Description="@SiteMetadata.UseCasesDescription"
    Keywords="@SiteMetadata.UseCasesKeywords"
    Robots="@SiteMetadata.IndexRobots"
    CanonicalUrl="@SiteMetadata.ToAbsoluteUrl(SiteUrl.UseCases)" />

<main class="bg-white text-slate-950">
    <section class="relative overflow-hidden border-b border-slate-200 bg-gradient-to-br from-emerald-50 via-white to-red-50">
        <div class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(circle_at_top_left,_rgba(16,185,129,0.14),_transparent_38%)]"></div>
        <div class="absolute inset-x-0 bottom-0 h-72 bg-[radial-gradient(circle_at_bottom_right,_rgba(239,68,68,0.14),_transparent_40%)]"></div>

        <div class="relative mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(320px,420px)] lg:px-8 lg:py-24">
            <section class="max-w-3xl">
                <LumexChip
                    Variant="@ChipVariant.Flat"
                    Color="@ThemeColor.Primary"
                    Radius="@Radius.Full"
                    Class="border border-emerald-200 bg-white px-4 py-2 text-sm font-semibold text-emerald-700 shadow-sm">
                    For freelance developers with multiple clients
                </LumexChip>

                <h1 class="mt-6 text-4xl font-semibold leading-tight text-slate-950 sm:text-5xl lg:text-6xl">
                    For freelance developers working with multiple clients
                </h1>
                <p class="mt-3 text-xl font-semibold text-slate-700">Stop guessing your income.</p>
                <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-600">
                    Track time, see how much you've <span class="font-semibold text-emerald-700">earned</span>,
                    and know exactly <span class="font-semibold text-slate-800">who owes you</span>.
                </p>

                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <LumexButton
                        Size="@Size.Large"
                        Radius="@Radius.Large"
                        Color="@ThemeColor.Success"
                        Class="w-full rounded-2xl px-6 font-semibold shadow-sm shadow-emerald-200/80 sm:w-auto"
                        OnClick="@(() => NavigationManager.NavigateTo(SiteUrl.Registration_Step1))">
                        <StartContent>
                            <i class="fa-solid fa-wallet"></i>
                        </StartContent>
                        <ChildContent>Start tracking income</ChildContent>
                    </LumexButton>

                    <a href="#use-cases" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-6 py-3.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50">
                        <i class="fa-regular fa-eye"></i>
                        <span>Explore use cases</span>
                    </a>
                </div>
                <p class="mt-3 text-sm text-slate-500">No setup. No spreadsheets. Start in 30 seconds.</p>

                <div class="mt-10 grid gap-4 sm:grid-cols-3">
                    <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
                        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Track</p>
                        <p class="mt-3 text-lg font-semibold text-slate-900">Client work in one place</p>
                        <p class="mt-2 text-sm leading-6 text-slate-600">Hours stay attached to the right client, project, and rate.</p>
                    </div>
                    <div class="rounded-3xl border border-emerald-200 bg-emerald-50/60 p-5 shadow-sm">
                        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-emerald-700">Earn</p>
                        <p class="mt-3 text-lg font-semibold text-slate-900">See money as you work</p>
                        <p class="mt-2 text-sm leading-6 text-slate-700">Tracked time turns into earned income automatically.</p>
                    </div>
                    <div class="rounded-3xl border border-red-200 bg-red-50/70 p-5 shadow-sm">
                        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-red-700">Outstanding</p>
                        <p class="mt-3 text-lg font-semibold text-slate-900">Spot unpaid work fast</p>
                        <p class="mt-2 text-sm leading-6 text-slate-700">You can see which client balance still needs follow-up.</p>
                    </div>
                </div>
            </section>

            <aside class="lg:pl-4">
                <LumexCard
                    Radius="@Radius.Large"
                    Shadow="@Shadow.Large"
                    Class="overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-950 text-white">
                    <LumexCardHeader Class="border-b border-white/10 px-6 py-5">
                        <div class="flex w-full items-start justify-between gap-4">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-[0.28em] text-emerald-200">Financial summary</p>
                                <h2 class="mt-2 text-2xl font-semibold">One glance at what matters</h2>
                            </div>
                            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10 text-emerald-200">
                                <i class="fa-solid fa-chart-pie text-xl"></i>
                            </div>
                        </div>
                    </LumexCardHeader>

                    <LumexCardBody Class="gap-4 px-6 py-6">
                        <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                            <div class="flex items-center justify-between gap-4">
                                <span class="text-sm text-slate-300">Total Earned</span>
                                <span class="text-2xl font-semibold text-emerald-300">$6,480</span>
                            </div>
                            <p class="mt-2 text-sm text-slate-400">Across 4 active clients this month</p>
                        </div>

                        <div class="rounded-3xl border border-emerald-500/20 bg-emerald-500/10 p-5">
                            <div class="flex items-center justify-between gap-4">
                                <span class="text-sm text-emerald-100">Paid</span>
                                <span class="text-2xl font-semibold text-emerald-200">$4,900</span>
                            </div>
                            <p class="mt-2 text-sm text-emerald-100/80">Payouts already logged from clients</p>
                        </div>

                        <div class="rounded-3xl border border-red-500/30 bg-red-500/15 p-5 shadow-lg shadow-red-950/10">
                            <div class="flex items-center justify-between gap-4">
                                <span class="text-sm font-semibold text-red-100">Outstanding</span>
                                <span class="text-3xl font-semibold text-red-200">$1,580</span>
                            </div>
                            <p class="mt-2 text-sm text-red-100/85">This is the amount still unpaid by clients.</p>
                        </div>

                        <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                            <div class="flex items-center justify-between gap-3 text-sm">
                                <span class="text-slate-300">Client owing the most</span>
                                <span class="font-semibold text-white">Northline Studio</span>
                            </div>
                            <div class="mt-4 h-2 rounded-full bg-white/10">
                                <div class="h-2 w-[62%] rounded-full bg-red-400"></div>
                            </div>
                            <p class="mt-3 text-sm text-slate-300">Outstanding balance needs attention before it gets buried in next week’s work.</p>
                        </div>
                    </LumexCardBody>
                </LumexCard>
            </aside>
        </div>
    </section>

    <section id="use-cases" class="border-b border-slate-200 bg-white">
        <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
            <div class="max-w-3xl">
                <p class="text-sm font-semibold uppercase tracking-[0.28em] text-emerald-600">Use cases</p>
                <h2 class="mt-4 text-3xl font-semibold text-slate-950 sm:text-4xl">
                    Situations freelance developers run into every month
                </h2>
                <p class="mt-4 text-base leading-7 text-slate-600">
                    This page is not about generic productivity. It is about client work, rates, payments, and the money behind your hours.
                </p>
            </div>

            <div class="mt-10 grid gap-6 xl:grid-cols-3">
                <LumexCard
                    Radius="@Radius.Large"
                    Shadow="@Shadow.Medium"
                    Class="h-full rounded-[2rem] border border-slate-200 bg-slate-50/70">
                    <LumexCardBody Class="h-full gap-6 p-7">
                        <div class="flex items-center justify-between gap-4">
                            <LumexChip
                                Variant="@ChipVariant.Flat"
                                Color="@ThemeColor.Info"
                                Radius="@Radius.Full"
                                Class="bg-blue-100 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-blue-700">
                                Use case 01
                            </LumexChip>
                            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-sm">
                                <i class="fa-solid fa-code-branch"></i>
                            </span>
                        </div>

                        <div>
                            <h3 class="text-2xl font-semibold text-slate-950">Multiple clients, different rates</h3>
                            <p class="mt-3 text-sm leading-6 text-slate-600">
                                You're working with several clients and projects at the same time.
                            </p>
                        </div>

                        <div class="rounded-3xl border border-slate-200 bg-white p-5">
                            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Problem</p>
                            <p class="mt-3 text-sm leading-6 text-slate-700">
                                At the end of the month, you're guessing: how much time you spent and how much each client should pay.
                            </p>
                        </div>

                        <div class="rounded-3xl border border-blue-200 bg-blue-50/70 p-5">
                            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-blue-700">How TimeVic helps</p>
                            <p class="mt-3 text-sm leading-6 text-slate-700">
                                Track time per client and project. Set hourly rates once — TimeVic converts time into money automatically.
                            </p>
                        </div>

                        <div class="mt-auto rounded-3xl border border-emerald-200 bg-emerald-50/70 p-5">
                            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-emerald-700">Result</p>
                            <p class="mt-3 text-sm leading-6 text-slate-800">
                                You instantly see how much each client owes you — no manual calculations.
                            </p>
                        </div>
                    </LumexCardBody>
                </LumexCard>

                <LumexCard
                    Radius="@Radius.Large"
                    Shadow="@Shadow.Large"
                    Class="h-full rounded-[2rem] border border-red-200 bg-gradient-to-br from-white via-red-50 to-emerald-50 shadow-lg shadow-red-100/80 xl:-translate-y-3">
                    <LumexCardHeader Class="border-b border-red-100 px-7 py-6">
                        <div class="flex w-full items-center justify-between gap-4">
                            <div>
                                <LumexChip
                                    Variant="@ChipVariant.Flat"
                                    Color="@ThemeColor.Danger"
                                    Radius="@Radius.Full"
                                    Class="bg-red-100 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-red-700">
                                    Most important use case
                                </LumexChip>
                                <h3 class="mt-4 text-2xl font-semibold text-slate-950">Unpaid work visibility</h3>
                            </div>
                            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-red-600 text-white shadow-sm">
                                <i class="fa-solid fa-file-invoice-dollar"></i>
                            </span>
                        </div>
                    </LumexCardHeader>

                    <LumexCardBody Class="h-full gap-6 px-7 py-7">
                        <div>
                            <p class="text-sm leading-6 text-slate-700">
                                Some clients have paid. Others haven't.
                            </p>
                        </div>

                        <div class="rounded-3xl border border-red-200 bg-white p-5">
                            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-red-700">Problem</p>
                            <p class="mt-3 text-sm leading-6 text-slate-700">
                                When time tracking and payments are separated, you lose visibility of unpaid work.
                            </p>
                        </div>

                        <div class="rounded-3xl border border-emerald-200 bg-emerald-50/80 p-5">
                            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-emerald-700">How TimeVic helps</p>
                            <p class="mt-3 text-sm leading-6 text-slate-700">
                                Log payments and compare them directly with earned amounts.
                            </p>
                        </div>

                        <div class="rounded-[1.75rem] border border-slate-200 bg-slate-950 p-5 text-white">
                            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-300">Result</p>
                            <p class="mt-3 text-sm leading-6 text-slate-300">You always see:</p>

                            <div class="mt-4 grid gap-3">
                                <div class="flex items-center justify-between rounded-2xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-3">
                                    <span class="text-sm text-emerald-100">Paid</span>
                                    <span class="text-lg font-semibold text-emerald-200">$3,400</span>
                                </div>
                                <div class="flex items-center justify-between rounded-2xl border border-red-500/20 bg-red-500/10 px-4 py-3">
                                    <span class="text-sm text-red-100">Unpaid</span>
                                    <span class="text-lg font-semibold text-red-200">$1,120</span>
                                </div>
                                <div class="flex items-center justify-between rounded-2xl border border-red-500/30 bg-red-500/15 px-4 py-3">
                                    <span class="text-sm font-semibold text-red-100">Who owes you</span>
                                    <span class="text-xl font-semibold text-red-200">$1,120</span>
                                </div>
                            </div>

                            <p class="mt-4 text-xs font-semibold text-slate-400">Outstanding is not a guess anymore.</p>
                        </div>
                    </LumexCardBody>
                </LumexCard>

                <LumexCard
                    Radius="@Radius.Large"
                    Shadow="@Shadow.Medium"
                    Class="h-full rounded-[2rem] border border-slate-200 bg-slate-50/70">
                    <LumexCardBody Class="h-full gap-6 p-7">
                        <div class="flex items-center justify-between gap-4">
                            <LumexChip
                                Variant="@ChipVariant.Flat"
                                Color="@ThemeColor.Warning"
                                Radius="@Radius.Full"
                                Class="bg-amber-100 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-amber-700">
                                Use case 03
                            </LumexChip>
                            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-amber-500 text-white shadow-sm">
                                <i class="fa-solid fa-gauge-high"></i>
                            </span>
                        </div>

                        <div>
                            <h3 class="text-2xl font-semibold text-slate-950">Real hourly rate</h3>
                            <p class="mt-3 text-sm leading-6 text-slate-600">
                                You charge hourly, but not all work is visible.
                            </p>
                        </div>

                        <div class="rounded-3xl border border-slate-200 bg-white p-5">
                            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Problem</p>
                            <p class="mt-3 text-sm leading-6 text-slate-700">
                                Meetings, context switching, quick fixes — they reduce your real hourly rate, but you don't see it.
                            </p>
                        </div>

                        <div class="rounded-3xl border border-amber-200 bg-amber-50/80 p-5">
                            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-amber-700">How TimeVic helps</p>
                            <p class="mt-3 text-sm leading-6 text-slate-700">
                                Track all work related to a client and compare time vs earned money.
                            </p>
                        </div>

                        <div class="mt-auto rounded-3xl border border-emerald-200 bg-emerald-50/70 p-5">
                            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-emerald-700">Result</p>
                            <p class="mt-3 text-sm leading-6 text-slate-800">
                                You understand your real effective hourly rate — not just the nominal one.
                            </p>
                        </div>
                    </LumexCardBody>
                </LumexCard>
            </div>
        </div>
    </section>

    <section class="border-b border-slate-200 bg-slate-50">
        <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
            <LumexCard
                Radius="@Radius.Large"
                Shadow="@Shadow.Medium"
                Class="rounded-[2rem] border border-slate-200 bg-white">
                <LumexCardBody Class="gap-6 p-8 text-center sm:p-10">
                    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-900 text-white">
                        <i class="fa-solid fa-ban"></i>
                    </div>
                    <div>
                        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-slate-500">Anti-positioning</p>
                        <h2 class="mt-4 text-3xl font-semibold text-slate-950 sm:text-4xl">Not another task manager</h2>
                    </div>
                    <div class="mx-auto max-w-3xl space-y-4 text-base leading-7 text-slate-600">
                        <p>
                            TimeVic doesn't replace Jira, ClickUp, or your workflow.
                        </p>
                        <p class="font-medium text-slate-900">
                            It focuses on one thing:
                        </p>
                        <p class="text-lg font-semibold text-slate-950 sm:text-xl">
                            How much you earned, how much was paid,<br class="hidden sm:block" /> and who still owes you.
                        </p>
                    </div>
                </LumexCardBody>
            </LumexCard>
        </div>
    </section>

    <section class="bg-white">
        <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
            <LumexCard
                Radius="@Radius.Large"
                Shadow="@Shadow.Large"
                Class="rounded-[2rem] border border-slate-200 bg-slate-950 text-white shadow-2xl">
                <LumexCardBody Class="gap-8 p-8 sm:p-10 lg:p-12">
                    <div class="max-w-3xl">
                        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-emerald-200">Start now</p>
                        <h2 class="mt-4 text-3xl font-semibold leading-tight sm:text-4xl">
                            Start tracking income in minutes
                        </h2>
                        <p class="mt-4 text-base leading-7 text-slate-300">
                            Add a client, set your rate, and start tracking time.
                        </p>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-3">
                        <div class="rounded-3xl border border-white/10 bg-white/5 p-4 text-sm text-slate-200">Add a client</div>
                        <div class="rounded-3xl border border-white/10 bg-white/5 p-4 text-sm text-slate-200">Set your hourly rate</div>
                        <div class="rounded-3xl border border-white/10 bg-white/5 p-4 text-sm text-slate-200">Track time and payments</div>
                    </div>

                    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                        <LumexButton
                            Size="@Size.Large"
                            Radius="@Radius.Large"
                            Color="@ThemeColor.Success"
                            Class="w-full rounded-2xl px-6 font-semibold shadow-sm shadow-emerald-950/20 sm:w-auto"
                            OnClick="@(() => NavigationManager.NavigateTo(SiteUrl.Registration_Step1))">
                            <StartContent>
                                <i class="fa-solid fa-user-plus"></i>
                            </StartContent>
                            <ChildContent>Start free</ChildContent>
                        </LumexButton>

                        <a href="@SiteUrl.LoginAsDemo" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-white/15 bg-white/5 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-white/10">
                            <i class="fa-solid fa-flask"></i>
                            <span>Preview demo</span>
                        </a>

                        <p class="text-sm text-slate-400 sm:ml-2">No setup. No spreadsheets.</p>
                    </div>
                </LumexCardBody>
            </LumexCard>
        </div>
    </section>
</main>
