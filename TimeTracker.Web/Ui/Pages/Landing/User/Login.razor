@page "/login"
@using Layout = TimeTracker.Web.Ui.Pages.Landing.Shared.Layout

@inherits BaseReactiveComponent
@layout Layout

<FluentStack HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
    <FluentCard Style="width: 300px" Class="mt-5 mb-5">
        <EditForm
            Model="model"
            @ref="_form"
            novalidate>
            <DataAnnotationsValidator />

            <FluentLabel Typo="Typography.H2" Class="mb-3">Sign In</FluentLabel>

            <FluentStack Orientation="Orientation.Vertical" Class="mb-3">
                <FluentLabel>Email</FluentLabel>
                <FluentTextField
                    style="width: 100%;"
                    Disabled="_isLoading"
                    ValueExpression="() => model.Email"
                    ValueChanged="value => model.Email = value"
                    InputMode="InputMode.Email"
                    Placeholder="Enter your email">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Slot="start" Color="Color.Neutral"/>
                </FluentTextField>

                <FluentLabel>Password</FluentLabel>
                <FluentTextField
                    style="width: 100%;"
                    Disabled="_isLoading"
                    ValueExpression="() => model.Password"
                    ValueChanged="value => model.Password = value"
                    TextFieldType="TextFieldType.Password"
                    Placeholder="Your password">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Password())" Slot="start" Color="Color.Neutral"/>
                </FluentTextField>
            </FluentStack>
        </EditForm>
        <div Class="d-flex justify-space-between">
            <FluentButton
                OnClick="Submit"
                Appearance="@Appearance.Accent">
                Login
            </FluentButton>
            <FluentSpacer></FluentSpacer>
            <FluentAnchor
                Href="/user/password-reset">
                Forgot password?
            </FluentAnchor>
        </div>
    </FluentCard>
</FluentStack>
