@page "/login"
@using LumexUI.Common
@using Layout = TimeTracker.Web.Ui.Pages.Landing.Shared.Layout

@inherits BaseReactiveComponent
@layout Layout

<PageTitle>TimeVic - Login</PageTitle>

<div class="min-h-screen bg-slate-100 text-slate-900">
    <div class="px-4 py-10 sm:px-6 lg:px-8">
        <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(360px,440px)]">
        <section class="overflow-hidden rounded-[2rem] bg-slate-900 text-white shadow-2xl">
            <div class="flex h-full flex-col justify-between gap-8 p-8 sm:p-10">
                <div>
                    <div class="inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/10 px-4 py-2 text-sm font-semibold text-blue-100">
                        <i class="fa-solid fa-shield-halved text-blue-300"></i>
                        <span>Workspace demo access</span>
                    </div>
                    <h1 class="mt-6 max-w-xl text-3xl font-semibold leading-tight sm:text-4xl">Sign in to the TimeVic workspace</h1>
                    <p class="mt-4 max-w-2xl text-sm leading-6 text-slate-300 sm:text-base">After signing in, the user lands on the dashboard or returns to chat if that page was opened before authentication.</p>
                </div>
                <div class="grid gap-4 sm:grid-cols-3">
                    <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-blue-200">01</p>
                        <p class="mt-3 text-lg font-semibold">Single sign-in</p>
                        <p class="mt-2 text-sm text-slate-300">Authentication state is stored locally for a backend-free preview.</p>
                    </div>
                    <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-200">02</p>
                        <p class="mt-3 text-lg font-semibold">Protected pages</p>
                        <p class="mt-2 text-sm text-slate-300">Dashboard, chat, and workspace pages open only after sign-in.</p>
                    </div>
                    <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-200">03</p>
                        <p class="mt-3 text-lg font-semibold">Quick start</p>
                        <p class="mt-2 text-sm text-slate-300">Enter any valid email and password to access the preview workspace.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-xl sm:p-8">
