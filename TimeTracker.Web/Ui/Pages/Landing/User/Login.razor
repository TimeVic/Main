            <EditForm Model="@model" @ref="_form" OnValidSubmit="Submit" FormName="LoginForm" class="mt-6 space-y-4">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="space-y-2">
                    <label class="block text-sm font-medium text-slate-700">Email</label>
                    <InputTextField 
                        @bind-Value="@model.Email" 
                        Type="InputType.Email"
                        Placeholder="name@company.com" />
                </div>

                <div class="space-y-2">
                    <div class="flex items-center justify-between gap-3">
                        <label class="block text-sm font-medium text-slate-700">Password</label>
                        <button type="button" @onclick="ForgotPassword" class="text-sm font-medium text-blue-600 transition hover:text-blue-700 hover:underline">
                            Forgot password?
                        </button>
                    </div>
                    <InputTextField 
                        @bind-Value="@model.Password" Type="InputType.Password" 
                        Placeholder="Enter password" />
                </div>

                <label class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
                    <InputCheckbox @bind-Value="@model.IsRememberMe" />
                    <span>Remember this demo session</span>
                </label>

                @* <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600"> *@
                @*     @statusMessage *@
                @* </div> *@

                <button 
                    type="submit" 
                    class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">
                    <i class="fa-solid fa-arrow-right-to-bracket"></i>
                    <span>Sign in and open workspace</span>
                </button>
                <div class="text-center text-sm text-slate-600">
                    <span>No account yet?</span>
                    <a href="@SiteUrl.Registration_Step1" class="ml-2 font-semibold text-blue-600 transition hover:text-blue-700 hover:underline">Create one</a>
                </div>
            </EditForm>
        </section>
        </div>
    </div>
