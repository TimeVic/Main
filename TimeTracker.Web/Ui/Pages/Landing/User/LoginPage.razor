@page "/login"
@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons
@using TimeTracker.Web.Ui.Shared.Components.Form
@using TimeTracker.Web.Ui.Shared.Components.Form.Validation
@using Layout = TimeTracker.Web.Ui.Pages.Landing.Shared.LandingLayout

@inherits BaseReactiveComponent
@layout Layout

@inject IStringLocalizer<PublicLandingResource> SharedLocalizer
@inject IStringLocalizer<LoginPage> Localizer
<SeoHead
    Title="@Localizer["Meta_Title"]"
    Robots="@SiteMetadata.NoIndexRobots" />

<div class="min-h-screen bg-slate-100 text-slate-900">
    <div class="px-4 py-10 sm:px-6 lg:px-8">
        <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(360px,440px)]">
        <section class="overflow-hidden rounded-[2rem] bg-slate-900 text-white shadow-2xl">
            <div class="flex h-full flex-col justify-between gap-8 p-8 sm:p-10">
                <div>
                    <div class="inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/10 px-4 py-2 text-sm font-semibold text-blue-100">
                        <i class="fa-solid fa-shield-halved text-blue-300"></i>
                        <span>@Localizer["Content_WorkspaceDemoAccess"]</span>
                    </div>
                    <h1 class="mt-6 max-w-xl text-3xl font-semibold leading-tight sm:text-4xl">@Localizer["Content_SignInToTheTimevicWorkspace"]</h1>
                    <p class="mt-4 max-w-2xl text-sm leading-6 text-slate-300 sm:text-base">@Localizer["Content_AfterSigningInTheUserLandsOnTheDashboardOr"]</p>
                </div>
                <div class="grid gap-4 sm:grid-cols-3">
                    <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-blue-200">01</p>
                        <p class="mt-3 text-lg font-semibold">@Localizer["Content_SingleSignIn"]</p>
                        <p class="mt-2 text-sm text-slate-300">@Localizer["Content_AuthenticationStateIsStoredLocallyForABackendFreePreview"]</p>
                    </div>
                    <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-200">02</p>
                        <p class="mt-3 text-lg font-semibold">@Localizer["Content_ProtectedPages"]</p>
                        <p class="mt-2 text-sm text-slate-300">@Localizer["Content_DashboardChatAndWorkspacePagesOpenOnlyAfterSignIn"]</p>
                    </div>
                    <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-200">03</p>
                        <p class="mt-3 text-lg font-semibold">@Localizer["Content_QuickStart"]</p>
                        <p class="mt-2 text-sm text-slate-300">@Localizer["Content_EnterAnyValidEmailAndPasswordToAccessThePreview"]</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-xl sm:p-8">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-blue-600">@Localizer["Content_Auth"]</p>
                    <h2 class="mt-2 text-2xl font-semibold text-slate-900">@Localizer["Content_UserSignIn"]</h2>
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-sm">
                    <i class="fa-solid fa-user-lock text-lg"></i>
                </div>
            </div>

            <EditForm Model="@model" @ref="_form" OnValidSubmit="Submit" FormName="LoginForm" class="mt-6 space-y-4">
                <DataAnnotationsValidator/>
                <CustomValidationSummary/>

                <div>
                    <InputTextField
                        @bind-Value="@model.Email"
                        Label="@SharedLocalizer["Form_EmailLabel"]"
                        FullWidth="true"
                        Type="InputType.Email"
                        Placeholder="@SharedLocalizer["Form_EmailPlaceholder"]"/>

                    <InputTextField
                        @bind-Value="@model.Password"
                        Class="mt-4"
                        Label="@SharedLocalizer["Form_PasswordLabel"]"
                        FullWidth="true"
                        Type="InputType.Password"
                        Placeholder="@SharedLocalizer["Form_EnterPasswordPlaceholder"]"/>
                </div>

                <div class="flex items-end justify-between gap-3 w-full">
                    <button type="button" @onclick="ForgotPassword" class="text-sm font-medium text-blue-600 transition hover:text-blue-700 hover:underline">
                        @SharedLocalizer["Auth_ForgotPassword"]
                    </button>
                </div>

                <label class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
                    <InputCheckbox @bind-Value="@model.IsRememberMe"/>
                    <span>@Localizer["Content_RememberThisSession"]</span>
                </label>

                <CustomButton
                    Color="@ThemeColor.Primary"
                    Class="font-semibold w-full"
                    IsLoading="_isLoading"
                    OnClick="@Submit">
                    <StartContent>
                        <UserIcon></UserIcon>
                    </StartContent>
                    <ChildContent>@Localizer["Content_SignInAndOpenWorkspace"]</ChildContent>
                </CustomButton>
                <div class="text-center text-sm text-slate-600">
                    <span>@Localizer["Content_NoAccountYet"]</span>
                    <a href="@SiteUrl.Registration_Step1" class="ml-2 font-semibold text-blue-600 transition hover:text-blue-700 hover:underline">@Localizer["Content_CreateOne"]</a>
                </div>

                <div class="my-6 flex items-center gap-3">
                    <div class="h-px flex-1 bg-slate-200"></div>
                    <span class="text-xs font-medium text-slate-400 uppercase tracking-widest">@SharedLocalizer["Form_OrSeparator"]</span>
                    <div class="h-px flex-1 bg-slate-200"></div>
                </div>

                <a href="@SiteUrl.LoginAsDemo"
                   class="flex w-full items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-slate-50 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-100">
                    <i class="fa-regular fa-eye text-blue-500"></i>
                    <span>@SharedLocalizer["CTA_DemoDashboard"]</span>
                </a>
            </EditForm>

            <div class="my-6 flex items-center gap-3">
                <div class="h-px flex-1 bg-slate-200"></div>
                <span class="text-xs font-medium text-slate-400 uppercase tracking-widest">@SharedLocalizer["Form_OrSeparator"]</span>
                <div class="h-px flex-1 bg-slate-200"></div>
            </div>

            <EditForm Model="@_magicModel" @ref="_magicForm" FormName="MagicLoginForm" class="space-y-4">
                <DataAnnotationsValidator/>
                <CustomValidationSummary/>

                <div>
                    <p class="mb-1 text-sm font-medium text-slate-700">@Localizer["Content_SignInWithAMagicLink"]</p>
                    <p class="mb-3 text-xs text-slate-400">@Localizer["Content_WeLlSendAOneTimeLoginLinkToYour"]</p>
                    <InputTextField
                        @bind-Value="@_magicModel.Email"
                        Class="mt-2"
                        Label="@SharedLocalizer["Form_EmailLabel"]"
                        FullWidth="true"
                        Type="InputType.Email"
                        Placeholder="@SharedLocalizer["Form_EmailPlaceholder"]"/>
                </div>

                <CustomButton
                    Color="@ThemeColor.Default"
                    Class="font-semibold w-full"
                    IsLoading="_magicIsLoading"
                    OnClick="@SubmitMagic">
                    <StartContent>
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                    </StartContent>
                    <ChildContent>@Localizer["Content_SendMagicLink"]</ChildContent>
                </CustomButton>

                @if (_magicIsSent)
                {
                    <div class="rounded-2xl border border-blue-200 bg-blue-50 p-4 text-sm text-blue-900">
                        <p class="font-semibold">@Localizer["Content_MagicLinkSent"]</p>
                        <p class="mt-1 text-blue-700">@Localizer["Content_CheckYourInboxAndClickTheLinkToSignIn"]</p>
                    </div>
                }
            </EditForm>
        </section>
        </div>
    </div>
</div>
