@page "/registration/verification/{verificationToken}"

@using Microsoft.AspNetCore.Components
@using Layout = TimeTracker.Web.Ui.Pages.Landing.Shared.Layout

@layout Layout
@inherits BaseComponent

<FluentStack HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
    <FluentCard Style="width: 300px" Class="mt-5 mb-5">
        <EditForm
            Model="model"
            @ref="_form"
            novalidate>
            <DataAnnotationsValidator />

            <FluentLabel Typo="Typography.H2" Class="mb-3">Registration - Step 2</FluentLabel>
            
            <FluentStack Orientation="Orientation.Vertical" Class="mb-3">
                <FluentLabel>Enter your password to finish registration</FluentLabel>
                <FluentTextField
                    TextFieldType="TextFieldType.Password"
                    style="width: 100%;"
                    Disabled="_isLoading"
                    @bind-Value="@model.Password"
                    InputMode="InputMode.Email">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Slot="start" Color="Color.Neutral"/>
                </FluentTextField>
            </FluentStack>
        </EditForm>
        <div Class="d-flex justify-space-between">
            <FluentButton
                OnClick="Submit"
                Appearance="@Appearance.Accent">
                Continue
            </FluentButton>
        </div>
    </FluentCard>
</FluentStack>
