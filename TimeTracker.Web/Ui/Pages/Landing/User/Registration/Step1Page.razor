@page "/signup"
@page "/registration/step1"
@using LumexUI
@using LumexUI.Common
@using TimeTracker.Web.Ui.Pages.Landing.User.Registration.Shared
@using TimeTracker.Web.Ui.Shared.Components.Form
@using TimeTracker.Web.Ui.Shared.Components.Form.Validation
@using Layout = TimeTracker.Web.Ui.Pages.Landing.Shared.LandingLayout

@inherits BaseReactiveComponent
@layout Layout

<SeoHead
    Title="@SiteMetadata.RegistrationTitle"
    Description="@SiteMetadata.RegistrationDescription"
    Keywords="@SiteMetadata.RegistrationKeywords"
    Robots="@SiteMetadata.IndexRobots"
    CanonicalUrl="@SiteMetadata.ToAbsoluteUrl(SiteUrl.Registration_Step1)" />

<RegistrationCntainerBlock>
    <ChildContent>
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-600">Registration</p>
                <h2 class="mt-2 text-2xl font-semibold text-slate-900">"Create account"</h2>
                <p class="mt-2 text-sm text-slate-500">"Step 1 of 2 — start with your email address."</p>
            </div>
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-600 text-white shadow-sm">
                <i class="@($"fa-solid fa-user-plus text-lg")"></i>
            </div>
        </div>
        
        <EditForm
            Model="model"
            @ref="_form"
            class="mt-6 space-y-4">
            <DataAnnotationsValidator />
            <CustomValidationSummary/>

            <div class="space-y-2">
                <InputTextField 
                    @bind-Value="@model.Email"
                    Label="Email"
                    FullWidth="true"
                    Type="InputType.Email" 
                    Placeholder="your@email.com" />
            </div>
            @* <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600"> *@
            @*     @statusMessage *@
            @* </div> *@
            
            <CustomButton
                Color="@ThemeColor.Warning"
                Class="w-full gap-2 rounded-2xl bg-emerald-600 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"
                IsLoading="_isLoading"
                OnClick="@Submit">
                Send verification email
            </CustomButton>
        </EditForm>

        @if (_isSent)
        {
            <div class="mt-6 rounded-3xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900">
                <p class="font-semibold">Verification email sent</p>
                <p class="mt-2 text-emerald-700">We've sent you an email. Please follow the link inside to continue your registration.</p>
            </div>
        }

    </ChildContent>
</RegistrationCntainerBlock>
