@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

<div class="px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(360px,440px)]">
        <section class="overflow-hidden rounded-[2rem] bg-slate-900 text-white shadow-2xl">
            <div class="flex h-full flex-col justify-between gap-8 p-8 sm:p-10">
                <div>
                    <div class="inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/10 px-4 py-2 text-sm font-semibold text-emerald-100">
                        <i class="fa-solid fa-user-shield text-emerald-300"></i>
                        <span>Workspace account activation</span>
                    </div>
                    <h1 class="mt-6 max-w-xl text-3xl font-semibold leading-tight sm:text-4xl">Join TimeVic and start working in your workspace</h1>
                    <p class="mt-4 max-w-2xl text-sm leading-6 text-slate-300 sm:text-base">
                        Registration and workspace invitations use the same verification step: open the email link, create a password, and continue to the dashboard.
                    </p>
                </div>
                <div class="grid gap-4 sm:grid-cols-3">
                    <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-blue-200">01</p>
                        <p class="mt-3 text-lg font-semibold">Receive invite</p>
                        <p class="mt-2 text-sm text-slate-300">A workspace owner adds your email to the team.</p>
                    </div>
                    <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-200">02</p>
                        <p class="mt-3 text-lg font-semibold">Open email link</p>
                        <p class="mt-2 text-sm text-slate-300">The verification link confirms the invited account.</p>
                    </div>
                    <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-200">03</p>
                        <p class="mt-3 text-lg font-semibold">Create password</p>
                        <p class="mt-2 text-sm text-slate-300">Finish activation and enter the workspace.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-xl sm:p-8">
            @ChildContent

            <div class="mt-6 border-t border-slate-200 pt-5 text-sm text-slate-600">
                <span>Remembered your password?</span>
                <a href="@SiteUrl.Login" class="ml-2 font-semibold text-blue-600 transition hover:text-blue-700 hover:underline">Back to sign in</a>
            </div>
        </section>
    </div>
</div>
