@inject IStringLocalizer<PublicLandingResource> SharedLocalizer
@inject IStringLocalizer<RegistrationCntainerBlock> Localizer
@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

<div class="px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(360px,440px)]">
        <section class="overflow-hidden rounded-[2rem] bg-slate-900 text-white shadow-2xl">
            <div class="flex h-full flex-col justify-between gap-8 p-8 sm:p-10">
                <div>
                    <div class="inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/10 px-4 py-2 text-sm font-semibold text-emerald-100">
                        <i class="fa-solid fa-user-shield text-emerald-300"></i>
                        <span>@Localizer["Content_WorkspaceAccountActivation"]</span>
                    </div>
                    <h1 class="mt-6 max-w-xl text-3xl font-semibold leading-tight sm:text-4xl">@Localizer["Content_JoinTimevicAndStartWorkingInYourWorkspace"]</h1>
                    <p class="mt-4 max-w-2xl text-sm leading-6 text-slate-300 sm:text-base">
                        @Localizer["Content_RegistrationAndWorkspaceInvitationsUseTheSameVerificationStepOpen"]
                    </p>
                </div>
                <div class="grid gap-4 sm:grid-cols-3">
                    <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-blue-200">01</p>
                        <p class="mt-3 text-lg font-semibold">@Localizer["Content_ReceiveInvite"]</p>
                        <p class="mt-2 text-sm text-slate-300">@Localizer["Content_AWorkspaceOwnerAddsYourEmailToTheTeam"]</p>
                    </div>
                    <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-200">02</p>
                        <p class="mt-3 text-lg font-semibold">@Localizer["Content_OpenEmailLink"]</p>
                        <p class="mt-2 text-sm text-slate-300">@Localizer["Content_TheVerificationLinkConfirmsTheInvitedAccount"]</p>
                    </div>
                    <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-200">03</p>
                        <p class="mt-3 text-lg font-semibold">@SharedLocalizer["Form_CreatePasswordPlaceholder"]</p>
                        <p class="mt-2 text-sm text-slate-300">@Localizer["Content_FinishActivationAndEnterTheWorkspace"]</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-xl sm:p-8">
            @ChildContent

            <div class="mt-6 border-t border-slate-200 pt-5 text-sm text-slate-600">
                <span>@SharedLocalizer["Auth_RememberedPassword"]</span>
                <a href="@SiteUrl.Login" class="ml-2 font-semibold text-blue-600 transition hover:text-blue-700 hover:underline">@SharedLocalizer["CTA_BackToSignIn"]</a>
            </div>
        </section>
    </div>
</div>
