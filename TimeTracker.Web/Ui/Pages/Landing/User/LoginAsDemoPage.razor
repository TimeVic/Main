@page "/demo"
@page "/login/as-demo"
@using Layout = TimeTracker.Web.Ui.Pages.Landing.Shared.LandingLayout
@inherits BaseReactiveComponent
@layout Layout

<SeoHead
    Title="TimeVic — Loading Demo"
    Robots="@SiteMetadata.NoIndexRobots" />

<div class="min-h-screen bg-slate-100 flex items-center justify-center">
    <div class="mx-auto max-w-sm w-full px-4">
        <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white p-10 shadow-xl text-center">
            @if (_isError)
            {
                <div class="flex h-16 w-16 mx-auto items-center justify-center rounded-2xl bg-red-100 text-red-600">
                    <i class="fa-solid fa-triangle-exclamation text-2xl"></i>
                </div>
                <h2 class="mt-6 text-xl font-semibold text-slate-900">Something went wrong</h2>
                <p class="mt-2 text-sm text-slate-500">Could not load the demo account. Please try again.</p>
                <a href="@SiteUrl.LoginAsDemo"
                   class="mt-6 inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-blue-700">
                    <i class="fa-solid fa-rotate-right"></i>
                    <span>Retry</span>
                </a>
            }
            else
            {
                <div class="relative flex h-16 w-16 mx-auto items-center justify-center">
                    <div class="absolute inset-0 rounded-full border-4 border-blue-100"></div>
                    <div class="absolute inset-0 rounded-full border-4 border-blue-600 border-t-transparent animate-spin"></div>
                    <i class="fa-solid fa-clock text-blue-600 text-xl"></i>
                </div>
                <h2 class="mt-6 text-xl font-semibold text-slate-900">Setting up your demo</h2>
                <p class="mt-2 text-sm text-slate-500">We're preparing a workspace with sample data. This takes just a moment.</p>
                <div class="mt-6 flex flex-col gap-2 text-sm text-slate-400">
                    <div class="flex items-center justify-center gap-2">
                        <i class="fa-solid fa-check text-emerald-500"></i>
                        <span>Workspaces &amp; clients</span>
                    </div>
                    <div class="flex items-center justify-center gap-2">
                        <i class="fa-solid fa-check text-emerald-500"></i>
                        <span>Projects &amp; task lists</span>
                    </div>
                    <div class="flex items-center justify-center gap-2">
                        <i class="fa-solid fa-check text-emerald-500"></i>
                        <span>Sample tasks</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
