@page "/user/password-reset"
@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons
@using TimeTracker.Web.Ui.Pages.Landing.User.Password.Shared
@using Layout = TimeTracker.Web.Ui.Pages.Landing.Shared.LandingLayout

@inherits BaseReactiveComponent
@layout Layout

<SeoHead
    Title="TimeVic - Forgot Password"
    Robots="@SiteMetadata.NoIndexRobots" />

<PasswordFormBlock>
    <ChildContent>
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-600">Recovery</p>
                <h2 class="mt-2 text-2xl font-semibold text-slate-900">Forgot password</h2>
                <p class="mt-2 text-sm text-slate-500">"Step 1 of 2 — receive a password recovery link."</p>
            </div>
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-500 text-white shadow-sm">
                <i class="@($"fa-solid fa-envelope text-lg")"></i>
            </div>
        </div>

        <EditForm 
            Model="model"
            @ref="_form"
            class="mt-6 space-y-4"
            novalidate
        >
            <DataAnnotationsValidator/>
        
            <div class="space-y-2">
                <InputTextField 
                    @bind-Value="@model.Email"
                    Label="Email"
                    Type="InputType.Email" 
                    FullWidth="true"
                    Placeholder="some@email.com" />
            </div>
            @* <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600"> *@
            @*     @statusMessage *@
            @* </div> *@
            <CustomButton
                Color="@ThemeColor.Warning"
                Class="bg-amber-500 text-white shadow-sm transition hover:bg-amber-600 font-semibold w-full"
                IsLoading="_isLoading"
                OnClick="@Submit">
                <StartContent>
                    <SendAltIcon></SendAltIcon>
                </StartContent>
                <ChildContent>Send recovery email</ChildContent>
            </CustomButton>
        </EditForm>
        @if (_isSent)
        {
            <div class="mt-6 rounded-3xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
                <p class="font-semibold">Recovery email sent</p>
                <p class="mt-2 text-amber-700">Check your email and use the link below to continue recovering your password.</p>
            </div>
        }
    </ChildContent>
</PasswordFormBlock>
