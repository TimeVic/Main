@page "/user/change-password/{token}"

@using LumexUI
@using LumexUI.Common
@using TimeTracker.Web.Ui.Pages.Landing.User.Password.Shared
@using TimeTracker.Web.Ui.Shared.Components.Form
@using Layout = TimeTracker.Web.Ui.Pages.Landing.Shared.Layout

@inherits BaseComponent
@layout Layout

<PageTitle>TimeVic - Change password</PageTitle>

<ComponentLayout>
    <ChildContent>
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-600">Recovery</p>
                <h2 class="mt-2 text-2xl font-semibold text-slate-900">"Set a new password"</h2>
                <p class="mt-2 text-sm text-slate-500">"Step 2 of 2 — create a new password."</p>
            </div>
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-500 text-white shadow-sm">
                <i class="fa-solid fa-lock-open text-lg"></i>
            </div>
        </div>

        @if (_isCompleted)
        {
            <div class="mt-6 rounded-3xl border border-emerald-200 bg-emerald-50 p-5 text-sm text-emerald-900">
                <p class="font-semibold">Password updated successfully</p>
                @* <p class="mt-2 text-emerald-700">AAAAAAAAAAAAAAAAA</p> *@
                <div class="mt-4 flex flex-col gap-3 sm:flex-row">
                    <a 
                        href="@SiteUrl.Login" 
                        class="inline-flex items-center justify-center gap-2 rounded-2xl bg-emerald-600 px-4 py-3 font-semibold text-white transition hover:bg-emerald-700">
                        <i class="fa-solid fa-arrow-right-to-bracket"></i>
                        <span>Go to login</span>
                    </a>
                    <a href="@SiteUrl.ForgotPassword" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50">
                        <i class="fa-solid fa-rotate-left"></i>
                        <span>Start again</span>
                    </a>
                </div>
            </div>
        }
        else
        {
            @* <div class="mt-6 rounded-3xl border border-blue-200 bg-blue-50 p-4 text-sm text-blue-900"> *@
            @*     <p class="font-semibold">Recovery for email</p> *@
            @*     <p class="mt-1 text-blue-700">@model.</p> *@
            @* </div> *@
            <EditForm 
                Model="model"
                @ref="_form" 
                FormName="ForgotPasswordResetForm" 
                class="mt-6 space-y-4"
                novalidate
            >
                <DataAnnotationsValidator/>
                
                <div class="space-y-2">
                    <InputTextField 
                        @bind-Value="@model.Password"
                        Label="New password"
                        FullWidth="true"
                        Type="InputType.Password" 
                        Placeholder="some@email.com" />
                </div>
                @* <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600"> *@
                @*     AAAAAAAAAAAAAAAAAAAAAAA *@
                @* </div> *@
                <div class="flex flex-col gap-3 sm:flex-row">
                    <CustomButton
                        Color="@ThemeColor.Warning"
                        Class="bg-amber-500 text-white shadow-sm transition hover:bg-amber-600 font-semibold w-full"
                        IsLoading="_isLoading"
                        OnClick="@Submit">
                        Save new password
                    </CustomButton>
                    <a href="@SiteUrl.ForgotPassword" 
                       class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50"
                    >
                        <i class="fa-solid fa-arrow-left"></i>
                        <span>Back</span>
                    </a>
                </div>
            </EditForm>
        }
    </ChildContent>
</ComponentLayout>

