@page "/faq"
@page "/uk/faq"
@using LumexUI.Common
@using TimeTracker.Web.Services
@using Layout = TimeTracker.Web.Ui.Pages.Landing.Shared.LandingLayout

@layout Layout

@inject IStringLocalizer<PublicLandingResource> SharedLocalizer
@inject IStringLocalizer<FaqPage> Localizer
@inject ILocalizationUrlService LocalizationUrlService
@inject NavigationManager NavigationManager
<SeoHead
    Title="@Localizer["Meta_Title"]"
    Description="@Localizer["Meta_Description"]"
    Keywords="@Localizer["Meta_Keywords"]"
    Robots="@SiteMetadata.IndexRobots"
    PublicPagePath="@SiteUrl.Faq" />

<main class="bg-white text-slate-950">
    <section class="relative overflow-hidden border-b border-slate-200 bg-gradient-to-br from-blue-50 via-white to-emerald-50">
        <div class="absolute inset-x-0 top-0 h-64 bg-[radial-gradient(circle_at_top_right,_rgba(16,185,129,0.12),_transparent_42%)]"></div>
        <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:py-20">
            <div class="relative text-center">
                <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-white px-4 py-2 text-sm font-semibold text-blue-700 shadow-sm">
                    <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                    <span>@Localizer["Content_ForFreelanceDevelopersWorkingWithMultipleClients"]</span>
                </div>
                <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-semibold leading-tight text-slate-950 sm:text-5xl">
                    @Localizer["Content_EverythingAboutTrackingYourIncomeAndClientPayments"]
                </h1>
                <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
                    @Localizer["Content_LearnHowTimevicHelpsFreelanceDevelopersTrackEarningsPaymentsAnd"]
                </p>
                <p class="mx-auto mt-4 max-w-2xl text-sm font-medium leading-6 text-slate-700 sm:text-base">
                    @Localizer["Content_MostToolsTrackTimeTimevicHelpsYouUnderstandYourIncome"]
                </p>
            </div>

            <div class="relative mt-10 rounded-[2rem] border border-slate-200 bg-slate-950 p-6 text-white shadow-xl sm:p-8">
                <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-blue-200">@Localizer["Content_QuickExample"]</p>
                        <h2 class="mt-3 text-2xl font-semibold leading-tight sm:text-3xl">
                            @Localizer["Content_TrackTheWorkSeeTheMoneyImmediately"]
                        </h2>
                        <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-300 sm:text-base">
                            @Localizer["Content_YouWorked30HoursThatEarned1500TheClient"]
                        </p>
                    </div>

                    <div class="rounded-[1.75rem] border border-white/10 bg-white/5 p-5 sm:min-w-[280px]">
                        <div class="space-y-4">
                            <div class="flex items-center justify-between gap-4 rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                                <span class="text-sm text-slate-300">@Localizer["Content_TrackedWork"]</span>
                                <span class="text-base font-semibold text-white">@Localizer["Content_30Hours"]</span>
                            </div>
                            <div class="flex items-center justify-between gap-4 rounded-2xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-3">
                                <span class="text-sm text-emerald-100">@Localizer["Content_Earned"]</span>
                                <span class="text-base font-semibold text-white">$1,500</span>
                            </div>
                            <div class="flex items-center justify-between gap-4 rounded-2xl border border-blue-500/20 bg-blue-500/10 px-4 py-3">
                                <span class="text-sm text-blue-100">@Localizer["Content_Paid"]</span>
                                <span class="text-base font-semibold text-white">$500</span>
                            </div>
                            <div class="flex items-center justify-between gap-4 rounded-2xl border border-amber-500/20 bg-amber-500/10 px-4 py-3">
                                <span class="text-sm text-amber-100">@Localizer["Content_Outstanding"]</span>
                                <span class="text-base font-semibold text-white">$1,000</span>
                            </div>
                        </div>
                        <p class="mt-4 text-sm font-medium text-slate-200">@Localizer["Content_TimevicShowsThisInstantly"]</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-white">
        <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:py-16">
            <div class="space-y-14">
                <section aria-labelledby="faq-product-basics" class="scroll-mt-24">
                    <div class="mb-5">
                        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-blue-600">@Localizer["Content_Section1"]</p>
                        <h2 id="faq-product-basics" class="mt-2 text-2xl font-semibold text-slate-950">@Localizer["Content_ProductBasics"]</h2>
                        <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600 sm:text-base">
                            @Localizer["Content_StartHereIfYouWantTheShortVersionOfWhat"]
                        </p>
                    </div>

                    <LumexAccordion
                        Variant="@AccordionVariant.Splitted"
                        SelectionMode="@SelectionMode.Multiple"
                        ShowDividers="@false"
                        ItemClasses="@FaqItemClasses">
                        <LumexAccordionItem Id="product-what" Title="@Localizer["Title_WhatIsTimevic"]" Expanded="true">
                            <p>
                                @Localizer["Content_TimevicIsAnIncomeTrackingToolForFreelanceDevelopersWho"]
                            </p>
                            <p class="mt-3">
                                @Localizer["Content_ItTurnsTrackedWorkIntoClearNumbersHowMuchYou"]
                            </p>
                            <p class="mt-3">
                                @Localizer["Content_TheGoalIsSimpleFinancialClarityFromClientWork"]
                            </p>
                        </LumexAccordionItem>

                        <LumexAccordionItem Id="product-time-tracker" Title="@Localizer["Title_IsTimevicJustATimeTracker"]" Expanded="true">
                            <p>@Localizer["Content_No"]</p>
                            <p class="mt-3">
                                @Localizer["Content_TimeTrackingIsOnlyTheInput"]
                            </p>
                            <p class="mt-3">
                                @Localizer["Content_TheOutputIsIncomeVisibilityEarnedMoneyPaidMoneyAnd"]
                            </p>
                        </LumexAccordionItem>

                        <LumexAccordionItem Id="product-for" Title="@Localizer["Title_WhoIsTimevicFor"]">
                            <p>
                                @Localizer["Content_TimevicIsForFreelanceDevelopersWhoWorkWithMultipleClients"]
                            </p>
                            <p class="mt-3">
                                @Localizer["Content_IfYouNeedToKnowWhatEachClientOwesYou"]
                            </p>
                        </LumexAccordionItem>

                        <LumexAccordionItem Id="product-spreadsheet" Title="@Localizer["Title_WhyNotJustUseATimeTrackerAndASpreadsheet"]">
                            <p>
                                @Localizer["Content_YouCanButThenYouDoTheMoneyWorkManually"]
                            </p>
                            <p class="mt-3">
                                @Localizer["Content_YouHaveToCalculateEarningsLogPaymentsSomewhereElseAnd"]
                            </p>
                            <p class="mt-3">
                                @Localizer["Content_TimevicKeepsThatInOnePlaceSoYourTrackedWork"]
                            </p>
                        </LumexAccordionItem>
                    </LumexAccordion>
                </section>

                <section aria-labelledby="faq-money-payments" class="scroll-mt-24">
                    <div class="rounded-[2rem] border border-emerald-200 bg-emerald-50/70 p-6 sm:p-8">
                        <div class="mb-6">
                            <div class="inline-flex items-center gap-3 rounded-full border border-emerald-200 bg-white px-4 py-2 text-sm font-semibold text-emerald-700 shadow-sm">
                                <i class="fa-solid fa-wallet"></i>
                                <span>@Localizer["Content_MostImportantSection"]</span>
                            </div>
                            <p class="mt-5 text-xs font-semibold uppercase tracking-[0.24em] text-emerald-600">@Localizer["Content_Section2"]</p>
                            <h2 id="faq-money-payments" class="mt-2 text-2xl font-semibold text-slate-950">@Localizer["Content_MoneyPayments"]</h2>
                            <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-700 sm:text-base">
                                @Localizer["Content_ThisIsWhereTimevicBecomesMoreThanATimeTracker"]
                            </p>
                        </div>

                        <LumexAccordion
                            Variant="@AccordionVariant.Splitted"
                            SelectionMode="@SelectionMode.Multiple"
                            ShowDividers="@false"
                            ItemClasses="@FaqItemClasses">
                            <LumexAccordionItem Id="money-calculate" Title="@Localizer["Title_HowDoesTimevicCalculateEarnings"]">
                                <p>
                                    @Localizer["Content_YouSetAnHourlyRateForTheWorkYouTrack"]
                                </p>
                                <p class="mt-3">
                                    @Localizer["Content_TimevicConvertsThoseHoursIntoEarnedIncomeAutomaticallySoYou"]
                                </p>
                            </LumexAccordionItem>

                            <LumexAccordionItem Id="money-payments" Title="@Localizer["Title_CanITrackPaymentsFromClients"]">
                                <p>
                                    @Localizer["Content_Yes"]
                                </p>
                                <p class="mt-3">
                                    @Localizer["Content_YouCanRecordClientPaymentsAndCompareThemDirectlyAgainst"]
                                </p>
                                <p class="mt-3">
                                    @Localizer["Content_ThatGivesYouAClearSplitBetweenPaidWorkAnd"]
                                </p>
                            </LumexAccordionItem>

                            <LumexAccordionItem Id="money-unpaid" Title="@Localizer["Title_WhatHappensIfAClientHasnTPaidYet"]">
                                <p>
                                    @Localizer["Content_TimevicHighlightsTheUnpaidWorkAndTheOutstandingBalance"]
                                </p>
                                <p class="mt-3">
                                    @Localizer["Content_YouAlwaysKnowWhichClientStillOwesYouMoneyAnd"]
                                </p>
                            </LumexAccordionItem>

                            <LumexAccordionItem Id="money-paid-unpaid-client" Title="@Localizer["Title_CanISeePaidVsUnpaidWorkPerClient"]">
                                <p>
                                    @Localizer["Content_Yes"]
                                </p>
                                <p class="mt-3">
                                    @Localizer["Content_TimevicHelpsYouReviewEarnedPaidAndOutstandingAmountsFor"]
                                </p>
                            </LumexAccordionItem>

                            <LumexAccordionItem Id="money-owes" Title="@Localizer["Title_CanISeeWhoOwesMeMoney"]">
                                <p>
                                    @Localizer["Content_Yes"]
                                </p>
                                <p class="mt-3">
                                    @Localizer["Content_ThePlatformMakesUnpaidBalancesVisibleSoYouCanSee"]
                                </p>
                            </LumexAccordionItem>

                            <LumexAccordionItem Id="money-invoicing" Title="@Localizer["Title_DoesTimevicReplaceInvoicingTools"]">
                                <p>
                                    @Localizer["Content_No"]
                                </p>
                                <p class="mt-3">
                                    @Localizer["Content_TimevicIsFocusedOnEarningsPaymentsAndOutstandingBalancesIt"]
                                </p>
                            </LumexAccordionItem>
                        </LumexAccordion>
                    </div>
                </section>

                <section aria-labelledby="faq-features-usage" class="scroll-mt-24">
                    <div class="mb-5">
                        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-violet-600">@Localizer["Content_Section3"]</p>
                        <h2 id="faq-features-usage" class="mt-2 text-2xl font-semibold text-slate-950">@Localizer["Content_FeaturesUsage"]</h2>
                        <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600 sm:text-base">
                            @Localizer["Content_TheProductStaysFocusedFeaturesSupportIncomeTrackingInsteadOf"]
                        </p>
                    </div>

                    <LumexAccordion
                        Variant="@AccordionVariant.Splitted"
                        SelectionMode="@SelectionMode.Multiple"
                        ShowDividers="@false"
                        ItemClasses="@FaqItemClasses">
                        <LumexAccordionItem Id="usage-every-minute" Title="@Localizer["Title_DoINeedToTrackEveryMinute"]">
                            <p>@Localizer["Content_No"]</p>
                            <p class="mt-3">
                                @Localizer["Content_YouCanTrackAsMuchOrAsLittleAsYou"]
                            </p>
                        </LumexAccordionItem>

                        <LumexAccordionItem Id="usage-multiple-clients" Title="@Localizer["Title_CanIManageMultipleClients"]">
                            <p>
                                @Localizer["Content_YesTimevicIsBuiltForMultipleClientsMultipleProjectsAnd"]
                            </p>
                        </LumexAccordionItem>

                        <LumexAccordionItem Id="usage-task-managers" Title="@Localizer["Title_DoesTimevicReplaceJiraOrTaskManagers"]">
                            <p>@Localizer["Content_No"]</p>
                            <p class="mt-3">
                                @Localizer["Content_TimevicIsNotATaskManager"]
                            </p>
                            <p class="mt-3">
                                @Localizer["Content_TasksAreSimpleOptionalAndOnlyExistToSupportTime"]
                            </p>
                        </LumexAccordionItem>

                        <LumexAccordionItem Id="usage-attach-time" Title="@Localizer["Title_CanIAttachTimeToTasks"]">
                            <p>
                                @Localizer["Content_YesYouCanAttachTimeEntriesToTasksWhenYou"]
                            </p>
                        </LumexAccordionItem>
                    </LumexAccordion>
                </section>

                <section aria-labelledby="faq-pricing-access" class="scroll-mt-24">
                    <div class="mb-5">
                        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-amber-600">@Localizer["Content_Section4"]</p>
                        <h2 id="faq-pricing-access" class="mt-2 text-2xl font-semibold text-slate-950">@Localizer["Content_PricingAccess"]</h2>
                        <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600 sm:text-base">
                            @Localizer["Content_KeepSetupFrictionLowSoYouCanStartTrackingClients"]
                        </p>
                    </div>

                    <LumexAccordion
                        Variant="@AccordionVariant.Splitted"
                        SelectionMode="@SelectionMode.Multiple"
                        ShowDividers="@false"
                        ItemClasses="@FaqItemClasses">
                        <LumexAccordionItem Id="pricing-free" Title="@Localizer["Title_IsTimevicFree"]">
                            <p>
                                @Localizer["Content_YesTimevicIsFreeToUse"]
                            </p>
                        </LumexAccordionItem>

                        <LumexAccordionItem Id="pricing-install" Title="@Localizer["Title_DoINeedToInstallAnything"]">
                            <p>
                                @Localizer["Content_NoTimevicWorksInYourBrowser"]
                            </p>
                        </LumexAccordionItem>
                    </LumexAccordion>
                </section>

                <section aria-labelledby="faq-getting-started" class="scroll-mt-24">
                    <div class="mb-5">
                        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">@Localizer["Content_Section5"]</p>
                        <h2 id="faq-getting-started" class="mt-2 text-2xl font-semibold text-slate-950">@Localizer["Content_GettingStarted"]</h2>
                        <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600 sm:text-base">
                            @Localizer["Content_TheFirstSetupIsShortAddTheClientSetThe"]
                        </p>
                    </div>

                    <LumexAccordion
                        Variant="@AccordionVariant.Splitted"
                        SelectionMode="@SelectionMode.Multiple"
                        ShowDividers="@false"
                        ItemClasses="@FaqItemClasses">
                        <LumexAccordionItem Id="getting-started-how" Title="@Localizer["Title_HowDoIStart"]">
                            <ol class="list-decimal space-y-1 pl-5">
                                <li>@Localizer["Content_AddAClient"]</li>
                                <li>@Localizer["Content_CreateAProject"]</li>
                                <li>@Localizer["Content_SetAnHourlyRate"]</li>
                                <li>@Localizer["Content_TrackTime"]</li>
                            </ol>
                            <p class="mt-3">@Localizer["Content_YouWillImmediatelySeeHowMuchYouEarnedFromThe"]</p>
                        </LumexAccordionItem>

                        <LumexAccordionItem Id="getting-started-value" Title="@Localizer["Title_HowLongDoesItTakeToSeeValue"]">
                            <p>
                                @Localizer["Content_About2Minutes"]
                            </p>
                            <p class="mt-3">
                                @Localizer["Content_AsSoonAsYouAddAClientSetARate"]
                            </p>
                        </LumexAccordionItem>
                    </LumexAccordion>
                </section>
            </div>
        </div>
    </section>

    <section class="bg-slate-950 text-white">
        <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:py-20">
            <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-200">@Localizer["Content_IncomeClarity"]</p>
            <h2 class="mt-4 text-3xl font-semibold leading-tight sm:text-4xl">
                @Localizer["Content_StartTrackingYourIncomeNotJustTime"]
            </h2>
            <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-slate-300">
                @Localizer["Content_KnowHowMuchYouEarnedAndWhoStillOwesYou"]
            </p>
            <div class="mt-8">
                <a href="@LocalizedUrl(SiteUrl.Registration_Step1)" class="inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">
                    <i class="fa-solid fa-arrow-right"></i>
                    <span>@SharedLocalizer["CTA_GetStartedFree"]</span>
                </a>
            </div>
            <p class="mx-auto mt-4 max-w-2xl text-sm leading-6 text-slate-400">
                @Localizer["Content_NoSetupComplexityJustAddAClientSetARate"]
            </p>
        </div>
    </section>
</main>

@code {
    private string CurrentPath => new Uri(NavigationManager.Uri).AbsolutePath;

    private string CurrentCulture => LocalizationUrlService.GetCurrentCultureName(CurrentPath);

    private string LocalizedUrl(string path) => LocalizationUrlService.GetLocalizedUrl(path, CurrentCulture);

    private static readonly AccordionItemSlots FaqItemClasses = new()
    {
        Base = "rounded-[1.5rem] border border-slate-200 bg-white shadow-sm transition-shadow duration-200 hover:shadow-md",
        Trigger = "py-5 gap-4",
        Title = "text-base font-semibold leading-6 text-slate-950 sm:text-lg",
        Content = "pb-5 text-sm leading-7 text-slate-600 sm:text-base",
        Indicator = "text-slate-400 transition-transform duration-200"
    };
}
