@page "/"

@using TimeTracker.Web.Ui.Pages.Landing.Shared
@inherits BaseReactiveComponent
@layout Layout

<SeoHead
    Title="@SiteMetadata.HomeTitle"
    Description="@SiteMetadata.HomeDescription"
    Keywords="@SiteMetadata.HomeKeywords"
    Robots="@SiteMetadata.IndexRobots"
    CanonicalUrl="@SiteMetadata.ToAbsoluteUrl(SiteUrl.Main)" />

<main>
        <section class="relative overflow-hidden border-b border-slate-200 bg-gradient-to-br from-blue-50 via-white to-emerald-50">
            <div class="absolute inset-x-0 top-0 h-64 bg-[radial-gradient(circle_at_top_right,_rgba(37,99,235,0.14),_transparent_40%)]"></div>
            <div class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(320px,480px)] lg:px-8 lg:py-24">
                <section class="relative z-10">
                    <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-white px-4 py-2 text-sm font-semibold text-blue-700 shadow-sm">
                        <i class="fa-solid fa-bolt"></i>
                        <span>Clear work visibility for teams, freelancers, and agencies</span>
                    </div>
                    <h1 class="mt-6 max-w-4xl text-4xl font-semibold leading-tight text-slate-950 sm:text-5xl lg:text-6xl">Understand where time goes, what gets paid, and what your team should do next.</h1>
                    <p class="mt-6 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">TimeVic helps small teams track work hours, organize tasks, chat inside a workspace, manage clients and projects, and turn raw time entries into useful reports. A quick scan of the product shows exactly how it helps: less chaos, clearer priorities, and better billing confidence.</p>

                    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                        <a href="@SiteUrl.LoginAsDemo" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">
                            <i class="fa-solid fa-rocket"></i>
                            <span>Try demo</span>
                        </a>
                        <a href="@SiteUrl.Login" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-6 py-3.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50">
                            <i class="fa-solid fa-arrow-right-to-bracket"></i>
                            <span>Sign in</span>
                        </a>
                        <a href="@SiteUrl.Dashboard_TimeEntry" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-6 py-3.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50">
                            <i class="fa-regular fa-eye"></i>
                            <span>Preview the dashboard flow</span>
                        </a>
                    </div>

                    <div class="mt-10 grid gap-4 sm:grid-cols-3">
                        <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
                            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-blue-600">Track</p>
                            <p class="mt-3 text-lg font-semibold text-slate-900">Time entries with context</p>
                            <p class="mt-2 text-sm leading-6 text-slate-600">Users can log hours against tasks, projects, and clients instead of keeping scattered notes.</p>
                        </div>
                        <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
                            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-emerald-600">Align</p>
                            <p class="mt-3 text-lg font-semibold text-slate-900">One place for chat and planning</p>
                            <p class="mt-2 text-sm leading-6 text-slate-600">Teams discuss work inside the same workspace where tasks, project status, and timing already live.</p>
                        </div>
                        <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
                            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-amber-600">Monetize</p>
                            <p class="mt-3 text-lg font-semibold text-slate-900">Turn hours into payment visibility</p>
                            <p class="mt-2 text-sm leading-6 text-slate-600">Reports and payment summaries help users see what was delivered, billed, and still needs attention.</p>
                        </div>
                    </div>
                </section>

                <aside class="relative z-10">
                    <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-950 text-white shadow-2xl">
                        <div class="border-b border-white/10 px-6 py-5">
                            <div class="flex items-center justify-between gap-4">
                                <div>
                                    <p class="text-xs font-semibold uppercase tracking-[0.28em] text-blue-200">What the product covers</p>
                                    <h2 class="mt-2 text-2xl font-semibold">A simple operating system for client work</h2>
                                </div>
                                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-500/20 text-blue-200">
                                    <i class="fa-solid fa-layer-group text-xl"></i>
                                </div>
                            </div>
                        </div>

                        <div class="grid gap-4 p-6">
                            <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                                <div class="flex items-start gap-4">
                                    <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-blue-500/20 text-blue-200">
                                        <i class="fa-regular fa-clock"></i>
                                    </div>
                                    <div>
                                        <p class="text-base font-semibold">Live timer and manual time logging</p>
                                        <p class="mt-2 text-sm leading-6 text-slate-300">Useful for freelancers who need billable proof and for teams who want accurate workload data.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                                <div class="flex items-start gap-4">
                                    <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-emerald-500/20 text-emerald-200">
                                        <i class="fa-regular fa-comments"></i>
                                    </div>
                                    <div>
                                        <p class="text-base font-semibold">Workspace chat and task coordination</p>
                                        <p class="mt-2 text-sm leading-6 text-slate-300">Helpful when a team wants fewer context switches between messengers, task boards, and reporting tools.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                                <div class="flex items-start gap-4">
                                    <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-amber-500/20 text-amber-200">
                                        <i class="fa-solid fa-hand-holding-dollar"></i>
                                    </div>
                                    <div>
                                        <p class="text-base font-semibold">Client, project, and payment structure</p>
                                        <p class="mt-2 text-sm leading-6 text-slate-300">Valuable for agencies and service teams that need transparency before invoicing or reviewing profitability.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </section>

        <section id="features" class="border-b border-slate-200 bg-white">
            <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
                <div class="max-w-3xl">
                    <p class="text-sm font-semibold uppercase tracking-[0.28em] text-blue-600">Features</p>
                    <h2 class="mt-4 text-3xl font-semibold text-slate-950 sm:text-4xl">Everything a user needs to understand the product in under a minute</h2>
                    <p class="mt-4 text-base leading-7 text-slate-600">The landing explains the problem, the workflow, and the practical value: track work, organize teams, improve billing discipline, and keep project communication connected to execution.</p>
                </div>

                <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
                    <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-sm">
                            <i class="fa-regular fa-hourglass-half"></i>
                        </div>
                        <h3 class="mt-5 text-xl font-semibold text-slate-900">Timer and timesheets</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-600">Capture work in real time or fill timesheets later without losing the connection to the actual project.</p>
                    </div>
                    <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-600 text-white shadow-sm">
                            <i class="fa-solid fa-list-check"></i>
                        </div>
                        <h3 class="mt-5 text-xl font-semibold text-slate-900">Tasks with accountability</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-600">Break work into visible steps so every team member knows what is in progress, blocked, or ready.</p>
                    </div>
                    <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-500 text-white shadow-sm">
                            <i class="fa-regular fa-chart-bar"></i>
                        </div>
                        <h3 class="mt-5 text-xl font-semibold text-slate-900">Reports that explain the work</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-600">Use summaries, grouped views, and payment context to make team output easier to present and defend.</p>
                    </div>
                    <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-600 text-white shadow-sm">
                            <i class="fa-regular fa-folder-open"></i>
                        </div>
                        <h3 class="mt-5 text-xl font-semibold text-slate-900">Workspace structure</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-600">Keep clients, projects, chat threads, and settings inside one workspace so the product feels coherent from day one.</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="benefits" class="border-b border-slate-200 bg-slate-50">
            <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
                <div class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-start">
                    <div>
                        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-emerald-600">Benefits</p>
                        <h2 class="mt-4 text-3xl font-semibold text-slate-950 sm:text-4xl">Why this is useful to the end user</h2>
                        <p class="mt-4 text-base leading-7 text-slate-600">People adopt products faster when the value is obvious. This page highlights outcomes instead of just tools: better focus, easier collaboration, clearer billing, and more confidence in delivery planning.</p>
                    </div>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                            <p class="text-sm font-semibold text-slate-900">For freelancers</p>
                            <p class="mt-3 text-sm leading-6 text-slate-600">Show what was done, how long it took, and what should be invoiced next.</p>
                        </div>
                        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                            <p class="text-sm font-semibold text-slate-900">For agencies</p>
                            <p class="mt-3 text-sm leading-6 text-slate-600">Keep multiple clients and projects organized without juggling separate spreadsheets and chats.</p>
                        </div>
                        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                            <p class="text-sm font-semibold text-slate-900">For team leads</p>
                            <p class="mt-3 text-sm leading-6 text-slate-600">Understand workload, identify bottlenecks, and talk about progress using actual data.</p>
                        </div>
                        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                            <p class="text-sm font-semibold text-slate-900">For growing teams</p>
                            <p class="mt-3 text-sm leading-6 text-slate-600">Start simple, then use the same workspace to support reporting, payments, and operational clarity.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="share" class="border-b border-slate-200 bg-white">
            <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
                <div class="max-w-3xl">
                    <p class="text-sm font-semibold uppercase tracking-[0.28em] text-violet-600">Growth-ready sections</p>
                    <h2 class="mt-4 text-3xl font-semibold text-slate-950 sm:text-4xl">Blocks that help users recommend and spread the product</h2>
                    <p class="mt-4 text-base leading-7 text-slate-600">To support organic growth, the landing now includes language that is easy to repeat in a conversation: what the product is, who it helps, and why teams trust it enough to share with colleagues.</p>
                </div>

                <div class="mt-10 grid gap-6 lg:grid-cols-3">
                    <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-600 text-white shadow-sm">
                            <i class="fa-solid fa-share-nodes"></i>
                        </div>
                        <h3 class="mt-5 text-xl font-semibold text-slate-900">Easy to explain</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-600">The copy clearly describes TimeVic as a workspace for time, tasks, chat, clients, and payments, making word-of-mouth promotion easier.</p>
                    </div>
                    <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-sm">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <h3 class="mt-5 text-xl font-semibold text-slate-900">Built for team invites</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-600">The landing speaks to freelancers, agencies, and managers separately, so every visitor can quickly see who else should join.</p>
                    </div>
                    <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-600 text-white shadow-sm">
                            <i class="fa-solid fa-bullhorn"></i>
                        </div>
                        <h3 class="mt-5 text-xl font-semibold text-slate-900">Promotion-friendly CTA</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-600">Strong entry points like the live demo and quick start CTA help visitors forward the product internally with less friction.</p>
                    </div>
                </div>

                <div class="mt-10 rounded-[2rem] border border-slate-200 bg-slate-950 p-8 text-white shadow-xl">
                    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
                        <div>
                            <p class="text-sm font-semibold uppercase tracking-[0.28em] text-blue-200">Ready to explore</p>
                            <h3 class="mt-3 text-3xl font-semibold">See the workspace users will talk about after one quick walkthrough</h3>
                            <p class="mt-4 max-w-3xl text-sm leading-6 text-slate-300">A clear landing page increases conversion and makes the product easier to recommend. New visitors now understand what TimeVic does, why it matters, and how to try it immediately.</p>
                        </div>
                        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
                            <a href="@SiteUrl.Registration_Step1" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-white/15 bg-white/5 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-white/10">
                                <i class="fa-solid fa-user-plus"></i>
                                <span>Create account</span>
                            </a>
                            <a href="@SiteUrl.LoginAsDemo" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-blue-700">
                                <i class="fa-solid fa-flask"></i>
                                <span>Login as demo</span>
                            </a>
                            <a href="@SiteUrl.Login" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-white/15 bg-white/5 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-white/10">
                                <i class="fa-solid fa-arrow-right-to-bracket"></i>
                                <span>Sign in</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-white">
            <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
                <div class="grid gap-6 lg:grid-cols-3">
                    <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
                        <p class="text-sm font-semibold text-slate-900">What is TimeVic?</p>
                        <p class="mt-3 text-sm leading-6 text-slate-600">A team workspace for tracking time, coordinating work, managing clients, and understanding performance.</p>
                    </div>
                    <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
                        <p class="text-sm font-semibold text-slate-900">Why use it?</p>
                        <p class="mt-3 text-sm leading-6 text-slate-600">It helps users replace fragmented tools with one workflow that is easier to review and easier to explain.</p>
                    </div>
                    <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
                        <p class="text-sm font-semibold text-slate-900">Why share it?</p>
                        <p class="mt-3 text-sm leading-6 text-slate-600">Because the value proposition is now visible at a glance, visitors can quickly recommend it to a manager, teammate, or client-facing lead.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>
