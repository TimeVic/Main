@page "/pricing"

@using LumexUI.Common
@using Layout = TimeTracker.Web.Ui.Pages.Landing.Shared.Layout

@layout Layout

<SeoHead
    Title="@SiteMetadata.PricingTitle"
    Description="@SiteMetadata.PricingDescription"
    Keywords="@SiteMetadata.PricingKeywords"
    Robots="@SiteMetadata.IndexRobots"
    CanonicalUrl="@SiteMetadata.ToAbsoluteUrl(SiteUrl.Pricing)" />

<main class="bg-white text-slate-950">

    @* 1. Hero *@
    <section class="relative overflow-hidden border-b border-slate-200 bg-gradient-to-b from-slate-50 to-white">
        <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 lg:py-28">
            <h1 class="text-4xl font-semibold leading-tight text-slate-950 sm:text-5xl lg:text-6xl">
                Track your work.<br />Understand your money.
            </h1>
            <p class="mx-auto mt-6 max-w-xl text-base leading-7 text-slate-500 sm:text-lg">
                See how much you've earned, what's been paid, and who still owes you — without spreadsheets.
            </p>

            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <a href="@SiteUrl.Registration_Step1" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-slate-900 px-7 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-800">
                    Start tracking your earnings
                </a>
                <a href="@SiteUrl.UseCases" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 px-7 py-3.5 text-sm font-semibold text-slate-600 transition hover:border-slate-300 hover:bg-slate-50">
                    See how it works
                </a>
            </div>
            <p class="mt-4 text-xs text-slate-400">Free. No credit card required.</p>
        </div>
    </section>

    @* 2. Price statement *@
    <section class="border-b border-slate-200 bg-white">
        <div class="mx-auto max-w-sm px-4 py-14 text-center sm:px-6">
            <p class="text-4xl font-bold text-slate-950">Free — $0<span class="text-xl font-normal text-slate-400">/month</span></p>
            <p class="mt-3 text-sm text-slate-400">No credit card required</p>
        </div>
    </section>

    @* 3. Value explanation *@
    <section class="border-b border-slate-200 bg-slate-50">
        <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
            <div class="mb-10 max-w-xl">
                <h2 class="text-3xl font-semibold text-slate-950 sm:text-4xl">From hours to money clarity</h2>
            </div>

            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
                <div class="rounded-[1.5rem] border border-slate-200 bg-white p-6">
                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 text-slate-600">
                        <i class="fa-regular fa-clock"></i>
                    </div>
                    <h3 class="mt-5 text-base font-semibold text-slate-900">Track work</h3>
                    <p class="mt-1.5 text-sm leading-6 text-slate-500">Log time by client, project, and task.</p>
                </div>

                <div class="rounded-[1.5rem] border border-emerald-100 bg-emerald-50 p-6">
                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">
                        <i class="fa-solid fa-arrow-right-arrow-left"></i>
                    </div>
                    <h3 class="mt-5 text-base font-semibold text-slate-900">Turn time into money</h3>
                    <p class="mt-1.5 text-sm leading-6 text-slate-600">Automatically calculate earnings using hourly rates.</p>
                    <p class="mt-3 text-xs font-semibold text-emerald-600">earned</p>
                </div>

                <div class="rounded-[1.5rem] border border-blue-100 bg-blue-50 p-6">
                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-100 text-blue-700">
                        <i class="fa-solid fa-hand-holding-dollar"></i>
                    </div>
                    <h3 class="mt-5 text-base font-semibold text-slate-900">Track payments</h3>
                    <p class="mt-1.5 text-sm leading-6 text-slate-600">Record what clients have paid you.</p>
                    <p class="mt-3 text-xs font-semibold text-blue-600">paid</p>
                </div>

                <div class="rounded-[1.5rem] border border-red-100 bg-red-50 p-6">
                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-red-100 text-red-600">
                        <i class="fa-regular fa-circle-dot"></i>
                    </div>
                    <h3 class="mt-5 text-base font-semibold text-slate-900">See what's missing</h3>
                    <p class="mt-1.5 text-sm leading-6 text-slate-600">Instantly see unpaid work and outstanding balances.</p>
                    <p class="mt-3 text-xs font-semibold text-red-500">unpaid</p>
                </div>
            </div>
        </div>
    </section>

    @* 4. What you actually get *@
    <section class="border-b border-slate-200 bg-white">
        <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:py-20">
            <h2 class="text-2xl font-semibold text-slate-950 sm:text-3xl">What you can do with TimeVic</h2>
            <ul class="mt-8 space-y-4">
                @foreach (var item in _capabilities)
                {
                    <li class="flex items-start gap-3">
                        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500">
                            <i class="fa-solid fa-check text-[9px]"></i>
                        </span>
                        <span class="text-sm leading-6 text-slate-700">@item</span>
                    </li>
                }
            </ul>
        </div>
    </section>

    @* 5. Trust section *@
    <section class="border-b border-slate-200 bg-slate-50">
        <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 lg:py-20">
            <h2 class="text-2xl font-semibold text-slate-950 sm:text-3xl">Simple and transparent</h2>
            <p class="mx-auto mt-5 max-w-xl text-base leading-7 text-slate-500">
                TimeVic is free to use. The focus is on helping freelancers understand their income, not just track time.
            </p>
        </div>
    </section>

    @* 6. Final CTA *@
    <section class="bg-slate-950 text-white">
        <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 lg:py-20">
            <h2 class="text-3xl font-semibold leading-tight sm:text-4xl">
                Start tracking your time and income
            </h2>
            <div class="mt-8">
                <a href="@SiteUrl.Registration_Step1" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-8 py-3.5 text-sm font-semibold text-slate-900 shadow-sm transition hover:bg-slate-100">
                    Start for free
                </a>
            </div>
            <p class="mt-4 text-sm text-slate-400">No credit card required</p>
        </div>
    </section>

</main>

@code {
    private static readonly string[] _capabilities =
    [
        "Time tracking per client and project",
        "Hourly rates → automatic earnings calculation",
        "Payment tracking",
        "Paid vs unpaid overview",
        "Client-level summaries",
    ];
}
