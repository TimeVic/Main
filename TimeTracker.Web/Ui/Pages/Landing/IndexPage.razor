@page "/"
@page "/uk"

@using Layout = TimeTracker.Web.Ui.Pages.Landing.Shared.LandingLayout
@inherits BaseReactiveComponent
@layout Layout

@inject IStringLocalizer<PublicLandingResource> SharedLocalizer
@inject IStringLocalizer<IndexPage> Localizer
<SeoHead
    Title="@Localizer["Meta_Title"]"
    Description="@Localizer["Meta_Description"]"
    Keywords="@Localizer["Meta_Keywords"]"
    Robots="@SiteMetadata.IndexRobots"
    CanonicalUrl="@SiteMetadata.ToAbsoluteUrl(SiteUrl.Main)" />

<main>
        <section class="relative overflow-hidden border-b border-slate-200 bg-gradient-to-br from-blue-50 via-white to-emerald-50">
            <div class="absolute inset-x-0 top-0 h-64 bg-[radial-gradient(circle_at_top_right,_rgba(37,99,235,0.14),_transparent_40%)]"></div>
            <div class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(320px,480px)] lg:px-8 lg:py-24">
                <section class="relative z-10">
                    <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-white px-4 py-2 text-sm font-semibold text-blue-700 shadow-sm">
                        <i class="fa-solid fa-bolt"></i>
                        <span>@Localizer["Content_ForFreelanceDevelopersWorkingWithMultipleClients"]</span>
                    </div>
                    <h1 class="mt-6 max-w-4xl text-4xl font-semibold leading-tight text-slate-950 sm:text-5xl lg:text-6xl">@Localizer["Content_TrackTimeSeeMoneyKnowWhoOwesYou"]</h1>
                    <p class="mt-6 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">@Localizer["Content_TimevicHelpsFreelanceDevelopersTrackHoursCalculateEarningsAndSee"]</p>

                    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                        <a href="@SiteUrl.Registration_Step1" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">
                            <i class="fa-solid fa-rocket"></i>
                            <span>@SharedLocalizer["CTA_RegisterIncomeFree"]</span>
                        </a>
                        <a href="@SiteUrl.LoginAsDemo" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-6 py-3.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50">
                            <i class="fa-regular fa-eye"></i>
                            <span>@SharedLocalizer["CTA_DemoDashboard"]</span>
                        </a>
                    </div>
                    <p class="mt-3 text-sm font-medium text-slate-500">@SharedLocalizer["CTA_NoCreditCardRequired"]</p>

                    <div class="mt-10 grid gap-4 sm:grid-cols-3">
                        <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
                            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-blue-600">@Localizer["Content_Track"]</p>
                            <p class="mt-3 text-lg font-semibold text-slate-900">@Localizer["Content_HoursByClientAndProject"]</p>
                            <p class="mt-2 text-sm leading-6 text-slate-600">@Localizer["Content_LogBillableWorkAgainstTheRightClientProjectAndTask"]</p>
                        </div>
                        <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
                            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-emerald-600">@Localizer["Content_Earn"]</p>
                            <p class="mt-3 text-lg font-semibold text-slate-900">@Localizer["Content_EarningsCalculatedFromRates"]</p>
                            <p class="mt-2 text-sm leading-6 text-slate-600">@Localizer["Content_SetHourlyRatesAndLetTimevicTurnTrackedHoursInto"]</p>
                        </div>
                        <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
                            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-amber-600">@Localizer["Content_Monetize"]</p>
                            <p class="mt-3 text-lg font-semibold text-slate-900">@Localizer["Content_PaidAndUnpaidWork"]</p>
                            <p class="mt-2 text-sm leading-6 text-slate-600">@Localizer["Content_SeeWhatWasPaidWhatIsUnpaidAndWhichClient"]</p>
                        </div>
                    </div>
                </section>

                <aside class="relative z-10">
                    <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-950 text-white shadow-2xl">
                        <div class="border-b border-white/10 px-6 py-5">
                            <div class="flex items-center justify-between gap-4">
                                <div>
                                    <p class="text-xs font-semibold uppercase tracking-[0.28em] text-blue-200">@Localizer["Content_IncomeClarity"]</p>
                                    <h2 class="mt-2 text-2xl font-semibold">@Localizer["Content_WorkEarningsAndPaymentsInOneView"]</h2>
                                </div>
                                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-500/20 text-blue-200">
                                    <i class="fa-solid fa-layer-group text-xl"></i>
                                </div>
                            </div>
                        </div>

                        <div class="grid gap-4 p-6">
                            <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                                <div class="flex items-start gap-4">
                                    <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-blue-500/20 text-blue-200">
                                        <i class="fa-regular fa-clock"></i>
                                    </div>
                                    <div>
                                        <p class="text-base font-semibold">@Localizer["Content_TrackTimeAcrossClientsAndProjects"]</p>
                                        <p class="mt-2 text-sm leading-6 text-slate-300">@Localizer["Content_RecordBillableHoursWhereTheyBelongWhetherYouUseA"]</p>
                                    </div>
                                </div>
                            </div>
                            <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                                <div class="flex items-start gap-4">
                                    <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-emerald-500/20 text-emerald-200">
                                        <i class="fa-regular fa-comments"></i>
                                    </div>
                                    <div>
                                        <p class="text-base font-semibold">@Localizer["Content_ConnectTasksToTimeEntries"]</p>
                                        <p class="mt-2 text-sm leading-6 text-slate-300">@Localizer["Content_KeepTaskTrackingSimpleAndLinkEachPieceOfWork"]</p>
                                    </div>
                                </div>
                            </div>
                            <div class="rounded-3xl border border-white/10 bg-white/5 p-5">
                                <div class="flex items-start gap-4">
                                    <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-amber-500/20 text-amber-200">
                                        <i class="fa-solid fa-hand-holding-dollar"></i>
                                    </div>
                                    <div>
                                        <p class="text-base font-semibold">@Localizer["Content_ClientBalancesYouCanTrust"]</p>
                                        <p class="mt-2 text-sm leading-6 text-slate-300">@Localizer["Content_SeeTotalEarnedTotalPaidAndTheOutstandingBalanceFor"]</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </section>

        <section id="features" class="border-b border-slate-200 bg-white">
            <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
                <div class="max-w-3xl">
                    <p class="text-sm font-semibold uppercase tracking-[0.28em] text-blue-600">@Localizer["Content_Features"]</p>
                    <h2 class="mt-4 text-3xl font-semibold text-slate-950 sm:text-4xl">@Localizer["Content_TurnTrackedTimeIntoIncomeInsights"]</h2>
                    <p class="mt-4 text-base leading-7 text-slate-600">@Localizer["Content_TrackWorkMoneyAndPaymentsInOnePlaceSoYou"]</p>
                </div>

                <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
                    <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-sm">
                            <i class="fa-regular fa-hourglass-half"></i>
                        </div>
                        <h3 class="mt-5 text-xl font-semibold text-slate-900">@Localizer["Content_TrackTimeAcrossMultipleClientsAndProjects"]</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-600">@Localizer["Content_CaptureBillableHoursInRealTimeOrAddThemLater"]</p>
                    </div>
                    <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-600 text-white shadow-sm">
                            <i class="fa-solid fa-list-check"></i>
                        </div>
                        <h3 class="mt-5 text-xl font-semibold text-slate-900">@Localizer["Content_SetHourlyRatesAndAutomaticallyCalculateEarnings"]</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-600">@Localizer["Content_AssignRatesToYourWorkAndSeeHowEveryEntry"]</p>
                    </div>
                    <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-500 text-white shadow-sm">
                            <i class="fa-regular fa-chart-bar"></i>
                        </div>
                        <h3 class="mt-5 text-xl font-semibold text-slate-900">@Localizer["Content_SeePaidVsUnpaidWorkPerClient"]</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-600">@Localizer["Content_CompareEarnedTotalsWithPaymentsReceivedAndSpotOutstandingBalances"]</p>
                    </div>
                    <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-600 text-white shadow-sm">
                            <i class="fa-regular fa-folder-open"></i>
                        </div>
                        <h3 class="mt-5 text-xl font-semibold text-slate-900">@Localizer["Content_GetClearSummariesOfYourIncome"]</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-600">@Localizer["Content_ReviewEarningsByClientProjectDateOrTaskBeforeInvoicing"]</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="benefits" class="border-b border-slate-200 bg-slate-50">
            <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
                <div class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-start">
                    <div>
                        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-emerald-600">@Localizer["Content_ClientAndProjectView"]</p>
                        <h2 class="mt-4 text-3xl font-semibold text-slate-950 sm:text-4xl">@Localizer["Content_SeeExactlyHowMuchEachClientOwesYou"]</h2>
                        <p class="mt-4 text-base leading-7 text-slate-600">@Localizer["Content_TimevicConnectsTrackedHoursHourlyRatesAndReceivedPaymentsSo"]</p>
                    </div>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                            <p class="text-sm font-semibold text-slate-900">@Localizer["Content_TotalEarned"]</p>
                            <p class="mt-3 text-sm leading-6 text-slate-600">@Localizer["Content_KnowHowMuchBillableWorkYouHaveCompletedForEach"]</p>
                        </div>
                        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                            <p class="text-sm font-semibold text-slate-900">@Localizer["Content_TotalPaid"]</p>
                            <p class="mt-3 text-sm leading-6 text-slate-600">@Localizer["Content_RecordReceivedPaymentsAndCompareThemAgainstYourEarnedTotals"]</p>
                        </div>
                        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                            <p class="text-sm font-semibold text-slate-900">@Localizer["Content_OutstandingBalance"]</p>
                            <p class="mt-3 text-sm leading-6 text-slate-600">@Localizer["Content_SeeExactlyHowMuchEachClientHasPaidAndWhat"]</p>
                        </div>
                        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                            <p class="text-sm font-semibold text-slate-900">@Localizer["Content_InvoiceReadyDetail"]</p>
                            <p class="mt-3 text-sm leading-6 text-slate-600">@Localizer["Content_OpenAClientOrProjectAndReviewTheWorkMoney"]</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="share" class="border-b border-slate-200 bg-white">
            <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
                <div class="max-w-3xl">
                    <p class="text-sm font-semibold uppercase tracking-[0.28em] text-violet-600">@Localizer["Content_TasksAndIntegrations"]</p>
                    <h2 class="mt-4 text-3xl font-semibold text-slate-950 sm:text-4xl">@Localizer["Content_SimpleTaskTrackingConnectedToYourTimeEntries"]</h2>
                    <p class="mt-4 text-base leading-7 text-slate-600">@Localizer["Content_KeepTasksLightweightConnectThemToBillableHoursAndLink"]</p>
                </div>

                <div class="mt-10 grid gap-6 lg:grid-cols-3">
                    <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-600 text-white shadow-sm">
                            <i class="fa-solid fa-share-nodes"></i>
                        </div>
                        <h3 class="mt-5 text-xl font-semibold text-slate-900">@Localizer["Content_TasksWithoutProjectManagementOverhead"]</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-600">@Localizer["Content_SimpleTaskTrackingConnectedToYourTimeEntriesWithoutThe"]</p>
                    </div>
                    <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-sm">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <h3 class="mt-5 text-xl font-semibold text-slate-900">@Localizer["Content_JiraLinksWhenYouNeedThem"]</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-600">@Localizer["Content_TrackTimeInTimevicAndLinkItToYourJira"]</p>
                    </div>
                    <div class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-600 text-white shadow-sm">
                            <i class="fa-solid fa-bullhorn"></i>
                        </div>
                        <h3 class="mt-5 text-xl font-semibold text-slate-900">@Localizer["Content_OptionalSyncForClientWorkflows"]</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-600">@Localizer["Content_UseTimevicForTimeEarningsAndPaymentClarityWhileKeeping"]</p>
                    </div>
                </div>

                <div class="mt-10 rounded-[2rem] border border-slate-200 bg-slate-950 p-8 text-white shadow-xl">
                    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
                        <div>
                            <p class="text-sm font-semibold uppercase tracking-[0.28em] text-blue-200">@Localizer["Content_ReadyToSeeYourNumbers"]</p>
                            <h3 class="mt-3 text-3xl font-semibold">@Localizer["Content_StartTrackingWorkMoneyAndPaymentsInOnePlace"]</h3>
                            <p class="mt-4 max-w-3xl text-sm leading-6 text-slate-300">@Localizer["Content_UseTimevicToTurnBillableHoursIntoClearClientBalances"]</p>
                        </div>
                        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
                            <a href="@SiteUrl.Registration_Step1" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-blue-700">
                                <i class="fa-solid fa-user-plus"></i>
                                <span>@SharedLocalizer["CTA_RegisterIncomeFree"]</span>
                            </a>
                            <a href="@SiteUrl.LoginAsDemo" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-white/15 bg-white/5 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-white/10">
                                <i class="fa-regular fa-eye"></i>
                                <span>@SharedLocalizer["CTA_Demo"]</span>
                            </a>
                            <p class="text-center text-sm text-slate-300 sm:text-left lg:text-center">
                                @Localizer["Content_AlreadyHaveAnAccount"]
                                <a href="@SiteUrl.Login" class="font-semibold text-white underline underline-offset-4 transition hover:text-blue-100">@SharedLocalizer["CTA_Login"]</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-white">
            <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
                <div class="grid gap-6 lg:grid-cols-3">
                    <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
                        <p class="text-sm font-semibold text-slate-900">@Localizer["Content_WhatIsTimevic"]</p>
                        <p class="mt-3 text-sm leading-6 text-slate-600">@Localizer["Content_AFocusedTimeIncomeAndPaymentTrackerForFreelanceDevelopers"]</p>
                    </div>
                    <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
                        <p class="text-sm font-semibold text-slate-900">@Localizer["Content_WhyUseIt"]</p>
                        <p class="mt-3 text-sm leading-6 text-slate-600">@Localizer["Content_ItShowsHowMuchYouEarnedHowMuchWasPaid"]</p>
                    </div>
                    <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
                        <p class="text-sm font-semibold text-slate-900">@Localizer["Content_WhyKeepTasksHere"]</p>
                        <p class="mt-3 text-sm leading-6 text-slate-600">@Localizer["Content_BecauseLightweightTasksKeepTimeEntriesConnectedToRealWork"]</p>
                    </div>
                </div>
            </div>
        </section>
    </main>
