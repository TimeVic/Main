                Exclude="node_modules\**\*.less;wwwroot\**\*.less;styles\**\*.less;Ignore\**\*.less"
            />
            <BootstrapFiles Include="$(ProjectDir)node_modules/bootstrap/dist/**/*.*" />
        </ItemGroup>

        <!-- Compile .less → .css -->
        <Exec Command="npm install" />
        <Exec Command="node $(ProjectDir)node_modules/less/bin/lessc %(LessFiles.Identity) %(LessFiles.RelativeDir)%(Filename).css" />
        <Exec Command="node $(ProjectDir)node_modules/less/bin/lessc styles/app.less wwwroot/app.css" />
        <Copy SourceFiles="@(BootstrapFiles)"
              DestinationFolder="wwwroot/lib/bootstrap/%(RecursiveDir)" />
    </Target>


</Project>
