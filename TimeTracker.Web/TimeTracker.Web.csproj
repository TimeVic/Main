    <PropertyGroup>
        <TailwindToolsDir Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(USERPROFILE)\.tailwind\</TailwindToolsDir>
        <TailwindToolsDir Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(HOME)/.tailwind/</TailwindToolsDir>

        <TailwindExePath Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(TailwindToolsDir)tailwindcss-windows-x64.exe</TailwindExePath>
        <TailwindExePath Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(TailwindToolsDir)tailwindcss-macos-x64</TailwindExePath>
        <TailwindExePath Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(TailwindToolsDir)tailwindcss-linux-x64</TailwindExePath>

        <TailwindDownloadUrl Condition="$([MSBuild]::IsOSPlatform('Windows'))">https://github.com/tailwindlabs/tailwindcss/releases/download/v3.4.19/tailwindcss-windows-x64.exe</TailwindDownloadUrl>
        <TailwindDownloadUrl Condition="$([MSBuild]::IsOSPlatform('OSX'))">https://github.com/tailwindlabs/tailwindcss/releases/download/v3.4.19/tailwindcss-macos-x64</TailwindDownloadUrl>
        <TailwindDownloadUrl Condition="$([MSBuild]::IsOSPlatform('Linux'))">https://github.com/tailwindlabs/tailwindcss/releases/download/v3.4.19/tailwindcss-linux-x64</TailwindDownloadUrl>

        <TailwindInputCss>$(ProjectDir)wwwroot\app.css</TailwindInputCss>
        <TailwindOutputCss>$(ProjectDir)wwwroot\app.min.css</TailwindOutputCss>
    </PropertyGroup>
    
    <Target Name="CompileLess" BeforeTargets="Build;PrepareForPublish">
        <!-- Compile .less → .css -->
        <Exec Command="npm install" />
        
        <ItemGroup>
            <LessFiles 
                Include="**\*.less"
                Exclude="node_modules\**\*.less;wwwroot\**\*.less;styles\**\*.less;Ignore\**\*.less"
            />
            <BootstrapFiles Include="$(ProjectDir)node_modules/bootstrap/dist/**/*.*" />
        </ItemGroup>
        
        <Exec Command="node $(ProjectDir)node_modules/less/bin/lessc %(LessFiles.Identity) %(LessFiles.RelativeDir)%(Filename).css" />
        <Exec Command="node $(ProjectDir)node_modules/less/bin/lessc styles/app.less wwwroot/app.css" />
        <Copy SourceFiles="@(BootstrapFiles)"
              DestinationFolder="wwwroot/lib/bootstrap/%(RecursiveDir)" />
    </Target>

    <Target Name="TailwindCssBuild" BeforeTargets="Build;PrepareForPublish">
        <Message Text="Checking for Tailwind CLI for your OS..."/>
        <MakeDir Directories="$(TailwindToolsDir)" />

        <DownloadFile Condition="!Exists($(TailwindExePath))"
                      SourceUrl="$(TailwindDownloadUrl)"
                      DestinationFolder="$(TailwindToolsDir)"
                      DestinationFileName="$([System.IO.Path]::GetFileName($(TailwindExePath)))" />

        <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
              Command="chmod +x $(TailwindExePath)" />

        <Message Text="Building Tailwind CSS..." />
        <Exec Command="$(TailwindExePath) -i $(TailwindInputCss) -o $(TailwindOutputCss) --minify" />
    </Target>
