@using Microsoft.AspNetCore.Components.Routing
@using Fluxor
@using TimeTracker.Client.Core.Constants
@using TimeTracker.Client.Core.Core.Extensions
@using TimeTracker.Client.Core.Services.Security
@using TimeTracker.Client.Core.Store.Permissions
@using TimeTracker.Client.Core.Store.Auth
@inject NavigationManager NavigationManager
@inject ISecurityManager SecurityManager
@inject IState<WorkspacePermissionsState> WorkspacePermissionsState
@inject IState<AuthState> AuthState
@implements IDisposable

@if (_hasAccess)
{
    <RouteView RouteData="@RouteData" DefaultLayout="@DefaultLayout" />
}

@code {
    [Parameter]
    public RouteData RouteData { get; set; } = default!;

    [Parameter]
    public Type? DefaultLayout { get; set; }

    private bool _hasAccess = true;

    protected override void OnInitialized()
    {
        WorkspacePermissionsState.StateChanged += OnPermissionsChanged;
        AuthState.StateChanged += OnAuthStateChanged;
    }

    protected override void OnParametersSet()
    {
        CheckRouteAccess();
    }

    private bool HasRouteAccess()
    {
        var attributes = RouteData.PageType
            .GetCustomAttributes(typeof(RequireWorkspacePermissionAttribute), true)
            .Cast<RequireWorkspacePermissionAttribute>()
            .ToList();

        if (attributes.Any()
            && WorkspacePermissionsState.Value.IsLoaded
            && !attributes.All(attribute => SecurityManager.HasPermission(attribute.Permission)))
        {
            return false;
        }

        var roleAttributes = RouteData.PageType
            .GetCustomAttributes(typeof(RequireWorkspaceRoleAttribute), true)
            .Cast<RequireWorkspaceRoleAttribute>()
            .ToList();

        return AuthState.Value.Workspace == null
            || roleAttributes.All(attribute => attribute.AllowedRoles.Contains(AuthState.Value.AccessLevel));
    }

    private void CheckRouteAccess()
    {
        _hasAccess = HasRouteAccess();
        if (!_hasAccess && NavigationManager.GetPath() != ClientSiteUrl.Error403)
        {
            var redirectUrl = RouteData.PageType
                .GetCustomAttributes(typeof(RequireWorkspacePermissionAttribute), true)
                .Cast<RequireWorkspacePermissionAttribute>()
                .Select(attribute => attribute.UnauthorizedUserRedirectUrl)
                .FirstOrDefault(url => !string.IsNullOrWhiteSpace(url));

            NavigationManager.NavigateTo(
                AuthState.Value.IsRoleUser && !string.IsNullOrWhiteSpace(redirectUrl)
                    ? $"/board/{redirectUrl}"
                    : ClientSiteUrl.Error403
            );
        }
    }

    private void OnPermissionsChanged(object? sender, EventArgs args)
    {
        InvokeAsync(() =>
        {
            CheckRouteAccess();
            StateHasChanged();
        });
    }

    private void OnAuthStateChanged(object? sender, EventArgs args)
    {
        InvokeAsync(() =>
        {
            CheckRouteAccess();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        WorkspacePermissionsState.StateChanged -= OnPermissionsChanged;
        AuthState.StateChanged -= OnAuthStateChanged;
    }
}
