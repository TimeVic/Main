@using System.Globalization

<div class="select-none p-3 w-[280px] bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 @Class">
    <!-- Header: Prev, Month Year, Next -->
    <div class="flex items-center justify-between mb-3 px-1">
        <button
            type="button"
            class="w-7 h-7 flex items-center justify-center rounded-lg text-slate-500 hover:text-slate-800 hover:bg-slate-100 dark:text-slate-400 dark:hover:text-slate-200 dark:hover:bg-slate-700/60 transition-colors cursor-pointer"
            @onclick="PreviousMonth"
            @onclick:stopPropagation="true"
            aria-label="@CommonLocalizer["Calendar_PreviousMonth"]">
            <i class="fa-solid fa-chevron-left text-xs"></i>
        </button>

        <div class="text-sm font-semibold text-slate-800 dark:text-slate-100 capitalize">
            @_displayMonth.ToString("MMMM yyyy", CultureInfo.CurrentUICulture)
        </div>

        <button
            type="button"
            class="w-7 h-7 flex items-center justify-center rounded-lg text-slate-500 hover:text-slate-800 hover:bg-slate-100 dark:text-slate-400 dark:hover:text-slate-200 dark:hover:bg-slate-700/60 transition-colors cursor-pointer"
            @onclick="NextMonth"
            @onclick:stopPropagation="true"
            aria-label="@CommonLocalizer["Calendar_NextMonth"]">
            <i class="fa-solid fa-chevron-right text-xs"></i>
        </button>
    </div>

    <!-- Weekday Labels -->
    <div class="grid grid-cols-7 mb-1 text-center text-xs font-medium">
        <span class="py-1 text-slate-400 dark:text-slate-500">@GetDayName(DayOfWeek.Monday)</span>
        <span class="py-1 text-slate-400 dark:text-slate-500">@GetDayName(DayOfWeek.Tuesday)</span>
        <span class="py-1 text-slate-400 dark:text-slate-500">@GetDayName(DayOfWeek.Wednesday)</span>
        <span class="py-1 text-slate-400 dark:text-slate-500">@GetDayName(DayOfWeek.Thursday)</span>
        <span class="py-1 text-slate-400 dark:text-slate-500">@GetDayName(DayOfWeek.Friday)</span>
        <span class="py-1 text-rose-500 dark:text-rose-400">@GetDayName(DayOfWeek.Saturday)</span>
        <span class="py-1 text-rose-500 dark:text-rose-400">@GetDayName(DayOfWeek.Sunday)</span>
    </div>

    <!-- 42 Days Grid (6 weeks x 7 days) -->
    <div class="grid grid-cols-7 gap-y-1 gap-x-1 text-center text-xs">
        @foreach (var day in GetCalendarDays())
        {
            var isCurrentMonth = day.Month == _displayMonth.Month;
            var isSelected = Value.HasValue && day.Date == Value.Value.Date;
            var isToday = day.Date == DateTime.Today;
            var isWeekend = day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday;
            var isDisabled = DisabledDateFunc?.Invoke(day) ?? false;

            <button
                type="button"
                disabled="@isDisabled"
                @onclick="() => SelectDate(day)"
                @onclick:stopPropagation="true"
                class="w-8 h-8 mx-auto flex items-center justify-center rounded-lg transition-all text-xs cursor-pointer
                    @(isSelected 
                        ? "bg-blue-600 text-white font-semibold shadow-xs hover:bg-blue-700" 
                        : isToday 
                            ? "border border-blue-500 font-semibold " + (isCurrentMonth ? (isWeekend ? "text-rose-500 dark:text-rose-400" : "text-slate-800 dark:text-slate-100") : "text-slate-400 dark:text-slate-500")
                            : !isCurrentMonth 
                                ? "text-slate-300 dark:text-slate-600 hover:bg-slate-100 dark:hover:bg-slate-700/40" 
                                : isWeekend 
                                    ? "text-rose-500 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30" 
                                    : "text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700/60")
                    @(isDisabled ? "opacity-25 cursor-not-allowed pointer-events-none" : "")">
                @day.Day
            </button>
        }
    </div>
</div>

@code {
    [Parameter]
    public DateTime? Value { get; set; }

    [Parameter]
    public EventCallback<DateTime> ValueChanged { get; set; }

    [Parameter]
    public Func<DateTime, bool>? DisabledDateFunc { get; set; }

    [Parameter]
    public string Class { get; set; } = string.Empty;

    private DateTime _displayMonth = DateTime.Today;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Value.HasValue && Value.Value != default)
        {
            _displayMonth = new DateTime(Value.Value.Year, Value.Value.Month, 1);
        }
    }

    private void PreviousMonth()
    {
        _displayMonth = _displayMonth.AddMonths(-1);
    }

    private void NextMonth()
    {
        _displayMonth = _displayMonth.AddMonths(1);
    }

    private async Task SelectDate(DateTime date)
    {
        if (date.Month != _displayMonth.Month)
        {
            _displayMonth = new DateTime(date.Year, date.Month, 1);
        }
        await ValueChanged.InvokeAsync(date);
    }

    private List<DateTime> GetCalendarDays()
    {
        var firstDayOfMonth = new DateTime(_displayMonth.Year, _displayMonth.Month, 1);
        var dayOfWeek = (int)firstDayOfMonth.DayOfWeek;
        // Adjust so Monday is 0, Sunday is 6
        var offset = (dayOfWeek == 0 ? 7 : dayOfWeek) - 1;

        var startDate = firstDayOfMonth.AddDays(-offset);
        var days = new List<DateTime>(42);

        for (int i = 0; i < 42; i++)
        {
            days.Add(startDate.AddDays(i));
        }

        return days;
    }

    private string GetDayName(DayOfWeek dayOfWeek)
    {
        return dayOfWeek switch
        {
            DayOfWeek.Monday => CommonLocalizer["Day_Monday_Short"],
            DayOfWeek.Tuesday => CommonLocalizer["Day_Tuesday_Short"],
            DayOfWeek.Wednesday => CommonLocalizer["Day_Wednesday_Short"],
            DayOfWeek.Thursday => CommonLocalizer["Day_Thursday_Short"],
            DayOfWeek.Friday => CommonLocalizer["Day_Friday_Short"],
            DayOfWeek.Saturday => CommonLocalizer["Day_Saturday_Short"],
            DayOfWeek.Sunday => CommonLocalizer["Day_Sunday_Short"],
            _ => string.Empty
        };
    }
}
