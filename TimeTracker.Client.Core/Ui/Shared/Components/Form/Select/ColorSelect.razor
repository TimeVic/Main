@inherits Microsoft.AspNetCore.Components.Forms.InputBase<string?>
@using TimeTracker.Client.Core.Constants.Ui
@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Select.Core

<div
    class="@Class @(FullWidth ? "w-full" : "")">
    <AppSelect
        TValue="string"
        Value="@CurrentValue"
        ValueChanged="@OnColorSelected"
        Items="@ColorCodes"
        Label="@Label"
        Placeholder="@LocalizedPlaceholder"
        IsDisabled="@Disabled"
        IsClearable="@Clearable"
        IsFullWidth="@FullWidth"
        Variant="@ResolvedVariant">
        <TriggerContent>
            @if (!string.IsNullOrEmpty(CurrentValue))
            {
                <span
                    class="inline-flex items-center gap-2">
                    <span
                        class="inline-block h-4 w-4 rounded-full border border-slate-200 shadow-xs shrink-0"
                        style="@GetColorStyle(CurrentValue)">
                    </span>
                    <span
                        class="font-mono text-xs">
                        @CurrentValue
                    </span>
                </span>
            }
            else
            {
                <span
                    class="text-slate-400">
                    @LocalizedPlaceholder
                </span>
            }
        </TriggerContent>
        <ItemTemplate Context="color">
            <span
                class="inline-flex items-center gap-2">
                <span
                    class="inline-block h-4 w-4 rounded-full border border-slate-200 shadow-xs shrink-0"
                    style="@GetColorStyle(color)">
                </span>
                <span
                    class="font-mono text-xs">
                    @color
                </span>
            </span>
        </ItemTemplate>
    </AppSelect>
    @if (HasError)
    {
        <p
            class="mt-1 text-xs text-red-600">
            @FirstError
        </p>
    }
</div>
