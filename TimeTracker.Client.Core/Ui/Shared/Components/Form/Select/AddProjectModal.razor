@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Validation

@inherits BaseReactiveComponent

<AppModalHeader
    Title="@DashboardLocalizer["AddProject"]"
    Description="@DashboardLocalizer["AddProjectModal_Description"]">
    <Icon>
        <div
            class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
            <i
                class="fa-solid fa-plus"></i>
        </div>
    </Icon>
</AppModalHeader>
<AppModalBody>
    <EditForm
        Context="form"
        @ref="_form"
        Model="@model"
        OnSubmit="@SubmitForm"
        novalidate>
        <DataAnnotationsValidator/>
        <button
            type="submit"
            class="sr-only"
            tabindex="-1"
            aria-hidden="true">
            @DashboardLocalizer["Submit"]
        </button>

        <div
            class="grid gap-4">
            <div>
                <ClientsSelect
                    Value="model.ClientId"
                    ValueExpression="() => model.ClientId"
                    Clearable="false"
                    SelectedItemChanged="OnClientChanged"/>
                <CustomValidationMessage
                    For="@(() => model.ClientId)"/>
            </div>

            <div>
                <InputTextField
                    FullWidth="true"
                    Label="@DashboardLocalizer["Project"]"
                    Placeholder="@DashboardLocalizer["ProjectName"]"
                    IsShowEmojiButton="true"
                    @bind-Value="model.Name"/>
                <CustomValidationMessage
                    For="@(() => model.Name)"/>
            </div>
        </div>

        <CustomValidationSummary/>
    </EditForm>
</AppModalBody>
<AppModalFooter>
    <AppButton
        FullWidth="@true"
        OnClick="@Submit"
        IsLoading="_state.Value.IsSaving"
        Color="@ComponentColor.Primary"
        Radius="@ButtonRadius.Full">
        @DashboardLocalizer["Add"]
    </AppButton>
</AppModalFooter>
