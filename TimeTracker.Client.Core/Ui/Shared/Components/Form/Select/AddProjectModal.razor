@inject IStringLocalizer<DashboardResource> DashboardLocalizer

@inherits BaseReactiveComponent

<AppModalHeader
    Title="@DashboardLocalizer["AddProject"]"
    Description="@DashboardLocalizer["AddProjectModal_Description"]"
    Icon="fa-solid fa-plus" />
<AppModalBody>
    <EditForm
        Context="form"
        @ref="_form"
        Model="@model"
        OnSubmit="@SubmitForm"
        novalidate>
        <DataAnnotationsValidator/>
        <button
            type="submit"
            class="sr-only"
            tabindex="-1"
            aria-hidden="true">
            @DashboardLocalizer["Submit"]
        </button>

        <div
            class="grid gap-4">
            <div>
                <ClientsSelect
                    Label="@DashboardLocalizer["Client"]"
                    Value="model.ClientId"
                    ValueExpression="() => model.ClientId"
                    Clearable="false"
                    SelectedItemChanged="OnClientChanged"/>
            </div>

            <div>
                <InputTextField
                    FullWidth="true"
                    Label="@DashboardLocalizer["Project"]"
                    Placeholder="@DashboardLocalizer["ProjectName"]"
                    IsShowEmojiButton="true"
                    @bind-Value="model.Name"/>
            </div>
        </div>
    </EditForm>
</AppModalBody>
<AppModalFooter>
    <AppButton
        Color="@ComponentColor.Default"
        Variant="@ButtonVariant.Outlined"
        Radius="@ButtonRadius.Medium"
        OnClick="@(() => ModalInstance?.Close(AppModalResult.Cancel()))">
        @DashboardLocalizer["Cancel"]
    </AppButton>
    <AppButton
        OnClick="@Submit"
        IsLoading="_state.Value.IsSaving"
        Color="@ComponentColor.Primary"
        Radius="@ButtonRadius.Medium">
        @DashboardLocalizer["Add"]
    </AppButton>
</AppModalFooter>
