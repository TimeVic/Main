@using TimeTracker.Client.Core.Constants.Ui
@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Select.Core

<div
    class="@Class @(FullWidth ? "w-full" : "")">
    <AppSelect
        TValue="bool?"
        Value="@Value"
        ValueChanged="@ValueChanged"
        Items="@_items"
        ItemText="@GetDisplayText"
        Label="@Label"
        Placeholder="@(string.IsNullOrWhiteSpace(Placeholder) ? DashboardLocalizer["Select"].Value : Placeholder)"
        IsClearable="@Clearable"
        IsFullWidth="@FullWidth"
        Variant="@ResolvedVariant">
    </AppSelect>
</div>
