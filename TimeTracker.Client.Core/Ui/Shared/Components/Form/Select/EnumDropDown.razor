@using LumexUI
@using LumexUI.Common
@using TimeTracker.Client.Core.Constants.Ui
@using TimeTracker.Client.Core.Core.Helpers

@typeparam TItem where TItem: struct, IConvertible

<div class="@Class @(FullWidth ? "w-100" : "")">
    @if (SelectType == DropDownType.DropDown)
    {
        <LumexDropdown 
            Size="Size">
            <LumexDropdownTrigger>
                <LumexButton
                    Size="Size"
                    FullWidth="true"
                    Color="DropDownColor"
                    Variant="DropDownVariant">
                    @if (_value is null)
                    {
                        @_placeholder
                    }
                    else
                    {
                        @GetLocalizedDisplayName(_value)
                    }
                </LumexButton>
            </LumexDropdownTrigger>
            <LumexDropdownMenu
                Color="DropDownColor"
                Variant="DropDownMenuVariant">
                @foreach (var item in _list)
                {
                    <LumexDropdownItem OnClick="@(() => OnItemSelected(item))">
                        @GetLocalizedDisplayName(item)
                    </LumexDropdownItem>
                }
            </LumexDropdownMenu>
        </LumexDropdown>    
    }
    else
    {
        <LumexSelect 
            TValue="TItem?"
            Label="@Label"
            Placeholder="@_placeholder"
            LabelPlacement="@LabelPlacement.Outside"
            Variant="@SelectVariant"
            Color="DropDownColor"
            Size="Size"
            ValueChanged="dto => OnItemSelected(dto)"
            Value="_value">
            <ChildContent>
                @foreach (var character in _list)
                {
                    <LumexSelectItem @key="@character" Value="@character">
                        @GetLocalizedDisplayName(character)
                    </LumexSelectItem>
                }
            </ChildContent>
            <ValueContent>
                @if (context is null)
                {
                    return;
                }
                @GetLocalizedDisplayName(context)
            </ValueContent>
        </LumexSelect>
    }
</div>
