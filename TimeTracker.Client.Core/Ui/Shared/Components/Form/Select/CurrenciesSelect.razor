@inherits TimeTracker.Client.Core.Ui.Shared.Components.Form.Select.Core.BaseSingleSelect<TimeTracker.Api.Shared.Dto.Entity.List.CurrencyDto>

@using LumexUI
@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity.List

<div class="@Class">
    
    @if (_selectedItem != null)
    {
        <LumexSelect
            TValue="CurrencyDto"
            Label="@Label"
            Placeholder="@_placeholder"
            LabelPlacement="@LabelPlacement.Outside"
            Variant="InputVariant.Outlined"
            Color="ThemeColor.Default"
            ValueChanged="@OnValueChanged"
            Value="@_selectedItem"
            Invalid="@IsInvalid">
            @foreach (var item in _list)
            {
                <LumexSelectItem 
                    @key="@item" 
                    Value="@item" 
                    TextValue="@(item.Code + " (" + item.Symbol + ")")"
                    TValue="CurrencyDto">
                    <text>@item?.Code (@item?.Symbol)</text>
                </LumexSelectItem>
            }
        </LumexSelect>    
    }
</div>
