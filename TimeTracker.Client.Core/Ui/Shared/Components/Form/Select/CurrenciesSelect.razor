@inherits TimeTracker.Client.Core.Ui.Shared.Components.Form.Select.Core.BaseSingleSelect<TimeTracker.Api.Shared.Dto.Entity.List.CurrencyDto>
@using TimeTracker.Api.Shared.Dto.Entity.List
@using TimeTracker.Client.Core.Constants.Ui
@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Select.Core

<div
    class="@Class @(FullWidth ? "w-full" : "")">
    <AppSelect
        TValue="CurrencyDto"
        Value="@_selectedItem"
        ValueChanged="@OnCurrencySelected"
        Items="@_list"
        ItemText="@(c => $"{c.Code} ({c.Symbol})")"
        Label="@Label"
        Placeholder="@_placeholder"
        IsDisabled="@Disabled"
        IsClearable="@Clearable"
        IsFullWidth="@FullWidth"
        Variant="@ResolvedVariant">
    </AppSelect>
</div>
