@inject IStringLocalizer<DashboardResource> DashboardLocalizer
@using TimeTracker.Client.Core.Constants.Ui

@inherits BaseReactiveComponent

<AppModalHeader
    Title="@DashboardLocalizer["TagsBlock_AddTag"]"
    Description="@DashboardLocalizer["AddTagModal_Description"]"
    Icon="fa-solid fa-tag" />
<AppModalBody
    Class="pt-3">
    <EditForm
        Context="form"
        @ref="_form"
        Model="@model"
        novalidate>
        <DataAnnotationsValidator/>

        <div
            class="grid gap-5">
            <div>
                <InputTextField
                    FullWidth="true"
                    Label="@DashboardLocalizer["Tag"]"
                    Placeholder="@DashboardLocalizer["TagName"]"
                    IsShowEmojiButton="true"
                    @bind-Value="model.Name"/>
            </div>

            <div
                class="pt-1">
                <ColorSelect
                    Label="@DashboardLocalizer["Color"]"
                    Type="DropDownType.Select"
                    Clearable="true"
                    @bind-Value="model.Color"/>
            </div>
        </div>
    </EditForm>
</AppModalBody>
<AppModalFooter>
    <AppButton
        Color="@ComponentColor.Default"
        Variant="@ButtonVariant.Outlined"
        Radius="@ButtonRadius.Medium"
        OnClick="@(() => ModalInstance?.Close(AppModalResult.Cancel()))">
        @DashboardLocalizer["Cancel"]
    </AppButton>
    <AppButton
        OnClick="@Submit"
        IsLoading="_state.Value.IsSaving"
        IsLoading="_isLoading"
        Color="@ComponentColor.Primary"
        Radius="@ButtonRadius.Medium">
        @DashboardLocalizer["Add"]
    </AppButton>
</AppModalFooter>
