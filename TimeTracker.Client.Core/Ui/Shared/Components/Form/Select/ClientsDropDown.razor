@inherits TimeTracker.Client.Core.Ui.Shared.Components.Form.Select.Core.BaseSingleSelect<ClientDto>

@using LumexUI
@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Client.Core.Constants.Ui

<div class="@Class">
    @if (Type == DropDownType.DropDown)
    {
        <LumexDropdown
            Open="@_isOpen"
            OpenChanged="@OnOpenChanged">
            <LumexDropdownTrigger>
                <LumexButton
                    Disabled="Disabled"
                    FullWidth="true"
                    Color="@(IsInvalid ? ThemeColor.Danger : ThemeColor.Default)"
                    Variant="LumexUI.Common.Variant.Outlined"
                    Class="@SelectClass">
                    @if (_selectedItem is null)
                    {
                        @_placeholder
                    }
                    else
                    {
                        @_selectedItem?.Name
                    }
                </LumexButton>
            </LumexDropdownTrigger>
            <LumexDropdownMenu
                Color="ThemeColor.Default"
                Variant="MenuVariant.Outlined">
                @if (Clearable && _selectedItem != null)
                {
                    <LumexDropdownItem OnClick="@(() => OnClientSelected(null))" Class="text-slate-400">
                        <ChildContent>
                            <span class="flex items-center gap-2">
                                <i class="fa-solid fa-xmark text-xs"></i>
                                @DashboardLocalizer["None"]
                            </span>
                        </ChildContent>
                    </LumexDropdownItem>
                }
                @foreach (var client in _list)
                {
                    <LumexDropdownItem OnClick="@(() => OnClientSelected(client))">
                        <ChildContent>@client?.Name</ChildContent>
                    </LumexDropdownItem>
                }
            </LumexDropdownMenu>
        </LumexDropdown>
    }
    else
    {
        <LumexSelect
            TValue="ClientDto"
            Label="@Label"
            Placeholder="@_placeholder"
            LabelPlacement="LabelPlacement.Outside"
            Variant="@Variant"
            Size="Size"
            Color="@(IsInvalid ? ThemeColor.Danger : ThemeColor.Default)"
            ValueChanged="dto => OnValueChanged(dto)"
            Value="_selectedItem"
            Invalid="@IsInvalid">
            <ChildContent>
                @if (Clearable && _selectedItem != null)
                {
                    <LumexSelectItem Value="@_clearSentinel" TextValue="">
                        <div class="flex items-center gap-2 text-slate-400">
                            <i class="fa-solid fa-xmark text-xs"></i>
                            <span class="text-small">@DashboardLocalizer["None"]</span>
                        </div>
                    </LumexSelectItem>
                }
                @foreach (var client in _list)
                {
                    <LumexSelectItem @key="@client" Value="@client">
                        @client?.Name
                    </LumexSelectItem>
                }
            </ChildContent>
            <ValueContent>
                <span>@context?.Name</span>
            </ValueContent>
        </LumexSelect>
    }
</div>
