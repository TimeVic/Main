@inject IStringLocalizer<DashboardResource> DashboardLocalizer

@inherits BaseReactiveComponent

<AppModalHeader
    Title="@DashboardLocalizer["AddClient"]"
    Description="@DashboardLocalizer["AddClientModal_Description"]"
    Icon="fa-solid fa-plus" />
<AppModalBody>
    <EditForm
        Context="form"
        @ref="_form"
        Model="@model"
        OnSubmit="@SubmitForm"
        novalidate>
        <DataAnnotationsValidator/>
        <button
            type="submit"
            class="sr-only"
            tabindex="-1"
            aria-hidden="true">
            @DashboardLocalizer["Submit"]
        </button>

        <div
            class="mt-1">
            <InputTextField
                FullWidth="true"
                Label="@DashboardLocalizer["Client"]"
                Placeholder="@DashboardLocalizer["ClientName"]"
                IsShowEmojiButton="true"
                @bind-Value="model.Name"/>
        </div>
    </EditForm>
</AppModalBody>
<AppModalFooter>
    <AppButton
        Color="@ComponentColor.Default"
        Variant="@ButtonVariant.Outlined"
        Radius="@ButtonRadius.Medium"
        OnClick="@(() => ModalInstance?.Close(AppModalResult.Cancel()))">
        @DashboardLocalizer["Cancel"]
    </AppButton>
    <AppButton
        OnClick="@Submit"
        IsLoading="_state.Value.IsSaving"
        IsLoading="_isLoading"
        Color="@ComponentColor.Primary"
        Radius="@ButtonRadius.Medium">
        @DashboardLocalizer["Add"]
    </AppButton>
</AppModalFooter>
