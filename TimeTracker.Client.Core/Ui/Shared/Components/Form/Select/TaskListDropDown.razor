@using System.Linq.Expressions
@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity.Task
@using TimeTracker.Client.Core.Constants.Ui

<TaskListsDropDown
    Type="@Type"
    Label="@Label"
    Disabled="@Disabled"
    Clearable="@Clearable"
    Value="@Value"
    ValueExpression="@ValueExpression"
    Placeholder="@Placeholder"
    Class="@Class"
    FullWidth="@FullWidth"
    SelectedItemChanged="@SelectedItemChanged"
    Required="@Required"
    ProjectId="@ProjectId"
    ClientId="@ClientId"
    IsExtendedInfo="@IsExtendedInfo"
    LabelPlacement="@LabelPlacement"
    Variant="@Variant" />

@code {
    [Parameter]
    public DropDownType Type { get; set; } = DropDownType.DropDown;

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Clearable { get; set; }

    [Parameter]
    public Guid Value { get; set; }

    [Parameter]
    public Expression<Func<Guid>>? ValueExpression { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Select item";

    [Parameter]
    public string Class { get; set; } = string.Empty;

    [Parameter]
    public bool FullWidth { get; set; }

    [Parameter]
    public EventCallback<TaskListDto?> SelectedItemChanged { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public Guid? ProjectId { get; set; }

    [Parameter]
    public Guid? ClientId { get; set; }

    [Parameter]
    public bool IsExtendedInfo { get; set; } = true;

    [Parameter]
    public LabelPlacement LabelPlacement { get; set; } = LabelPlacement.Outside;

    [Parameter]
    public InputVariant Variant { get; set; } = InputVariant.Outlined;
}
