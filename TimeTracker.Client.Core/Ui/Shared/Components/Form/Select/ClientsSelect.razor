@inherits TimeTracker.Client.Core.Ui.Shared.Components.Form.Select.Core.BaseSingleSelect<TimeTracker.Api.Shared.Dto.Entity.ClientDto>
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Client.Core.Constants.Ui
@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Select.Core

<div
    class="@Class @(FullWidth ? "w-full" : "")">
    <AppSelect
        TValue="ClientDto"
        Value="@_selectedItem"
        ValueChanged="@OnClientSelected"
        Label="@Label"
        Placeholder="@_placeholder"
        IsDisabled="@Disabled"
        IsClearable="@Clearable"
        IsFullWidth="@FullWidth"
        IsInvalid="@IsInvalid"
        Variant="@ResolvedVariant">
        <TriggerContent>
            @if (_selectedItem != null)
            {
                <span
                    class="truncate">
                    @_selectedItem.Name
                </span>
            }
            else
            {
                <span
                    class="text-slate-400">
                    @_placeholder
                </span>
            }
        </TriggerContent>
        <ChildContent>
            @if (IsCanCreateClient && _state.Value.IsLoaded && !_list.Any())
            {
                <div
                    class="w-full px-3 py-2 rounded-lg text-xs md:text-sm flex items-center gap-2 text-blue-600 hover:bg-blue-50 dark:hover:bg-blue-950/40 cursor-pointer select-none transition-colors font-medium"
                    @onclick="OnAddClient">
                    <i
                        class="fa-solid fa-plus text-xs">
                    </i>
                    <span>
                        @DashboardLocalizer["AddClient"]
                    </span>
                </div>
            }
            @foreach (var client in _list)
            {
                <AppSelectItem
                    TValue="ClientDto"
                    Value="@client"
                    Text="@client.Name">
                </AppSelectItem>
            }
        </ChildContent>
    </AppSelect>
    @if (IsInvalid && !string.IsNullOrWhiteSpace(FirstError))
    {
        <p
            class="mt-1.5 text-xs text-rose-500 flex items-center gap-1">
            <i
                class="fa-solid fa-circle-exclamation text-[11px]">
            </i>
            <span>@FirstError</span>
        </p>
    }
</div>
