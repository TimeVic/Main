@using System.Linq.Expressions
@using TimeTracker.Api.Shared.Dto.Entity.Task
@using TimeTracker.Client.Core.Constants.Ui

<TaskListsSelect
    Type="@Type"
    Label="@Label"
    Disabled="@Disabled"
    Clearable="@Clearable"
    Value="@Value"
    ValueExpression="@ValueExpression"
    Placeholder="@Placeholder"
    Class="@Class"
    FullWidth="@FullWidth"
    SelectedItemChanged="@SelectedItemChanged"
    Required="@Required"
    ProjectId="@ProjectId"
    ClientId="@ClientId"
    IsExtendedInfo="@IsExtendedInfo"
    Size="@Size">
</TaskListsSelect>

@code {
    [Parameter]
    public ComponentSize Size { get; set; } = ComponentSize.Medium;

    [Parameter]
    public DropDownType Type { get; set; } = DropDownType.Select;

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Clearable { get; set; }

    [Parameter]
    public Guid Value { get; set; }

    [Parameter]
    public Expression<Func<Guid>>? ValueExpression { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Select item";

    [Parameter]
    public string Class { get; set; } = string.Empty;

    [Parameter]
    public bool FullWidth { get; set; } = true;

    [Parameter]
    public EventCallback<TaskListDto?> SelectedItemChanged { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public Guid? ProjectId { get; set; }

    [Parameter]
    public Guid? ClientId { get; set; }

    [Parameter]
    public bool IsExtendedInfo { get; set; } = true;
}
