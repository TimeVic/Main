@inherits TimeTracker.Client.Core.Ui.Shared.Components.Form.Select.Core.BaseSingleSelect<WorkspaceMemberDto>

@using LumexUI
@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants
@using TimeTracker.Client.Core.Constants.Ui

<div class="@Class @(FullWidth ? "w-100" : "")">
    @if (Type == DropDownType.DropDown)
    {
        <LumexDropdown
            Open="@_isOpen"
            OpenChanged="@OnOpenChanged">
            <LumexDropdownTrigger>
                <LumexButton
                    FullWidth="true"
                    Color="DropDownColor"
                    Variant="DropDownVariant"
                    Disabled="Disabled">
                    @if (_selectedItem is null)
                    {
                        @_placeholder
                    }
                    else
                    {
                        @_selectedItem?.User.Name
                    }
                </LumexButton>
            </LumexDropdownTrigger>
            <LumexDropdownMenu
                Color="DropDownColor"
                Variant="DropDownMenuVariant">
                @if (Clearable && _selectedItem != null)
                {
                    <LumexDropdownItem OnClick="@(() => OnMemberSelected(null))" Class="text-slate-400">
                        <ChildContent>
                            <span class="flex items-center gap-2">
                                <i class="fa-solid fa-xmark text-xs"></i>
                                @DashboardLocalizer["None"]
                            </span>
                        </ChildContent>
                    </LumexDropdownItem>
                }
                @foreach (var member in _list)
                {
                    <LumexDropdownItem OnClick="@(() => OnMemberSelected(member))">
                        <ChildContent>@member?.User.Name</ChildContent>
                    </LumexDropdownItem>
                }
            </LumexDropdownMenu>
        </LumexDropdown>
    }
    else
    {
        <LumexSelect 
            TValue="WorkspaceMemberDto"
            Label="@Label"
            Placeholder="@_placeholder"
            Color="ThemeColor.Default"
            Variant="SelectVariant"
            LabelPlacement="@LabelPlacement.Outside"
            ValueChanged="OnMemberValueChanged"
            Value="_selectedItem"
            Invalid="@IsInvalid">
            <ChildContent>
                @if (Clearable && _selectedItem != null)
                {
                    <LumexSelectItem Value="@_clearSentinel" TextValue="">
                        <div class="flex items-center gap-2 text-slate-400">
                            <i class="fa-solid fa-xmark text-xs"></i>
                            <span class="text-small">@DashboardLocalizer["None"]</span>
                        </div>
                    </LumexSelectItem>
                }
                @foreach (var character in _list)
                {
                    <LumexSelectItem @key="@character" Value="@character">
                        @character?.User.Name
                    </LumexSelectItem>
                }
            </ChildContent>
            <ValueContent>
                <div class="flex items-center gap-2">
                    <div class="flex flex-col">
                        <span>@context?.User.Name</span>
                    </div>
                </div>
            </ValueContent>
        </LumexSelect>
    }
</div>
