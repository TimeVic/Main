@using TimeTracker.Client.Core.Services.UI
@using TimeTracker.Client.Core.Core.Helpers
@using LumexUI.Common

<div class="@($"{Class} w-markdown-editor w-full")">

    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">@Label</label>
    }
    @if (_isShowEditBox)
    {
        <div class="w-full">
            <textarea
                name="@TextAreaName"
                placeholder="@Placeholder"
                value="@_editValue"
                maxlength="@MaxLength"
                rows="@_textAreaRows"
                @oninput="@OnChangeValue"
                class="w-markdown-editor-input w-full resize-y rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 focus:border-blue-500 focus:outline-none"></textarea>
            <p class="w-support mt-2 text-slate-500">
                @DashboardLocalizer["MarkdownEdit_Supports"]
                <a class="text-blue-600 hover:text-blue-700" href="https://www.markdownguide.org/basic-syntax/" target="_blank" rel="noopener noreferrer">
                    @DashboardLocalizer["MarkdownEdit_Markdown"]
                </a>
            </p>

        </div>
        if (IsInlineActionsEnabled && _isActionButtonsEnabled)
        {
            <div class="mt-3 flex items-center gap-2">
                <CustomButton
                    Size="Size.Small"
                    Variant="Variant.Outlined"
                    Color="ThemeColor.Default"
                    OnClick="@OnClickCancel">
                    @DashboardLocalizer["Cancel"]
                </CustomButton>
                
                <CustomButton
                    Size="Size.Small"
                    Color="ThemeColor.Primary"
                    OnClick="@OnClickSave">
                    <StartContent>
                        <i class="fa-regular fa-floppy-disk text-xs"></i>
                    </StartContent>
                    <ChildContent>@DashboardLocalizer["Save"]</ChildContent>
                </CustomButton>
            </div>
        }
    }
    else
    {
        <div
            class="w-view w-full text-sm text-slate-700"
            @onclick="@OnClickView">
            @MarkdownHtml
        </div>
    }
</div>

@code
{
    [Parameter]
    public string Class { get; set; } = string.Empty;

    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Placeholder { get; set; } = string.Empty;

    [Parameter]
    public string TextAreaName { get; set; } = string.Empty;

    [Parameter]
    public int MaxLength { get; set; } = 10000;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public int RowsMin { get; set; } = 6;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string> Changed { get; set; }

    [Parameter]
    public EventCallback OnClickedToView { get; set; }
    
    [Parameter]
    public bool IsEditMode { get; set; }
    
    [Parameter]
    public bool IsInlineActionsEnabled { get; set; } = true;

    [Inject]
    public MarkdownService MarkdownService { get; set; }

    [Inject]
    public UiHelperService UiHelperService { get; set; }
    
    public MarkupString MarkdownHtml => (MarkupString) MarkdownService.ToHtml(_value);

    private bool _isShowEditBox;
    private readonly int _textAreaRowsMax = 20;
    private int _textAreaRows = 3;
    private string _value = string.Empty;
    private string _editValue = string.Empty;
    private bool _isActionButtonsEnabled;
    private bool _isInitialized;

    protected override void OnParametersSet()
    {
        var value = Value ?? string.Empty;
        var isDesiredEditBox = IsEditMode || string.IsNullOrWhiteSpace(value);
        if (_isInitialized && (IsInlineActionsEnabled && _isActionButtonsEnabled || _value == value && _isShowEditBox == isDesiredEditBox))
        {
            return;
        }

        _value = value;
        _editValue = value;
        _isShowEditBox = isDesiredEditBox;
        _isActionButtonsEnabled = false;
        _isInitialized = true;
        ResizeEditBox(_editValue);
    }

    private void ResizeEditBox(string? description)
    {
        description ??= string.Empty;
        _textAreaRows = Math.Max(description.Split('\n').Length, description.Split('\r').Length);
        _textAreaRows = Math.Max(_textAreaRows, RowsMin);
        _textAreaRows = Math.Min(_textAreaRows, _textAreaRowsMax);
    }

    private async Task OnChangeValue(ChangeEventArgs elementEvent)
    {
        _editValue = elementEvent.Value?.ToString() ?? string.Empty;
        ResizeEditBox(_editValue);

        if (!IsInlineActionsEnabled)
        {
            _value = _editValue;
            await ValueChanged.InvokeAsync(_value);
            await Changed.InvokeAsync(_value);
            return;
        }

        _isActionButtonsEnabled = _isActionButtonsEnabled || _editValue != _value;
    }

    private async Task OnClickView()
    {
        if (await UiHelperService.IsTextSelected())
        {
            return;
        }

        _isShowEditBox = true;
        _isActionButtonsEnabled = IsInlineActionsEnabled;
        StateHasChanged();
    }

    private async Task OnClickSave()
    {
        var isChanged = _value != _editValue;
        _value = _editValue;
        _isShowEditBox = string.IsNullOrWhiteSpace(_value);
        _isActionButtonsEnabled = false;
        if (isChanged)
        {
            await ValueChanged.InvokeAsync(_value);
            await Changed.InvokeAsync(_value);
        }
    }

    private void OnClickCancel()
    {
        _isShowEditBox = string.IsNullOrWhiteSpace(_value);
        _editValue = _value;
        _isActionButtonsEnabled = false;
        ResizeEditBox(_editValue);
    }
}
