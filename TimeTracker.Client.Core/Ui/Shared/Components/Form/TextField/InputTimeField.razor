@inherits BaseInputField<DateTime?>
@using System.Globalization
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<CommonComponentsResource> CommonLocalizer

<div class="@(IsFullWidth ? "w-full" : "w-auto") @WrapperClass">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="block mb-1.5 text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            @Label
            @if (IsRequired)
            {
                <span class="text-rose-500 ms-0.5">*</span>
            }
        </label>
    }

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="mb-1.5 text-xs text-slate-500 dark:text-slate-400">@Description</p>
    }

    <div class="@ContainerClasses @InputSizeClasses @Class flex items-center justify-between gap-1.5">
        <div class="flex items-center pl-3 pr-1 text-slate-400 shrink-0">
            @if (StartContent != null)
            {
                @StartContent
            }
            else
            {
                <i class="fa-regular fa-clock text-xs"></i>
            }
        </div>

        <input
            @ref="_inputRef"
            type="text"
            inputmode="numeric"
            value="@_textValue"
            @onfocus="HandleFocus"
            @oninput="HandleInput"
            @onkeydown="HandleKeyDown"
            @onkeydown:preventDefault="IsArrowKey(lastKeyDownKey)"
            @onblur="HandleBlur"
            placeholder="@(string.IsNullOrEmpty(Placeholder) ? "HH:mm" : Placeholder)"
            disabled="@IsDisabled"
            readonly="@IsReadOnly"
            maxlength="8"
            class="w-full h-full bg-transparent border-0 px-1.5 py-1.5 font-mono text-inherit placeholder:text-slate-400 focus:outline-hidden focus:ring-0 disabled:cursor-not-allowed cursor-text"
            @attributes="AdditionalAttributes" />

        <div class="flex items-center gap-1 pr-2.5 shrink-0">
            @if (IsClearable && !IsDisabled && !IsReadOnly && !string.IsNullOrEmpty(_textValue))
            {
                <button
                    type="button"
                    tabindex="-1"
                    class="p-0.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors cursor-pointer"
                    @onclick="ClearTimeAsync"
                    aria-label="@CommonLocalizer["Clear"]">
                    <i class="fa-solid fa-circle-xmark text-xs"></i>
                </button>
            }

            @if (!IsDisabled && !IsReadOnly)
            {
                <div class="flex flex-col -space-y-1 select-none">
                    <button
                        type="button"
                        tabindex="-1"
                        class="px-1 py-0.5 text-[9px] text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors cursor-pointer"
                        @onclick="() => StepMinutes(1)"
                        aria-label="Increase time">
                        <i class="fa-solid fa-chevron-up"></i>
                    </button>
                    <button
                        type="button"
                        tabindex="-1"
                        class="px-1 py-0.5 text-[9px] text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors cursor-pointer"
                        @onclick="() => StepMinutes(-1)"
                        aria-label="Decrease time">
                        <i class="fa-solid fa-chevron-down"></i>
                    </button>
                </div>
            }

            @if (EndContent != null)
            {
                @EndContent
            }
        </div>
    </div>

    @if (HasError && !string.IsNullOrWhiteSpace(FirstError))
    {
        <p class="mt-1.5 text-xs text-rose-500 flex items-center gap-1">
            <i class="fa-solid fa-circle-exclamation text-[11px]"></i>
            <span>@FirstError</span>
        </p>
    }
</div>

