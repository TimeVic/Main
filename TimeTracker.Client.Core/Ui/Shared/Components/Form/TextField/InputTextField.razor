@inherits BaseInputField<string>
@using TimeTracker.Client.Core.Constants.Ui

<div
    class="@(IsFullWidth ? "w-full" : "w-auto") @WrapperClass">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label
            class="block mb-1.5 text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            @Label
            @if (IsRequired)
            {
                <span
                    class="text-rose-500 ms-0.5">*</span>
            }
        </label>
    }

    <div
        class="@ContainerClasses @InputSizeClasses @Class">
        @if (StartContent != null)
        {
            <div
                class="flex items-center pl-3 pr-1 text-slate-400 shrink-0">
                @StartContent
            </div>
        }

        <input
            type="@ResolvedHtmlInputType"
            value="@Value"
            @oninput="HandleInput"
            placeholder="@Placeholder"
            disabled="@IsDisabled"
            readonly="@IsReadOnly"
            class="w-full h-full bg-transparent border-0 px-3.5 py-1.5 text-inherit placeholder:text-slate-400 focus:outline-hidden focus:ring-0 disabled:cursor-not-allowed @(StartContent != null ? "!pl-1.5" : "") @(HasEndElements ? "!pr-1.5" : "")"
            @attributes="AdditionalAttributes" />

        @if (HasEndElements)
        {
            <div
                class="flex items-center gap-1 pr-3 pl-1 shrink-0">
                @if (IsClearable && !IsDisabled && !IsReadOnly && !string.IsNullOrEmpty(Value))
                {
                    <button
                        type="button"
                        tabindex="-1"
                        class="p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors cursor-pointer"
                        @onclick="ClearAsync">
                        <i
                            class="fa-solid fa-circle-xmark text-xs">
                        </i>
                    </button>
                }

                @if (Type == InputType.Password)
                {
                    <button
                        type="button"
                        tabindex="-1"
                        class="p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors cursor-pointer"
                        @onclick="TogglePasswordVisibility">
                        <i
                            class="fa-regular @(_isPasswordVisible ? "fa-eye-slash" : "fa-eye") text-xs">
                        </i>
                    </button>
                }

                @if (IsShowValidationState && IsSuccess)
                {
                    <i
                        class="fa-solid fa-circle-check text-emerald-500 text-sm">
                    </i>
                }

                @if (IsShowEmojiButton)
                {
                    <SelectEmojiButton
                        OnSelected="OnEmojiSelected"/>
                }

                @if (EndContent != null)
                {
                    @EndContent
                }
            </div>
        }
    </div>

    @if (HasError && !string.IsNullOrWhiteSpace(FirstError))
    {
        <p
            class="mt-1.5 text-xs text-rose-500 flex items-center gap-1">
            <i
                class="fa-solid fa-circle-exclamation text-[11px]">
            </i>
            <span>@FirstError</span>
        </p>
    }
</div>

@code {
    [Parameter]
    public InputType Type { get; set; } = InputType.Text;

    [Parameter]
    public bool IsShowEmojiButton { get; set; }

    [Parameter]
    public bool IsShowValidationState { get; set; }

    [Parameter]
    public bool ShowValidationState
    {
        get => IsShowValidationState;
        set => IsShowValidationState = value;
    }

    private bool _isPasswordVisible;

    private bool IsSuccess => !HasError && !string.IsNullOrWhiteSpace(Value);

    private bool HasEndElements =>
        EndContent != null
        || IsShowEmojiButton
        || (IsShowValidationState && IsSuccess)
        || (Type == InputType.Password)
        || (IsClearable && !IsDisabled && !IsReadOnly && !string.IsNullOrEmpty(Value));

    private string ResolvedHtmlInputType => Type switch
    {
        InputType.Password => _isPasswordVisible ? "text" : "password",
        InputType.Email => "email",
        InputType.Url => "url",
        InputType.Number => "number",
        InputType.Tel => "tel",
        InputType.Search => "search",
        _ => "text"
    };

    private async Task HandleInput(ChangeEventArgs e)
    {
        await SetValueAsync(e.Value?.ToString() ?? string.Empty);
    }

    private void TogglePasswordVisibility()
    {
        _isPasswordVisible = !_isPasswordVisible;
    }

    private async Task OnEmojiSelected(EmojiList.EmojiOptionModel emoji)
    {
        var newValue = string.Concat(Value, emoji.Symbol);
        await SetValueAsync(newValue);
    }
}
