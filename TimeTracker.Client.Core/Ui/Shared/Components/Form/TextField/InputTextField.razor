@inherits InputBase<string>
@using LumexUI.Common
@using TimeTracker.Client.Core.Constants.Ui

<LumexTextbox
    @bind-Value="CurrentValue"
    AdditionalAttributes="@AdditionalAttributes"
    Class="@Class"
    Placeholder="@Placeholder"
    Type="@Type"
    Label="@Label"
    Invalid="@HasError"
    Disabled="Disabled"
    FullWidth="FullWidth"
    Required="@Required"
    Variant="Variant"
    Color="@ComputedColor"
    LabelPlacement="LabelPlacement"
    Size="Size"
    Clearable="Clearable"
    ErrorMessage="@FirstError">

    <StartContent>@StartContent</StartContent>
    <EndContent>
        @if (EndContent != null || IsShowEmojiButton || (ShowValidationState && IsSuccess))
        {
            <span class="inline-flex items-center gap-1.5">
                @EndContent
                @if (ShowValidationState && IsSuccess)
                {
                    <i class="fa-solid fa-circle-check text-emerald-500 text-sm"></i>
                }
                @if (IsShowEmojiButton)
                {
                    <SelectEmojiButton OnSelected="OnEmojiSelected"/>
                }
            </span>
        }
    </EndContent>
</LumexTextbox>

@code {
    [Parameter]
    public bool Required { get; set; }
    
    [Parameter]
    public bool Disabled { get; set; }
    
    [Parameter]
    public InputVariant Variant { get; set; } = InputVariant.Outlined;

    [Parameter]
    public ThemeColor Color { get; set; } = ThemeColor.Default;
    
    [Parameter]
    public bool FullWidth { get; set; }
    
    [Parameter]
    public InputType Type { get; set; } = InputType.Text;
    
    [Parameter]
    public string Placeholder { get; set; } = string.Empty;
    
    [Parameter]
    public string Label { get; set; } = string.Empty;
    
    [Parameter]
    public string Class { get; set; } = string.Empty;
    
    [Parameter]
    public Size Size { get; set; } = Size.Medium;

    [Parameter]
    public bool Clearable { get; set; } = false;
    
    [Parameter]
    public bool IsShowEmojiButton { get; set; } = false;

    [Parameter]
    public bool ShowValidationState { get; set; } = false;
    
    [Parameter]
    public RenderFragment? StartContent { get; set; }
    
    [Parameter]
    public RenderFragment? EndContent { get; set; }
    
    [Parameter]
    public LabelPlacement LabelPlacement { get; set; } = LabelPlacement.Outside;
    
    private bool HasError => EditContext?.GetValidationMessages(FieldIdentifier).Any() ?? false;

    private bool IsSuccess => !HasError && !string.IsNullOrWhiteSpace(CurrentValue);

    private ThemeColor ComputedColor
    {
        get
        {
            if (HasError)
            {
                return ThemeColor.Danger;
            }
            if (ShowValidationState && IsSuccess)
            {
                return ThemeColor.Success;
            }
            return Color;
        }
    }

    private string FirstError =>
        EditContext?.GetValidationMessages(FieldIdentifier).FirstOrDefault() ?? string.Empty;

    public bool _isShowEmojiModal { get; set; } = false;

    private void OnEmojiSelected(EmojiList.EmojiOptionModel emoji)
    {
        CurrentValue = string.Concat(CurrentValue, emoji.Symbol);
    }

    protected override bool TryParseValueFromString(
        string? value,
        out string result,
        out string? validationErrorMessage
    )
    {
        result = value ?? string.Empty;
        validationErrorMessage = null;
        return true;
    }
}
