@inherits BaseInputField<DateTime?>
@using System.Globalization
@inject IStringLocalizer<CommonComponentsResource> CommonLocalizer

@if (IsSplit)
{
    <div class="@WrapperClass">
        <div class="flex items-end gap-2">
            <div class="flex-1">
                <InputDateField
                    TValue="DateTime?"
                    Size="@Size"
                    Placeholder="@Placeholder"
                    Value="@Value"
                    ValueChanged="OnDateOnlyChanged"
                    Disabled="@IsDisabled"
                    Label="@Label"
                    DisabledDateFunc="@DisabledDateFunc"
                    Clearable="@IsClearable"
                    FullWidth="true" />
            </div>
            <div class="w-32">
                <InputTimeField
                    Size="@Size"
                    Value="@Value"
                    ValueChanged="OnTimeOnlyChanged"
                    Disabled="@IsDisabled"
                    Clearable="@IsClearable"
                    FullWidth="true" />
            </div>
        </div>
    </div>
}
else
{
    <div
        class="relative @(IsFullWidth ? "w-full" : "w-auto") @WrapperClass"
        @onkeydown="HandleKeyDown">

        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <label
                class="block mb-1.5 text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                @Label
                @if (IsRequired)
                {
                    <span class="text-rose-500 ms-0.5">*</span>
                }
            </label>
        }

        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="mb-1.5 text-xs text-slate-500 dark:text-slate-400">@Description</p>
        }

        @* Transparent Backdrop to catch outside clicks *@
        @if (_isOpen)
        {
            <div
                class="fixed inset-0 z-40 bg-transparent"
                @onclick="ClosePopover"
                @onclick:stopPropagation="true">
            </div>
        }

        @* Trigger Input Container *@
        <div
            class="@ContainerClasses @InputSizeClasses @Class cursor-pointer select-none"
            @onclick="TogglePopover">

            <div class="flex items-center pl-3 pr-1 text-slate-400 shrink-0">
                <i class="fa-regular fa-calendar-days text-xs"></i>
            </div>

            <div class="flex-1 min-w-0 px-2 text-inherit truncate">
                @if (Value.HasValue && Value.Value != default)
                {
                    <span>@Value.Value.ToString("yyyy-MM-dd HH:mm")</span>
                }
                else
                {
                    <span class="text-slate-400">@(string.IsNullOrEmpty(Placeholder) ? "yyyy-mm-dd --:--" : Placeholder)</span>
                }
            </div>

            <div class="flex items-center gap-1 pr-3 pl-1 shrink-0">
                @if (IsClearable && !IsDisabled && Value.HasValue && Value.Value != default)
                {
                    <button
                        type="button"
                        tabindex="-1"
                        class="p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors cursor-pointer"
                        @onclick="HandleClear"
                        @onclick:stopPropagation="true"
                        aria-label="@CommonLocalizer["Clear"]">
                        <i class="fa-solid fa-circle-xmark text-xs"></i>
                    </button>
                }
            </div>
        </div>

        @* Mantine DateTimePicker Popover *@
        @if (_isOpen && !IsDisabled)
        {
            <div class="absolute z-50 mt-1.5 left-0 top-full">
                <div class="p-3 w-[290px] bg-white dark:bg-slate-800 rounded-xl shadow-xl border border-slate-200 dark:border-slate-700 select-none">
                    <!-- Calendar Section -->
                    <AppCalendar
                        Value="@_tempDate"
                        ValueChanged="OnCalendarDateSelected"
                        DisabledDateFunc="@DisabledDateFunc"
                        Class="!p-0 !border-0 !shadow-none !w-full !rounded-none" />

                    <!-- Divider -->
                    <div class="border-t border-slate-100 dark:border-slate-700 my-3"></div>

                    <!-- Bottom Bar: Time Input + Confirm Button -->
                    <div class="flex items-center justify-between gap-2 px-1">
                        <div class="flex items-center border border-slate-200 dark:border-slate-700 rounded-lg px-2.5 py-1.5 bg-white dark:bg-slate-900 font-mono text-sm w-32">
                            <i class="fa-regular fa-clock text-xs text-slate-400 mr-2 shrink-0"></i>
                            <input
                                type="text"
                                inputmode="numeric"
                                placeholder="HH:mm"
                                maxlength="8"
                                value="@_timeStr"
                                @oninput="HandleTimeInput"
                                @onkeydown="HandleTimeKeyDown"
                                class="w-full bg-transparent border-0 p-0 text-inherit placeholder:text-slate-400 focus:outline-hidden focus:ring-0 cursor-text" />
                        </div>

                        <button
                            type="button"
                            class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors cursor-pointer flex items-center justify-center text-xs font-medium"
                            @onclick="ConfirmSelection"
                            @onclick:stopPropagation="true"
                            aria-label="@CommonLocalizer["Confirm"]">
                            <i class="fa-solid fa-check text-xs"></i>
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (HasError && !string.IsNullOrWhiteSpace(FirstError))
        {
            <p class="mt-1.5 text-xs text-rose-500 flex items-center gap-1">
                <i class="fa-solid fa-circle-exclamation text-[11px]"></i>
                <span>@FirstError</span>
            </p>
        }
    </div>
}

