@inherits BaseInputField<TValue>
@using System.Globalization
@typeparam TValue

<div
    class="relative @(IsFullWidth ? "w-full" : "w-auto") @WrapperClass"
    @onkeydown="HandleKeyDown">

    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label
            class="block mb-1.5 text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            @Label
            @if (IsRequired)
            {
                <span class="text-rose-500 ms-0.5">*</span>
            }
        </label>
    }

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="mb-1.5 text-xs text-slate-500 dark:text-slate-400">@Description</p>
    }

    @* Transparent Backdrop to catch outside clicks *@
    @if (_isOpen)
    {
        <div
            class="fixed inset-0 z-40 bg-transparent"
            @onclick="ClosePopover"
            @onclick:stopPropagation="true">
        </div>
    }

    <div
        class="@ContainerClasses @InputSizeClasses @Class cursor-text"
        @onclick="OpenPopover">

        <div
            class="flex items-center pl-3 pr-1 text-slate-400 shrink-0">
            @if (StartContent != null)
            {
                @StartContent
            }
            else
            {
                <button
                    type="button"
                    tabindex="-1"
                    class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors cursor-pointer"
                    @onclick="TogglePopover"
                    @onclick:stopPropagation="true"
                    aria-label="@CommonLocalizer["Calendar"]">
                    <i class="fa-regular fa-calendar text-xs"></i>
                </button>
            }
        </div>

        <input
            type="text"
            inputmode="numeric"
            value="@_dateString"
            @oninput="HandleInput"
            @onchange="HandleChange"
            placeholder="@(string.IsNullOrEmpty(Placeholder) ? "yyyy-mm-dd" : Placeholder)"
            disabled="@IsDisabled"
            readonly="@IsReadOnly"
            maxlength="10"
            class="w-full h-full bg-transparent border-0 px-2 py-1.5 text-inherit placeholder:text-slate-400 focus:outline-hidden focus:ring-0 disabled:cursor-not-allowed cursor-text"
            @attributes="AdditionalAttributes" />

        @if (HasEndElements)
        {
            <div
                class="flex items-center gap-1 pr-3 pl-1 shrink-0">
                @if (IsClearable && !IsDisabled && !IsReadOnly && !string.IsNullOrEmpty(_dateString))
                {
                    <button
                        type="button"
                        tabindex="-1"
                        class="p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors cursor-pointer"
                        @onclick="HandleClearAsync"
                        @onclick:stopPropagation="true"
                        aria-label="@CommonLocalizer["Clear"]">
                        <i class="fa-solid fa-circle-xmark text-xs"></i>
                    </button>
                }

                @if (EndContent != null)
                {
                    @EndContent
                }
            </div>
        }
    </div>

    @* Calendar Dropdown Popover *@
    @if (_isOpen && !IsDisabled && !IsReadOnly)
    {
        <div
            class="absolute z-50 mt-1.5 left-0 top-full">
            <AppCalendar
                Value="@GetDateTimeValue()"
                ValueChanged="OnCalendarDateSelected"
                DisabledDateFunc="@DisabledDateFunc" />
        </div>
    }

    @if (HasError && !string.IsNullOrWhiteSpace(FirstError))
    {
        <p
            class="mt-1.5 text-xs text-rose-500 flex items-center gap-1">
            <i
                class="fa-solid fa-circle-exclamation text-[11px]">
            </i>
            <span>@FirstError</span>
        </p>
    }
</div>

@code {
    [Parameter]
    public Func<DateTime, bool>? DisabledDateFunc { get; set; }

    private string _dateString = string.Empty;
    private bool _isOpen;

    private bool HasEndElements =>
        EndContent != null
        || (IsClearable && !IsDisabled && !IsReadOnly && !string.IsNullOrEmpty(_dateString));

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (Value is DateTime dt && dt != default)
        {
            _dateString = dt.ToString("yyyy-MM-dd");
        }
        else
        {
            _dateString = string.Empty;
        }
    }

    private void TogglePopover()
    {
        if (!IsDisabled && !IsReadOnly)
        {
            _isOpen = !_isOpen;
        }
    }

    private void OpenPopover()
    {
        if (!IsDisabled && !IsReadOnly && !_isOpen)
        {
            _isOpen = true;
        }
    }

    private void ClosePopover()
    {
        _isOpen = false;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _isOpen)
        {
            ClosePopover();
        }
    }

    private async Task OnCalendarDateSelected(DateTime date)
    {
        _dateString = date.ToString("yyyy-MM-dd");
        _isOpen = false;
        await UpdateValue(date);
    }

    private DateTime? GetDateTimeValue()
    {
        if (Value is DateTime dt && dt != default)
        {
            return dt;
        }
        if (DateTime.TryParseExact(_dateString, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed))
        {
            return parsed;
        }
        return null;
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        _dateString = ApplyDateMask(raw);

        if (string.IsNullOrWhiteSpace(_dateString))
        {
            await UpdateValue(null);
            return;
        }

        if (_dateString.Length == 10 && DateTime.TryParseExact(_dateString, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedDate))
        {
            await UpdateValue(parsedDate);
        }
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(raw))
        {
            _dateString = string.Empty;
            await UpdateValue(null);
            return;
        }

        if (DateTime.TryParseExact(raw, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedExact))
        {
            _dateString = parsedExact.ToString("yyyy-MM-dd");
            await UpdateValue(parsedExact);
            return;
        }

        if (DateTime.TryParse(raw, CultureInfo.CurrentCulture, DateTimeStyles.None, out var parsedCulture))
        {
            _dateString = parsedCulture.ToString("yyyy-MM-dd");
            await UpdateValue(parsedCulture);
            return;
        }

        _dateString = ApplyDateMask(raw);
        if (_dateString.Length == 10 && DateTime.TryParseExact(_dateString, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedMasked))
        {
            await UpdateValue(parsedMasked);
        }
    }

    private async Task HandleClearAsync()
    {
        _dateString = string.Empty;
        _isOpen = false;
        await UpdateValue(null);
        await ClearAsync();
    }

    private async Task UpdateValue(DateTime? dt)
    {
        if (typeof(TValue) == typeof(DateTime))
        {
            await SetValueAsync((TValue)(object)(dt ?? default(DateTime)));
        }
        else
        {
            await SetValueAsync((TValue?)(object?)dt);
        }
    }

    private string ApplyDateMask(string input)
    {
        var digits = new string(input.Where(char.IsDigit).ToArray());

        if (digits.Length == 0)
        {
            return string.Empty;
        }

        if (digits.Length <= 4)
        {
            return digits;
        }

        if (digits.Length <= 6)
        {
            return $"{digits.Substring(0, 4)}-{digits.Substring(4)}";
        }

        var year = digits.Substring(0, 4);
        var month = digits.Substring(4, 2);
        var day = digits.Substring(6, Math.Min(2, digits.Length - 6));

        return $"{year}-{month}-{day}";
    }
}
