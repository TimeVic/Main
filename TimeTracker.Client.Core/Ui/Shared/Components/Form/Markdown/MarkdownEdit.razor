@using TimeTracker.Client.Core.Services.UI
@using TimeTracker.Client.Core.Core.Helpers
@namespace TimeTracker.Client.Core.Ui.Shared.Components.Form

<div class="@($"{Class} w-markdown-editor w-full")">

    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">@Label</label>
    }
    
    @if (_isShowEditBox)
    {
        <div class="w-full">
            @if (IsModeTabsVisible)
            {
                <div class="w-markdown-editor-tabs" role="tablist" aria-label="@DashboardLocalizer["MarkdownEdit_Modes"]">
                    <button
                        type="button"
                        role="tab"
                        aria-selected="@(_editorMode == MarkdownEditorMode.Edit)"
                        class="@GetEditorTabClass(MarkdownEditorMode.Edit)"
                        @onclick="@(() => SetEditorMode(MarkdownEditorMode.Edit))">
                        @DashboardLocalizer["MarkdownEdit_Edit"]
                    </button>
                    <button
                        type="button"
                        role="tab"
                        aria-selected="@(_editorMode == MarkdownEditorMode.View)"
                        class="@GetEditorTabClass(MarkdownEditorMode.View)"
                        @onclick="@(() => SetEditorMode(MarkdownEditorMode.View))">
                        @DashboardLocalizer["MarkdownEdit_View"]
                    </button>
                </div>
            }

            @if (_editorMode == MarkdownEditorMode.Edit)
            {
                <div class="w-markdown-editor-surface">
                    <div class="w-markdown-editor-toolbar" role="toolbar" aria-label="@DashboardLocalizer["MarkdownEdit_Toolbar"]">
                        <div class="w-markdown-editor-toolbar-group">
                            <button type="button" class="w-markdown-editor-tool-button" title="@DashboardLocalizer["MarkdownEdit_Heading1"]" aria-label="@DashboardLocalizer["MarkdownEdit_Heading1"]" @onclick="@(() => ApplyMarkdownFormatAsync(MarkdownFormat.Heading1))">H1</button>
                            <button type="button" class="w-markdown-editor-tool-button" title="@DashboardLocalizer["MarkdownEdit_Heading2"]" aria-label="@DashboardLocalizer["MarkdownEdit_Heading2"]" @onclick="@(() => ApplyMarkdownFormatAsync(MarkdownFormat.Heading2))">H2</button>
                            <button type="button" class="w-markdown-editor-tool-button" title="@DashboardLocalizer["MarkdownEdit_Heading3"]" aria-label="@DashboardLocalizer["MarkdownEdit_Heading3"]" @onclick="@(() => ApplyMarkdownFormatAsync(MarkdownFormat.Heading3))">H3</button>
                        </div>
                        <div class="w-markdown-editor-toolbar-group">
                            <button type="button" class="w-markdown-editor-tool-button" title="@DashboardLocalizer["MarkdownEdit_Bold"]" aria-label="@DashboardLocalizer["MarkdownEdit_Bold"]" @onclick="@(() => ApplyMarkdownFormatAsync(MarkdownFormat.Bold))"><i class="fa-solid fa-bold"></i></button>
                            <button type="button" class="w-markdown-editor-tool-button" title="@DashboardLocalizer["MarkdownEdit_Italic"]" aria-label="@DashboardLocalizer["MarkdownEdit_Italic"]" @onclick="@(() => ApplyMarkdownFormatAsync(MarkdownFormat.Italic))"><i class="fa-solid fa-italic"></i></button>
                            <button type="button" class="w-markdown-editor-tool-button" title="@DashboardLocalizer["MarkdownEdit_Strikethrough"]" aria-label="@DashboardLocalizer["MarkdownEdit_Strikethrough"]" @onclick="@(() => ApplyMarkdownFormatAsync(MarkdownFormat.Strikethrough))"><i class="fa-solid fa-strikethrough"></i></button>
                        </div>
                        <div class="w-markdown-editor-toolbar-group">
                            <button type="button" class="w-markdown-editor-tool-button" title="@DashboardLocalizer["MarkdownEdit_Quote"]" aria-label="@DashboardLocalizer["MarkdownEdit_Quote"]" @onclick="@(() => ApplyMarkdownFormatAsync(MarkdownFormat.Quote))"><i class="fa-solid fa-quote-left"></i></button>
                            <button type="button" class="w-markdown-editor-tool-button" title="@DashboardLocalizer["MarkdownEdit_Code"]" aria-label="@DashboardLocalizer["MarkdownEdit_Code"]" @onclick="@(() => ApplyMarkdownFormatAsync(MarkdownFormat.Code))"><i class="fa-solid fa-code"></i></button>
                            <button type="button" class="w-markdown-editor-tool-button" title="@DashboardLocalizer["MarkdownEdit_Link"]" aria-label="@DashboardLocalizer["MarkdownEdit_Link"]" @onclick="@(() => ApplyMarkdownFormatAsync(MarkdownFormat.Link))"><i class="fa-solid fa-link"></i></button>
                        </div>
                        <div class="w-markdown-editor-toolbar-group">
                            <button type="button" class="w-markdown-editor-tool-button" title="@DashboardLocalizer["MarkdownEdit_BulletedList"]" aria-label="@DashboardLocalizer["MarkdownEdit_BulletedList"]" @onclick="@(() => ApplyMarkdownFormatAsync(MarkdownFormat.BulletedList))"><i class="fa-solid fa-list-ul"></i></button>
                            <button type="button" class="w-markdown-editor-tool-button" title="@DashboardLocalizer["MarkdownEdit_OrderedList"]" aria-label="@DashboardLocalizer["MarkdownEdit_OrderedList"]" @onclick="@(() => ApplyMarkdownFormatAsync(MarkdownFormat.OrderedList))"><i class="fa-solid fa-list-ol"></i></button>
                            <button type="button" class="w-markdown-editor-tool-button" title="@DashboardLocalizer["MarkdownEdit_TaskList"]" aria-label="@DashboardLocalizer["MarkdownEdit_TaskList"]" @onclick="@(() => ApplyMarkdownFormatAsync(MarkdownFormat.TaskList))"><i class="fa-solid fa-list-check"></i></button>
                        </div>
                    </div>

                    <textarea
                        @ref="_editor"
                        name="@TextAreaName"
                        placeholder="@Placeholder"
                        @bind="@_editValue"
                        @bind:event="oninput"
                        @bind:after="@OnEditValueChanged"
                        maxlength="@MaxLength"
                        rows="@_textAreaRows"
                        style="min-height: @(MinHeight)px"
                        class="w-markdown-editor-input w-full resize-y bg-white px-4 py-3 text-sm text-slate-700 focus:outline-none"></textarea>
                </div>
                <p class="w-support mt-2 text-slate-500">
                    @DashboardLocalizer["MarkdownEdit_Supports"]
                    <a class="text-blue-600 hover:text-blue-700" href="https://www.markdownguide.org/basic-syntax/" target="_blank" rel="noopener noreferrer">
                        @DashboardLocalizer["MarkdownEdit_Markdown"]
                    </a>
                </p>
            }
            else
            {
                <MarkdownContent
                    Class="w-markdown-editor-preview"
                    Content="@_editValue"
                    MinHeight="@PreviewMinHeight" />
            }

        </div>
        @if (IsInlineActionsEnabled && _isActionButtonsEnabled)
        {
            <div class="mt-3 flex items-center gap-2">
                <AppButton
                    Size="ComponentSize.Small"
                    Variant="ButtonVariant.Outlined"
                    Color="ComponentColor.Default"
                    OnClick="@OnClickCancel">
                    @DashboardLocalizer["Cancel"]
                </AppButton>
                
                <AppButton
                    Size="ComponentSize.Small"
                    Color="ComponentColor.Primary"
                    OnClick="@OnClickSave">
                    <StartContent>
                        <i class="fa-regular fa-floppy-disk text-xs"></i>
                    </StartContent>
                    <ChildContent>@DashboardLocalizer["Save"]</ChildContent>
                </AppButton>
            </div>
        }
    }
    else
    {
        <MarkdownContent
            Class="w-view"
            Content="@_value"
            EmptyText="@EmptyText"
            OnClick="@OnClickView" />
    }
</div>
