@typeparam TItem

<div class="mt-5 border-t border-slate-200 pt-1">
    @if (IsLoading && !Items.Any())
    {
        <div class="flex justify-center py-6">
            <LumexSpinner Size="@Size.Medium" />
        </div>
    }
    else if (!Items.Any())
    {
        @EmptyContent
    }
    else
    {
        <div class="@ItemsClass">
            @foreach (var item in Items)
            {
                @ItemTemplate(item)
            }
        </div>
    }

    @if (IsHasMore)
    {
        <div class="mt-4 flex justify-center">
            <CustomButton
                Size="Size.Small"
                Variant="Variant.Outlined"
                Color="ThemeColor.Default"
                IsLoading="@IsLoading"
                OnClick="OnLoadMore">
                <StartContent>
                    <i class="fa-solid fa-chevron-down text-xs"></i>
                </StartContent>
                <ChildContent>@LoadMoreText</ChildContent>
            </CustomButton>
        </div>
    }
</div>
