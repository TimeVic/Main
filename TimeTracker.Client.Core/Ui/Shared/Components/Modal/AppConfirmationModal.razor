@using TimeTracker.Client.Core.Services.UI.Modal

<AppModalHeader
    Title="@(string.IsNullOrWhiteSpace(Title) ? CommonLocalizer["ConfirmAction"].Value : Title)"
    HasCloseButton="true">
    <Icon>
        <div
            class="flex h-9 w-9 items-center justify-center rounded-xl @_iconBoxClass">
            <i
                class="@_iconClass"></i>
        </div>
    </Icon>
</AppModalHeader>

<AppModalBody>
    <p
        class="text-sm text-slate-600">
        @Message
    </p>
</AppModalBody>

<AppModalFooter
    Class="flex items-center justify-end gap-2.5">
    <button
        type="button"
        class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition cursor-pointer"
        @onclick="@OnCancel">
        @(string.IsNullOrWhiteSpace(CancelText) ? CommonLocalizer["Cancel"].Value : CancelText)
    </button>
    <button
        type="button"
        class="rounded-xl px-4 py-2 text-sm font-medium transition cursor-pointer @_confirmButtonClass"
        @onclick="@OnConfirm">
        @(string.IsNullOrWhiteSpace(ConfirmText) ? CommonLocalizer["Confirm"].Value : ConfirmText)
    </button>
</AppModalFooter>
