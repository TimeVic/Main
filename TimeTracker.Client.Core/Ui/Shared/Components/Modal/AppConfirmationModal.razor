@using TimeTracker.Client.Core.Services.UI.Modal
@inject IStringLocalizer<CommonComponentsResource> CommonLocalizer

<AppModalHeader
    Title="@(string.IsNullOrWhiteSpace(Title) ? CommonLocalizer["ConfirmAction"].Value : Title)"
    HasCloseButton="true"
    Icon="@_iconClass"
    IconColorClass="@_iconBoxClass" />

<AppModalBody>
    <p
        class="text-sm text-slate-600">
        @Message
    </p>
</AppModalBody>

<AppModalFooter>
    <AppButton
        Color="@ComponentColor.Default"
        Variant="@ButtonVariant.Outlined"
        Radius="@ButtonRadius.Medium"
        OnClick="@OnCancel">
        @(string.IsNullOrWhiteSpace(CancelText) ? CommonLocalizer["Cancel"].Value : CancelText)
    </AppButton>
    <AppButton
        Color="@_confirmButtonColor"
        Variant="@ButtonVariant.Solid"
        Radius="@ButtonRadius.Medium"
        OnClick="@OnConfirm">
        @(string.IsNullOrWhiteSpace(ConfirmText) ? CommonLocalizer["Confirm"].Value : ConfirmText)
    </AppButton>
</AppModalFooter>
