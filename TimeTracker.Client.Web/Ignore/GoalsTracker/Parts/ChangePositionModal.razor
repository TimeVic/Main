@inherits BaseComponent

<MudDialog Style="min-width: 300px;">
    <DialogContent>
        <Dropzone Items="@_goals">
            <AppCard Class="mb-2 cursor-move">
                <AppCardBody Class="p-2">
                    @context.Name
                </AppCardBody>
            </AppCard>
        </Dropzone>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@OnCloseModal">Cancel</MudButton>
        <MudButton
            ButtonType="MudBlazor.ButtonType.Submit"
            OnClick="@Submit"
            Color="Color.Primary">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>
