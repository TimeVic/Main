@inherits BaseComponent

<MudDialog Style="min-width: 500px;">
    <DialogContent>
        <EditForm
            @ref="_form"
            @bind-IsValid="_isValid">
            <FluentTextField
                FullWidth="true"
                T="string"
                Name="Name"
                OnKeyUp="@OnKeyUp"
                Label="Goal"
                @bind-Value="model.Name"/>
            <MudSpacer/>
            <FluentNumberField
                FullWidth="true"
                OnKeyUp="@OnKeyUp"
                T="int"
                Name="Goal"
                @bind-Value="model.NumberOfTimes"
                Label="Number of times to perform goal in a month"/>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@OnCloseModal">Cancel</MudButton>
        <MudButton
            ButtonType="MudBlazor.ButtonType.Submit"
            OnClick="@Submit"
            Disabled="@_isLoading"
            Color="Color.Primary">
            Add
        </MudButton>
    </DialogActions>
</MudDialog>
