@using TimeTracker.Client.Web.Ui.Shared.Components.Layout
@using TimeTracker.Client.Web.Services
@inject IStringLocalizer<PublicLandingResource> SharedLocalizer
@inject ILocalizationUrlService LocalizationUrlService
@inject NavigationManager NavigationManager

<header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
        <AppLogoBlock Eyebrow="@SharedLocalizer["AppLogo_Eyebrow"]" />

        <nav class="hidden items-center gap-6 md:flex">
            <a href="@NavHomeUrl" class="text-sm font-medium text-slate-600 transition hover:text-slate-900">@SharedLocalizer["Nav_Home"]</a>
            <a href="@NavUseCasesUrl" class="text-sm font-medium text-slate-600 transition hover:text-slate-900">@SharedLocalizer["Nav_UseCases"]</a>
            <a href="@NavPricingUrl" class="text-sm font-medium text-slate-600 transition hover:text-slate-900">@SharedLocalizer["Nav_Pricing"]</a>
            <a href="@NavFaqUrl" class="text-sm font-medium text-slate-600 transition hover:text-slate-900">@SharedLocalizer["Nav_FAQ"]</a>
            <div class="flex items-center gap-1 border-l border-slate-200 pl-4 text-sm font-medium">
                <a href="@EnglishSwitchUrl" class="@(!IsUkrainianLocale ? "font-semibold text-slate-900" : "text-slate-400 hover:text-slate-600") inline-flex items-center gap-1 transition">
                    <span>EN</span>
                </a>
                <span class="text-slate-300">|</span>
                <a href="@UkrainianSwitchUrl" class="@(IsUkrainianLocale ? "font-semibold text-slate-900" : "text-slate-400 hover:text-slate-600") inline-flex items-center gap-1 transition">
                    <span>UK</span>
                </a>
            </div>
            <a href="@RegistrationUrl" class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">
                <i class="fa-solid fa-user-plus"></i>
                <span>@SharedLocalizer["CTA_RegisterIncomeFree"]</span>
            </a>
            <a href="@LoginUrl" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50">
                <i class="fa-solid fa-arrow-right-to-bracket"></i>
                <span>@SharedLocalizer["CTA_Login"]</span>
            </a>
        </nav>
    </div>
</header>

@code {
    private string CurrentPath => new Uri(NavigationManager.Uri).AbsolutePath;

    private string CurrentCulture => LocalizationUrlService.GetCurrentCultureName(CurrentPath);

    private bool IsUkrainianLocale => CurrentCulture == ILocalizationUrlService.UkrainianCultureName;

    private string NavHomeUrl => LocalizationUrlService.GetLocalizedUrl(SiteUrl.Main, CurrentCulture);

    private string NavUseCasesUrl => LocalizationUrlService.GetLocalizedUrl(SiteUrl.UseCases, CurrentCulture);

    private string NavPricingUrl => LocalizationUrlService.GetLocalizedUrl(SiteUrl.Pricing, CurrentCulture);

    private string NavFaqUrl => LocalizationUrlService.GetLocalizedUrl(SiteUrl.Faq, CurrentCulture);

    private string LoginUrl => LocalizationUrlService.GetLocalizedUrl(SiteUrl.Login, CurrentCulture);

    private string RegistrationUrl => LocalizationUrlService.GetLocalizedUrl(SiteUrl.Registration_Step1, CurrentCulture);

    private string EnglishSwitchUrl => LocalizationUrlService.GetEnglishUrl(CurrentPath);

    private string UkrainianSwitchUrl => LocalizationUrlService.GetUkrainianUrl(CurrentPath);
}
