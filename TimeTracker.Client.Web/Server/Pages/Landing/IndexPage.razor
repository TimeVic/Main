    <script>
        function setHeroMode(mode) {
            var soloElements = document.querySelectorAll('[data-hero-mode="solo"]');
            var teamElements = document.querySelectorAll('[data-hero-mode="team"]');
            var soloBtn = document.getElementById('hero-toggle-solo-btn');
            var teamBtn = document.getElementById('hero-toggle-team-btn');

            if (mode === 'team') {
                soloElements.forEach(function (el) { el.classList.add('hidden'); });
                teamElements.forEach(function (el) { el.classList.remove('hidden'); });

                if (soloBtn && teamBtn) {
                    soloBtn.className = "inline-flex items-center gap-2 rounded-xl px-5 py-2.5 text-sm font-medium text-slate-600 transition hover:text-slate-900";
                    teamBtn.className = "inline-flex items-center gap-2 rounded-xl bg-white px-5 py-2.5 text-sm font-semibold text-slate-950 shadow-sm transition";
                }
            } else {
                teamElements.forEach(function (el) { el.classList.add('hidden'); });
                soloElements.forEach(function (el) { el.classList.remove('hidden'); });

                if (soloBtn && teamBtn) {
                    soloBtn.className = "inline-flex items-center gap-2 rounded-xl bg-white px-5 py-2.5 text-sm font-semibold text-slate-950 shadow-sm transition";
                    teamBtn.className = "inline-flex items-center gap-2 rounded-xl px-5 py-2.5 text-sm font-medium text-slate-600 transition hover:text-slate-900";
                }
            }
        }
    </script>

