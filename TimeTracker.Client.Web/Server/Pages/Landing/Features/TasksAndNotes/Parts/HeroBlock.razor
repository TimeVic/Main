@using LumexUI.Common
@using TimeTracker.Client.Web.Services
@using TimeTracker.Client.Web.Ui.Pages.Landing
@namespace TimeTracker.Client.Web.Ui.Pages.Landing.TasksAndNotes.Parts
@inject IStringLocalizer<TasksAndNotesPage> Localizer
@inject IStringLocalizer<PublicLandingResource> SharedLocalizer
@inject ILocalizationUrlService LocalizationUrlService
@inject NavigationManager NavigationManager

<section class="relative overflow-hidden border-b border-slate-200 bg-gradient-to-br from-indigo-50/70 via-white to-blue-50/70 py-16 sm:py-24">
    <div class="absolute inset-x-0 top-0 h-96 bg-[radial-gradient(ellipse_at_top,_rgba(79,70,229,0.12),_transparent_55%)] pointer-events-none"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-4xl text-center">
            <div class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white/90 px-4 py-1.5 text-xs sm:text-sm font-semibold text-indigo-700 shadow-sm backdrop-blur">
                <i class="fa-solid fa-layer-group text-indigo-600"></i>
                <span>@Localizer["Hero_Badge"]</span>
            </div>

            <h1 class="mt-6 text-3xl font-bold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl leading-[1.15]">
                @Localizer["Hero_Title"]
            </h1>

            <p class="mx-auto mt-6 max-w-3xl text-base text-slate-600 sm:text-xl sm:leading-8">
                @Localizer["Hero_Subtitle"]
            </p>

            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <a
                    href="@LocalizedUrl(SiteUrl.Registration_Step1)"
                    class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-blue-600 px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700 sm:w-auto">
                    <i class="fa-solid fa-rocket"></i>
                    <span>@Localizer["Hero_Cta_Start"]</span>
                </a>
                <a
                    href="@LocalizedUrl(SiteUrl.LoginAsDemo)"
                    class="inline-flex w-full items-center justify-center gap-2 rounded-2xl border border-slate-300 bg-white px-7 py-3.5 text-base font-semibold text-slate-700 shadow-sm transition hover:border-slate-400 hover:bg-slate-50 sm:w-auto">
                    <i class="fa-regular fa-eye"></i>
                    <span>@Localizer["Hero_Cta_Demo"]</span>
                </a>
            </div>

            <p class="mt-3 text-xs font-medium text-slate-500 sm:text-sm">
                @Localizer["Hero_Subtext"]
            </p>

            <div class="mt-8 flex flex-wrap items-center justify-center gap-2 sm:gap-3">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-blue-200/80 bg-blue-50/80 px-3.5 py-1 text-xs font-medium text-blue-700">
                    <i class="fa-solid fa-check text-[10px]"></i>
                    @Localizer["Hero_Pill_Tasks"]
                </span>
                <span class="inline-flex items-center gap-1.5 rounded-full border border-indigo-200/80 bg-indigo-50/80 px-3.5 py-1 text-xs font-medium text-indigo-700">
                    <i class="fa-solid fa-check text-[10px]"></i>
                    @Localizer["Hero_Pill_Wiki"]
                </span>
                <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200/80 bg-emerald-50/80 px-3.5 py-1 text-xs font-medium text-emerald-700">
                    <i class="fa-solid fa-check text-[10px]"></i>
                    @Localizer["Hero_Pill_Bridge"]
                </span>
            </div>
        </div>

        <div class="mt-12 sm:mt-16">
            <div class="relative mx-auto max-w-5xl rounded-2xl sm:rounded-3xl border border-slate-200/90 bg-white p-2 sm:p-3 shadow-2xl shadow-slate-300/50 ring-1 ring-slate-900/5">
                <div class="flex items-center gap-2 border-b border-slate-100 px-3 py-2 text-xs text-slate-400">
                    <div class="flex gap-1.5">
                        <span class="h-3 w-3 rounded-full bg-slate-200"></span>
                        <span class="h-3 w-3 rounded-full bg-slate-200"></span>
                        <span class="h-3 w-3 rounded-full bg-slate-200"></span>
                    </div>
                    <span class="mx-auto font-mono text-[11px] text-slate-400">timevic.com / board / notes</span>
                </div>
                <div class="overflow-hidden rounded-xl sm:rounded-2xl">
                    <img
                        src="/img/features/notes_page_team_mode.png"
                        alt="@Localizer["Hero_Title"]"
                        class="w-full h-auto object-cover"
                        loading="eager" />
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string CurrentPath => new Uri(NavigationManager.Uri).AbsolutePath;

    private string CurrentCulture => LocalizationUrlService.GetCurrentCultureName(CurrentPath);

    private string LocalizedUrl(string path) => LocalizationUrlService.GetLocalizedUrl(path, CurrentCulture);
}
