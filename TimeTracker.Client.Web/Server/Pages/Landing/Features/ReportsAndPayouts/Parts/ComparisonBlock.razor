@using TimeTracker.Client.Web.Ui.Pages.Landing
@namespace TimeTracker.Client.Web.Ui.Pages.Landing.ReportsAndPayouts.Parts
@inject IStringLocalizer<ReportsAndPayoutsPage> Localizer

<section class="border-b border-slate-200 bg-slate-50 py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
            <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-blue-700 shadow-sm">
                <i class="fa-solid fa-code-compare"></i>
                <span>@Localizer["Comparison_Badge"]</span>
            </div>

            <h2 class="mt-4 text-3xl font-bold text-slate-950 sm:text-4xl">
                @Localizer["Comparison_Title"]
            </h2>
        </div>

        <div class="mt-12 grid gap-8 lg:grid-cols-2">
            @* Column 1: Manual Excel Spreadsheet *@
            <div class="rounded-3xl border border-rose-200 bg-white p-6 sm:p-8 shadow-sm">
                <div class="flex items-center gap-3 border-b border-rose-100 pb-5">
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-rose-100 text-rose-600">
                        <i class="fa-solid fa-file-excel text-lg"></i>
                    </span>
                    <h3 class="text-xl font-bold text-slate-900">
                        @Localizer["Comparison_Excel_Title"]
                    </h3>
                </div>

                <ul class="mt-6 space-y-4">
                    <li class="flex items-start gap-3 text-sm text-slate-600 sm:text-base">
                        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-rose-100 text-rose-600">
                            <i class="fa-solid fa-xmark text-xs"></i>
                        </span>
                        <span>@Localizer["Comparison_Point1_Excel"]</span>
                    </li>
                    <li class="flex items-start gap-3 text-sm text-slate-600 sm:text-base">
                        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-rose-100 text-rose-600">
                            <i class="fa-solid fa-xmark text-xs"></i>
                        </span>
                        <span>@Localizer["Comparison_Point2_Excel"]</span>
                    </li>
                    <li class="flex items-start gap-3 text-sm text-slate-600 sm:text-base">
                        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-rose-100 text-rose-600">
                            <i class="fa-solid fa-xmark text-xs"></i>
                        </span>
                        <span>@Localizer["Comparison_Point3_Excel"]</span>
                    </li>
                    <li class="flex items-start gap-3 text-sm text-slate-600 sm:text-base">
                        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-rose-100 text-rose-600">
                            <i class="fa-solid fa-xmark text-xs"></i>
                        </span>
                        <span>@Localizer["Comparison_Point4_Excel"]</span>
                    </li>
                </ul>
            </div>

            @* Column 2: TimeVic Automated Engine *@
            <div class="rounded-3xl border border-emerald-200 bg-gradient-to-br from-white via-emerald-50/40 to-blue-50/40 p-6 sm:p-8 shadow-md">
                <div class="flex items-center gap-3 border-b border-emerald-100 pb-5">
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-600 text-white shadow-sm">
                        <i class="fa-solid fa-bolt text-lg"></i>
                    </span>
                    <h3 class="text-xl font-bold text-slate-900">
                        @Localizer["Comparison_TimeVic_Title"]
                    </h3>
                </div>

                <ul class="mt-6 space-y-4">
                    <li class="flex items-start gap-3 text-sm font-medium text-slate-800 sm:text-base">
                        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                            <i class="fa-solid fa-check text-xs"></i>
                        </span>
                        <span>@Localizer["Comparison_Point1_TimeVic"]</span>
                    </li>
                    <li class="flex items-start gap-3 text-sm font-medium text-slate-800 sm:text-base">
                        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                            <i class="fa-solid fa-check text-xs"></i>
                        </span>
                        <span>@Localizer["Comparison_Point2_TimeVic"]</span>
                    </li>
                    <li class="flex items-start gap-3 text-sm font-medium text-slate-800 sm:text-base">
                        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                            <i class="fa-solid fa-check text-xs"></i>
                        </span>
                        <span>@Localizer["Comparison_Point3_TimeVic"]</span>
                    </li>
                    <li class="flex items-start gap-3 text-sm font-medium text-slate-800 sm:text-base">
                        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                            <i class="fa-solid fa-check text-xs"></i>
                        </span>
                        <span>@Localizer["Comparison_Point4_TimeVic"]</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>
