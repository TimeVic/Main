@page "/features/reports-and-payouts"
@page "/uk/features/reports-and-payouts"
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

@using LumexUI.Common
@using TimeTracker.Client.Web.Services
@using TimeTracker.Client.Web.Ui.Pages.Landing.ReportsAndPayouts.Parts
@using Layout = TimeTracker.Client.Web.Server.Shared.StaticLandingLayout
@namespace TimeTracker.Client.Web.Ui.Pages.Landing
@layout Layout

@inject IStringLocalizer<PublicLandingResource> SharedLocalizer
@inject IStringLocalizer<ReportsAndPayoutsPage> Localizer
@inject ILocalizationUrlService LocalizationUrlService
@inject NavigationManager NavigationManager

<SeoHead
    Title="@Localizer["Meta_Title"]"
    Description="@Localizer["Meta_Description"]"
    Keywords="@Localizer["Meta_Keywords"]"
    Robots="@SiteMetadata.IndexRobots"
    PublicPagePath="@SiteUrl.FeaturesReportsAndPayouts" />

<main class="bg-white text-slate-950">
    <HeroBlock />
    <DeveloperCabinetBlock />
    <WorkspaceProfitabilityBlock />
    <SharedClientReportsBlock />
    <ComparisonBlock />
    <BottomCtaBlock />
</main>
