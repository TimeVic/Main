@using TimeTracker.Client.Web.Ui.Pages.Landing
@namespace TimeTracker.Client.Web.Ui.Pages.Landing.TimeAndApprovals.Parts
@inject IStringLocalizer<TimeAndApprovalsPage> Localizer

<section class="border-b border-slate-200 bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
            <div class="lg:col-span-6">
                <div class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3.5 py-1.5 text-xs font-semibold text-emerald-700">
                    <i class="fa-solid fa-user-astronaut"></i>
                    <span>@Localizer["Block1_Badge"]</span>
                </div>

                <h3 class="mt-4 text-2xl font-bold text-slate-950 sm:text-3xl lg:text-4xl leading-tight">
                    @Localizer["Block1_Title"]
                </h3>

                <p class="mt-4 text-base text-slate-600 sm:text-lg leading-relaxed">
                    @Localizer["Block1_Description"]
                </p>

                <div class="mt-8 space-y-4">
                    <div class="flex items-start gap-4 rounded-2xl border border-slate-100 bg-slate-50 p-4 transition hover:border-emerald-200 hover:bg-emerald-50/40">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white shadow-sm">
                            <i class="fa-solid fa-play text-sm"></i>
                        </div>
                        <div>
                            <h4 class="text-base font-semibold text-slate-900">
                                @Localizer["Block1_Item1_Title"]
                            </h4>
                            <p class="mt-1 text-sm text-slate-600 leading-relaxed">
                                @Localizer["Block1_Item1_Desc"]
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4 rounded-2xl border border-slate-100 bg-slate-50 p-4 transition hover:border-emerald-200 hover:bg-emerald-50/40">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-600 text-white shadow-sm">
                            <i class="fa-solid fa-pen-to-square text-sm"></i>
                        </div>
                        <div>
                            <h4 class="text-base font-semibold text-slate-900">
                                @Localizer["Block1_Item2_Title"]
                            </h4>
                            <p class="mt-1 text-sm text-slate-600 leading-relaxed">
                                @Localizer["Block1_Item2_Desc"]
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4 rounded-2xl border border-slate-100 bg-slate-50 p-4 transition hover:border-emerald-200 hover:bg-emerald-50/40">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-violet-600 text-white shadow-sm">
                            <i class="fa-solid fa-wallet text-sm"></i>
                        </div>
                        <div>
                            <h4 class="text-base font-semibold text-slate-900">
                                @Localizer["Block1_Item3_Title"]
                            </h4>
                            <p class="mt-1 text-sm text-slate-600 leading-relaxed">
                                @Localizer["Block1_Item3_Desc"]
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="relative lg:col-span-6">
                <div class="relative rounded-2xl sm:rounded-3xl border border-slate-200 bg-gradient-to-br from-slate-50 via-white to-emerald-50/30 p-6 sm:p-8 shadow-xl ring-1 ring-slate-900/5">
                    @* Solo Timer Simulation Card *@
                    <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-sm">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                            <div class="flex items-center gap-2">
                                <span class="flex h-3 w-3 rounded-full bg-emerald-500 animate-pulse"></span>
                                <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider">@Localizer["SoloMode_TrackingActive"]</span>
                            </div>
                            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">@Localizer["SoloMode_NoApprovals"]</span>
                        </div>

                        <div class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-4">
                            <div class="w-full">
                                <p class="text-xs font-medium text-slate-400">@Localizer["SoloMode_CurrentTask"]</p>
                                <p class="text-sm font-semibold text-slate-900 truncate">@Localizer["SoloMode_TaskTitle"]</p>
                                <span class="inline-block mt-1 rounded bg-blue-50 px-2 py-0.5 text-[11px] font-medium text-blue-700">@Localizer["SoloMode_Client"]</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="font-mono text-2xl font-bold tracking-tight text-slate-900">03:45:12</span>
                                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-rose-600 text-white shadow-md shadow-rose-600/20">
                                    <i class="fa-solid fa-stop text-sm"></i>
                                </span>
                            </div>
                        </div>
                    </div>

                    @* Sample Freedom Entries List *@
                    <div class="mt-4 space-y-2.5">
                        <div class="flex items-center justify-between rounded-xl border border-slate-200/80 bg-white px-4 py-3 shadow-xs">
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-semibold text-slate-800 truncate">@Localizer["SoloMode_Entry1_Title"]</p>
                                <p class="text-[11px] text-slate-500">10:00 - 12:30 • <span class="text-emerald-600 font-medium">$125.00</span></p>
                            </div>
                            <div class="flex items-center gap-2 text-slate-400">
                                <span class="text-xs font-mono font-medium text-slate-700">2:30:00</span>
                                <span class="cursor-pointer hover:text-blue-600"><i class="fa-solid fa-pen text-xs"></i></span>
                                <span class="cursor-pointer hover:text-rose-600"><i class="fa-solid fa-trash text-xs"></i></span>
                            </div>
                        </div>

                        <div class="flex items-center justify-between rounded-xl border border-slate-200/80 bg-white px-4 py-3 shadow-xs">
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-semibold text-slate-800 truncate">@Localizer["SoloMode_Entry2_Title"]</p>
                                <p class="text-[11px] text-slate-500">14:00 - 15:15 • <span class="text-emerald-600 font-medium">$62.50</span></p>
                            </div>
                            <div class="flex items-center gap-2 text-slate-400">
                                <span class="text-xs font-mono font-medium text-slate-700">1:15:00</span>
                                <span class="cursor-pointer hover:text-blue-600"><i class="fa-solid fa-pen text-xs"></i></span>
                                <span class="cursor-pointer hover:text-rose-600"><i class="fa-solid fa-trash text-xs"></i></span>
                            </div>
                        </div>
                    </div>

                    @* Direct Ledger Highlight *@
                    <div class="mt-4 flex items-center justify-between rounded-xl border border-emerald-200 bg-emerald-50/70 px-4 py-3">
                        <div class="flex items-center gap-2.5">
                            <i class="fa-solid fa-circle-check text-emerald-600"></i>
                            <span class="text-xs font-semibold text-emerald-950">@Localizer["SoloMode_IncomeCalcTitle"]</span>
                        </div>
                        <span class="font-mono text-sm font-bold text-emerald-700">+$187.50 @Localizer["SoloMode_Ready"]</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
