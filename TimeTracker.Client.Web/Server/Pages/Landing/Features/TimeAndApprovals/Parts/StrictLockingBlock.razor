@using TimeTracker.Client.Web.Ui.Pages.Landing
@namespace TimeTracker.Client.Web.Ui.Pages.Landing.TimeAndApprovals.Parts
@inject IStringLocalizer<TimeAndApprovalsPage> Localizer

<section class="border-b border-slate-200 bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
            <div class="lg:col-span-6">
                <div class="inline-flex items-center gap-2 rounded-full border border-violet-200 bg-violet-50 px-3.5 py-1.5 text-xs font-semibold text-violet-700">
                    <i class="fa-solid fa-lock"></i>
                    <span>@Localizer["Block3_Badge"]</span>
                </div>

                <h3 class="mt-4 text-2xl font-bold text-slate-950 sm:text-3xl lg:text-4xl leading-tight">
                    @Localizer["Block3_Title"]
                </h3>

                <p class="mt-4 text-base text-slate-600 sm:text-lg leading-relaxed">
                    @Localizer["Block3_Description"]
                </p>

                <div class="mt-8 space-y-4">
                    <div class="flex items-start gap-4 rounded-2xl border border-slate-100 bg-slate-50 p-4 transition hover:border-violet-200 hover:bg-violet-50/40">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-violet-600 text-white shadow-sm">
                            <i class="fa-solid fa-shield-halved text-sm"></i>
                        </div>
                        <div>
                            <h4 class="text-base font-semibold text-slate-900">
                                @Localizer["Block3_Item1_Title"]
                            </h4>
                            <p class="mt-1 text-sm text-slate-600 leading-relaxed">
                                @Localizer["Block3_Item1_Desc"]
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4 rounded-2xl border border-slate-100 bg-slate-50 p-4 transition hover:border-violet-200 hover:bg-violet-50/40">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-800 text-white shadow-sm">
                            <i class="fa-solid fa-sliders text-sm"></i>
                        </div>
                        <div>
                            <h4 class="text-base font-semibold text-slate-900">
                                @Localizer["Block3_Item2_Title"]
                            </h4>
                            <p class="mt-1 text-sm text-slate-600 leading-relaxed">
                                @Localizer["Block3_Item2_Desc"]
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4 rounded-2xl border border-slate-100 bg-slate-50 p-4 transition hover:border-violet-200 hover:bg-violet-50/40">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white shadow-sm">
                            <i class="fa-solid fa-receipt text-sm"></i>
                        </div>
                        <div>
                            <h4 class="text-base font-semibold text-slate-900">
                                @Localizer["Block3_Item3_Title"]
                            </h4>
                            <p class="mt-1 text-sm text-slate-600 leading-relaxed">
                                @Localizer["Block3_Item3_Desc"]
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="relative lg:col-span-6">
                <div class="relative rounded-2xl sm:rounded-3xl border border-slate-200 bg-gradient-to-br from-slate-50 via-white to-violet-50/30 p-6 sm:p-8 shadow-xl ring-1 ring-slate-900/5">
                    @* Security Status Header *@
                    <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-sm">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                            <div class="flex items-center gap-2">
                                <span class="flex h-3 w-3 rounded-full bg-violet-600 animate-pulse"></span>
                                <span class="text-xs font-semibold text-violet-900 uppercase tracking-wider">@Localizer["StrictLocking_ProtectionActive"]</span>
                            </div>
                            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700">
                                <i class="fa-solid fa-lock text-[10px]"></i>
                                <span>@Localizer["StrictLocking_LockedBadge"]</span>
                            </span>
                        </div>

                        <div class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-4">
                            <div class="w-full">
                                <p class="text-xs font-medium text-slate-400">@Localizer["StrictLocking_ApprovedPeriod"]</p>
                                <p class="text-sm font-semibold text-slate-900">@Localizer["StrictLocking_PeriodDate"]</p>
                                <span class="inline-block mt-1 rounded bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-700">@Localizer["StrictLocking_ApprovedByOwner"]</span>
                            </div>
                            <div class="text-right">
                                <span class="font-mono text-xl font-bold tracking-tight text-slate-900">39:00:00</span>
                                <p class="text-xs font-medium text-emerald-600">$2,210.00 @Localizer["StrictLocking_Billable"]</p>
                            </div>
                        </div>
                    </div>

                    @* Locked Records List *@
                    <div class="mt-4 space-y-2.5">
                        <div class="flex items-center justify-between rounded-xl border border-slate-200/80 bg-white px-4 py-3 shadow-xs opacity-90">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <i class="fa-solid fa-lock text-xs text-slate-400"></i>
                                    <p class="text-xs font-semibold text-slate-800 truncate">@Localizer["StrictLocking_Entry1_Title"]</p>
                                </div>
                                <p class="mt-0.5 text-[11px] text-slate-500">@Localizer["StrictLocking_Entry1_Sub"] <span class="text-emerald-600 font-medium">$720.00</span></p>
                            </div>
                            <span class="rounded bg-slate-100 px-2 py-1 text-[10px] font-semibold text-slate-500">@Localizer["StrictLocking_ReadOnly"]</span>
                        </div>

                        <div class="flex items-center justify-between rounded-xl border border-slate-200/80 bg-white px-4 py-3 shadow-xs opacity-90">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <i class="fa-solid fa-lock text-xs text-slate-400"></i>
                                    <p class="text-xs font-semibold text-slate-800 truncate">@Localizer["StrictLocking_Entry2_Title"]</p>
                                </div>
                                <p class="mt-0.5 text-[11px] text-slate-500">@Localizer["StrictLocking_Entry2_Sub"] <span class="text-emerald-600 font-medium">$990.00</span></p>
                            </div>
                            <span class="rounded bg-slate-100 px-2 py-1 text-[10px] font-semibold text-slate-500">@Localizer["StrictLocking_ReadOnly"]</span>
                        </div>
                    </div>

                    @* Security Guarantee Footer *@
                    <div class="mt-4 flex items-center justify-between rounded-xl border border-violet-200 bg-violet-50/70 px-4 py-3">
                        <div class="flex items-center gap-2.5">
                            <i class="fa-solid fa-shield-halved text-violet-600"></i>
                            <span class="text-xs font-semibold text-violet-950">@Localizer["StrictLocking_GuaranteeTitle"]</span>
                        </div>
                        <span class="text-[11px] font-medium text-violet-700">@Localizer["StrictLocking_GuaranteeSub"]</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
