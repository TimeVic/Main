@page "/pricing"
@page "/uk/pricing"
@attribute [Microsoft.AspNetCore.Components.ExcludeFromInteractiveRouting]

@using TimeTracker.Client.Web.Services
@using Layout = TimeTracker.Client.Web.Server.Shared.StaticLandingLayout
@namespace TimeTracker.Client.Web.Ui.Pages.Landing

@layout Layout

@inject IStringLocalizer<PricingPage> Localizer
@inject ILocalizationUrlService LocalizationUrlService
@inject NavigationManager NavigationManager
<SeoHead
    Title="@Localizer["Meta_Title"]"
    Description="@Localizer["Meta_Description"]"
    Keywords="@Localizer["Meta_Keywords"]"
    Robots="@SiteMetadata.IndexRobots"
    PublicPagePath="@SiteUrl.Pricing" />

<main class="bg-white text-slate-950">
    <section class="relative overflow-hidden border-b border-slate-200 bg-gradient-to-b from-blue-50/50 via-slate-50 to-white">
        <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:py-24">
            <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
                @Localizer["Pricing_Header_Title"]
            </h1>

            <h2 class="mx-auto mt-4 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
                @Localizer["Pricing_Header_Subtitle"]
            </h2>

            <div class="mt-12">
                <div class="mx-auto max-w-2xl rounded-2xl border border-slate-200 bg-slate-50 p-8 text-center shadow-sm md:p-12">
                    <div class="inline-flex items-center gap-1.5 rounded-full border border-blue-200 bg-blue-50 px-3.5 py-1 text-xs font-semibold text-blue-700 shadow-sm">
                        <span>@Localizer["Pricing_Badge_PublicBeta"]</span>
                    </div>

                    <h3 class="mt-6 text-2xl font-bold text-slate-900 sm:text-3xl">
                        @Localizer["Pricing_Card_Title"]
                    </h3>

                    <p class="mt-4 text-sm leading-relaxed text-slate-600 sm:text-base">
                        @Localizer["Pricing_Card_Description"]
                    </p>

                    <div class="my-8 rounded-xl border border-slate-200/80 bg-white p-6 shadow-sm">
                        <ul class="space-y-3.5 text-left text-sm text-slate-700 sm:text-base">
                            <li class="flex items-start gap-3">
                                <i class="fa-solid fa-circle-check mt-1 text-blue-600 text-sm shrink-0"></i>
                                <span>
                                    <strong class="font-semibold text-slate-900">@Localizer["Pricing_Feature_Workspaces_Bold"]</strong>
                                    <span> @Localizer["Pricing_Feature_Workspaces_Text"]</span>
                                </span>
                            </li>
                            <li class="flex items-start gap-3">
                                <i class="fa-solid fa-circle-check mt-1 text-blue-600 text-sm shrink-0"></i>
                                <span>
                                    <strong class="font-semibold text-slate-900">@Localizer["Pricing_Feature_Finance_Bold"]</strong>
                                    <span> @Localizer["Pricing_Feature_Finance_Text"]</span>
                                </span>
                            </li>
                            <li class="flex items-start gap-3">
                                <i class="fa-solid fa-circle-check mt-1 text-blue-600 text-sm shrink-0"></i>
                                <span>
                                    <strong class="font-semibold text-slate-900">@Localizer["Pricing_Feature_Approvals_Bold"]</strong>
                                    @if (!string.IsNullOrWhiteSpace(Localizer["Pricing_Feature_Approvals_Text"]))
                                    {
                                        <span> @Localizer["Pricing_Feature_Approvals_Text"]</span>
                                    }
                                </span>
                            </li>
                            <li class="flex items-start gap-3">
                                <i class="fa-solid fa-circle-check mt-1 text-blue-600 text-sm shrink-0"></i>
                                <span>
                                    <strong class="font-semibold text-slate-900">@Localizer["Pricing_Feature_TasksNotes_Bold"]</strong>
                                    @if (!string.IsNullOrWhiteSpace(Localizer["Pricing_Feature_TasksNotes_Text"]))
                                    {
                                        <span> @Localizer["Pricing_Feature_TasksNotes_Text"]</span>
                                    }
                                </span>
                            </li>
                            <li class="flex items-start gap-3">
                                <i class="fa-solid fa-circle-check mt-1 text-blue-600 text-sm shrink-0"></i>
                                <span>
                                    <strong class="font-semibold text-slate-900">@Localizer["Pricing_Feature_Members_Bold"]</strong>
                                    <span> @Localizer["Pricing_Feature_Members_Text"]</span>
                                </span>
                            </li>
                        </ul>
                    </div>

                    <p class="text-xs italic text-slate-500 sm:text-sm">
                        @Localizer["Pricing_Card_NoCreditCard"]
                    </p>

                    <div class="mt-6">
                        <a
                            href="@LocalizedUrl(SiteUrl.Registration_Step1)"
                            class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-blue-600 px-8 py-3.5 text-center text-sm font-semibold text-white shadow-md shadow-blue-500/20 transition hover:bg-blue-700 sm:w-auto"
                        >
                            <i class="fa-solid fa-rocket text-xs"></i>
                            <span>@Localizer["Pricing_Card_Cta"]</span>
                        </a>
                    </div>
                </div>

                <div class="mx-auto mt-6 max-w-2xl px-4 text-xs leading-relaxed text-slate-500 sm:text-sm">
                    <p>
                        <span>«</span><strong class="font-semibold text-slate-700">@Localizer["Pricing_Transparency_Title"]</strong>
                        <span> @Localizer["Pricing_Transparency_Text"]</span><span>»</span>
                    </p>
                </div>
            </div>
        </div>
    </section>
</main>

@code {
    private string CurrentPath => new Uri(NavigationManager.Uri).AbsolutePath;

    private string CurrentCulture => LocalizationUrlService.GetCurrentCultureName(CurrentPath);

    private string LocalizedUrl(string path) => LocalizationUrlService.GetLocalizedUrl(path, CurrentCulture);
}
