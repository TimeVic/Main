@using LumexUI.Common
@using TimeTracker.Client.Core.Constants.Ui
@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Validation

@inherits BaseReactiveComponent

<LumexModal
    Open="IsOpened"
    OnClose="@OnCloseModal"
    Size="ModalSize.Medium"
    @ref="modal">
    <LumexModalContent>
        <LumexModalHeader Class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                <i class="fa-solid fa-plus"></i>
            </div>
            <div>
                <h2 class="text-xl font-semibold text-slate-900">@DashboardLocalizer["AddClientPayment"]</h2>
                <p class="mt-1 text-sm text-slate-600">@DashboardLocalizer["RecordMoneyReceivedClient"]</p>
            </div>
        </LumexModalHeader>
        <LumexModalBody Class="pt-3">
            <EditForm
                Context="form"
                @ref="_form"
                Model="@model"
                novalidate>
                <DataAnnotationsValidator/>

                <div class="grid gap-x-4 gap-y-5 md:grid-cols-2">
                    <div>
                        <ClientsSelect
                            Type="DropDownType.Select"
                            Size="ComponentSize.Small"
                            Label="@DashboardLocalizer["Client"].Value"
                            Value="model.ClientId"
                            ValueExpression="() => model.ClientId"
                            SelectedItemChanged="OnChangeClient"/>
                        <CustomValidationMessage For="@(() => model.ClientId)"/>
                    </div>
                    <div>
                        <ProjectsSelect
                            Type="DropDownType.Select"
                            Size="ComponentSize.Small"
                            Label="@DashboardLocalizer["Project"].Value"
                            ClientId="model.ClientId"
                            Value="model.ProjectId"
                            ValueExpression="() => model.ProjectId"
                            SelectedItemChanged="OnProjectSelected"
                            Disabled="@(model.ClientId == Guid.Empty)"/>
                    </div>
                    <div>
                        <InputDateField
                            Size="ComponentSize.Small"
                            Required="true"
                            @bind-Value="@model.PaymentTime"
                            Label="@DashboardLocalizer["PaymentDate"].Value"/>
                        <CustomValidationMessage For="@(() => model.PaymentTime)"/>
                    </div>
                    <div>
                        <InputNumericField
                            TItem="decimal"
                            Size="ComponentSize.Small"
                            Required="true"
                            @bind-Value="@model.Amount"
                            Label="@DashboardLocalizer["Amount"].Value"/>
                        <CustomValidationMessage For="@(() => model.Amount)"/>
                    </div>
                    <div class="md:col-span-2">
                        <InputTextareaField
                            Size="ComponentSize.Small"
                            Label="@DashboardLocalizer["PaymentNoteReference"].Value"
                            Placeholder="@DashboardLocalizer["OptionalPaymentNoteReference"].Value"
                            @bind-Value="model.Description"/>
                    </div>
                </div>

                <CustomValidationSummary/>
            </EditForm>
        </LumexModalBody>
        <LumexModalFooter>
            <AppButton
                FullWidth="@true"
                OnClick="@Submit"
                Color="@ComponentColor.Primary"
                Radius="@ButtonRadius.Full">
                <ChildContent>
                    @DashboardLocalizer["Create"]
                </ChildContent>
            </AppButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
