@using Microsoft.AspNetCore.Components.QuickGrid
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.ClientPayments.Parts.Modals
@using TimeTracker.Client.Web.Ui.Shared.Components
@using TimeTracker.Client.Web.Ui.Shared.Components.Dialogs

@inherits BaseReactiveComponent

<AppTable
    TGridItem="ClientPaymentDto"
    Items="@Items.AsQueryable()"
    IsLoading="@_isLoading">
    <AppTableColumn
        Title="@DashboardLocalizer["Date"].Value"
        SortBy="@(GridSort<ClientPaymentDto>.ByAscending(p => p.PaymentTime))">
        <span
            class="text-sm text-slate-700">
            @context.PaymentTime.ToShortDateString()
        </span>
    </AppTableColumn>

    <AppTableColumn
        Title="@DashboardLocalizer["Client"].Value"
        SortBy="@(GridSort<ClientPaymentDto>.ByAscending(p => p.Client.Name))">
        <div
            class="font-medium text-slate-900">
            @context.Client?.Name
        </div>
    </AppTableColumn>

    <AppTableColumn
        Title="@DashboardLocalizer["Project"].Value">
        @if (context.Project != null)
        {
            <span
                class="text-sm text-slate-700">
                @context.Project.Name
            </span>
        }
        else
        {
            <span
                class="text-sm text-slate-400">
                @DashboardLocalizer["NoProject"]
            </span>
        }
    </AppTableColumn>

    <AppTableColumn
        Title="@DashboardLocalizer["Amount"].Value"
        SortBy="@(GridSort<ClientPaymentDto>.ByAscending(p => p.Amount))">
        <span
            class="font-semibold text-emerald-700">
            <AmountDisplay
                Amount="@context.Amount" />
        </span>
    </AppTableColumn>

    <AppTableColumn
        Title="@DashboardLocalizer["AddedBy"].Value">
        <span
            class="text-sm text-slate-400">
            @DashboardLocalizer["NotTracked"]
        </span>
    </AppTableColumn>

    <AppTableColumn
        Title="@DashboardLocalizer["PaymentNoteReference"].Value"
        SortBy="@(GridSort<ClientPaymentDto>.ByAscending(p => p.Description))">
        @if (string.IsNullOrWhiteSpace(context.Description))
        {
            <span
                class="text-sm text-slate-400">
                @DashboardLocalizer["NoNote"]
            </span>
        }
        else
        {
            <span
                class="text-sm text-slate-700">
                @context.Description
            </span>
        }
    </AppTableColumn>

    <AppTableColumn
        Title="@DashboardLocalizer["Actions"].Value"
        Align="Align.End">
        <div
            class="flex items-center justify-end gap-2"
            @onclick:stopPropagation="true">
            <AppButton
                Variant="ButtonVariant.Outlined"
                Color="ComponentColor.Default"
                OnClick="() => OpenViewModal(context)"
                IconOnly="true"
                Size="ComponentSize.Small">
                <StartContent>
                    <i
                        class="fa-regular fa-eye">
                    </i>
                </StartContent>
            </AppButton>
            @if (CanUpdatePayments)
            {
                <AppButton
                    Variant="ButtonVariant.Outlined"
                    Color="ComponentColor.Primary"
                    OnClick="() => OpenUpdateModal(context)"
                    IconOnly="true"
                    Size="ComponentSize.Small">
                    <StartContent>
                        <i
                            class="fa-regular fa-pen-to-square">
                        </i>
                    </StartContent>
                </AppButton>
                <AppButton
                    Variant="ButtonVariant.Outlined"
                    Color="ComponentColor.Danger"
                    OnClick="() => OpenDeleteConfirmation(context)"
                    IconOnly="true"
                    Size="ComponentSize.Small">
                    <StartContent>
                        <i
                            class="fa-regular fa-trash-can">
                        </i>
                    </StartContent>
                </AppButton>
            }
        </div>
    </AppTableColumn>
</AppTable>
