@page "/board/{WorkspaceId:guid}/client-payments"
@attribute [RequireWorkspacePermission(WorkspacePermission.ReadClientPayment)]
@attribute [RequireWorkspaceRole(MembershipAccessType.Owner, MembershipAccessType.Manager)]

@using LumexUI.Common
@using TimeTracker.Api.Shared.Constants
@using TimeTracker.Business.Common.Constants
@using TimeTracker.Client.Core.Constants.Ui
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.ClientPayments.Parts
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.ClientPayments.Parts.Modals
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared
@using TimeTracker.Client.Web.Ui.Shared.Components
@using TimeTracker.Client.Web.Ui.Shared.Components.List

@inherits BaseReactiveComponent
@layout TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Layout
@implements IDisposable

<AddClientPaymentModal
    IsOpened="_isShowAddClientPaymentModal"
    IsOpenedChanged="isOpened => _isShowAddClientPaymentModal = isOpened"/>

<div class="space-y-6">
    <section class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">@DashboardLocalizer["ClientPayments"]</h1>
            <p class="mt-1 text-sm text-slate-500">
                @DashboardLocalizer["ClientPaymentsDescription"]
            </p>
        </div>
        @if (CanCreatePayments)
        {
            <CustomButton OnClick="@(() => _isShowAddClientPaymentModal = true)">
                <StartContent>
                    <i class="fa-solid fa-plus"></i>
                </StartContent>
                <ChildContent>
                    @DashboardLocalizer["AddClientPayment"]
                </ChildContent>
            </CustomButton>
        }
    </section>

    <section class="grid gap-4 md:grid-cols-3">
        <LumexCard>
            <LumexCardBody Class="p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@DashboardLocalizer["Received"]</p>
                <p class="mt-2 text-2xl font-bold text-emerald-700">
                    <AmountDisplay Amount="@FilteredTotal"></AmountDisplay>
                </p>
                <p class="mt-1 text-xs text-slate-500">@DashboardLocalizer["PaymentsMatchingCurrentFilters"]</p>
            </LumexCardBody>
        </LumexCard>
        <LumexCard>
            <LumexCardBody Class="p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@DashboardLocalizer["ClientsPaid"]</p>
                <p class="mt-2 text-2xl font-bold text-slate-900">@PaidClientsCount</p>
                <p class="mt-1 text-xs text-slate-500">@DashboardLocalizer["UniqueClientsFilteredList"]</p>
            </LumexCardBody>
        </LumexCard>
        <LumexCard>
            <LumexCardBody Class="p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@DashboardLocalizer["OutstandingBalance"]</p>
                <p class="mt-2 text-2xl font-bold text-slate-900">@DashboardLocalizer["NotTracked"]</p>
                <p class="mt-1 text-xs text-slate-500">@DashboardLocalizer["ClientPaymentsRecordedSeparately"]</p>
            </LumexCardBody>
        </LumexCard>
    </section>

    <LumexCard>
        <LumexCardHeader>
            <div>
                <p class="text-sm font-semibold text-slate-900">@DashboardLocalizer["Filters"]</p>
                <p class="text-sm text-slate-500">@DashboardLocalizer["PaymentsFiltersHelper"]</p>
            </div>
        </LumexCardHeader>
        <LumexCardBody>
            <div class="grid gap-4 md:grid-cols-3">
                <div>
                    <ClientsSelect
                        Label="@DashboardLocalizer["Client"].Value"
                        Clearable="true"
                        Value="@SelectedClientId"
                        SelectedItemChanged="OnClientFilterChanged"/>
                </div>
                <div>
                    <ProjectsSelect
                        Label="@DashboardLocalizer["Project"].Value"
                        Clearable="true"
                        ClientId="@SelectedClientId"
                        Value="@SelectedProjectId"
                        SelectedItemChanged="OnProjectFilterChanged"/>
                </div>
                <div>
                    <LumexTextbox
                        Label="@DashboardLocalizer["Search"].Value"
                        LabelPlacement="LabelPlacement.Outside"
                        Placeholder="@DashboardLocalizer["ClientProjectNoteReference"].Value"
                        Value="@_search"
                        ValueChanged="OnSearchValueChanged"
                        Clearable="true"/>
                </div>
            </div>
        </LumexCardBody>
    </LumexCard>

    <LumexCard Class="overflow-x-auto pb-2">
        <LumexCardHeader Class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-sm font-semibold text-slate-900">@DashboardLocalizer["ReceivedClientPayments"]</p>
                <p class="text-sm text-slate-500">@DashboardLocalizer["ReceivedClientPaymentsHelper"]</p>
            </div>
        </LumexCardHeader>
        <LumexCardBody>
            @if (!_state.Value.IsListLoading && !FilteredPayments.Any())
            {
                <div class="px-4 py-12 text-center">
                    <p class="text-base font-semibold text-slate-900">@DashboardLocalizer["NoClientPaymentsYet"]</p>
                    <p class="mt-2 text-sm text-slate-500">
                        @DashboardLocalizer["NoClientPaymentsHelper"]
                    </p>
                    @if (CanCreatePayments)
                    {
                        <div class="mt-5">
                            <CustomButton OnClick="@(() => _isShowAddClientPaymentModal = true)">
                                <StartContent>
                                    <i class="fa-solid fa-plus"></i>
                                </StartContent>
                                <ChildContent>
                                    @DashboardLocalizer["AddClientPayment"]
                                </ChildContent>
                            </CustomButton>
                        </div>
                    }
                </div>
            }
            else
            {
                <ClientPaymentsTableBlock Items="@FilteredPayments"></ClientPaymentsTableBlock>
            }
            <div class="mt-4">
                <TPaginator
                    CurrentPage="@_state.Value.SelectedPage"
                    CurrentPageChanged="OnPageChanged"
                    TotalPages="@_state.Value.TotalPages"
                    TotalItems="@_state.Value.TotalCount"
                    IsLoading="@_state.Value.IsListLoading"/>
            </div>
        </LumexCardBody>
    </LumexCard>
</div>
