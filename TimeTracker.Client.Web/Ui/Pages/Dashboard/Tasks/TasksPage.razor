@page "/board/{WorkspaceId:guid}/tasks/{TaskListId:guid}"
@page "/board/{WorkspaceId:guid}/tasks"
@page "/board/tasks/{TaskListId:guid}"
@page "/board/tasks"
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.LayoutParts
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Tasks.Components

@inherits BaseComponent
@layout Layout

<CascadingValue
    Name="TaskListId"
    Value="@TaskListId">
    <LumexCard
        Class="border-slate-200 bg-white shadow-sm"
        Style="overflow: visible;">
        <LumexCardBody Class="p-0">
            <ResizableSplitBlock
                Class="min-h-[720px]"
                IsContentOverflowVisible="true"
                DefaultStartPaneWidth="@DefaultTaskListsWidth"
                MinStartPaneWidth="@MinTaskListsWidth"
                MaxStartPaneWidth="@MaxTaskListsWidth"
                HandleLabel="@DashboardLocalizer["Tasks_ResizeTaskListsPanel"].Value">
                <StartContent>
                    <TasksListBlock
                        IsEmbedded="true"
                        OnContextChanged="OnTaskListsContextChanged" />
                </StartContent>
                <EndContent>
                    <TasksBlock
                        IsEmbedded="true"
                        ContextClient="_selectedClient"
                        ContextProject="_selectedProject" />
                </EndContent>
            </ResizableSplitBlock>
        </LumexCardBody>
    </LumexCard>
</CascadingValue>
