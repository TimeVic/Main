@using TimeTracker.Api.Shared.Dto.Entity.Task
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;

@inherits BaseReactiveComponent

<div class="flex w-full flex-col gap-3">
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
        <div class="border-b border-slate-200 px-3 py-2.5">
            <p class="text-sm font-semibold text-slate-900">@DashboardLocalizer["TasksBoardBlock_Todo"]</p>
            <p class="mt-0.5 text-sm text-slate-500">@DashboardLocalizer["TasksBoardBlock_TodoDescription"]</p>
        </div>
        <TasksTableBlock 
            Tasks="@_todoTasks"
            IsLoading="@TasksState.Value.IsListLoading" 
            EmptyMessage="@DashboardLocalizer["TasksBoardBlock_NoTodoTasks"].Value" />
    </div>

    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
        <div class="border-b border-slate-200 px-3 py-2.5">
            <p class="text-sm font-semibold text-slate-900">@DashboardLocalizer["TasksBoardBlock_Backlog"]</p>
            <p class="mt-0.5 text-sm text-slate-500">@DashboardLocalizer["TasksBoardBlock_BacklogDescription"]</p>
        </div>
        <TasksTableBlock 
            Tasks="@_backlogTasks"
            IsLoading="@TasksState.Value.IsListLoading" 
            EmptyMessage="@DashboardLocalizer["TasksBoardBlock_NoBacklogTasks"].Value" />
    </div>
</div>
