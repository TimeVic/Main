@using TimeTracker.Api.Shared.Dto.Entity.Task
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;

@inherits BaseReactiveComponent

<div class="flex w-full flex-col gap-3">
    <TasksTableBlock
        Title="@DashboardLocalizer["TasksBoardBlock_Todo"].Value"
        Status="TaskStatus.ToDo"
        Tasks="@_todoTasks"
        Version="@_todoTasksVersion"
        IsLoading="@TasksState.Value.IsListLoading"
        EmptyMessage="@DashboardLocalizer["TasksBoardBlock_NoTodoTasks"].Value" />
    <TasksTableBlock
        Title="@DashboardLocalizer["TasksBoardBlock_Backlog"].Value"
        Status="TaskStatus.Backlog"
        Tasks="@_backlogTasks"
        Version="@_backlogTasksVersion"
        IsLoading="@TasksState.Value.IsListLoading"
        EmptyMessage="@DashboardLocalizer["TasksBoardBlock_NoBacklogTasks"].Value" />
    <TasksTableBlock
        Title="@DashboardLocalizer["TasksBoardBlock_Done"].Value"
        Status="TaskStatus.Done"
        Tasks="@_doneTasks"
        Version="@_doneTasksVersion"
        IsLoading="@TasksState.Value.IsListLoading"
        EmptyMessage="@DashboardLocalizer["TasksBoardBlock_NoDoneTasks"].Value" />
</div>
