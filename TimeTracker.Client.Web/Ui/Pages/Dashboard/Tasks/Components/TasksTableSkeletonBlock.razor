@for (var i = 0; i < 6; i++)
{
    <tr>
        <td class="border-t border-slate-200 px-3 py-2.5 align-top">
            <LumexSkeleton Class="h-6 w-6 rounded"/>
        </td>
        <td class="border-t border-slate-200 px-2 py-2.5 align-top">
            <div class="space-y-1.5">
                <LumexSkeleton Class="h-4 w-72 rounded"/>
                <LumexSkeleton Class="h-3 w-52 rounded"/>
            </div>
        </td>
        <td class="hidden border-t border-slate-200 px-2 py-2.5 align-top lg:table-cell">
            <LumexSkeleton Class="h-6 w-20 rounded-full"/>
        </td>
        <td class="hidden border-t border-slate-200 px-2 py-2.5 align-top lg:table-cell">
            <LumexSkeleton Class="h-6 w-16 rounded-full"/>
        </td>
        <td class="hidden border-t border-slate-200 px-2 py-2.5 align-top lg:table-cell">
            <div class="flex items-center gap-3">
                <LumexSkeleton Class="h-7 w-7 rounded-full shrink-0"/>
                <div class="space-y-1.5">
                    <LumexSkeleton Class="h-3.5 w-20 rounded"/>
                </div>
            </div>
        </td>
        <td class="border-t border-slate-200 px-2 py-2.5 align-top text-right">
            <div class="flex items-center justify-end gap-1">
                <LumexSkeleton Class="h-7 w-7 rounded-lg"/>
                <LumexSkeleton Class="h-7 w-7 rounded-lg"/>
            </div>
        </td>
    </tr>
}
