@using LumexUI
@using LumexUI.Common
@using TimeTracker.Business.Extensions
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Tasks
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Tasks.Modals
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;
@using TaskPriority = TimeTracker.Business.Common.Constants.Task.TaskPriority;

@inherits BaseReactiveComponent

<section class="space-y-4">
    
    @if (_taskList != null)
    {
        <AddTaskModal
            @bind-IsOpened="_isShowAddTaskModal"
            TaskList="@_taskList"></AddTaskModal>
    }
    
    <div class="flex flex-col gap-3 px-1 sm:flex-row sm:items-center sm:justify-between">
        <div class="min-w-0">
            <p class="break-words text-sm font-semibold text-slate-900">@_taskList?.Name</p>
            <p class="mt-0.5 text-sm text-slate-500">@DashboardLocalizer["TasksBlock_TaskListDescription"]</p>
        </div>
        <div class="flex shrink-0 flex-wrap items-center gap-2">
            @if (_taskList != null)
            {
                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">@_taskList.Project.Name</span>
            }

            <CustomButton
                Variant="Variant.Outlined"
                Color="ThemeColor.Info"
                Disabled="@(_taskList == null)"
                OnClick="@(() => _isShowAddTaskModal = true)">
                <StartContent>
                    <i class="fa-solid fa-plus"></i>
                </StartContent>
                <ChildContent>@DashboardLocalizer["AddTask"]</ChildContent>
            </CustomButton>
        </div>
    </div>

    <TasksBoardBlock></TasksBoardBlock>
</section>
