@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity.Task
@using TimeTracker.Business.Extensions
@using TimeTracker.Client.Core.Constants.Ui
@using TimeTracker.Client.Core.Core.Extensions.Enums
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Tasks.Parts
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;
@using TaskPriority = TimeTracker.Business.Common.Constants.Task.TaskPriority;

@inherits BaseReactiveComponent

<section class="tasks-table-block tasks-table-block--@GetStatusCssClass() @(!IsExpanded ? "tasks-table-block--collapsed" : null) rounded-lg border border-slate-200/80 bg-white">
    <button
        type="button"
        aria-expanded="@IsExpanded.ToString().ToLowerInvariant()"
        class="tasks-table-block__header flex min-h-13 w-full items-center justify-between px-4 py-2 text-left"
        @onclick="ToggleExpanded">
        <span class="flex items-center gap-2">
            <span
                aria-hidden="true"
                class="tasks-table-block__icon flex h-7 w-7 shrink-0 items-center justify-center rounded-md">
                <i class="@GetStatusIconClass() text-xs"></i>
            </span>
            <span class="text-sm font-semibold text-slate-900">@Title</span>
            <span class="tasks-table-block__count rounded-full px-2 py-0.5 text-[11px] font-semibold">@Tasks.Count</span>
        </span>
        <i
            aria-hidden="true"
            class="fa-solid @(IsExpanded ? "fa-chevron-down" : "fa-chevron-right") text-xs text-slate-400"></i>
    </button>

    <div class="@TableContentClass">
        @if (_taskToUpdate != null)
        {
            <TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Tasks.Modals.UpdateTaskModal
                IsOpened="true"
                Task="_taskToUpdate"
                OnClose="@(() => _taskToUpdate = null)"
            />
        }

        @if (Tasks.Any())
        {
            <div class="flex items-center justify-between border-b border-slate-200 px-3 py-2">
                <div class="flex items-center gap-2">
                    <LumexCheckbox
                        OnClick="@SelectAllTasks"
                        Value="@(_selectedTaskIds.Any() && _selectedTaskIds.Count == Tasks.Count)"
                        ValueChanged="@(SelectAllTasks)"/>
                    <span class="text-sm text-slate-600">@string.Format(DashboardLocalizer["TasksTableBlock_SelectedCount"].Value, _selectedTaskIds.Count)</span>
                </div>
                @if (_selectedTaskIds.Count > 0)
                {
                    <div class="flex items-center gap-2">
                        <CustomButton
                            Color="ThemeColor.Warning"
                            Variant="Variant.Light"
                            Size="Size.Small"
                            OnClick="@(() => OnSetArchivedSelectedTasks(true))">
                            <StartContent>
                                <i class="fa-solid fa-box-archive text-xs"></i>
                            </StartContent>
                            <ChildContent>@DashboardLocalizer["Archive"]</ChildContent>
                        </CustomButton>
                        <CustomButton
                            Color="ThemeColor.Success"
                            Variant="Variant.Light"
                            Size="Size.Small"
                            OnClick="@(() => OnSetArchivedSelectedTasks(false))">
                            <StartContent>
                                <i class="fa-solid fa-rotate-left text-xs"></i>
                            </StartContent>
                            <ChildContent>@DashboardLocalizer["Restore"]</ChildContent>
                        </CustomButton>
                    </div>
                }
            </div>
        }

        @* Avoid a nested scroll container: overflow-x-auto also computes overflow-y as auto and breaks Virtualize's scroll root. *@
        <div class="w-full">
            <table class="w-full table-fixed border-separate border-spacing-0">
        <colgroup>
            <col class="w-11" />
            <col />
            <col class="hidden lg:table-column lg:w-28" />
            <col class="hidden lg:table-column lg:w-24" />
            <col class="hidden lg:table-column lg:w-36" />
            <col class="w-20" />
        </colgroup>
        <thead class="bg-slate-50/80 sticky top-0 z-10">
            <tr class="text-left text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">
                <th class="w-11 px-3 py-2"></th>
                <th class="px-2 py-2">@DashboardLocalizer["Task"]</th>
                <th class="hidden px-2 py-2 text-left lg:table-cell">@DashboardLocalizer["Status"]</th>
                <th class="hidden px-2 py-2 text-left lg:table-cell">@DashboardLocalizer["Priority"]</th>
                <th class="hidden px-2 py-2 lg:table-cell">@DashboardLocalizer["Assignee"]</th>
                <th class="px-2 py-2 text-right">@DashboardLocalizer["Actions"]</th>
            </tr>
        </thead>
        <tbody class="text-sm">
            @if (IsLoading)
            {
                <TasksTableSkeletonBlock/>
            }
            else if (Tasks.Any())
            {
                <Virtualize
                    @ref="_virtualize"
                    Items="Tasks"
                    ItemSize="72"
                    SpacerElement="tr"
                    OverscanCount="5"
                    Context="task">
                    @if (IsDropTarget(task))
                    {
                        <tr class="pointer-events-none">
                            <td colspan="6" class="p-0">
                                <div class="h-0.5 bg-blue-500 rounded-full mx-2 shadow-sm shadow-blue-300"></div>
                            </td>
                        </tr>
                    }
                    <tr @key="task.Id"
                        class="@GetTaskBoardRowClass(task.Id) @GetDragRowClass(task) transition-colors"
                        draggable="true"
                        @ondragstart="@(() => OnDragStart(task))"
                        @ondragover:preventDefault="true"
                        @ondragover="@(() => OnDragOver(task))"
                        @ondrop="@(() => OnDrop(task))"
                        @ondragend="@OnDragEnd">
                        <td class="border-t border-slate-200 px-3 py-2 align-top">
                            <div class="flex flex-col items-center">
                                <LumexCheckbox
                                    Value="IsTaskBoardSelected(task.Id)"
                                    ValueChanged="@(() => ToggleTaskBoardSelection(task.Id))"/>
                            </div>
                        </td>
                        <td class="cursor-pointer border-t border-slate-200 px-2 py-2 align-top @GetSelectedTaskClass(task.Id)" @onclick="@(() => OpenTaskEditor(task))">
                            <div class="flex">
                                <div class="min-w-0 flex-1 space-y-1.5">
                                    <div class="flex min-w-0 items-start gap-2">
                                        <span class="mt-0.5 shrink-0 rounded-md bg-slate-100 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-slate-600">
                                            @task.FormattedId
                                        </span>
                                        <a
                                            href="@GetTaskUrl(task)"
                                            title="@task.Title"
                                            @onclick:preventDefault="true"
                                            class="min-w-0 flex-1 break-words text-left text-sm font-semibold leading-5 text-slate-900 transition group-hover:text-blue-700 hover:text-blue-700 @GetTaskTitleClass(task)">
                                            @GetTaskListTitle(task.Title)
                                        </a>
                                    </div>
                                    <TaskEstimateSummaryBlock
                                        Class="max-w-[42rem]"
                                        IsCompact="true"
                                        PlannedDuration="task.OriginalEstimate"
                                        TrackedDuration="task.TrackedDuration" />
                                    <div class="flex flex-wrap items-center gap-1.5 lg:hidden" @onclick:stopPropagation="true">
                                        <EnumDropDown
                                            TItem="TaskStatus"
                                            Class="shrink-0"
                                            DropDownColor="@task.Status.GetThemeColor()"
                                            DropDownVariant="Variant.Light"
                                            SelectType="DropDownType.DropDown"
                                            Size="Size.Small"
                                            Value="@task.Status"
                                            ValueChanged="(value) => OnChangeStatusTask(task, value)"/>
                                        <EnumDropDown
                                            TItem="TaskPriority"
                                            Class="shrink-0"
                                            DropDownColor="@task.Priority.GetThemeColor()"
                                            DropDownVariant="Variant.Light"
                                            SelectType="DropDownType.DropDown"
                                            Size="Size.Small"
                                            Value="@task.Priority"
                                            ValueChanged="(value) => OnChangePriorityTask(task, value)"/>
                                        <UserAvatarBlock
                                            User="@task.User"
                                            SizeClass="h-6 w-6"
                                            Class="text-[10px]" />
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="hidden border-t border-slate-200 px-2 py-2 align-top lg:table-cell">
                            <EnumDropDown
                                TItem="TaskStatus"
                                Class="whitespace-nowrap"
                                DropDownColor="@task.Status.GetThemeColor()"
                                DropDownVariant="Variant.Light"
                                SelectType="DropDownType.DropDown"
                                Size="Size.Small"
                                Value="@task.Status"
                                ValueChanged="(value) => OnChangeStatusTask(task, value)"/>
                        </td>
                        <td class="hidden border-t border-slate-200 px-2 py-2 align-top lg:table-cell">
                            <EnumDropDown
                                TItem="TaskPriority"
                                Class="whitespace-nowrap"
                                DropDownColor="@task.Priority.GetThemeColor()"
                                DropDownVariant="Variant.Light"
                                SelectType="DropDownType.DropDown"
                                Size="Size.Small"
                                Value="@task.Priority"
                                ValueChanged="(value) => OnChangePriorityTask(task, value)"/>
                        </td>
                        <td class="hidden border-t border-slate-200 px-2 py-2 align-top lg:table-cell">
                            <div class="flex items-center gap-2" title="@task.User?.Email">
                                <UserAvatarBlock
                                    User="@task.User"
                                    SizeClass="h-7 w-7"
                                    Class="text-[10px]" />
                                <div class="min-w-0">
                                    <div class="truncate text-xs font-medium text-slate-800">@(task.User?.Name ?? "")</div>
                                </div>
                            </div>
                        </td>
                        <td class="border-t border-slate-200 px-2 py-2 align-top text-right">
                            <div class="flex items-center justify-end gap-1">
                                <TaskTimeTrackerButton Task="@task" />
                                <LumexDropdown>
                                    <LumexDropdownTrigger>
                                        <LumexButton
                                            IconOnly="true"
                                            Size="Size.Small"
                                            Variant="@Variant.Outlined">
                                            <i class="fa-solid fa-ellipsis-h"></i>
                                        </LumexButton>
                                    </LumexDropdownTrigger>
                                    <LumexDropdownMenu>
                                        <LumexDropdownItem
                                            Color="@ThemeColor.Warning"
                                            OnClick="@(() => OnArchiveTask(task))">
                                            @DashboardLocalizer["TasksTableBlock_ArchiveThisTask"]
                                        </LumexDropdownItem>
                                    </LumexDropdownMenu>
                                </LumexDropdown>
                            </div>
                        </td>
                    </tr>
                </Virtualize>
            }
            else
            {
                <tr>
                    <td colspan="6" class="px-3 py-3 text-sm text-slate-500">@(string.IsNullOrWhiteSpace(EmptyMessage) ? DashboardLocalizer["TasksTableBlock_NoTasksFound"] : EmptyMessage)</td>
                </tr>
            }
        </tbody>
            </table>
        </div>
    </div>
</section>
