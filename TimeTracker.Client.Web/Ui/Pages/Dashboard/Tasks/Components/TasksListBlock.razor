@using TimeTracker.Client.Core.Ui.Shared.Components.Dropdown
@using TimeTracker.Client.Core.Ui.Shared.Components.Enums
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Tasks.Modals
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Tasks.Parts.TasksList
@using TimeTracker.Client.Web.Ui.Shared.Components.Dialogs
@inherits BaseReactiveComponent

<aside class="@ContainerClass">
    <div class="flex min-h-0 flex-1 flex-col">
        <div class="border-b border-slate-200 p-4">
            <div class="min-w-0">
                <p class="text-sm font-semibold text-slate-900">@DashboardLocalizer["TasksListBlock_Title"]</p>
                <p class="text-xs text-slate-500">@DashboardLocalizer["TasksListBlock_Description"]</p>
            </div>
        </div>

        <div class="border-b border-slate-200 px-4 py-3">
            <InputTextField
                @bind-Value="_taskListSearch"
                Placeholder="@DashboardLocalizer["TasksListBlock_SearchPlaceholder"].Value"
                FullWidth="true"
                Size="ComponentSize.Small"
                Clearable="true">
                <StartContent>
                    <i class="fa-solid fa-magnifying-glass text-xs text-slate-400"></i>
                </StartContent>
            </InputTextField>
        </div>

        <div class="min-h-0 flex-1 space-y-2 overflow-y-auto p-2">
            @if (IsSearching)
            {
                @foreach (var taskList in _searchResults)
                {
                    <button
                        type="button"
                        class="@GetTaskListClass(taskList)"
                        @onclick="@(() => OnTasksListSelected(taskList))">
                        <span class="min-w-0 flex-1">
                            <span class="block truncate text-sm font-medium leading-5 text-slate-800">@taskList.Name</span>
                            <span class="mt-0.5 block truncate text-xs text-slate-500">@GetTaskListContext(taskList)</span>
                        </span>
                        <span class="ml-2 shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-500">
                            @GetTasksCountText(taskList)
                        </span>
                    </button>
                }

                @if (!_searchResults.Any())
                {
                    <p class="px-3 py-2 text-sm text-slate-600">@string.Format(DashboardLocalizer["TasksListBlock_NoMatches"].Value, _taskListSearch)</p>
                }
            }
            else
            {
                @foreach (var client in _clients)
                {
                    var isClientExpanded = IsClientExpanded(client);
                    <div @key="client.Id">
                        <button
                            type="button"
                            class="@GetClientClass(client)"
                            @onclick="@(() => OnClientSelected(client))">
                            <i class="fa-solid @(isClientExpanded ? "fa-chevron-down" : "fa-chevron-right") w-3 text-[10px] text-slate-400"></i>
                            <span class="min-w-0 truncate text-[11px] font-semibold uppercase tracking-wide">@client.Name</span>
                        </button>

                        @if (isClientExpanded)
                        {
                            var projects = GetClientProjects(client).ToList();
                            if (!projects.Any())
                            {
                                <div class="ml-5 px-3 py-2">
                                    <p class="text-xs text-slate-500">@DashboardLocalizer["TasksListBlock_ClientHasNoProjects"]</p>
                                    @if (IsCanCreateProject)
                                    {
                                        <button
                                            type="button"
                                            class="mt-1 text-xs font-medium text-blue-600 hover:text-blue-700"
                                            @onclick="@(() => OpenAddProjectModal(client))">
                                            <i class="fa-solid fa-plus mr-1 text-[10px]"></i>@DashboardLocalizer["AddProject"]
                                        </button>
                                    }
                                </div>
                            }

                            @foreach (var project in projects)
                            {
                                var isProjectExpanded = IsProjectExpanded(project);
                                <div class="ml-3 border-t border-slate-100 pt-1 first:border-t-0" @key="project.Id">
                                    <div class="group flex items-center gap-1">
                                        <button
                                            type="button"
                                            class="@GetProjectClass(project)"
                                            title="@project.Name"
                                            @onclick="@(() => OnProjectSelected(project))">
                                            <i class="fa-solid @(isProjectExpanded ? "fa-chevron-down" : "fa-chevron-right") w-3 text-[10px] text-slate-400"></i>
                                            <span class="min-w-0 flex-1 truncate text-sm font-medium">@project.Name</span>
                                            <span class="shrink-0 text-[10px] font-medium text-slate-400">@GetProjectTaskListsCountText(project)</span>
                                        </button>
                                        <AppDropdown Alignment="DropdownAlignment.Right">
                                            <Trigger>
                                                <AppButton
                                                    IconOnly="true"
                                                    Size="ComponentSize.Small"
                                                    Variant="ButtonVariant.Light"
                                                    Class="text-slate-500">
                                                    <i class="fa-solid fa-ellipsis-h text-xs"></i>
                                                </AppButton>
                                            </Trigger>
                                            <Menu>
                                                <AppDropdownItem OnClick="@(() => OpenAddTaskListModal(project))">
                                                    <span class="flex items-center gap-2">
                                                        <i class="fa-solid fa-plus w-4 text-xs"></i>
                                                        @DashboardLocalizer["AddTasksListModalForm_Title"]
                                                    </span>
                                                </AppDropdownItem>
                                            </Menu>
                                        </AppDropdown>
                                    </div>

                                    @if (isProjectExpanded)
                                    {
                                        var taskLists = GetProjectTaskLists(project).ToList();
                                        if (taskLists.Any())
                                        {
                                            <div class="ml-5 space-y-1 pb-1">
                                                @foreach (var taskList in taskLists)
                                                {
                                                    <div class="group flex items-center gap-1">
                                                        <button
                                                            type="button"
                                                            class="@GetTaskListClass(taskList)"
                                                            title="@taskList.Name"
                                                            @onclick="@(() => OnTasksListSelected(taskList))">
                                                            <span class="min-w-0 flex-1 truncate text-sm font-medium leading-5 text-slate-800">@taskList.Name</span>
                                                            <span class="ml-2 shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-500">
                                                                @GetTasksCountText(taskList)
                                                            </span>
                                                        </button>
                                                        <AppDropdown Alignment="DropdownAlignment.Right">
                                                            <Trigger>
                                                                <AppButton
                                                                    IconOnly="true"
                                                                    Size="ComponentSize.Small"
                                                                    Variant="ButtonVariant.Light"
                                                                    Class="text-slate-500">
                                                                    <i class="fa-solid fa-ellipsis-h text-xs"></i>
                                                                </AppButton>
                                                            </Trigger>
                                                            <Menu>
                                                                <AppDropdownItem OnClick="@(() => OpenEditTaskList(taskList))">
                                                                    <span class="flex items-center gap-2">
                                                                        <i class="fa-solid fa-pen w-4 text-xs"></i>
                                                                        @DashboardLocalizer["TasksBlock_EditTaskList"]
                                                                    </span>
                                                                </AppDropdownItem>
                                                                <AppDropdownItem
                                                                    Color="@ComponentColor.Danger"
                                                                    OnClick="@(() => OpenDeleteTaskListConfirmation(taskList))">
                                                                    <span class="flex items-center gap-2">
                                                                        <i class="fa-solid fa-trash w-4 text-xs"></i>
                                                                        @DashboardLocalizer["TasksBlock_DeleteTaskListTitle"]
                                                                    </span>
                                                                </AppDropdownItem>
                                                            </Menu>
                                                        </AppDropdown>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="ml-5 px-3 py-2">
                                                <p class="text-xs text-slate-500">@DashboardLocalizer["TasksListBlock_ListIsEmpty"]</p>
                                                <button
                                                    type="button"
                                                    class="mt-1 text-xs font-medium text-blue-600 hover:text-blue-700"
                                                    @onclick="@(() => OpenAddTaskListModal(project))">
                                                    <i class="fa-solid fa-plus mr-1 text-[10px]"></i>@DashboardLocalizer["AddTasksListModalForm_Title"]
                                                </button>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        }
                    </div>
                }

                @if (!_clients.Any() && !_projectState.Value.IsListLoading && !_clientState.Value.IsListLoading)
                {
                    <div class="px-3 py-2">
                        <p class="text-sm text-slate-600">@DashboardLocalizer["TasksListBlock_NoClients"]</p>
                        @if (IsCanCreateClient)
                        {
                            <button
                                type="button"
                                class="mt-1 text-xs font-medium text-blue-600 hover:text-blue-700"
                                @onclick="OpenAddClientModal">
                                <i class="fa-solid fa-plus mr-1 text-[10px]"></i>@DashboardLocalizer["AddClient"]
                            </button>
                        }
                    </div>
                }
            }
        </div>
    </div>
</aside>
