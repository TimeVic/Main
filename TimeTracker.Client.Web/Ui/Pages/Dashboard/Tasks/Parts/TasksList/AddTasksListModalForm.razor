@inherits BaseReactiveComponent

<AppModalHeader
    Title="@DashboardLocalizer["AddTasksListModalForm_Title"]"
    Icon="fa-solid fa-plus" />
<AppModalBody Class="pt-3">
    <EditForm
        Context="form"
        @ref="_form"
        Model="@model"
        OnValidSubmit="@Submit"
        novalidate>
        <DataAnnotationsValidator/>
        <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">@DashboardLocalizer["Create"]</button>

        <div class="space-y-6">
            <div class="rounded-2xl border border-blue-100 bg-blue-50/70 px-4 py-3">
                <p class="text-xs font-medium uppercase tracking-[0.18em] text-blue-600">@DashboardLocalizer["Project"]</p>
                <p class="mt-1 text-sm font-semibold text-slate-900">@Project?.Name</p>
            </div>

            <div class="pt-1">
                <InputTextField
                    FullWidth="true"
                    Label="@DashboardLocalizer["Name"].Value"
                    @bind-Value="model.Name"
                    Placeholder="@DashboardLocalizer["AddTasksListModalForm_NamePlaceholder"].Value"/>
            </div>
        </div>
    </EditForm>
</AppModalBody>
<AppModalFooter>
    <AppButton
        Color="@ComponentColor.Default"
        Variant="@ButtonVariant.Outlined"
        Radius="@ButtonRadius.Medium"
        OnClick="@(() => ModalInstance?.Close(AppModalResult.Cancel()))">
        @DashboardLocalizer["Cancel"]
    </AppButton>
    <AppButton
        OnClick="@Submit"
        Color="@ComponentColor.Primary"
        Radius="@ButtonRadius.Medium">
        @DashboardLocalizer["Add"]
    </AppButton>
</AppModalFooter>
