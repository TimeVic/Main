@using LumexUI.Common
@using TimeTracker.Client.Web.Ui.Shared.Components.Dialogs

@inherits BaseReactiveComponent

@if (_isShowDeletionModal)
{
    <ConfirmationModal
        Title="@DashboardLocalizer["UserSettings_RequestDeletionConfirmTitle"].Value"
        Message="@DashboardLocalizer["UserSettings_RequestDeletionConfirmMessage"].Value"
        ConfirmText="@DashboardLocalizer["UserSettings_RequestDeletion"].Value"
        OnCancel="@(() => _isShowDeletionModal = false)"
        OnClose="@(() => _isShowDeletionModal = false)"
        OnConfirm="@OnRequestDeletionConfirmed" />
}

<div class="rounded-2xl border border-red-200 bg-red-50/30 p-6">
    <div class="mb-5">
        <h2 class="text-lg font-semibold text-slate-900">@DashboardLocalizer["UserSettings_AccountDeletionSection"]</h2>
        <p class="mt-1 text-sm text-slate-500">@DashboardLocalizer["UserSettings_AccountDeletionSectionDescription"]</p>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-red-200 bg-white p-4">
        <p class="text-sm text-slate-600">@DashboardLocalizer["UserSettings_RequestDeletionDescription"]</p>
        @* TODO: Wire to account deletion request API *@
        <CustomButton
            Color="ThemeColor.Danger"
            Variant="Variant.Outlined"
            OnClick="@(() => _isShowDeletionModal = true)">
            <StartContent>
                <i class="fa-regular fa-trash-can"></i>
            </StartContent>
            <ChildContent>@DashboardLocalizer["UserSettings_RequestDeletion"]</ChildContent>
        </CustomButton>
    </div>
</div>

