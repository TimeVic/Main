@using LumexUI.Common
@using TimeTracker.Client.Web.Services

@inherits BaseReactiveComponent

<LumexCard>
    <LumexCardHeader>
        <div>
            <h2 class="text-lg font-semibold text-slate-900">@DashboardLocalizer["UserSettings_ProfileSection"]</h2>
            <p class="mt-1 text-sm text-slate-500">@DashboardLocalizer["UserSettings_ProfileSectionDescription"]</p>
        </div>
    </LumexCardHeader>
    <LumexCardBody>
        <div class="max-w-xl space-y-5">
            <div>
                <p class="mb-3 text-sm font-medium text-slate-700">@DashboardLocalizer["UserSettings_Avatar"]</p>
                <div class="flex flex-wrap items-center gap-4">
                    <div class="avatar-preview">
                        <LumexAvatar
                            @key="_avatarRenderKey"
                            Name="@(AuthState.Value.User?.Initials ?? string.Empty)"
                            Src="@_avatarSrc"
                            Size="Size.Large" />
                        @if (_isUploadingAvatar || _isDeletingAvatar)
                        {
                            <div class="avatar-preview__loader" aria-hidden="true">
                                <svg
                                    class="h-5 w-5 animate-spin"
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24">
                                    <circle
                                        class="opacity-25"
                                        cx="12"
                                        cy="12"
                                        r="10"
                                        stroke="currentColor"
                                        stroke-width="4"></circle>
                                    <path
                                        class="opacity-75"
                                        fill="currentColor"
                                        d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                                    </svg>
                            </div>
                        }
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        <InputFile
                            id="avatar-file-input"
                            class="hidden"
                            accept="image/png,image/jpeg,image/gif,image/webp"
                            OnChange="@OnAvatarFileSelected" />
                        <AppButton
                            Color="ComponentColor.Default"
                            Variant="ButtonVariant.Outlined"
                            IsLoading="@_isUploadingAvatar"
                            Disabled="@_isDeletingAvatar"
                            OnClick="@OnClickChangeAvatar">
                            <StartContent>
                                <i class="fa-solid fa-arrow-up-from-bracket"></i>
                            </StartContent>
                            <ChildContent>@DashboardLocalizer["UserSettings_ChangeAvatar"]</ChildContent>
                        </AppButton>
                        @if (AuthState.Value.User?.Avatar != null)
                        {
                            <AppButton
                                Color="ComponentColor.Danger"
                                Variant="ButtonVariant.Light"
                                IsLoading="@_isDeletingAvatar"
                                Disabled="@_isUploadingAvatar"
                                OnClick="@OnClickRemoveAvatar">
                                @DashboardLocalizer["UserSettings_RemoveAvatar"]
                            </AppButton>
                        }
                    </div>
                </div>
                <p class="mt-2 text-xs text-slate-400">@DashboardLocalizer["UserSettings_AvatarHelper"]</p>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <InputTextField
                        @bind-Value="_name"
                        Label="@DashboardLocalizer["UserSettings_Name"].Value"
                        Placeholder="@DashboardLocalizer["UserSettings_Name"].Value"
                        FullWidth="true" />
                    <p class="mt-1.5 text-xs text-slate-400">@DashboardLocalizer["UserSettings_NameHelper"]</p>
                </div>
                <div>
                    <InputTextField
                        @bind-Value="_email"
                        Label="@DashboardLocalizer["UserSettings_Email"].Value"
                        FullWidth="true"
                        Disabled="true" />
                    <p class="mt-1.5 text-xs text-slate-400">@DashboardLocalizer["UserSettings_EmailHelper"]</p>
                </div>
            </div>
        </div>

        <hr class="my-6 border-slate-100" />

        <div>
            <p class="mb-3 text-sm font-semibold text-slate-700">@DashboardLocalizer["UserSettings_InterfaceLanguageSection"]</p>
            <p class="mb-4 text-sm text-slate-500">@DashboardLocalizer["UserSettings_InterfaceLanguageSectionDescription"]</p>
            <div class="max-w-xs">
                <LanguagesSelect
                    Label="@DashboardLocalizer["Language"].Value"
                    @bind-Value="_selectedLanguage" />
            </div>
        </div>

        <div class="mt-6 flex justify-end border-t border-slate-100 pt-5">
            <AppButton
                Color="ComponentColor.Primary"
                Variant="ButtonVariant.Solid"
                IsLoading="@_isSaving"
                OnClick="@OnSave">
                <StartContent>
                    <i class="fa-regular fa-floppy-disk"></i>
                </StartContent>
                <ChildContent>@DashboardLocalizer["UserSettings_SaveChanges"]</ChildContent>
            </AppButton>
        </div>
    </LumexCardBody>
</LumexCard>
