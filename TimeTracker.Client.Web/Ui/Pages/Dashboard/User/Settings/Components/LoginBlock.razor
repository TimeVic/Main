@using LumexUI.Common

@inherits BaseReactiveComponent

<AppCard>
    <AppCardHeader>
        <div>
            <h2 class="text-lg font-semibold text-slate-900">@DashboardLocalizer["UserSettings_LoginSection"]</h2>
            <p class="mt-1 text-sm text-slate-500">@DashboardLocalizer["UserSettings_LoginSectionDescription"]</p>
        </div>
    </AppCardHeader>
    <AppCardBody>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">
                @_errorMessage
            </div>
        }
        <div class="max-w-xl space-y-4">
            <div>
                <InputTextField
                    @bind-Value="_login"
                    Label="@DashboardLocalizer["UserSettings_Login"].Value"
                    Placeholder="@DashboardLocalizer["UserSettings_Login"].Value"
                    FullWidth="true" />
                <p class="mt-1.5 text-xs text-slate-400">@DashboardLocalizer["UserSettings_LoginHelper"]</p>
            </div>
        </div>

        <div class="mt-6 flex justify-end border-t border-slate-100 pt-5">
            <AppButton
                Color="ComponentColor.Primary"
                Variant="ButtonVariant.Solid"
                IsLoading="@_isSaving"
                OnClick="@OnChangeLogin">
                <StartContent>
                    <i class="fa-regular fa-floppy-disk"></i>
                </StartContent>
                <ChildContent>@DashboardLocalizer["UserSettings_SaveLogin"]</ChildContent>
            </AppButton>
        </div>
    </AppCardBody>
</AppCard>
