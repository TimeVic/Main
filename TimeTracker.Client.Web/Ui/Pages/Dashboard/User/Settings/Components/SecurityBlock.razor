@inherits BaseReactiveComponent

<AppCard>
    <AppCardHeader>
        <div>
            <h2
                class="text-lg font-semibold text-slate-900">
                @DashboardLocalizer["UserSettings_SecuritySection"]
            </h2>
            <p
                class="mt-1 text-sm text-slate-500">
                @DashboardLocalizer["UserSettings_SecuritySectionDescription"]
            </p>
        </div>
    </AppCardHeader>
    <AppCardBody>
        <div
            class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-200 bg-slate-50/60 p-4">
            <div>
                <p
                    class="text-sm font-semibold text-slate-900">
                    @DashboardLocalizer["UserSettings_PasswordTitle"]
                </p>
                <p
                    class="mt-0.5 text-sm text-slate-500">
                    @DashboardLocalizer["UserSettings_ChangePasswordDescription"]
                </p>
            </div>
            <AppButton
                Color="ComponentColor.Default"
                Variant="ButtonVariant.Outlined"
                OnClick="@OpenChangePasswordModal">
                <StartContent>
                    <i
                        class="fa-solid fa-lock"></i>
                </StartContent>
                <ChildContent>@DashboardLocalizer["UserSettings_ChangePassword"]</ChildContent>
            </AppButton>
        </div>
    </AppCardBody>
</AppCard>
