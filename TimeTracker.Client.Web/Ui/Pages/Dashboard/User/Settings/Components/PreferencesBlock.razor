@using LumexUI.Common
@using TimeTracker.Client.Web.Services

@inherits BaseReactiveComponent

<LumexCard>
    <LumexCardHeader>
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.25em] text-blue-700">@DashboardLocalizer["UserSettings_PreferencesSection"]</p>
            <h2 class="mt-2 text-lg font-semibold text-slate-900">@DashboardLocalizer["UserSettings_PreferencesSection"]</h2>
            <p class="mt-1 text-sm text-slate-600">@DashboardLocalizer["UserSettings_PreferencesSectionDescription"]</p>
        </div>
    </LumexCardHeader>
    <LumexCardBody>
        <div class="max-w-xs">
            <LumexSelect
                TValue="string"
                Label="@DashboardLocalizer["Language"].Value"
                @bind-Value="_selectedLanguage">
                <LumexSelectItem Value="@ILocalizationUrlService.EnglishCultureName">
                    <span class="inline-flex items-center gap-2">
                        <span aria-hidden="true">🇺🇸</span>
                        <span>@DashboardLocalizer["English"]</span>
                    </span>
                </LumexSelectItem>
                <LumexSelectItem Value="@ILocalizationUrlService.UkrainianCultureName">
                    <span class="inline-flex items-center gap-2">
                        <span aria-hidden="true">🇺🇦</span>
                        <span>@DashboardLocalizer["Ukrainian"]</span>
                    </span>
                </LumexSelectItem>
            </LumexSelect>
        </div>

        <div class="mt-6 flex justify-end">
            <CustomButton
                Color="ThemeColor.Primary"
                Variant="Variant.Solid"
                OnClick="@OnSave">
                <StartContent>
                    <i class="fa-regular fa-floppy-disk"></i>
                </StartContent>
                <ChildContent>@DashboardLocalizer["UserSettings_SaveChanges"]</ChildContent>
            </CustomButton>
        </div>
    </LumexCardBody>
</LumexCard>
