@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Validation

@inherits BaseReactiveComponent

<AppModalHeader
    Title="@DashboardLocalizer["UserSettings_ChangePasswordModalTitle"]"
    Description="@DashboardLocalizer["UserSettings_ChangePasswordModalDescription"]">
    <Icon>
        <div
            class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
            <i
                class="fa-solid fa-lock"></i>
        </div>
    </Icon>
</AppModalHeader>

<AppModalBody
    Class="pt-3">
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div
            class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700"
            role="alert">
            @_errorMessage
        </div>
    }
    <EditForm
        Model="_model"
        Context="passwordFormContext">
        <DataAnnotationsValidator />
        <div
            class="space-y-4">
            <InputTextField
                @bind-Value="_model.CurrentPassword"
                Type="InputType.Password"
                Label="@DashboardLocalizer["UserSettings_CurrentPassword"].Value"
                FullWidth="true" />
            <InputTextField
                @bind-Value="_model.NewPassword"
                Type="InputType.Password"
                Label="@DashboardLocalizer["UserSettings_NewPassword"].Value"
                FullWidth="true" />
            <InputTextField
                @bind-Value="_model.ConfirmPassword"
                Type="InputType.Password"
                Label="@DashboardLocalizer["UserSettings_ConfirmPassword"].Value"
                FullWidth="true" />
            <ValidationMessage
                For="@(() => _model.ConfirmPassword)"
                class="text-sm text-red-600" />
        </div>
    </EditForm>
</AppModalBody>

<AppModalFooter>
    <AppButton
        FullWidth="true"
        Disabled="@_isSaving"
        OnClick="@CloseModal"
        Color="@ComponentColor.Default"
        Variant="ButtonVariant.Outlined"
        Radius="@ButtonRadius.Medium">
        @DashboardLocalizer["Cancel"]
    </AppButton>
    <AppButton
        FullWidth="true"
        IsLoading="@_isSaving"
        OnClick="@OnChangePassword"
        Color="@ComponentColor.Primary"
        Variant="ButtonVariant.Solid"
        Radius="@ButtonRadius.Medium">
        @DashboardLocalizer["UserSettings_SavePassword"]
    </AppButton>
</AppModalFooter>
