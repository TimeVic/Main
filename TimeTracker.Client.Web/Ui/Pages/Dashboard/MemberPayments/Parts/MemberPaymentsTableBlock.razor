@using Microsoft.AspNetCore.Components.QuickGrid
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.MemberPayments.Parts.Modals
@using TimeTracker.Client.Web.Ui.Shared.Components
@using TimeTracker.Client.Web.Ui.Shared.Components.Dialogs

@inherits BaseReactiveComponent

<AppTable
    TGridItem="MemberPaymentDto"
    Items="@_state.Value.List.AsQueryable()"
    IsLoading="@_isLoading">
    <AppTableColumn
        Title="#"
        SortBy="@(GridSort<MemberPaymentDto>.ByAscending(p => p.PaymentTime))">
        <span
            class="text-sm text-slate-700">
            @context.PaymentTime.ToShortDateString()
        </span>
    </AppTableColumn>

    <AppTableColumn
        Title="@DashboardLocalizer["Project"].Value">
        <div
            class="font-medium text-slate-900">
            @context.Project?.Name
        </div>
        @if (context.Client != null)
        {
            <div
                class="mt-1 max-w-xl text-slate-500">
                @context.Client?.Name
            </div>
        }
    </AppTableColumn>

    <AppTableColumn
        Title="@DashboardLocalizer["MemberPayments_PaidOut"].Value"
        SortBy="@(GridSort<MemberPaymentDto>.ByAscending(p => p.Amount))">
        <span
            class="font-semibold text-emerald-700">
            <AmountDisplay
                Amount="@context.Amount" />
        </span>
    </AppTableColumn>

    <AppTableColumn
        Title="@DashboardLocalizer["Member"].Value">
        <div
            class="font-medium text-slate-900">
            @context.Member?.User.Name
        </div>
    </AppTableColumn>

    <AppTableColumn
        Title="@DashboardLocalizer["Description"].Value"
        SortBy="@(GridSort<MemberPaymentDto>.ByAscending(p => p.Description))">
        <span
            class="text-sm text-slate-700">
            @context.Description
        </span>
    </AppTableColumn>

    <AppTableColumn
        Title="@DashboardLocalizer["Actions"].Value"
        Align="Align.End">
        <div
            class="flex items-center justify-end gap-2"
            @onclick:stopPropagation="true">
            @if (CanUpdatePayments)
            {
                <AppButton
                    Variant="ButtonVariant.Outlined"
                    Color="ComponentColor.Primary"
                    OnClick="() => OpenUpdateModal(context)"
                    IconOnly="true"
                    Size="ComponentSize.Small">
                    <StartContent>
                        <i
                            class="fa-regular fa-pen-to-square">
                        </i>
                    </StartContent>
                </AppButton>
                <AppButton
                    Variant="ButtonVariant.Outlined"
                    Color="ComponentColor.Danger"
                    OnClick="() => OpenDeleteConfirmation(context)"
                    IconOnly="true"
                    Size="ComponentSize.Small">
                    <StartContent>
                        <i
                            class="fa-regular fa-trash-can">
                        </i>
                    </StartContent>
                </AppButton>
            }
        </div>
    </AppTableColumn>
</AppTable>
