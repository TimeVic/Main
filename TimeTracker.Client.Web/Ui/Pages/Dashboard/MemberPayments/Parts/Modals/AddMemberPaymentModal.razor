@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons
@using TimeTracker.Client.Core.Constants.Ui
@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Validation

@inherits BaseReactiveComponent

<LumexModal Open="IsOpened" OnClose="@OnCloseModal" @ref="modal">
    <LumexModalContent>
        <LumexModalHeader Class="flex items-center gap-3">
            <div class="size-10 flex items-center justify-center bg-default-100 rounded-full">
                <i class="fa-solid fa-plus text-xl"></i>
            </div>
            @DashboardLocalizer["AddPaymentList"]
        </LumexModalHeader>
        <LumexModalBody>
            <EditForm
                Context="form"
                @ref="_form"
                Model="@model"
                novalidate>
                <DataAnnotationsValidator/>

                <div class="grid gap-4 md:grid-cols-2">
                    <div class="md:col-span-2">
                        <ProjectsDropDown 
                            Label="@DashboardLocalizer["Project"].Value"
                            IsGroupByClient="true"
                            IsShowProjectsWithoutClients="false"
                            Value="model.ProjectId"
                            ValueExpression="() => model.ProjectId"
                            SelectedItemChanged="OnProjectSelected"/>
                        <CustomValidationMessage For="@(() => model.ProjectId)"/>
                    </div>
                    @if (CanCreatePaymentForOtherMembers)
                    {
                        <div class="md:col-span-2">
                            <MembersDropDown
                                Label="@DashboardLocalizer["Member"].Value"
                                Type="DropDownType.Select"
                                Value="model.MemberId"
                                ValueExpression="() => model.MemberId"
                                SelectedItemChanged="OnMemberSelected"/>
                        </div>
                    }
                    <div>
                        <InputDateTimeField
                            Size="Size.Small"
                            Required="true"
                            @bind-Value="@model.PaymentTime"
                            Label="@DashboardLocalizer["PaymentDate"].Value"/>
                        <CustomValidationMessage For="@(() => model.PaymentTime)"/>
                    </div>
                    <div>
                        <InputNumericField
                            TItem="decimal"
                            Size="Size.Small"
                            Required="true"
                            @bind-Value="@model.Amount"
                            Label="@DashboardLocalizer["Received"].Value"/>
                        <CustomValidationMessage For="@(() => model.Amount)" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">@DashboardLocalizer["Description"]</label>
                        <InputTextArea 
                            @bind-Value="model.Description" 
                            class="min-h-[120px] w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 focus:border-blue-500 focus:outline-none" 
                            placeholder="@DashboardLocalizer["OptionalPaymentNote"]"/>
                    </div>
                </div>
                
                <CustomValidationSummary />
            </EditForm>
        </LumexModalBody>
        <LumexModalFooter>
            <CustomButton
                FullWidth="@true"
                OnClick="@Submit"
                Color="@ThemeColor.Primary"
                Radius="@Radius.Full">
                @DashboardLocalizer["Add"]
            </CustomButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
