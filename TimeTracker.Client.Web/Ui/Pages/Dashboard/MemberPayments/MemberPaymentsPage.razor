@page "/board/{WorkspaceId:guid}/member-payments"
@attribute [RequireWorkspacePermission(WorkspacePermission.ReadMemberPayment)]
@attribute [RequireWorkspaceRole(MembershipAccessType.Owner, MembershipAccessType.Manager)]

@using TimeTracker.Client.Core.Constants.Ui
@using TimeTracker.Api.Shared.Constants
@using TimeTracker.Business.Common.Constants
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.MemberPayments.Parts
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.MemberPayments.Parts.Modals
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared
@using TimeTracker.Client.Web.Ui.Shared.Components.List

@inherits BaseReactiveComponent
@layout Layout

<AddMemberPaymentModal 
    IsOpened="_isShowAddMemberPaymentModal" 
    IsOpenedChanged="isOpened => _isShowAddMemberPaymentModal = isOpened"/>

<div class="space-y-6">
    <section class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">@DashboardLocalizer["MemberPayments"]</h1>
            <p class="mt-1 text-sm text-slate-500">
                @DashboardLocalizer["MemberPaymentsDescription"]
            </p>
        </div>
    </section>

    <AppCard>
        <AppCardBody Class="p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@DashboardLocalizer["Payments"]</p>
            <p class="mt-2 text-2xl font-bold text-slate-900">@_state.Value.TotalCount</p>
            <p class="mt-1 text-xs text-slate-500">@DashboardLocalizer["SavedCurrentWorkspace"]</p>
        </AppCardBody>
    </AppCard>
</div>

<AppCard Class="mt-6 overflow-x-auto pb-2">
    <AppCardHeader Class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="text-sm font-semibold text-slate-900">@DashboardLocalizer["Payments"]</p>
            <p class="text-sm text-slate-500">@DashboardLocalizer["MemberPaymentsDescription"]</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
            @if (CanManageOtherMemberPayments)
            {
                <MembersSelect
                    Class="min-w-56"
                    Label="@DashboardLocalizer["Member"].Value"
                    Type="DropDownType.Select"
                    Clearable="true"
                    Value="_memberFilterId"
                    SelectedItemChanged="OnMemberFilterChanged"/>
            }
            @if (CanCreatePayments)
            {
                <AppButton OnClick="@(() => _isShowAddMemberPaymentModal = true)">
                <StartContent>
                    <i class="fa-solid fa-plus"></i>    
                </StartContent>
                <ChildContent>
                    @DashboardLocalizer["AddPayment"]
                </ChildContent>
                </AppButton>
            }
        </div>
    </AppCardHeader>
    <AppCardBody>
        @if (_state.Value.TotalCount == 0)
        {
            <div class="px-4 py-8 text-center text-sm text-slate-500">
                @DashboardLocalizer["NoPaymentsAddedHelper"]
            </div>
        }
        else
        {
            <MemberPaymentsTableBlock></MemberPaymentsTableBlock>
        }
        <div class="mt-4">
            <TPaginator
                CurrentPage="@_state.Value.SelectedPage"
                CurrentPageChanged="OnPageChanged"
                TotalPages="@_state.Value.TotalPages"
                TotalItems="@_state.Value.TotalCount"
                IsLoading="@_state.Value.IsListLoading"/>
        </div>
    </AppCardBody>
</AppCard>
