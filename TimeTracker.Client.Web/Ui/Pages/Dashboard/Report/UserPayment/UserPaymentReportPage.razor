@page "/board/{WorkspaceId:guid}/report/user-payments"
@attribute [RequireWorkspacePermission(WorkspacePermission.ReadUserPaymentReport)]
@using TimeTracker.Api.Shared.Constants
@using Fluxor
@using LumexUI.Common
@using TimeTracker.Business.Extensions
@using TimeTracker.Client.Core.Store.Report
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Report.Shared
@using Layout = TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Layout

@inherits BaseReactiveComponent
@inject IState<ReportsState> ReportsState
@layout Layout

<div class="space-y-6">


    <section class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">@DashboardLocalizer["UserPaymentReport_Title"]</h1>
            <p class="mt-1 text-sm text-slate-500">
                @DashboardLocalizer["UserPaymentReport_Description"]
            </p>
        </div>
        <div class="w-full sm:w-64">
            <InputDateField
                TValue="DateTime?"
                Value="@_filterState.EndDate"
                ValueChanged="OnEndDateChanged"
                Label="@DashboardLocalizer["DateEnd"].Value"/>
        </div>
    </section>

    @if (ReportsState.Value.IsLoading)
    {
        <div class="flex justify-center rounded-2xl border border-slate-200 bg-white py-12">
            <LumexSpinner/>
        </div>
    }
    else if (_report == null || !_report.Clients.Any())
    {
        <AppCard Class="border-dashed border-slate-200 bg-slate-50 shadow-none">
            <AppCardBody Class="py-10 text-center">
                <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                    <i class="fa-solid fa-chart-pie text-xl"></i>
                </div>
                <p class="text-sm font-semibold text-slate-700">@DashboardLocalizer["UserPaymentReport_EmptyTitle"]</p>
                <p class="mt-1 text-xs text-slate-500">@DashboardLocalizer["UserPaymentReport_EmptyDescription"]</p>
            </AppCardBody>
        </AppCard>
    }
    else
    {
        <section class="grid gap-4 md:grid-cols-3">
            <AppCard>
                <AppCardBody Class="p-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@DashboardLocalizer["TotalEarned"]</p>
                    <p class="mt-2 text-2xl font-bold text-slate-900">
                        <AmountDisplay Amount="@_report.Totals.Earned"/>
                    </p>
                    @if (IsTeamWorkspace && _approvalSummary != null && _approvalSummary.PendingAmount > 0)
                    {
                        var symbol = AuthState.Value.Workspace?.Currency?.Symbol ?? "$";
                        <p class="mt-1 text-xs font-semibold text-amber-600">
                            @string.Format(DashboardLocalizer["Approvals_Report_PendingHint"].Value, $"{symbol}{_approvalSummary.PendingAmount:0.00}")
                        </p>
                    }
                    else
                    {
                        <p class="mt-1 text-xs text-slate-500">@DashboardLocalizer["UserPaymentReport_EarnedSubtitle"]</p>
                    }
                </AppCardBody>
            </AppCard>

            <AppCard>
                <AppCardBody Class="p-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@DashboardLocalizer["TotalReceived"]</p>
                    <p class="mt-2 text-2xl font-bold text-emerald-700">
                        <AmountDisplay Amount="@_report.Totals.Received"/>
                    </p>
                    <p class="mt-1 text-xs text-slate-500">@DashboardLocalizer["UserPaymentReport_ReceivedSubtitle"]</p>
                </AppCardBody>
            </AppCard>

            <AppCard Class="@GetOutstandingCardClass(_report.Totals.Outstanding)">
                <AppCardBody Class="p-4">
                    <div class="flex items-center justify-between">
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@DashboardLocalizer["OutstandingBalance"]</p>
                        <AppBadge
                            Color="@GetOutstandingBadgeColor(_report.Totals.Outstanding)"
                            Variant="BadgeVariant.Flat"
                            Size="ComponentSize.Small">
                            @GetOutstandingBadgeLabel(_report.Totals.Outstanding)
                        </AppBadge>
                    </div>
                    <p class="mt-2 text-2xl font-bold @GetOutstandingTextClass(_report.Totals.Outstanding)">
                        <AmountDisplay Amount="@_report.Totals.Outstanding"/>
                    </p>
                    <p class="mt-1 text-xs text-slate-500">@GetOutstandingBadgeText(_report.Totals.Outstanding)</p>
                </AppCardBody>
            </AppCard>
        </section>

        <AppCard Class="overflow-hidden">
            <AppCardHeader Class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm font-semibold text-slate-900">@DashboardLocalizer["UserPaymentReport_ClientBalances"]</p>
                    <p class="text-sm text-slate-500">@DashboardLocalizer["UserPaymentReport_ClientBalancesDescription"]</p>
                </div>
            </AppCardHeader>
            <AppCardBody Class="p-0">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200 text-sm">
                        <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wider text-slate-500">
                            <tr>
                                <th class="px-3 py-2 text-left">@DashboardLocalizer["Client"]</th>
                                <th class="px-3 py-2 text-right">@DashboardLocalizer["Hours"]</th>
                                <th class="px-3 py-2 text-right">@DashboardLocalizer["Earned"]</th>
                                <th class="px-3 py-2 text-right">@DashboardLocalizer["Received"]</th>
                                <th class="px-3 py-2 text-right">@DashboardLocalizer["Balance"]</th>
                                <th class="px-3 py-2 text-center">@DashboardLocalizer["Status"]</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var client in _report.Clients)
                            {
                                var isExpanded = _expandedClientIds.Contains(client.Id);
                                <tr
                                    class="@($"group cursor-pointer transition-colors hover:bg-slate-50/80 {(isExpanded ? "bg-slate-50/90 font-medium" : "")}")"
                                    @onclick="() => ToggleClient(client.Id)">
                                    <td class="px-3 py-2 text-slate-900">
                                        <div class="flex items-center gap-2.5">
                                            <button
                                                type="button"
                                                class="flex h-6 w-6 shrink-0 items-center justify-center rounded text-slate-400 group-hover:text-slate-600">
                                                <i class="@($"fa-solid fa-chevron-right text-xs transition-transform duration-200 {(isExpanded ? "rotate-90 text-blue-600" : "text-slate-400")}")"></i>
                                            </button>
                                            <span class="font-semibold text-slate-800">@client.Name</span>
                                        </div>
                                    </td>
                                    <td class="px-3 py-2 text-right">
                                        <span class="inline-block rounded bg-slate-100 px-2 py-0.5 font-mono text-xs font-medium text-slate-700">
                                            @client.Duration.ToReadableShortString()
                                        </span>
                                    </td>
                                    <td class="px-3 py-2 text-right font-medium text-slate-800">
                                        <AmountDisplay Amount="@client.Earned"/>
                                    </td>
                                    <td class="px-3 py-2 text-right font-medium text-emerald-700">
                                        <AmountDisplay Amount="@client.Received"/>
                                    </td>
                                    <td class="px-3 py-2 text-right font-bold @GetOutstandingTextClass(client.Outstanding)">
                                        <AmountDisplay Amount="@client.Outstanding"/>
                                    </td>
                                    <td class="px-3 py-2 text-center">
                                        <AppBadge
                                            Color="@GetStatusColor(client.Outstanding)"
                                            Variant="BadgeVariant.Flat"
                                            Size="ComponentSize.Small"
                                            IsDot="true">
                                            @GetStatus(client.Outstanding)
                                        </AppBadge>
                                    </td>
                                </tr>
                                @if (isExpanded)
                                {
                                    <tr class="bg-slate-50/50">
                                        <td
                                            colspan="6"
                                            class="border-l-2 border-blue-500 bg-slate-50/60 px-4 py-3 shadow-inner sm:px-6">
                                            <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
                                                <div class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
                                                    <div>
                                                        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                                                            <div class="flex items-center gap-2">
                                                                <div class="flex h-7 w-7 items-center justify-center rounded-md bg-blue-50 text-blue-600">
                                                                    <i class="fa-solid fa-folder-tree text-xs"></i>
                                                                </div>
                                                                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">
                                                                    @DashboardLocalizer["UserPaymentReport_ProjectWork"]
                                                                </h3>
                                                            </div>
                                                            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-2xs font-medium text-slate-600">
                                                                @client.Projects.Count
                                                            </span>
                                                        </div>

                                                        @if (!client.Projects.Any())
                                                        {
                                                            <div class="py-6 text-center text-xs text-slate-400">
                                                                @DashboardLocalizer["UserPaymentReport_NoProjects"]
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="mt-3 overflow-x-auto">
                                                                <table class="w-full text-xs">
                                                                    <thead>
                                                                        <tr class="border-b border-slate-100 text-2xs font-semibold uppercase tracking-wider text-slate-400">
                                                                            <th class="pb-2 text-left">@DashboardLocalizer["Project"]</th>
                                                                            <th class="pb-2 text-right">@DashboardLocalizer["Hours"]</th>
                                                                            <th class="pb-2 text-right">@DashboardLocalizer["Earned"]</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody class="divide-y divide-slate-100">
                                                                        @foreach (var project in client.Projects)
                                                                        {
                                                                            <tr class="hover:bg-slate-50/50">
                                                                                <td class="py-2 font-medium text-slate-700">
                                                                                    @project.Name
                                                                                </td>
                                                                                <td class="py-2 text-right font-mono text-slate-600">
                                                                                    @project.Duration.ToReadableShortString()
                                                                                </td>
                                                                                <td class="py-2 text-right font-semibold text-slate-800">
                                                                                    <AmountDisplay Amount="@project.Earned"/>
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        }
                                                    </div>

                                                    <div class="mt-4 flex items-center justify-between rounded-lg bg-slate-50 px-3.5 py-2.5 text-xs font-semibold text-slate-800">
                                                        <span>@DashboardLocalizer["UserPaymentReport_TotalEarned"]</span>
                                                        <span class="text-sm font-bold text-slate-900">
                                                            <AmountDisplay Amount="@client.Earned"/>
                                                        </span>
                                                    </div>
                                                </div>

                                                <div class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
                                                    <div>
                                                        <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
                                                            <div class="flex h-7 w-7 items-center justify-center rounded-md bg-emerald-50 text-emerald-600">
                                                                <i class="fa-solid fa-receipt text-xs"></i>
                                                            </div>
                                                            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">
                                                                @DashboardLocalizer["UserPaymentReport_PaymentBalance"]
                                                            </h3>
                                                        </div>

                                                        <dl class="mt-3 space-y-1.5 text-xs">
                                                            <div class="flex items-center justify-between rounded-lg px-3 py-2 transition-colors hover:bg-slate-50">
                                                                <dt class="flex items-center gap-2 text-slate-600">
                                                                    <i class="fa-solid fa-briefcase text-2xs text-slate-400"></i>
                                                                    <span>@DashboardLocalizer["UserPaymentReport_WorkAccrued"]</span>
                                                                </dt>
                                                                <dd class="font-semibold text-slate-800">
                                                                    <AmountDisplay Amount="@client.Earned"/>
                                                                </dd>
                                                            </div>
                                                            <div class="flex items-center justify-between rounded-lg px-3 py-2 transition-colors hover:bg-slate-50">
                                                                <dt class="flex items-center gap-2 text-slate-600">
                                                                    <i class="fa-solid fa-tag text-2xs text-emerald-500"></i>
                                                                    <span>@DashboardLocalizer["UserPaymentReport_ProjectPayments"]</span>
                                                                </dt>
                                                                <dd class="font-semibold text-emerald-700">
                                                                    <AmountDisplay Amount="@client.ProjectPayments"/>
                                                                </dd>
                                                            </div>
                                                            <div class="flex items-center justify-between rounded-lg px-3 py-2 transition-colors hover:bg-slate-50">
                                                                <dt class="flex items-center gap-2 text-slate-600">
                                                                    <i class="fa-solid fa-globe text-2xs text-emerald-500"></i>
                                                                    <span>@DashboardLocalizer["UserPaymentReport_GeneralPayments"]</span>
                                                                </dt>
                                                                <dd class="font-semibold text-emerald-700">
                                                                    <AmountDisplay Amount="@client.GeneralPayments"/>
                                                                </dd>
                                                            </div>
                                                        </dl>
                                                    </div>

                                                    <div class="mt-4 space-y-3">
                                                        <div class="flex items-center justify-between rounded-lg border border-emerald-100 bg-emerald-50/70 px-3.5 py-2.5 text-xs text-emerald-900">
                                                            <span class="font-semibold">@DashboardLocalizer["UserPaymentReport_TotalReceived"]</span>
                                                            <span class="text-sm font-bold text-emerald-700">
                                                                <AmountDisplay Amount="@client.Received"/>
                                                            </span>
                                                        </div>

                                                        <div class="flex justify-start">
                                                            <a
                                                                class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 shadow-2xs transition-colors hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900 sm:w-auto"
                                                                href="@GetClientPaymentsUrl(client.Id)">
                                                                <i class="fa-solid fa-magnifying-glass text-slate-400"></i>
                                                                <span>@DashboardLocalizer["UserPaymentReport_PaymentHistory"]</span>
                                                                <i class="fa-solid fa-arrow-up-right-from-square text-2xs text-slate-400"></i>
                                                            </a>
                                                        </div>

                                                        @if (IsCanShareClientReport)
                                                        {
                                                            <div class="flex justify-start">
                                                                <button
                                                                    type="button"
                                                                    class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-blue-200 bg-blue-50 px-4 py-2 text-xs font-semibold text-blue-700 transition-colors hover:border-blue-300 hover:bg-blue-100 sm:w-auto"
                                                                    @onclick="() => OpenShareModal(client)">
                                                                    <i class="fa-solid fa-link"></i>
                                                                    @DashboardLocalizer["ClientShareReport_Open"]
                                                                </button>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="border-t-2 border-slate-200/80 bg-slate-50 font-semibold text-slate-900">
                            <tr>
                                <td class="px-3 py-2.5">
                                    @DashboardLocalizer["Total"]
                                </td>
                                <td class="px-3 py-2.5 text-right font-mono text-xs">
                                    @_report.Clients.Aggregate(TimeSpan.Zero, (a, c) => a + c.Duration).ToReadableShortString()
                                </td>
                                <td class="px-3 py-2.5 text-right font-semibold text-slate-900">
                                    <AmountDisplay Amount="@_report.Totals.Earned"/>
                                </td>
                                <td class="px-3 py-2.5 text-right font-semibold text-emerald-700">
                                    <AmountDisplay Amount="@_report.Totals.Received"/>
                                </td>
                                <td class="px-3 py-2.5 text-right font-bold @GetOutstandingTextClass(_report.Totals.Outstanding)">
                                    <AmountDisplay Amount="@_report.Totals.Outstanding"/>
                                </td>
                                <td class="px-3 py-2.5 text-center">
                                    <AppBadge
                                        Color="@GetStatusColor(_report.Totals.Outstanding)"
                                        Variant="BadgeVariant.Flat"
                                        Size="ComponentSize.Small"
                                        IsDot="true">
                                        @GetStatus(_report.Totals.Outstanding)
                                    </AppBadge>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </AppCardBody>
        </AppCard>
    }
</div>
