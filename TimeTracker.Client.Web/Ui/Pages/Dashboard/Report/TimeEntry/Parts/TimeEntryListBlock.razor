@using Microsoft.AspNetCore.Components.QuickGrid
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Extensions
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.TimeEntry.Manage
@using TimeTracker.Client.Web.Ui.Shared.Components.Dialogs
@using TimeTracker.Client.Web.Ui.Shared.Components.List

@inherits BaseReactiveComponent

<div
    class="mt-6">
<div>
    <AppTable
        TGridItem="TimeEntryDto"
        Items="@_state.Value.FilteredList.AsQueryable()"
        IsLoading="@_state.Value.IsListLoading">
        <EmptyContent>
            <div
                class="py-6 text-center text-sm text-slate-500">
                @DashboardLocalizer["NoTimeEntriesFilterMessage"]
            </div>
        </EmptyContent>

        <ChildContent>
            <AppTableColumn
                Title="@DashboardLocalizer["Date"].Value">
                <span
                    class="whitespace-nowrap text-slate-600">
                    @context.StartTime.ToDateTimeOffset(AuthState.Value.Workspace?.TimeZone ?? TimeZoneInfo.Local.Id).ToString("MMM d, yyyy")
                </span>
            </AppTableColumn>

            <AppTableColumn
                Title="@DashboardLocalizer["User"].Value">
                <span
                    class="font-medium text-slate-700">
                    @context.User.Name
                </span>
            </AppTableColumn>

            <AppTableColumn
                Title="@DashboardLocalizer["Description"].Value">
                <span
                    class="@(string.IsNullOrWhiteSpace(context.Description) && context.Task == null ? "italic text-slate-400" : "text-slate-700")">
                    @GetDescriptionOrTask(context)
                </span>
            </AppTableColumn>

            <AppTableColumn
                Title="@DashboardLocalizer["Project"].Value">
                <span
                    class="text-slate-500">
                    @(context.Project?.Name ?? "—")
                </span>
            </AppTableColumn>

            <AppTableColumn
                Title="@DashboardLocalizer["Billable"].Value"
                Align="Align.Center">
                @if (context.IsBillable)
                {
                    <span
                        class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-semibold text-emerald-600">
                        <i
                            class="fa-solid fa-dollar-sign">
                        </i>
                    </span>
                }
                else
                {
                    <span
                        class="text-slate-300">
                        —
                    </span>
                }
            </AppTableColumn>

            <AppTableColumn
                Title="@DashboardLocalizer["Duration"].Value"
                Align="Align.End">
                <span
                    class="whitespace-nowrap font-mono font-semibold text-slate-700">
                    @if (context.IsAutostopped)
                    {
                        <span
                            class="mr-1 text-amber-600"
                            title="@DashboardLocalizer["TimeEntry_Autostopped"]">
                            ⚠️
                        </span>
                    }
                    @_timeParsingService.TimeSpanToTimeString(context.Duration, true)
                </span>
            </AppTableColumn>

            <AppTableColumn
                TGridItem="TimeEntryDto"
                Title=""
                Align="Align.End">
                <div
                    class="flex items-center justify-end gap-1">
                    @if (SecurityManager.CanEditTimeEntry(context))
                    {
                        <AppButton
                            Size="ComponentSize.Small"
                            Color="ComponentColor.Default"
                            Variant="ButtonVariant.Light"
                            IconOnly="true"
                            OnClick="@(() => OnEdit(context))">
                            <ChildContent>
                                <i
                                    class="fa-regular fa-pen-to-square text-slate-400">
                                </i>
                            </ChildContent>
                        </AppButton>
                    }
                    @if (SecurityManager.CanDeleteTimeEntry(context))
                    {
                        <AppButton
                            Size="ComponentSize.Small"
                            Color="ComponentColor.Danger"
                            Variant="ButtonVariant.Light"
                            IconOnly="true"
                            OnClick="@(() => OnDelete(context))">
                            <ChildContent>
                                <i
                                    class="fa-regular fa-trash-can text-slate-400">
                                </i>
                            </ChildContent>
                        </AppButton>
                    }
                </div>
            </AppTableColumn>
        </ChildContent>
    </AppTable>

    <div
        class="mt-4">
        <TPaginator
            CurrentPage="@_state.Value.FilteredSelectedPage"
            CurrentPageChanged="OnPageChanged"
            TotalPages="@_state.Value.FilteredTotalPages"
            TotalItems="@_state.Value.FilteredTotalCount"
            IsLoading="@_state.Value.IsListLoading"/>
    </div>
</div>
