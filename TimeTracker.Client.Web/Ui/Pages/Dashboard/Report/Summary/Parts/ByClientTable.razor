@using Microsoft.AspNetCore.Components.QuickGrid
@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Business.Extensions
@using TimeTracker.Client.Web.Ui.Shared.Components

@code {
    [Parameter]
    public ICollection<SummaryByClientsReportItemDto> Items { get; set; } = new List<SummaryByClientsReportItemDto>();

    private static decimal GetEffectiveHourlyRate(decimal amount, TimeSpan duration)
    {
        if (duration.TotalHours <= 0)
        {
            return 0;
        }

        return Math.Round(amount / (decimal)duration.TotalHours, 2);
    }
}

<AppTable
    TGridItem="SummaryByClientsReportItemDto"
    Items="@Items.AsQueryable()">
    <AppPropertyColumn
        TGridItem="SummaryByClientsReportItemDto"
        TProp="string"
        Title="@DashboardLocalizer["Client"].Value"
        Property="@(p => p.ClientName)"
        Sortable="true"/>
    <AppTableColumn
        TGridItem="SummaryByClientsReportItemDto"
        Title="@DashboardLocalizer["Duration"].Value"
        SortBy="@(GridSort<SummaryByClientsReportItemDto>.ByAscending(p => p.Duration))">
        @context.Duration.ToReadableShortString()
    </AppTableColumn>
    <AppTableColumn
        TGridItem="SummaryByClientsReportItemDto"
        Title="@DashboardLocalizer["Earned"].Value"
        SortBy="@(GridSort<SummaryByClientsReportItemDto>.ByAscending(p => p.Amount))">
        <AmountDisplay
            Amount="@context.Amount"/>
    </AppTableColumn>
    <AppTableColumn
        TGridItem="SummaryByClientsReportItemDto"
        Title="@DashboardLocalizer["EffectiveHourlyRate"].Value">
        <AmountDisplay
            Amount="@GetEffectiveHourlyRate(context.Amount, context.Duration)"/>/h
    </AppTableColumn>
</AppTable>
