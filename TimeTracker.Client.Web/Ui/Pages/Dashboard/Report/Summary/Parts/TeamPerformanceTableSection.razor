@using Microsoft.AspNetCore.Components.QuickGrid
@using TimeTracker.Api.Shared.Dto.Model.Report.TeamSummary
@using TimeTracker.Business.Extensions
@using TimeTracker.Client.Web.Ui.Shared.Components

<AppCard
    Class="mt-10">
    <AppCardHeader>
        <SummarySectionHeader
            Title="@DashboardLocalizer["TeamPerformance"].Value"/>
    </AppCardHeader>
    <AppCardBody>
        <AppTable
            TGridItem="TeamSummaryMemberReportItemDto"
            Items="@Items.AsQueryable()">
            <AppTableColumn
                Title="@DashboardLocalizer["Member"].Value"
                SortBy="@(GridSort<TeamSummaryMemberReportItemDto>.ByAscending(item => item.Name))">
                <div
                    class="font-medium text-slate-900">
                    @context.Name
                </div>
                <div
                    class="text-xs text-slate-500">
                    @context.Email
                </div>
            </AppTableColumn>

            <AppTableColumn
                Title="@DashboardLocalizer["Duration"].Value"
                SortBy="@(GridSort<TeamSummaryMemberReportItemDto>.ByAscending(item => item.Duration))">
                <span
                    class="font-mono text-sm">
                    @context.Duration.ToReadableShortString()
                </span>
            </AppTableColumn>

            <AppTableColumn
                Title="@DashboardLocalizer["TeamLaborCost"].Value"
                SortBy="@(GridSort<TeamSummaryMemberReportItemDto>.ByAscending(item => item.TeamLaborCost))">
                <AmountDisplay
                    Amount="@context.TeamLaborCost"/>
            </AppTableColumn>

            <AppTableColumn
                Title="@DashboardLocalizer["ClientBillable"].Value"
                SortBy="@(GridSort<TeamSummaryMemberReportItemDto>.ByAscending(item => item.ClientBillable))">
                <AmountDisplay
                    Amount="@context.ClientBillable"/>
            </AppTableColumn>

            <AppTableColumn
                Title="@DashboardLocalizer["Margin"].Value"
                SortBy="@(GridSort<TeamSummaryMemberReportItemDto>.ByAscending(item => item.GrossProfit))">
                <span
                    class="@(context.GrossProfit < 0 ? "text-red-600" : "text-emerald-700 font-medium")">
                    <AmountDisplay
                        Amount="@context.GrossProfit"/>
                </span>
            </AppTableColumn>

            <AppTableColumn
                Title="@DashboardLocalizer["MarginPercent"].Value"
                SortBy="@(GridSort<TeamSummaryMemberReportItemDto>.ByAscending(item => item.MarginPercent))">
                <span>
                    @(context.MarginPercent?.ToString("0.#") ?? "—")
                </span>
            </AppTableColumn>
        </AppTable>
    </AppCardBody>
</AppCard>
