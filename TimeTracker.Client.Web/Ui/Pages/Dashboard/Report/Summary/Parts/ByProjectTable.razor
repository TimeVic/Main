@using Microsoft.AspNetCore.Components.QuickGrid
@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Business.Extensions
@using TimeTracker.Client.Web.Ui.Shared.Components

@code {
    [Parameter]
    public ICollection<SummaryByProjectsReportItemDto> Items { get; set; } = new List<SummaryByProjectsReportItemDto>();

    private static decimal GetEffectiveHourlyRate(decimal amount, TimeSpan duration)
    {
        if (duration.TotalHours <= 0)
        {
            return 0;
        }

        return Math.Round(amount / (decimal)duration.TotalHours, 2);
    }
}

<AppTable
    TGridItem="SummaryByProjectsReportItemDto"
    Items="@Items.AsQueryable()">
    <AppTableColumn
        Title="@DashboardLocalizer["Project"].Value"
        SortBy="@(GridSort<SummaryByProjectsReportItemDto>.ByAscending(p => p.ProjectName))">
        @(context.ProjectName ?? DashboardLocalizer["NoProject"].Value)
    </AppTableColumn>
    <AppTableColumn
        Title="@DashboardLocalizer["Duration"].Value"
        SortBy="@(GridSort<SummaryByProjectsReportItemDto>.ByAscending(p => p.Duration))">
        @context.Duration.ToReadableShortString()
    </AppTableColumn>
    <AppTableColumn
        Title="@DashboardLocalizer["Earned"].Value"
        SortBy="@(GridSort<SummaryByProjectsReportItemDto>.ByAscending(p => p.Amount))">
        <AmountDisplay
            Amount="@context.Amount"/>
    </AppTableColumn>
    <AppTableColumn
        TGridItem="SummaryByProjectsReportItemDto"
        Title="@DashboardLocalizer["EffectiveHourlyRate"].Value">
        <AmountDisplay
            Amount="@GetEffectiveHourlyRate(context.Amount, context.Duration)"/>/h
    </AppTableColumn>
</AppTable>
