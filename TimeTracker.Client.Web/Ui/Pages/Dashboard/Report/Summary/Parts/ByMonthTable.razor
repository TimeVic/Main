@using Microsoft.AspNetCore.Components.QuickGrid
@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Business.Extensions
@using TimeTracker.Client.Web.Ui.Shared.Components
@using System.Globalization

@code {
    [Parameter]
    public ICollection<SummaryByMonthsReportItemDto> Items { get; set; } = new List<SummaryByMonthsReportItemDto>();

    private string GetName(int month, int year)
    {
        return new DateTime(year, month, 1).ToString("MMM", CultureInfo.CurrentUICulture);
    }

    private static decimal GetEffectiveHourlyRate(decimal amount, TimeSpan duration)
    {
        if (duration.TotalHours <= 0)
        {
            return 0;
        }

        return Math.Round(amount / (decimal)duration.TotalHours, 2);
    }
}

<AppTable
    TGridItem="SummaryByMonthsReportItemDto"
    Items="@Items.AsQueryable()">
    <AppTableColumn
        TGridItem="SummaryByMonthsReportItemDto"
        Title="@DashboardLocalizer["Month"].Value"
        SortBy="@(GridSort<SummaryByMonthsReportItemDto>.ByAscending(p => p.Year).ThenAscending(p => p.Month))">
        @GetName(context.Month, context.Year)
    </AppTableColumn>
    <AppTableColumn
        TGridItem="SummaryByMonthsReportItemDto"
        Title="@DashboardLocalizer["Duration"].Value"
        SortBy="@(GridSort<SummaryByMonthsReportItemDto>.ByAscending(p => p.Duration))">
        @context.Duration.ToReadableShortString()
    </AppTableColumn>
    <AppTableColumn
        TGridItem="SummaryByMonthsReportItemDto"
        Title="@DashboardLocalizer["Earned"].Value"
        SortBy="@(GridSort<SummaryByMonthsReportItemDto>.ByAscending(p => p.Amount))">
        <AmountDisplay
            Amount="@context.Amount"/>
    </AppTableColumn>
    <AppTableColumn
        TGridItem="SummaryByMonthsReportItemDto"
        Title="@DashboardLocalizer["Outstanding"].Value">
        <span
            class="text-slate-400">
            -
        </span>
    </AppTableColumn>
    <AppTableColumn
        TGridItem="SummaryByMonthsReportItemDto"
        Title="@DashboardLocalizer["EffectiveHourlyRate"].Value">
        <AmountDisplay
            Amount="@GetEffectiveHourlyRate(context.Amount, context.Duration)"/>/h
    </AppTableColumn>
</AppTable>
