@inherits BaseReactiveComponent

<LumexCard Class="@CardClass">
    <LumexCardBody Class="flex h-full flex-col p-4">
        <div class="flex items-start justify-between gap-3">
            <p class="@TitleClass" title="@TooltipText">@Title</p>
            @if (!string.IsNullOrWhiteSpace(IconClass))
            {
                <span class="@IconContainerClass">
                    <i class="@IconClass"></i>
                </span>
            }
        </div>
        <p class="@ValueClass">
            @if (Value != null)
            {
                @Value
            }
            else
            {
                @ValueText
            }
        </p>
        <p class="@HelperClass">@HelperText</p>
        @if (!string.IsNullOrWhiteSpace(ActionText) && !string.IsNullOrWhiteSpace(ActionHref))
        {
            <a href="@ActionHref" class="@ActionClass">@ActionText</a>
        }
    </LumexCardBody>
</LumexCard>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string HelperText { get; set; } = string.Empty;

    [Parameter]
    public string TooltipText { get; set; } = string.Empty;

    [Parameter]
    public string ValueText { get; set; } = "—";

    [Parameter]
    public RenderFragment? Value { get; set; }

    [Parameter]
    public string Variant { get; set; } = "neutral";

    [Parameter]
    public bool Emphasis { get; set; }

    [Parameter]
    public string IconClass { get; set; } = string.Empty;

    [Parameter]
    public string ActionText { get; set; } = string.Empty;

    [Parameter]
    public string ActionHref { get; set; } = string.Empty;

    private string CardClass
    {
        get
        {
            var baseClass = "h-full min-h-[105px] border shadow-sm";
            return Variant switch
            {
                "success" => $"{baseClass} border-emerald-100 bg-emerald-50/50",
                "danger" => $"{baseClass} border-red-200 bg-red-100/80 shadow-md shadow-red-100/70",
                _ => $"{baseClass} border-slate-200 bg-white"
            };
        }
    }

    private string TitleClass
    {
        get
        {
            return Variant switch
            {
                "success" => "text-xs font-semibold uppercase tracking-wide text-emerald-700",
                "danger" => "text-xs font-semibold uppercase tracking-wide text-red-600",
                _ => "text-xs font-semibold uppercase tracking-wide text-slate-500"
            };
        }
    }

    private string ValueClass
    {
        get
        {
            var sizeClass = Emphasis ? "text-2xl font-bold" : "text-xl font-bold";
            var colorClass = Variant switch
            {
                "success" => "text-emerald-700",
                "danger" => "text-red-700",
                _ => "text-slate-900"
            };
            return $"mt-2 {sizeClass} leading-tight {colorClass}";
        }
    }

    private string HelperClass
    {
        get => Variant == "danger"
            ? "mt-1 text-xs font-medium text-red-700"
            : "mt-1 text-xs text-slate-500";
    }

    private string IconContainerClass
    {
        get
        {
            return Variant switch
            {
                "success" => "inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 text-xs",
                "danger" => "inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-red-200 text-red-700 text-xs",
                _ => "inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 text-xs"
            };
        }
    }

    private string ActionClass
    {
        get => Variant == "danger"
            ? "mt-auto inline-flex w-fit pt-2 text-xs font-semibold text-red-700 hover:text-red-800"
            : "mt-auto inline-flex w-fit pt-2 text-xs font-semibold text-slate-600 hover:text-slate-900";
    }
}
