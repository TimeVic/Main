@using Microsoft.AspNetCore.Components.QuickGrid
@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Business.Extensions
@using TimeTracker.Client.Web.Ui.Shared.Components

@code {
    [Parameter]
    public ICollection<SummaryByDaysReportItemDto> Items { get; set; } = new List<SummaryByDaysReportItemDto>();

    private static decimal GetEffectiveHourlyRate(decimal amount, TimeSpan duration)
    {
        if (duration.TotalHours <= 0)
        {
            return 0;
        }

        return Math.Round(amount / (decimal)duration.TotalHours, 2);
    }
}

<AppTable
    TGridItem="SummaryByDaysReportItemDto"
    Items="@Items.AsQueryable()">
    <AppTableColumn
        TGridItem="SummaryByDaysReportItemDto"
        Title="@DashboardLocalizer["Date"].Value"
        SortBy="@(GridSort<SummaryByDaysReportItemDto>.ByAscending(p => p.Date))">
        @context.Date.ToShortDateString()
    </AppTableColumn>
    <AppTableColumn
        TGridItem="SummaryByDaysReportItemDto"
        Title="@DashboardLocalizer["Duration"].Value"
        SortBy="@(GridSort<SummaryByDaysReportItemDto>.ByAscending(p => p.Duration))">
        @context.Duration.ToReadableShortString()
    </AppTableColumn>
    <AppTableColumn
        TGridItem="SummaryByDaysReportItemDto"
        Title="@DashboardLocalizer["Earned"].Value"
        SortBy="@(GridSort<SummaryByDaysReportItemDto>.ByAscending(p => p.Amount))">
        <AmountDisplay
            Amount="@context.Amount"/>
    </AppTableColumn>
    <AppTableColumn
        TGridItem="SummaryByDaysReportItemDto"
        Title="@DashboardLocalizer["Outstanding"].Value">
        <span
            class="text-slate-400">
            -
        </span>
    </AppTableColumn>
    <AppTableColumn
        TGridItem="SummaryByDaysReportItemDto"
        Title="@DashboardLocalizer["EffectiveHourlyRate"].Value">
        <AmountDisplay
            Amount="@GetEffectiveHourlyRate(context.Amount, context.Duration)"/>/h
    </AppTableColumn>
</AppTable>
