@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Business.Common.Services.Format
@using TimeTracker.Client.Web.Ui.Shared.Components
@using System.Globalization

@inherits BaseReactiveComponent

<AppCard Class="mt-10">
    <AppCardHeader>
        <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
            <SummarySectionHeader
                Title="@string.Format(DashboardLocalizer["SummaryBy"].Value, PeriodLabel)"/>
            <div class="flex flex-wrap items-center gap-3 text-xs font-semibold">
                <span class="inline-flex items-center gap-2 rounded-full bg-blue-50 px-3 py-1 text-blue-700">
                    <span class="h-2.5 w-2.5 rounded-full bg-blue-600"></span>
                    @DashboardLocalizer["Duration"]
                </span>
                <span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-emerald-700">
                    <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                    @DashboardLocalizer["Earned"]
                </span>
            </div>
        </div>
    </AppCardHeader>
    <AppCardBody>
        <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600">
            @if (Items.Any() && _trackedDaysCount > 0)
            {
                <span>@_trackedDaysLabel • <AmountDisplay Amount="@_totalEarned"/> @DashboardLocalizer["Earned"]</span>
            }
            else
            {
                <span>@DashboardLocalizer["NoSignificantActivityPeriod"]</span>
            }
        </div>

        @if (Items.Any())
        {
            <div class="mt-6 overflow-x-auto pb-2">
                <div class="relative flex min-w-max items-end gap-3 rounded-2xl border border-slate-200/80 bg-gradient-to-b from-slate-50/50 to-slate-100/40 px-8 pt-12 pb-4">
                    <!-- Background Grid lines -->
                    <div class="pointer-events-none absolute inset-x-8 top-12 flex h-44 flex-col justify-between md:h-52">
                        <div class="w-full border-b border-dashed border-slate-200/80"></div>
                        <div class="w-full border-b border-dashed border-slate-200/80"></div>
                        <div class="w-full border-b border-dashed border-slate-200/80"></div>
                        <div class="w-full border-b border-slate-200"></div>
                    </div>

                    @foreach (var item in Items.AsQueryable())
                    {
                        <div class="group relative flex w-16 shrink-0 flex-col items-center gap-2 rounded-xl p-1.5 transition-all duration-200 hover:bg-white/80 hover:shadow-sm">
                            <div class="relative flex h-44 items-end gap-1.5 md:h-52">
                                <!-- Tooltip floating above columns -->
                                <div class="pointer-events-none absolute -top-8 left-1/2 z-30 flex -translate-x-1/2 items-center gap-1.5 rounded-lg bg-slate-900/95 px-2.5 py-1 text-[11px] font-medium text-white shadow-xl backdrop-blur-sm opacity-0 transition-all duration-200 group-hover:-top-9 group-hover:opacity-100 whitespace-nowrap">
                                    <span class="text-blue-300 font-semibold">@TimeParsingService.TimeSpanToTimeString(item.Duration, false)</span>
                                    <span class="text-slate-500">•</span>
                                    <span class="text-emerald-300 font-semibold">@item.Amount.ToString("0.##", CultureInfo.InvariantCulture) $</span>
                                    <!-- Pointer Arrow -->
                                    <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 border-4 border-transparent border-t-slate-900/95"></div>
                                </div>

                                <!-- Duration Bar -->
                                <div class="flex h-full w-4 items-end rounded-t-lg rounded-b-md bg-blue-100/40 p-0.5">
                                    <div class="w-full rounded-t-md rounded-b-sm bg-gradient-to-t from-blue-600 via-blue-500 to-indigo-500 transition-all duration-300 group-hover:from-blue-500 group-hover:to-indigo-400 group-hover:shadow-md group-hover:shadow-blue-500/20" style="@GetDurationBarStyle(item)"></div>
                                </div>
                                <!-- Earned Bar -->
                                <div class="flex h-full w-4 items-end rounded-t-lg rounded-b-md bg-emerald-100/40 p-0.5">
                                    <div class="w-full rounded-t-md rounded-b-sm bg-gradient-to-t from-emerald-600 via-emerald-500 to-teal-500 transition-all duration-300 group-hover:from-emerald-500 group-hover:to-teal-400 group-hover:shadow-md group-hover:shadow-emerald-500/20" style="@GetAmountBarStyle(item)"></div>
                                </div>
                            </div>
                            <div class="flex flex-col items-center gap-0.5 text-center">
                                <div class="text-[11px] font-bold text-slate-600 group-hover:text-slate-900 transition-colors duration-200">@item.Date.ToString("dd MMM")</div>
                                <div class="rounded bg-blue-50/80 px-1.5 py-0.2 text-[10px] font-semibold text-blue-600 group-hover:bg-blue-100 transition-colors duration-200">@TimeParsingService.TimeSpanToTimeString(item.Duration, false)</div>
                                <div class="rounded bg-emerald-50/80 px-1.5 py-0.2 text-[10px] font-semibold text-emerald-600 group-hover:bg-emerald-100 transition-colors duration-200">@item.Amount.ToString("0.##", CultureInfo.InvariantCulture)</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="mt-6 rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-6 py-10 text-center text-sm text-slate-500">
                @DashboardLocalizer["StartTrackingEarnings"]
            </div>
        }
    </AppCardBody>
</AppCard>