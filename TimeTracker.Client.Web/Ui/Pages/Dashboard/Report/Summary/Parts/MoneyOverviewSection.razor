@using Fluxor
@using TimeTracker.Api.Shared.Dto.Model.Report
@using TimeTracker.Client.Web.Constants
@using TimeTracker.Client.Core.Store.Report
@using TimeTracker.Client.Web.Ui.Shared.Components

@inherits BaseReactiveComponent

@inject IState<ReportsState> ReportsState

<section class="mt-10 space-y-4">
    <SummarySectionHeader
        Title="@DashboardLocalizer["MoneyOverview"].Value"
        HelperText="@DashboardLocalizer["MoneyOverviewHelper"].Value"/>

    <p class="text-sm text-slate-500">
        @DashboardLocalizer["OutstandingFormula"]
    </p>

    @if (!string.IsNullOrWhiteSpace(_moneyInsight))
    {
        <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600">
            @_moneyInsight
        </div>
    }

    <div class="grid gap-4 lg:grid-cols-3">
        <SummaryMetricCard
            Title="@DashboardLocalizer["TotalEarned"].Value"
            HelperText="@DashboardLocalizer["TotalEarnedHelper"].Value"
            Variant="neutral"
            IconClass="fa-solid fa-chart-line">
            <Value>
                <AmountDisplay Amount="@_totalEarned"/>
            </Value>
        </SummaryMetricCard>

        <SummaryMetricCard
            Title="@DashboardLocalizer["TotalReceived"].Value"
            HelperText="@DashboardLocalizer["TotalReceivedHelper"].Value"
            Variant="success"
            IconClass="fa-solid fa-check">
            <Value>
                <AmountDisplay Amount="@_totalReceived"/>
            </Value>
        </SummaryMetricCard>

        <SummaryMetricCard
            Title="@DashboardLocalizer["OutstandingBalance"].Value"
            HelperText="@DashboardLocalizer["OutstandingBalanceHelper"].Value"
            Variant="danger"
            Emphasis="true"
            IconClass="fa-solid fa-triangle-exclamation"
            ActionText="@DashboardLocalizer["ViewUnpaidByClient"].Value"
            ActionHref="@SiteUrl.Dashboard_Reports_MemberPayments">
            <Value>
                <AmountDisplay Amount="@_outstandingBalance"/>
            </Value>
        </SummaryMetricCard>
    </div>
</section>

@code {
    private IEnumerable<IGrouping<Guid?, MemberPaymentsReportItemDto>> _paymentReportGroups
    {
        get => ReportsState.Value.MemberPaymentReportItems.GroupBy(item => item.ClientId);
    }

    private decimal _totalEarned
    {
        get => ReportsState.Value.MemberPaymentReportItems.Sum(item => item.Amount);
    }

    private decimal _totalReceived
    {
        get => _paymentReportGroups.Sum(group => group.FirstOrDefault()?.PaidAmountByClient ?? 0);
    }

    private decimal _outstandingBalance
    {
        get => _paymentReportGroups.Sum(group =>
        {
            var earned = group.Sum(item => item.Amount);
            var paid = group.FirstOrDefault()?.PaidAmountByClient ?? 0;
            return Math.Max(earned - paid, 0);
        });
    }

    private string _moneyInsight
    {
        get
        {
            if (_totalEarned > 0 && _totalReceived <= 0)
            {
                return DashboardLocalizer["WorkRecordedNoPaymentsYet"].Value;
            }

            return string.Empty;
        }
    }
}
