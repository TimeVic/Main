@using System.Globalization
@using TimeTracker.Api.Shared.Dto.Model.Report.TeamSummary
@using TimeTracker.Client.Web.Ui.Shared.Components

<LumexCard Class="mt-10">
    <LumexCardHeader>
        <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
            <SummarySectionHeader
                Title="@string.Format(DashboardLocalizer["SummaryBy"].Value, PeriodLabel)"/>
            <div class="flex flex-wrap items-center gap-3 text-xs font-semibold">
                <span class="inline-flex items-center gap-2 rounded-full bg-blue-50 px-3 py-1 text-blue-700"><span class="h-2.5 w-2.5 rounded-full bg-blue-600"></span>@DashboardLocalizer["ClientBillable"]</span>
                <span class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1 text-slate-700"><span class="h-2.5 w-2.5 rounded-full bg-slate-500"></span>@DashboardLocalizer["TeamLaborCost"]</span>
            </div>
        </div>
    </LumexCardHeader>
    <LumexCardBody>
        @if (Items.Any())
        {
            <div class="mt-2 overflow-x-auto pb-2">
                <div class="relative flex min-w-max items-end gap-3 rounded-2xl border border-slate-200/80 bg-slate-50 px-8 pb-4 pt-12">
                    @foreach (var item in Items)
                    {
                        <div class="group relative flex w-16 shrink-0 flex-col items-center gap-2 rounded-xl p-1.5 transition-all duration-300 hover:bg-white hover:shadow-sm">
                            <div class="relative flex h-52 items-end gap-1.5">
                                <div class="pointer-events-none absolute -top-9 left-1/2 z-30 flex -translate-x-1/2 items-center gap-1.5 whitespace-nowrap rounded-lg bg-slate-900/95 px-2.5 py-1 text-[11px] font-medium text-white opacity-0 shadow-xl transition-all duration-300 group-hover:opacity-100">
                                    <span class="text-blue-300"><AmountDisplay Amount="@item.ClientBillable"/></span>
                                    <span class="text-slate-500">•</span>
                                    <span class="text-slate-300"><AmountDisplay Amount="@item.TeamLaborCost"/></span>
                                </div>
                                <div class="flex h-full w-4 items-end rounded-t-lg bg-blue-100/50 p-0.5"><div class="w-full rounded-t-md bg-blue-600 transition-all duration-500" style="@GetBarStyle(item.ClientBillable)"></div></div>
                                <div class="flex h-full w-4 items-end rounded-t-lg bg-slate-200 p-0.5"><div class="w-full rounded-t-md bg-slate-500 transition-all duration-500" style="@GetBarStyle(item.TeamLaborCost)"></div></div>
                            </div>
                            <div class="text-center text-[11px] font-bold text-slate-600">@item.Date.ToString("dd MMM", CultureInfo.CurrentUICulture)</div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-6 py-10 text-center text-sm text-slate-500">@DashboardLocalizer["NoTeamActivitySelectedPeriod"]</div>
        }
    </LumexCardBody>
</LumexCard>
