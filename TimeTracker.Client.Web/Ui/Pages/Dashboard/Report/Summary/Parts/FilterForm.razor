@using LumexUI.Common
@using TimeTracker.Business.Common.Constants.Reports

@inherits BaseReactiveComponent

<LumexCard Class="border-slate-200 bg-slate-50/50 shadow-none">
    <LumexCardHeader>
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-400">@DashboardLocalizer["Filter"]</p>
            <h2 class="mt-2 text-lg font-semibold text-slate-900">@DashboardLocalizer["SummaryReportParameters"]</h2>
            <p class="mt-1 text-sm text-slate-500">@(IsTeamSummary ? DashboardLocalizer["TeamSummaryFilterHelper"].Value : DashboardLocalizer["ReportFilterHelper"].Value)</p>
        </div>
    </LumexCardHeader>
    <LumexCardBody>
        <div class="@FilterGridClass">
            @if (!IsTeamSummary)
            {
                <div>
                <EnumDropDown
                    Label="@DashboardLocalizer["GroupBy"].Value"
                    TItem="SummaryReportType"
                    DropDownColor="ThemeColor.Default"
                    AllowedValues="@(Enum.GetValues<SummaryReportType>())"
                    Value="@_filterState.ReportType"
                    ValueChanged="OnChangeReportType"/>
                </div>
            }

            <div>
                <EnumDropDown
                    Label="@DashboardLocalizer["Period"].Value"
                    TItem="SummaryReportPeriodType"
                    DropDownColor="ThemeColor.Default"
                    Value="@_filterState.PeriodType"
                    ValueChanged="OnChangePeriodType"/>
            </div>

            @if (_filterState.PeriodType == SummaryReportPeriodType.Custom)
            {
                <div>
                    <LumexDatebox 
                        TValue="DateTime?"
                        Required="true"
                        Value="@_filterState.StartDate"
                        Variant="InputVariant.Outlined"
                        LabelPlacement="LabelPlacement.Outside"
                        ValueChanged="@OnChangeDateStart"
                        Label="@DashboardLocalizer["DateFrom"].Value"/>
                </div>

                <div>
                    <LumexDatebox 
                        TValue="DateTime?"
                        Required="true"
                        Value="@_filterState.EndDate"
                        Variant="InputVariant.Outlined"
                        LabelPlacement="LabelPlacement.Outside"
                        ValueChanged="@OnChangeDateEnd"
                        Label="@DashboardLocalizer["DateTo"].Value"/>
                </div>
            }
        </div>
    </LumexCardBody>
</LumexCard>

@code {
    [Parameter]
    public bool IsTeamSummary { get; set; }
}
