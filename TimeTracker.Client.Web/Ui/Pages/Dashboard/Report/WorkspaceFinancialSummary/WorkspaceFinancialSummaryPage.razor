@page "/board/{WorkspaceId:guid}/money"
@page "/board/{WorkspaceId:guid}/report/workspace-financial-summary"
@page "/board/money"
@page "/board/report/workspace-financial-summary"
@attribute [RequireWorkspacePermission(WorkspacePermission.ReadWorkspaceFinancialSummary, "report/user-payments")]
@using Fluxor
@using TimeTracker.Api.Shared.Constants
@using TimeTracker.Client.Core.Store.Report
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.MemberPayments.Parts.Modals
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Report.WorkspaceFinancialSummary.Parts
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared
@using TimeTracker.Client.Web.Ui.Shared.Components
@using Layout = TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Layout

@inherits BaseReactiveComponent
@inject IState<ReportsState> _state
@layout Layout

<AddMemberPaymentModal
    IsOpened="_isPayoutModalOpened"
    IsOpenedChanged="OnPayoutModalStateChanged"
    InitialMemberId="_selectedMemberId"/>

<div class="space-y-6">
    <section>
        <h1 class="text-2xl font-bold text-slate-900">@DashboardLocalizer["WorkspaceMoney"]</h1>
        <p class="mt-1 text-sm text-slate-500">@DashboardLocalizer["WorkspaceMoneyDescription"]</p>
    </section>

    @if (_state.Value.IsLoading)
    {
        <div class="flex justify-center rounded-2xl border border-slate-200 bg-white py-10"><LumexSpinner/></div>
    }
    else if (_reportData == null || (_reportData.ClientBalances.Count == 0 && _reportData.MemberBalances.Count == 0))
    {
        <LumexCard Class="border-dashed border-slate-200 bg-slate-50 shadow-none"><LumexCardBody><p class="text-sm font-medium text-slate-700">@DashboardLocalizer["NoTrackedWorkYet"]</p><p class="mt-1 text-sm text-slate-500">@DashboardLocalizer["WorkspaceFinancialSummaryPage_NoTrackedWorkDescription"]</p></LumexCardBody></LumexCard>
    }
    else
    {
        <FinancialFunnelBlock/>
        <FinancialActionCenterBlock OnPayMember="OpenPayoutModal"/>
        <FinancialReportTabsBlock/>
    }
</div>
