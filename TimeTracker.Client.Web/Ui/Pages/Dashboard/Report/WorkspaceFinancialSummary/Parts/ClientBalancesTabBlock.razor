@using Fluxor
@using TimeTracker.Business.Common.Constants
@using TimeTracker.Business.Extensions
@using TimeTracker.Client.Core.Store.Report
@using TimeTracker.Client.Web.Ui.Shared.Components

@inherits BaseReactiveComponent
@inject IState<ReportsState> ReportsState

@{
    var items = ReportsState.Value.WorkspaceFinancialSummaryData?.ClientBalances ?? [];
}

@if (items.Count == 0)
{
    <p class="rounded-xl border border-dashed border-slate-200 bg-slate-50 px-4 py-6 text-sm text-slate-500">
        @DashboardLocalizer["NoClientBalancesYet"]
    </p>
}
else
{
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
        <table class="min-w-[760px] w-full text-sm">
            <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                <tr>
                    <th class="px-3 py-2">@DashboardLocalizer["Client"]</th>
                    <th class="px-3 py-2 text-right">@DashboardLocalizer["Hours"]</th>
                    <th class="px-3 py-2 text-right">@DashboardLocalizer["Earned"]</th>
                    <th class="px-3 py-2 text-right">@DashboardLocalizer["Received"]</th>
                    <th class="px-3 py-2 text-right">@DashboardLocalizer["Balance"]</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var item in items)
                {
                    <tr class="hover:bg-slate-50/50">
                        <td class="px-3 py-2 font-medium text-slate-800">
                            <div class="inline-flex items-center gap-1.5">
                                <span>@item.Client.Name</span>
                                @if (IsCanShareClientReport)
                                {
                                    <button
                                        type="button"
                                        class="inline-flex h-6 w-6 items-center justify-center rounded text-slate-400 transition hover:bg-blue-50 hover:text-blue-600"
                                        title="@DashboardLocalizer["ClientShareReport_Open"]"
                                        @onclick="() => OnShareClient.InvokeAsync((item.Client.Id, item.Client.Name))">
                                        <i class="fa-solid fa-link text-xs"></i>
                                    </button>
                                }
                            </div>
                        </td>
                        <td class="px-3 py-2 text-right text-slate-600">@item.Duration.ToReadableShortString()</td>
                        <td class="px-3 py-2 text-right">
                            <AmountDisplay Amount="@item.Earned"/>
                        </td>
                        <td class="px-3 py-2 text-right text-emerald-700">
                            <AmountDisplay Amount="@item.Received"/>
                        </td>
                        <td class="px-3 py-2 text-right font-semibold @(item.Outstanding > 0 ? "text-red-700" : item.Outstanding < 0 ? "text-blue-700" : "text-emerald-700")">
                            <AmountDisplay Amount="@item.Outstanding"/>
                        </td>
                    </tr>
                    <tr>
                        <td
                            colspan="5"
                            class="bg-slate-50/70 px-3 pb-2">
                            <details>
                                <summary class="cursor-pointer py-1.5 text-sm font-medium text-blue-700">
                                    @DashboardLocalizer["WorkspaceMoney_ProjectBreakdown"]
                                </summary>
                                <div class="grid gap-4 pb-2 lg:grid-cols-2">
                                    <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
                                        <table class="min-w-full text-sm">
                                            <thead class="bg-slate-50 text-xs text-slate-500">
                                                <tr>
                                                    <th class="px-3 py-2 text-left">@DashboardLocalizer["Project"]</th>
                                                    <th class="px-3 py-2 text-right">@DashboardLocalizer["Hours"]</th>
                                                    <th class="px-3 py-2 text-right">@DashboardLocalizer["Earned"]</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var project in item.Projects)
                                                {
                                                    <tr class="border-t border-slate-100">
                                                        <td class="px-3 py-2">@project.Project.Name</td>
                                                        <td class="px-3 py-2 text-right">@project.Duration.ToReadableShortString()</td>
                                                        <td class="px-3 py-2 text-right">
                                                            <AmountDisplay Amount="@project.Earned"/>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <dl class="rounded-lg border border-slate-200 bg-white p-4 text-sm">
                                        <dt class="font-semibold text-slate-700">@DashboardLocalizer["WorkspaceMoney_PaymentSummary"]</dt>
                                        <div class="mt-3 flex justify-between">
                                            <dt class="text-slate-500">@DashboardLocalizer["Received"]</dt>
                                            <dd class="font-semibold text-emerald-700">
                                                <AmountDisplay Amount="@item.Received"/>
                                            </dd>
                                        </div>
                                        <div class="mt-2 flex justify-between">
                                            <dt class="text-slate-500">@DashboardLocalizer["Balance"]</dt>
                                            <dd class="font-semibold @(item.Outstanding > 0 ? "text-red-700" : "text-emerald-700")">
                                                <AmountDisplay Amount="@item.Outstanding"/>
                                            </dd>
                                        </div>
                                        <div class="mt-2 flex justify-between">
                                            <dt class="text-slate-500">@DashboardLocalizer["LastPayment"]</dt>
                                            <dd class="font-medium text-slate-700">@(item.LastPaymentDate?.ToString("d MMM yyyy") ?? "—")</dd>
                                        </div>
                                        @if (IsCanShareClientReport)
                                        {
                                            <div class="mt-4 flex justify-start border-t border-slate-100 pt-3">
                                                <button
                                                    type="button"
                                                    class="inline-flex items-center gap-2 rounded-lg border border-blue-200 bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-700 transition hover:bg-blue-100"
                                                    @onclick="() => OnShareClient.InvokeAsync((item.Client.Id, item.Client.Name))">
                                                    <i class="fa-solid fa-link"></i>
                                                    @DashboardLocalizer["ClientShareReport_Open"]
                                                </button>
                                            </div>
                                        }
                                    </dl>
                                </div>
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public EventCallback<(Guid ClientId, string ClientName)> OnShareClient { get; set; }

    private bool IsCanShareClientReport => AuthState.Value.Workspace?.IsWorkspaceAdmin == true;
}
