@using LumexUI.Common
<AppTabs
    Size="ComponentSize.Medium">
    <AppTab
        Title="@DashboardLocalizer["WorkspaceMoney_ClientBalancesTab"]">
        <ClientBalancesTabBlock
            OnShareClient="OnShareClient" />
    </AppTab>
    <AppTab
        Title="@DashboardLocalizer["WorkspaceMoney_TeamSettlementsTab"]">
        <TeamSettlementsTabBlock />
    </AppTab>
    <AppTab
        Title="@DashboardLocalizer["WorkspaceMoney_ProjectProfitabilityTab"]">
        <ProjectProfitabilityTabBlock />
    </AppTab>
</AppTabs>

<LumexTabs
    Size="Size.Large"
    Variant="TabVariant.Outlined"
    Color="ThemeColor.Primary"
    FullWidth="true">
    <LumexTab Title="@DashboardLocalizer["WorkspaceMoney_ClientBalancesTab"]">
        <ClientBalancesTabBlock OnShareClient="OnShareClient"/>
    </LumexTab>
    <LumexTab Title="@DashboardLocalizer["WorkspaceMoney_TeamSettlementsTab"]">
        <TeamSettlementsTabBlock/>
    </LumexTab>
    <LumexTab Title="@DashboardLocalizer["WorkspaceMoney_ProjectProfitabilityTab"]">
        <ProjectProfitabilityTabBlock/>
    </LumexTab>
</LumexTabs>

@code {
    [Parameter]
    public EventCallback<(Guid ClientId, string ClientName)> OnShareClient { get; set; }
}
