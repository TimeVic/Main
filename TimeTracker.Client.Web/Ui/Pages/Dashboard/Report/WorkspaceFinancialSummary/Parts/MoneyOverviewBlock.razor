@using Fluxor
@using TimeTracker.Api.Shared.Dto.Model.Report.WorkspaceFinancialSummary
@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Report
@using TimeTracker.Client.Core.Store.Report
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Report.Summary.Parts
@using TimeTracker.Client.Web.Ui.Shared.Components

@inherits BaseReactiveComponent
@inject IState<ReportsState> ReportsState

<section class="@Class">
    <h2 class="mb-4 text-base font-semibold text-slate-700">@DashboardLocalizer["MoneyOverview"]</h2>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <SummaryMetricCard
            Title="@DashboardLocalizer["MoneyOverviewBlock_ClientEarned"].Value"
            HelperText="@DashboardLocalizer["TotalEarnedHelper"].Value"
            TooltipText="@DashboardLocalizer["TotalEarnedHelper"].Value"
            Variant="neutral"
            IconClass="fa-solid fa-file-invoice-dollar">
            <Value>
                <AmountDisplay Amount="@(_totals?.ClientEarned ?? 0)"/>
            </Value>
        </SummaryMetricCard>

        <SummaryMetricCard
            Title="@DashboardLocalizer["MoneyOverviewBlock_ClientReceived"].Value"
            HelperText="@DashboardLocalizer["TotalReceivedHelper"].Value"
            Variant="success"
            IconClass="fa-solid fa-circle-check">
            <Value>
                <AmountDisplay Amount="@(_totals?.ClientReceived ?? 0)"/>
            </Value>
        </SummaryMetricCard>

        <SummaryMetricCard
            Title="@DashboardLocalizer["MoneyOverviewBlock_UnpaidByClients"].Value"
            HelperText="@DashboardLocalizer["OutstandingBalanceHelper"].Value"
            TooltipText="@DashboardLocalizer["ClientBalancesTableBlock_DueTooltip"].Value"
            Variant="@(_totals?.ClientOutstanding > 0 ? "danger" : "neutral")"
            Emphasis="@(_totals?.ClientOutstanding > 0)"
            IconClass="fa-solid fa-triangle-exclamation">
            <Value>
                <AmountDisplay Amount="@(_totals?.ClientOutstanding ?? 0)"/>
            </Value>
        </SummaryMetricCard>

        <SummaryMetricCard
            Title="@DashboardLocalizer["MoneyOverviewBlock_OwnerRevenue"].Value"
            HelperText="@DashboardLocalizer["MoneyOverviewBlock_OwnerRevenueHelper"].Value"
            TooltipText="@DashboardLocalizer["MoneyOverviewBlock_OwnerRevenueTooltip"].Value"
            Variant="@(_totals?.RealizedMargin >= 0 ? "success" : "danger")"
            IconClass="fa-solid fa-chart-line">
            <Value>
                <AmountDisplay Amount="@(_totals?.RealizedMargin ?? 0)"/>
            </Value>
        </SummaryMetricCard>
    </div>

    @if (_totals?.RealizedMargin < 0)
    {
        <div class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
            @DashboardLocalizer["MoneyOverviewBlock_NegativeRevenueWarning"]
        </div>
    }

    @if (_data?.HasMemberPayouts == true)
    {
        <div class="mt-6">
            <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">@DashboardLocalizer["MoneyOverviewBlock_MemberPayouts"]</h3>
            <div class="grid gap-3 md:grid-cols-3">
                <div class="rounded-lg border border-slate-200 bg-white px-4 py-3">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500" title="@DashboardLocalizer["MoneyOverviewBlock_MemberEarningsTooltip"]">@DashboardLocalizer["ProjectProfitabilityTableBlock_MemberEarnings"]</p>
                    <p class="mt-2 text-xl font-semibold text-slate-900"><AmountDisplay Amount="@(_totals?.TeamCost ?? 0)"/></p>
                </div>

                <div class="rounded-lg border border-emerald-100 bg-emerald-50/40 px-4 py-3">
                    <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">@DashboardLocalizer["MoneyOverviewBlock_PaidToMembers"]</p>
                    <p class="mt-2 text-xl font-semibold text-emerald-700"><AmountDisplay Amount="@(_totals?.MemberPaidOut ?? 0)"/></p>
                </div>

                <div class="rounded-lg border @((_totals?.MemberOutstanding ?? 0) > 0 ? "border-red-200 bg-red-50" : "border-slate-200 bg-white") px-4 py-3">
                    <p class="text-xs font-semibold uppercase tracking-wide @((_totals?.MemberOutstanding ?? 0) > 0 ? "text-red-600" : "text-slate-500")">@DashboardLocalizer["MoneyOverviewBlock_OwedToMembers"]</p>
                    <p class="mt-2 text-xl font-semibold @((_totals?.MemberOutstanding ?? 0) > 0 ? "text-red-700" : "text-slate-900")"><AmountDisplay Amount="@(_totals?.MemberOutstanding ?? 0)"/></p>
                </div>
            </div>
        </div>
    }
    
    @if (_totals?.ClientEarned > 0 && _totals?.ClientReceived <= 0)
    {
        <p class="mt-3 text-sm text-slate-500">@DashboardLocalizer["MoneyOverviewBlock_NoClientPayments"]</p>
    }
    @if (_data?.HasMemberPayouts == true && _totals?.TeamCost > 0 && _totals?.MemberPaidOut <= 0)
    {
        <p class="mt-2 text-sm text-slate-500">@DashboardLocalizer["MoneyOverviewBlock_NoMemberPayouts"]</p>
    }
</section>

@code {
    [Parameter]
    public string? Class { get; set; }

    private WorkspaceFinancialSummaryReportResponse? _data
        => ReportsState.Value.WorkspaceFinancialSummaryData;

    private WorkspaceFinancialSummaryTotalsDto? _totals
        => _data?.Totals;
}
