@using Fluxor
@using TimeTracker.Client.Core.Store.Report
@using TimeTracker.Client.Web.Ui.Shared.Components

@inherits BaseReactiveComponent
@inject IState<ReportsState> ReportsState

@{
    var totals = ReportsState.Value.WorkspaceFinancialSummaryData?.Totals;
}

<section class="grid grid-cols-1 gap-4 lg:grid-cols-3">
    <AppCard Class="shadow-sm">
        <AppCardBody Class="p-4">
            <h2 class="text-sm font-semibold text-slate-800">@DashboardLocalizer["WorkspaceMoney_FunnelClientFlow"]</h2>
            <dl class="mt-3.5 space-y-2.5">
                <div class="flex items-center justify-between gap-4">
                    <dt class="text-sm text-slate-500">@DashboardLocalizer["WorkspaceMoney_ClientBillable"]</dt>
                    <dd class="font-semibold text-slate-900">
                        <AmountDisplay Amount="@(totals?.ClientEarned ?? 0)"/>
                    </dd>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <dt class="text-sm text-slate-500">@DashboardLocalizer["WorkspaceMoney_ClientReceived"]</dt>
                    <dd class="font-semibold text-emerald-700">
                        <AmountDisplay Amount="@(totals?.ClientReceived ?? 0)"/>
                    </dd>
                </div>
                <div class="flex items-center justify-between gap-4 rounded-xl bg-red-50 px-3 py-1.5">
                    <dt class="text-sm font-medium text-red-700">@DashboardLocalizer["WorkspaceMoney_ClientDebt"]</dt>
                    <dd class="font-semibold text-red-700">
                        <AmountDisplay Amount="@(totals?.ClientOutstanding ?? 0)"/>
                    </dd>
                </div>
            </dl>
        </AppCardBody>
    </AppCard>

    <AppCard Class="shadow-sm">
        <AppCardBody Class="p-4">
            <h2 class="text-sm font-semibold text-slate-800">@DashboardLocalizer["WorkspaceMoney_FunnelTeamCost"]</h2>
            <dl class="mt-3.5 space-y-2.5">
                <div class="flex items-center justify-between gap-4">
                    <dt class="text-sm text-slate-500">@DashboardLocalizer["WorkspaceMoney_TeamEarnings"]</dt>
                    <dd class="font-semibold text-slate-900">
                        <AmountDisplay Amount="@(totals?.TeamCost ?? 0)"/>
                    </dd>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <dt class="text-sm text-slate-500">@DashboardLocalizer["WorkspaceMoney_PaidToMembers"]</dt>
                    <dd class="font-semibold text-emerald-700">
                        <AmountDisplay Amount="@(totals?.MemberPaidOut ?? 0)"/>
                    </dd>
                </div>
                <div class="flex items-center justify-between gap-4 rounded-xl bg-red-50 px-3 py-1.5">
                    <dt class="text-sm font-medium text-red-700">@DashboardLocalizer["WorkspaceMoney_OwedToMembers"]</dt>
                    <dd class="font-semibold text-red-700">
                        <AmountDisplay Amount="@(totals?.MemberOutstanding ?? 0)"/>
                    </dd>
                </div>
            </dl>
        </AppCardBody>
    </AppCard>

    <AppCard Class="border-emerald-100 bg-emerald-50/40 shadow-sm">
        <AppCardBody Class="p-4">
            <h2 class="text-sm font-semibold text-slate-800">@DashboardLocalizer["WorkspaceMoney_FunnelProfit"]</h2>
            <dl class="mt-3.5 space-y-2.5">
                <div class="flex items-center justify-between gap-4">
                    <dt class="text-sm text-slate-600">@DashboardLocalizer["WorkspaceMoney_ExpectedProfit"]</dt>
                    <dd class="font-semibold @(totals?.EstimatedMargin < 0 ? "text-red-700" : "text-emerald-700")">
                        <AmountDisplay Amount="@(totals?.EstimatedMargin ?? 0)"/>
                    </dd>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <dt class="text-sm text-slate-600">@DashboardLocalizer["WorkspaceMoney_CashProfit"]</dt>
                    <dd class="font-semibold @(totals?.RealizedMargin < 0 ? "text-red-700" : "text-emerald-700")">
                        <AmountDisplay Amount="@(totals?.RealizedMargin ?? 0)"/>
                    </dd>
                </div>
                <div class="flex items-center justify-between gap-4 rounded-xl bg-white px-3 py-1.5">
                    <dt class="text-sm font-medium text-slate-700">@DashboardLocalizer["WorkspaceMoney_Margin"]</dt>
                    <dd class="font-semibold text-slate-900">
                        @(totals?.MarginPercent is null ? "—" : $"{totals.MarginPercent:0.#}%")
                    </dd>
                </div>
            </dl>
        </AppCardBody>
    </AppCard>
</section>
