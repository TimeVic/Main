@using Fluxor
@using TimeTracker.Business.Extensions
@using TimeTracker.Client.Core.Store.Report
@using TimeTracker.Client.Web.Ui.Shared.Components

@inherits BaseReactiveComponent
@inject IState<ReportsState> ReportsState

@{
    var items = ReportsState.Value.WorkspaceFinancialSummaryData?.MemberBalances ?? [];
}

@if (items.Count == 0)
{
    <p class="rounded-xl border border-dashed border-slate-200 bg-slate-50 px-4 py-6 text-sm text-slate-500">
        @DashboardLocalizer["MemberBalancesTableBlock_NoEarningsDescription"]
    </p>
}
else
{
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
        <table class="min-w-[760px] w-full text-sm">
            <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                <tr>
                    <th class="px-3 py-2">@DashboardLocalizer["Member"]</th>
                    <th class="px-3 py-2 text-right">@DashboardLocalizer["Hours"]</th>
                    <th class="px-3 py-2 text-right">@DashboardLocalizer["WorkspaceMoney_TeamEarnings"]</th>
                    <th class="px-3 py-2 text-right">@DashboardLocalizer["WorkspaceMoney_PaidToMembers"]</th>
                    <th class="px-3 py-2 text-right">@DashboardLocalizer["WorkspaceMoney_OwedToMembers"]</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var item in items)
                {
                    <tr class="hover:bg-slate-50/50">
                        <td class="px-3 py-2 font-medium text-slate-800">@item.User.Name</td>
                        <td class="px-3 py-2 text-right text-slate-600">@item.Duration.ToReadableShortString()</td>
                        <td class="px-3 py-2 text-right"><AmountDisplay Amount="@item.Cost"/></td>
                        <td class="px-3 py-2 text-right text-emerald-700"><AmountDisplay Amount="@item.PaidOut"/></td>
                        <td class="px-3 py-2 text-right font-semibold @(item.Owed > 0 ? "text-red-700" : "text-emerald-700")">
                            <AmountDisplay Amount="@item.Owed"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="5" class="border-l-2 border-blue-500 bg-slate-50/60 px-4 py-3 shadow-inner">
                            <details class="group">
                                <summary class="flex cursor-pointer items-center gap-2 py-1 text-sm font-medium text-blue-700 hover:text-blue-800">
                                    <i class="fa-solid fa-chevron-right text-xs transition-transform duration-200 group-open:rotate-90"></i>
                                    <span>@DashboardLocalizer["WorkspaceMoney_ProjectBreakdown"]</span>
                                </summary>
                                @if (item.Projects.Count == 0)
                                {
                                    <p class="mt-2 pb-2 text-sm text-slate-500">@DashboardLocalizer["WorkspaceMoney_NoDetails"]</p>
                                }
                                else
                                {
                                    <div class="mt-2 overflow-x-auto rounded-lg border border-slate-200 bg-white">
                                        <table class="min-w-full text-sm">
                                            <thead class="bg-slate-50 text-xs text-slate-500">
                                                <tr>
                                                    <th class="px-3 py-2 text-left">@DashboardLocalizer["Project"]</th>
                                                    <th class="px-3 py-2 text-left">@DashboardLocalizer["Client"]</th>
                                                    <th class="px-3 py-2 text-right">@DashboardLocalizer["Hours"]</th>
                                                    <th class="px-3 py-2 text-right">@DashboardLocalizer["WorkspaceMoney_TeamEarnings"]</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var project in item.Projects)
                                                {
                                                    <tr class="border-t border-slate-100">
                                                        <td class="px-3 py-2 font-medium text-slate-800">@project.Project.Name</td>
                                                        <td class="px-3 py-2 text-slate-600">@(project.Client?.Name ?? "—")</td>
                                                        <td class="px-3 py-2 text-right font-mono text-xs text-slate-600">@project.Duration.ToReadableShortString()</td>
                                                        <td class="px-3 py-2 text-right font-semibold text-slate-900"><AmountDisplay Amount="@project.Earned"/></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="border-t-2 border-slate-200/80 bg-slate-50 font-semibold text-slate-900">
                <tr>
                    <td class="px-3 py-2.5">@DashboardLocalizer["Total"]</td>
                    <td class="px-3 py-2.5 text-right font-mono text-xs text-slate-900">@items.Aggregate(TimeSpan.Zero, (a, i) => a + i.Duration).ToReadableShortString()</td>
                    <td class="px-3 py-2.5 text-right font-semibold text-slate-900"><AmountDisplay Amount="@items.Sum(i => i.Cost)"/></td>
                    <td class="px-3 py-2.5 text-right font-semibold text-emerald-700"><AmountDisplay Amount="@items.Sum(i => i.PaidOut)"/></td>
                    <td class="px-3 py-2.5 text-right font-semibold @(items.Sum(i => i.Owed) > 0 ? "text-red-700" : "text-emerald-700")">
                        <AmountDisplay Amount="@items.Sum(i => i.Owed)"/>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
}
