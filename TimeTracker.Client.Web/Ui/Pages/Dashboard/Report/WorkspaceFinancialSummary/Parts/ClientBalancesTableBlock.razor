@using Fluxor
@using TimeTracker.Api.Shared.Dto.Model.Report.WorkspaceFinancialSummary
@using TimeTracker.Business.Extensions
@using TimeTracker.Client.Core.Store.Report
@using TimeTracker.Client.Web.Ui.Shared.Components

@inherits BaseReactiveComponent
@inject IState<ReportsState> ReportsState

<section class="@Class">
    <div class="mb-4">
        <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
            <div>
                <h2 class="text-base font-semibold text-slate-700">@DashboardLocalizer["ClientBalancesTableBlock_Title"]</h2>
                <p class="mt-1 text-sm text-slate-500">@DashboardLocalizer["ClientBalancesTableBlock_Description"]</p>
            </div>

            <label class="inline-flex items-center gap-2 text-sm font-medium text-slate-600">
                <input type="checkbox" class="h-4 w-4 rounded border-slate-300" @bind="_showSettledClients"/>
                @DashboardLocalizer["ShowSettledClients"]
            </label>
        </div>
    </div>
    @{
        var allItems = ReportsState.Value.WorkspaceFinancialSummaryData?.ClientBalances ?? [];
        var items = (_showSettledClients ? allItems : allItems.Where(c => c.Outstanding != 0).ToList()).ToList();
    }
    @if (allItems.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 px-4 py-6">
            <p class="text-sm font-medium text-slate-700">@DashboardLocalizer["NoClientBalancesYet"]</p>
            <p class="mt-1 text-sm text-slate-500">@DashboardLocalizer["ClientBalancesTableBlock_NoBalancesDescription"]</p>
        </div>
    }
    else if (items.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 px-4 py-6">
            <p class="text-sm font-medium text-slate-700">@DashboardLocalizer["NoOpenClientBalances"]</p>
            <p class="mt-1 text-sm text-slate-500">@DashboardLocalizer["ClientBalancesTableBlock_NoOpenBalancesDescription"]</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
            <table class="min-w-full text-sm">
                <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
                    <tr>
                        <th class="px-3 py-2 text-left">@DashboardLocalizer["Client"]</th>
                        <th class="px-3 py-2 text-right">@DashboardLocalizer["Hours"]</th>
                        <th class="px-3 py-2 text-right">@DashboardLocalizer["Earned"]</th>
                        <th class="px-3 py-2 text-right">@DashboardLocalizer["Received"]</th>
                        <th class="px-3 py-2 text-right">@DashboardLocalizer["Balance"]</th>
                        <th class="px-3 py-2 text-left">@DashboardLocalizer["Status"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in items)
                    {
                        var status = GetClientStatus(item.Outstanding);
                        <tr class="hover:bg-slate-50/50">
                            <td class="px-3 py-2 font-medium text-slate-800">
                                @(item.Client?.Name ?? DashboardLocalizer["NoClient"].Value)
                            </td>
                            <td class="px-3 py-2 text-right text-slate-600">
                                @item.Duration.ToReadableShortString()
                            </td>
                            <td class="px-3 py-2 text-right">
                                <AmountDisplay Amount="@item.Earned"/>
                            </td>
                            <td class="px-3 py-2 text-right text-emerald-700">
                                <AmountDisplay Amount="@item.Received"/>
                            </td>
                            <td class="px-3 py-2 text-right font-semibold @GetBalanceTextClass(item.Outstanding)">
                                @if (item.Outstanding == 0)
                                {
                                    <span>@DashboardLocalizer["Settled"]</span>
                                }
                                else
                                {
                                    <AmountDisplay Amount="@Math.Abs(item.Outstanding)"/>
                                    <span title="@(item.Outstanding > 0 ? DueTooltip : CreditTooltip)">
                                        @(item.Outstanding > 0 ? DashboardLocalizer["Due"].Value : DashboardLocalizer["Credit"].Value)
                                    </span>
                                }
                            </td>
                            <td class="px-3 py-2">
                                <AppBadge
                                    Color="@status.Color"
                                    Variant="BadgeVariant.Flat"
                                    Size="ComponentSize.Small"
                                    title="@status.Tooltip">
                                    @status.Text
                                </AppBadge>
                            </td>
                        </tr>
                    }
                    <tr class="border-t-2 border-slate-200/80 bg-slate-50 font-semibold text-slate-900">
                        <td class="px-3 py-2">
                            @DashboardLocalizer["Total"]
                        </td>
                        <td class="px-3 py-2 text-right font-mono text-xs text-slate-900">
                            @items.Aggregate(TimeSpan.Zero, (a, i) => a + i.Duration).ToReadableShortString()
                        </td>
                        <td class="px-3 py-2 text-right font-semibold text-slate-900">
                            <AmountDisplay Amount="@items.Sum(i => i.Earned)"/>
                        </td>
                        <td class="px-3 py-2 text-right text-emerald-700">
                            <AmountDisplay Amount="@items.Sum(i => i.Received)"/>
                        </td>
                        <td class="px-3 py-2 text-right @GetBalanceTextClass(items.Sum(i => i.Outstanding))">
                            <AmountDisplay Amount="@items.Sum(i => i.Outstanding)"/>
                        </td>
                        <td class="px-3 py-2"></td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Parameter]
    public string? Class { get; set; }

    private string DueTooltip => DashboardLocalizer["ClientBalancesTableBlock_DueTooltip"].Value;

    private string CreditTooltip => DashboardLocalizer["ClientBalancesTableBlock_CreditTooltip"].Value;

    private bool _showSettledClients;

    private static string GetBalanceTextClass(decimal balance)
    {
        if (balance > 0) return "text-red-700";
        if (balance < 0) return "text-blue-700";
        return "text-emerald-700";
    }

    private (string Text, ComponentColor Color, string Tooltip) GetClientStatus(decimal balance)
    {
        if (balance > 0) return (DashboardLocalizer["Due"].Value, ComponentColor.Danger, DueTooltip);
        if (balance < 0) return (DashboardLocalizer["Credit"].Value, ComponentColor.Primary, CreditTooltip);
        return (DashboardLocalizer["Settled"].Value, ComponentColor.Success, DashboardLocalizer["ClientBalancesTableBlock_SettledTooltip"].Value);
    }
}
