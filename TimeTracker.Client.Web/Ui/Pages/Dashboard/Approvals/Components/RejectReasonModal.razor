@using Microsoft.AspNetCore.Components.Forms
@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.TimeEntry.Approval
@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Validation
@inherits BaseReactiveComponent

<AppModalHeader Class="flex items-center gap-3">
    <div class="flex items-start gap-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-amber-50 text-amber-600">
            <i class="fa-solid fa-triangle-exclamation text-xl"></i>
        </div>
        <div>
            <h3 class="text-xl font-semibold text-slate-900">@DashboardLocalizer["Approvals_RejectModal_Title"]</h3>
            <p class="mt-1 text-sm text-slate-500">@DashboardLocalizer["Approvals_Description"]</p>
        </div>
    </div>
</AppModalHeader>
<AppModalBody Class="space-y-4 pt-3">
    <EditForm
        Context="form"
        Model="@_model"
        OnValidSubmit="@OnValidSubmit"
        @ref="_editForm">
        <DataAnnotationsValidator />
        <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">@DashboardLocalizer["Submit"]</button>

        <div>
            <InputTextareaField
                Required="true"
                Label="@DashboardLocalizer["Approvals_RejectModal_ReasonLabel"].Value"
                Placeholder="@DashboardLocalizer["Approvals_RejectModal_ReasonPlaceholder"].Value"
                @bind-Value="_model.Reason" />
            <CustomValidationMessage For="@(() => _model.Reason)" />
        </div>
    </EditForm>
</AppModalBody>
<AppModalFooter>
    <AppButton
        FullWidth="@true"
        OnClick="@OnCancelClicked"
        Color="@ComponentColor.Default"
        Variant="@ButtonVariant.Outlined"
        Radius="@ButtonRadius.Medium">
        @DashboardLocalizer["Cancel"]
    </AppButton>
    <AppButton
        FullWidth="@true"
        OnClick="@Submit"
        Color="@ComponentColor.Danger"
        Variant="@ButtonVariant.Solid"
        Radius="@ButtonRadius.Medium"
        Disabled="@string.IsNullOrWhiteSpace(_model.Reason)">
        @DashboardLocalizer["Approvals_RejectModal_Confirm"]
    </AppButton>
</AppModalFooter>
