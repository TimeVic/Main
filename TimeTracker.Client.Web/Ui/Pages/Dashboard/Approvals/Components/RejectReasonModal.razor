@using Microsoft.AspNetCore.Components.Forms
@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.TimeEntry.Approval
@inherits BaseReactiveComponent

<AppModalHeader
    Title="@DashboardLocalizer["Approvals_RejectModal_Title"]"
    Description="@DashboardLocalizer["Approvals_Description"]"
    Icon="fa-solid fa-triangle-exclamation"
    Color="ComponentColor.Warning" />
<AppModalBody Class="space-y-4 pt-3">
    <EditForm
        Context="form"
        Model="@_model"
        OnValidSubmit="@OnValidSubmit"
        @ref="_editForm">
        <DataAnnotationsValidator />
        <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">@DashboardLocalizer["Submit"]</button>

        <div>
            <InputTextareaField
                Required="true"
                Label="@DashboardLocalizer["Approvals_RejectModal_ReasonLabel"].Value"
                Placeholder="@DashboardLocalizer["Approvals_RejectModal_ReasonPlaceholder"].Value"
                @bind-Value="_model.Reason" />
        </div>
    </EditForm>
</AppModalBody>
<AppModalFooter>
    <AppButton
        FullWidth="@true"
        OnClick="@OnCancelClicked"
        Color="@ComponentColor.Default"
        Variant="@ButtonVariant.Outlined"
        Radius="@ButtonRadius.Medium">
        @DashboardLocalizer["Cancel"]
    </AppButton>
    <AppButton
        FullWidth="@true"
        OnClick="@Submit"
        Color="@ComponentColor.Danger"
        Variant="@ButtonVariant.Solid"
        Radius="@ButtonRadius.Medium"
        Disabled="@string.IsNullOrWhiteSpace(_model.Reason)">
        @DashboardLocalizer["Approvals_RejectModal_Confirm"]
    </AppButton>
</AppModalFooter>
