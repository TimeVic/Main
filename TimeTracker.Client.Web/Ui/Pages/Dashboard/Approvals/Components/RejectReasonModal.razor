@using LumexUI
@using LumexUI.Common
@using Microsoft.AspNetCore.Components.Forms
@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.TimeEntry.Approval
@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Validation
@inherits BaseReactiveComponent

@if (IsOpened)
{
    <LumexModal
        Open="true"
        Size="ModalSize.Small"
        OnClose="@OnCancelClicked"
        @ref="_modal">
        <LumexModalContent>
            <LumexModalHeader Class="flex items-center gap-3">
                <div class="flex items-start gap-4">
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-amber-50 text-amber-600">
                        <i class="fa-solid fa-triangle-exclamation text-xl"></i>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold text-slate-900">@DashboardLocalizer["Approvals_RejectModal_Title"]</h3>
                        <p class="mt-1 text-sm text-slate-500">@DashboardLocalizer["Approvals_Description"]</p>
                    </div>
                </div>
            </LumexModalHeader>
            <LumexModalBody Class="space-y-4 pt-3">
                <EditForm
                    Context="form"
                    Model="@_model"
                    OnValidSubmit="@OnValidSubmit"
                    @ref="_editForm">
                    <DataAnnotationsValidator />
                    <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">@DashboardLocalizer["Submit"]</button>

                    <div>
                        <div class="mb-1.5 flex items-center justify-between">
                            <label class="block text-xs font-semibold uppercase tracking-wide text-slate-700">
                                @DashboardLocalizer["Approvals_RejectModal_ReasonLabel"]
                                <span class="text-red-500">*</span>
                            </label>
                            <span class="text-2xs text-slate-400">
                                @((_model.Reason?.Length ?? 0))/500
                            </span>
                        </div>
                        <InputTextArea
                            class="w-full rounded-xl border border-slate-200 bg-white p-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100"
                            rows="3"
                            maxlength="500"
                            placeholder="@DashboardLocalizer["Approvals_RejectModal_ReasonPlaceholder"].Value"
                            @bind-Value="_model.Reason" />
                        <CustomValidationMessage For="@(() => _model.Reason)" />
                    </div>
                </EditForm>
            </LumexModalBody>
            <LumexModalFooter>
                <CustomButton
                    FullWidth="@true"
                    OnClick="@OnCancelClicked"
                    Color="@ThemeColor.Default"
                    Variant="Variant.Outlined"
                    Radius="@Radius.Medium">
                    @DashboardLocalizer["Cancel"]
                </CustomButton>
                <CustomButton
                    FullWidth="@true"
                    OnClick="@Submit"
                    Color="@ThemeColor.Danger"
                    Variant="Variant.Solid"
                    Radius="@Radius.Medium"
                    Disabled="@string.IsNullOrWhiteSpace(_model.Reason)">
                    @DashboardLocalizer["Approvals_RejectModal_Confirm"]
                </CustomButton>
            </LumexModalFooter>
        </LumexModalContent>
    </LumexModal>
}
