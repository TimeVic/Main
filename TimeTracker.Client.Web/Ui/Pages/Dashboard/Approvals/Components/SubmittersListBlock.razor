@using LumexUI
@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Model.TimeEntry.Approval
@using TimeTracker.Business.Common.Constants
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Report.Shared
@inherits BaseReactiveComponent

<div class="flex h-full flex-col border-r border-slate-200 bg-slate-50/50">
    @* Search header *@
    <div class="border-b border-slate-200 bg-white p-3">
        <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                <i class="fa-solid fa-magnifying-glass text-xs"></i>
            </div>
            <input
                type="text"
                class="w-full rounded-xl border border-slate-200 bg-slate-50 py-1.5 pl-8 pr-3 text-xs text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-100"
                placeholder="@DashboardLocalizer["Search"].Value"
                @bind="_searchQuery"
                @bind:event="oninput" />
        </div>
    </div>

    @* Submitters list *@
    <div class="flex-1 overflow-y-auto p-2 space-y-1.5">
        @if (IsLoading)
        {
            <div class="flex justify-center py-8">
                <LumexSpinner Size="Size.Small" />
            </div>
        }
        else if (!FilteredSubmitters.Any())
        {
            <div class="rounded-xl border border-dashed border-slate-200 bg-white p-6 text-center">
                <div class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                    <i class="fa-solid fa-clipboard-check text-base"></i>
                </div>
                <p class="text-xs font-semibold text-slate-700">@DashboardLocalizer["Approvals_EmptySubmitters"]</p>
            </div>
        }
        else
        {
            @foreach (var submitter in FilteredSubmitters)
            {
                var isSelected = SelectedSubmitter != null
                    && SelectedSubmitter.UserId == submitter.UserId
                    && SelectedSubmitter.PeriodStartDate == submitter.PeriodStartDate;

                <div
                    @key="@($"{submitter.UserId}_{submitter.PeriodStartDate:yyyyMMdd}")"
                    class="@GetCardClasses(isSelected)"
                    @onclick="@(() => OnSelectSubmitter(submitter))">
                    
                    <div class="flex items-start justify-between gap-2">
                        <div class="flex items-center gap-2.5 min-w-0">
                            @* Status Indicator Dot (always Pending) *@
                            <span class="relative flex h-2.5 w-2.5 shrink-0" title="@DashboardLocalizer["Approvals_Status_Pending"]">
                                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75"></span>
                                <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-amber-500"></span>
                            </span>

                            @* Name and Email *@
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-xs font-semibold @(isSelected ? "text-blue-950 font-bold" : "text-slate-900")">
                                    @submitter.UserName
                                    @if (submitter.IsCurrentUser)
                                    {
                                        <span class="ml-1 rounded bg-blue-100 px-1 py-0.2 text-3xs font-semibold text-blue-700">@DashboardLocalizer["Approvals_CurrentUserBadge"]</span>
                                    }
                                </p>
                            </div>
                        </div>

                        @* Duration *@
                        <span class="shrink-0 font-mono text-2xs font-semibold text-slate-700">
                            @_timeParsingService.TimeSpanToTimeString(submitter.TotalDuration, true)
                        </span>
                    </div>

                    <div class="mt-2 flex items-center justify-between text-2xs text-slate-500">
                        <span class="font-medium">
                            @GetPeriodLabel(submitter)
                        </span>
                        <span class="font-bold text-slate-900">
                            <AmountDisplay Amount="@submitter.TotalDeveloperAmount" />
                        </span>
                    </div>
                </div>
            }
        }
    </div>
</div>
