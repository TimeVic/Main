@page "/workspace/{WorkspaceId:guid}/choose-mode"
@page "/workspace/choose-mode"
@page "/board/{WorkspaceId:guid}/workspace/choose-mode"
@page "/board/workspace/choose-mode"
@using LumexUI
@using TimeTracker.Business.Common.Constants
@using TimeTracker.Client.Web.Ui.Shared.Components
@using Layout = TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Layout

@inherits BaseReactiveComponent
@layout Layout

<div class="mx-auto max-w-5xl py-8 px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
        <h1 class="text-3xl font-extrabold text-slate-900 sm:text-4xl">
            @DashboardLocalizer["ChooseWorkspaceModePage_Title"]
        </h1>
        <p class="mt-3 text-base text-slate-600 sm:text-lg">
            @DashboardLocalizer["ChooseWorkspaceModePage_Subtitle"]
        </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
        <!-- Solo Mode Card -->
        <div class="relative flex flex-col justify-between rounded-3xl border-2 border-slate-200 bg-white p-8 shadow-sm transition-all duration-200 hover:border-blue-500 hover:shadow-md">
            <div>
                <div class="flex items-center gap-4 mb-6">
                    <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-blue-600 text-2xl">
                        <i class="fa-solid fa-user"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-slate-900">
                            @DashboardLocalizer["ChooseWorkspaceModePage_SoloTitle"]
                        </h2>
                        <p class="text-sm text-slate-500">
                            Solo Mode
                        </p>
                    </div>
                </div>

                <p class="text-sm font-medium text-slate-700 mb-6">
                    @DashboardLocalizer["ChooseWorkspaceModePage_SoloDescription"]
                </p>

                <ul class="space-y-3 text-sm text-slate-600 mb-8">
                    <li class="flex items-start gap-3">
                        <i class="fa-solid fa-check text-blue-500 mt-1 shrink-0"></i>
                        <span>@DashboardLocalizer["ChooseWorkspaceModePage_SoloFeature1"]</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <i class="fa-solid fa-check text-blue-500 mt-1 shrink-0"></i>
                        <span>@DashboardLocalizer["ChooseWorkspaceModePage_SoloFeature2"]</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <i class="fa-solid fa-check text-blue-500 mt-1 shrink-0"></i>
                        <span>@DashboardLocalizer["ChooseWorkspaceModePage_SoloFeature3"]</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <i class="fa-solid fa-check text-blue-500 mt-1 shrink-0"></i>
                        <span>@DashboardLocalizer["ChooseWorkspaceModePage_SoloFeature4"]</span>
                    </li>
                </ul>
            </div>

            <button
                type="button"
                disabled="@_isLoading"
                @onclick="() => SelectModeAsync(WorkspaceMode.Solo)"
                class="w-full inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-6 py-3.5 text-base font-semibold text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50">
                @if (_isLoading && _selectedMode == WorkspaceMode.Solo)
                {
                    <LumexSpinner Size="LumexUI.Common.Size.Small" />
                }
                else
                {
                    <i class="fa-solid fa-arrow-right"></i>
                }
                <span>@DashboardLocalizer["ChooseWorkspaceModePage_ChooseSolo"]</span>
            </button>
        </div>

        <!-- Team Mode Card -->
        <div class="relative flex flex-col justify-between rounded-3xl border-2 border-slate-200 bg-white p-8 shadow-sm transition-all duration-200 hover:border-indigo-500 hover:shadow-md">
            <div>
                <div class="flex items-center gap-4 mb-6">
                    <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 text-2xl">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-slate-900">
                            @DashboardLocalizer["ChooseWorkspaceModePage_TeamTitle"]
                        </h2>
                        <p class="text-sm text-slate-500">
                            Team Mode
                        </p>
                    </div>
                </div>

                <p class="text-sm font-medium text-slate-700 mb-6">
                    @DashboardLocalizer["ChooseWorkspaceModePage_TeamDescription"]
                </p>

                <ul class="space-y-3 text-sm text-slate-600 mb-8">
                    <li class="flex items-start gap-3">
                        <i class="fa-solid fa-check text-indigo-500 mt-1 shrink-0"></i>
                        <span>@DashboardLocalizer["ChooseWorkspaceModePage_TeamFeature1"]</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <i class="fa-solid fa-check text-indigo-500 mt-1 shrink-0"></i>
                        <span>@DashboardLocalizer["ChooseWorkspaceModePage_TeamFeature2"]</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <i class="fa-solid fa-check text-indigo-500 mt-1 shrink-0"></i>
                        <span>@DashboardLocalizer["ChooseWorkspaceModePage_TeamFeature3"]</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <i class="fa-solid fa-check text-indigo-500 mt-1 shrink-0"></i>
                        <span>@DashboardLocalizer["ChooseWorkspaceModePage_TeamFeature4"]</span>
                    </li>
                </ul>
            </div>

            <button
                type="button"
                disabled="@_isLoading"
                @onclick="() => SelectModeAsync(WorkspaceMode.Team)"
                class="w-full inline-flex items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-6 py-3.5 text-base font-semibold text-white transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:opacity-50">
                @if (_isLoading && _selectedMode == WorkspaceMode.Team)
                {
                    <LumexSpinner Size="LumexUI.Common.Size.Small" />
                }
                else
                {
                    <i class="fa-solid fa-arrow-right"></i>
                }
                <span>@DashboardLocalizer["ChooseWorkspaceModePage_ChooseTeam"]</span>
            </button>
        </div>
    </div>

    <div class="mt-8 text-center text-xs text-slate-500 max-w-2xl mx-auto">
        @DashboardLocalizer["ChooseWorkspaceModePage_Note"]
    </div>
</div>
