@using TimeTracker.Business.Common.Constants

@inherits BaseReactiveComponent

<div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-xs sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white text-xl shadow-xs">
                @if (Mode == WorkspaceMode.Solo)
                {
                    <span>🧘</span>
                }
                else
                {
                    <span>👥</span>
                }
            </div>
            <div>
                <h3 class="text-base font-bold text-slate-900">
                    @DashboardLocalizer["WorkspaceModeInfoCard_Title"]
                </h3>
            </div>
        </div>
        <div>
            @if (Mode == WorkspaceMode.Solo)
            {
                <span class="inline-flex items-center gap-1.5 rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">
                    @DashboardLocalizer["WorkspaceModeInfoCard_Badge_Solo"]
                </span>
            }
            else
            {
                <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
                    @DashboardLocalizer["WorkspaceModeInfoCard_Badge_Team"]
                </span>
            }
        </div>
    </div>

    <div class="mt-4 text-sm leading-relaxed text-slate-600">
        @if (Mode == WorkspaceMode.Solo)
        {
            <p>
                @DashboardLocalizer["WorkspaceModeInfoCard_Description_Solo"]
            </p>
        }
        else
        {
            <p>
                @DashboardLocalizer["WorkspaceModeInfoCard_Description_Team"]
            </p>
        }
    </div>

    <div class="mt-4 border-t border-slate-200/80 pt-4">
        @if (Mode == WorkspaceMode.Solo)
        {
            <div class="text-xs text-slate-600 sm:text-sm">
                <span class="font-semibold text-slate-900">
                    @DashboardLocalizer["WorkspaceModeInfoCard_Cta_Solo_Prefix"]
                </span>
                <span>
                    @DashboardLocalizer["WorkspaceModeInfoCard_Cta_Solo_Text"]
                </span>
                <button
                    type="button"
                    class="font-semibold text-blue-600 hover:text-blue-700 hover:underline focus:outline-none"
                    @onclick="HandleCreateWorkspaceClick">
                    @DashboardLocalizer["WorkspaceModeInfoCard_Cta_Solo_Link"]
                </button>
            </div>
        }
        else
        {
            <div class="text-xs text-slate-500">
                <span class="font-semibold text-slate-800">
                    @DashboardLocalizer["WorkspaceModeInfoCard_Note_Team_Prefix"]
                </span>
                <span>
                    @DashboardLocalizer["WorkspaceModeInfoCard_Note_Team_Text"]
                </span>
                <button
                    type="button"
                    class="font-semibold text-blue-600 hover:text-blue-700 hover:underline focus:outline-none"
                    @onclick="HandleCreateWorkspaceClick">
                    @DashboardLocalizer["WorkspaceModeInfoCard_Note_Team_Link"]
                </button>
            </div>
        }
    </div>
</div>

