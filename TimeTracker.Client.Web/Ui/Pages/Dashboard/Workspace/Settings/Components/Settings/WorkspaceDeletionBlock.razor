@using LumexUI.Common

@inherits BaseReactiveComponent

@if (IsDeletionAvailable)
{

    <AppCard>
        <AppCardHeader>
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-red-700">@DashboardLocalizer["WorkspaceDeletionBlock_DangerZone"]</p>
                <h2 class="mt-2 text-lg font-semibold text-slate-900">@DashboardLocalizer["WorkspaceDeletionBlock_Title"]</h2>
                <p class="mt-1 text-sm text-slate-600">@DashboardLocalizer["WorkspaceDeletionBlock_Description"]</p>
            </div>
        </AppCardHeader>
        <AppCardFooter>
            <AppButton
                Color="ComponentColor.Danger"
                Variant="ButtonVariant.Outlined"
                OnClick="@OpenConfirmation">
                <StartContent>
                    <i class="fa-regular fa-trash-can"></i>
                </StartContent>
                <ChildContent>
                    @DashboardLocalizer["WorkspaceDeletionBlock_DeleteWorkspace"]
                </ChildContent>
            </AppButton>
        </AppCardFooter>
    </AppCard>
}
