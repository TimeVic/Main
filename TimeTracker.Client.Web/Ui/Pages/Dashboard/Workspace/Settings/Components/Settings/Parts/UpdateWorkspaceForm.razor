@using TimeTracker.Business.Common.Constants
@using TimeTracker.Client.Core.Constants.Ui
@inherits BaseReactiveComponent

<div class="w-full">
    <EditForm 
        Model="model"
        @ref="_form"
        class="mt-2 space-y-6">
        <DataAnnotationsValidator />
    
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
            <div>
                <InputTextField 
                    Label="@DashboardLocalizer["UpdateWorkspaceForm_WorkspaceName"]"
                    FullWidth="true"
                    IsShowEmojiButton="true"
                    @bind-Value="model.Name"/>
            </div>

            <div>
                <TimeZonesSelect 
                    Label="@DashboardLocalizer["UpdateWorkspaceForm_TimeZone"]"
                    IsRequired="true"
                    @bind-Value="model.TimeZone" />
            </div>
            
            <div>
                <CurrenciesSelect 
                    Label="@DashboardLocalizer["Currency"]"
                    Value="@model.CurrencyId"
                    SelectedItemChanged="@OnSelectedCurrency" />
            </div>
        </div>

        <div>
            <InputTextareaField
                Label="@DashboardLocalizer["Description"].Value"
                @bind-Value="model.Description"/>
        </div>

        <div class="flex justify-end pt-2">
            <AppButton
                Class="w-full sm:w-auto sm:min-w-[200px]"
                Color="ComponentColor.Primary"
                Variant="ButtonVariant.Solid"
                OnClick="@OnSave">
                <StartContent>
                    <i class="fa-regular fa-floppy-disk"></i>
                </StartContent>
                <ChildContent>
                    @DashboardLocalizer["UpdateWorkspaceForm_SaveSettings"]
                </ChildContent>
            </AppButton>
        </div>
    </EditForm>
</div>
