@using LumexUI.Common
@using TimeTracker.Client.Core.Constants.Ui
@inherits BaseReactiveComponent

<div class="max-w-xl space-y-4">
    <EditForm 
        Model="model"
        @ref="_form"
        class="mt-2 space-y-4">
        <DataAnnotationsValidator />
    
        <div>
            <InputTextField 
                Label="@DashboardLocalizer["UpdateWorkspaceForm_WorkspaceName"]"
                FullWidth="true"
                IsShowEmojiButton="true"
                @bind-Value="model.Name"/>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <LumexSelect 
                TValue="string"
                Label="@DashboardLocalizer["UpdateWorkspaceForm_TimeZone"]"
                LabelPlacement="@LabelPlacement.Outside"
                Variant="InputVariant.Outlined"
                Required="true"
                @bind-Value="model.TimeZone">
                @foreach (var timeZone in _timeZones)
                {
                    <LumexSelectItem @key="@timeZone.Id" Value="@timeZone.Id">
                        @timeZone.DisplayName
                    </LumexSelectItem>
                }
            </LumexSelect>
            
            <CurrenciesSelect 
                Label="@DashboardLocalizer["Currency"]"
                Value="@model.CurrencyId"
                SelectedItemChanged="@OnSelectedCurrency" />
        </div>
        <div>
            <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">
                @DashboardLocalizer["Description"]
            </label>
            <InputTextArea
                @bind-Value="model.Description"
                class="min-h-[120px] w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-700 focus:border-blue-500 focus:outline-none"/>
        </div>
    </EditForm>

    <div class="flex justify-end pt-2">
        <CustomButton
            Color="ThemeColor.Primary"
            Variant="Variant.Solid"
            OnClick="@OnSave">
            <StartContent>
                <i class="fa-regular fa-floppy-disk"></i>
            </StartContent>
            <ChildContent>
                @DashboardLocalizer["UpdateWorkspaceForm_SaveSettings"]
            </ChildContent>
        </CustomButton>
    </div>
</div>
