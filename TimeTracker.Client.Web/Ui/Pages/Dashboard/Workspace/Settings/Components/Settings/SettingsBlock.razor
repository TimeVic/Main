@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Workspace.Components
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Workspace.Settings.Components.Settings
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Workspace.Settings.Components.Settings.Parts

@inherits BaseReactiveComponent

<section class="space-y-6">
    <WorkspaceModeInfoBlock OnCreateWorkspaceClicked="@(() => _isShowAddWorkspaceModal = true)" />

    <LumexCard>
        <LumexCardHeader>
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-blue-700">@DashboardLocalizer["SettingsBlock_General"]</p>
                <h2 class="mt-2 text-lg font-semibold text-slate-900">@DashboardLocalizer["SettingsBlock_WorkspaceProfileTitle"]</h2>
                <p class="mt-1 text-sm text-slate-600">@DashboardLocalizer["SettingsBlock_Description"]</p>
            </div>
        </LumexCardHeader>
        <LumexCardBody>
            <div>
                @if (_workspace != null)
                {
                    <p class="text-xs font-semibold uppercase tracking-[0.25em] ">@DashboardLocalizer["CurrentWorkspace"]</p>
                    <div class="mt-2 flex flex-wrap items-center gap-3">
                        <h2 class="text-2xl font-semibold">@_workspace.Name</h2>
                        @if (_workspace.IsDefault)
                        {
                            <span class="rounded-full border border-white/20 bg-white/15 px-3 py-1 text-xs font-semibold text-white">@DashboardLocalizer["SettingsBlock_DefaultWorkspace"]</span>
                        }
                    </div>
                    if (!string.IsNullOrEmpty(_workspace.Description))
                    {
                        <p class="mt-2 max-w-2xl text-sm text-blue-100">@_workspace.Description</p>
                    }
                }
            </div>
        </LumexCardBody>
    </LumexCard>
    
    <LumexCard>
        <LumexCardBody>
            @if (_workspaceState.Value.List.Any())
            {
                <UpdateWorkspaceForm></UpdateWorkspaceForm>
            }
        </LumexCardBody>
    </LumexCard>

    <WorkspaceDeletionBlock></WorkspaceDeletionBlock>

    <AddWorkspaceModal
        IsOpened="_isShowAddWorkspaceModal"
        IsOpenedChanged="@((isOpened) => _isShowAddWorkspaceModal = isOpened)" />
</section>
