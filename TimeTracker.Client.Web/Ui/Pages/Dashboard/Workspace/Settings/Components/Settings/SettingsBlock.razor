@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Modals
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Workspace.Settings.Components.Settings
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Workspace.Settings.Components.Settings.Parts

@inherits BaseReactiveComponent

<section class="space-y-6">
    <WorkspaceModeInfoBlock OnCreateWorkspaceClicked="@OpenAddWorkspaceModal" />

    <AppCard>
        <AppCardHeader>
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-blue-700">@DashboardLocalizer["SettingsBlock_General"]</p>
                <h2 class="mt-2 text-lg font-semibold text-slate-900">@DashboardLocalizer["SettingsBlock_WorkspaceProfileTitle"]</h2>
                <p class="mt-1 text-sm text-slate-600">@DashboardLocalizer["SettingsBlock_Description"]</p>
            </div>
        </AppCardHeader>
        <AppCardBody>
            <div>
                @if (_workspace != null)
                {
                    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-400">@DashboardLocalizer["CurrentWorkspace"]</p>
                    <div class="mt-2 flex flex-wrap items-center gap-3">
                        <h2 class="text-2xl font-semibold text-slate-900">@_workspace.Name</h2>
                        @if (_workspace.IsDefault)
                        {
                            <span class="rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">@DashboardLocalizer["SettingsBlock_DefaultWorkspace"]</span>
                        }
                    </div>
                    if (!string.IsNullOrEmpty(_workspace.Description))
                    {
                        <p class="mt-2 max-w-2xl text-sm text-slate-600">@_workspace.Description</p>
                    }
                }
            </div>
        </AppCardBody>
    </AppCard>
    
    <AppCard>
        <AppCardBody>
            @if (_workspaceState.Value.List.Any())
            {
                <UpdateWorkspaceForm></UpdateWorkspaceForm>
            }
        </AppCardBody>
    </AppCard>

    <WorkspaceDeletionBlock></WorkspaceDeletionBlock>
</section>
