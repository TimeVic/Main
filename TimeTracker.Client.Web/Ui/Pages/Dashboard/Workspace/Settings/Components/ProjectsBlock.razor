@using Microsoft.AspNetCore.Components.QuickGrid
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Workspace.Settings.Components.Clients.Parts

@inherits BaseReactiveComponent

<section
    class="space-y-6">
    <AppCard>
        <AppCardBody>
            <div
                class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                <div>
                    <p
                        class="text-xs font-semibold uppercase tracking-[0.25em] text-blue-700">
                        @DashboardLocalizer["Projects"]
                    </p>
                    <h2
                        class="mt-2 text-lg font-semibold text-slate-900">
                        @DashboardLocalizer["ProjectsBlock_WorkspaceProjectsTitle"]
                    </h2>
                    <p
                        class="mt-1 text-sm text-slate-600">
                        @DashboardLocalizer["ProjectsBlock_Description"]
                    </p>
                </div>
                <AppButton
                    Size="ComponentSize.Small"
                    OnClick="@OnAdd"
                    Color="@ComponentColor.Primary"
                    Radius="@ButtonRadius.Full">
                    <StartContent>
                        <i
                            class="fa-solid fa-plus">
                        </i>
                    </StartContent>
                    <ChildContent>
                        @DashboardLocalizer["AddProject"]
                    </ChildContent>
                </AppButton>
            </div>
        </AppCardBody>
    </AppCard>
    
    <AppTable
        TGridItem="ProjectDto"
        Items="@_state.Value.List.AsQueryable()"
        Class="mt-3">
        Items="@_state.Value.List.AsQueryable()">
        <AppPropertyColumn
            TGridItem="ProjectDto"
            TProp="string"
            Title="@DashboardLocalizer["Name"].Value"
            Property="@(p => p.Name)"
            Sortable="true" />
        <AppPropertyColumn
            TGridItem="ProjectDto"
            TProp="bool"
            Title="@DashboardLocalizer["BillableByDefault"].Value"
            Property="@(p => p.IsBillableByDefault)" />
        <AppPropertyColumn
            TGridItem="ProjectDto"
            TProp="decimal?"
            Title="@DashboardLocalizer["DefaultHourlyRate"].Value"
            Property="@(p => p.DefaultHourlyRate)" />
        <AppPropertyColumn
            TGridItem="ProjectDto"
            TProp="string"
            Title="@DashboardLocalizer["Client"].Value"
            Sortable="true"
            Property="@(p => p.Client != null ? p.Client.Name : string.Empty)" />
        <AppTableColumn
            TGridItem="ProjectDto"
            Title="@DashboardLocalizer["Actions"].Value"
            Align="Align.End">
            <div
                class="flex items-center justify-end">
                <AppButton
                    Class="inline-flex rounded-full"
                    OnClick="@(() => OnEdit(context))"
                    Size="ComponentSize.Small"
                    Color="ComponentColor.Primary"
                    Variant="ButtonVariant.Light"
                    IconOnly="true">
                    <ChildContent>
                        <i
                            class="fa-regular fa-pen-to-square">
                        </i>
                    </ChildContent>
                </AppButton>
            </div>
        </AppTableColumn>
    </AppTable>
</section>
