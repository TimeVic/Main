@using LumexUI.Common
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Workspace.Settings.Components.Parts
@using TimeTracker.Client.Web.Ui.Shared.Components.Dialogs

@inherits BaseReactiveComponent

<AddProjectModal
    IsOpened="_isAddProjectModalOpened"
    IsOpenedChanged="isOpened => _isAddProjectModalOpened = isOpened"/>

@if (_projectToUpdate != null)
{
    <UpdateProjectModal 
        Project="_projectToUpdate"
        IsOpened="_projectToUpdate != null" 
        IsOpenedChanged="isOpened => { _projectToUpdate = isOpened ? _projectToUpdate : null; }"/>
}

@if (_projectToDelete != null)
{
    <ConfirmationModal
        Title="@DashboardLocalizer["ProjectsBlock_DeleteProjectTitle"].Value"
        Subtitle="@string.Format(DashboardLocalizer["ProjectsBlock_DeleteProjectSubtitle"].Value, _projectToDelete.Name)"
        ConfirmText="@DashboardLocalizer["Delete"].Value"
        OnClose="@OnCloseDeleteConfirmation"
        OnCancel="@OnCloseDeleteConfirmation"
        OnConfirm="@OnConfirmDelete">
        <ChildContent>
            <p class="text-sm font-medium text-slate-700">
                @DashboardLocalizer["ProjectsBlock_DeleteProjectUnavailableTitle"]
            </p>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-slate-600">
                <li>@DashboardLocalizer["ProjectsBlock_DeleteProjectUnavailableProjects"]</li>
                <li>@DashboardLocalizer["ProjectsBlock_DeleteProjectUnavailableTimeEntries"]</li>
                <li>@DashboardLocalizer["ProjectsBlock_DeleteProjectUnavailableTaskLists"]</li>
                <li>@DashboardLocalizer["ProjectsBlock_DeleteProjectUnavailableTasks"]</li>
                <li>@DashboardLocalizer["ProjectsBlock_DeleteProjectUnavailableClientPayments"]</li>
                <li>@DashboardLocalizer["ProjectsBlock_DeleteProjectUnavailableMemberPayments"]</li>
                <li>@DashboardLocalizer["ProjectsBlock_DeleteProjectUnavailableReports"]</li>
            </ul>
        </ChildContent>
    </ConfirmationModal>
}

<section class="space-y-6">
    <LumexCard>
        <LumexCardBody>
            <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-blue-700">@DashboardLocalizer["Projects"]</p>
                    <h2 class="mt-2 text-lg font-semibold text-slate-900">@DashboardLocalizer["ProjectsBlock_WorkspaceProjectsTitle"]</h2>
                    <p class="mt-1 text-sm text-slate-600">@DashboardLocalizer["ProjectsBlock_Description"]</p>
                </div>
                <CustomButton
                    Size="Size.Small"
                    OnClick="@OnAdd"
                    Color="@ThemeColor.Primary"
                    Radius="@Radius.Full">
                    <StartContent>
                        <i class="fa-solid fa-plus"></i>
                    </StartContent>
                    <ChildContent>
                        @DashboardLocalizer["AddProject"]
                    </ChildContent>
                </CustomButton>
            </div>
        </LumexCardBody>
    </LumexCard>
    
    <LumexDataGrid
        Data="@_state.Value.List.AsQueryable()"
        Radius="@Radius.Medium"
        Class="mt-3">
        <LumexUI.EditColumn
            Title="@DashboardLocalizer["Name"].Value"
            Property="@(p => p.Name)"/>
        <LumexUI.PropertyColumn
            Title="@DashboardLocalizer["BillableByDefault"].Value"
            Property="@(p => p.IsBillableByDefault)"/>
        <LumexUI.PropertyColumn
            Title="@DashboardLocalizer["DefaultHourlyRate"].Value"
            Property="@(p => p.DefaultHourlyRate)"/>
        <LumexUI.PropertyColumn
            Title="@DashboardLocalizer["Client"].Value"
            Sortable="true"
            Property="@(p => p.Client != null ? p.Client.Name : string.Empty)"/>
        <LumexUI.PropertyColumn
            Title="@DashboardLocalizer["Actions"].Value"
            Property="@(p => p.Id)">
            <Content>
                <div class="inline-flex items-center gap-2">
                    <CustomButton
                        Class="inline-flex rounded-full"
                        OnClick="@(() => OnEdit(context))"
                        Size="Size.Small"
                        Color="ThemeColor.Primary"
                        Variant="Variant.Light"
                        IconOnly="true">
                        <ChildContent>
                            <i class="fa-regular fa-pen-to-square"></i>
                        </ChildContent>
                    </CustomButton>
                    <CustomButton
                        Class="inline-flex rounded-full"
                        OnClick="@(() => OnDeleteClicked(context))"
                        Size="Size.Small"
                        Color="ThemeColor.Danger"
                        Variant="Variant.Light"
                        IconOnly="true">
                        <ChildContent>
                            <i class="fa-regular fa-trash-can"></i>
                        </ChildContent>
                    </CustomButton>
                </div>
            </Content>
        </LumexUI.PropertyColumn>
    </LumexDataGrid>
</section>
