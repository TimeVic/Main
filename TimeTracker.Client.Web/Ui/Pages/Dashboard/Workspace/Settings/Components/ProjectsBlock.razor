@using LumexUI.Common
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Workspace.Settings.Components.Clients.Parts

@inherits BaseReactiveComponent



<section class="space-y-6">
    <AppCard>
        <AppCardBody>
            <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-blue-700">@DashboardLocalizer["Projects"]</p>
                    <h2 class="mt-2 text-lg font-semibold text-slate-900">@DashboardLocalizer["ProjectsBlock_WorkspaceProjectsTitle"]</h2>
                    <p class="mt-1 text-sm text-slate-600">@DashboardLocalizer["ProjectsBlock_Description"]</p>
                </div>
                <AppButton
                    Size="ComponentSize.Small"
                    OnClick="@OnAdd"
                    Color="@ComponentColor.Primary"
                    Radius="@ButtonRadius.Full">
                    <StartContent>
                        <i class="fa-solid fa-plus"></i>
                    </StartContent>
                    <ChildContent>
                        @DashboardLocalizer["AddProject"]
                    </ChildContent>
                </AppButton>
            </div>
        </AppCardBody>
    </AppCard>
    
    <LumexDataGrid
        Data="@_state.Value.List.AsQueryable()"
        Radius="@Radius.Medium"
        Class="mt-3">
        <LumexUI.EditColumn
            Title="@DashboardLocalizer["Name"].Value"
            Property="@(p => p.Name)"/>
        <LumexUI.PropertyColumn
            Title="@DashboardLocalizer["BillableByDefault"].Value"
            Property="@(p => p.IsBillableByDefault)"/>
        <LumexUI.PropertyColumn
            Title="@DashboardLocalizer["DefaultHourlyRate"].Value"
            Property="@(p => p.DefaultHourlyRate)"/>
        <LumexUI.PropertyColumn
            Title="@DashboardLocalizer["Client"].Value"
            Sortable="true"
            Property="@(p => p.Client != null ? p.Client.Name : string.Empty)"/>
        <LumexUI.PropertyColumn
            Title="@DashboardLocalizer["Actions"].Value"
            Property="@(p => p.Id)">
            <Content>
                <AppButton
                    Class="inline-flex rounded-full"
                    OnClick="@(() => OnEdit(context))"
                    Size="ComponentSize.Small"
                    Color="ComponentColor.Primary"
                    Variant="ButtonVariant.Light"
                    IconOnly="true">
                    <ChildContent>
                        <i class="fa-regular fa-pen-to-square"></i>
                    </ChildContent>
                </AppButton>
            </Content>
        </LumexUI.PropertyColumn>
    </LumexDataGrid>
</section>
