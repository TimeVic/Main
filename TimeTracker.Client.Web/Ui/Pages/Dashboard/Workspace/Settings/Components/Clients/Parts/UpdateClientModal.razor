@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Validation

@inherits BaseReactiveComponent

<AppModalHeader
    Title="@string.Format(DashboardLocalizer["UpdateClientModal_Title"], Client?.Name)"
    Description="@DashboardLocalizer["UpdateClientModal_Description"]"
    Icon="fa-regular fa-building" />
<AppModalBody
    Class="pt-3">
    <EditForm
        Context="form"
        @ref="_form"
        Model="@model"
        OnSubmit="@Submit"
        novalidate>
        <DataAnnotationsValidator/>

        <div
            class="grid gap-5">
            <div>
                <InputTextField
                    FullWidth="true"
                    Label="@DashboardLocalizer["Client"]"
                    Placeholder="@DashboardLocalizer["ClientName"]"
                    IsShowEmojiButton="true"
                    @bind-Value="model.Name"/>
                <CustomValidationMessage
                    For="@(() => model.Name)"/>
            </div>
        </div>

        <CustomValidationSummary/>
    </EditForm>
</AppModalBody>
<AppModalFooter>
    <AppButton
        FullWidth="@true"
        OnClick="@Submit"
        IsLoading="_state.Value.IsSaving"
        Color="@ComponentColor.Primary"
        Radius="@ButtonRadius.Full">
        @DashboardLocalizer["Update"]
    </AppButton>
</AppModalFooter>
