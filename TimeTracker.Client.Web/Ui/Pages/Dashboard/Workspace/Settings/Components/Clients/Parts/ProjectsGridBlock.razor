@using Microsoft.AspNetCore.Components.QuickGrid
@using TimeTracker.Api.Shared.Dto.Entity

@inherits BaseReactiveComponent

<AppTable
    TGridItem="ProjectDto"
    Items="@Projects.AsQueryable()"
    Class="w-full">
    <AppTableColumn
        TGridItem="ProjectDto"
        Title="@DashboardLocalizer["Project"]"
        SortBy="@(GridSort<ProjectDto>.ByAscending(p => p.Name))">
        <div
            class="flex items-center gap-2 py-0.5">
            <i
                class="fa-regular fa-folder text-sm text-blue-500">
            </i>
            <span
                class="font-medium text-slate-900">
                @context.Name
            </span>
        </div>
    </AppTableColumn>

    <AppTableColumn
        TGridItem="ProjectDto"
        Title="@DashboardLocalizer["DefaultHourlyRate"]"
        SortBy="@(GridSort<ProjectDto>.ByAscending(p => p.DefaultHourlyRate))">
        <span
            class="text-sm font-medium text-slate-700">
            @GetFormattedRate(context.DefaultHourlyRate)
        </span>
    </AppTableColumn>

    <AppTableColumn
        TGridItem="ProjectDto"
        Title="@DashboardLocalizer["ClientProjectsGroupBlock_BillableByDefault"]">
        @if (context.IsBillableByDefault)
        {
            <span
                class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400">
                <i
                    class="fa-solid fa-dollar-sign text-[10px]">
                </i>
                <span>
                    @DashboardLocalizer["ClientProjectsGroupBlock_Billable"]
                </span>
            </span>
        }
        else
        {
            <span
                class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                <span>
                    @DashboardLocalizer["ClientProjectsGroupBlock_NonBillable"]
                </span>
            </span>
        }
    </AppTableColumn>

    <AppTableColumn
        TGridItem="ProjectDto"
        Title="@DashboardLocalizer["Actions"]"
        Align="Align.End">
        <div
            class="flex items-center justify-end">
            <AppButton
                Class="inline-flex rounded-full"
                OnClick="@(() => OnEdit(context))"
                Size="ComponentSize.Small"
                Color="ComponentColor.Primary"
                Variant="ButtonVariant.Light"
                IconOnly="true">
                <ChildContent>
                    <i
                        class="fa-regular fa-pen-to-square">
                    </i>
                </ChildContent>
            </AppButton>
        </div>
    </AppTableColumn>
</AppTable>
