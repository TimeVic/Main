@inherits BaseReactiveComponent

<AppModalHeader
    Title="@string.Format(DashboardLocalizer["IntegrationsBlock_ConnectionTitle"], HelpInfo?.Name)"
    Description="@HelpInfo?.Summary"
    Icon="fa-solid fa-circle-info"
    Color="ComponentColor.Info" />

<AppModalBody
    Class="pt-3">
    <div
        class="space-y-4 text-sm text-slate-700">
        <p>@HelpInfo?.TokenInstruction</p>
        <p>@HelpInfo?.FieldsInstruction</p>
        <div
            class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-amber-900">
            <div
                class="flex items-start gap-3">
                <i
                    class="fa-solid fa-key mt-1"></i>
                <p>@DashboardLocalizer["IntegrationsBlock_ConnectionCheckNotice"]</p>
            </div>
        </div>
    </div>
</AppModalBody>

<AppModalFooter>
    <AppButton
        Color="@ComponentColor.Default"
        Variant="@ButtonVariant.Outlined"
        Radius="@ButtonRadius.Medium"
        OnClick="@CloseModal">
        @DashboardLocalizer["Close"]
    </AppButton>
</AppModalFooter>
