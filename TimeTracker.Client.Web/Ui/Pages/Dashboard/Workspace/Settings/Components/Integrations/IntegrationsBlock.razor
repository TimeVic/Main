@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Workspace
@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Validation

@inherits BaseReactiveComponent

@if (_helpInfo != null)
{
    <LumexModal
        Open="true"
        OnClose="@CloseHelpModal"
        Size="ModalSize.Large">
        <LumexModalContent>
            <LumexModalHeader Class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-cyan-50 text-cyan-700">
                    <i class="fa-solid fa-circle-info"></i>
                </div>
                <div>
                    <h2 class="text-xl font-semibold text-slate-900">@string.Format(DashboardLocalizer["IntegrationsBlock_ConnectionTitle"], _helpInfo.Name)</h2>
                    <p class="mt-1 text-sm text-slate-600">@_helpInfo.Summary</p>
                </div>
            </LumexModalHeader>
            <LumexModalBody Class="pt-3">
                <div class="space-y-4 text-sm text-slate-700">
                    <p>@_helpInfo.TokenInstruction</p>
                    <p>@_helpInfo.FieldsInstruction</p>
                    <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-amber-900">
                        <div class="flex items-start gap-3">
                            <i class="fa-solid fa-key mt-1"></i>
                            <p>@DashboardLocalizer["IntegrationsBlock_ConnectionCheckNotice"]</p>
                        </div>
                    </div>
                </div>
            </LumexModalBody>
            <LumexModalFooter>
                <AppButton
                    Color="ComponentColor.Primary"
                    Variant="ButtonVariant.Solid"
                    OnClick="@CloseHelpModal">
                    @DashboardLocalizer["Close"]
                </AppButton>
            </LumexModalFooter>
        </LumexModalContent>
    </LumexModal>
}

<section class="space-y-6">
    <div class="rounded-3xl border border-cyan-200 bg-cyan-50 p-5 text-cyan-950">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
            <div class="max-w-4xl">
                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-cyan-700">@DashboardLocalizer["IntegrationsBlock_HeaderKicker"]</p>
                <h2 class="mt-2 text-lg font-semibold">@DashboardLocalizer["IntegrationsBlock_Title"]</h2>
                <p class="mt-2 text-sm leading-6">
                    @DashboardLocalizer["IntegrationsBlock_Description"]
                </p>
            </div>
            <div class="grid min-w-[220px] grid-cols-3 gap-2 text-center text-xs font-semibold">
                <div class="rounded-2xl bg-white/70 px-3 py-2 text-slate-700">ClickUp</div>
                <div class="rounded-2xl bg-white/70 px-3 py-2 text-slate-700">Redmine</div>
                <div class="rounded-2xl bg-white/70 px-3 py-2 text-slate-700">Jira</div>
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <LumexCard>
            <LumexCardBody>
                <div class="flex items-center justify-center gap-3 py-12 text-sm font-medium text-slate-500">
                    <i class="fa-solid fa-circle-notch animate-spin text-cyan-600"></i>
                    <span>@DashboardLocalizer["IntegrationsBlock_Loading"]</span>
                </div>
            </LumexCardBody>
        </LumexCard>
    }
    else
    {
        <LumexTabs
            Size="Size.Large"
            Variant="TabVariant.Outlined"
            Color="ThemeColor.Primary"
            FullWidth="true">
            <LumexTab Title="ClickUp">
                <div class="mt-6 w-full">
                    <LumexCard>
                        <LumexCardHeader Class="p-6 pb-2">
                            <IntegrationServiceHeader
                                ServiceName="ClickUp"
                                IconClass="fa-solid fa-list-check"
                                IsActive="@IsActive(_settings.IntegrationClickUp)"
                                OnHelpClick="@(() => ShowHelp(ClickUpHelpInfo))"/>
                        </LumexCardHeader>
                        <LumexCardBody Class="p-6">
                            <EditForm
                                Context="clickUpFormContext"
                                @ref="_clickUpForm"
                                Model="@_clickUpModel"
                                autocomplete="off"
                                novalidate>
                                <DataAnnotationsValidator/>

                                <div class="flex flex-col gap-6">
                                    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
                                        <div>
                                            <InputTextField
                                                FullWidth="true"
                                                Required="true"
                                                Label="@DashboardLocalizer["IntegrationsBlock_ApiToken"]"
                                                Placeholder="pk_..."
                                                Type="InputType.Password"
                                                autocomplete="new-password"
                                                @bind-Value="_clickUpModel.SecurityKey"/>
                                        </div>

                                        <div>
                                            <InputTextField
                                                FullWidth="true"
                                                Required="true"
                                                Label="@DashboardLocalizer["IntegrationsBlock_TeamId"]"
                                                Placeholder="123456"
                                                autocomplete="off"
                                                @bind-Value="_clickUpModel.TeamId"/>
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-1 gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-4 lg:grid-cols-2">
                                        <div class="flex items-start justify-between gap-4">
                                            <div>
                                                <p class="text-sm font-semibold text-slate-900">@DashboardLocalizer["IntegrationsBlock_UseCustomTaskIds"]</p>
                                                <p class="mt-1 text-xs leading-5 text-slate-500">@DashboardLocalizer["IntegrationsBlock_UseCustomTaskIdsDescription"]</p>
                                            </div>
                                            <label class="inline-flex cursor-pointer items-center rounded-2xl px-2 py-1">
                                                <LumexSwitch @bind-Value="_clickUpModel.IsCustomTaskIds"/>
                                            </label>
                                        </div>
                                        <div class="flex items-start justify-between gap-4">
                                            <div>
                                                <p class="text-sm font-semibold text-slate-900">@DashboardLocalizer["IntegrationsBlock_FillEntriesFromTaskDetails"]</p>
                                                <p class="mt-1 text-xs leading-5 text-slate-500">@DashboardLocalizer["IntegrationsBlock_FillEntriesFromTaskDetailsDescription"]</p>
                                            </div>
                                            <label class="inline-flex cursor-pointer items-center rounded-2xl px-2 py-1">
                                                <LumexSwitch @bind-Value="_clickUpModel.IsFillTimeEntryWithTaskDetails"/>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </EditForm>
                        </LumexCardBody>
                        <LumexCardFooter Class="flex justify-start p-6 pt-2">
                            <AppButton
                                Class="w-full sm:w-auto sm:min-w-[200px]"
                                IsLoading="@IsSaving(IntegrationServiceType.ClickUp)"
                                Color="ComponentColor.Primary"
                                Variant="ButtonVariant.Solid"
                                Radius="ButtonRadius.Full"
                                OnClick="@SaveClickUpAsync">
                                <StartContent>
                                    <i class="fa-regular fa-floppy-disk"></i>
                                </StartContent>
                                <ChildContent>
                                    @string.Format(DashboardLocalizer["IntegrationsBlock_SaveService"], "ClickUp")
                                </ChildContent>
                            </AppButton>
                        </LumexCardFooter>
                    </LumexCard>
                </div>
            </LumexTab>

            <LumexTab Title="Redmine">
                <div class="mt-6 w-full">
                    <LumexCard>
                        <LumexCardHeader Class="p-6 pb-2">
                            <IntegrationServiceHeader
                                ServiceName="Redmine"
                                IconClass="fa-solid fa-diamond"
                                IsActive="@IsActive(_settings.IntegrationRedmine)"
                                OnHelpClick="@(() => ShowHelp(RedmineHelpInfo))"/>
                        </LumexCardHeader>
                        <LumexCardBody Class="p-6">
                            <EditForm
                                Context="redmineFormContext"
                                @ref="_redmineForm"
                                Model="@_redmineModel"
                                autocomplete="off"
                                novalidate>
                                <DataAnnotationsValidator/>

                                <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
                                    <div>
                                        <InputTextField
                                            FullWidth="true"
                                            Required="true"
                                            Label="@DashboardLocalizer["IntegrationsBlock_RedmineUrl"]"
                                            Placeholder="https://redmine.example.com"
                                            Type="InputType.Url"
                                            ShowValidationState="true"
                                            autocomplete="off"
                                            @bind-Value="_redmineModel.Url"/>
                                    </div>

                                    <div>
                                        <InputTextField
                                            FullWidth="true"
                                            Required="true"
                                            Label="@DashboardLocalizer["IntegrationsBlock_ApiKey"]"
                                            Placeholder="@DashboardLocalizer["IntegrationsBlock_ApiAccessKeyPlaceholder"]"
                                            Type="InputType.Password"
                                            autocomplete="new-password"
                                            @bind-Value="_redmineModel.ApiKey"/>
                                    </div>

                                    <div>
                                        <InputNumericField
                                            TItem="long"
                                            FullWidth="true"
                                            Required="true"
                                            Label="@DashboardLocalizer["IntegrationsBlock_UserId"]"
                                            Placeholder="1"
                                            @bind-Value="_redmineModel.RedmineUserId"/>
                                    </div>

                                    <div>
                                        <InputNumericField
                                            TItem="long"
                                            FullWidth="true"
                                            Required="true"
                                            Label="@DashboardLocalizer["IntegrationsBlock_ActivityId"]"
                                            Placeholder="9"
                                            @bind-Value="_redmineModel.ActivityId"/>
                                    </div>
                                </div>
                            </EditForm>
                        </LumexCardBody>
                        <LumexCardFooter Class="flex justify-start p-6 pt-2">
                            <AppButton
                                Class="w-full sm:w-auto sm:min-w-[200px]"
                                IsLoading="@IsSaving(IntegrationServiceType.Redmine)"
                                Color="ComponentColor.Primary"
                                Variant="ButtonVariant.Solid"
                                Radius="ButtonRadius.Full"
                                OnClick="@SaveRedmineAsync">
                                <StartContent>
                                    <i class="fa-regular fa-floppy-disk"></i>
                                </StartContent>
                                <ChildContent>
                                    @string.Format(DashboardLocalizer["IntegrationsBlock_SaveService"], "Redmine")
                                </ChildContent>
                            </AppButton>
                        </LumexCardFooter>
                    </LumexCard>
                </div>
            </LumexTab>

            <LumexTab Title="Jira">
                <div class="mt-6 w-full">
                    <LumexCard>
                        <LumexCardHeader Class="p-6 pb-2">
                            <IntegrationServiceHeader
                                ServiceName="Jira"
                                IconClass="fa-solid fa-layer-group"
                                IsActive="@IsActive(_settings.IntegrationJira)"
                                OnHelpClick="@(() => ShowHelp(JiraHelpInfo))"/>
                        </LumexCardHeader>
                        <LumexCardBody Class="p-6">
                            <EditForm
                                Context="jiraFormContext"
                                @ref="_jiraForm"
                                Model="@_jiraModel"
                                autocomplete="off"
                                novalidate>
                                <DataAnnotationsValidator/>

                                <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
                                    <div>
                                        <InputTextField
                                            FullWidth="true"
                                            Required="true"
                                            Label="@DashboardLocalizer["IntegrationsBlock_JiraUrl"]"
                                            Placeholder="https://company.atlassian.net"
                                            Type="InputType.Url"
                                            ShowValidationState="true"
                                            autocomplete="off"
                                            @bind-Value="_jiraModel.Url"/>
                                    </div>

                                    <div>
                                        <InputTextField
                                            FullWidth="true"
                                            Required="true"
                                            Label="@DashboardLocalizer["IntegrationsBlock_UserEmail"]"
                                            Placeholder="name@company.com"
                                            ShowValidationState="true"
                                            autocomplete="new-password"
                                            @bind-Value="_jiraModel.UserName"/>
                                    </div>

                                    <div>
                                        <InputTextField
                                            FullWidth="true"
                                            Required="true"
                                            Label="@DashboardLocalizer["IntegrationsBlock_ApiToken"]"
                                            Placeholder="@DashboardLocalizer["IntegrationsBlock_AtlassianApiTokenPlaceholder"]"
                                            Type="InputType.Password"
                                            autocomplete="new-password"
                                            @bind-Value="_jiraModel.ApiKey"/>
                                    </div>
                                </div>
                            </EditForm>
                        </LumexCardBody>
                        <LumexCardFooter Class="flex justify-start p-6 pt-2">
                            <AppButton
                                Class="w-full sm:w-auto sm:min-w-[200px]"
                                IsLoading="@IsSaving(IntegrationServiceType.Jira)"
                                Color="ComponentColor.Primary"
                                Variant="ButtonVariant.Solid"
                                Radius="ButtonRadius.Full"
                                OnClick="@SaveJiraAsync">
                                <StartContent>
                                    <i class="fa-regular fa-floppy-disk"></i>
                                </StartContent>
                                <ChildContent>
                                    @string.Format(DashboardLocalizer["IntegrationsBlock_SaveService"], "Jira")
                                </ChildContent>
                            </AppButton>
                        </LumexCardFooter>
                    </LumexCard>
                </div>
            </LumexTab>
        </LumexTabs>
    }
</section>
