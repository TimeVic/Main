@using LumexUI.Common
@using TimeTracker.Business.Common.Constants
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Workspace.Settings.Components.Members.Parts

@inherits BaseReactiveComponent

<AddMemberModal
    IsOpened="_isAddMemberModalOpened"
    IsOpenedChanged="isOpened => _isAddMemberModalOpened = isOpened"/>

@if (_memberToUpdate != null)
{
    <UpdateMemberModal
        Member="_memberToUpdate"
        IsOpened="_memberToUpdate != null"
        IsOpenedChanged="isOpened => { _memberToUpdate = isOpened ? _memberToUpdate : null; }"/>
}

<section class="space-y-6">
    <LumexCard>
        <LumexCardBody>
            <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-blue-700">@DashboardLocalizer["Members"]</p>
                    <h2 class="mt-2 text-lg font-semibold text-slate-900">@DashboardLocalizer["MembersBlock_WorkspaceMembersTitle"]</h2>
                    <p class="mt-1 text-sm text-slate-600">@DashboardLocalizer["MembersBlock_Description"]</p>
                </div>
                <CustomButton
                    Size="Size.Small"
                    OnClick="@OnAdd"
                    Color="@ThemeColor.Primary"
                    Radius="@Radius.Full">
                    <StartContent>
                        <i class="fa-solid fa-user-plus"></i>
                    </StartContent>
                    <ChildContent>
                        @DashboardLocalizer["MembersBlock_InviteMember"]
                    </ChildContent>
                </CustomButton>
            </div>
        </LumexCardBody>
    </LumexCard>

    <LumexDataGrid
        Data="@_state.Value.List.AsQueryable()"
        Radius="@Radius.Medium"
        Class="mt-3">
        <LumexUI.PropertyColumn
            Title="@DashboardLocalizer["Name"].Value"
            Property="@(p => p.User.Name)"/>
        <LumexUI.PropertyColumn
            Title="@DashboardLocalizer["Email"].Value"
            Property="@(p => p.User.Email)"/>
        <LumexUI.PropertyColumn
            Title="@DashboardLocalizer["MembersBlock_Access"].Value"
            Property="@(p => p.Access.ToString())"/>
        <LumexUI.PropertyColumn
            Title="@DashboardLocalizer["Actions"].Value"
            Property="@(p => p.Id)">
            <Content>
                @if (context.Access != MembershipAccessType.Owner)
                {
                    <div class="flex gap-1">
                        <CustomButton
                            Class="inline-flex rounded-full"
                            OnClick="@(() => OnEdit(context))"
                            Size="Size.Small"
                            Color="ThemeColor.Primary"
                            Variant="Variant.Light"
                            IconOnly="true">
                            <ChildContent>
                                <i class="fa-regular fa-pen-to-square"></i>
                            </ChildContent>
                        </CustomButton>
                        <CustomButton
                            Class="inline-flex rounded-full"
                            OnClick="@(() => OnDelete(context))"
                            Size="Size.Small"
                            Color="ThemeColor.Danger"
                            Variant="Variant.Light"
                            IconOnly="true">
                            <ChildContent>
                                <i class="fa-regular fa-trash-can"></i>
                            </ChildContent>
                        </CustomButton>
                    </div>
                }
            </Content>
        </LumexUI.PropertyColumn>
    </LumexDataGrid>
</section>
