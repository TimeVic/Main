@using TimeTracker.Api.Shared.Dto.Entity

@inherits BaseReactiveComponent

<div class="relative w-full @Class" @onfocusin="OnFocus" @onfocusout="OnBlur">
    <div class="relative">
        <InputTextField
            Value="@Value"
            ValueChanged="OnValueChanged"
            Label="@Label"
            Placeholder="@(string.IsNullOrEmpty(Placeholder) ? DashboardLocalizer["SmartUserSearchInput_Placeholder"].Value : Placeholder)"
            Disabled="@Disabled"
            FullWidth="true">
            <EndContent>
                @if (_isSearching)
                {
                    <span class="text-slate-400">
                        <i class="fa-solid fa-circle-notch fa-spin text-sm"></i>
                    </span>
                }
            </EndContent>
        </InputTextField>
    </div>

    @if (_isOpen && _searchResults.Count > 0)
    {
        <div class="absolute z-50 left-0 right-0 mt-1.5 bg-white border border-slate-100 rounded-xl shadow-lg max-h-48 overflow-y-auto">
            @foreach (var user in _searchResults)
            {
                <div
                    class="hover:bg-slate-50 hover:text-blue-600 transition-colors cursor-pointer px-4 py-2 text-sm text-slate-700 font-semibold flex items-center justify-between"
                    @onmousedown="@(() => SelectUser(user))">
                    <span>@($"@{user.Login}")</span>
                </div>
            }
        </div>
    }

    @if (_isEmailMode && !string.IsNullOrWhiteSpace(Value))
    {
        <p class="mt-1.5 text-xs text-blue-600 font-medium flex items-center gap-1.5">
            @DashboardLocalizer["SmartUserSearchInput_NewUserHint"]
        </p>
    }
</div>
