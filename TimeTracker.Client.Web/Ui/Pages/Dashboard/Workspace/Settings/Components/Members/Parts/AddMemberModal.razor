@using LumexUI
@using LumexUI.Common
@using TimeTracker.Business.Common.Constants
@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Validation
@using TimeTracker.Client.Web.Ui.Components.Core.Modal

@inherits BaseReactiveComponent

<AppModalHeader
    Title="@DashboardLocalizer["AddMemberModal_Title"]"
    Description="@DashboardLocalizer["AddMemberModal_Description"]">
    <Icon>
        <div
            class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
            <i
                class="fa-solid fa-user-plus"></i>
        </div>
    </Icon>
</AppModalHeader>

<AppModalBody>
    <div
        class="add-member-modal">
        <EditForm
            Context="form"
            @ref="_form"
            Model="@_model"
            novalidate>
            <DataAnnotationsValidator/>

            <div
                class="flex flex-col gap-4">
                <div>
                    <SmartUserSearchInput
                        Label="@DashboardLocalizer["AddMemberModal_MemberEmail"]"
                        @bind-Value="_model.EmailOrLogin" />
                    <CustomValidationMessage
                        For="@(() => _model.EmailOrLogin)" />
                </div>

                <div>
                    <EnumDropDown
                        TItem="MembershipAccessType"
                        Label="@DashboardLocalizer["UpdateMemberModal_AccessLevel"]"
                        AllowedValues="_allowedAccessLevels"
                        Value="@_model.Access"
                        ValueChanged="@(v => _model.Access = v ?? MembershipAccessType.User)"/>
                </div>
            </div>
        </EditForm>
    </div>
</AppModalBody>

<AppModalFooter>
    <CustomButton
        FullWidth="@true"
        OnClick="@Submit"
        IsLoading="_isLoading"
        Color="@ThemeColor.Primary"
        Radius="@Radius.Full">
        <StartContent>
            <i
                class="fa-solid fa-user-plus"></i>
        </StartContent>
        <ChildContent>
            @DashboardLocalizer["AddMemberModal_InviteMember"]
        </ChildContent>
    </CustomButton>
</AppModalFooter>
