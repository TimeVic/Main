@using TimeTracker.Business.Common.Constants

@inherits BaseReactiveComponent

<AppModalHeader
    Title="@DashboardLocalizer["AddMemberModal_Title"]"
    Description="@DashboardLocalizer["AddMemberModal_Description"]"
    Icon="fa-solid fa-user-plus" />

<AppModalBody>
    <EditForm
        Context="form"
        @ref="_form"
        Model="@_model"
        novalidate>
        <DataAnnotationsValidator/>

            <div
                class="flex flex-col gap-4">
                <div>
                    <SmartUserSearchInput
                        Label="@DashboardLocalizer["AddMemberModal_MemberEmail"]"
                        @bind-Value="_model.EmailOrLogin" />
                </div>

                <div>
                    <EnumSelect
                        TItem="MembershipAccessType"
                        Label="@DashboardLocalizer["UpdateMemberModal_AccessLevel"]"
                        AllowedValues="_allowedAccessLevels"
                        Value="@_model.Access"
                        ValueChanged="@(v => _model.Access = v ?? MembershipAccessType.User)"/>
                </div>
            </div>
        </EditForm>
</AppModalBody>

<AppModalFooter>
    <AppButton
        Color="@ComponentColor.Default"
        Variant="@ButtonVariant.Outlined"
        Radius="@ButtonRadius.Medium"
        OnClick="@(() => ModalInstance?.Close(AppModalResult.Cancel()))">
        @DashboardLocalizer["Cancel"]
    </AppButton>
    <AppButton
        OnClick="@Submit"
        IsLoading="_isLoading"
        Color="@ComponentColor.Primary"
        Radius="@ButtonRadius.Medium">
        <StartContent>
            <i
                class="fa-solid fa-user-plus"></i>
        </StartContent>
        <ChildContent>
            @DashboardLocalizer["AddMemberModal_InviteMember"]
        </ChildContent>
    </AppButton>
</AppModalFooter>
