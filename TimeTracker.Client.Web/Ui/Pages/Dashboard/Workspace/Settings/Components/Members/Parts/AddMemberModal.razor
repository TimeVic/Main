@using LumexUI
@using LumexUI.Common
@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Validation

@inherits BaseReactiveComponent

<LumexModal
    Open="IsOpened"
    OnClose="@OnCloseModal"
    Size="ModalSize.Small">
    <LumexModalContent>
        <LumexModalHeader Class="flex items-center gap-3">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                    <i class="fa-solid fa-user-plus"></i>
                </div>
                <div>
                    <h2 class="text-xl font-semibold text-slate-900">@DashboardLocalizer["AddMemberModal_Title"]</h2>
                    <p class="mt-1 text-sm text-slate-600">@DashboardLocalizer["AddMemberModal_Description"]</p>
                </div>
            </div>
        </LumexModalHeader>
        <LumexModalBody Class="pt-3">
            <EditForm
                Context="form"
                @ref="_form"
                Model="@_model"
                novalidate>
                <DataAnnotationsValidator/>

                <div class="pt-1">
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                        @DashboardLocalizer["AddMemberModal_MemberEmail"]
                    </label>
                    <SmartUserSearchInput
                        @bind-Value="_model.EmailOrLogin" />
                    <ValidationMessage For="@(() => _model.EmailOrLogin)" Class="text-xs text-rose-500 mt-1" />
                </div>
            </EditForm>
        </LumexModalBody>
        <LumexModalFooter>
            <CustomButton
                FullWidth="@true"
                OnClick="@Submit"
                IsLoading="_isLoading"
                Color="@ThemeColor.Primary"
                Radius="@Radius.Full">
                <StartContent>
                    <i class="fa-solid fa-user-plus"></i>
                </StartContent>
                <ChildContent>
                    @DashboardLocalizer["AddMemberModal_InviteMember"]
                </ChildContent>
            </CustomButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
