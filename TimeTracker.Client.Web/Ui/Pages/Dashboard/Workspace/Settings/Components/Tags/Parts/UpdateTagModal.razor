@using TimeTracker.Client.Core.Constants.Ui

@inherits BaseReactiveComponent

<AppModalHeader
    Title="@string.Format(DashboardLocalizer["UpdateTagModal_Title"], model.Name)"
    Description="@DashboardLocalizer["UpdateTagModal_Description"]"
    Icon="fa-solid fa-tag" />
<AppModalBody
    Class="pt-3">
    <EditForm
        Context="form"
        @ref="_form"
        Model="@model"
        novalidate>
        <DataAnnotationsValidator/>

        <div
            class="grid gap-5">
            <div>
                <InputTextField
                    FullWidth="true"
                    Label="@DashboardLocalizer["Tag"]"
                    Placeholder="@DashboardLocalizer["TagName"]"
                    IsShowEmojiButton="true"
                    @bind-Value="model.Name"/>
            </div>

            <div
                class="pt-1">
                <ColorSelect
                    Label="@DashboardLocalizer["Color"]"
                    Type="DropDownType.Select"
                    Clearable="true"
                    @bind-Value="model.Color"/>
            </div>
        </div>
    </EditForm>
</AppModalBody>
<AppModalFooter>
    <AppButton
        FullWidth="@true"
        OnClick="@Submit"
        IsLoading="_state.Value.IsSaving"
        Color="@ComponentColor.Primary"
        Radius="@ButtonRadius.Full">
        @DashboardLocalizer["Update"]
    </AppButton>
</AppModalFooter>
