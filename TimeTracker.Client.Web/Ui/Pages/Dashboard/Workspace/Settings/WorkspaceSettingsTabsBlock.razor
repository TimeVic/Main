@using TimeTracker.Api.Shared.Constants

@inherits BaseReactiveComponent

<div
    class="space-y-6">
    <AppTabs
        ActiveKey="@ActiveSection"
        AriaLabel="@DashboardLocalizer["Settings"]">
        <AppTab
            Key="general"
            Title="@DashboardLocalizer["Settings"]"
            Icon="fa-solid fa-sliders"
            Href="@UrlService.GetDashboardUrl("workspace/settings")" />
        <AppTab
            Key="clients"
            Title="@DashboardLocalizer["SettingsPage_ClientsAndProjectsTab"]"
            Icon="fa-regular fa-building"
            Href="@UrlService.GetDashboardUrl("workspace/settings/clients")" />
        <AppTab
            Key="tags"
            Title="@DashboardLocalizer["Tags"]"
            Icon="fa-solid fa-tags"
            Href="@UrlService.GetDashboardUrl("workspace/settings/tags")" />
        @if (SecurityManager.HasPermission(WorkspacePermission.UpdateWorkspaceMembers))
        {
            <AppTab
                Key="members"
                Title="@DashboardLocalizer["Members"]"
                Icon="fa-solid fa-users"
                Href="@UrlService.GetDashboardUrl("workspace/settings/members")" />
        }
        <AppTab
            Key="integrations"
            Title="@DashboardLocalizer["Integrations"]"
            Icon="fa-solid fa-plug-circle-check"
            Href="@UrlService.GetDashboardUrl("workspace/settings/integrations")" />
        <AppTab
            Key="import"
            Title="@DashboardLocalizer["SettingsPage_ImportTab"]"
            Icon="fa-solid fa-file-import"
            Href="@UrlService.GetDashboardUrl("workspace/settings/import")" />
    </AppTabs>

    @ChildContent
</div>
