@page "/board/{WorkspaceId:guid}/workspace/settings"
@page "/board/workspace/settings"
@attribute [RequireWorkspacePermission(WorkspacePermission.UpdateWorkspaceSettings)]
@using LumexUI.Common
@using TimeTracker.Api.Shared.Constants
@using TimeTracker.Business.Common.Constants
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Workspace.Settings.Components.Settings
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Workspace.Settings.Components.Clients
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Workspace.Settings.Components.Tags
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Workspace.Settings.Components.Members
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Workspace.Settings.Components.Integrations
@using Layout = TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Layout

@inherits BaseReactiveComponent
@layout Layout

<LumexTabs 
    Size="Size.Large" 
    Variant="TabVariant.Outlined"
    Color="ThemeColor.Primary"
    FullWidth="true"
>
    <LumexTab>
        <TitleContent>
            <div class="flex items-center space-x-2">
                <i class="fa-solid fa-sliders"></i>
                <span>@DashboardLocalizer["Settings"]</span>
            </div>
        </TitleContent>
        <ChildContent>
            <SettingsBlock></SettingsBlock>
        </ChildContent>
    </LumexTab>
    <LumexTab>
        <TitleContent>
            <div class="flex items-center space-x-2">
                <i class="fa-regular fa-building"></i>
                <span>@DashboardLocalizer["SettingsPage_ClientsAndProjectsTab"]</span>
            </div>
        </TitleContent>
        <ChildContent>
            <ClientsBlock></ClientsBlock>
        </ChildContent>
    </LumexTab>
    <LumexTab>
        <TitleContent>
            <div class="flex items-center space-x-2">
                <i class="fa-solid fa-tags"></i>
                <span>@DashboardLocalizer["Tags"]</span>
            </div>
        </TitleContent>
        <ChildContent>
            <TagsBlock></TagsBlock>
        </ChildContent>
    </LumexTab>
    @if (AuthState.Value.Workspace?.Mode == WorkspaceMode.Team)
    {
        <LumexTab>
            <TitleContent>
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-users"></i>
                    <span>@DashboardLocalizer["Members"]</span>
                </div>
            </TitleContent>
            <ChildContent>
                <MembersBlock></MembersBlock>
            </ChildContent>
        </LumexTab>
    }
    <LumexTab>
        <TitleContent>
            <div class="flex items-center space-x-2">
                <i class="fa-solid fa-plug-circle-check"></i>
                <span>@DashboardLocalizer["Integrations"]</span>
            </div>
        </TitleContent>
        <ChildContent>
            <IntegrationsBlock></IntegrationsBlock>
        </ChildContent>
    </LumexTab>
</LumexTabs>
