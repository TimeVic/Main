@using LumexUI
@using LumexUI.Common

@inherits BaseReactiveComponent

<LumexModal Open="IsOpened" OnClose="@OnCloseModal" Size="ModalSize.Small" @ref="modal">
    <LumexModalContent>
        <LumexModalHeader Class="flex items-center gap-3">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-blue-600">@DashboardLocalizer["AddWorkspaceModal_Kicker"]</p>
                <h2 class="mt-2 text-xl font-semibold text-slate-900">@DashboardLocalizer["AddWorkspaceModal_Title"]</h2>
                <p class="mt-1 text-sm text-slate-500">@DashboardLocalizer["AddWorkspaceModal_Description"]</p>
            </div>
        </LumexModalHeader>
        <LumexModalBody Class="pt-3">
            <EditForm
                Context="form"
                @ref="_form"
                Model="@model"
                OnValidSubmit="@Submit"
                novalidate>
                <DataAnnotationsValidator/>
                <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">@DashboardLocalizer["Submit"]</button>
                
                <div class="pt-1">
                    <InputTextField
                        FullWidth="true"
                        Label="@DashboardLocalizer["UpdateWorkspaceForm_WorkspaceName"]"
                        IsShowEmojiButton="true"
                        @bind-Value="model.Name"/>
                </div>
            </EditForm>
        </LumexModalBody>
        <LumexModalFooter>
            <CustomButton
                FullWidth="@true"
                OnClick="@Submit"
                Color="@ThemeColor.Primary"
                Radius="@Radius.Full">
                @DashboardLocalizer["Add"]
            </CustomButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
