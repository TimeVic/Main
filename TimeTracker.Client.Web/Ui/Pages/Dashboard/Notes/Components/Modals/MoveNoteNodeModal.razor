@using TimeTracker.Api.Shared.Dto.Entity.Notes
@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Notes

@inherits BaseReactiveComponent

<div class="notes-node-modal">
    <AppModalHeader
        Title="@DashboardLocalizer["Notes_MoveTitle"]"
        Description="@DashboardLocalizer["Notes_MoveDescription"]"
        Icon="fa-solid fa-folder-tree" />
    <AppModalBody
        Class="pt-3">
        <MoveNoteFolderSelect
            Nodes="Nodes"
            SelectedFolderId="_selectedParentId"
            SelectedFolderIdChanged="@OnParentChanged"/>
    </AppModalBody>
    <AppModalFooter>
        <AppButton
            Color="@ComponentColor.Default"
            Variant="@ButtonVariant.Outlined"
            Radius="@ButtonRadius.Medium"
            OnClick="@(() => ModalInstance?.Close(AppModalResult.Cancel()))">
            @DashboardLocalizer["Cancel"]
        </AppButton>
        <AppButton
            Color="ComponentColor.Primary"
            Radius="@ButtonRadius.Medium"
            IsLoading="IsSaving"
            OnClick="@Submit">
            @DashboardLocalizer["Notes_Move"]
        </AppButton>
    </AppModalFooter>
</div>
