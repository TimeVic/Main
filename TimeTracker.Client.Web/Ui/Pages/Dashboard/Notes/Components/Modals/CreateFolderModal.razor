@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Notes
@using TimeTracker.Business.Common.Constants.Notes

@inherits BaseReactiveComponent

<div class="notes-node-modal">
    <AppModalHeader
        Title="@DashboardLocalizer["CreateFolder"]"
        Description="@DashboardLocalizer["Notes_CreateFolderDescription"]"
        Icon="fa-regular fa-folder" />
    <AppModalBody
        Class="pt-3">
        <EditForm
            Context="form"
            @ref="_form"
            Model="@_model"
            OnSubmit="@SubmitForm"
            novalidate>
            <DataAnnotationsValidator/>
            <button
                type="submit"
                class="sr-only"
                tabindex="-1"
                aria-hidden="true">
                @DashboardLocalizer["Submit"]
            </button>
            <div
                class="grid min-w-0 gap-6">
                <div
                    class="min-w-0">
                    <InputTextField
                        Class="min-w-0 max-w-full"
                        FullWidth="true"
                        Label="@DashboardLocalizer["Title"].Value"
                        Placeholder="@DashboardLocalizer["Notes_FolderTitlePlaceholder"].Value"
                        @bind-Value="_model.Title"/>
                </div>
            </div>
        </EditForm>
    </AppModalBody>
    <AppModalFooter>
        <AppButton
            Color="@ComponentColor.Default"
            Variant="@ButtonVariant.Outlined"
            Radius="@ButtonRadius.Medium"
            OnClick="@(() => ModalInstance?.Close(AppModalResult.Cancel()))">
            @DashboardLocalizer["Cancel"]
        </AppButton>
        <AppButton
            Color="@ComponentColor.Primary"
            Radius="@ButtonRadius.Medium"
            IsLoading="IsSaving"
            OnClick="@Submit">
            @DashboardLocalizer["CreateFolder"]
        </AppButton>
    </AppModalFooter>
</div>
