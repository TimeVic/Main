@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Notes
@using TimeTracker.Business.Common.Constants.Notes
@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Validation

@inherits BaseReactiveComponent

<div class="notes-node-modal">
    <LumexModal Open="IsOpened" OnClose="@OnCloseModal" Size="ModalSize.Small" @ref="_modal">
        <LumexModalContent>
            <LumexModalHeader Class="flex items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                    <i class="fa-regular fa-folder"></i>
                </div>
                <div class="min-w-0">
                    <h2 class="text-xl font-semibold text-slate-900">@DashboardLocalizer["CreateFolder"]</h2>
                    <p class="mt-1 text-sm text-slate-600">@DashboardLocalizer["Notes_CreateFolderDescription"]</p>
                </div>
            </LumexModalHeader>
            <LumexModalBody Class="pt-3">
                <EditForm Context="form" @ref="_form" Model="@_model" OnSubmit="@SubmitForm" novalidate>
                    <DataAnnotationsValidator/>
                    <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">@DashboardLocalizer["Submit"]</button>
                    <div class="grid min-w-0 gap-6">
                        <div class="min-w-0">
                            <InputTextField
                                Class="min-w-0 max-w-full"
                                FullWidth="true"
                                Label="@DashboardLocalizer["Title"].Value"
                                Placeholder="@DashboardLocalizer["Notes_FolderTitlePlaceholder"].Value"
                                @bind-Value="_model.Title"/>
                            <CustomValidationMessage For="@(() => _model.Title)"/>
                        </div>
                        <CustomValidationSummary/>
                    </div>
                </EditForm>
            </LumexModalBody>
            <LumexModalFooter>
                <AppButton
                    FullWidth="true"
                    Color="@ComponentColor.Primary"
                    Radius="@ButtonRadius.Full"
                    IsLoading="IsSaving"
                    OnClick="@Submit">
                    @DashboardLocalizer["CreateFolder"]
                </AppButton>
            </LumexModalFooter>
        </LumexModalContent>
    </LumexModal>
</div>
