@using TimeTracker.Api.Shared.Dto.Entity.Notes
@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Notes
@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Validation

@inherits BaseReactiveComponent

<div class="notes-node-modal">
    <AppModalHeader
        Title="@DashboardLocalizer["Rename"]"
        Description="@DashboardLocalizer["Notes_RenameDescription"]">
        <Icon>
            <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-700">
                <i
                    class="fa-solid fa-pen"></i>
            </div>
        </Icon>
    </AppModalHeader>
    <AppModalBody
        Class="pt-3">
        <EditForm
            Context="form"
            @ref="_form"
            Model="@_model"
            OnSubmit="@SubmitForm"
            novalidate>
            <DataAnnotationsValidator/>
            <button
                type="submit"
                class="sr-only"
                tabindex="-1"
                aria-hidden="true">
                @DashboardLocalizer["Submit"]
            </button>
            <div
                class="min-w-0">
                <InputTextField
                    Class="min-w-0 max-w-full"
                    FullWidth="true"
                    Label="@DashboardLocalizer["Title"].Value"
                    Placeholder="@DashboardLocalizer["Title"].Value"
                    @bind-Value="_model.Title"/>
            </div>
            <CustomValidationMessage
                For="@(() => _model.Title)"/>
            <CustomValidationSummary/>
        </EditForm>
    </AppModalBody>
    <AppModalFooter>
        <AppButton
            FullWidth="true"
            Color="@ComponentColor.Primary"
            Radius="@ButtonRadius.Full"
            IsLoading="IsSaving"
            OnClick="@Submit">
            @DashboardLocalizer["Rename"]
        </AppButton>
    </AppModalFooter>
</div>
