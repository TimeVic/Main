@using LumexUI.Common
@using TimeTracker.Business.Common.Constants.Notes
@using TimeTracker.Business.Common.Constants.Storage
@using TimeTracker.Client.Core.Constants.Ui
@using TimeTracker.Client.Web.Ui.Shared.Components.Storage
@using TimeTracker.Client.Web.Services.UI
@inject MarkdownService MarkdownService
@inherits BaseReactiveComponent

<section class="@ContainerClass">
    @if (IsLoading)
    {
        <div class="flex flex-1 flex-col">
            <div class="border-b border-slate-200 p-4">
                <div class="flex flex-col gap-3 xl:flex-row xl:items-center">
                    <LumexSkeleton Class="h-12 min-w-0 flex-1 rounded-xl"/>
                    <div class="flex shrink-0 justify-end gap-2">
                        <LumexSkeleton Class="h-8 w-24 rounded-full"/>
                        <LumexSkeleton Class="h-8 w-28 rounded-full"/>
                    </div>
                </div>
            </div>
            <div class="flex min-h-0 flex-1 flex-col p-4">
                <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                    <LumexSkeleton Class="h-4 w-24 rounded-full"/>
                    @if (IsEditing)
                    {
                        <LumexSkeleton Class="h-6 w-28 rounded-full"/>
                    }
                </div>
                @if (!IsEditing)
                {
                    <LumexSkeleton Class="mb-3 h-4 w-64 max-w-full rounded-full"/>
                }
                <LumexSkeleton Class="min-h-[560px] flex-1 w-full rounded-xl"/>
            </div>
        </div>
    }
    else if (Document == null)
    {
        <div class="flex min-h-[360px] flex-1 items-center justify-center p-6 text-center">
            <div>
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-500">
                    <i class="fa-regular fa-note-sticky"></i>
                </div>
                <p class="mt-4 text-sm font-medium text-slate-700">@DashboardLocalizer["Notes_NoSelectedNote"]</p>
            </div>
        </div>
    }
    else
    {
        <div class="border-b border-slate-200 p-4">
            <div class="flex flex-col gap-3 xl:flex-row xl:items-center">
                @if (IsEditing)
                {
                    <input
                        class="min-w-0 flex-1 rounded-xl border border-slate-200 px-4 py-3 text-lg font-semibold text-slate-900 outline-none transition focus:border-blue-500"
                        maxlength="200"
                        value="@Title"
                        placeholder="@DashboardLocalizer["Title"].Value"
                        @oninput="@OnTitleInput"/>
                }
                else
                {
                    <div class="min-w-0 flex-1">
                        <h2 class="truncate text-xl font-semibold text-slate-900">@Title</h2>
                    </div>
                }
                <div class="flex shrink-0 flex-wrap items-center justify-end gap-2">
                    @if (IsEditing)
                    {
                        <EnumDropDown
                            TItem="NoteVisibility"
                            SelectType="@DropDownType.DropDown"
                            Size="Size.Small"
                            Value="@Visibility"
                            ValueChanged="@OnVisibilityChanged"/>
                        <CustomButton
                            Size="Size.Small"
                            Color="@ThemeColor.Default"
                            Variant="Variant.Outlined"
                            Radius="@Radius.Full"
                            Disabled="IsSaving"
                            OnClick="@OnCancelClick">
                            <StartContent>
                                <i class="fa-solid fa-xmark"></i>
                            </StartContent>
                            <ChildContent>@DashboardLocalizer["Cancel"]</ChildContent>
                        </CustomButton>
                        <CustomButton
                            Size="Size.Small"
                            Color="@ThemeColor.Primary"
                            Radius="@Radius.Full"
                            IsLoading="IsSaving"
                            OnClick="@OnSave">
                            <StartContent>
                                <i class="fa-regular fa-floppy-disk"></i>
                            </StartContent>
                            <ChildContent>@DashboardLocalizer["Save"]</ChildContent>
                        </CustomButton>
                    }
                    else
                    {
                        <span class="rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600">
                            @GetVisibilityLabel()
                        </span>
                        <CustomButton
                            Size="Size.Small"
                            Color="@ThemeColor.Primary"
                            Radius="@Radius.Full"
                            OnClick="@OnEditClick">
                            <StartContent>
                                <i class="fa-regular fa-pen-to-square"></i>
                            </StartContent>
                            <ChildContent>@DashboardLocalizer["Edit"]</ChildContent>
                        </CustomButton>
                    }
                </div>
            </div>
        </div>
        @if (IsEditing)
        {
            <div class="flex min-h-0 flex-1 flex-col p-4">
                <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                    <label class="block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">@DashboardLocalizer["Markdown"]</label>
                    <span class="@SaveStateClass">@SaveStateLabel</span>
                </div>
                <LumexTextarea
                    Value="@MarkdownContent"
                    ValueChanged="@OnMarkdownChanged"
                    Behavior="InputBehavior.OnInput"
                    Variant="InputVariant.Outlined"
                    Radius="Radius.Large"
                    FullWidth="true"
                    MinRows="@MarkdownTextareaMinRows"
                    MaxRows="@MarkdownTextareaMaxRows"
                    Placeholder="@DashboardLocalizer["Notes_MarkdownPlaceholder"].Value"
                    AdditionalAttributes="@MarkdownTextareaAttributes"
                    Classes="@MarkdownTextareaClasses"
                    Class="flex-1"/>
            </div>
        }
        else
        {
            <div class="flex min-h-0 flex-1 flex-col p-4">
                <div class="mb-2">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">@DashboardLocalizer["Preview"]</p>
                </div>
                <div class="min-h-[560px] flex-1 overflow-auto rounded-xl bg-white text-slate-700">
                    @if (string.IsNullOrWhiteSpace(MarkdownContent))
                    {
                        <p class="text-sm text-slate-400">@DashboardLocalizer["Notes_EmptyPreview"]</p>
                    }
                    else
                    {
                        @((MarkupString)MarkdownService.ToHtml(MarkdownContent))
                    }
                </div>
            </div>
        }
        <div class="mx-4 mb-4 border-t border-slate-200 pt-4">
            <div class="relative flex min-h-24 items-center justify-center overflow-hidden rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 text-center text-sm text-slate-500 transition hover:border-blue-400 hover:bg-blue-50">
                <InputFile
                    class="absolute inset-0 z-10 h-full w-full cursor-copy opacity-0"
                    OnChange="@OnAttachmentsInputFileChange"
                    multiple
                    accept="@AttachmentAcceptTypes" />
                <div class="pointer-events-none flex items-center gap-2">
                    <i class="fa-solid fa-cloud-arrow-up text-base text-slate-400"></i>
                    <span>@DashboardLocalizer["Notes_AttachmentsHint"]</span>
                </div>
            </div>
            <AttachmentsBlock
                Class="mt-4"
                ListClass="flex flex-wrap gap-3"
                PreviewItemClass="relative flex h-24 w-24 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-slate-200 bg-slate-50 transition"
                EntityId="@Document.Id"
                EntityType="@StorageEntityType.NoteNode"
                Files="@Document.Attachments"
                UploadingFiles="@_uploadingAttachments"
                FilesChanged="@AttachmentsChanged" />
        </div>
    }
</section>
