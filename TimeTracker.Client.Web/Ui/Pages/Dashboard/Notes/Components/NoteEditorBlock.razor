@using TimeTracker.Business.Common.Constants.Notes
@using TimeTracker.Business.Common.Constants.Storage
@using TimeTracker.Client.Core.Constants.Ui
@using TimeTracker.Client.Web.Ui.Shared.Components.Storage
@using TimeTracker.Client.Web.Services.UI
@inject MarkdownService MarkdownService
@inherits BaseReactiveComponent

<section class="@ContainerClass">
    @if (IsLoading)
    {
        <div class="flex flex-1 flex-col">
            <div class="border-b border-slate-200 p-4">
                <div class="flex flex-col gap-3 xl:flex-row xl:items-center">
                    <AppSkeleton Class="h-12 min-w-0 flex-1 rounded-xl"/>
                    <div class="flex shrink-0 justify-end gap-2">
                        <AppSkeleton Class="h-8 w-24 rounded-full"/>
                        <AppSkeleton Class="h-8 w-28 rounded-full"/>
                    </div>
                </div>
            </div>
            <div class="flex min-h-0 flex-1 flex-col p-4">
                <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                    <AppSkeleton Class="h-4 w-24 rounded-full"/>
                    @if (IsEditing)
                    {
                        <AppSkeleton Class="h-6 w-28 rounded-full"/>
                    }
                </div>
                @if (!IsEditing)
                {
                    <AppSkeleton Class="mb-3 h-4 w-64 max-w-full rounded-full"/>
                }
                <AppSkeleton Class="min-h-[560px] flex-1 w-full rounded-xl"/>
            </div>
        </div>
    }
    else if (Document == null)
    {
        <div class="flex min-h-[360px] flex-1 items-center justify-center p-6 text-center">
            <div>
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-500">
                    <i class="fa-regular fa-note-sticky"></i>
                </div>
                <p class="mt-4 text-sm font-medium text-slate-700">@DashboardLocalizer["Notes_NoSelectedNote"]</p>
            </div>
        </div>
    }
    else
    {
        <div class="border-b border-slate-200 p-4">
            <div class="flex flex-col gap-3 xl:flex-row xl:items-center">
                @if (IsEffectiveEditing)
                {
                    <div class="flex min-w-0 flex-1 items-center gap-2.5">
                        @if (Document.IsDraft)
                        {
                            <span class="inline-flex shrink-0 items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700">
                                @DashboardLocalizer["Notes_DraftBadge"]
                            </span>
                        }
                        <input
                            class="min-w-0 flex-1 rounded-xl border border-slate-200 px-4 py-3 text-lg font-semibold text-slate-900 outline-none transition focus:border-blue-500"
                            maxlength="200"
                            value="@Title"
                            placeholder="@(Document.IsDraft ? DashboardLocalizer["Notes_DraftTitlePlaceholder"].Value : DashboardLocalizer["Title"].Value)"
                            @oninput="@OnTitleInput"
                            @onblur="@OnTitleBlur"/>
                    </div>
                }
                else
                {
                    <div class="min-w-0 flex-1">
                        <h2 class="truncate text-xl font-semibold text-slate-900">@Title</h2>
                    </div>
                }
                <div class="flex shrink-0 flex-wrap items-center justify-end gap-2">
                    @if (Document.IsDraft)
                    {
                        <AppButton
                            Size="ComponentSize.Small"
                            Color="@ComponentColor.Default"
                            Variant="ButtonVariant.Outlined"
                            Radius="@ButtonRadius.Full"
                            OnClick="@OnCopyAllClick">
                            <StartContent>
                                <i class="fa-regular fa-copy"></i>
                            </StartContent>
                            <ChildContent>@DashboardLocalizer["Notes_CopyAll"]</ChildContent>
                        </AppButton>
                        <AppButton
                            Size="ComponentSize.Small"
                            Color="@ComponentColor.Primary"
                            Radius="@ButtonRadius.Full"
                            IsLoading="@IsPromotingDraft"
                            Disabled="@(IsSaving || IsDeletingDraft)"
                            OnClick="@OnPromoteDraftClick">
                            <StartContent>
                                <i class="fa-regular fa-folder-open"></i>
                            </StartContent>
                            <ChildContent>@DashboardLocalizer["Notes_SaveToNotes"]</ChildContent>
                        </AppButton>
                        <AppButton
                            IconOnly="true"
                            Size="ComponentSize.Small"
                            Color="@ComponentColor.Danger"
                            Variant="ButtonVariant.Outlined"
                            Radius="@ButtonRadius.Full"
                            IsLoading="@IsDeletingDraft"
                            Disabled="@(IsSaving || IsPromotingDraft)"
                            Title="@DashboardLocalizer["Notes_DeleteDraft"].Value"
                            OnClick="@OnDeleteDraftClick">
                            <i class="fa-regular fa-trash-can"></i>
                        </AppButton>
                    }
                    else if (IsEditing)
                    {
                        <AppButton
                            Size="ComponentSize.Small"
                            Color="@ComponentColor.Default"
                            Variant="ButtonVariant.Outlined"
                            Radius="@ButtonRadius.Full"
                            Disabled="IsSaving"
                            OnClick="@OnCancelClick">
                            <StartContent>
                                <i class="fa-solid fa-xmark"></i>
                            </StartContent>
                            <ChildContent>@DashboardLocalizer["Cancel"]</ChildContent>
                        </AppButton>
                        @if (IsEditingAllowed)
                        {
                            <AppButton
                            Size="ComponentSize.Small"
                            Color="@ComponentColor.Primary"
                            Radius="@ButtonRadius.Full"
                            IsLoading="IsSaving"
                            OnClick="@OnSave">
                            <StartContent>
                                <i class="fa-regular fa-floppy-disk"></i>
                            </StartContent>
                            <ChildContent>@DashboardLocalizer["Save"]</ChildContent>
                            </AppButton>
                        }
                    }
                    else
                    {
                        @if (IsEditingAllowed)
                        {
                            <AppButton
                                Size="ComponentSize.Small"
                                Color="@ComponentColor.Primary"
                                Radius="@ButtonRadius.Full"
                                OnClick="@OnEditClick">
                                <StartContent>
                                    <i class="fa-regular fa-pen-to-square"></i>
                                </StartContent>
                                <ChildContent>@DashboardLocalizer["Edit"]</ChildContent>
                            </AppButton>
                        }
                    }
                </div>
            </div>
        </div>
        @if (IsEffectiveEditing)
        {
            <div class="flex min-h-0 flex-1 flex-col p-4">
                <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                    <label class="block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
                        @DashboardLocalizer["Markdown"]
                    </label>
                    <span class="@SaveStateClass">@SaveStateLabel</span>
                </div>
                <MarkdownEdit
                    @ref="_markdownEdit"
                    Class="flex-1"
                    IsEditMode="true"
                    IsInlineActionsEnabled="false"
                    IsModeTabsVisible="false"
                    Value="@MarkdownContent"
                    ValueChanged="@OnMarkdownChanged"
                    OnBlur="@OnMarkdownBlur"
                    MaxLength="5000000"
                    RowsMin="24"
                    MinHeight="560"
                    Placeholder="@(Document.IsDraft ? DashboardLocalizer["Notes_DraftMarkdownPlaceholder"].Value : DashboardLocalizer["Notes_MarkdownPlaceholder"].Value)"
                    TextAreaName="note-markdown-content" />
            </div>
        }
        else
        {
            <div class="flex min-h-0 flex-1 flex-col p-4">
                <div class="mb-2">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">@DashboardLocalizer["Preview"]</p>
                </div>
                <div class="min-h-[560px] flex-1 overflow-auto rounded-xl bg-white text-slate-700">
                    @if (string.IsNullOrWhiteSpace(MarkdownContent))
                    {
                        <p class="text-sm text-slate-400">@DashboardLocalizer["Notes_EmptyPreview"]</p>
                    }
                    else
                    {
                        @((MarkupString)MarkdownService.ToHtml(MarkdownContent))
                    }
                </div>
            </div>
        }
        @if (!Document.IsDraft)
        {
            @if (IsEditingAllowed)
            {
                <AttachmentsUploadBlock Class="mx-4 mb-4 border-t border-slate-200 pt-4" EntityId="@Document.Id" EntityType="@StorageEntityType.NoteNode" Files="@Document.Attachments" FilesChanged="@AttachmentsChanged" Hint="@DashboardLocalizer["Notes_AttachmentsHint"].Value" />
            }
            else
            {
                <AttachmentsBlock Class="mx-4 mb-4 border-t border-slate-200 pt-4" EntityId="@Document.Id" EntityType="@StorageEntityType.NoteNode" Files="@Document.Attachments" AllowDelete="false" />
            }
        }
    }
</section>
