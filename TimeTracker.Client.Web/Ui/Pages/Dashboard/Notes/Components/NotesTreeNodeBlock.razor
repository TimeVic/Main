@using TimeTracker.Business.Common.Constants.Notes
@using TimeTracker.Client.Core.Ui.Shared.Components.Dropdown
@using TimeTracker.Client.Core.Ui.Shared.Components.Enums

@inherits BaseReactiveComponent

<div class="notes-tree-node">
    <div
        class="@RowClass"
        role="treeitem"
        tabindex="0"
        aria-level="@(Level + 1)"
        aria-expanded="@(IsFolder ? IsExpanded.ToString().ToLowerInvariant() : null)"
        aria-selected="@(IsSelected.ToString().ToLowerInvariant())"
        style="padding-left: @(Level * 14 + 8)px;"
        @onclick="@OnSelect"
        @onkeydown="@OnRowKeyDown">
        @if (IsFolder)
        {
            <button
                type="button"
                class="notes-tree-node-expander flex h-5 w-5 items-center justify-center rounded text-xs text-slate-400 hover:text-slate-600"
                @onclick="@OnToggleExpanded"
                @onclick:stopPropagation="true"
                @onkeydown:stopPropagation="true">
                <i class="fa-solid @(IsExpanded ? "fa-chevron-down" : "fa-chevron-right") text-[9px]"></i>
            </button>
        }
        else
        {
            <span class="inline-block w-5"></span>
        }
        <div class="flex min-w-0 flex-1 items-center gap-1.5 text-left">
            <i class="@IconClass"></i>
            <span class="truncate">@TreeNode.Node.Title</span>
        </div>
        @if (IsEditingAllowed)
        {
            <div @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                <AppDropdown Alignment="DropdownAlignment.Right">
                    <Trigger>
                        <button
                            type="button"
                            class="flex h-6 w-6 items-center justify-center rounded-md text-xs text-slate-500 hover:bg-slate-100">
                            <i class="fa-solid fa-ellipsis-h"></i>
                        </button>
                    </Trigger>
                    <Menu>
                        @if (IsFolder)
                        {
                            <AppDropdownItem OnClick="@(() => CreateFolderRequested.InvokeAsync(TreeNode.Node.Id))">
                                <span class="flex items-center gap-2">
                                    <i class="fa-regular fa-folder w-4 text-xs"></i>
                                    @DashboardLocalizer["NewFolder"]
                                </span>
                            </AppDropdownItem>
                            <AppDropdownItem OnClick="@(() => CreateNoteRequested.InvokeAsync(TreeNode.Node.Id))">
                                <span class="flex items-center gap-2">
                                    <i class="fa-regular fa-note-sticky w-4 text-xs"></i>
                                    @DashboardLocalizer["NewNote"]
                                </span>
                            </AppDropdownItem>
                        }
                        <AppDropdownItem OnClick="@(() => RenameRequested.InvokeAsync(TreeNode.Node))">
                            <span class="flex items-center gap-2">
                                <i class="fa-solid fa-pen w-4 text-xs"></i>
                                @DashboardLocalizer["Rename"]
                            </span>
                        </AppDropdownItem>
                        @if (!IsFolder)
                        {
                            <AppDropdownItem OnClick="@(() => MoveRequested.InvokeAsync(TreeNode.Node))">
                                <span class="flex items-center gap-2">
                                    <i class="fa-solid fa-folder-tree w-4 text-xs"></i>
                                    @DashboardLocalizer["Notes_Move"]
                                </span>
                            </AppDropdownItem>
                        }
                        <AppDropdownItem Color="@ComponentColor.Danger" OnClick="@(() => ArchiveRequested.InvokeAsync(TreeNode.Node))">
                            <span class="flex items-center gap-2">
                                <i class="fa-solid fa-box-archive w-4 text-xs"></i>
                                @DashboardLocalizer["Archive"]
                            </span>
                        </AppDropdownItem>
                    </Menu>
                </AppDropdown>
            </div>
        }
    </div>

    @if (IsFolder && IsExpanded)
    {
        <div class="notes-tree-node-children" role="group">
            @if (TreeNode.Children.Any())
            {
                @foreach (var child in TreeNode.Children)
                {
                    <NotesTreeNodeBlock
                        @key="child.Node.Id"
                        TreeNode="@child"
                        Level="@(Level + 1)"
                        ExpandedNodeIds="@ExpandedNodeIds"
                        SelectedNoteId="@SelectedNoteId"
                        IsEditingAllowed="@IsEditingAllowed"
                        ToggleExpandedRequested="@ToggleExpandedRequested"
                        SelectNodeRequested="@SelectNodeRequested"
                        CreateFolderRequested="@CreateFolderRequested"
                        CreateNoteRequested="@CreateNoteRequested"
                        RenameRequested="@RenameRequested"
                        MoveRequested="@MoveRequested"
                        ArchiveRequested="@ArchiveRequested"/>
                }
            }
            else
            {
                <div class="notes-tree-node-empty py-2 text-xs text-slate-400">
                    @DashboardLocalizer["Notes_EmptyFolder"]
                </div>
            }
        </div>
    }
</div>
