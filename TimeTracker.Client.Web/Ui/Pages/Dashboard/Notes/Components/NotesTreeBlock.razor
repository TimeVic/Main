@using LumexUI.Common
@using TimeTracker.Business.Common.Constants.Notes
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Notes.Models

@inherits BaseReactiveComponent

<aside class="@ContainerClass">
    <div class="border-b border-slate-200 p-4">
        <div class="flex items-center justify-between gap-3">
            <div>
                <p class="text-sm font-semibold text-slate-900">@DashboardLocalizer["Notes"]</p>
                <p class="text-xs text-slate-500">@DashboardLocalizer["Notes_TreeDescription"]</p>
            </div>
            @if (IsEditingAllowed)
            {
                <LumexDropdown>
                <LumexDropdownTrigger>
                    <AppButton
                        IconOnly="true"
                        Size="ComponentSize.Small"
                        Variant="ButtonVariant.Outlined">
                        <i class="fa-solid fa-ellipsis-h"></i>
                    </AppButton>
                </LumexDropdownTrigger>
                <LumexDropdownMenu>
                    <LumexDropdownItem OnClick="@(() => CreateFolderRequested.InvokeAsync(null))">
                        <span class="flex items-center gap-2">
                            <i class="fa-regular fa-folder w-4 text-xs"></i>
                            @DashboardLocalizer["NewFolder"]
                        </span>
                    </LumexDropdownItem>
                    <LumexDropdownItem OnClick="@(() => CreateNoteRequested.InvokeAsync(null))">
                        <span class="flex items-center gap-2">
                            <i class="fa-regular fa-note-sticky w-4 text-xs"></i>
                            @DashboardLocalizer["NewNote"]
                        </span>
                    </LumexDropdownItem>
                </LumexDropdownMenu>
                </LumexDropdown>
            }
        </div>
    </div>

    <div class="p-2">
        @if (IsLoading)
        {
            <div class="space-y-3">
                <AppSkeleton Class="h-9 w-full rounded-xl"/>
                <AppSkeleton Class="h-9 w-10/12 rounded-xl"/>
                <AppSkeleton Class="h-9 w-11/12 rounded-xl"/>
                <AppSkeleton Class="h-9 w-9/12 rounded-xl"/>
                <AppSkeleton Class="h-9 w-full rounded-xl"/>
                <AppSkeleton Class="h-9 w-8/12 rounded-xl"/>
            </div>
        }
        else if (!TreeNodes.Any())
        {
            <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">
                <p>@(ActiveMode == NoteVisibility.Workspace ? DashboardLocalizer["Notes_EmptyWorkspaceDescription"] : DashboardLocalizer["Notes_EmptyPrivateDescription"])</p>
                @if (IsEditingAllowed)
                {
                    <AppButton
                    Class="mt-3"
                    Size="ComponentSize.Small"
                    Color="@ComponentColor.Primary"
                    OnClick="@(() => CreateNoteRequested.InvokeAsync(null))">
                    <StartContent>
                        <i class="fa-solid fa-plus"></i>
                    </StartContent>
                    <ChildContent>@DashboardLocalizer["CreateNote"]</ChildContent>
                    </AppButton>
                }
            </div>
        }
        else
        {
            <div class="space-y-0.5" role="tree">
                @foreach (var treeNode in TreeNodes)
                {
                    <NotesTreeNodeBlock
                        @key="treeNode.Node.Id"
                        TreeNode="@treeNode"
                        Level="0"
                        ExpandedNodeIds="@ExpandedNodeIds"
                        SelectedNoteId="@SelectedNoteId"
                        IsEditingAllowed="@IsEditingAllowed"
                        ToggleExpandedRequested="@ToggleExpandedRequested"
                        SelectNodeRequested="@SelectNodeRequested"
                        CreateFolderRequested="@CreateFolderRequested"
                        CreateNoteRequested="@CreateNoteRequested"
                        RenameRequested="@RenameRequested"
                        MoveRequested="@MoveRequested"
                        ArchiveRequested="@ArchiveRequested"/>
                }
            </div>
        }
    </div>
</aside>
