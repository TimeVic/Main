@page "/board/{WorkspaceId:guid}/notes"
@using LumexUI.Common
@using TimeTracker.Business.Common.Constants.Notes
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Notes.Components
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Notes.Components.Modals
@using TimeTracker.Client.Web.Ui.Shared.Components.Dialogs
@using Layout = TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Layout

@inherits BaseReactiveComponent
@layout Layout

<SeoHead
    Title="@($"TimeVic - {DashboardLocalizer["Notes"]}")"
    Robots="@SiteMetadata.NoIndexRobots" />

@if (CanManageTree)
{
<CreateFolderModal
    IsOpened="State.IsCreateFolderModalOpened"
    IsSaving="State.IsCreatingNode"
    ParentId="State.ActiveParentId"
    Visibility="@ActiveModalVisibility"
    IsOpenedChanged="@OnCreateFolderModalChanged"
    OnSubmit="@CreateFolder"/>

<CreateNoteModal
    IsOpened="State.IsCreateNoteModalOpened"
    IsSaving="State.IsCreatingNode"
    ParentId="State.ActiveParentId"
    Visibility="@ActiveModalVisibility"
    IsOpenedChanged="@OnCreateNoteModalChanged"
    OnSubmit="@CreateDocument"/>

<RenameNoteNodeModal
    IsOpened="@(State.NodeToRename != null)"
    IsSaving="State.IsRenamingNode"
    Node="State.NodeToRename"
    IsOpenedChanged="@OnRenameModalChanged"
    OnSubmit="@RenameNode"/>

<MoveNoteNodeModal
    IsOpened="@(State.NodeToMove != null)"
    IsSaving="State.IsMovingNode"
    Node="State.NodeToMove"
    Nodes="State.FlatNodes"
    IsOpenedChanged="@OnMoveModalChanged"
    OnSubmit="@MoveNode"/>
}

@if (CanManageTree && State.NodeToArchive != null)
{
    <ConfirmationModal
        Title="@DashboardLocalizer["Notes_ArchiveConfirmTitle"].Value"
        Subtitle="@DashboardLocalizer["Notes_ArchiveConfirmSubtitle"].Value"
        ConfirmText="@DashboardLocalizer["Archive"].Value"
        OnClose="@CloseArchiveConfirmation"
        OnCancel="@CloseArchiveConfirmation"
        OnConfirm="@ArchiveNode"/>
}

<section class="space-y-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">@DashboardLocalizer["Notes"]</h1>
            <p class="mt-1 text-sm text-slate-500">@DashboardLocalizer["Notes_PageSubtitle"]</p>
        </div>
        @if (!IsSoloWorkspace)
        {
            <div class="flex flex-wrap items-center gap-3">
                <div class="inline-flex rounded-xl border border-slate-200 bg-slate-100 p-1">
                    <button
                        type="button"
                        class="@GetModeButtonClass(NoteVisibility.Workspace)"
                        title="@DashboardLocalizer["Notes_ModeWorkspace_Subtitle"].Value"
                        @onclick="@(() => SetMode(NoteVisibility.Workspace))">
                        <i class="fa-solid fa-users mr-1.5 text-xs"></i>
                        <span>@DashboardLocalizer["Notes_ModeWorkspace"]</span>
                    </button>
                    <button
                        type="button"
                        class="@GetModeButtonClass(NoteVisibility.Private)"
                        title="@DashboardLocalizer["Notes_ModePrivate_Subtitle"].Value"
                        @onclick="@(() => SetMode(NoteVisibility.Private))">
                        <i class="fa-solid fa-user-lock mr-1.5 text-xs"></i>
                        <span>@DashboardLocalizer["Notes_ModePrivate"]</span>
                    </button>
                </div>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(TreeError))
    {
        <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            @TreeError
        </div>
    }

    <AppCard Class="overflow-hidden border-slate-200 bg-white shadow-sm">
        <AppCardBody Class="p-0">
            <ResizableSplitBlock
                Class="min-h-[720px]"
                DefaultStartPaneWidth="@DefaultTreeWidth"
                MinStartPaneWidth="@MinTreeWidth"
                MaxStartPaneWidth="@MaxTreeWidth"
                HandleLabel="@DashboardLocalizer["Notes_ResizeTreePanel"].Value">
                <StartContent>
                    <NotesTreeBlock
                        ActiveMode="@ActiveMode"
                        TreeNodes="@TreeNodes"
                        ExpandedNodeIds="@State.ExpandedNodeIds"
                        SelectedNoteId="@State.SelectedNoteId"
                        IsLoading="State.IsTreeLoading"
                        IsEmbedded="true"
                        IsEditingAllowed="@CanManageTree"
                        ToggleExpandedRequested="@ToggleExpanded"
                        SelectNodeRequested="@SelectDocument"
                        CreateFolderRequested="@OpenCreateFolderModal"
                        CreateNoteRequested="@OpenCreateNoteModal"
                        RenameRequested="@OpenRenameModal"
                        MoveRequested="@OpenMoveModal"
                        ArchiveRequested="@OpenArchiveConfirmation"/>
                </StartContent>
                <EndContent>
                    <NoteEditorBlock
                        Document="@State.CurrentDocument"
                        Title="@State.EditorTitle"
                        MarkdownContent="@State.EditorMarkdown"
                        Visibility="@State.EditorVisibility"
                        IsLoading="State.IsDocumentLoading"
                        IsSaving="State.IsDocumentSaving"
                        IsDirty="@IsDocumentDirty"
                        IsEditing="State.IsEditingDocument"
                        IsEditingAllowed="@CanEditDocument"
                        IsEmbedded="true"
                        SaveStateLabel="@SaveStateLabel"
                        SaveStateClass="@SaveStateClass"
                        AttachmentsChanged="@OnAttachmentsChanged"
                        TitleChanged="@OnTitleChanged"
                        MarkdownContentChanged="@OnMarkdownChanged"
                        OnEdit="@StartDocumentEditing"
                        OnCancel="@CancelDocumentEditing"
                        OnSave="@SaveDocument"/>
                </EndContent>
            </ResizableSplitBlock>
        </AppCardBody>
    </AppCard>
</section>
