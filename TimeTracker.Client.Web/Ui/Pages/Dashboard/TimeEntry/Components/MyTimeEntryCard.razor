@using TimeTracker.Business.Common.Constants
@using TimeTracker.Business.Extensions
@using TimeTracker.Client.Core.Ui.Shared.Components.Dropdown
@using TimeTracker.Client.Core.Ui.Shared.Components.Popover
@using TimeTracker.Client.Core.Ui.Shared.Components.Enums

<div class="group flex h-[46px] @(CanEditOrDelete ? "cursor-pointer" : "cursor-default") items-center gap-3 border-b border-slate-100 bg-white px-4 py-2 text-sm transition-colors hover:border-blue-200 hover:bg-blue-50"
     @onclick="@(() => { if (CanEditOrDelete) OnEdit.InvokeAsync(Entry); })">

    @* Description (or task title fallback) — takes all remaining space *@
    <span class="min-w-0 flex-1 truncate @(string.IsNullOrWhiteSpace(Entry.Description) && Entry.Task == null ? "text-slate-300" : "text-slate-700")">
        @GetDescriptionOrTaskTitle()
    </span>

    @* Project name — right-aligned, secondary text *@
    <span class="hidden sm:block shrink-0 text-xs font-medium text-slate-500">
        @GetProjectLabel()
    </span>

    @* Indicators *@
    <div class="hidden md:flex shrink-0 items-center gap-1" @onclick:stopPropagation="true">
        <TimeEntryApprovalStatusBlock
            Entry="@Entry"
            IsApprovalsEnabled="@IsTeamWorkspace" />

        @if (Entry.Task != null)
        {
            <button
                type="button"
                @onclick="@(() => OnOpenTask.InvokeAsync(Entry))"
                class="inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-xs font-medium text-blue-600 hover:bg-blue-100">
                <i class="fa-regular fa-square-check"></i>
                @Entry.Task.FormattedId
            </button>
        }
        @if (Entry.IsSynced)
        {
            <AppPopover Color="ComponentColor.Primary">
                <Trigger>
                    <span class="inline-flex cursor-pointer items-center rounded px-1.5 py-0.5 text-xs font-medium text-emerald-600 hover:bg-emerald-50">
                        <i class="fa-solid fa-rotate"></i>
                    </span>
                </Trigger>
                <Content>
                    @DashboardLocalizer["SynchronizedExternalService"]
                </Content>
            </AppPopover>
        }
        @if (Entry.IsBillable)
        {
            <AppPopover>
                <Trigger>
                    <span class="inline-flex cursor-pointer items-center rounded px-1.5 py-0.5 text-xs font-semibold text-emerald-600 hover:bg-emerald-50">
                        <i class="fa-solid fa-dollar-sign"></i>
                    </span>
                </Trigger>
                <Content>
                    <div class="min-w-[200px] space-y-2 p-3">
                        <div>
                            <p class="text-sm font-semibold text-slate-900">@DashboardLocalizer["Billable"]</p>
                            <p class="text-xs text-slate-500">@DashboardLocalizer["CalculatedTimeEntryValue"]</p>
                        </div>
                        @if (Entry.HourlyRate.HasValue)
                        {
                            <div>
                                <p class="text-[11px] font-medium uppercase tracking-wide text-slate-400">@DashboardLocalizer["Amount"]</p>
                                <p class="text-base font-semibold text-slate-900">@GetBillableAmountLabel()</p>
                            </div>
                            <div class="flex justify-between text-xs text-slate-500">
                                <span>@DashboardLocalizer["Rate"]</span>
                                <span class="font-medium text-slate-700">@GetHourlyRateLabel()/h</span>
                            </div>
                        }
                        else
                        {
                            <div class="rounded border border-amber-200 bg-amber-50 px-2 py-1.5 text-xs text-amber-900">
                                @DashboardLocalizer["HourlyRateNotSet"]
                            </div>
                        }
                        <div class="flex justify-between text-xs text-slate-500">
                            <span>@DashboardLocalizer["Tracked"]</span>
                            <span class="font-medium text-slate-700">@_timeParsingService.TimeSpanToTimeString(Entry.Duration, true)</span>
                        </div>
                    </div>
                </Content>
            </AppPopover>
        }
        @if (Entry.TimeZone != CurrentTimeZone)
        {
            <AppPopover>
                <Trigger>
                    <span class="inline-flex cursor-pointer items-center rounded px-1.5 py-0.5 text-xs text-slate-400 hover:bg-slate-100">
                        <i class="fa-solid fa-earth-africa"></i>
                    </span>
                </Trigger>
                <Content>@Entry.TimeZone</Content>
            </AppPopover>
        }
    </div>

    @* Time range — displayed in the current workspace timezone *@
    <div class="hidden sm:flex shrink-0 items-center gap-1 font-mono text-xs text-slate-400">
        <span>@_timeParsingService.DateTimeToTimeString(GetStartTimeInWorkspaceTz())</span>
        <span>-</span>
        <span>@_timeParsingService.DateTimeToTimeString(GetEndTimeInWorkspaceTz())</span>
    </div>

    @* Duration *@
    <span class="w-16 shrink-0 text-right font-mono text-sm font-semibold text-slate-700">
        @if (Entry.IsAutostopped)
        {
            <span class="mr-1 text-amber-600" title="@DashboardLocalizer["TimeEntry_Autostopped"]">⚠️</span>
        }
        @_timeParsingService.TimeSpanToTimeString(Entry.Duration, true)
    </span>

    @* Actions *@
    <div class="shrink-0 flex items-center gap-1" @onclick:stopPropagation="true">
        @if (CanSubmitForApproval)
        {
            <AppButton
                OnClick="@(() => OnSubmitForApproval.InvokeAsync(Entry))"
                Size="ComponentSize.Small"
                Color="ComponentColor.Primary"
                Variant="ButtonVariant.Light"
                IconOnly="true"
                Title="@DashboardLocalizer["Approvals_Card_SubmitSingle"].Value">
                <ChildContent>
                    <i class="fa-solid fa-paper-plane text-blue-600"></i>
                </ChildContent>
            </AppButton>
        }
        <AppButton
            OnClick="@(() => OnClone.InvokeAsync(Entry))"
            Size="ComponentSize.Small"
            Color="ComponentColor.Default"
            Variant="ButtonVariant.Light"
            IconOnly="true">
            <ChildContent>
                <i class="fa-regular fa-circle-play text-slate-400"></i>
            </ChildContent>
        </AppButton>
        <AppDropdown Alignment="DropdownAlignment.Right">
            <Trigger>
                <AppButton
                    IconOnly="true"
                    Size="ComponentSize.Small"
                    Variant="ButtonVariant.Light">
                    <i class="fa-solid fa-ellipsis-v text-slate-400"></i>
                </AppButton>
            </Trigger>
            <Menu>
                @if (CanSubmitForApproval)
                {
                    <AppDropdownItem OnClick="@(() => OnSubmitForApproval.InvokeAsync(Entry))">
                        <span class="flex items-center gap-2 @(IsOwner ? "text-emerald-600" : "text-blue-600")">
                            @if (IsOwner)
                            {
                                <i class="fa-solid fa-circle-check w-4"></i>
                                <span>@DashboardLocalizer["Approvals_Card_ApproveSingle"]</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-paper-plane w-4"></i>
                                <span>@DashboardLocalizer["Approvals_Card_SubmitSingle"]</span>
                            }
                        </span>
                    </AppDropdownItem>
                }
                @if (CanEditOrDelete)
                {
                    <AppDropdownItem OnClick="@(() => OnEdit.InvokeAsync(Entry))">
                        <span class="flex items-center gap-2">
                            <i class="fa-regular fa-pen-to-square w-4"></i>
                            <span>@DashboardLocalizer["Edit"]</span>
                        </span>
                    </AppDropdownItem>
                }
                <AppDropdownItem OnClick="@(() => OnClone.InvokeAsync(Entry))">
                    <span class="flex items-center gap-2">
                        <i class="fa-regular fa-clone w-4"></i>
                        <span>@DashboardLocalizer["Duplicate"]</span>
                    </span>
                </AppDropdownItem>
                @if (CanDelete)
                {
                    <AppDropdownItem
                        Color="@ComponentColor.Danger"
                        OnClick="@(() => OnDelete.InvokeAsync(Entry))">
                        <span class="flex items-center gap-2">
                            <i class="fa-regular fa-trash-can w-4"></i>
                            <span>@DashboardLocalizer["Delete"]</span>
                        </span>
                    </AppDropdownItem>
                }
            </Menu>
        </AppDropdown>
    </div>
</div>
