@using LumexUI
@using LumexUI.Common
@using TimeTracker.Business.Common.Constants
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Report.Shared
@inherits BaseReactiveComponent

@if (IsApprovalsEnabled && _summary != null && _summary.HasDraftEntries)
{
    <div class="mb-4 flex flex-col gap-3 rounded-2xl border border-blue-200 bg-blue-50/80 px-4 py-3.5 shadow-2xs sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3 min-w-0">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-blue-700">
                <i class="fa-solid fa-clock-rotate-left text-sm"></i>
            </div>
            <div class="min-w-0">
                <p class="text-xs font-semibold text-blue-950 sm:text-sm">
                    @GetBannerText()
                </p>
            </div>
        </div>

        <div class="shrink-0 flex items-center gap-2">
            <CustomButton
                Color="@(IsOwner ? ThemeColor.Success : ThemeColor.Primary)"
                Variant="Variant.Solid"
                Size="Size.Small"
                Radius="@Radius.Medium"
                Disabled="@_isSubmitting"
                OnClick="@OnSubmitForApproval">
                @if (_isSubmitting)
                {
                    <LumexSpinner Size="Size.Small" Color="ThemeColor.Default" Class="mr-1.5" />
                }
                else if (IsOwner)
                {
                    <i class="fa-solid fa-circle-check mr-1.5 text-xs"></i>
                }
                else
                {
                    <i class="fa-solid fa-paper-plane mr-1.5 text-xs"></i>
                }
                <span>
                    @(IsOwner ? DashboardLocalizer["Approvals_Banner_ApproveButton"] : DashboardLocalizer["Approvals_Banner_SubmitButton"])
                </span>
            </CustomButton>
        </div>
    </div>
}
