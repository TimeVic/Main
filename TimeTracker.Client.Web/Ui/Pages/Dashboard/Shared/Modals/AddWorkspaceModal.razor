@inherits BaseReactiveComponent

<AppModalHeader
    Title="@DashboardLocalizer["AddWorkspaceModal_Title"]"
    Description="@DashboardLocalizer["AddWorkspaceModal_Description"]"
    Icon="fa-solid fa-briefcase" />
<AppModalBody
    Class="pt-3">
    <EditForm
        Context="form"
        @ref="_form"
        Model="@model"
        OnValidSubmit="@Submit"
        novalidate>
        <DataAnnotationsValidator/>
        <button
            type="submit"
            class="sr-only"
            tabindex="-1"
            aria-hidden="true">
            @DashboardLocalizer["Submit"]
        </button>
        
        <div
            class="pt-1">
            <InputTextField
                FullWidth="true"
                Label="@DashboardLocalizer["UpdateWorkspaceForm_WorkspaceName"]"
                IsShowEmojiButton="true"
                @bind-Value="model.Name"/>
        </div>
    </EditForm>
</AppModalBody>
<AppModalFooter>
    <AppButton
        FullWidth="@true"
        OnClick="@Submit"
        IsLoading="_isLoading"
        Color="@ComponentColor.Primary"
        Radius="@ButtonRadius.Full">
        <StartContent>
            <i
                class="fa-solid fa-plus"></i>
        </StartContent>
        <ChildContent>
            @DashboardLocalizer["Add"]
        </ChildContent>
    </AppButton>
</AppModalFooter>

