@using LumexUI
@using LumexUI.Common
@using TimeTracker.Business.Common.Constants.Task
@using TimeTracker.Business.Common.Constants.Storage
@using TimeTracker.Business.Common.Constants
@using TimeTracker.Business.Extensions
@using TimeTracker.Client.Core.Constants.Ui
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Tasks.Comments
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Tasks.Parts
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.TimeEntry.Manage
@using TaskStatus = TimeTracker.Business.Common.Constants.Task.TaskStatus;

@inherits BaseReactiveComponent

@if (_isLoading)
{
    <div class="flex justify-center py-12"><LumexSpinner Size="@Size.Large" /></div>
}
else if (!string.IsNullOrEmpty(_task.TaskList?.Name))
{
    <div @ref="_attachmentDropZone" class="task-detail-workspace relative">
        <InputFile
            @ref="_attachmentInput"
            class="hidden"
            OnChange="OnAttachmentsInputFileChange"
            multiple
            accept="@_attachmentAcceptTypes" />
        @if (_timeEntryToEdit != null)
        {
            <EditTimeEntryModal
                Entry="@_timeEntryToEdit"
                OnClose="@(() => _timeEntryToEdit = null)" />
        }
        @if (_isDragActive)
        {
            <div class="pointer-events-none absolute inset-0 z-20 flex items-center justify-center rounded-lg border-2 border-dashed border-blue-500 bg-blue-50/80 text-blue-600">
                <i class="fa-solid fa-cloud-arrow-up text-3xl"></i>
            </div>
        }

        <EditForm
            @ref="_form"
            EditContext="_editContext"
            novalidate>
            <DataAnnotationsValidator />
            <div class="border-b border-slate-200 @TabsContainerClass">
                <nav class="flex flex-wrap gap-x-4" aria-label="@DashboardLocalizer["TaskDetail_Tabs"]">
                    @foreach (var tab in TaskDetailTab.All)
                    {
                        <button type="button" @onclick="@(() => OnTabSelected(tab))" class="-mb-px shrink-0 border-b-2 px-1 py-3 text-sm font-medium transition @GetTabClass(tab)">
                            @DashboardLocalizer[tab.ResourceKey]
                        </button>
                    }
                </nav>
            </div>

            <div class="grid min-h-[30rem] lg:grid-cols-[minmax(0,1fr)_17rem]">
                <main class="@MainContentClass">
                    @if (_activeTab == TaskDetailTab.Overview)
                    {
                        <section>
                            <div class="border-y border-slate-100 py-4">
                                <TaskEstimateSummaryBlock
                                    IsCompact="true"
                                    PlannedDuration="_model.OriginalEstimate"
                                    TrackedDuration="_task.TrackedDuration"
                                    ExternalSourceType="_task.ExternalSourceType" />
                            </div>
                        </section>
                        <section class="mt-6">
                            <div class="mb-2">
                                <label class="text-sm font-semibold text-slate-800">@DashboardLocalizer["Description"]</label>
                            </div>
                            <MarkdownEdit
                                IsEditMode="@string.IsNullOrWhiteSpace(_model.Description)"
                                Value="@_model.Description"
                                ValueChanged="@OnDescriptionChanged"
                                Placeholder="@DashboardLocalizer["TaskDescription"].Value"
                                RowsMin="4" />
                            <AttachmentsBlock
                                Class="mt-4"
                                ListClass="flex flex-wrap gap-3"
                                PreviewItemClass="relative flex h-24 w-24 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-slate-200 bg-slate-50"
                                EntityId="@TaskId"
                                EntityType="@StorageEntityType.Task"
                                Files="@TaskAttachments"
                                UploadingFiles="@_uploadingAttachments"
                                FilesChanged="@OnAttachmentsChanged" />
                        </section>
                    }
                    else if (_activeTab == TaskDetailTab.Comments)
                    {
                        <TaskCommentsBlock Task="@_task" />
                    }
                    else if (_activeTab == TaskDetailTab.TimeEntries)
                    {
                        <PaginatedItemsListBlock
                            Items="@TaskTimeEntries"
                            IsLoading="@_isTaskTimeEntriesLoading"
                            IsHasMore="@_isTaskTimeEntriesHasMore"
                            OnLoadMore="LoadMoreTaskTimeEntries"
                            LoadMoreText="@DashboardLocalizer["TaskComments_LoadMore"].Value">
                            <EmptyContent>
                                <TaskDetailEmptyState Title="@DashboardLocalizer["TaskDetail_NoTimeEntries"].Value" />
                            </EmptyContent>
                            <ItemTemplate Context="entry">
                                <div class="flex items-center justify-between gap-4 py-3">
                                    <div class="min-w-0">
                                        <p class="text-sm font-medium text-slate-800">@entry.StartTimeOffset.ToString("MMM d, yyyy")</p>
                                        <p class="mt-1 truncate text-xs text-slate-500">@(entry.Project?.Name ?? _task.TaskList.Project.Name)</p>
                                    </div>
                                    <div class="flex shrink-0 items-center gap-3">
                                        <span class="text-sm font-semibold text-slate-700">@entry.Duration.ToReadableShortString()</span>
                                        <button type="button" class="text-xs font-medium text-blue-600" @onclick="@(() => _timeEntryToEdit = entry)">@DashboardLocalizer["Edit"]</button>
                                    </div>
                                </div>
                            </ItemTemplate>
                        </PaginatedItemsListBlock>
                    }
                    else
                    {
                        <section>
                            <AttachmentsUploadBlock
                                EntityId="@TaskId"
                                EntityType="@StorageEntityType.Task"
                                Files="@TaskAttachments"
                                FilesChanged="@OnAttachmentsChanged"
                                Hint="@DashboardLocalizer["Notes_AttachmentsHint"].Value" />
                        </section>
                    }
                </main>

                <aside class="@SidebarClass">
                    <section>
                        <div class="border-l-2 border-blue-500 pl-2">
                            <h3 class="text-sm font-semibold text-slate-800">@DashboardLocalizer["TaskDetail_Details"]</h3>
                        </div>
                        <div class="mt-4 flex flex-col gap-3">
                        <EnumDropDown
                            TItem="TaskStatus"
                            Label="@DashboardLocalizer["Status"]"
                            Value="_model.Status"
                            Size="Size.Small"
                            ValueChanged="OnStatusChanged" />
                        <EnumDropDown
                            TItem="TaskPriority"
                            Label="@DashboardLocalizer["Priority"]"
                            Value="_model.Priority"
                            Size="Size.Small"
                            ValueChanged="OnPriorityChanged" />
                        <MembersDropDown
                            Type="DropDownType.Select"
                            Label="@DashboardLocalizer["UpdateTaskForm_Assigned"]"
                            UserId="_model.UserId"
                            Size="Size.Small"
                            SelectedItemChanged="OnAssignedChanged"
                            AllowedIds="_allowedUserIds" />
                        <div class="border-l border-slate-200 pl-2.5"><p class="text-xs font-medium text-slate-500">@DashboardLocalizer["Project"]</p><p class="mt-1 text-sm font-medium text-slate-800">@_task.TaskList.Project.Name</p></div>
                        <TaskListDropDown
                            Label="@DashboardLocalizer["TaskList"]"
                            Variant="InputVariant.Outlined"
                            LabelPlacement="LabelPlacement.Outside"
                            ProjectId="@_task.TaskList.Project.Id"
                            Value="@_model.TaskListId"
                            Disabled="@_tasksState.Value.IsTaskSaving"
                            FullWidth="true"
                            Size="Size.Small"
                            SelectedItemChanged="@OnTaskListChanged" />
                        <TagsDropDown
                            Label="@DashboardLocalizer["Tags"]"
                            Value="_model.TagIds"
                            Size="Size.Small"
                            ValueChanged="OnTagsChanged" />
                        <div class="border-l border-slate-200 pl-2.5"><p class="text-xs font-medium text-slate-500">@DashboardLocalizer["TaskId"]</p><p class="mt-1 font-mono text-xs font-medium text-slate-700">@_task.FormattedId</p></div>
                        </div>
                    </section>
                    <section class="mt-6 border-t border-slate-200 pt-5">
                        <div class="border-l-2 border-blue-500 pl-2">
                            <h3 class="text-sm font-semibold text-slate-800">@DashboardLocalizer["TaskDetail_Tracking"]</h3>
                        </div>
                        <div class="mt-4 flex flex-col gap-3">
                        <DurationInput
                            Label="@EstimateInputLabel"
                            Placeholder="1h 30m"
                            FullWidth="true"
                            Size="Size.Small"
                            @bind-Value="_model.OriginalEstimate" />
                        <TaskEstimateSummaryBlock
                            IsCompact="true"
                            Class="rounded-lg bg-slate-100/70 px-3 py-2"
                            PlannedDuration="_model.OriginalEstimate"
                            TrackedDuration="_task.TrackedDuration" />
                        </div>
                    </section>
                    @if (_task.ExternalSourceType == ExternalSourceType.Jira)
                    {
                        <section class="mt-6 border-t border-slate-200 pt-5">
                            <div class="border-l-2 border-blue-500 pl-2">
                                <h3 class="text-sm font-semibold text-slate-800">@DashboardLocalizer["TaskDetail_Integrations"]</h3>
                            </div>
                            <p class="mt-3 text-sm text-slate-700"><i class="fa-brands fa-jira mr-1 text-blue-600"></i>@DashboardLocalizer["TaskDetail_JiraSynced"]</p>
                        </section>
                    }
                </aside>
            </div>
        </EditForm>
    </div>
}
