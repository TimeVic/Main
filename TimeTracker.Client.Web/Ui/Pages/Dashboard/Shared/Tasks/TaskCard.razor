            @*             BadgeStyle="@Task.Priority.GetChipStyle()"> *@
            @*             @Task.Priority.GetDisplayName() *@
            @*         </MudChip> *@
            @*     </ActivatorContent> *@
            @*     <ChildContent> *@
            @*         @foreach (var priority in _priorities) *@
            @*         { *@
            @*             <MudMenuItem *@
            @*                 OnClick="() => OnSelectTaskPriority(priority)" *@
