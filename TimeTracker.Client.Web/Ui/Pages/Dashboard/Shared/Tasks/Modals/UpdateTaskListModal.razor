@using LumexUI.Common

@inherits BaseReactiveComponent

<LumexModal
    Open="IsOpened"
    OnClose="@OnCloseModal"
    Size="ModalSize.Large"
    @ref="_modal">
    <LumexModalContent>
        <LumexModalHeader Class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                <i class="fa-regular fa-pen-to-square"></i>
            </div>
            <div>
                <h3 class="text-2xl font-medium text-slate-900">@DashboardLocalizer["UpdateTaskListModal_Title"]</h3>
                <p class="mt-1 text-sm text-slate-500">@TaskList.Project.Name</p>
            </div>
        </LumexModalHeader>
        <LumexModalBody Class="pt-3">
            <EditForm
                Context="form"
                @ref="_form"
                Model="@_model"
                OnValidSubmit="@Submit"
                novalidate>
                <DataAnnotationsValidator/>
                <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">@DashboardLocalizer["Update"]</button>

                <div class="pt-1">
                    <InputTextField
                        FullWidth="true"
                        Label="@DashboardLocalizer["Name"].Value"
                        Placeholder="@DashboardLocalizer["UpdateTaskListModal_NamePlaceholder"].Value"
                        Variant="InputVariant.Outlined"
                        @bind-Value="_model.Name"/>
                </div>
            </EditForm>
        </LumexModalBody>
        <LumexModalFooter>
            <CustomButton
                FullWidth="@true"
                OnClick="@Submit"
                Disabled="_isLoading"
                Color="@ThemeColor.Primary"
                Radius="@Radius.Full">
                @DashboardLocalizer["Update"]
            </CustomButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
