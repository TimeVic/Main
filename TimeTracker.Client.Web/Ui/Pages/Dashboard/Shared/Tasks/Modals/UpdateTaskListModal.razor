@inherits BaseReactiveComponent

<AppModalHeader
    Title="@DashboardLocalizer["UpdateTaskListModal_Title"]"
    Description="@TaskList.Project.Name"
    Icon="fa-regular fa-pen-to-square" />
<AppModalBody Class="pt-3">
    <EditForm
        Context="form"
        @ref="_form"
        Model="@_model"
        OnValidSubmit="@Submit"
        novalidate>
        <DataAnnotationsValidator/>
        <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">@DashboardLocalizer["Update"]</button>

        <div class="pt-1">
            <InputTextField
                FullWidth="true"
                Label="@DashboardLocalizer["Name"].Value"
                Placeholder="@DashboardLocalizer["UpdateTaskListModal_NamePlaceholder"].Value"
                @bind-Value="_model.Name"/>
        </div>
    </EditForm>
</AppModalBody>
<AppModalFooter>
    <AppButton
        Color="@ComponentColor.Default"
        Variant="@ButtonVariant.Outlined"
        Radius="@ButtonRadius.Medium"
        OnClick="@(() => ModalInstance?.Close(AppModalResult.Cancel()))">
        @DashboardLocalizer["Cancel"]
    </AppButton>
    <AppButton
        OnClick="@Submit"
        Disabled="_isLoading"
        Color="@ComponentColor.Primary"
        Radius="@ButtonRadius.Medium">
        @DashboardLocalizer["Update"]
    </AppButton>
</AppModalFooter>
