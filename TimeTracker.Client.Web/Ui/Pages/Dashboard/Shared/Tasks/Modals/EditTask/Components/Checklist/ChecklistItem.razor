@using TimeTracker.Api.Shared.Dto.Entity.Task
@inherits BaseComponent

<div
    class="group flex items-center gap-2 py-1.5 px-2 rounded-md hover:bg-slate-50 transition-colors duration-150 min-w-0 @(IsDragging ? "opacity-30 bg-slate-100" : "") @(IsDropTarget ? "border-t-2 border-blue-500" : "")"
    draggable="@(!_isEditing ? "true" : "false")"
    @ondragstart="HandleDragStart"
    @ondragover:preventDefault="true"
    @ondragover="HandleDragOver"
    @ondrop="HandleDrop"
    @ondragend="HandleDragEnd">

    <div class="text-slate-400 opacity-0 group-hover:opacity-60 hover:!opacity-100 cursor-grab active:cursor-grabbing transition-opacity p-0.5 select-none shrink-0"
         title="@DashboardLocalizer["Checklist_DragTooltip"].Value">
        <i class="fa-solid fa-grip-vertical text-xs"></i>
    </div>

    <input
        type="checkbox"
        checked="@SubTask.IsCompleted"
        @onchange="ToggleCompleted"
        class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 focus:ring-offset-0 cursor-pointer transition-colors accent-blue-600 shrink-0" />

    @if (_isEditing)
    {
        <input
            @ref="_editInputRef"
            type="text"
            class="flex-1 min-w-0 text-sm text-slate-800 bg-white border border-blue-400 focus:ring-2 focus:ring-blue-500/20 rounded px-2 py-0.5 outline-none"
            value="@_editingTitle"
            @oninput="HandleEditInput"
            @onkeydown="HandleEditKeyDown"
            @onblur="SaveEdit"
            maxlength="512" />
    }
    else
    {
        <span
            class="@(SubTask.IsCompleted ? "text-sm text-slate-400 line-through flex-1 min-w-0 leading-relaxed select-none break-all transition-all cursor-pointer" : "text-sm text-slate-700 flex-1 min-w-0 leading-relaxed select-none break-all cursor-pointer")"
            @onclick="StartEdit">
            @SubTask.Title
        </span>
    }

    @if (!_isEditing)
    {
        <button
            type="button"
            class="opacity-0 group-hover:opacity-60 hover:!opacity-100 text-slate-400 hover:text-red-600 transition-all p-1 rounded hover:bg-red-50 ml-auto shrink-0 cursor-pointer"
            @onclick="Delete"
            title="@DashboardLocalizer["Checklist_DeleteTooltip"].Value">
            <i class="fa-regular fa-trash-can text-xs"></i>
        </button>
    }
</div>
