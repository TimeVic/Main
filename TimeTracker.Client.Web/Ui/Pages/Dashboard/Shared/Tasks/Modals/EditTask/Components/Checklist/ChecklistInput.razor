@inherits BaseComponent

<div class="relative flex items-center w-full">
    <input
        @ref="_inputRef"
        type="text"
        class="w-full bg-slate-50 border border-slate-200 focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 rounded-xl px-3 py-2 text-sm transition-all duration-150 outline-none text-slate-800 placeholder:text-slate-400 pr-9 @Class"
        placeholder="@DashboardLocalizer["Checklist_InputPlaceholder"].Value"
        value="@_title"
        @oninput="HandleInput"
        @onkeydown="HandleKeyDown"
        disabled="@IsDisabled" />

    @if (!string.IsNullOrWhiteSpace(_title))
    {
        <button
            type="button"
            class="absolute right-2 text-slate-400 hover:text-blue-600 p-1 rounded-md transition-colors"
            @onclick="Submit">
            <i class="fa-solid fa-plus text-xs"></i>
        </button>
    }
</div>
