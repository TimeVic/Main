@inherits BaseComponent

<div class="mt-2 @Class">
    <input
        @ref="_inputRef"
        type="text"
        class="w-full text-sm py-1.5 px-3 rounded-md bg-transparent border border-dashed border-slate-300 text-slate-700 placeholder:text-slate-400 focus:bg-white focus:border-solid focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-all"
        placeholder="@DashboardLocalizer["Checklist_InputPlaceholder"].Value"
        @bind="_title"
        @bind:event="oninput"
        @onkeydown="HandleKeyDown"
        maxlength="512"
        disabled="@IsDisabled" />
</div>
