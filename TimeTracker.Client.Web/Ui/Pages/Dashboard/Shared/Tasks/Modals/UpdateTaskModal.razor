@using LumexUI
@using LumexUI.Common
@using TimeTracker.Business.Extensions
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Tasks.Forms
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Tasks.Parts

@inherits BaseReactiveComponent

<div class="update-task-modal">
    <LumexModal 
        Open="IsOpened" 
        OnClose="@OnCloseModal"
        Placement="ModalPlacement.Auto"
        Size="ModalSize.Large"
        ScrollBehavior="ScrollBehavior.Inside"
        OpenChanged="@OnOpenChanged"
        @ref="modal">
        <LumexModalContent>
            <LumexModalHeader Class="flex items-center gap-3">
                <div class="flex w-full min-w-0 items-start justify-between gap-3">
                    <div class="flex min-w-0 items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                            <i class="fa-regular fa-pen-to-square"></i>
                        </div>
                        <div class="min-w-0">
                            <h3 class="truncate text-lg font-semibold text-slate-900">@Task.Title</h3>
                            <p class="mt-1 truncate text-sm text-slate-500">@Task.TaskList.Project.Name · @Task.TaskList.Name</p>
                        </div>
                    </div>
                    <div class="mr-8 shrink-0">
                        <TaskTimeTrackerButton Task="@Task" />
                    </div>
                </div>
            </LumexModalHeader>
            <LumexModalBody Class="pt-3">
                <TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Tasks.Forms.UpdateTaskForm TaskId="Task.Id"/>
            </LumexModalBody>
        </LumexModalContent>
    </LumexModal>
</div>
