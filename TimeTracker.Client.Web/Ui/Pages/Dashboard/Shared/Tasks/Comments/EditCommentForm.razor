@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.RequestsAndResponses.Dashboard.Tasks.Comments
@using TimeTracker.Business.Extensions
@using TimeTracker.Client.Web.Ui.Shared.Components.Dialogs

@inherits BaseReactiveComponent

@if (_isDeleteConfirmationOpen)
{
    <ConfirmationModal
        Title="@DashboardLocalizer["TaskComment_DeleteTitle"].Value"
        Subtitle="@DashboardLocalizer["TaskComment_DeleteSubtitle"].Value"
        ConfirmText="@DashboardLocalizer["Delete"].Value"
        OnClose="@CloseDeleteConfirmation"
        OnCancel="@CloseDeleteConfirmation"
        OnConfirm="@OnConfirmDelete" />
}

<article class="@ContainerClass">
    @if (!_isNewComment)
    {
        <div class="flex gap-3">
            <UserAvatarBlock
                User="@Comment.User"
                SizeClass="h-9 w-9" />
            <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <p class="truncate text-sm font-semibold text-slate-900">@AuthorName</p>
                    <span class="text-xs text-slate-400">@FormattedCreatedAt</span>
                </div>

                @if (IsEditorVisible)
                {
                    @EditFormContent
                }
                else
                {
                    <MarkdownContent
                        Class="task-comment-body mt-2"
                        Content="@Comment.Comment" />
                    @if (Comment.Watchers.Any())
                    {
                        <div class="mt-3 flex flex-wrap items-center gap-1.5">
                            <span class="text-xs text-slate-400">@DashboardLocalizer["TaskComment_Subscribers"]:</span>
                            @foreach (var watcher in Comment.Watchers)
                            {
                                <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600">
                                    <UserAvatarBlock
                                        User="@watcher"
                                        SizeClass="h-4 w-4"
                                        Class="text-[8px]" />
                                    @watcher.Name
                                </span>
                            }
                        </div>
                    }
                    @if (_canEdit)
                    {
                        <div class="mt-3 flex items-center gap-1">
                            <button
                                type="button"
                                class="inline-flex h-7 w-7 items-center justify-center rounded-md text-slate-400 transition hover:bg-slate-100 hover:text-blue-700"
                                @onclick="OnClickEdit"
                                title="@DashboardLocalizer["Edit"]"
                                aria-label="@DashboardLocalizer["Edit"]">
                                <i class="fa-regular fa-pen-to-square"></i>
                            </button>
                            <button
                                type="button"
                                class="inline-flex h-7 w-7 items-center justify-center rounded-md text-slate-400 transition hover:bg-red-50 hover:text-red-600"
                                @onclick="OpenDeleteConfirmation"
                                title="@DashboardLocalizer["Delete"]"
                                aria-label="@DashboardLocalizer["Delete"]">
                                <i class="fa-regular fa-trash-can"></i>
                            </button>
                        </div>
                    }
                }
            </div>
        </div>
    }
    else
    {
        <div class="flex gap-3">
            <UserAvatarBlock
                User="@AuthState.Value.User"
                SizeClass="h-9 w-9" />
            <div class="min-w-0 flex-1">
                @EditFormContent
            </div>
        </div>
    }
</article>

@code
{
    private RenderFragment EditFormContent => @<EditForm
        @ref="_form"
        EditContext="_editContext"
        novalidate>
        <DataAnnotationsValidator />

        <MarkdownEdit
            IsEditMode="true"
            IsInlineActionsEnabled="false"
            Value="@_model.Comment"
            ValueChanged="@OnCommentChanged"
            Placeholder="@DashboardLocalizer["TaskComment_Placeholder"].Value"
            RowsMin="@(_isNewComment ? 2 : 3)"
            MinHeight="90" />
        
        @if (_isSubscribersSelectAvailable)
        {
            <MultipleUsersDropDown
                Class="mt-3"
                Label="@DashboardLocalizer["TaskComment_Subscribers"].Value"
                Placeholder="@DashboardLocalizer["TaskComment_SelectSubscribers"].Value"
                Project="@Project"
                @bind-Value="@_model.WatcherIds" />
        }

        <div class="mt-3 flex flex-wrap items-center gap-2">
            <CustomButton
                Size="Size.Small"
                Color="ThemeColor.Primary"
                IsLoading="@_isLoading"
                Disabled="@IsCommentEmpty"
                OnClick="@Submit">
                <StartContent>
                    <i class="fa-regular fa-floppy-disk text-xs"></i>
                </StartContent>
                <ChildContent>@SubmitButtonText</ChildContent>
            </CustomButton>
            @if (!_isNewComment)
            {
                <CustomButton
                    Size="Size.Small"
                    Variant="Variant.Outlined"
                    Color="ThemeColor.Default"
                    Disabled="@_isLoading"
                    OnClick="@ResetForm">
                    @DashboardLocalizer["Cancel"]
                </CustomButton>
            }
        </div>
    </EditForm>;
}
