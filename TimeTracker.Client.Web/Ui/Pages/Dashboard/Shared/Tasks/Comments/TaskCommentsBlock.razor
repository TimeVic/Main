@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity.Task

@inherits BaseReactiveComponent

<section class="min-w-0">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h4 class="text-sm font-semibold text-slate-900">@DashboardLocalizer["TaskComments_Title"]</h4>
            <p class="mt-1 text-xs text-slate-500">@DashboardLocalizer["TaskComments_Subtitle"]</p>
        </div>
        @if (_comments.Any())
        {
            <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                @_comments.Count()
            </span>
        }
    </div>

    <div class="mt-4">
        <EditCommentForm
            OnSaved="OnCommentSaved"
            Comment="@(new TaskCommentDto { Task = Task })"
            TaskId="@Task.Id"
            Project="@Task.TaskList.Project" />
    </div>

    <PaginatedItemsListBlock
        Items="@_comments"
        IsLoading="@_isLoading"
        IsHasMore="@_isHasMore"
        OnLoadMore="LoadMore"
        LoadMoreText="@DashboardLocalizer["TaskComments_LoadMore"].Value">
        <EmptyContent>
            <div class="py-10 text-center">
                <p class="text-sm font-medium text-slate-700">@DashboardLocalizer["TaskComments_EmptyTitle"]</p>
                <p class="mt-1 text-xs text-slate-500">@DashboardLocalizer["TaskComments_EmptySubtitle"]</p>
            </div>
        </EmptyContent>
        <ItemTemplate Context="comment">
            <EditCommentForm
                @key="comment.Id"
                OnSaved="OnCommentSaved"
                OnDeleted="OnCommentDeleted"
                Comment="@comment"
                TaskId="@Task.Id"
                Project="@Task.TaskList.Project" />
        </ItemTemplate>
    </PaginatedItemsListBlock>
</section>
