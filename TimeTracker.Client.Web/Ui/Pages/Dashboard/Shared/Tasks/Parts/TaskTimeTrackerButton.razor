@using TimeTracker.Api.Shared.Dto.Entity.Task

@inherits BaseReactiveComponent

<span class="inline-flex shrink-0 @Class" title="@ButtonTitle">
    @if (IsCurrentTaskTimerActive)
    {
        <AppButton
            Variant="@Variant"
            Color="ComponentColor.Default"
            IconOnly="@IconOnly"
            Size="@Size"
            Disabled="@IsDisabled"
            OnClick="@StopTimeEntry">
            <StartContent>
                <i class="fa-solid fa-stop text-xs"></i>
            </StartContent>
            <ChildContent>
                @if (!IconOnly)
                {
                    <span class="task-tracker-button-text">@DashboardLocalizer["StopTimer"]</span>
                }
            </ChildContent>
        </AppButton>
    }
    else
    {
        <AppButton
            Variant="@Variant"
            Color="ComponentColor.Info"
            IconOnly="@IconOnly"
            Size="@Size"
            Disabled="@IsDisabled"
            OnClick="@StartTimeEntry">
            <StartContent>
                <i class="fa-solid fa-play text-xs"></i>
            </StartContent>
            <ChildContent>
                @if (!IconOnly)
                {
                    <span class="task-tracker-button-text">@DashboardLocalizer["StartTimer"]</span>
                }
            </ChildContent>
        </AppButton>
    }
</span>
