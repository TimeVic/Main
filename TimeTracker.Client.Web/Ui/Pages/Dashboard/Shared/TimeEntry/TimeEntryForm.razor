@using LumexUI.Common
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.TimeEntry.Parts
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.Tasks.Modals
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.Shared.TimeEntry.Manage
@using TimeTracker.Client.Web.Ui.Pages.Dashboard.TimeEntry.Parts
@inherits BaseReactiveComponent

<div class="w-time-form @(IsShort ? "w-time-form--short" : "") @Class">
    @if (_isEditModalOpened)
    {
        <EditTimeEntryModal 
            Entry="_activeEntry"
            OnClose="@(() => _isEditModalOpened = false)"/>
    }

    @if (_isAddTaskModalOpened && _activeEntry?.Project != null)
    {
        <AddTaskModal
            ProjectId="_activeEntry.Project.Id"
            TimeEntryId="_activeEntry.Id"
            IsOpened="_isAddTaskModalOpened"
            IsOpenedChanged="@((isOpened) => _isAddTaskModalOpened = isOpened)"
            OnAdded="@OnTaskAdded"/>
    }

    @if (_activeEntry?.Task != null)
    {
        <UpdateTaskModal
            Task="_activeEntry.Task"
            @bind-IsOpened="_isUpdateTaskModalOpened"
            OnClose="@(() => _isUpdateTaskModalOpened = false)"/>
    }

    @{
        var shellClass = IsShort
            ? "w-time-form__shell w-full"
            : "w-time-form__shell w-full rounded-2xl border border-slate-200 bg-white p-3 shadow-sm";
        var contentClass = IsShort
            ? "w-time-form__content flex min-w-0 flex-col gap-2 lg:flex-row lg:items-center"
            : "w-time-form__content flex flex-col gap-2 sm:flex-row sm:items-center";
        var descriptionClass = IsShort
            ? "w-time-form__description min-w-[220px] flex-1"
            : "w-time-form__description min-w-0 flex-1";
        var descriptionInputClass = IsShort
            ? "w-time-form__description-input h-11 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm text-slate-700 placeholder-slate-400 shadow-sm focus:border-blue-300 focus:outline-none"
            : "w-full bg-transparent px-1 py-1 text-sm text-slate-700 placeholder-slate-400 focus:outline-none";
        var controlsClass = IsShort
            ? "w-time-form__controls flex shrink-0 flex-wrap items-center gap-2"
            : "w-time-form__controls flex shrink-0 flex-wrap items-center gap-2";
        var projectSelectClass = IsShort
            ? "w-time-form__project-select min-w-[170px]"
            : "w-time-form__project-select min-w-[180px]";
        var counterClass = IsShort
            ? "w-time-form__compact-counter"
            : string.Empty;
    }

    <section class="@shellClass">
        <div class="@contentClass">

            @* Description — full width on mobile, flex-1 on desktop *@
            <div class="@descriptionClass">
                <input
                    type="text"
                    placeholder="@DashboardLocalizer["WhatAreYouWorkingOn"]"
                    value="@(_activeEntry?.Description ?? string.Empty)"
                    @onchange="@OnDescriptionChanged"
                    @onclick="@OnDescriptionClick"
                    readonly="@(!_hasActiveEntry)"
                    class="@descriptionInputClass @(!_hasActiveEntry ? "cursor-pointer opacity-40" : "")"/>
            </div>

            @* Right-side controls *@
            <div class="@controlsClass">

                @* Project / Task chip *@
                @if (_activeEntry?.Task != null)
                {
                    <button
                        type="button"
                        @onclick="@(() => _isUpdateTaskModalOpened = true)"
                        class="w-time-form__task-chip inline-flex min-h-10 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm font-medium text-slate-800 transition hover:border-blue-300 hover:bg-blue-50 hover:text-blue-700">
                        <i class="fa-regular fa-square-check text-blue-600"></i>
                        <span>@_activeEntry.Task.FormattedId</span>
                    </button>
                }
                else
                {
                    <div class="w-time-form__project-control flex items-center gap-2">
                        <div class="@projectSelectClass @(!_hasActiveEntry ? "cursor-pointer" : "")" @onclick="@OnProjectAreaClick">
                            <div class="@(!_hasActiveEntry ? "pointer-events-none" : "")">
                                <ProjectsDropDown
                                    Value="@(_activeEntry?.Project?.Id ?? Guid.Empty)"
                                    Disabled="@(!_hasActiveEntry)"
                                    Clearable="true"
                                    IsGroupByClient="true"
                                    SelectedItemChanged="@OnChangeProject"/>
                            </div>
                        </div>
                    </div>
                }

                @if ((_activeEntry?.Task == null && _activeEntry?.Project != null) || _activeEntry?.IsBillable == true)
                {
                    <div class="w-time-form__secondary-actions flex items-center gap-2">
                        @if (_activeEntry?.Task == null && _activeEntry?.Project != null)
                        {
                            <div class="w-time-form__add-task-control">
                                <CustomButton
                                    OnClick="@OpenAddTaskModal"
                                    Class="w-time-form__wide-button"
                                    Variant="Variant.Outlined"
                                    Size="Size.Medium"
                                    Color="ThemeColor.Info"
                                    Disabled="@(!_hasActiveEntry)">
                                    <StartContent>
                                        <i class="fa-solid fa-plus"></i>
                                    </StartContent>
                                    <ChildContent>
                                        <span class="w-time-form__responsive-label hidden sm:inline">@DashboardLocalizer["Task"]</span>
                                    </ChildContent>
                                </CustomButton>
                            </div>
                        }

                        @if (_activeEntry?.IsBillable == true)
                        {
                            <div class="w-time-form__control w-time-form__billing-control">
                                <BillableIndicator />
                            </div>
                        }
                    </div>
                }

                <div class="w-time-form__timer-actions flex items-center gap-2">
                    <div class="w-time-form__control w-time-form__counter">
                        <TimeCounterField
                            Class="@counterClass"
                            Value="@_activeEntry?.StartTimeOffset"
                            IsActive="@_hasActiveEntry"/>
                    </div>

                    <div class="w-time-form__control w-time-form__timer-button">
                        <CustomButton
                            OnClick="@(() => ToggleTimeEntry())"
                            Class="w-time-form__wide-button"
                            Variant="Variant.Solid"
                            Color="@(_hasActiveEntry ? ThemeColor.Default : ThemeColor.Primary)"
                            Disabled="@_state.Value.IsTimeEntryProcessing">
                            <StartContent>
                                <i class="fa-solid @(_hasActiveEntry ? "fa-stop" : "fa-play")"></i>
                            </StartContent>
                            <ChildContent>
                                <span class="w-time-form__responsive-label hidden sm:inline">@(_hasActiveEntry ? DashboardLocalizer["Stop"] : DashboardLocalizer["Start"])</span>
                            </ChildContent>
                        </CustomButton>
                    </div>

                    @if (_activeEntry != null)
                    {
                        <div class="w-time-form__control w-time-form__timer-button">
                            <CustomButton
                                OnClick="@(() => _isEditModalOpened = true)"
                                Class="w-time-form__wide-button"
                                Variant="Variant.Outlined"
                                Size="Size.Medium"
                                Radius="Radius.Full"
                                IconOnly="true"
                                Color="ThemeColor.Default">
                                <StartContent>
                                    <i class="fa-solid fa-pencil"></i>
                                </StartContent>
                            </CustomButton>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</div>
