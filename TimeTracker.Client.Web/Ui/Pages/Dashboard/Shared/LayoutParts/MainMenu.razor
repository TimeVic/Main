@using LumexUI.Common
@inherits BaseReactiveComponent

@{
    var availableNavItems = AvailableNavItems.ToList();
    var primaryItems = availableNavItems
        .Where(item => item.GroupName == null && !string.IsNullOrEmpty(item.Name))
        .AsQueryable();
    var groupedItems = availableNavItems
        .Where(item => item.GroupName != null)
        .GroupBy(i => i.GroupName)
        .AsQueryable();
    var settingsItem = availableNavItems.FirstOrDefault(item => string.IsNullOrEmpty(item.Name));
}

<nav class="flex min-w-0 flex-wrap items-center gap-2 max-[420px]:justify-between">
    @foreach (var item in primaryItems)
    {
        <CustomButton
            Class="shrink-0"
            Color="@(IsMenuItemSelected(item) ? ThemeColor.Primary : ThemeColor.Default)"
            Variant="@(IsMenuItemSelected(item) ? Variant.Solid : Variant.Outlined)"
            Size="@Size.Medium"
            OnClick="@(() => OnMenuItemSelected(item.Url))">
            <StartContent>
                <i class="@item.Icon"></i>
            </StartContent>
            <ChildContent>
                <span class="hidden sm:inline">@item.Name</span>
            </ChildContent>
        </CustomButton>
    }
    @if (groupedItems.Any())
    {
        <LumexDropdown ShowArrow="@true"
                       Radius="@Radius.Small">
            <LumexDropdownTrigger>
                <LumexButton
                    Class="shrink-0"
                    Variant="@Variant.Outlined"
                    IconOnly="true"
                    Size="@Size.Medium">
                    <StartContent>
                        <i class="fa fa-arrow-down" aria-hidden="true"></i>
                    </StartContent>
                </LumexButton>
            </LumexDropdownTrigger>
            <LumexDropdownMenu Class="p-3">
                @foreach (var group in groupedItems.Where(g => string.IsNullOrEmpty(g.Key)))
                {
                    foreach (var item in group)
                    {
                        <LumexDropdownItem
                            Color="@(IsMenuItemSelected(item) ? ThemeColor.Primary : ThemeColor.Default)"
                            Variant="@(IsMenuItemSelected(item) ? MenuVariant.Solid : MenuVariant.Outlined)"
                            OnClick="@(() => OnMenuItemSelected(item.Url))">
                            <StartContent>
                                <span class="flex items-center gap-2">
                                    <i class="@item.Icon"></i>
                                </span>
                            </StartContent>
                            <ChildContent>
                                @item.Name
                            </ChildContent>
                        </LumexDropdownItem>
                    }
                }
                @foreach (var group in groupedItems.Where(g => !string.IsNullOrEmpty(g.Key)))
                {
                    <LumexDropdownItem
                        ShowDivider="true"
                        Disabled="true">
                        @group.Key
                    </LumexDropdownItem>
                    foreach (var item in group)
                    {
                        <LumexDropdownItem
                            Color="@(IsMenuItemSelected(item) ? ThemeColor.Primary : ThemeColor.Default)"
                            Variant="@(IsMenuItemSelected(item) ? MenuVariant.Solid : MenuVariant.Outlined)"
                            OnClick="@(() => OnMenuItemSelected(item.Url))">
                            <StartContent>
                                <span class="flex items-center gap-2">
                                    <i class="@item.Icon"></i>
                                </span>
                            </StartContent>
                            <ChildContent>
                                @item.Name
                            </ChildContent>
                        </LumexDropdownItem>
                    }
                }
            </LumexDropdownMenu>
        </LumexDropdown>
    }

    @if (settingsItem != null)
    {
        <CustomButton
            Class="shrink-0"
            Color="@(IsMenuItemSelected(settingsItem) ? ThemeColor.Primary : ThemeColor.Default)"
            Variant="@(IsMenuItemSelected(settingsItem) ? Variant.Solid : Variant.Outlined)"
            Size="@Size.Medium"
            IconOnly="true"
            OnClick="@(() => OnMenuItemSelected(settingsItem.Url))">
            <StartContent>
                <span class="flex items-center gap-2">
                    <i class="@settingsItem.Icon"></i>
                </span>
            </StartContent>
        </CustomButton>
    }
</nav>
