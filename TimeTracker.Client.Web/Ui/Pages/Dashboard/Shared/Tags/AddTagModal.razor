@using TimeTracker.Client.Core.Constants.Ui
@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Validation

@inherits BaseReactiveComponent

<AppModalHeader
    Title="@DashboardLocalizer["TagsBlock_AddTag"]"
    Description="@DashboardLocalizer["AddTagModal_Description"]">
    <Icon>
        <div
            class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
            <i
                class="fa-solid fa-tag"></i>
        </div>
    </Icon>
</AppModalHeader>
<AppModalBody
    Class="pt-3">
    <EditForm
        Context="form"
        @ref="_form"
        Model="@model"
        novalidate>
        <DataAnnotationsValidator/>

        <div
            class="grid gap-5">
            <div>
                <InputTextField
                    FullWidth="true"
                    Label="@DashboardLocalizer["Tag"]"
                    Placeholder="@DashboardLocalizer["TagName"]"
                    IsShowEmojiButton="true"
                    @bind-Value="model.Name"/>
                <CustomValidationMessage
                    For="@(() => model.Name)"/>
            </div>

            <div
                class="pt-1">
                <ColorSelect
                    Label="@DashboardLocalizer["Color"]"
                    Type="DropDownType.Select"
                    Clearable="true"
                    @bind-Value="model.Color"/>
                <CustomValidationMessage
                    For="@(() => model.Color)"/>
            </div>
        </div>

        <CustomValidationSummary/>
    </EditForm>
</AppModalBody>
<AppModalFooter>
    <AppButton
        FullWidth="@true"
        OnClick="@Submit"
        IsLoading="_state.Value.IsSaving"
        Color="@ComponentColor.Primary"
        Radius="@ButtonRadius.Full">
        @DashboardLocalizer["Add"]
    </AppButton>
</AppModalFooter>
