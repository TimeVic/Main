@using TimeTracker.Client.Web.Ui.Shared
@inherits TimeTracker.Client.Web.Ui.Shared.BaseLayout

<SeoHead
    Title="TimeVic Chat"
    Robots="@SiteMetadata.NoIndexRobots" />

<div class="flex h-screen flex-col overflow-hidden bg-slate-100 text-slate-900">
    <div class="mx-auto flex w-full flex-1 min-h-0 max-w-7xl flex-col overflow-hidden lg:flex-row">
        @if (CommonState.Value.IsInitialized)
        {
            <InitializationContainer>
                @Body
            </InitializationContainer>
        }
    </div>
</div>
