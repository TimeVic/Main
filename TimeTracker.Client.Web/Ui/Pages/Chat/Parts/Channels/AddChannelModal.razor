@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons
@inherits BaseReactiveComponent

<LumexModal @ref="modal">
    <LumexModalTrigger 
        Variant="@Variant.Light" 
        Color="ThemeColor.Info"
        Size="Size.Small">Create Channel</LumexModalTrigger>
    <LumexModalContent>
        <LumexModalHeader Class="flex-col gap-3">
            Create channel
        </LumexModalHeader>
        <LumexModalBody Class="pt-3">
            <EditForm
                @ref="_form"
                Context="formContext"
                Model="model"
                OnValidSubmit="OnSubmit">
                <DataAnnotationsValidator />
                <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">Submit</button>
            
                <InputTextField 
                    @bind-Value="model.Slug"
                    Type="@InputType.Text"
                    Class="w-100"
                    Label="Name"
                    DisplayName="Name"
                    Placeholder="e.g. my-channel"
                />
                <p>
                    Channels are where conversations happen around a topic. Use a name that is easy to find and understand.
                </p>
            </EditForm>
        </LumexModalBody>
        <LumexModalFooter>
            <LumexButton 
                FullWidth="@true"
                Color="@ThemeColor.Primary"
                Radius="@Radius.Full"
                OnClick="OnSubmit"
                command="close"
                commandfor="@context">
                Create
            </LumexButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>
