@inherits BaseReactiveComponent

<div id="tv-chat-container" class="flex-1 space-y-4 overflow-y-auto flex-grow bg-slate-50 px-4 py-5 sm:px-6">
    @if (State.Value.IsListLoading)
    {
        <div class="flex justify-center">
            <AppSpinner Variant="SpinnerVariant.DotsFade" />
        </div>
    }
    @if (_messages.Any())
    {
        DateTime? previousMessageDay = null;
        foreach (var message in _sortedMessages)
        {
            <MessageBlock
                @key="@message.Id"
                Message="@message" 
                PreviousMessageDay="@previousMessageDay"/>
            
            previousMessageDay = message.CreatedAt.Date;
        }
    }
    else if (!State.Value.IsListLoading)
    {
        <div class="flex h-full min-h-[20rem] items-center justify-center">
            <div class="max-w-md rounded-3xl border border-dashed border-slate-300 bg-white p-8 text-center shadow-sm">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-100 text-slate-500">
                    <i class="fa-regular fa-comments text-2xl"></i>
                </div>
                <h3 class="mt-4 text-lg font-semibold text-slate-900">No messages yet</h3>
                <p class="mt-2 text-sm text-slate-500">Start the conversation with a first message in this chat.</p>
            </div>
        </div>
    }
</div>
