@using TimeTracker.Business.Common.Constants.Messaging
@using TimeTracker.Client.Web.Ui.Pages.Chat.Parts.Channels
@inherits BaseReactiveComponent

@{
    var commonChannels = ChannelsState.Value.List.Where(item => item.Type == MessagingChannelType.Common);
    var directChannels = ChannelsState.Value.List.Where(item => item.Type == MessagingChannelType.Direct);
    var selectedChannel = ChannelsState.Value.SelectedChannel;
}

<div class="p-4">
    <div class="mb-3 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2 text-sm font-semibold text-slate-700">
            <i class="fa-solid fa-user-group text-cyan-600"></i>
            <span>Channels</span>
        </div>
        
        <AppButton
            Variant="@ButtonVariant.Light"
            Color="@ComponentColor.Info"
            Size="@ComponentSize.Small"
            OnClick="OpenAddChannelModal">
            Create Channel
        </AppButton>
    </div>
    
    
    <div class="space-y-2">
        @foreach (var channel in commonChannels)
        {
            <button class="@GetNavButtonClass(channel.Id == selectedChannel?.Id)" @onclick="@(() => SelectChannel(channel))">
                <span class="flex min-w-0 items-center gap-3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-cyan-100 text-cyan-700">
                        <i class="fa-solid fa-hashtag"></i>
                    </span>
                    <span class="min-w-0 text-left">
                        <span class="block truncate font-medium text-slate-900">@channel.Slug</span>
                        <span class="block truncate text-xs text-slate-500">@channel.Slug</span>
                    </span>
                </span>
                <span class="text-xs text-slate-500">44</span>
            </button>
        }
    </div>
</div>

<div class="border-t border-slate-200 p-4">
    <div class="mb-3 flex items-center gap-2 text-sm font-semibold text-slate-700">
        <i class="fa-regular fa-message text-violet-600"></i>
        <span>Direct messages</span>
    </div>
    <div class="space-y-2">
        @foreach (var channel in directChannels)
        {
            <button class="@GetNavButtonClass(channel.Id == selectedChannel?.Id)" @onclick="@(() => SelectChannel(channel))">
                <span class="flex min-w-0 items-center gap-3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-violet-100 text-violet-700">
                        @channel.User!.Initials
                    </span>
                    <span class="min-w-0 text-left">
                        <span class="block truncate font-medium text-slate-900">@channel.User.Name</span>
                        <span class="block truncate text-xs text-slate-500">GetDirectPreview</span>
                    </span>
                </span>
                @if (true)
                {
                    <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                }
                else
                {
                    <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
                }
            </button>
        }
    </div>
</div>
