@page "/user/password-reset"
@page "/uk/user/password-reset"
@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons
@using TimeTracker.Client.Web.Ui.Pages.Landing.User.Password.Shared
@using Layout = TimeTracker.Client.Web.Ui.Pages.Landing.Shared.LandingLayout

@inherits BaseReactiveComponent
@layout Layout

@inject IStringLocalizer<PublicLandingResource> SharedLocalizer
@inject IStringLocalizer<ResetPasswordPage> Localizer
<SeoHead
    Title="@Localizer["Meta_Title"]"
    Robots="@SiteMetadata.NoIndexRobots" />

<PasswordFormBlock>
    <ChildContent>
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-600">@Localizer["Content_Recovery"]</p>
                <h2 class="mt-2 text-2xl font-semibold text-slate-900">@Localizer["Content_ForgotPassword"]</h2>
                <p class="mt-2 text-sm text-slate-500">@Localizer["Content_Step1Of2ReceiveAPasswordRecoveryLink"]</p>
            </div>
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-500 text-white shadow-sm">
                <i class="@($"fa-solid fa-envelope text-lg")"></i>
            </div>
        </div>

        <EditForm 
            Model="model"
            @ref="_form"
            class="mt-6 grid gap-4"
            novalidate
        >
            <DataAnnotationsValidator/>
        
            <div>
                <InputTextField 
                    @bind-Value="@model.Email"
                    Label="@SharedLocalizer["Form_EmailLabel"]"
                    Type="InputType.Email" 
                    FullWidth="true"
                    Placeholder="@SharedLocalizer["Form_RecoveryEmailPlaceholder"]" />
            </div>
            @* <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600"> *@
            @*     @statusMessage *@
            @* </div> *@
            <AppButton
                Color="@ComponentColor.Warning"
                Class="bg-amber-500 text-white shadow-sm transition hover:bg-amber-600 font-semibold w-full"
                IsLoading="_isLoading"
                OnClick="@Submit">
                <StartContent>
                    <SendAltIcon></SendAltIcon>
                </StartContent>
                <ChildContent>@Localizer["Content_SendRecoveryEmail"]</ChildContent>
            </AppButton>
        </EditForm>
        @if (_isSent)
        {
            <div class="mt-6 rounded-3xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
                <p class="font-semibold">@Localizer["Content_RecoveryEmailSent"]</p>
                <p class="mt-2 text-amber-700">@Localizer["Content_CheckYourEmailAndUseTheLinkBelowToContinue"]</p>
            </div>
        }
    </ChildContent>
</PasswordFormBlock>
