@page "/user/change-password/{token}"
@page "/uk/user/change-password/{token}"

@using LumexUI
@using LumexUI.Common
@using TimeTracker.Client.Web.Ui.Pages.Landing.User.Password.Shared
@using TimeTracker.Client.Core.Ui.Shared.Components.Form
@using TimeTracker.Client.Web.Services
@using Layout = TimeTracker.Client.Web.Ui.Pages.Landing.Shared.LandingLayout

@inherits BaseComponent
@layout Layout

@inject IStringLocalizer<PublicLandingResource> SharedLocalizer
@inject IStringLocalizer<ChangePasswordPage> Localizer
@inject ILocalizationUrlService LocalizationUrlService
<SeoHead
    Title="@Localizer["Meta_Title"]"
    Robots="@SiteMetadata.NoIndexRobots" />

<PasswordFormBlock>
    <ChildContent>
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-600">@Localizer["Content_Recovery"]</p>
                <h2 class="mt-2 text-2xl font-semibold text-slate-900">@Localizer["Content_SetANewPassword"]</h2>
                <p class="mt-2 text-sm text-slate-500">@Localizer["Content_Step2Of2CreateANewPassword"]</p>
            </div>
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-500 text-white shadow-sm">
                <i class="fa-solid fa-lock-open text-lg"></i>
            </div>
        </div>

        @if (_isCompleted)
        {
            <div class="mt-6 rounded-3xl border border-emerald-200 bg-emerald-50 p-5 text-sm text-emerald-900">
                <p class="font-semibold">@Localizer["Content_PasswordUpdatedSuccessfully"]</p>
                @* <p class="mt-2 text-emerald-700">@Localizer["Content_AAAAAAAAAAAAAAAAA"]</p> *@
                <div class="mt-4 flex flex-col gap-3 sm:flex-row">
                    <a 
                        href="@LocalizedUrl(SiteUrl.Login)" 
                        class="inline-flex items-center justify-center gap-2 rounded-2xl bg-emerald-600 px-4 py-3 font-semibold text-white transition hover:bg-emerald-700">
                        <i class="fa-solid fa-arrow-right-to-bracket"></i>
                        <span>@Localizer["Content_GoToLogin"]</span>
                    </a>
                    <a href="@LocalizedUrl(SiteUrl.ForgotPassword)" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-3 font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50">
                        <i class="fa-solid fa-rotate-left"></i>
                        <span>@Localizer["Content_StartAgain"]</span>
                    </a>
                </div>
            </div>
        }
        else
        {
            @* <div class="mt-6 rounded-3xl border border-blue-200 bg-blue-50 p-4 text-sm text-blue-900"> *@
            @*     <p class="font-semibold">@Localizer["Content_RecoveryForEmail"]</p> *@
            @*     <p class="mt-1 text-blue-700">@model.</p> *@
            @* </div> *@
            <EditForm 
                Model="model"
                @ref="_form" 
                FormName="ForgotPasswordResetForm" 
                class="mt-6 grid gap-4"
                novalidate
            >
                <DataAnnotationsValidator/>
                
                <div>
                    <InputTextField 
                        @bind-Value="@model.Password"
                        Label="@SharedLocalizer["Form_NewPasswordLabel"]"
                        FullWidth="true"
                        Type="InputType.Password" 
                        Placeholder="@SharedLocalizer["Form_RecoveryEmailPlaceholder"]" />
                </div>
                @* <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600"> *@
                @*     AAAAAAAAAAAAAAAAAAAAAAA *@
                @* </div> *@
                <div class="flex flex-col gap-3 sm:flex-row">
                    <CustomButton
                        Color="@ThemeColor.Warning"
                        Class="bg-amber-500 text-white shadow-sm transition hover:bg-amber-600 font-semibold w-full"
                        IsLoading="_isLoading"
                        OnClick="@Submit">
                        @Localizer["Content_SaveNewPassword"]
                    </CustomButton>
                    <a href="@LocalizedUrl(SiteUrl.ForgotPassword)" 
                       class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50"
                    >
                        <i class="fa-solid fa-arrow-left"></i>
                        <span>@Localizer["Content_Back"]</span>
                    </a>
                </div>
            </EditForm>
        }
    </ChildContent>
</PasswordFormBlock>

@code {
    private string CurrentPath => new Uri(NavigationManager.Uri).AbsolutePath;

    private string CurrentCulture => LocalizationUrlService.GetCurrentCultureName(CurrentPath);

    private string LocalizedUrl(string path) => LocalizationUrlService.GetLocalizedUrl(path, CurrentCulture);
}
