@page "/login/magic/{token}"
@page "/uk/login/magic/{token}"
@using TimeTracker.Client.Web.Ui.Pages.Landing.User.Registration.Shared
@using TimeTracker.Client.Web.Services
@using Layout = TimeTracker.Client.Web.Ui.Pages.Landing.Shared.LandingLayout

@inherits BaseComponent
@layout Layout

@inject IStringLocalizer<PublicLandingResource> SharedLocalizer
@inject IStringLocalizer<MagicLoginPage> Localizer
@inject ILocalizationUrlService LocalizationUrlService
<SeoHead
    Title="@Localizer["Meta_Title"]"
    Robots="@SiteMetadata.NoIndexRobots" />

<RegistrationCntainerBlock>
    <ChildContent>
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-blue-600">@Localizer["Content_Auth"]</p>
                <h2 class="mt-2 text-2xl font-semibold text-slate-900">@Localizer["Content_MagicLinkSignIn"]</h2>
                <p class="mt-2 text-sm text-slate-500">@Localizer["Content_VerifyingYourOneTimeLoginLink"]</p>
            </div>
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-sm">
                <i class="fa-solid fa-wand-magic-sparkles text-lg"></i>
            </div>
        </div>

        <div class="mt-6">
            @if (_isLoading)
            {
                <div class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">
                    <i class="fa-solid fa-circle-notch fa-spin text-blue-500"></i>
                    <span>@Localizer["Content_SigningYouInPleaseWait"]</span>
                </div>
            }
            else if (_isError)
            {
                <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-900">
                    <p class="font-semibold">@Localizer["Content_InvalidOrExpiredLink"]</p>
                    <p class="mt-1 text-red-700">@Localizer["Content_ThisMagicLinkIsNoLongerValidPleaseRequestA"]</p>
                    <div class="mt-4">
                        <a href="@LocalizedUrl(SiteUrl.Login)"
                           class="inline-flex items-center gap-2 rounded-2xl bg-blue-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-blue-700">
                            <i class="fa-solid fa-arrow-right-to-bracket"></i>
                            <span>@SharedLocalizer["CTA_BackToSignInHyphen"]</span>
                        </a>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</RegistrationCntainerBlock>

@code {
    private string CurrentPath => new Uri(NavigationManager.Uri).AbsolutePath;

    private string CurrentCulture => LocalizationUrlService.GetCurrentCultureName(CurrentPath);

    private string LocalizedUrl(string path) => LocalizationUrlService.GetLocalizedUrl(path, CurrentCulture);
}
