@page "/registration/verification/{verificationToken}"
@page "/uk/registration/verification/{verificationToken}"
@using LumexUI
@using LumexUI.Common
@using Microsoft.AspNetCore.Components
@using TimeTracker.Client.Web.Ui.Pages.Landing.User.Registration.Shared
@using TimeTracker.Client.Web.Ui.Pages.Landing.User.Shared
@using TimeTracker.Client.Core.Ui.Shared.Components.Form
@using TimeTracker.Client.Core.Ui.Shared.Components.Form.Validation
@using Layout = TimeTracker.Client.Web.Ui.Pages.Landing.Shared.LandingLayout

@layout Layout
@inherits BaseComponent

@inject IStringLocalizer<PublicLandingResource> SharedLocalizer
@inject IStringLocalizer<Step2Page> Localizer
<SeoHead
    Title="@Localizer["Meta_Title"]"
    Robots="@SiteMetadata.NoIndexRobots" />

<RegistrationCntainerBlock>
    <ChildContent>
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-600">@Localizer["Content_Registration"]</p>
                <h2 class="mt-2 text-2xl font-semibold text-slate-900">@Localizer["Content_SetYourPassword"]</h2>
                <p class="mt-2 text-sm text-slate-500">@Localizer["Content_CompleteAccountActivationAndOpenYourWorkspace"]</p>
            </div>
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-600 text-white shadow-sm">
                <i class="fa-solid fa-lock text-lg"></i>
            </div>
        </div>

        <EditForm
            Model="model"
            @ref="_form"
            class="mt-6 grid gap-4"
            novalidate>
            <DataAnnotationsValidator />
            <CustomValidationSummary />

            <div>
                <InputTextField
                    @bind-Value="@model.Password"
                    Label="@SharedLocalizer["Form_PasswordLabel"]"
                    FullWidth="true"
                    Type="InputType.Password"
                    Placeholder="@SharedLocalizer["Form_CreatePasswordPlaceholder"]" />
            </div>

            <CustomButton
                Color="@ThemeColor.Primary"
                Class="w-full gap-2 bg-emerald-600 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"
                IsLoading="_isLoading"
                OnClick="@Submit">
                <StartContent>
                    <i class="fa-solid fa-arrow-right-to-bracket"></i>
                </StartContent>
                <ChildContent>
                    @Localizer["Content_FinishRegistration"]
                </ChildContent>
            </CustomButton>
        </EditForm>

        <div class="mt-6 rounded-3xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900">
            <p class="font-semibold">@Localizer["Content_WorkspaceInvitation"]</p>
            <p class="mt-2 text-emerald-700">@Localizer["Content_ThisLinkActivatesTheAccountCreatedFromAWorkspaceInvitation"]</p>
        </div>
    </ChildContent>
</RegistrationCntainerBlock>
