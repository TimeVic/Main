@using TimeTracker.Client.Web.Ui.Shared.Components.Layout
@inherits BaseReactiveComponent

@inject IStringLocalizer<PublicLandingResource> SharedLocalizer
<header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8">
        
        <AppLogoBlock
            Eyebrow="@SharedLocalizer["AppLogo_Eyebrow"]"
        />
        
        <nav class="hidden items-center gap-6 lg:flex">
            <a
                href="@NavHomeUrl"
                class="text-sm font-medium text-slate-600 transition hover:text-slate-900"
            >
                @SharedLocalizer["Nav_Home"]
            </a>

            @* Features Dropdown *@
            <div class="group relative inline-block text-left">
                <button
                    type="button"
                    class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-600 transition hover:text-slate-900 group-hover:text-slate-900"
                    aria-expanded="false"
                >
                    <span>@SharedLocalizer["Nav_Features"]</span>
                    <i class="fa-solid fa-chevron-down text-xs transition duration-200 group-hover:rotate-180"></i>
                </button>

                <div class="invisible absolute left-0 top-full z-50 mt-2 w-80 translate-y-2 scale-95 rounded-2xl border border-slate-200 bg-white p-2 shadow-xl opacity-0 transition-all duration-150 group-hover:visible group-hover:translate-y-0 group-hover:scale-100 group-hover:opacity-100">
                    <a
                        href="@NavReportsAndPayoutsUrl"
                        class="flex items-start gap-3 rounded-xl p-3 transition hover:bg-slate-50"
                    >
                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                            <span class="text-base">📊</span>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-slate-900">
                                @SharedLocalizer["Nav_ReportsAndPayouts"]
                            </p>
                            <p class="mt-0.5 text-xs text-slate-500">
                                @SharedLocalizer["Nav_ReportsAndPayouts_Desc"]
                            </p>
                        </div>
                    </a>

                    <a
                        href="@NavTimeAndApprovalsUrl"
                        class="flex items-start gap-3 rounded-xl p-3 transition hover:bg-slate-50"
                    >
                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
                            <span class="text-base">⏱️</span>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-slate-900">
                                @SharedLocalizer["Nav_TimeAndApprovals"]
                            </p>
                            <p class="mt-0.5 text-xs text-slate-500">
                                @SharedLocalizer["Nav_TimeAndApprovals_Desc"]
                            </p>
                        </div>
                    </a>

                    <a
                        href="@NavTasksAndNotesUrl"
                        class="flex items-start gap-3 rounded-xl p-3 transition hover:bg-slate-50"
                    >
                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-purple-50 text-purple-600">
                            <span class="text-base">📝</span>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-slate-900">
                                @SharedLocalizer["Nav_TasksAndNotes"]
                            </p>
                            <p class="mt-0.5 text-xs text-slate-500">
                                @SharedLocalizer["Nav_TasksAndNotes_Desc"]
                            </p>
                        </div>
                    </a>
                </div>
            </div>

            <a
                href="@NavPricingUrl"
                class="text-sm font-medium text-slate-600 transition hover:text-slate-900"
            >
                @SharedLocalizer["Nav_Pricing"]
            </a>
            <a
                href="@NavFaqUrl"
                class="text-sm font-medium text-slate-600 transition hover:text-slate-900"
            >
                @SharedLocalizer["Nav_FAQ"]
            </a>
        </nav>

        <div class="flex items-center gap-3">
            @* Language Switcher *@
            <div class="flex items-center rounded-lg border border-slate-200 bg-slate-50/80 p-0.5 text-xs font-semibold text-slate-600">
                <button
                    type="button"
                    @onclick="SwitchToUkrainian"
                    class="@(IsUkrainianLocale ? "bg-white text-slate-950 shadow-sm" : "text-slate-500 hover:text-slate-900") rounded-md px-2.5 py-1 transition"
                >
                    UA
                </button>
                <button
                    type="button"
                    @onclick="SwitchToEnglish"
                    class="@(!IsUkrainianLocale ? "bg-white text-slate-950 shadow-sm" : "text-slate-500 hover:text-slate-900") rounded-md px-2.5 py-1 transition"
                >
                    EN
                </button>
            </div>

            @if (AuthState.Value.IsLoggedIn)
            {
                <a 
                    href="@UrlService.GetDashboardUrl()"
                    class="inline-flex items-center gap-2 rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50"
                >
                    <i class="fa-regular fa-chart-bar"></i>
                    <span>@SharedLocalizer["CTA_Dashboard"]</span>
                </a>    
            }
            else
            {
                <a 
                    href="@LoginUrl" 
                    class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50"
                >
                    <i class="fa-solid fa-arrow-right-to-bracket text-xs text-slate-400"></i>
                    <span>@SharedLocalizer["CTA_Login"]</span>
                </a>
                <a
                    href="@RegistrationUrl"
                    class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700"
                >
                    <i class="fa-solid fa-plus text-xs"></i>
                    <span>@SharedLocalizer["CTA_CreateWorkspace"]</span>
                </a>
            }
        </div>
    </div>
</header>
