
@using LumexUI
@using LumexUI.Common
@using LumexUI.Shared.Icons
@using Markdig.Extensions.TaskLists

@inherits BaseReactiveComponent

<LumexModal 
    Open="true" 
    Size="ModalSize.Small"
    OnClose="@OnClose"
    @ref="modal">
    <LumexModalContent>
        <LumexModalHeader Class="flex items-center gap-3">
            <div class="flex items-start gap-4">
                <div class="@($"flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl {IconBackgroundClass} {IconTextClass}")">
                    <i class="@IconClass"></i>
                </div>
                <div>
                    <h3 class="text-xl font-semibold text-slate-900">@DisplayTitle</h3>
                    @if (!string.IsNullOrWhiteSpace(DisplaySubtitle))
                    {
                        <p class="mt-1 text-sm text-slate-500">@DisplaySubtitle</p>
                    }
                </div>
            </div>
        </LumexModalHeader>
        <LumexModalBody Class="pt-3">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else if (!string.IsNullOrWhiteSpace(Message))
            {
                <p class="text-sm leading-6 text-slate-600">@Message</p>
            }
        </LumexModalBody>
        <LumexModalFooter>
            <CustomButton
                FullWidth="@true"
                OnClick="@OnCancelClicked"
                Color="@ThemeColor.Default"
                Variant="Variant.Outlined"
                Radius="@Radius.Medium">
                @DisplayCancelButtonText
            </CustomButton>
            <CustomButton
                FullWidth="@true"
                OnClick="@OnConfirmClicked"
                Color="@ThemeColor.Danger"
                Variant="Variant.Solid"
                Radius="@Radius.Medium">
                @DisplayConfirmText
            </CustomButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>

@code {

    public enum ConfirmationVariant
    {
        Delete = 1,
        Info
    }

    [Parameter]
    public ConfirmationVariant DialogVariant { get; set; } = ConfirmationVariant.Delete;
    
    [Parameter]
    public string Title { get; set; } = string.Empty;
    
    [Parameter]
    public string Subtitle { get; set; } = string.Empty;
    
    [Parameter]
    public string Message { get; set; } = string.Empty;
    
    [Parameter]
    public string ConfirmText { get; set; } = string.Empty;
    
    [Parameter]
    public string CancelButtonText { get; set; } = string.Empty;
    
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    
    [Parameter]
    public EventCallback OnConfirm { get; set; }
    
    [Parameter]
    public EventCallback OnCancel { get; set; }
    
    [Parameter]
    public EventCallback OnClose { get; set; }
    
    LumexModal modal;
    
    private string DisplayTitle => string.IsNullOrWhiteSpace(Title)
        ? DashboardLocalizer["ConfirmAction"].Value
        : Title;
    
    private string DisplaySubtitle => string.IsNullOrWhiteSpace(Subtitle)
        ? DashboardLocalizer["ConfirmActionSubtitle"].Value
        : Subtitle;
    
    private string DisplayConfirmText => string.IsNullOrWhiteSpace(ConfirmText)
        ? DashboardLocalizer["Confirm"].Value
        : ConfirmText;
    
    private string DisplayCancelButtonText => string.IsNullOrWhiteSpace(CancelButtonText)
        ? DashboardLocalizer["Cancel"].Value
        : CancelButtonText;
    
    public string IconBackgroundClass
    {
        get
        {
            if (DialogVariant == ConfirmationVariant.Delete)
                return "bg-red-50";
            return string.Empty;
        }
    }
    
    public string IconTextClass
    {
        get
        {
            if (DialogVariant == ConfirmationVariant.Delete)
                return "text-red-600";
            return string.Empty;
        }
    }
    
    public string IconClass
    {
        get
        {
            if (DialogVariant == ConfirmationVariant.Delete)
                return "fa-regular fa-trash-can";
            return "fa-solid fa-triangle-exclamation";
        }
    }

    private async Task OnCancelClicked()
    {
        await OnCancel.InvokeAsync();
        await modal.CloseAsync();
    }

    private async Task OnConfirmClicked()
    {
        await OnConfirm.InvokeAsync();
        await modal.CloseAsync();
    }
}
