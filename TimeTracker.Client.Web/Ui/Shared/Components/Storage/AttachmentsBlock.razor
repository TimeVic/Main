@using LumexUI
@using LumexUI.Common
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants.Storage

@inherits BaseReactiveComponent

@if (IsVisible)
{
    <div class="@Class">
        @if (!string.IsNullOrWhiteSpace(LocalizedTitle))
        {
            <label class="mb-3 block text-xs font-medium uppercase tracking-wide text-slate-500">@LocalizedTitle</label>
        }
        <div class="@ListClass">
            @foreach (var attachment in Files)
            {
                <div class="@PreviewItemClass group hover:border-blue-400 hover:shadow-sm">
                    <a
                        href="@GetAttachmentUrl(attachment)"
                        target="_blank"
                        class="flex h-full w-full items-center justify-center"
                        title="@attachment.Name">
                        @if (IsAttachmentDeleting(attachment))
                        {
                            <div class="absolute inset-0 z-10 flex items-center justify-center bg-white/75">
                                <LumexSpinner Size="@Size.Medium" />
                            </div>
                        }
                        @if (IsImageAttachment(attachment))
                        {
                            <img
                                src="@GetAttachmentPreviewUrl(attachment)"
                                alt="@attachment.Name"
                                class="h-full w-full object-cover" />
                        }
                        else
                        {
                            <div class="flex h-16 w-14 items-center justify-center rounded-lg border border-slate-300 bg-white text-xs font-semibold uppercase text-slate-600 group-hover:border-blue-300 group-hover:text-blue-600">
                                @GetAttachmentExtension(attachment)
                            </div>
                        }
                    </a>
                    @if (IsImageAttachment(attachment) || AllowDelete)
                    {
                        <div class="absolute right-2 top-2 z-20 flex gap-1 opacity-0 transition focus-within:opacity-100 group-hover:opacity-100">
                            @if (IsImageAttachment(attachment))
                            {
                                <button
                                    type="button"
                                    class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-white/80 bg-white/90 text-slate-500 shadow-sm transition hover:bg-blue-50 hover:text-blue-600 disabled:cursor-not-allowed disabled:opacity-70"
                                    title="@DashboardLocalizer["AttachmentsBlock_CopyImage"]"
                                    aria-label="@DashboardLocalizer["AttachmentsBlock_CopyImage"]"
                                    disabled="@IsAttachmentCopying(attachment)"
                                    @onclick="@(() => OnCopyImage(attachment))">
                                    @if (IsAttachmentCopying(attachment))
                                    {
                                        <LumexSpinner Size="@Size.Small" />
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-copy text-sm"></i>
                                    }
                                </button>
                            }
                            @if (AllowDelete)
                            {
                                <button
                                    type="button"
                                    class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-white/80 bg-white/90 text-slate-500 shadow-sm transition hover:bg-red-50 hover:text-red-600 disabled:cursor-not-allowed disabled:opacity-70"
                                    title="@DashboardLocalizer["AttachmentsBlock_DeleteAttachment"]"
                                    aria-label="@DashboardLocalizer["AttachmentsBlock_DeleteAttachment"]"
                                    disabled="@IsAttachmentDeleting(attachment)"
                                    @onclick="@(() => OnDeleteAttachment(attachment))">
                                    @if (IsAttachmentDeleting(attachment))
                                    {
                                        <LumexSpinner Size="@Size.Small" />
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-trash-can text-sm"></i>
                                    }
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            @foreach (var attachment in UploadingFiles)
            {
                <div @key="attachment.Id" class="@PreviewItemClass group" title="@attachment.FileName" aria-busy="true">
                    <div class="flex h-full w-full items-center justify-center">
                        <div class="flex h-16 w-14 items-center justify-center rounded-lg border border-slate-300 bg-white text-xs font-semibold uppercase text-slate-600">
                            @GetUploadingAttachmentExtension(attachment)
                        </div>
                    </div>
                    <div class="absolute inset-0 z-10 flex items-center justify-center bg-white/75">
                        <LumexSpinner Size="@Size.Medium" />
                    </div>
                </div>
            }
        </div>
    </div>
}
