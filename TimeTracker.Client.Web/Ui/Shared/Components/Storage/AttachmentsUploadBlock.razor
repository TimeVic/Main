@using Microsoft.AspNetCore.Components.Forms
@using TimeTracker.Api.Shared.Dto.Entity
@using TimeTracker.Business.Common.Constants.Storage

@inherits BaseReactiveComponent

<div class="@Class">
    <FileDropzoneInput
        Accept="@ResolvedAcceptTypes"
        Multiple="true"
        Title="@Hint"
        MaxFileSize="@FileAcceptConstants.MaxDefaultFileSize"
        OnFilesSelected="@OnFilesSelected" />
    <AttachmentsBlock
        Class="mt-4"
        ListClass="flex flex-wrap gap-3"
        PreviewItemClass="relative flex h-24 w-24 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-slate-200 bg-slate-50"
        EntityId="@EntityId"
        EntityType="@EntityType"
        Files="@Files"
        UploadingFiles="@_uploadingFiles"
        FilesChanged="@OnFilesChanged" />
</div>
