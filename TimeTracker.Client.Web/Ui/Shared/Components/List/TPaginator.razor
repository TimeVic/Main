@using System.Linq
@using Microsoft.AspNetCore.Components

@if (IsVisible)
{
    <div class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-slate-500">@Summary</p>
        <div class="flex flex-wrap items-center gap-2">
            <button type="button" @onclick="GoToFirstPageAsync" disabled="@(IsLoading || IsOnFirstPage)" class="@NavigationButtonClass()" aria-label="@DashboardLocalizer["FirstPage"]" title="@DashboardLocalizer["FirstPage"]">
                @if (IsControlLoading("first"))
                {
                    <i class="fa-solid fa-spinner fa-spin"></i>
                }
                else
                {
                    <i class="fa-solid fa-angles-left"></i>
                }
            </button>

            <button type="button" @onclick="GoToPreviousPageAsync" disabled="@(IsLoading || IsOnFirstPage)" class="@NavigationButtonClass()" aria-label="@DashboardLocalizer["PreviousPage"]" title="@DashboardLocalizer["PreviousPage"]">
                @if (IsControlLoading("previous"))
                {
                    <i class="fa-solid fa-spinner fa-spin"></i>
                }
                else
                {
                    <i class="fa-solid fa-chevron-left"></i>
                }
            </button>

            <div class="flex flex-wrap items-center gap-2">
                @foreach (var pageItem in VisiblePageItems)
                {
                    if (pageItem.IsEllipsis)
                    {
                        <span class="inline-flex h-10 min-w-10 items-center justify-center px-2 text-sm font-medium text-slate-400">...</span>
                    }
                    else
                    {
                        var isActive = pageItem.Page == SafeCurrentPage;
                        <button type="button" @onclick="@(() => SetPageAsync(pageItem.Page))" disabled="@IsPageButtonDisabled(pageItem.Page)" class="@PageButtonClass(isActive)" aria-label="@string.Format(DashboardLocalizer["Page"].Value, pageItem.Page)" title="@string.Format(DashboardLocalizer["Page"].Value, pageItem.Page)">
                            @if (IsControlLoading(PageControlKey(pageItem.Page)))
                            {
                                <i class="fa-solid fa-spinner fa-spin"></i>
                            }
                            else
                            {
                                @pageItem.Page
                            }
                        </button>
                    }
                }
            </div>

            <button type="button" @onclick="GoToNextPageAsync" disabled="@(IsLoading || IsOnLastPage)" class="@NavigationButtonClass()" aria-label="@DashboardLocalizer["NextPage"]" title="@DashboardLocalizer["NextPage"]">
                @if (IsControlLoading("next"))
                {
                    <i class="fa-solid fa-spinner fa-spin"></i>
                }
                else
                {
                    <i class="fa-solid fa-chevron-right"></i>
                }
            </button>

            <button type="button" @onclick="GoToLastPageAsync" disabled="@(IsLoading || IsOnLastPage)" class="@NavigationButtonClass()" aria-label="@DashboardLocalizer["LastPage"]" title="@DashboardLocalizer["LastPage"]">
                @if (IsControlLoading("last"))
                {
                    <i class="fa-solid fa-spinner fa-spin"></i>
                }
                else
                {
                    <i class="fa-solid fa-angles-right"></i>
                }
            </button>
        </div>
    </div>
}
