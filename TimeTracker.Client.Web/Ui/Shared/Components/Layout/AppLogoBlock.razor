@using TimeTracker.Client.Web.Services
@inject IStringLocalizer<PublicLandingResource> SharedLocalizer
@inject ILocalizationUrlService LocalizationUrlService
@inject NavigationManager NavigationManager

<a href="@HomeUrl" class="flex items-center gap-3">
    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 text-white shadow-sm">
        <i class="fa-regular fa-clock text-lg"></i>
    </div>
    <div class="min-w-0">
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-blue-600">@Eyebrow</p>
        }
        <div class="mt-1 flex items-center gap-2">
            <p class="text-2xl font-semibold text-slate-900">TimeVic</p>
            <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.2em] text-amber-700">@SharedLocalizer["AppLogo_BetaBadge"]</span>
        </div>
    </div>
</a>

@code {
    [Parameter]
    public string Eyebrow { get; set; } = string.Empty;

    private string CurrentPath => new Uri(NavigationManager.Uri).AbsolutePath;

    private string CurrentCulture => LocalizationUrlService.GetCurrentCultureName(CurrentPath);

    private string HomeUrl => LocalizationUrlService.GetLocalizedUrl(SiteUrl.Main, CurrentCulture);
}
