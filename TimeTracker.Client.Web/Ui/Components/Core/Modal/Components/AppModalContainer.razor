@using TimeTracker.Client.Web.Ui.Components.Core.Modal
@using TimeTracker.Client.Web.Ui.Components.Core.Modal.Components

@if (ModalDialogService.Modals.Count > 0)
{
    <div
        class="app-modals-host">
        @foreach (var modal in ModalDialogService.Modals)
        {
            <AppModalWindow
                @key="modal.Id"
                ModalInstance="modal" />
        }
    </div>
}
